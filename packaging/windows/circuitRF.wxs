<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    WiX v4 definition of the circuitRF .msi. One file for all three architectures AND both install
    scopes: build-msi.ps1 passes the architecture, the version, the publish directory and the scope
    in, so nothing here is per-arch or per-scope except what the two <?if ?> blocks below select.

    Do not run wix by hand — packaging\windows\build-msi.ps1 publishes, harvests the file list into
    Files.wxs and invokes wix with the right arguments. See BUILDING.md.

    ═══ THE TWO SCOPES, AND WHY THERE ARE TWO ═════════════════════════════════════════════════

    perMachine (the default, unchanged) installs to %ProgramFiles%\circuitRF, which only a
    privileged process can modify — so it is the managed, machine-wide story and it is
    NOTIFY-ONLY: circuitRF checks for updates, posts one Message Panel line with a link, and
    writes nothing. That is not a limitation to work around. The only ways to update a Program
    Files install silently are a UAC prompt every time or a permanently-installed SYSTEM service
    that downloads and executes code from the internet, and the second is a genuine
    privilege-escalation surface.

    perUser installs to %LOCALAPPDATA%\Programs\circuitRF and raises no UAC prompt, which is what
    makes a silent background update possible at all (docs/design/auto-update.md §1). Its layout is
    versioned directories behind a stub launcher:

        circuitRF.exe        <- the stub. NEVER changes; shortcuts and file associations point here
        current              <- one line of text naming the directory to run
        app-<version>\       <- the publish tree
        staging\             <- the updater's partial downloads; never executed from

    so an update is a POINTER FLIP and never an overwrite of a file that is currently in use —
    which matters because you cannot overwrite a running .exe or a loaded .dll on Windows.

    Considered and rejected: silently re-running a per-user .msi with `msiexec /qn`, as some
    applications do. It is less new machinery, but it abandons the rename-only swap that the
    disk-space safety of design §13 rests on, and a half-applied MSI on a full disk is a much
    larger thing to reason about than a pointer file that was never truncated.

    KNOWN LIMITATION: uninstalling a perUser install removes the app-<version> directory the MSI
    itself laid down, and leaves behind any LATER one the updater created — MSI can only remove
    files it knows about. The user-visible residue is one directory under %LOCALAPPDATA%.
  -->

  <?if $(var.Scope) = "perUser" ?>
    <?define UpgradeGuid = "1E4F8D22-6C0B-4A57-9E3D-0B71C4A8F015" ?>
  <?else?>
    <?define UpgradeGuid = "70CB9791-A58B-444F-8153-63DB32CE7235" ?>
  <?endif?>

  <Package Name="circuitRF"
           Manufacturer="potatobeanradio"
           Version="$(var.Version)"
           UpgradeCode="$(var.UpgradeGuid)"
           Scope="$(var.Scope)">

    <MediaTemplate EmbedCab="yes" />

    <!-- License page, install-location page, and a feature tree with the optional desktop shortcut. -->
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of circuitRF is already installed." />

    <!-- The icon Add/Remove Programs shows. Built from the SVG by tools/IconGen. -->
    <!-- The Id extension must match the source file type, or the icon silently does not appear. -->
    <Icon Id="circuitRFIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="circuitRFIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/potatobeanradio/circuitRF" />

    <!-- ═══ DIRECTORIES ═══════════════════════════════════════════════════════ -->

    <?if $(var.Scope) = "perUser" ?>
      <!--
        %LOCALAPPDATA%\Programs\circuitRF — the same place VS Code's User Installer and other
        silently-updating applications live, and for the same reason: the running user can write it.
        INSTALLFOLDER holds the stub and `current`; APPFOLDER is app-<version>, and Files.wxs is
        harvested into it rather than into INSTALLFOLDER.
      -->
      <StandardDirectory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="circuitRF">
            <Directory Id="APPFOLDER" Name="app-$(var.VersionText)" />
            <Directory Id="STAGINGFOLDER" Name="staging" />
          </Directory>
        </Directory>
      </StandardDirectory>
    <?else?>
      <StandardDirectory Id="ProgramFiles6432Folder">
        <Directory Id="INSTALLFOLDER" Name="circuitRF" />
      </StandardDirectory>
    <?endif?>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="circuitRF">
        <Component Id="StartMenuShortcutComp">
          <Shortcut Id="StartMenuShortcut"
                    Name="circuitRF"
                    Description="RF circuit simulator — DC, S-parameters, harmonic balance, loadpull"
                    Target="[INSTALLFOLDER]circuitRF.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveAppStartMenuFolder" Directory="AppStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\circuitRF\circuitRF"
                         Name="StartMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComp">
        <Shortcut Id="DesktopShortcut"
                  Name="circuitRF"
                  Description="RF circuit simulator — DC, S-parameters, harmonic balance, loadpull"
                  Target="[INSTALLFOLDER]circuitRF.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\circuitRF\circuitRF"
                       Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ═══ THE EXECUTABLE AND ITS FILE TYPES ═════════════════════════════════ -->
    <!--
      Every other published file is harvested into Files.wxs by build-msi.ps1 — the app ships its
      user documentation and (on some builds) native DLLs beside the .exe, and a hand-written list
      goes stale the first time that set changes. Only the .exe is named here, because the shortcuts
      and the file associations have to point at it.

      The registered types are exactly the ones App.axaml.cs opens when Windows hands it a path.
      Registering one the app ignores would look to the user like a broken file.
    -->
    <?if $(var.Scope) = "perUser" ?>
      <!--
        The `current` pointer and the staging directory the updater owns. `current` is laid down by
        the installer naming the version it just installed; from then on the updater rewrites it —
        always by writing current.tmp and renaming over it, never by truncation, because a
        truncating write that fails with ENOSPC would leave the stub with nothing to run and the
        user with an application that will not start (design §13.2).
      -->
      <ComponentGroup Id="PointerAndStaging">
        <Component Id="CurrentPointerComp" Directory="INSTALLFOLDER">
          <File Id="CurrentPointer" Name="current" Source="$(var.CurrentFile)" KeyPath="yes" />
        </Component>
        <Component Id="StagingFolderComp" Directory="STAGINGFOLDER" Guid="A2D5F3C1-8B47-4E62-9C10-5F7E2A9D4B33">
          <CreateFolder />
          <RemoveFolder Id="RemoveStagingFolder" Directory="STAGINGFOLDER" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\circuitRF\circuitRF"
                         Name="StagingFolderCreated" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </ComponentGroup>
    <?endif?>

    <ComponentGroup Id="MainExecutable" Directory="INSTALLFOLDER">
      <Component Id="CircuitRfExeComp">
        <?if $(var.Scope) = "perUser" ?>
          <!--
            The STUB, not the application. It is what never changes, so shortcuts, the Start Menu
            entry and every file association below keep pointing at one path across every update.
          -->
          <File Id="CircuitRfExe" Name="circuitRF.exe" Source="$(var.StubFile)" KeyPath="yes" />
        <?else?>
          <File Id="CircuitRfExe" Source="$(var.PublishDir)\circuitRF.exe" KeyPath="yes" />
        <?endif?>

        <!--
          BOTH workspace spellings, and the second one is a fix rather than an addition: a workspace
          saved into a folder is that folder's `.cws` and `.crfw` is the standalone spelling, and
          App.OpenFiles has always opened both. Windows claimed only `crfw`, so every `.cws` on the
          machine had no owner and double-clicking one did nothing at all — the macOS plist and the
          Linux mime file had claimed both since R-h8-10.
        -->
        <ProgId Id="circuitRF.Workspace" Description="circuitRF Workspace" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="crfw" ContentType="application/x-circuitrf-workspace">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
          <!--
            No Verb here, on purpose, and it must stay that way: a Verb is registered against the
            PROGID, not against the extension. It writes HKCR\<ProgId>\shell\open and
            HKCR\<ProgId>\shell\open\command — neither key mentions `crfw` or `cws` — so a second
            copy under this same ProgId is two byte-identical registry rows, and wix build stops
            with WIX0091 on the duplicate generated identifier (it did, 2026-08-23).

            Nothing is lost. `.cws` still gets its own HKCR\.cws default value pointing at this
            ProgId, and the ProgId's single open verb is what Explorer then runs. Both extensions
            keep their own Content Type row, which IS per-extension and may safely repeat.
          -->
          <Extension Id="cws" ContentType="application/x-circuitrf-workspace" />
        </ProgId>

        <ProgId Id="circuitRF.Harmonica" Description="harmonicaRF Document" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="charm" ContentType="application/x-circuitrf-harmonica">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.WBond" Description="wBond Design" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="wBond" ContentType="application/x-circuitrf-wbond">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!--
          The document types a double-click in Explorer opens. circuitRF is the only application that
          reads any of them, so each gets its own ProgId with the Open verb pointed straight at the
          .exe: Explorer hands the path as argv, Program.cs's named pipe forwards it to an instance
          that is already running, and App.OpenFiles dispatches on the extension.

          A file that IS inside the currently open workspace opens as an ordinary document of that
          workspace; one from anywhere else opens as an orphan, marked with its own source workspace.
          Neither needs a distinction here — the marking is computed from the file's own ancestor
          .cws at open time.

          EveryDocumentTypeTheWindowsInstallerClaims_IsActuallyHandledByItsOpenFilesDispatcher fails
          the build if a ProgId is added here without a case in App.OpenFiles.
        -->
        <ProgId Id="circuitRF.Schematic" Description="circuitRF Schematic" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="csch" ContentType="application/x-circuitrf-schematic">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.Layout" Description="circuitRF Layout" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="clay" ContentType="application/x-circuitrf-layout">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.Symbol" Description="circuitRF Symbol" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="csym" ContentType="application/x-circuitrf-symbol">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.DataDisplay" Description="circuitRF Data Display" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="cdd" ContentType="application/x-circuitrf-datadisplay">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.Technology" Description="circuitRF Technology" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="ctech" ContentType="application/x-circuitrf-technology">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <ProgId Id="circuitRF.EmSetup" Description="circuitRF EM Setup" Icon="CircuitRfExe" Advertise="no">
          <Extension Id="cem" ContentType="application/x-circuitrf-emsetup">
            <Verb Id="open" Command="Open" TargetFile="CircuitRfExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

      </Component>
    </ComponentGroup>

    <!-- ═══ FEATURES ══════════════════════════════════════════════════════════ -->

    <Feature Id="MainFeature" Title="circuitRF" Description="The circuitRF application." Level="1">
      <ComponentGroupRef Id="MainExecutable" />
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="StartMenuShortcutComp" />
      <?if $(var.Scope) = "perUser" ?>
        <ComponentGroupRef Id="PointerAndStaging" />
      <?endif?>

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop Shortcut"
               Description="Add a circuitRF shortcut to the Desktop."
               Level="1">
        <ComponentRef Id="DesktopShortcutComp" />
      </Feature>
    </Feature>

  </Package>
</Wix>
