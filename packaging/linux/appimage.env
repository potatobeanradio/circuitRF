# The AppImage tools build-linux.sh packs with -- PINNED, AS DATA (brief APPIMG R-appimg-2).
#
# FORMAT: one KEY=value per line, no quotes, no spaces around '='. READ by build-linux.sh line by line,
# never sourced, the same shape as tools/geometry-worker/occt/recipe.env.
#
# Every download is named by a FIXED release (never a moving build) and by the SHA-256 of the file that
# release serves. build-linux.sh caches each one per user (~/.circuitRF-build/appimage, or
# CRF_APPIMAGE_CACHE) and re-checks the hash on EVERY use, not only after a download: a cache is a
# directory anyone with the account can write, so a hash checked once is a hash checked never. A
# mismatch is a refusal, never a re-download.
#
# Adopting a newer build is an edit here and nothing else: a new URL and the hash of the file at it.

# appimagetool runs on the BUILD machine, so the host's architecture is the one fetched. It is itself an
# AppImage; build-linux.sh runs it with APPIMAGE_EXTRACT_AND_RUN=1, so packing needs no FUSE.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_X64_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage
APPIMAGETOOL_X64_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_ARM64_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-aarch64.AppImage
APPIMAGETOOL_ARM64_SHA256=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158

# The runtime is the TARGET's: it is the ELF header the finished AppImage starts with, so it is what
# decides which machine the image runs on. Passing it with --runtime-file is what cross-builds arm64 on
# x64 and the reverse. The type-2 STATIC runtime: it carries its own FUSE client, so the image runs on a
# distribution that does not install libfuse2.
RUNTIME_VERSION=20251108
RUNTIME_X64_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
RUNTIME_X64_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
RUNTIME_ARM64_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-aarch64
RUNTIME_ARM64_SHA256=00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444

# The squashfs compressor. zstd carries no architecture-specific filter, so the same setting serves both
# images. Why zstd and not xz: packaging/RESOLVED.md, "AppImage compression".
APPIMAGE_COMPRESSION=zstd

# AppImageUpdate (delta updates for an AppImage install). build-linux.sh embeds, in every AppImage, update
# information naming the GitHub repository its releases are published to, and writes the .zsync file
# AppImageUpdate reads next to each AppImage. The release tag is derived from VERSION, never written here:
# `latest` for a stable version, `latest-all` for a prerelease (so a beta install moves on to the next
# beta, and to the stable release once one exists). Spelled owner/repository.
APPIMAGE_UPDATE_GITHUB=potatobeanradio/circuitRF
