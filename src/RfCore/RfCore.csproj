<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RfCore</RootNamespace>
    <AssemblyName>RfCore</AssemblyName>
  </PropertyGroup>

  <!-- splotRF and circuitRF need access to internal SNP helpers (CreateBroken, RefreshFrom); the expression engine
       maps a cube element by element through DataCube.MapElements -->
  <ItemGroup>
    <InternalsVisibleTo Include="splotRF" />
    <InternalsVisibleTo Include="CircuitRF.Core" />
    <InternalsVisibleTo Include="CircuitRF.Ui" />
    <InternalsVisibleTo Include="RfCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NumFlat"  Version="1.3.0" />
    <PackageReference Include="PureHDF" Version="2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Diagnostics/CircuitRF.Diagnostics.csproj" />
  </ItemGroup>

</Project>
