<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE PROCESS ENTRY POINT, AND NOTHING ELSE. Every verb lives in src/Cli.Verbs, which compiles the
    other files in this folder where they stand (see that project for why they did not move). This
    project is `CircuitRF.Cli.dll` — what `dotnet run` on src/Cli, every CLI test and every build
    script launches — and it is one line: CliEntry.Run(args).

    The installed `circuitRF` executable is the SAME CliEntry.Run reached through src/Ui's
    Program.Main (brief-automation-13-installed-cli.md R-aut13-1); this one is the developer's and
    the tests' front door to it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cli.Verbs\CircuitRF.Cli.Verbs.csproj" />
  </ItemGroup>

</Project>
