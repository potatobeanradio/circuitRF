<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE PROCESS ENTRY POINT, AND NOTHING ELSE. Every verb lives in src/Cli.Verbs, which compiles the
    other files in this folder where they stand (see that project for why they did not move). This
    project is `CircuitRF.Cli.dll` — what `dotnet run` on src/Cli, every CLI test and every build
    script launches — and it is one line: CliEntry.Run(args).

    The installed `circuitRF` executable is the SAME CliEntry.Run reached through src/Ui's
    Program.Main (brief-automation-13-installed-cli.md R-aut13-1); this one is the developer's and
    the tests' front door to it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cli.Verbs\CircuitRF.Cli.Verbs.csproj" />
  </ItemGroup>

  <!--
    LINUX'S NATIVE SkiaSharp, NAMED OUTRIGHT. The SkiaSharp package brings only its Windows and macOS
    natives; src/Ui gets the Linux one through Avalonia.Skia, and nothing gave it to this process, so on
    Linux every verb that draws or reads a picture died with "Unable to load shared library
    'libSkiaSharp'". The version is the one Avalonia.Skia resolves for src/Ui, so the CLI and the
    application load the same native library and the byte-identity gates compare like with like.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4-preview.1.1" />
  </ItemGroup>

</Project>
