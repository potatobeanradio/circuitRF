{
  "$schema": "./recipe.schema.json",
  "comment": "brief-emi-2 R-emi2-1. uv, a pinned Python and a hash-locked EMerge, all inside the home: no system Python is read or changed. The lock lines are tools/EmergeLock/make_locks.py's output.",
  "id": "emerge-3.0.0-macos-x64",
  "tool": "emerge",
  "version": "3.0.0",
  "platform": "macos",
  "architecture": "x64",
  "layout": "in-place",
  "layoutNote": "The environment's python is a link to the interpreter by absolute path, and its pyvenv.cfg names that interpreter's folder the same way (measured on macOS arm64), so the home cannot be renamed into place and is built where it stays.",
  "sources": [
    {
      "id": "uv",
      "url": "https://github.com/astral-sh/uv/releases/download/0.12.24/uv-x86_64-apple-darwin.tar.gz",
      "fetchedBy": "circuitRF",
      "file": "uv-x86_64-apple-darwin.tar.gz",
      "sha256": "4fa82e37cb94767661f532b001e470b67a186c7260e305bd84ddb78fd545c0b6"
    },
    {
      "url": "https://github.com/astral-sh/python-build-standalone/releases",
      "fetchedBy": "uv",
      "sha256": null,
      "checksumNote": "uv 0.12.24 checks the Python 3.13.16 archive it downloads against the SHA-256 it carries for that build"
    },
    {
      "url": "https://pypi.org/simple/",
      "fetchedBy": "uv",
      "sha256": null,
      "checksumNote": "every package is pinned to an exact version and checked against the SHA-256 hashes in requirements.lock, which this recipe writes; uv refuses a file whose hash is not listed"
    }
  ],
  "prerequisites": [],
  "environment": {
    "UV_PYTHON_INSTALL_DIR": "${home}/python",
    "UV_CACHE_DIR": "${home}/uv-cache"
  },
  "clearEnvironment": [
    "PYTHON*",
    "VIRTUAL_ENV",
    "CONDA_PREFIX",
    "UV_*",
    "PIP_*"
  ],
  "consentNotes": [
    "EMerge is free software under the GNU General Public License, version 2 or later, and so is Gmsh, which it meshes with; circuitRF starts them as separate programs and distributes neither.",
    "On this platform EMerge's own dependencies include a vendor's multi-threaded sparse-solver library, distributed under that vendor's proprietary licence; by installing EMerge you accept its terms.",
    "EMerge's macOS sparse solver, which comes with it from macOS 15, is under the MIT licence; circuitRF distributes nothing."
  ],
  "steps": [
    {
      "name": "Download uv 0.12.24",
      "kind": "download",
      "source": "uv"
    },
    {
      "name": "Unpack uv",
      "kind": "extract",
      "source": "uv",
      "into": "${home}/uv"
    },
    {
      "name": "Install Python 3.13.16",
      "kind": "run",
      "command": "${home}/uv/uv-x86_64-apple-darwin/uv",
      "arguments": [
        "python",
        "install",
        "cpython-3.13.16-macos-x86_64-none",
        "--install-dir",
        "${home}/python",
        "--no-bin",
        "--no-registry",
        "--no-config"
      ],
      "comment": "--no-bin and --no-registry keep uv from adding a python command to ~/.local/bin or registering the interpreter with Windows: the interpreter lives in the home and nowhere else."
    },
    {
      "name": "Create the Python environment",
      "kind": "run",
      "command": "${home}/uv/uv-x86_64-apple-darwin/uv",
      "arguments": [
        "venv",
        "${home}/env",
        "--python",
        "${home}/python/cpython-3.13.16-macos-x86_64-none/bin/python3.13",
        "--no-config"
      ]
    },
    {
      "name": "Write the locked requirements",
      "kind": "write",
      "path": "${home}/requirements.lock",
      "lines": [
        "# Written by circuitRF's install assistant from recipe ${recipeId}: EMerge and every package it needs, each at",
        "# an exact version with the SHA-256 of every file this platform may install (uv pip compile --generate-hashes).",
