        "rich==15.0.0 --hash=sha256:33bd4ef74232fb73fe9279a257718407f169c09b78a87ad3d296f548e27de0bb",
        "rich-rst==2.2.0 --hash=sha256:1ea1c43813dc4a8d86475fce27ffb74e0ada3d4656c9f8130ba2a59868055fe9",
        "scipy==1.18.1 --hash=sha256:3ab3523da44749156e1f68b464dc56af11ae4cbc5c739a49d05f32b982eca9f3 --hash=sha256:75b00eb8fb802090aa903f4ea1c7f5a584779f967361e68b7e98e531cc2d7174",
        "scooby==0.12.1 --hash=sha256:4e3e474a3542fd1d19d775cea70d19ce58a005102c0206955dddbbd33f07eb4e",
        "tbb==2021.10.0 --hash=sha256:5049f3be64664897f33ac1474a1bb1cfa45274cd8f4541e91fee4eda5c4165b5",
        "typing-extensions==4.16.0 --hash=sha256:481caa481374e813c1b176ada14e97f1f67a4539ce9cfeb3f350d78d6370c2e8",
        "tzdata==2026.6 --hash=sha256:0a10eec6e13ef16b627fabed9a5f2ba61a62b1c67f327305f4e7e412a70b4aec",
        "urllib3==2.8.0 --hash=sha256:0cf3cae568d36aa9576b28dfb35f11328f1cb974ca7647d9475ebb86c75ac6e3",
        "vtk==9.7.2 --hash=sha256:7e63af5118db0875492681cd3b647ae3284cde45635b02375a3147774c0947db",
        "emerge-aasds==0.4.0 ; platform_release >= \"24\" --hash=sha256:410b4f6a1bcc8e4499bd3945acbc2ca5ca535b6b7ec4a87d5a3836e022ab07b1"
      ]
    },
    {
      "name": "Install EMerge 3.0.0",
      "kind": "run",
      "command": "${home}/uv/uv-x86_64-apple-darwin/uv",
      "arguments": [
        "pip",
        "install",
        "--python",
        "${home}/env/bin/python",
        "--require-hashes",
        "--no-build",
        "--link-mode",
        "copy",
        "--compile-bytecode",
        "--no-config",
        "--no-deps",
        "-r",
        "${home}/requirements.lock"
      ],
      "comment": "--require-hashes refuses any file the lock does not name; --no-build refuses anything that would compile; --compile-bytecode spends the start-up a first run would otherwise pay. --no-deps: the lock names everything, and EMerge's macOS sparse solver only from macOS 15, whose wheel an older macOS cannot install (tools/EmergeLock/make_locks.py)."
    },
    {
      "name": "Check that EMerge imports",
      "kind": "run",
      "command": "${home}/env/bin/python",
      "arguments": [
        "-I",
        "-c",
        "import emerge; print(emerge.__version__)"
      ],
      "captureAs": "emerge",
      "expect": "3.0.0",
      "comment": "-I: the user's PYTHONPATH and site-packages play no part. A broken environment fails here, not at the first run."
    },
    {
      "name": "Clear uv's download cache",
      "kind": "run",
      "command": "${home}/uv/uv-x86_64-apple-darwin/uv",
      "arguments": [
        "cache",
        "clean",
        "--no-config"
      ],
      "comment": "The cache roughly doubles the home's size and nothing reads it again."
    }
  ],
  "program": "${home}/env/bin/python",
  "measured": {
    "minutes": null,
    "diskGB": null,
    "source": "not yet measured on an x64 Mac; the macOS arm64 install took 2.3 min and 1.02 GB"
  },
  "knownFailures": []
}
