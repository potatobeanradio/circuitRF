        "cyclopts==5.3.3 --hash=sha256:b16ae3619f9447f6b7e42834586e2def254b940ce0b39f82eaf3cfee788a924f",
        "docstring-parser==0.18.0 --hash=sha256:b3fcbed555c47d8479be0796ef7e19c2670d428d72e96da63f3a40122860374b",
        "emerge==3.0.0 --hash=sha256:8b436d4f13b4590511fae9b99cf05477d98c2872f3f844a2395a17bce9fde1e6",
        "emsutil==1.1.5 --hash=sha256:9f50833c1853a17a2f66209d10edc728edb415747b9d9d5ffb8129128dbfa161",
        "fonttools==4.68.0 --hash=sha256:86d319a1feedfc75c8ff582d947b21fa1854e2829cb8cf9428784d750a05f1d9 --hash=sha256:d76f8fdcb6936f5e1045a0c9dd721a4bf11112e60d1e243bfa1d39f06a8b3104 --hash=sha256:f15de48b82a816c72f358e772792801bd3788a156caa76e1806cb0aa8148cd61",
        "gmsh==4.15.2 --hash=sha256:9f5a97b6633e40be331cb777ab571cef96e6ff5979bb7b20aad2438724ca417b",
        "idna==3.20 --hash=sha256:ab7ae7122974553370f0bdb919e1a960b2cd1bc1ef0276416d896db81c14582c",
