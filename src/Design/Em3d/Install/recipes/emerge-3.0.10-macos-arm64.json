{
  "$schema": "./recipe.schema.json",
  "comment": "brief-emi-2 R-emi2-1. uv, a pinned Python and a hash-locked EMerge, all inside the home: no system Python is read or changed. The lock lines are tools/EmergeLock/make_locks.py's output. EMerge's macOS sparse solver comes as a wheel from macOS 15, and since EMerge 3.0.8 so does its GPU sparse solver (SPARTA), so nothing is built here any more.",
  "id": "emerge-3.0.10-macos-arm64",
  "tool": "emerge",
  "version": "3.0.10",
  "platform": "macos",
  "architecture": "arm64",
  "layout": "in-place",
  "layoutNote": "The environment's python is a link to the interpreter by absolute path, and its pyvenv.cfg names that interpreter's folder the same way (measured on macOS arm64), so the home cannot be renamed into place and is built where it stays.",
  "sources": [
    {
      "id": "uv",
      "url": "https://github.com/astral-sh/uv/releases/download/0.12.24/uv-aarch64-apple-darwin.tar.gz",
      "fetchedBy": "circuitRF",
      "file": "uv-aarch64-apple-darwin.tar.gz",
      "sha256": "0c4346de7abdb49495b393b9ec809fe387aa43e586be20fecb972216c1e71732"
    },
    {
      "url": "https://github.com/astral-sh/python-build-standalone/releases",
      "fetchedBy": "uv",
      "sha256": null,
      "checksumNote": "uv 0.12.24 checks the Python 3.13.16 archive it downloads against the SHA-256 it carries for that build"
    },
    {
      "url": "https://pypi.org/simple/",
      "fetchedBy": "uv",
      "sha256": null,
      "checksumNote": "every package is pinned to an exact version and checked against the SHA-256 hashes in requirements.lock, which this recipe writes; uv refuses a file whose hash is not listed"
    }
  ],
  "prerequisites": [],
  "environment": {
    "UV_PYTHON_INSTALL_DIR": "${home}/python",
    "UV_CACHE_DIR": "${home}/uv-cache"
  },
  "clearEnvironment": [
    "PYTHON*",
    "VIRTUAL_ENV",
    "CONDA_PREFIX",
    "UV_*",
    "PIP_*"
  ],
  "consentNotes": [
    "EMerge is free software under the GNU General Public License, version 2 or later, and so is Gmsh, which it meshes with; circuitRF starts them as separate programs and distributes neither.",
    "EMerge's macOS sparse solver, which comes with it from macOS 15, is under the MIT licence; circuitRF distributes nothing.",
    "EMerge's sparse solvers SPARTA (its first choice, CPU and GPU) and CORVID (iterative, for a model a direct solve cannot fit in memory) come with it as wheels and are under the GNU Affero General Public License, version 3 or later; EMerge runs them in its own process, and circuitRF distributes nothing."
  ],
  "steps": [
    {
      "name": "Download uv 0.12.24",
      "kind": "download",
      "source": "uv"
    },
    {
      "name": "Unpack uv",
      "kind": "extract",
      "source": "uv",
      "into": "${home}/uv"
    },
    {
      "name": "Install Python 3.13.16",
      "kind": "run",
      "command": "${home}/uv/uv-aarch64-apple-darwin/uv",
      "arguments": [
        "python",
        "install",
        "cpython-3.13.16-macos-aarch64-none",
        "--install-dir",
        "${home}/python",
        "--no-bin",
        "--no-registry",
        "--no-config"
      ],
      "comment": "--no-bin and --no-registry keep uv from adding a python command to ~/.local/bin or registering the interpreter with Windows: the interpreter lives in the home and nowhere else."
    },
    {
      "name": "Create the Python environment",
      "kind": "run",
      "command": "${home}/uv/uv-aarch64-apple-darwin/uv",
      "arguments": [
        "venv",
        "${home}/env",
        "--python",
        "${home}/python/cpython-3.13.16-macos-aarch64-none/bin/python3.13",
        "--no-config"
      ]
    },
    {
      "name": "Write the locked requirements",
      "kind": "write",
      "path": "${home}/requirements.lock",
      "lines": [
        "# Written by circuitRF's install assistant from recipe ${recipeId}: EMerge and every package it needs, each at",
        "# an exact version with the SHA-256 of every file this platform may install (uv pip compile --generate-hashes).",
