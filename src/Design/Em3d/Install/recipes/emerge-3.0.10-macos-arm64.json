        "cycler==0.12.1 --hash=sha256:85cef7cff222d8644161529808465972e51340599459b8ac3ccbac5a854e0d30",
        "cyclopts==5.5.2 --hash=sha256:4fbe863ebace1c65dafc6520c82217915b103d27fbd1d8fcd168f2abcca3a12a",
        "docstring-parser==0.18.0 --hash=sha256:b3fcbed555c47d8479be0796ef7e19c2670d428d72e96da63f3a40122860374b",
        "emerge==3.0.10 --hash=sha256:761942a09ed86cde714a36ffd7805100aacf4a1d3651b156ebe1985f71d9aacd",
        "emsutil==1.1.7 --hash=sha256:398299a1bfc97f1d4b1486cffa54546073a44b4216c9aee2add834d666b11848",
