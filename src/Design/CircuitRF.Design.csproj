<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CircuitRF.Design — the design-layer ARTIFACTS an EM problem is built from, and the code that
    turns them into one (docs/sonnet-briefs/brief-cli-em-verb.md R-emcli-1).

    WHAT LIVES HERE: the layout model and its `.clay` reader, the technology model and its `.ctech`
    reader, the cell-folder format (`.ccell`) both of those resolve through, the `.cem` EM setup, and
    the extractors that turn geometry + stackup into an `EmProblem`.

    WHAT MUST NOT: anything that draws, docks, undoes, or observes a canvas. This project is on the
    far side of the UI firewall and tests/Firewall.Tests asserts it references no Avalonia —
    transitively, exactly as it does for Core/Engine/RfCore/Cli. A project that starts clean and is
    not gated does not stay clean.

    WHY IT IS NOT `src/Core`: Core is the CIRCUIT design layer — cells as netlists, parameters,
    expressions, elaboration into a numbered netlist. This is the DOCUMENT layer for artwork: the
    files a layout editor and an EM setup are stored in, and their readers. Core knows nothing about
    DBU, stackups or drawing layers, and nothing here elaborates a netlist.

    The dependency runs ONE way: src/Ui consumes this, never the reverse. src/Cli consumes it too —
    that is what makes `circuitrf em` possible without a second copy of the layout reader.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/CircuitRF.Core.csproj" />
    <ProjectReference Include="../Engine/CircuitRF.Engine.csproj" />
    <ProjectReference Include="../RfCore/RfCore.csproj" />
    <!-- brief-em3d-74: the thermal solver, which Design/Thermal's run service lowers a .c3d for and calls. -->
    <ProjectReference Include="../Thermal/CircuitRF.Thermal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Polygon booleans/offsets for the layout model's own flatten/boolean paths. Managed C#,
         Boost licence, integer coordinates matching our DBU storage type — already a src/Ui
         dependency before this project existed, and it moves with the code that uses it. -->
    <PackageReference Include="Clipper2" Version="1.5.4" />

    <!-- Glyph outlines for LayoutTextOutline — the one thing in this project that needs a font
         engine, and the reason `circuitrf convert` can flatten a label to polygons headlessly.
         SkiaSharp is explicitly ALLOWED across the UI firewall (tests/Firewall.Tests: headless 2D
         graphics is not a UI framework); the Avalonia-bound part, loading the embedded IBM Plex
         faces, stays in src/Ui behind LayoutTextOutline.TypefaceSource. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <!-- Shipped default technologies (docs/sonnet-briefs/brief-misc-termg-units-technologies.md §3,
       R-misc-6) — real .ctech files, embedded as plain-text .NET resources (NOT AvaloniaResource:
       ShippedTechnologies.cs is framework-free and must be readable via Assembly.
       GetManifestResourceStream in headless tests, which have no live Avalonia platform for
       AssetLoader to run against). Read at runtime through the SAME TechPersistence reader user files
       use (R-misc-7) — never hand-transcribed into C#.

       They live HERE rather than in src/Ui because `circuitrf new workspace` copies one into the
       workspace it creates, and the class that reads them reads them out of its OWN assembly
       (brief-automation-3-authoring-verbs.md R-aut3-4: move the resources with the class, or the
       class compiles, enumerates nothing, and reports nothing). -->
  <ItemGroup>
    <EmbeddedResource Include="resources\technologies\*.ctech" />
    <!-- brief-em3d-53 R-em3d53-8a: the shipped generic material library, BESIDE the technologies that
         name it, so their reference "generic-materials.cmat" is true in the assembly and in a
         workspace's tech/ folder alike. Left out of this glob, every shipped technology would refuse
         to load, naming the library it could not find. -->
    <EmbeddedResource Include="resources\technologies\*.cmat" />
  </ItemGroup>

  <!-- brief-silkscreen-stroke-font R-ssf-1: the stroke font every layout label is drawn in, read by StrokeFont out of
       this assembly under a fixed name; GlyphTemplates takes AS-10's matching templates out of the same copy. Its
       licence file sits beside it in the tree. -->
  <ItemGroup>
    <EmbeddedResource Include="resources\stroke-font\hershey-roman-simplex.txt"
                      LogicalName="CircuitRF.Design.StrokeFont.hershey-roman-simplex.txt" />
  </ItemGroup>

  <!-- brief-artsch-10 R-as10-3: the variants of the stroke font CAD plotter fonts draw instead — matching templates
       for the silkscreen reader, never drawn. -->
  <ItemGroup>
    <EmbeddedResource Include="resources\silkscreen-glyphs\hershey-variants.txt"
                      LogicalName="CircuitRF.Design.SilkscreenGlyphs.hershey-variants.txt" />
  </ItemGroup>

  <!-- brief-img-8 R-im8-2: the drawings other conventions use for a schematic symbol, one stroke file each, read by
       SymbolTemplates under the prefix below. Adding a drawing is adding a file: the glob takes it. -->
  <ItemGroup>
    <EmbeddedResource Include="resources\image-symbol-templates\*.stroke"
                      LogicalName="CircuitRF.Design.ImageSymbolTemplates.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- brief-em3d-24 R-em3d24-1: the solver install recipes and their schema, read by SolverRecipes out of
       this assembly. The LogicalName is fixed so a recipe's resource name is its file name, which is what
       SolverInstallTests validates against the schema. A recipe file left out of this glob would compile,
       enumerate nothing and install nothing. -->
  <ItemGroup>
    <EmbeddedResource Include="Em3d\Install\recipes\*.json"
                      LogicalName="CircuitRF.Design.Em3d.Install.recipes.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- brief-em3d-63 R-em3d63-2b: the geometry kernel's recipe, read IN PLACE (brief 62's single copy), so the
       client pins exactly the OCCT version the worker was built from and knows which RIDs ship it. A second
       copy of the version here would be a third place to forget when the recipe moves (VERSION's rule). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\geometry-worker\occt\recipe.env"
                      LogicalName="CircuitRF.Design.ThreeD.Occ.recipe.env" />
  </ItemGroup>

  <!-- The reference pages `circuitrf reference` serves
       (docs/sonnet-briefs/brief-automation-6-reference-and-components.md R-aut6-5/R-aut6-6).

       Referenced IN PLACE from docs/user/src/reference/ rather than copied into this project: a copy
       is a file that will be edited on one side only, and nothing would report the drift. The
       authored bytes are what is embedded — the YAML front matter and the docs factory's {{…}}
       placeholders are stripped at READ, in ReferenceLibrary, so the two sides stay byte-identical
       and ReferenceLibraryTests can compare them.

       The LogicalName is explicit because these files live outside this project's own cone, where
       MSBuild's default manifest name is derived from a relative path nobody should have to predict.

       They live HERE and not in src/Cli for ShippedTechnologies' reason: this is where the
       framework-free readers of shipped content live, and Assembly.GetManifestResourceStream works
       with no live platform where Avalonia's AssetLoader throws. ADD A TOPIC AND ITS ITEM TOGETHER —
       a class shipped without its resources compiles, enumerates nothing and reports nothing. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\user\src\reference\netlist.md"
                      LogicalName="CircuitRF.Design.Reference.netlist.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\expressions.md"
                      LogicalName="CircuitRF.Design.Reference.expressions.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\units.md"
                      LogicalName="CircuitRF.Design.Reference.units.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\measurements.md"
                      LogicalName="CircuitRF.Design.Reference.measurements.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\pins-ports-terms.md"
                      LogicalName="CircuitRF.Design.Reference.pins-ports-terms.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\sdd.md"
                      LogicalName="CircuitRF.Design.Reference.sdd.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\file-formats.md"
                      LogicalName="CircuitRF.Design.Reference.file-formats.md" />
    <EmbeddedResource Include="..\..\docs\user\src\reference\components.md"
                      LogicalName="CircuitRF.Design.Reference.components.md" />
  </ItemGroup>

  <ItemGroup>
    <!--
      circuitRF's OWN Python package (circuitrf_pcell + cni), beside the executable.

      It lives HERE, with PCellPythonPackage, since brief-generated-cells-2 moved that class out of
      src/Ui (R-gc2-1): a class moved without its files finds nothing. It was in src/Ui's project,
      which left `src/Cli`'s own build with no copy, so its resolver walked up to the SOURCE tree and
      hashed the example and conformance scripts too - a kit's cell got a different name headless than
      in the application, and a CLI run rebuilt, under a new name, artwork the GUI had already drawn.
      A ProjectReference copies this item into every consumer's output, so there is one copy rule.

      A kit's generator script starts with `import circuitrf_pcell`, and PCellPythonPackage puts the
      directory holding it on the interpreter's path. That resolver looks BESIDE THE EXECUTABLE first
      and only then walks up for a `tools/pcell-python` source tree - so in a development build the
      walk-up found it and nothing here was missed, while every packaged build shipped without it.

      Measured, not supposed: an installed /Applications/circuitRF.app contained no copy at all, and
      importing a kit ended at

          File ".../kit_entry.py", line 7, in <module>
            import circuitrf_pcell as crf
          ModuleNotFoundError: No module named 'circuitrf_pcell'

      with every one of that kit's cells drawing as a placeholder. This is the same class of bug as
      CrfPublishHelperPrograms below - a kit whose artwork generates fine under `dotnet run` and not
      on an installed copy - and it is fixed the same way: ship the thing.

      The glob is rooted at pcell-python/ rather than at each package, because %(RecursiveDir) begins
      after the `**` and a per-package Include would flatten `circuitrf_pcell/__init__.py` to
      `__init__.py` - a directory of loose modules that is not an importable package. Only `.py` is
      taken, which is also what leaves `__pycache__` (`.pyc`) behind; the kit-author example and the
      two conformance scripts are development tools and are excluded by name.
    -->
    <None Include="../../tools/pcell-python/**/*.py"
          Exclude="../../tools/pcell-python/example/**/*.py;../../tools/pcell-python/verify.py;../../tools/pcell-python/vendor_conformance.py">
      <Link>pcell-python/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Same grant src/Ui carries, and for the same reason: the layout/EM tests live in
         tests/Ui.Tests and reach internal members of the code that used to be there. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CircuitRF.Ui</_Parameter1>
    </AssemblyAttribute>
    <!-- And the same grant to the renderers, which were IN src/Ui until RND-1 and reach the same
         internal helpers (CellHierarchy.LayoutBaseDirOf, LayoutFlattener.FlattenOpenEdgeList,
         LayoutTextOutline.ResolveLabelAnchor). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CircuitRF.Render</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CircuitRF.Ui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
