<!-- Design ▸ Create Schematic from Artwork…, and Create Schematic / Layout from Image… — ONE window
     (brief-artsch-8-gui-command.md R-as8-2, R-as8-3; brief-img-5-dialog.md R-im5-1).

     NON-MODAL. The top is the SOURCE: for artwork, the scope and the companion files of the focused layout; for a
     picture, the picture itself (ImageSourcePane). Everything below is the body every source shares — the target,
     the recognition's options, the parts table (beside the picture canvas for a picture), the report strip, the
     status line and the buttons — each a control of its own, so no row exists twice.

     No explanatory prose under readouts (overview §3): values, a short status, and a note only where there is no
     value. Each option says what it does in its tooltip. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rec="using:CircuitRF.Ui.Recognition"
        x:Class="CircuitRF.Ui.Recognition.CreateSchematicFromArtworkDialog"
        x:DataType="rec:RecognitionSessionViewModel"
        Title="{Binding Title}"
        Width="1060" Height="760"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <StyleInclude Source="avares://CircuitRF.Ui/Recognition/RecognitionDialogStyles.axaml"/>
    </Window.Styles>

    <!-- No RowSpacing: a hidden row (the picture dialog's before it has a picture) would still take its spacing. Each
         row after the first carries its own top margin instead. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="12">

        <!-- ── The source ────────────────────────────────────────────────────────────────── -->
        <ContentControl Grid.Row="0" Content="{Binding}" IsVisible="{Binding HasSource}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="rec:ImageSourceViewModel">
                    <rec:ImageSourcePane/>
                </DataTemplate>
                <!-- Artwork: the scope (D11) and the companion files. -->
                <DataTemplate DataType="rec:CreateSchematicFromArtworkViewModel">
                    <StackPanel Spacing="8">
                        <StackPanel Classes="row" Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="label" Text="Scope" Width="70"/>
                            <RadioButton GroupName="scope" Content="Selection" IsChecked="{Binding ScopeSelection}"
                                         IsEnabled="{Binding SelectionAvailable}"
                                         ToolTip.Tip="Read only the copper inside the layout's selection; a line the outline cuts becomes a port."/>
                            <RadioButton GroupName="scope" Content="Whole layout" IsChecked="{Binding ScopeWhole}"/>
                        </StackPanel>
                        <WrapPanel Classes="row" Orientation="Horizontal">
                            <TextBlock Classes="label" Text="Files" Width="70" Margin="0,0,10,0"/>
                            <Button Content="BOM…" Command="{Binding PickBomCommand}" Margin="0,0,6,0"
                                    ToolTip.Tip="A bill of materials: values, part numbers and kinds by designator."/>
                            <TextBox Text="{Binding BomPath}" Width="240" Margin="0,0,16,0" PlaceholderText="No bill of materials"/>
                            <Button Content="Placement…" Command="{Binding PickPlacementCommand}" Margin="0,0,6,0"
                                    ToolTip.Tip="A placement file: where each designator sits."/>
                            <TextBox Text="{Binding PlacementPath}" Width="240" Margin="0,0,8,0" PlaceholderText="No placement file"/>
                            <StackPanel Classes="row" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" IsVisible="{Binding PlacementNeedsOrigin}">
                                <TextBlock Classes="label" Text="Origin"/>
                                <ComboBox ItemsSource="{x:Static rec:CreateSchematicFromArtworkViewModel.PlacementOriginLabels}"
                                          SelectedIndex="{Binding PlacementOriginIndex}" MinWidth="200"
                                          PlaceholderText="Choose…"
                                          ToolTip.Tip="The file does not say which point of each part its coordinates are; it is not guessed."/>
                            </StackPanel>
                            <TextBlock Text="{Binding CompanionError}" Classes="error"/>
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <!-- ── Target (D4, D14) ──────────────────────────────────────────────────────────── -->
        <rec:RecognitionTargetRow Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding HasSource}"/>

        <!-- ── Options ───────────────────────────────────────────────────────────────────── -->
        <rec:RecognitionOptionsRow Grid.Row="2" Margin="0,8,0,0" IsVisible="{Binding OptionsApply}"/>

        <!-- ── The body: the parts table, or the picture beside it ───────────────────────── -->
        <ContentControl Grid.Row="3" Margin="0,8,0,0" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="rec:ImageSourceViewModel">
                    <rec:ImageReadingPanel/>
                </DataTemplate>
                <DataTemplate DataType="rec:CreateSchematicFromArtworkViewModel">
                    <rec:PartsTablePanel/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <!-- ── The report strip ──────────────────────────────────────────────────────────── -->
        <rec:RecognitionReportStrip x:Name="Report" Grid.Row="4" Margin="0,8,0,0" IsVisible="{Binding HasSource}"/>

        <!-- ── Status, progress, and an offer ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="5" Classes="row" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Width="90" Height="6" MinWidth="0" IsVisible="{Binding IsRecognising}"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="11" Opacity="0.8" IsVisible="{Binding IsRecognising}"/>
            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" MaxWidth="980"/>
            <StackPanel Classes="row" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasOffer}">
                <TextBlock Text="{Binding OfferText}" FontSize="12"/>
                <Button Classes="link" Content="Apply" Command="{Binding AcceptOfferCommand}" FontSize="12"/>
                <Button Classes="link" Content="Dismiss" Command="{Binding DeclineOfferCommand}" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Buttons ───────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Export Parts…" Command="{Binding ExportPartsCommand}" Margin="0,0,6,0"
                    IsVisible="{Binding PartsApply}"
                    ToolTip.Tip="Write the parts table as CSV — the file circuitrf recognize --parts reads."/>
            <Button Grid.Column="1" Content="Import Parts…" Command="{Binding ImportPartsCommand}" Margin="0,0,6,0"
                    IsVisible="{Binding PartsApply}"
                    ToolTip.Tip="Read an edited parts table back; only the Refdes, Kind, Value, Variable and Model columns change anything."/>
            <Button Grid.Column="2" Content="Learn These Glyphs" Command="{Binding LearnGlyphsCommand}"
                    IsVisible="{Binding CanLearn}"
                    ToolTip.Tip="Remember the selected part's silkscreen glyphs as the characters its corrected designator says they are."/>
            <Button Grid.Column="4" Content="Cancel" Click="OnCancelClick" Margin="0,0,6,0" MinWidth="80"/>
            <Panel Grid.Column="5">
                <Button Content="Create" Command="{Binding CreateCommand}" MinWidth="90" Classes="accent"
                        IsVisible="{Binding !IsReplace}"
                        ToolTip.Tip="{Binding CreateTip}" ToolTip.ShowOnDisabled="True"/>
                <Button Content="Replace" MinWidth="90" IsVisible="{Binding IsReplace}"
                        ToolTip.Tip="{Binding CreateTip}" ToolTip.ShowOnDisabled="True">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <StackPanel Spacing="8" MaxWidth="320">
                                <TextBlock Text="{Binding ReplaceConfirmText}" TextWrapping="Wrap"/>
                                <Button Content="Replace" Command="{Binding CreateCommand}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Panel>
        </Grid>
    </Grid>
</Window>
