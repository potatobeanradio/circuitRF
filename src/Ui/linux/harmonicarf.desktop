[Desktop Entry]
Name=harmonicaRF
Comment=Interactive load-pull instrument — drag a termination, watch the design follow
Exec=/usr/bin/harmonicarf %U
Icon=harmonicarf
Terminal=false
Type=Application
Categories=Science;Engineering;Electronics;
MimeType=application/x-harmonicarf-document;
Keywords=RF;load-pull;Smith chart;harmonic balance;PA;impedance;
StartupWMClass=harmonicaRF

# NOTE — the three applications are ONE ASSEMBLY built three times (WB40: the assembly name must stay
# CircuitRF.Ui), so every publish produces a binary called `CircuitRF.Ui`. A package installing more
# than one of them MUST rename them apart on the way in — /usr/bin/circuitrf, /usr/bin/harmonicarf,
# /usr/bin/wbond — which is what the three Exec= lines above and in the sibling files assume. On macOS
# the .app bundle name does this job; on Linux nothing does it for you.
