#!/bin/sh
# circuitRF post-remove script (Debian/Ubuntu). Mirrors postinst — see its own note on why one
# package carries three applications.
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    xdg-mime uninstall /usr/share/mime/packages/circuitrf-mime.xml || true
    update-mime-database /usr/share/mime 2>/dev/null || true

    for APP in circuitrf harmonicarf wbond; do
        xdg-desktop-menu uninstall "/usr/share/applications/${APP}.desktop" || true
        xdg-icon-resource uninstall --novendor --size 256 "$APP" || true
    done

    update-desktop-database /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
fi

#DEBHELPER#
exit 0
