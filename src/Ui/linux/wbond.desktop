[Desktop Entry]
Name=wBond
Comment=Bond-wire design and assembly rule checking
Exec=/usr/bin/wbond %U
Icon=wbond
Terminal=false
Type=Application
Categories=Science;Engineering;Electronics;
MimeType=application/x-wbond-design;
Keywords=wirebond;bond wire;packaging;inductance;assembly;DRC;
StartupWMClass=wBond

# NOTE — see harmonicarf.desktop: all three applications publish a binary called `CircuitRF.Ui`, so a
# package installing more than one MUST rename them apart on install for these Exec= lines to resolve.
