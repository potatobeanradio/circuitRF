<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CircuitRF.Ui.WBondApp"
             Name="wBond"
             RequestedThemeVariant="Default">

    <!--
      wBond's own Application (wbond.md §11, WB38 — the harmonicaRF route taken a second time).

      It is the SAME ASSEMBLY as circuitRF with a different Main and a different Application, not a
      different build of the editor. What differs is deliberately small: no workspace, no Dock
      layout, no launch action, no .crfw. What must NOT differ is the style and resource set —
      R-wbe-2, and the ways it fails are silent (omit the ColorPicker Fluent include and ColorView
      renders as an empty box with no error).

      **The wBond editor uses MORE of the shared surface than harmonicaRF does** — the Layout Editor
      canvas and renderer, the Properties dock's wire-inspector context, the DRC panel, and the
      layer/technology resolution behind the reference geometry are all application-scope resource
      consumers. So this is a superset BY CONSTRUCTION rather than by anyone remembering to mirror an
      addition: all three Applications include the SAME two files below and none of them declares an
      application-scope style or resource of its own. A structural test over the XAML pins it.
    -->

    <!-- macOS app menu. wBond has no Settings dialog of its own beyond Edit ▸ Preferences…, so About
         only. Do NOT add Quit — AppKit appends it, and adding it explicitly duplicates it. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About wBond…"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CircuitRF.Ui/Styles/CircuitRfResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="avares://CircuitRF.Ui/Styles/CircuitRfStyles.axaml"/>
    </Application.Styles>
</Application>
