<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:CircuitRF.Ui.Converters"
        xmlns:glob="using:System.Globalization"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:dockCtrl="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:dockCore="clr-namespace:Dock.Model.Core;assembly=Dock.Model">

    <!--
      THE APPLICATION-SCOPE STYLES, IN ONE PLACE BECAUSE THERE ARE TWO APPLICATIONS.

      Same rule as CircuitRfResources.axaml, and this is the half that fails SILENTLY: omit
      Avalonia.Controls.ColorPicker's Fluent theme and a ColorView renders as an empty box with no
      error anywhere (§7.9.4, and H7 met it from the other side). Both Applications include this one
      file, so the standalone binary's style set is a superset of what harmonicaRF reaches by
      construction — there is no second list that could fall behind.

      NOTE the extension on the ColorPicker include below: .xaml, NOT .axaml. That is the actual
      embedded resource name.
    -->

        <FluentTheme DensityStyle="Compact" />

        <!-- Dock.Avalonia.Themes.Fluent — provides DockControl rendering and styling.
             Resolved from Dock.Avalonia.Themes.Fluent 12.0.0.2 package. -->
        <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>

        <!-- Avalonia.Controls.ColorPicker Fluent theme (12.0.3).
             Required for ColorView/ColorPicker controls to render with templates.
             Path verified from embedded resources in Avalonia.Controls.ColorPicker.dll:
             Avalonia.Controls.ColorPicker.Themes.Fluent.Fluent.xaml -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

        <!-- Document bodies: use Dock's NON-deferred (cached) content template.
             The default 'DockDocumentControlSingleContentTemplate' wraps each document body in a
             DeferredContentControl that realizes content on a background-priority timeline. In our
             app that defers the first paint of a newly-activated document until the next layout
             pass (the canvas stayed blank/stale until a panel was toggled). The cached template
             hosts each dockable in a plain ContentControl (resolved via the App DataTemplates),
             so document bodies paint on the normal layout pass. Trade-off: all open document
             bodies are kept realized (cached) rather than lazily built — fine at our tab counts. -->
        <Style Selector="dockCtrl|DocumentControl">
            <Setter Property="Template" Value="{DynamicResource DockDocumentControlCachedContentTemplate}"/>

            <!-- brief-foreign-documents.md §4 item 3: tab header tint. Overrides the theme's own
                 default HeaderTemplate (a bare TextBlock bound to Title) with the same TextBlock
                 wrapped in a Border whose Background tints amber for a foreign document — never red
                 (R-fgn-7), never touching rendered geometry. x:CompileBindings="False" because the
                 declared DataType is the IDockable interface, but the runtime item may be any
                 concrete Document type; only LayoutDocument actually declares IsForeign today — every
                 other document type binds null here and renders untinted, exactly like a
                 workspace-bound LayoutDocument. -->
            <Setter Property="HeaderTemplate">
                <DataTemplate x:CompileBindings="False" DataType="dockCore:IDockable">
                    <Border Background="{Binding IsForeign, Converter={x:Static conv:ForeignDocumentTintConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Padding="{DynamicResource DockHeaderContentPadding}"/>
                            <!-- RC-2 R-rc2-5: this file lives in a workspace the open one references
                                 EDITABLY, so saving it writes into another project. Bound the same
                                 x:CompileBindings="False" way IsForeign above is: the declared
                                 DataType is IDockable, and only the document types a referenced
                                 workspace's sub-tree can open (schematic, symbol, layout, cell
                                 parameters) declare the property at all.

                                 FallbackValue=False IS THE WHOLE FIX, and its absence was an
                                 owner-reported bug (2026-09-07: every .cdd Data Display tab carried
                                 the pencil). The comment that used to sit here said every other
                                 document type "binds null here and renders unmarked", which is the
                                 wrong model: a MISSING property is not null, it is UnsetValue, and a
                                 property left unset takes its DEFAULT — and IsVisible's default is
                                 TRUE. So the mark appeared on exactly the tabs that cannot be
                                 referenced at all (Data Display, harmonicaRF, technology, EM setup),
                                 which is the opposite of what it means.

                                 IsForeign above escapes this only because it goes through a
                                 converter to a Background, where unset is transparent either way —
                                 so it is not the precedent it looks like. Any future binding here
                                 onto a property some document types lack needs this too.

                                 Never an error colour (§5A.4): it is an unusual state somebody
                                 chose, not a fault. -->
                            <mi:MaterialIcon Kind="PencilOutline"
                                             Width="11" Height="11"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource CrfWarningBrush}"
                                             ToolTip.Tip="This cell belongs to a referenced workspace that is editable from here. Saving writes into that workspace."
                                             IsVisible="{Binding IsEditableReference, FallbackValue=False}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Material Icons -->
        <mi:MaterialIconStyles/>

        <!-- ── Dock region backgrounds ──────────────────────────────────────
             The DockFluentTheme defaults to SystemAltHighColor (pure white / pure black).
             Override to SystemChromeLowColor (~#F2F2F2 light / ~#171717 dark) so panels
             feel like part of the window chrome, not a harsh contrast surface. -->
        <Style Selector="dockCtrl|ToolControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>

            <!-- CrfToolControlCachedContentTemplate — TOOL analog of DockDocumentControlCachedContentTemplate.
                 The package ToolControl ControlTheme (Dock.Avalonia.Themes.Fluent 12.0.0.2) wraps
                 the active dockable in DeferredContentControl+ControlRecyclingDataTemplate. On tab
                 switch the deferred control retains the existing realized view and only updates
                 DataContext; views with x:DataType compiled bindings silently no-op on the wrong type
                 → stale fallback content ("No workspace open").
                 This template reproduces the full package chrome extracted from the ControlTheme
                 (ToolTabStrip at DockPanel.Dock="Bottom"; Border with DockSurfacePanelBrush /
                 DockBorderSubtleBrush / BorderThickness "1 0 1 0"; PART names preserved) but replaces
                 DeferredContentControl with a plain ContentControl. Avalonia re-resolves the App
                 DataTemplate on each Content change, realizing the correct view for the new active
                 dockable type on every tab switch.
                 x:CompileBindings="False": the DataContext is set at runtime by Dock (to the ToolDock
                 model); no fixed x:DataType is available. DockProperties/ToolTabStrip/DockableControl
                 are in the default Avalonia xmlns (registered by Dock.Avalonia) — no prefix needed.
                 On Dock upgrades: re-extract the ToolControl ControlTheme and mirror its chrome here;
                 change only PART_ContentPresenter (DeferredContentControl → plain ContentControl). -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:CompileBindings="False" TargetType="dockCtrl:ToolControl">
                        <DockPanel x:Name="PART_DockPanel"
                                   Background="Transparent"
                                   ZIndex="1"
                                   DockProperties.IsDropArea="True"
                                   DockProperties.IsDockTarget="True">
                            <ToolTabStrip x:Name="PART_TabStrip"
                                          ItemsSource="{Binding VisibleDockables}"
                                          SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                                          IconTemplate="{TemplateBinding IconTemplate}"
                                          HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                          ModifiedTemplate="{TemplateBinding ModifiedTemplate}"
                                          DockPanel.Dock="Bottom"
                                          DockProperties.IsDropArea="True"
                                          DockProperties.DockAdornerHost="{Binding ElementName=PART_DockPanel}"/>
                            <Border x:Name="PART_Border"
                                    ZIndex="-1"
                                    Background="{DynamicResource DockSurfacePanelBrush}"
                                    Margin="0"
                                    BorderBrush="{DynamicResource DockBorderSubtleBrush}"
                                    BorderThickness="1 0 1 0">
                                <DockableControl DataContext="{Binding ActiveDockable}"
                                                 TrackingMode="Visible">
                                    <ContentControl x:Name="PART_ContentPresenter"
                                                    Content="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"/>
                                </DockableControl>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Floating TOOL window title bar: remove the chrome menu (Float / Dock / Dock as Tabbed
             Document). Owner-reported: on a floating tool window those items do nothing, and "Dock"
             is permanently disabled — a menu that cannot act violates R13a (act, or say why), so it
             is removed rather than left as decoration.

             SCOPED TO :floating ON PURPOSE. ToolChromeControl also provides the chrome for DOCKED
             tool panels, where Float does real work; a blanket removal would delete a working
             affordance to fix a broken one. ToolChromeControl sets IsFloating (and hence the
             :floating pseudo-class) when it finds itself hosted in a HostWindow, so this matches
             exactly the case the owner reported.

             MenuButtonTheme is the control's own public hook for theming that button (there is no
             DockSettings flag for it — checked). Replacing it with a theme that is simply not
             visible removes the button, and with it the flyout, without overriding the whole chrome
             template the way DocumentControl/ToolControl above have to. -->
        <Style Selector="dockCtrl|ToolChromeControl:floating">
            <Setter Property="MenuButtonTheme">
                <ControlTheme TargetType="Button">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </ControlTheme>
            </Setter>
        </Style>

        <Style Selector="dockCtrl|DocumentDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>

        <!-- ══ THE EMPTY DOCUMENT AREA — the Welcome page's icon, and nothing else ═══════════════
             Owner request: with no documents open, show the icon from the Welcome page on its own —
             no text, not even "Welcome to circuitRF". (The Welcome document page itself is
             untouched; this is only what fills the area when there is no document at all.)

             WHAT IT REPLACES: Dock.Model.Mvvm's DocumentDock.EmptyContent defaults to the literal
             string "No documents open" — that string is in the package, not in this repo, which is
             why it cannot be found by grepping for it here. The Fluent theme's DocumentControl
             template puts it in PART_EmptyContentHost, whose ContentTemplate is template-bound to
             DocumentControl.EmptyContentTemplate; a template set here therefore wins over whatever
             the model carries, and does so for EVERY document dock — including the ones Dock's own
             tab context menu creates (New Horizontal/Vertical Document Dock), which this repo never
             constructs and so could not fix at the model end.

             Our own three document docks additionally set EmptyContent = null (see
             CircuitRfDockFactory), so the string is gone from the model too and the failure mode, if
             this template is ever lost to a Dock upgrade, is an empty area rather than the old text
             quietly coming back.

             The icon is deliberately the same MaterialIcon, size, brush and opacity as
             Views/Content/StubContentView.axaml's — it IS the Welcome page's icon, not a copy that
             can drift. -->
        <Style Selector="dockCtrl|DocumentControl">
            <Setter Property="EmptyContentTemplate">
                <DataTemplate>
                    <mi:MaterialIcon Kind="IntegratedCircuitChip"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                     Opacity="0.4"/>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- The same, for the MDI layout mode the tab context menu can switch the area into. -->
        <Style Selector="dockCtrl|MdiDocumentControl">
            <Setter Property="EmptyContentTemplate">
                <DataTemplate>
                    <mi:MaterialIcon Kind="IntegratedCircuitChip"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                     Opacity="0.4"/>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="dockCtrl|RootDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>
        <Style Selector="dockCtrl|ProportionalDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>
        <Style Selector="dockCtrl|PinnedDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>

        <!-- Toolbar icons: soften from SystemBaseHighColor (~87% black) to SystemBaseMediumColor (~60%).
             MaterialIcon.Foreground does not inherit via TextElement.Foreground, so a descendant
             style targeting the StackPanel.Toolbar class is required. -->
        <Style Selector="StackPanel.Toolbar mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>

        <!-- Panel toggles in a toolbar (the workspace toolbar's Library / Properties / Messages
             buttons): FLAT while unchecked, so they sit with the plain toolbar buttons beside them,
             and the theme's own checked chrome — an accent fill — when their panel is on screen.

             Two deliberate choices:
               • the flat background is set from a STYLE, not as a local value on each button like the
                 plain toolbar buttons use. A local value outranks a style setter (LocalValue beats
                 Style), so a local Background="Transparent" would also win against the theme's
                 :checked and :pointerover fills and the button would never look checked at all.
               • the checked FILL is left to the theme rather than overridden, so it follows the active
                 accent; only the icon is re-coloured, because the toolbar icon rule above paints every
                 icon 60% grey and that is unreadable on an accent fill. This rule comes AFTER that one
                 for exactly that reason: with both active, the later style wins. -->
        <Style Selector="ToggleButton.PanelToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style Selector="ToggleButton.PanelToggle:checked mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
        </Style>

        <!-- Global font defaults -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- ── AND THE SELECTABLE ONE, which the block above has never reached ──
             Owner-reported, 2026-08-28, against the Match Designer's Response readout: text that
             became selectable so its numbers could be copied "is now rendered too big".

             `SelectableTextBlock` derives from `TextBlock`, and an Avalonia type selector matches its
             type EXACTLY — so the defaults above stop at the base class. The FontSize is usually not
             what shows, because most selectable readouts set their own; the ALIGNMENTS are, because
             nothing sets those by hand and Avalonia's own default is Stretch on both axes. A
             vertically stretched line in a StackPanel claims more height than a centred one, and a
             card of seven of them grows visibly. It is the same defect as the Button note further
             down, on a different control, and it is fixed the same way: ONCE, here.

             Targeted at SelectableTextBlock rather than widened to `:is(TextBlock)` on the block
             above, and that distinction is load-bearing: `TextPresenter` also derives from
             `TextBlock`, so `:is()` would reach inside the template of every TextBox, ComboBox and
             AutoCompleteBox in the application and restyle their editable text. -->
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <!-- Owner-reported 3 times now (ScaleDialog, FlattenToPolygonDialog, ...): a Button wider
                 than its content (any fixed-Width dialog button, e.g. Cancel/OK) left-aligns its label
                 by Avalonia's own default, reading as visually off. Centering it ONCE, globally, here
                 is the fix that makes this class of bug impossible to reintroduce per-dialog — do NOT
                 go back to fixing it button-by-button in each new dialog's AXAML. -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <!-- AND THE OTHER AXIS, for the same reason and by the same policy (owner-reported
                 2026-08-28, against the Match Designer's Probe button: "the Probe button text is not
                 aligned middle within its button"). Avalonia's ContentControl default is Stretch on
                 both axes, so a Button TALLER than its label — one given a Height, or stretched by a
                 sibling in its row — renders the text against the top edge. It is exactly the bug the
                 paragraph above is about, on the axis that paragraph did not fix, and it belongs in
                 the same one place: a per-button VerticalContentAlignment is how this comes back. -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- A DISABLED BUTTON MUST STILL BE ABLE TO EXPLAIN ITSELF (owner-reported, 2026-09-09).
                 A disabled control takes no pointer input, so its tooltip is unreachable by default —
                 which hides the message exactly when it is worth most. This app puts REASONS in those
                 tooltips: LayoutCommandAvailability.DisabledReason binds straight to ToolTip.Tip on the
                 layout editor's Via tool and its neighbours, and it names the layer to draw vias on
                 instead. The owner could not read one, because the button carrying it was greyed out.
                 Here rather than per view, and for the same reason as the two setters above:
                 SchematicView and SymbolEditorView had each opted in locally and seventeen other views
                 with bound IsEnabled had not — a per-view opt-in is a list that falls behind silently. -->
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}"/>
        </Style>

        <!-- THE SAME BUG AS THE TWO ABOVE, one control further in (owner-reported 2026-09-06:
             "all those number edit UI elements have their text that is not vertically aligned to
             center", against Settings' "Keep them for:", "Always keep at least:" and "Wire
             clearance:").

             The TextBox style above already says Center — and it does not reach the TextBox inside a
             NumericUpDown's template, because that one's VerticalContentAlignment is TEMPLATE-BOUND to
             the NumericUpDown's own, and a template binding is a local value that beats any style. So
             the alignment has to be set on the OUTER control, which is what this does.

             Measured before and after rather than assumed: with the default (Stretch) the digits'
             glyph ink is centred ~2 px above the label beside them — small, consistent across every
             numeric field in the application, and exactly the sort of thing that reads as sloppy
             without being locatable. Application scope because it is not one dialog's problem: the
             Settings tabs, the technology editor and the wBond property panels all pair a numeric
             field with a label. -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- HOW THIS CONTROL READS WHAT IS TYPED INTO IT (owner, 2026-09-21).

                 Avalonia's defaults are ParsingNumberStyle=Any against CurrentCulture, and `Any`
                 admits a GROUP separator. Measured rather than assumed:
                 double.TryParse("4,4", NumberStyles.Any, en-US) returns 44. So a user typing four
                 point four into any of the 14 views using this control got FORTY-FOUR — no error, no
                 revert, a plausible number. `1.234` reads as 1234 on a German machine by the same
                 mechanism, in the other direction.

                 Float admits no thousands separator in any culture, and InvariantInfo takes the
                 machine out of it. Accepting the comma as a DECIMAL point is the other half and
                 cannot be done with a setter — Controls/NumericUpDownInputInstaller.cs rewrites the
                 text before the control parses it. -->
            <Setter Property="ParsingNumberStyle" Value="Float"/>
            <Setter Property="NumberFormat" Value="{x:Static glob:NumberFormatInfo.InvariantInfo}"/>
        </Style>

        <!-- AND THE SAME BUG ONE CONTROL FURTHER AGAIN (owner-reported 2026-09-11, against the EM
             Setup panel: the text in a lot of its comboboxes does not sit in the vertical middle).

             This one is NOT VerticalContentAlignment — the theme already template-binds that and it
             already says Center. It is the theme's own default PADDING, which is vertically
             ASYMMETRIC: 12,1,0,3. That is the upstream theme's own optical nudge, sized for a 32 px control
             carrying 14 px text, and at this application's compact density (24 px, 12 px text) it simply
             pushes the line up. Measured on the live EmSetupEditorView rather than assumed: every
             combo left on the theme default rendered its text 3 px from the top and 6 px from the
             bottom — 1.5 px high — while the TextBox beside it was exact, and the five combos that
             had been given a symmetric padding by hand were within half a pixel.

             Only the vertical numbers change here. 12 and 0 are the theme's own horizontal values
             and are repeated deliberately: the right side is 0 because the chevron lives in its own
             grid column, and moving the left one would shift the text of every combobox in the
             application sideways to fix an axis nobody reported.

             Application scope for the reason the three notes above give: the EM Setup panel is where
             it was SEEN, not where it lives — the Data Display trace cards, the technology editor and
             every dialog with a unit picker all inherit the same default. Fixing it per view is how
             it comes back. -->
        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="12,2,0,2"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>

        <!-- ══ A SCROLLBAR NO LONGER SITS ON TOP OF THE ONE INSIDE IT ═══════════════════════
             Owner-reported, 2026-09-20, against railRF's Results ▸ Breakdown: with a long breakdown
             and a short window there are two scrollbars, and the inner one is "hard to scroll".

             IT IS NOT THE EXPANSION ANIMATION AND IT IS NOT THE DELAY — the bars overlap even while
             both are collapsed, and the strip belongs to the OUTER one at every instant. Measured on
             railRF's own geometry (pane Padding 10, Border.card Padding 8,5 + 1 px border) in a
             headless Avalonia 12.0.3 harness, window 360x300:

                 outer bar   x = 333 .. 349     (16 px, ScrollBarSize)
                 inner bar   x = 324 .. 340     the card insets it by 9 px
                 overlap     x = 333 .. 340     7 px, the inner bar's RIGHT edge

             and the collapsed thumb renders hard against that right edge — Fluent's ScrollBar theme
             thins a resting bar by SCALING the thumb about RenderTransformOrigin 100%,50%, so the
             2 px sliver a user aims at is the part that is covered. An InputHitTest at the middle of
             that sliver returned the OUTER bar's PART_PageDownButton, so a click there PAGES THE
             OUTER VIEW instead of dragging the inner thumb. The only reachable part of the inner bar
             was the 9 px of empty track to its left, where nothing is drawn.

             The cause is Fluent's ScrollViewer theme, which makes an auto-hiding bar an OVERLAY:

                 Style Selector="^[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter"
                   Setter Property="Grid.ColumnSpan" Value="2"      (the content spans under the bars)

             so the bar floats over the last 16 px of content — its own transparent Border included,
             which is what eats the pointer. Avalonia ties the two behaviours to one property:
             AllowAutoHide="False" un-overlaps a bar but ALSO pins it permanently expanded, arrow
             buttons and all. This rule takes the half we want and leaves the other: the presenter
             stops spanning, so a visible bar RESERVES its column, while the bar itself still rests
             thin and still expands under the pointer.

             Costs nothing when nothing scrolls: an unneeded ScrollBar is IsVisible="False" and an
             Auto column measures it at 0 — verified in the same harness (content presenter 338 px
             wide with and without this rule when the content fits). When a bar IS shown the content
             is 12 px narrower than it used to be, which is the whole point: those 12 px were never
             usable, they were under the bar.

             Exact-type selector, so MenuScrollViewer (a ScrollViewer subclass, and a DockPanel
             template where these setters would be inert anyway) is not touched.

             THE [AllowAutoHide=True] QUALIFIER IS LOAD-BEARING AND MUST NOT BE TIDIED AWAY. Without
             it the selector still matches, the setters still parse, and the span STAYS AT 2 — the
             theme's own rule is activated by that same condition, and an unconditional style at the
             same priority does not displace an activated one. Both forms measured in that harness
             at the stock 16 px bar: qualified gives a 322 px content presenter, unqualified the
             unchanged 338 px. It fails silently, which is the only reason this paragraph exists.

             To go back to overlay bars, delete this one Style. -->
        <Style Selector="ScrollViewer[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Grid.RowSpan"    Value="1"/>
        </Style>

        <!-- ── THE OPT-OUT, for a panel whose WIDTH IS THE DESIGN ────────────────────────────
             Owner-reported the day the rule above landed: the Library palette showed ONE column of
             components at its default width instead of two, and a hand-widened palette left an
             awkward strip of empty space down its right edge.

             The palette reflows on measured width — a WrapPanel of 60 px tiles in a 62 px slot, so
             its column count is floor(width / 62) and the panel is sized deliberately to land just
             above a boundary. Taking 12 px out of that content crosses it, and one column is not a
             cosmetic difference. A panel like this WANTS the bar over its content: the tiles are
             what the width is for, and the right-hand slot the bar floats across is 2 px of tile
             margin most of the time.

             So: wear this class and the bar goes back to floating. It is deliberately a class and
             not a per-view copy of the setters — an opt-out that is named can be found, and the
             nesting hazard the rule above exists for is a real one to weigh before wearing it. Do
             not put it on a panel that CONTAINS another scroller.

             Later in this file than the rule it reverses, which is how it wins: both are activated
             styles at the same priority, so the last one applied takes the property. Verified in the
             same harness, both in one run — classed viewer back to a 338 px presenter, unclassed one
             still 326. -->
        <Style Selector="ScrollViewer.overlay-scroll[AllowAutoHide=True] /template/ ScrollContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Grid.RowSpan"    Value="2"/>
        </Style>

        <!-- The second half of the same report: a resting bar takes half a second to become
             grabbable and stays fat for two seconds after the pointer leaves (Fluent's own
             ShowDelay/HideDelay defaults). With the rule above the fat state no longer covers
             anything, so this is feel rather than function — but 2 s of a widened bar sitting over
             its own neighbour's edge is exactly what the report describes seeing. Short enough to
             feel immediate, long enough that sweeping the pointer across a list on the way somewhere
             else does not pop every bar open. -->
        <Style Selector="ScrollBar">
            <Setter Property="ShowDelay" Value="0:0:0.2"/>
            <Setter Property="HideDelay" Value="0:0:0.6"/>
        </Style>

        <!-- ── Segmented select buttons ──────────────────────────────────────────
             The resting look of IconSelectButton's PART_Button (Styles/SegmentedSelect.axaml) and of
             any toolbar button that wants to read as one segment of a group. Application scope
             because two windows use it: the Data Display's trace card and the Match Designer. The
             Data Display adds its OWN selectors for the MaterialIcon / PlotTypeGlyphControl content
             it hosts — those stay in PlotInspectorView.axaml, where the controls they name live. -->
        <Style Selector="Button.seg-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="MinWidth"        Value="0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Margin"          Value="0,0,2,0"/>
        </Style>
        <!-- active = accent bg + white glyph, on ContentPresenter (mirrors Button.ToolActive) -->
        <Style Selector="Button.seg-btn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.seg-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/>
            </Setter>
        </Style>
        <Style Selector="Button.seg-btn.active:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/>
            </Setter>
        </Style>

        <!-- ── Expander.fill — an expander whose BODY spans its container ──
             Owner-reported, 2026-09-11, against the note field in Correct What You Wrote…: a
             multi-line TextBox inside an expander rendered about 150 px wide in a 620 px dialog.

             The theme sizes an Expander to its content and does not stretch the content presenter,
             so an empty TextBox — no text, no placeholder — asks for its minimum and gets it. The
             same expander in the two Keep dialogs looked fine only because a long PlaceholderText was
             padding out its desired width, which is the accident that hid this.

             Setting HorizontalContentAlignment on the control is NOT enough; the presenter inside
             the template has to be stretched, and the header's ToggleButton with it or the control
             changes width as it is toggled. AnalysesListView found all three the hard way and kept a
             private copy of them; this is that fix, named, so the next expander that needs it says so
             in one word. OPT-IN rather than a plain `Expander` selector: several expanders in this
             application are deliberately content-sized. -->
        <Style Selector="Expander.fill">
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.fill /template/ ToggleButton">
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.fill /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- ComboBox.metaCombo — the layout editor's Unit and Snap pickers, and railRF's board-toolbar
             unit picker, which reuses the Unit one (2026-09-23). Moved here from LayoutEditorView so
             the second window takes the same setters rather than a copy that drifts.

             Unit and Snap: same font, same HEIGHT, left-aligned; Snap wider.

             Two Avalonia facts drive every setter here, and ignoring them is what made an earlier
             attempt look worse than the original:

             1. An EDITABLE ComboBox (Snap) is templated around an inner TextBox with its OWN
                padding, min-height and font; a NON-EDITABLE one (Unit) is templated around a plain
                ContentPresenter. So identical Padding/FontSize on the two ComboBoxes still yields
                DIFFERENT heights, and the inner TextBox does not necessarily take the outer
                FontSize. Height is therefore pinned explicitly on both, and the font is pushed into
                the inner TextBox by name.
             2. The template reserves space for the drop-down chevron. Squeezing Width clips the
                content presenter on BOTH sides — so width is expressed as MinWidth (a floor, never
                a cap) and the padding is left at the value the template expects, rather than
                shrunk. -->
        <Style Selector="ComboBox.metaCombo">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Reaches the editable variant's inner TextBox, which would otherwise keep the theme's
             own font size and make "same font size" quietly untrue. -->
        <Style Selector="ComboBox.metaCombo /template/ TextBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

</Styles>
