<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="using:CircuitRF.Ui.Converters"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      THE APPLICATION-SCOPE RESOURCES, IN ONE PLACE BECAUSE THERE ARE TWO APPLICATIONS.

      circuitRF and harmonicaRF are two entry points into ONE assembly (harmonicarf.md §3.1 route
      (b)), so each has its own Application object. R-h8-6 requires the standalone one to carry every
      resource harmonicaRF's own views reach — and requires that to hold BY CONSTRUCTION rather than
      by somebody remembering to mirror an addition. Both Applications merge this one dictionary, so
      a key added here is in both by definition and there is nothing to keep in step.

      Do not declare an application-scope resource in App.axaml or HarmonicaApp.axaml directly.
    -->

        <FontFamily x:Key="DejaVuSans">avares://CircuitRF.Ui/Assets/Fonts#DejaVu Sans</FontFamily>
        <sys:Double x:Key="FontSize">12</sys:Double>

        <!-- System.Warning brush — initialized from ColorTheme.BuiltIn in App.axaml.cs;
             updated on ThemeService.ThemeChanged so tree warning nodes follow the active theme. -->
        <SolidColorBrush x:Key="CrfWarningBrush" Color="#CE4A24"/>

        <!-- Palette tile definition border: semitransparent neutral gray so it reads against
             the panel in both light and dark without fighting the armed accent color.
             BorderBrush requires a Brush; System*Color keys resolve to Color (not Brush) and
             may silently fail to render on BorderBrush — always use a SolidColorBrush resource. -->
        <SolidColorBrush x:Key="CrfTileBorderBrush" Color="#55808080"/>

        <!-- Icon brush: wraps SystemBaseMediumColor as a Brush so it can be assigned to
             Stroke/BorderBrush properties (which require IBrush, not Color).
             Defined at Application scope so popup visual trees can reach it. -->
        <SolidColorBrush x:Key="CrfIconBrush" Color="{DynamicResource SystemBaseMediumColor}"/>

        <!-- brief-foreign-documents.md §4/R-fgn-7: marks a foreign document's chrome (edge band, tab
             tint) — amber, NEVER red (red means error; a foreign document is a normal, supported
             state), and never used to tint rendered geometry. Semi-transparent so it reads over either
             theme without a separate light/dark pair, same convention as CrfTileBorderBrush above. -->
        <SolidColorBrush x:Key="CrfForeignBandBrush" Color="#33E8A33D"/>
        <SolidColorBrush x:Key="CrfForeignAccentBrush" Color="#E8A33D"/>

        <!-- TM1 R-tm1-12: the Project Tree row a move-drop would land in. Follows the active accent
             so it reads as "this is where it goes" rather than as a state, and is held at 0.3 opacity
             because the row's own LABEL sits on top of it — an opaque accent fill would hide the name
             of the folder the highlight exists to name. A Brush, not a System*Color key, for the
             reason CrfTileBorderBrush above already records: a Color assigned to a Brush property may
             silently fail to render. -->
        <SolidColorBrush x:Key="CrfDropTargetBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.3"/>

<!-- Converters registered as application-level resources so all views can use them -->
        <conv:TreeItemIconConverter           x:Key="TreeItemIconConverter"/>
        <conv:StubKindIsSchematicConverter    x:Key="StubKindIsSchematicConverter"/>
        <conv:StubKindIsDataDisplayConverter  x:Key="StubKindIsDataDisplayConverter"/>
        <conv:MessageLevelToIconConverter     x:Key="MessageLevelToIconConverter"/>
        <conv:MessageLevelToColorConverter    x:Key="MessageLevelToColorConverter"/>
        <conv:IsNotNullConverter              x:Key="IsNotNullConverter"/>

        <!-- Override Dock.Fluent accent brushes with the OS system accent color.
             DockFluentTheme/Accents/Fluent.axaml hardcodes VS-blue (#007ACC) for these
             "DockApplication*" keys. Application.Resources wins over StyleInclude resources
             for DynamicResource lookups, so overriding them here replaces the hardcoded blue.
             However, the theme also uses StaticResource aliases (e.g. DockTabActiveBackgroundBrush
             → DockApplicationAccentBrushLow) which resolve at THEME LOAD time — those alias keys
             must be overridden here directly too, or they keep pointing to the original #007ACC
             brush regardless of the DockApplicationAccentBrush* overrides. -->

        <!-- Primary accent family -->
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow"       Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed"       Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh"      Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="{DynamicResource SystemAccentColor}"/>

        <!-- StaticResource aliases the theme resolves at load time — must also be overridden -->
        <SolidColorBrush x:Key="DockTabActiveBackgroundBrush"        Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockTabActiveIndicatorBrush"         Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockTabHoverBackgroundBrush"         Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush"    Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="DockSplitterHoverBrush"              Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockSplitterDragBrush"               Color="{DynamicResource SystemAccentColor}"/>

        <!--
            The Data Display CANVAS surface colour — deliberately NOT the shared dock-region
            SystemChromeLowColor (~#F2F2F2 light) that every other panel uses.

            Light mode wants a near-white off-white: the canvas sits directly behind pure-white plot
            backgrounds (RenderTheme.Light.BackgroundColor), so #F2F2F2 read as grey by contrast.
            #FCFCFC keeps the plot/canvas edge legible while looking off-white rather than grey. Dark
            mode is pinned to the current SystemChromeLowColor dark value, so this is light-mode-only;
            the two variants are stated as LITERAL colours (not a DynamicResource into the theme) so
            the canvas can never drift back to the shared dock grey.

            It lives at application scope because TWO surfaces are the Data Display canvas: the canvas
            itself (PlotCanvasView) and the Match Designer's Response pane, whose plots the owner asked
            to sit on the same ground (2026-08-20: "background color of the Response group UI needs to
            be the same as the background color of the Data display"). A second literal copy in the
            other file is exactly how the two would stop matching.
        -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="CrfDataDisplayCanvasBrush" Color="#FCFCFC"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="CrfDataDisplayCanvasBrush" Color="#171717"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <!-- The IconSelectButton default ControlTheme (the trace card's S/Y/Z selector, and every
             two- or three-way selector in the Match Designer). ONE definition, application scope —
             see the file's own header for why it is not two. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://CircuitRF.Ui/Styles/SegmentedSelect.axaml"/>

            <!-- ══ THE DOCUMENT TAB CONTEXT MENU SWITCH ═════════════════════════════════════
                 COMMENT OUT THE ONE LINE BELOW to go back to Dock's own (native) document tab
                 context menu. Nothing else needs changing: Dock's Fluent theme binds the tab's
                 menu with {DynamicResource DocumentTabStripItemContextMenu}, an
                 Application.Resources key wins over a StyleInclude's resources for a
                 DynamicResource lookup (the same mechanism the accent overrides above rely on),
                 and with our key absent the lookup falls through to Dock's dictionary unchanged.
                 The file's own header says what it replaces and why the whole menu is copied.
                 tests/Ui.Tests/DocumentTabContextMenuTests.cs pins both halves. -->
            <ResourceInclude Source="avares://CircuitRF.Ui/Styles/DocumentTabContextMenu.axaml"/>
        </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
