         entitlements argument to codesign. CFBundleExecutable must match the binary
         name inside Contents/MacOS/. -->

    <key>CFBundleIdentifier</key>
    <string>com.circuitRF.circuitRF</string>

    <key>CFBundleExecutable</key>
    <string>circuitRF</string>

    <key>CFBundleName</key>
    <string>circuitRF</string>

    <key>CFBundleDisplayName</key>
