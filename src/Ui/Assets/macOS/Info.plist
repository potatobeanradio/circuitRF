<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── Required bundle identity keys ─────────────────────────────────────
         CFBundleIdentifier must match BUNDLE_ID in bundleForMacOS.sh and the
         entitlements argument to codesign. CFBundleExecutable must match the binary
         name inside Contents/MacOS/. -->

    <key>CFBundleIdentifier</key>
    <string>com.circuitRF.circuitRF</string>

    <key>CFBundleExecutable</key>
    <string>circuitRF</string>

    <key>CFBundleName</key>
    <string>circuitRF</string>

    <key>CFBundleDisplayName</key>
    <string>circuitRF</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- PLACEHOLDER: bundleFor*MacOS.sh stamps these two keys from the repo-root VERSION file, the
         one place circuitRF's version is written. Editing them here changes nothing about a built
         bundle. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>0.1.0</string>

    <!-- .NET 10 requires macOS 13 (Ventura) or later. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- WHAT THIS KEY IS NOT: it has nothing to do with THIS app's own quarantine, and setting it
         does not suppress any Gatekeeper dialog. It governs whether files the app CREATES OR
         DOWNLOADS get the com.apple.quarantine attribute — the flag a browser or a download manager
         opts into. circuitRF is not that kind of app, so it is explicitly false (which is also the
         default).

         The comment here used to claim it "suppresses the quarantine 'damaged app' dialog for
         ad-hoc signed builds". It never did, and believing it costs real time: an ad-hoc signature
         is one Gatekeeper cannot trust at all, and NO plist key changes that. Signing with a
         Developer ID certificate and notarising is the only thing that does. -->
    <key>LSFileQuarantineEnabled</key>
    <false/>

    <key>CFBundleIconFile</key>
    <string>circuitRFIcon</string>

    <!-- Declare the custom UTIs for .crfw (circuitRF Workspace) and .charm (harmonicaRF document).

         R-h8-10 — .charm is declared on BOTH binaries, because circuitRF opens one too (Tools ▸
         harmonicaRF is not going away). The UTI is EXPORTED here and IMPORTED by harmonicaRF's own
         Info.plist: two applications must not both claim to define one type, and circuitRF is the
         one that ships the type's own description. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.crfw</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Workspace</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>crfw</string>
                    <!-- Both spellings, because App.OpenFiles opens both: a workspace saved into a
                         folder is that folder's `.cws`, and `.crfw` is the standalone spelling.
                         Claiming only one left half the workspaces on the machine with no owner. -->
                    <string>cws</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.charm</string>
            <key>UTTypeDescription</key>
            <string>harmonicaRF Document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>charm</string>
                </array>
            </dict>
        </dict>
        <!-- R-wbe-7 — .wBond was not declared to macOS at all until WB-E. circuitRF ships the type's
             description because the format is circuitRF's; the standalone wBond binary IMPORTS it.
             Two applications both EXPORTING one UTI is what Launch Services cannot arbitrate.
             harmonicaRF declares it nowhere: it has no business opening a .wBond. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.wbond</string>
            <key>UTTypeDescription</key>
            <string>wBond Design</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>wBond</string>
                    <string>wbond</string>
                </array>
            </dict>
        </dict>
        <!-- The five document types a user actually double-clicks to inspect, plus the .cem that
             goes with a layout. circuitRF is the ONLY application that opens any of them, so unlike
             .charm and .wBond there is no exported/imported split to make and no Viewer role to
             argue about: it exports the type and it is the type's editor.

             Every one of these must have a matching `case` in App.OpenFiles — a declared type with
             no dispatcher launches circuitRF and opens nothing, which reads as a broken file.
             EveryDocumentTypeCircuitRfClaims_IsActuallyHandledByItsOpenFilesDispatcher holds that
             shut. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.csch</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Schematic</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>csch</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.clay</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Layout</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>clay</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.csym</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Symbol</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>csym</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.cdd</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Data Display</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>cdd</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.ctech</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Technology</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ctech</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.cem</string>
            <key>UTTypeDescription</key>
            <string>circuitRF EM Setup</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>cem</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Document types this app can open. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Workspace</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.crfw</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>crfw</string>
                <string>cws</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>harmonicaRF Document</string>
            <!-- Viewer, not Editor: harmonicaRF standalone is the app that OWNS a .charm, and both
                 declaring themselves the editor would make which one opens a double-click a matter of
                 whichever Launch Services saw last. circuitRF still opens one, in Tools ▸ harmonicaRF. -->
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.charm</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>charm</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>wBond Design</string>
            <!-- Viewer, not Editor, for exactly harmonicaRF's reason: the standalone wBond binary is
                 the app that OWNS a .wBond, and both declaring themselves the editor would make which
                 one opens a double-click a matter of whichever Launch Services saw last. circuitRF
                 still opens one, from the project tree or File ▸ Open wBond…. -->
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.wbond</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>wBond</string>
                <string>wbond</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Schematic</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.csch</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>csch</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Layout</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.clay</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>clay</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Symbol</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.csym</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>csym</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Data Display</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.cdd</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cdd</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Technology</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.ctech</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>ctech</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF EM Setup</string>
            <!-- Editor, not Viewer: circuitRF is the only application that opens one. -->
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.cem</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cem</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
