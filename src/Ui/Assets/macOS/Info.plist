<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── Required bundle identity keys ─────────────────────────────────────
         CFBundleIdentifier must match BUNDLE_ID in bundleForMacOS.sh and the
         --entitlements arg to codesign. CFBundleExecutable must match the binary
         name inside Contents/MacOS/. -->

    <key>CFBundleIdentifier</key>
    <string>com.circuitRF.circuitRF</string>

    <key>CFBundleExecutable</key>
    <string>CircuitRF.Ui</string>

    <key>CFBundleName</key>
    <string>circuitRF</string>

    <key>CFBundleDisplayName</key>
    <string>circuitRF</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>0.1.0</string>

    <!-- .NET 10 requires macOS 13 (Ventura) or later. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Suppress quarantine "damaged app" dialog for ad-hoc signed builds. -->
    <key>LSFileQuarantineEnabled</key>
    <false/>

    <key>CFBundleIconFile</key>
    <string>circuitRFIcon</string>

    <!-- Declare the custom UTIs for .crfw (circuitRF Workspace) and .charm (harmonicaRF document).

         R-h8-10 — .charm is declared on BOTH binaries, because circuitRF opens one too (Tools ▸
         harmonicaRF is not going away). The UTI is EXPORTED here and IMPORTED by harmonicaRF's own
         Info.plist: two applications must not both claim to define one type, and circuitRF is the
         one that ships the type's own description. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.crfw</string>
            <key>UTTypeDescription</key>
            <string>circuitRF Workspace</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>crfw</string>
                </array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.charm</string>
            <key>UTTypeDescription</key>
            <string>harmonicaRF Document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>charm</string>
                </array>
            </dict>
        </dict>
        <!-- R-wbe-7 — .wBond was not declared to macOS at all until WB-E. circuitRF ships the type's
             description because the format is circuitRF's; the standalone wBond binary IMPORTS it.
             Two applications both EXPORTING one UTI is what Launch Services cannot arbitrate.
             harmonicaRF declares it nowhere: it has no business opening a .wBond. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.wbond</string>
            <key>UTTypeDescription</key>
            <string>wBond Design</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>wBond</string>
                    <string>wbond</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Document types this app can open. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>circuitRF Workspace</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.crfw</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>crfw</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>harmonicaRF Document</string>
            <!-- Viewer, not Editor: harmonicaRF standalone is the app that OWNS a .charm, and both
                 declaring themselves the editor would make which one opens a double-click a matter of
                 whichever Launch Services saw last. circuitRF still opens one, in Tools ▸ harmonicaRF. -->
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.charm</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>charm</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>wBond Design</string>
            <!-- Viewer, not Editor, for exactly harmonicaRF's reason: the standalone wBond binary is
                 the app that OWNS a .wBond, and both declaring themselves the editor would make which
                 one opens a double-click a matter of whichever Launch Services saw last. circuitRF
                 still opens one, from the project tree or File ▸ Open wBond…. -->
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.wbond</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>wBond</string>
                <string>wbond</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
