<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ── harmonicaRF's OWN bundle identity (R-h8-9) ─────────────────────────
         A different application, and macOS will not tolerate it pretending otherwise: two bundles
         sharing one CFBundleIdentifier collide in Launch Services, in the Dock, in the quarantine
         database and in the login-item list, and the symptoms of that are all remote from the cause.

         THE THREE-PLACE TRAP, unchanged from circuitRF's own Info.plist and now doubled:
         CFBundleIdentifier must match BUNDLE_ID in bundleForHarmonicaMacOS.sh AND the entitlements argument
         argument to codesign. Nothing derives one from another. The bundle script reads the
         identifier back OUT of this file and checks it, which is the one place the three can be
         compared — see its own note. -->

    <key>CFBundleIdentifier</key>
    <string>com.circuitRF.harmonicaRF</string>

    <!-- The binary inside Contents/MacOS/. The ASSEMBLY is still shared with circuitRF on purpose
         (§3.1: the standalone binary is src/Ui with a different Main, and RfCore's InternalsVisibleTo
         names that assembly) - but the published HOST is renamed per app by CircuitRF.Ui.csproj's
         CrfRenameApphost target, so this must match EXECUTABLE_NAME in bundleForHarmonicaMacOS.sh. -->
    <key>CFBundleExecutable</key>
    <string>harmonicaRF</string>

    <key>CFBundleName</key>
    <string>harmonicaRF</string>

    <key>CFBundleDisplayName</key>
    <string>harmonicaRF</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- PLACEHOLDER: bundleFor*MacOS.sh stamps these two keys from the repo-root VERSION file, the
         one place circuitRF's version is written. Editing them here changes nothing about a built
         bundle. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>

    <key>CFBundleVersion</key>
    <string>0.1.0</string>

    <!-- .NET 10 requires macOS 13 (Ventura) or later. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- WHAT THIS KEY IS NOT: it has nothing to do with THIS app's own quarantine, and setting it
         does not suppress any Gatekeeper dialog. It governs whether files the app CREATES OR
         DOWNLOADS get the com.apple.quarantine attribute — the flag a browser or a download manager
         opts into. circuitRF is not that kind of app, so it is explicitly false (which is also the
         default).

         The comment here used to claim it "suppresses the quarantine 'damaged app' dialog for
         ad-hoc signed builds". It never did, and believing it costs real time: an ad-hoc signature
         is one Gatekeeper cannot trust at all, and NO plist key changes that. Signing with a
         Developer ID certificate and notarising is the only thing that does. -->
    <key>LSFileQuarantineEnabled</key>
    <false/>

    <key>CFBundleIconFile</key>
    <string>harmonicaRFIcon</string>

    <!-- .charm is IMPORTED here and EXPORTED by circuitRF's Info.plist (R-h8-10). Two applications
         must not both claim to define one type; circuitRF ships the definition, harmonicaRF states
         that it understands it. Both then open a double-clicked .charm. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.circuitrf.charm</string>
            <key>UTTypeDescription</key>
            <string>harmonicaRF Document</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.content</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>charm</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- Document types this app can open. .crfw is deliberately ABSENT: there is no workspace in this
         build (§1.2), so claiming the type would put an application that cannot open one in the
         "Open With" list for every workspace on the machine. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>harmonicaRF Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.circuitrf.charm</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>charm</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
