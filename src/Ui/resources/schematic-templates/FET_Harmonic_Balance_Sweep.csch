      "Parameters": [
        {
          "Name": "Pout_W",
          "Expression": "real(0.5*HB1.V(\u0022Vout\u0022,1)*conj(HB1.I(\u0022Iout\u0022,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_dBm",
          "Expression": "10*log10(Pout_W*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gp_dB",
          "Expression": "Pout_dBm - Pin_deliv_dBm",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gt_dB",
          "Expression": "Pout_dBm - Pin_avail_dBm",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "trans_phase",
          "Expression": "phase(HB1.V(\u0022Vout\u0022, 1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "AMPM",
          "Expression": "trans_phase - at(trans_phase, \u0022Pin\u0022, 0)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
