          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Efficiency",
          "Expression": "Pout_W/Pdc_W*100",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE",
          "Expression": "(Pout_W -",
          "Unit": "Pin_deliv_W)/Pdc_W*100",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
