      "Parameters": [
        {
          "Name": "Pin_avail_dBm",
          "Expression": "Pin",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pin_deliv_W",
          "Expression": "real(0.5*HB1.V(\u0022Vin\u0022,1)*conj(HB1.I(\u0022Iin\u0022,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pin_deliv_dBm",
          "Expression": "10*log10(Pin_deliv_W*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IRL_dB",
          "Expression": "Pin_deliv_dBm - Pin_avail_dBm",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Zin",
          "Expression": "HB1.V(\u0022Vin\u0022,1)/HB1.I(\u0022Iin\u0022,1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
