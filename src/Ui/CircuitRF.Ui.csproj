<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    THREE APPLICATIONS, ONE ASSEMBLY (docs/design/harmonicarf.md §3.1 route (b), wbond.md §11/WB38).

    circuitRF, harmonicaRF and wBond are the same code with a different Main and a different
    Application object. Which one this build produces is `CrfApp`:

        dotnet build                                  → circuitRF   (the default)
        dotnet build   -p:CrfApp=harmonica            → harmonicaRF
        dotnet build   -p:CrfApp=wbond                → wBond
        dotnet publish -p:CrfApp=wbond -r osx-arm64     (self-contained)

    R-h8-5 / WB39 — StartupObject is set EXPLICITLY for EVERY value, never left to "there is only one
    Main". This project sets TreatWarningsAsErrors, so the moment another entry point compiles the
    build is CS0017 without it.

    **THAT RULE HAS NOW BITTEN TWICE, and the second time was verified rather than assumed.** Deleting
    the `wbond` line below and rebuilding with -p:CrfApp=wbond gives, immediately:

        src/Ui/Program.cs(19,24): error CS0017: Program has more than one entry point defined.

    — note that it names circuitRF's OWN Program.cs, not the new entry point, which is exactly why
    the rule is written down here instead of remembered.

    Size is NOT a difference between them and is not meant to be — §0.2 of brief-harmonicarf-h8
    settled it: excluding the layout editor AND the MoM engine would save ~1.6 MB of 138, because a
    ~95 MB .NET-plus-Avalonia floor dominates and no source split reaches it. The standalone binary
    is the same size as circuitRF and that is the accepted outcome.
  -->
  <PropertyGroup>
    <CrfApp Condition="'$(CrfApp)' == ''">circuitrf</CrfApp>

    <StartupObject Condition="'$(CrfApp)' == 'circuitrf'">CircuitRF.Ui.Program</StartupObject>
    <StartupObject Condition="'$(CrfApp)' == 'harmonica'">CircuitRF.Ui.ProgramHarmonica</StartupObject>
    <StartupObject Condition="'$(CrfApp)' == 'wbond'">CircuitRF.Ui.ProgramWBond</StartupObject>

    <!-- The ASSEMBLY NAME is deliberately the same for all three, and this is not cosmetic (WB40):
         RfCore grants InternalsVisibleTo("CircuitRF.Ui"), so renaming the assembly for a standalone
         build loses SNP.CreateBroken / SNP.RefreshFrom and the Data Display half stops compiling.
         §3.1/§11 say the standalone binary IS src/Ui with a different Main; keeping one assembly
         name is what makes that literally true. The bundle script names the .app, not the binary. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(CrfApp)' != 'circuitrf' and '$(CrfApp)' != 'harmonica' and '$(CrfApp)' != 'wbond'">
    <!-- A typo in CrfApp must not silently build circuitRF and leave someone wondering why their
         standalone binary opens a workspace. -->
    <CrfAppInvalid>true</CrfAppInvalid>
  </PropertyGroup>

  <Target Name="CrfValidateApp" BeforeTargets="BeforeBuild" Condition="'$(CrfAppInvalid)' == 'true'">
    <Error Text="CrfApp must be 'circuitrf', 'harmonica' or 'wbond'; got '$(CrfApp)'." />
  </Target>

  <!-- harmonicaRF's own macOS bundle identity (R-h8-9). Its own icon, its own Info.plist, its own
       entitlements — macOS will not tolerate two applications claiming one bundle identifier, and
       two apps sharing an icon is its own kind of wrong. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(CrfApp)' == 'harmonica'">
    <MacOSXBundleIcon>Assets/harmonicaRFIcon.icns</MacOSXBundleIcon>
    <MacOSXBundleInfoPlist>Assets/macOS/Harmonica-Info.plist</MacOSXBundleInfoPlist>
    <CodeSignEntitlements>Assets/macOS/Entitlements.plist</CodeSignEntitlements>
  </PropertyGroup>

  <!-- wBond's own macOS bundle identity (WB-E M4, the same rule applied a third time). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(CrfApp)' == 'wbond'">
    <MacOSXBundleIcon>Assets/wBondIcon.icns</MacOSXBundleIcon>
    <MacOSXBundleInfoPlist>Assets/macOS/WBond-Info.plist</MacOSXBundleInfoPlist>
    <CodeSignEntitlements>Assets/macOS/Entitlements.plist</CodeSignEntitlements>
  </PropertyGroup>

  <!--
    Windows: embeds the icon into the .exe PE resources — PER APP.

    **This was NOT per-app until WB-E, and it is the Windows half of R-h8-9's rule.** The condition
    used to test only the platform, so all three executables would have embedded circuitRF's icon the
    moment one existed. Nothing broke because no `.ico` is committed (they are build products of the
    SVGs in Assets/artwork/, exactly like the `.icns` files — see .gitignore), so today every Windows
    build carries the default .NET icon. That is a real gap for all three and is stated in
    src/Ui/CLAUDE.md rather than left to be discovered; what this fixes is that when the `.ico` files
    ARE produced, each application gets its own instead of one wearing another's.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationIcon Condition="'$(CrfApp)' == 'circuitrf' and Exists('Assets\circuitRFIcon.ico')">Assets\circuitRFIcon.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(CrfApp)' == 'harmonica' and Exists('Assets\harmonicaRFIcon.ico')">Assets\harmonicaRFIcon.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(CrfApp)' == 'wbond'     and Exists('Assets\wBondIcon.ico')">Assets\wBondIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    THE SHIPPED EXECUTABLE IS NAMED AFTER THE APPLICATION, NOT AFTER THE ASSEMBLY.

    `dotnet publish` names the native host after $(AssemblyName), which would ship a
    CircuitRF.Ui.exe / CircuitRF.Ui on all three platforms - a build-system detail on a user's Start
    Menu, in Task Manager, in /opt and in an .app's Contents/MacOS. The assembly name itself cannot
    change (see WB40 above: RfCore grants InternalsVisibleTo("CircuitRF.Ui")), and .NET has no
    property that renames the host independently of it, so the host is renamed after publish.

    Renaming a single-file host is safe: it locates its bundle by reading its OWN path at run time
    and never by its own name, and nothing inside the app looks up the process file name.

    PUBLISH ONLY, on purpose - a plain `dotnet build` / `dotnet run` still produces CircuitRF.Ui, so
    every test, script and tool that launches the build output is untouched.

    Four consumers depend on the names below; change one and change all four:
      packaging/windows/circuitRF.wxs + build-msi.ps1  ($exeName)
      packaging/linux/postinst + circuitrf.desktop
      src/Ui/bundleFor*MacOS.sh                        (EXECUTABLE_NAME)
      src/Ui/Assets/macOS/*.plist                      (CFBundleExecutable)
  -->
  <PropertyGroup>
    <CrfExeName Condition="'$(CrfApp)' == 'circuitrf'">circuitRF</CrfExeName>
    <CrfExeName Condition="'$(CrfApp)' == 'harmonica'">harmonicaRF</CrfExeName>
    <CrfExeName Condition="'$(CrfApp)' == 'wbond'">wBond</CrfExeName>
  </PropertyGroup>

  <Target Name="CrfRenameApphost" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_CrfExeExt Condition="$(RuntimeIdentifier.StartsWith('win'))">.exe</_CrfExeExt>
      <_CrfPublishedHost>$(PublishDir)$(AssemblyName)$(_CrfExeExt)</_CrfPublishedHost>
      <_CrfRenamedHost>$(PublishDir)$(CrfExeName)$(_CrfExeExt)</_CrfRenamedHost>
    </PropertyGroup>
    <Move SourceFiles="$(_CrfPublishedHost)"
          DestinationFiles="$(_CrfRenamedHost)"
          Condition="Exists('$(_CrfPublishedHost)') and '$(_CrfPublishedHost)' != '$(_CrfRenamedHost)'" />
    <Exec Command="chmod +x &quot;$(_CrfRenamedHost)&quot;"
          Condition="!$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(_CrfRenamedHost)')" />
    <Message Importance="high" Text="Published executable: $(CrfExeName)$(_CrfExeExt)" />
  </Target>

  <PropertyGroup>
    <PackAsTool>false</PackAsTool>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfContained Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IncludeNativeLibrariesForSelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Authors>circuitRF</Authors>
  </PropertyGroup>

  <!--
    PER-APP IDENTITY METADATA, and on Windows this is USER-VISIBLE rather than bookkeeping.

    `Description` becomes the executable's **File Description**, which is the name Windows shows in
    Task Manager's Details tab and in the file's own Properties. All three binaries are called
    CircuitRF.exe (WB40 — the assembly name must not change), so before this the ONLY thing
    distinguishing them there was identical circuitRF text on all three. `Product` is what Explorer
    shows as the product name.

    The macOS side already had this right: CFBundleName/CFBundleDisplayName are per-app in each
    plist. This is that same decision applied to the one platform that reads it from the binary.
  -->
  <PropertyGroup Condition="'$(CrfApp)' == 'circuitrf'">
    <Product>circuitRF</Product>
    <Description>Lightweight cross-platform RF circuit simulator and electromagnetic solver</Description>
    <PackageId>com.circuitRF.circuitRF</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CrfApp)' == 'harmonica'">
    <Product>harmonicaRF</Product>
    <Description>harmonicaRF — interactive waveform engineering and load-pull instrument: drag a terminations on a Smith chart to investigate nonlinearities</Description>
    <PackageId>com.circuitRF.harmonicaRF</PackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CrfApp)' == 'wbond'">
    <Product>wBond</Product>
    <Description>wBond — layout-driver bond-wire design and assembly rule checking</Description>
    <PackageId>com.circuitRF.wBond</PackageId>
  </PropertyGroup>

  <!-- SelfContained only activates when an explicit -r <rid> is supplied (dotnet publish). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- macOS: Info.plist, Entitlements, icon -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(CrfApp)' == 'circuitrf'">
    <MacOSXBundleIcon>Assets/circuitRFIcon.icns</MacOSXBundleIcon>
    <MacOSXBundleInfoPlist>Assets/macOS/Info.plist</MacOSXBundleInfoPlist>
    <CodeSignEntitlements>Assets/macOS/Entitlements.plist</CodeSignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Shipped default technologies (docs/sonnet-briefs/brief-misc-termg-units-technologies.md §3,
       R-misc-6) — real .ctech files, embedded as plain-text .NET resources (NOT AvaloniaResource:
       ShippedTechnologies.cs is framework-free and must be readable via Assembly.
       GetManifestResourceStream in headless tests, which have no live Avalonia platform for
       AssetLoader to run against — see SkiaFonts.cs's own note on exactly that constraint). Read at
       runtime through the SAME TechPersistence reader user files use (R-misc-7) — never
       hand-transcribed into C#. -->
  <ItemGroup>
    <EmbeddedResource Include="resources\technologies\*.ctech" />
  </ItemGroup>

  <!-- Shipped schematic templates — real, authored .csch files (resources\schematic-templates\),
       embedded the same way and for the same reasons as the technologies above: read at runtime
       through the SAME SchematicPersistence.Deserialize a user's own .csch goes through, so a
       template can never drift from what the schematic editor actually reads, and readable via
       Assembly.GetManifestResourceStream in headless tests (ShippedSchematicTemplates.cs is
       framework-free). Embedding is also what makes them present in a compiled/published build —
       a loose folder beside the executable would not survive `dotnet publish`. -->
  <ItemGroup>
    <EmbeddedResource Include="resources\schematic-templates\*.csch" />
  </ItemGroup>

  <!-- Strip .pdb files from publish output -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Allow test project access to internal types -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CircuitRF.Ui.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Core stack -->
    <ProjectReference Include="../Core/CircuitRF.Core.csproj" />
    <ProjectReference Include="../Engine/CircuitRF.Engine.csproj" />
    <ProjectReference Include="../RfCore/RfCore.csproj" />
    <!-- harmonicaRF's framework-free half. The dependency runs ONE way only: src/Ui consumes
         src/Harmonica, never the reverse — src/Harmonica is on the far side of the UI firewall and
         tests/Firewall.Tests asserts it references no Avalonia (docs/design/harmonicarf.md §3.2). -->
    <ProjectReference Include="../Harmonica/CircuitRF.Harmonica.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Bundle the User Documentation into the app output (docs/user/) so the in-app Help menu and the
      component/analysis Help buttons (DocLauncher) open it offline. Component symbols and pages are
      refreshed by the docs factory (tools/DocGen; see docs/design/user-docs-factory.md).

      DOC SIZE IS APP SIZE, so three things are deliberately EXCLUDED as build inputs rather than
      runtime assets:
        *.md                  - the Markdown sources under docs/user/src/, which the generator reads
                                and which nothing at runtime does.
        assets/figures/**     - the captured UI figures. Every page INLINES its figure as an <svg>
                                element (an SVG referenced with <img> cannot see the page's
                                @font-face rules), so the standalone files are intermediates. They are
                                ~2 MB; shipping them would be shipping every figure twice.
        toolbar-*.json        - the per-button manifests the page generator reads. Covered by the
                                figures exclusion above; named here so the reason is on the record.
    -->
    <None Include="../../docs/user/**/*.*"
          Exclude="../../docs/user/**/*.md;../../docs/user/assets/figures/**/*.*">
      <Link>docs/user/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia UI framework (match splotRF versions) -->
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <!-- MVVM + icons -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />

    <!-- SkiaSharp (for future canvas rendering) -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />

    <!-- SVG→EMF conversion for the Windows clipboard (CF_ENHMETAFILE for Word/PowerPoint).
         Unconditional so it compiles on all platforms; every execution path is guarded by
         OperatingSystem.IsWindows() at runtime. Transitively brings System.Drawing.Common
         (used by WindowsClipboard.SvgToEmfHandle), so System.Drawing.Imaging compiles
         cross-platform. -->
    <PackageReference Include="Svg" Version="3.4.7" />

    <!-- Dock: AvaloniaUI docking library — regions, tear-out, re-dock -->
    <!-- NOTE: Verify Dock.Avalonia styles path at runtime; see CircuitRfDockFactory.cs -->
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />

    <!-- Clipper2 — polygon booleans/offsets for the layout editor (docs/design/layout-view.md §6.1).
         Managed C#, Boost licence, integer (long) coordinates — matches our DBU storage type exactly,
         no native dependency, clears the root CLAUDE.md bar on native deps. README acknowledgment
         already in place. -->
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <!--
    macOS only: keep the Linux VM host (tools/macos-vmhost) in step with the build.

    It is what lets Linux-only device models run on macOS, and it is OPTIONAL — circuitRF builds and
    runs fine without it. So this can only ever warn: ContinueOnError, and the script itself exits 0
    on every failure it can encounter (no Swift toolchain, no network, a bad checksum). A missing VM
    host must never be the reason someone cannot build the application.

    The Swift binary is rebuilt whenever its sources change (seconds, no network). The Linux image is
    rebuilt only when its downloads are already cached, because building it from scratch pulls
    ~330 MB and that is not something to do silently during a build; the script prints the one
    command to run otherwise. Force it with -p:CrfBuildVmImage=true.
  -->
  <Target Name="EnsureMacVmHost"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(CrfSkipVmHost)' != 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/../../tools/macos-vmhost/ensure-built.sh&quot; --dest &quot;$(MSBuildProjectDirectory)/$(OutDir.TrimEnd('/'))&quot; $(_CrfVmImageFlag)"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="high" />
  </Target>

  <!--
    EVERY platform: keep the device worker (tools/senior-worker) in step with the build.

    Unlike the VM host above this is NOT macOS-only. A contributor on Windows or Linux gets it from
    a plain `dotnet run` too, so "it works on my machine" does not depend on who built it. The
    binary lands beside the assemblies, which is where DeviceWorkerManifest.ToolsDirectory looks —
    and on macOS is the directory the VM host shares into the guest.

    OPTIONAL, therefore warn-only: ContinueOnError, and the scripts themselves exit 0 on every
    failure they can meet (no cross-compiler, no network for a first image pull, a compile error).
    A design using no compiled device models never notices it is missing, so a missing worker must
    never be the reason somebody cannot build the application.

    Skip with -p:CrfSkipDeviceWorker=true.
  -->
  <Target Name="EnsureDeviceWorker"
          AfterTargets="Build"
          Condition="'$(CrfSkipDeviceWorker)' != 'true'">
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          Command="&quot;$(MSBuildProjectDirectory)/../../tools/senior-worker/ensure-built.sh&quot; --dest &quot;$(MSBuildProjectDirectory)/$(OutDir.TrimEnd('/'))&quot;"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="high" />
    <!-- Same rule, same reason: keep the OSDI worker in step, and never fail the build over it. -->
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="&quot;$(MSBuildProjectDirectory)/../../tools/osdi-worker/build.sh&quot; --dest &quot;$(MSBuildProjectDirectory)/$(OutDir.TrimEnd('/'))&quot;"
          ContinueOnError="true" StandardOutputImportance="low" />
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          Command="&quot;$(MSBuildProjectDirectory)\..\..\tools\senior-worker\ensure-built.cmd&quot; --dest &quot;$(MSBuildProjectDirectory)\$(OutDir.TrimEnd('\'))&quot;"
          ContinueOnError="WarnAndContinue"
          StandardOutputImportance="high" />
  </Target>

  <!--
    ...and into the PUBLISHED tree, which is a separate question from landing beside the assemblies.

    A file an Exec drops into $(OutDir) is not an MSBuild item, and `dotnet publish` copies ITEMS,
    not the output folder - so every one of these helpers was left behind, and every packaged build
    (.msi, .dmg, .deb, all of which package the publish tree) shipped without them. Measured, not
    supposed: a publish of this project produced no worker at all while the build folder beside it
    had one. The symptom is a kit that evaluates fine under `dotnet run` and refuses on an installed
    copy, with a message about a program the user never installed and could not have.

    Named files rather than a wildcard. The output folder is full of build products, and "everything
    that is not an assembly" would sweep up whatever a future dependency leaves lying there.
    Missing ones are skipped: each helper is optional and platform-specific, so on any one machine
    most of this list does not exist and that is the normal case, not a failure.
  -->
  <Target Name="CrfPublishHelperPrograms" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- the device worker: the Linux/macOS build, and Windows' launcher stub + callback module -->
      <_CrfHelperProgram Include="$(OutDir)senior_worker" />
      <_CrfHelperProgram Include="$(OutDir)senior_worker.exe" />
      <_CrfHelperProgram Include="$(OutDir)crf-model-host.dll" />
      <!-- the OSDI worker -->
      <_CrfHelperProgram Include="$(OutDir)osdi-worker" />
      <!-- the macOS VM host, with the kernel and initramfs it looks for beside itself -->
      <_CrfHelperProgram Include="$(OutDir)crf-vmhost" />
      <_CrfHelperProgram Include="$(OutDir)crf-linux-kernel" />
      <_CrfHelperProgram Include="$(OutDir)crf-linux-initramfs.cpio.gz" />

      <ResolvedFileToPublish Include="@(_CrfHelperProgram)" Condition="Exists('%(FullPath)')">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <_CrfVmImageFlag Condition="'$(CrfBuildVmImage)' == 'true'">--with-image</_CrfVmImageFlag>
  </PropertyGroup>

</Project>
