<!-- The step rail and the selected step's settings (brief-modelcomposer-14 R-mc14-2, R-mc14-6 … R-mc14-9). One panel,
     one lamp. Values, not prose: a disabled step says why on its tooltip and nowhere else. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="using:CircuitRF.Ui.ModelComposer"
             xmlns:ctl="using:CircuitRF.Ui.Controls"
             xmlns:dm="using:CircuitRF.Design.Modeling"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.ModelComposer.StepsPanelView"
             x:DataType="mc:ModelComposerViewModel">
    <UserControl.Resources>
        <!-- The method picker (brief-modelcomposer-15 R-mc15-1): the same control for every constituent. -->
        <DataTemplate x:Key="MethodPicker" x:DataType="mc:MethodPickerRow">
            <Border Classes="card">
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="40,*">
                        <TextBlock Classes="panelhdr" Text="{Binding Name}" VerticalAlignment="Center" Margin="0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="mc:MethodChoice">
                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Tip}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <StackPanel Spacing="3" IsVisible="{Binding IsAnn}">
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Hidden layers"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding Hidden, Mode=TwoWay}" HorizontalContentAlignment="Right"
                                                ToolTip.Tip="1 to 4 layers, neurons each, e.g. 8, 8"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Activation"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Activations}" SelectedItem="{Binding Activation}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Iterations"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding Iterations, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="3" IsVisible="{Binding IsTable}">
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Grid step (V)"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding GridStep, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Smoothing"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding Smoothing, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90" IsVisible="{Binding ShowsPath}">
                            <TextBlock Classes="lbl" Text="Path"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Paths}" SelectedItem="{Binding Path}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="The line integral's path: A, B, or their mean"/>
                        </Grid>
                    </StackPanel>
                    <!-- An equation is a template's law or the user's own (Custom). A template shows the law it fits, and the
                         expression boxes are Custom's alone (owner, review 3: an empty box under a chosen template read as
                         something left to fill in). The fitted parameters are one selectable block, so they copy together. -->
                    <StackPanel Spacing="3" IsVisible="{Binding IsEquation}">
                        <Grid ColumnDefinitions="*,140">
                            <TextBlock Classes="lbl" Text="Template"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="A built-in law, or Custom for your own expression"/>
                        </Grid>
                        <SelectableTextBlock Text="{Binding TemplateExpression}" IsVisible="{Binding !IsCustom}" TextWrapping="Wrap"
                                             FontFamily="monospace" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <Grid ColumnDefinitions="*,140" IsVisible="{Binding ShowsTemperature}">
                            <TextBlock Classes="lbl" Text="Linear in T"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding Temperature, Mode=TwoWay}" Watermark="{Binding TemperatureWatermark}"
                                                ToolTip.Tip="Template parameters made linear in temperature, p + p_T·(T − Tnom). Blank is the template's default; none for none."/>
                        </Grid>
                        <TextBox Text="{Binding Expression}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" FontFamily="monospace" FontSize="11"
                                 IsVisible="{Binding IsCustom}"
                                 PlaceholderText="{Binding ExpressionWatermark}"
                                 ToolTip.Tip="Your own law. Every name that is not an input (vgs, vds, and T when the data spans temperatures) is a parameter the fit finds."/>
                        <TextBox Text="{Binding ExpressionGd}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" FontFamily="monospace" FontSize="11"
                                 PlaceholderText="IgGd = your expression in vgs, vds and parameters">
                            <TextBox.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsCustom"/>
                                    <Binding Path="IsGate"/>
                                </MultiBinding>
                            </TextBox.IsVisible>
                        </TextBox>
                        <SelectableTextBlock Text="{Binding FittedText}" IsVisible="{Binding HasFitted}" FontSize="11" FontFamily="monospace"
                                             TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Classes="pane">
        <Grid RowDefinitions="Auto,4,*">
            <!-- The rail. -->
            <ListBox Classes="rows" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="mc:ModelStepItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding IsEnabled}"
                              Background="Transparent" ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True">
                            <!-- A Grid and a TextBlock draw no disabled state of their own: without this a step that cannot
                                 be chosen yet looked exactly like one that can. -->
                            <Grid.Styles>
                                <Style Selector="Grid:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
                            </Grid.Styles>
                            <mi:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="2" Width="7" Height="7" IsVisible="{Binding IsStale}"
                                     Fill="{DynamicResource CrfWarningBrush}" ToolTip.Tip="Stale"/>
                            <mi:MaterialIcon Grid.Column="2" Kind="Check" Width="14" Height="14" IsVisible="{Binding IsDone}"
                                             Foreground="{DynamicResource CrfSuccessBrush}" ToolTip.Tip="Done"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                <StackPanel Spacing="4">

                    <!-- ── Data ─────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsDataStep}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="Data sets"/>
                            <Button Grid.Column="1" Classes="tool" Command="{Binding RunCommand}" CommandParameter="import"
                                    ToolTip.Tip="Import a data set">
                                <mi:MaterialIcon Kind="DatabaseImportOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <ListBox Classes="rows" ItemsSource="{Binding DataSetRows}" SelectedItem="{Binding SelectedDataSet}" MaxHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="mc:DataSetRow">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Classes="lbl" Text="{Binding Points}"/>
                                        </Grid>
                                        <TextBlock Classes="lbl" FontSize="11" TextTrimming="CharacterEllipsis" Text="{Binding Summary}"/>
                                        <TextBlock Classes="lbl" FontSize="11" Text="{Binding Capacitances}" IsVisible="{Binding HasCapacitances}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- MC-30 D5: what the imported sets can support, lit or dim — derived, never a button. A fixed
                             six rows of one line each, so the panel does not move as sets are imported. -->
                        <ItemsControl ItemsSource="{Binding NeedRows}" IsVisible="{Binding IsActive}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:NeedRow">
                                    <Grid ColumnDefinitions="Auto,Auto,*" Height="18" Opacity="{Binding Opacity}"
                                          ToolTip.Tip="{Binding Detail}">
                                        <mi:MaterialIcon Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Data}" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Classes="lbl" Text="{Binding Detail}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Which data a model needs, and how to take it from another simulator's kit, is a flow rather than
                             a field: the app note draws it, so the Data step points at it rather than restating it. -->
                        <Button Name="DataGuideButton" Classes="tool" IsVisible="{Binding IsActive}" HorizontalAlignment="Left"
                                ToolTip.Tip="The data a model needs, and how to sample it from another simulator's design kit">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <mi:MaterialIcon Kind="BookOpenPageVariantOutline" Width="14" Height="14"/>
                                <TextBlock Text="Which data does a model need?" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Classes="card" IsVisible="{Binding IsActive}">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="panelhdr" Text="Base periphery"/>
                                <Grid ColumnDefinitions="*,90">
                                    <TextBlock Classes="lbl" Text="N0"/>
                                    <ctl:InlineEditText Grid.Column="1" Text="{Binding PeripheryFingers, Mode=TwoWay}"
                                                        HorizontalContentAlignment="Right" ToolTip.Tip="Fingers of the measured device"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,90">
                                    <TextBlock Classes="lbl" Text="W0"/>
                                    <ctl:InlineEditText Grid.Column="1" Text="{Binding PeripheryWidth, Mode=TwoWay}"
                                                        HorizontalContentAlignment="Right" ToolTip.Tip="Unit gate width, e.g. 125 um"/>
                                </Grid>
                                <SelectableTextBlock Classes="warn" Text="{Binding PeripheryWarning}"
                                           IsVisible="{Binding PeripheryWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PassiveBlocks}" IsVisible="{Binding IsPassive}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Classes="lbl" FontSize="11" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding AnalysisLines}" IsVisible="{Binding IsPassive}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ── Pads ─────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsPadsStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Pads"/>
                        <ComboBox ItemsSource="{Binding PadsKinds}" SelectedItem="{Binding PadsKind}" HorizontalAlignment="Stretch"/>
                        <Grid ColumnDefinitions="50,*,Auto" IsVisible="{Binding PadsOpenShort}">
                            <TextBlock Classes="lbl" Text="Open"/>
                            <TextBlock Grid.Column="1" Text="{Binding PadsOpen}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="…" Command="{Binding PickPadFileCommand}" CommandParameter="open" ToolTip.Tip="Choose" Padding="8,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="50,*,Auto" IsVisible="{Binding PadsOpenShort}">
                            <TextBlock Classes="lbl" Text="Short"/>
                            <TextBlock Grid.Column="1" Text="{Binding PadsShort}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="…" Command="{Binding PickPadFileCommand}" CommandParameter="short" ToolTip.Tip="Choose" Padding="8,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="50,*,Auto" IsVisible="{Binding PadsTwoPorts}">
                            <TextBlock Classes="lbl" Text="Gate"/>
                            <TextBlock Grid.Column="1" Text="{Binding PadsGate}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="…" Command="{Binding PickPadFileCommand}" CommandParameter="gate" ToolTip.Tip="Choose" Padding="8,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="50,*,Auto" IsVisible="{Binding PadsTwoPorts}">
                            <TextBlock Classes="lbl" Text="Drain"/>
                            <TextBlock Grid.Column="1" Text="{Binding PadsDrain}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="…" Command="{Binding PickPadFileCommand}" CommandParameter="drain" ToolTip.Tip="Choose" Padding="8,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- ── Network ──────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsNetworkStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Network fit"/>
                        <Grid ColumnDefinitions="70,*">
                            <TextBlock Classes="lbl" Text="Method"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding NetworkMethods}" SelectedItem="{Binding NetworkMethod}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,*">
                            <TextBlock Classes="lbl" Text="Seed"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding NetworkSeed, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="70,*">
                            <TextBlock Classes="lbl" Text="Bias points"/>
                            <SelectableTextBlock Grid.Column="1" Text="{Binding FitPointsText}" HorizontalAlignment="Right"
                                       ToolTip.Tip="Lasso on the bias plane to add or remove"/>
                        </Grid>
                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="panelhdr" Text="Weights"/>
                                <Grid ColumnDefinitions="*,70">
                                    <TextBlock Classes="lbl" Text="Flatness"/>
                                    <ctl:InlineEditText Grid.Column="1" Text="{Binding WeightFlatness, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,70">
                                    <TextBlock Classes="lbl" Text="Cold"/>
                                    <ctl:InlineEditText Grid.Column="1" Text="{Binding WeightCold, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,70">
                                    <TextBlock Classes="lbl" Text="Small signal"/>
                                    <ctl:InlineEditText Grid.Column="1" Text="{Binding WeightSmallSignal, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Current (R-mc15-2) ──────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsCurrentStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Currents"/>
                        <ItemsControl ItemsSource="{Binding CurrentPickers}" ItemTemplate="{StaticResource MethodPicker}"/>
                        <Grid ColumnDefinitions="*,90" ToolTip.Tip="{x:Static mc:ModelComposerViewModel.IdFloorTip}">
                            <TextBlock Classes="lbl" Text="Id floor (of max |Id|)"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding CurrentIdFloor, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90" ToolTip.Tip="{x:Static mc:ModelComposerViewModel.IgFloorTip}">
                            <TextBlock Classes="lbl" Text="Ig floor (of max |Ig|)"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding CurrentIgFloor, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Restarts"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding CurrentRestarts, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Seed"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding CurrentSeed, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,90">
                            <TextBlock Classes="lbl" Text="Held out (%)"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding CurrentHeldOut, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <CheckBox Content="DC/RF dispersion" IsChecked="{Binding Dispersion}" ToolTip.Tip="{x:Static mc:ModelComposerViewModel.DispersionTip}"/>
                    </StackPanel>

                    <!-- ── Charge (R-mc15-3) ───────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsChargeStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Charges"/>
                        <!-- MC-18: with no S data, typed constant capacitances in place of the method picker. -->
                        <StackPanel Spacing="3" IsVisible="{Binding ChargesTyped}" ToolTip.Tip="{Binding TypedChargesTip}">
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Cgs"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding TypedCgs, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Cgd"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding TypedCgd, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Cds"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding TypedCds, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Cm"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding TypedCm, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                            <Button Content="Fit to the S data" Command="{Binding ClearTypedChargesCommand}" IsVisible="{Binding TypedBesideData}"
                                    ToolTip.Tip="The document has S data: clear the typed values to fit the charges to it"/>
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding !ChargesTyped}">
                            <ItemsControl ItemsSource="{Binding ChargePickers}" ItemTemplate="{StaticResource MethodPicker}"/>
                            <CheckBox Content="Drift charge in Qg" IsChecked="{Binding DriftCharge}" ToolTip.Tip="Qg carries a drift charge of vgd and Id"/>
                            <Grid ColumnDefinitions="*,90">
                                <TextBlock Classes="lbl" Text="Seed"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding ChargeSeed, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Thermal (R-mc15-4) ──────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsThermalStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Thermal"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding OneTemperature}">
                            <SelectableTextBlock Text="{Binding T0Text}"/>
                            <TextBlock Classes="lbl" Text="one temperature"/>
                        </StackPanel>
                        <StackPanel Spacing="3" IsVisible="{Binding !OneTemperature}">
                            <CheckBox Content="Self-heating" IsChecked="{Binding SelfHeating}"/>
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Rth (°C/W)"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding Rth, Mode=TwoWay}" HorizontalContentAlignment="Right"
                                                    ToolTip.Tip="Blank to extract it from the data"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,110">
                                <TextBlock Classes="lbl" Text="Cth"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding Cth, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="lbl" Text="Ladder"/>
                                <ctl:InlineEditText Grid.Column="1" Text="{Binding Ladder, Mode=TwoWay}" HorizontalContentAlignment="Right"
                                                    ToolTip.Tip="fraction:τ pairs, e.g. 0.6:1 µs, 0.4:100 µs"/>
                            </Grid>
                            <SelectableTextBlock FontSize="11" Text="{Binding ThermalResidual}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Noise (brief NZ-4) ─────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsNoiseStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Noise"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="lbl" Text="Measured noise parameters" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="…" Command="{Binding AddNoiseFileCommand}" Padding="8,0"
                                    ToolTip.Tip="Add a file: a .s2p with a noise block, or a table of noise parameters"/>
                        </Grid>
                        <TextBox Text="{Binding NoiseSources, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontSize="11" ToolTip.Tip="{x:Static mc:ModelComposerViewModel.NoiseSourcesTip}"/>
                        <Grid ColumnDefinitions="*,110">
                            <TextBlock Classes="lbl" Text="Measured at (°C)"/>
                            <ctl:InlineEditText Grid.Column="1" Text="{Binding NoiseAmbient, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                        </Grid>
                        <SelectableTextBlock FontSize="10.5" FontFamily="monospace" TextWrapping="Wrap" Text="{Binding NoiseResult}"
                                             IsVisible="{Binding NoiseResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <!-- ── Traps (R-mc15-5) ────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsTrapsStep}" Spacing="4">
                        <TextBlock Classes="panelhdr" Text="Traps"/>
                        <ComboBox ItemsSource="{Binding TrapModelNames}" SelectedItem="{Binding TrapModel}" HorizontalAlignment="Stretch"/>
                        <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding TrapRunNote}"
                                   IsVisible="{Binding TrapRunNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Grid ColumnDefinitions="60,*" IsVisible="{Binding HasTrapModel}">
                            <TextBlock Classes="lbl" Text="Coupling"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TrapCouplings}" SelectedItem="{Binding TrapCoupling}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Trained: Id takes the trap states as inputs, from pulsed I–V. Shift: the states shift the gate voltage of the trap-free Id."/>
                        </Grid>
                        <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding TrapCouplingNote}"
                                   IsVisible="{Binding TrapCouplingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ItemsControl ItemsSource="{Binding TrapStates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:TrapStateRow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsVisible="{Binding Supported}"/>
                                        <TextBlock Classes="warn" FontSize="11" Text="{Binding Reason}" IsVisible="{Binding !Supported}"/>
                                        <TextBlock Grid.Column="1" Classes="lbl" FontSize="11" Text="{Binding Level}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding TrapParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:ParameterRow">
                                    <Grid ColumnDefinitions="*,90" ToolTip.Tip="{Binding Tip}">
                                        <TextBlock Classes="lbl" Text="{Binding Name}"/>
                                        <ctl:InlineEditText Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding TrapStrengths}" IsVisible="{Binding IsShiftCoupling}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:StrengthRow">
                                    <Grid ColumnDefinitions="Auto,*,80,Auto" ToolTip.Tip="{Binding Tip}">
                                        <CheckBox IsChecked="{Binding Lock}" ToolTip.Tip="Locked: typed, not fitted"/>
                                        <TextBlock Grid.Column="1" Classes="lbl" Text="{Binding Name}"/>
                                        <ctl:InlineEditText Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Classes="lbl" FontSize="11" Margin="4,0,0,0" Text="{Binding Error}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding TrapExpressions}" IsVisible="{Binding IsCustomTraps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:ParameterRow">
                                    <StackPanel Spacing="1" ToolTip.Tip="{Binding Tip}">
                                        <TextBlock Classes="lbl" FontSize="11" Text="{Binding Name}"/>
                                        <TextBox Text="{Binding Value}" FontFamily="monospace" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding TrapCheck}"/>
                    </StackPanel>

                    <!-- ── Check (R-mc15-6) ────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsCheckStep}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="Charge conservation"/>
                            <Button Grid.Column="1" Classes="tool" Command="{Binding CheckChargeCommand}" ToolTip.Tip="Check Charge Conservation">
                                <mi:MaterialIcon Kind="CheckDecagramOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <!-- One result to a row (owner, review 2): the data's gate, its drain, the model, HB. -->
                        <ItemsControl ItemsSource="{Binding CheckLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock TextWrapping="Wrap" Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ── Validate (R-mc15-7) ─────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsValidateStep}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock Classes="panelhdr" Text="Validation"/>
                            <Button Grid.Column="1" Classes="tool" Command="{Binding ValidateAllCommand}" ToolTip.Tip="Run all">
                                <mi:MaterialIcon Kind="PlayBoxMultipleOutline" Width="16" Height="16"/>
                            </Button>
                            <Button Grid.Column="2" Classes="tool" Command="{Binding ShowTestbenchCommand}" ToolTip.Tip="Show testbench">
                                <mi:MaterialIcon Kind="FileDocumentOutline" Width="16" Height="16"/>
                            </Button>
                            <Button Grid.Column="3" Classes="tool" Command="{Binding OpenReportCommand}" ToolTip.Tip="Model Validation Report…">
                                <mi:MaterialIcon Kind="FileChartOutline" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ValidationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mc:ValidationRow">
                                    <Border Classes="card">
                                        <StackPanel Spacing="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Set}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Classes="tool" Padding="3,1" ToolTip.Tip="Run this one"
                                                        Command="{Binding $parent[UserControl].((mc:ModelComposerViewModel)DataContext).ValidateOneCommand}"
                                                        CommandParameter="{Binding Set}">
                                                    <mi:MaterialIcon Kind="Play" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                            <TextBlock Classes="lbl" FontSize="11" Text="{Binding Kind}"/>
                                            <TextBlock Classes="lbl" FontSize="11" Text="{Binding Tolerance}"/>
                                            <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Result}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="panelhdr" Text="Tolerances"/>
                                <ItemsControl ItemsSource="{Binding Tolerances}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="mc:ParameterRow">
                                            <Grid ColumnDefinitions="*,70,30" ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Classes="lbl" Text="{Binding Name}"/>
                                                <ctl:InlineEditText Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" HorizontalContentAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Classes="lbl" Text="{Binding Unit}" Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Export (R-mc15-8) ───────────────────────────────── -->
                    <!-- The step's actions are a tool strip on its header, as the Network panel's are: small glyph buttons at the
                         foot of a scrolling column read as stray, and a row of worded buttons clipped at the panel's width. -->
                    <StackPanel IsVisible="{Binding IsExportStep}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="Export" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button Classes="tool" Command="{Binding CopyInstanceCommand}" IsVisible="{Binding IsActive}"
                                        ToolTip.Tip="Copy Instance — the exported model, to paste into a schematic">
                                    <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                                </Button>
                                <!-- A boxed text tile, the Layout editor's EM Setup glyph: no icon says Verilog-A. -->
                                <Button Classes="tool" Command="{Binding ExportVerilogACommand}" IsVisible="{Binding IsActive}"
                                        ToolTip.Tip="Export Verilog-A… — the model as source, for another simulator">
                                    <Panel Width="16" Height="16">
                                        <Border Width="16" Height="12" CornerRadius="2" BorderThickness="1.2"
                                                BorderBrush="{Binding $parent[Button].Foreground}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="VA" FontSize="8" FontWeight="Bold" LetterSpacing="-0.3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Panel>
                                </Button>
                                <Border Classes="rule" IsVisible="{Binding IsActive}"/>
                                <Button Classes="tool" Command="{Binding ExportCommand}" ToolTip.Tip="Export">
                                    <mi:MaterialIcon Kind="ExportVariant" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Where Export writes, under the button that writes it. -->
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsActive}">
                            <TextBox Text="{Binding ExportPath}" FontSize="11" ToolTip.Tip="The .cmodel's path"/>
                            <Button Grid.Column="1" Content="…" Command="{Binding PickExportPathCommand}" ToolTip.Tip="Choose" Padding="8,0"/>
                        </Grid>
                        <SelectableTextBlock Classes="warn" FontSize="11" Text="{Binding VerilogATables}"
                                             IsVisible="{Binding VerilogATables, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <SelectableTextBlock Classes="lbl" FontSize="11" Text="{Binding VerilogAResult}" TextWrapping="Wrap"
                                             IsVisible="{Binding VerilogAResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !CanExport}">
                            <SelectableTextBlock Classes="warn" FontSize="11" Text="{Binding ExportBlocked}"/>
                            <Button Grid.Column="1" Content="Run stale" Command="{Binding RunStaleCommand}"/>
                        </Grid>
                        <StackPanel Spacing="4" IsVisible="{Binding IsActive}">
                            <Border Classes="card">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="panelhdr" Text="Base periphery"/>
                                    <Grid ColumnDefinitions="*,90">
                                        <TextBlock Classes="lbl" Text="N0"/>
                                        <ctl:InlineEditText Grid.Column="1" Text="{Binding PeripheryFingers, Mode=TwoWay}"
                                                            HorizontalContentAlignment="Right" ToolTip.Tip="Fingers of the measured device"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,90">
                                        <TextBlock Classes="lbl" Text="W0"/>
                                        <ctl:InlineEditText Grid.Column="1" Text="{Binding PeripheryWidth, Mode=TwoWay}"
                                                            HorizontalContentAlignment="Right" ToolTip.Tip="Unit gate width, e.g. 125 um"/>
                                    </Grid>
                                    <SelectableTextBlock Classes="warn" Text="{Binding PeripheryWarning}"
                                               IsVisible="{Binding PeripheryWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="panelhdr" Text="Scaling"/>
                                    <!-- The Values table's own scaling cell, so the rule is set where the export shows it. -->
                                    <ItemsControl ItemsSource="{Binding NetworkValues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="mc:NetworkValueRow">
                                                <Grid ColumnDefinitions="*,130" Margin="0,1">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[ItemsControl].((mc:ModelComposerViewModel)DataContext).ScalingRules}"
                                                              SelectedItem="{Binding Scaling}" FontSize="11" MinHeight="0" Padding="4,0"
                                                              HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <!-- One symbol, drawn large; a click opens the menu of every symbol the model can take, each row
                                 its own glyph — the Smith Chart's Add menu (SmithChartView.BuildElementMenus). The button is
                                 transparent: its default fill washed the whole glyph grey. Hover still lights it. -->
                            <Border Classes="card">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="panelhdr" Text="Symbol"/>
                                    <Button Name="SymbolButton" Background="Transparent" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="4" ToolTip.Tip="Choose the symbol">
                                        <StackPanel Spacing="2">
                                            <ctl:PaletteGlyphControl Kind="ComposedFET" SymbolCellDir="{Binding SelectedSymbol.GlyphRef}" Height="110"/>
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                                <TextBlock FontSize="11" Text="{Binding SelectedSymbol.Label}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="3" IsVisible="{Binding IsPassive}">
                            <Grid ColumnDefinitions="70,*">
                                <TextBlock Classes="lbl" Text="Cell"/>
                                <TextBox Grid.Column="1" Text="{Binding CellName}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70,*">
                                <TextBlock Classes="lbl" Text="Library"/>
                                <TextBox Grid.Column="1" Text="{Binding CellLibrary}" ToolTip.Tip="The workspace or library folder"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CellParameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock FontSize="11" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Topology (passive) ───────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsTopologyStep}" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="{Binding TopologyName}"/>
                            <Button Grid.Column="1" Classes="tool" Command="{Binding RunCommand}" CommandParameter="propose" ToolTip.Tip="Propose">
                                <mi:MaterialIcon Kind="Lightbulb" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <TextBlock Classes="lbl" TextWrapping="Wrap" Text="{Binding ProposalNote}"
                                   IsVisible="{Binding ProposalNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <ListBox Name="ProposalList" Classes="rows" ItemsSource="{Binding Proposals}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="mc:ProposalRow">
                                    <Border Classes="card" ToolTip.Tip="Double-click to choose">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Classes="lbl" Text="{Binding Score}"/>
                                            </Grid>
                                            <ctl:SchematicCanvas Model="{Binding Drawing}" ShowGrid="False" Height="90" ClipToBounds="True"
                                                                 IsHitTestVisible="False" DragDrop.AllowDrop="False"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
