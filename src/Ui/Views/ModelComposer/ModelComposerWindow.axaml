<!-- The Model Composer window (docs/sonnet-briefs/brief-modelcomposer-14-window-and-data-steps.md; overview §3).

     THE TOOLBAR IS THE SCHEMATIC AND LAYOUT EDITORS' (owner, 2026-10-19): one strip under a hairline, bare 16 px
     MaterialIcons in Padding="6,3" buttons, groups split by a 1 px rule, the word on the tooltip, and the lit state on
     Button.ToolActive's accent. THE PANELS ARE RAILRF'S: Border.pane over Border.card, a lamp per panel on the toolbar
     (kept in the .cmc), the last lit lamp disabled, and splitters in both directions.

     This layout is a first iteration and the owner will revise it, so each panel is its own view (StepsPanelView,
     PlotsPanelView, NetworkPanelView, ValuesPanelView) and the window only places them. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="using:CircuitRF.Ui.ModelComposer"
        xmlns:v="using:CircuitRF.Ui.Views.ModelComposer"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.ModelComposer.ModelComposerWindow"
        x:DataType="mc:ModelComposerViewModel"
        Title="{Binding Title}"
        Width="1199" Height="741"
        MinWidth="900" MinHeight="560"
        CanResize="True">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S"       Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Meta+S"       Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="Meta+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="Ctrl+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"       Command="{Binding RedoCommand}"/>
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>

        <!-- railRF's panel language: a pane is one tier, a card on it the next. -->
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style Selector=":is(TextBlock).lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector=":is(TextBlock).warn">
            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Lists that can grow are ListBoxes, flattened to read as rows (railRF / the Match Designer). -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <!-- A row whose inline editor is open shows no selection or hover highlight, so the box reads as what is being
             edited; the highlight returns when the edit commits (InlineEditText.EditingRowClass). -->
        <Style Selector="ListBox.rows ListBoxItem.inlineediting /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Centred text on buttons; a combobox's selection and its items are left-aligned, as everywhere else in circuitRF. -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- The editors' lit tool button. The Fluent theme paints hover and press on the inner presenter, so the accent
             is set there. -->
        <Style Selector="Button.ToolActive">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ToolActive /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColor}"/></Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/></Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/></Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Width" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
    </Window.Styles>

    <DockPanel Background="{DynamicResource SystemChromeLowColor}">

        <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Name="Toolbar" Orientation="Horizontal" Spacing="2">
                <Button Name="OpenButton" Classes="tool" ToolTip.Tip="Open (⌘O)">
                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/>
                </Button>
                <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save (⌘S)">
                    <mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                </Button>
                <Button Classes="tool" Command="{Binding SaveAsCommand}" ToolTip.Tip="Save As (⇧⌘S)">
                    <mi:MaterialIcon Kind="ContentSaveEditOutline" Width="16" Height="16"/>
                </Button>
                <Border Classes="rule"/>
                <Button Classes="tool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (⌘Z)">
                    <mi:MaterialIcon Kind="Undo" Width="16" Height="16"/>
                </Button>
                <Button Classes="tool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (⇧⌘Z)">
                    <mi:MaterialIcon Kind="Redo" Width="16" Height="16"/>
                </Button>
                <Border Classes="rule"/>
                <!-- The four panel lamps, in the window's left-to-right order. Lit means on screen; the last lit
                     one is disabled by its command, so at least one panel always shows. -->
                <Button Name="StepsLamp" Classes="tool" Classes.ToolActive="{Binding ShowSteps}"
                        Command="{Binding ToggleStepsCommand}" ToolTip.Tip="Steps">
                    <mi:MaterialIcon Kind="PageLayoutSidebarLeft" Width="16" Height="16"/>
                </Button>
                <Button Name="PlotsLamp" Classes="tool" Classes.ToolActive="{Binding ShowPlots}"
                        Command="{Binding TogglePlotsCommand}" ToolTip.Tip="Plots">
                    <mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                </Button>
                <Button Name="NetworkLamp" Classes="tool" Classes.ToolActive="{Binding ShowNetwork}"
                        Command="{Binding ToggleNetworkCommand}" ToolTip.Tip="Network">
                    <mi:MaterialIcon Kind="PageLayoutHeader" Width="16" Height="16"/>
                </Button>
                <Button Name="ValuesLamp" Classes="tool" Classes.ToolActive="{Binding ShowValues}"
                        Command="{Binding ToggleValuesCommand}" ToolTip.Tip="Values">
                    <mi:MaterialIcon Kind="TableLarge" Width="16" Height="16"/>
                </Button>
                <!-- The step's tools follow the window's, one strip from the left rather than across the window from them
                     (owner, review 4). -->
                <Border Classes="rule"/>
                <Button Classes="tool" Command="{Binding CheckChargeCommand}" IsVisible="{Binding IsActive}"
                        ToolTip.Tip="Check Charge Conservation">
                    <mi:MaterialIcon Kind="CheckDecagramOutline" Width="16" Height="16"/>
                </Button>
                <Button Classes="tool" Command="{Binding OpenReportCommand}" IsVisible="{Binding IsActive}"
                        ToolTip.Tip="Model Validation Report…">
                    <mi:MaterialIcon Kind="FileChartOutline" Width="16" Height="16"/>
                </Button>
                <!-- Export to Library… (brief vendorlib-17): the schematic editor's button, publishing the model this
                     window holds. Greyed with the reason as its tooltip until the document is saved and exported. -->
                <Button Name="ExportToLibraryButton" Classes="tool" Command="{Binding ExportToLibraryCommand}"
                        ToolTip.Tip="{Binding ExportToLibraryTip}" ToolTip.ShowOnDisabled="True">
                    <mi:MaterialIcon Kind="PackageVariantClosedPlus" Width="16" Height="16"/>
                </Button>
                <Border Classes="rule"/>
                <Button Name="RunButton" Classes="tool" Command="{Binding RunCommand}" ToolTip.Tip="{Binding RunTip}">
                    <mi:MaterialIcon Kind="Play" Width="16" Height="16"/>
                </Button>
                <Button Name="RunMenuButton" Classes="tool" Padding="2,3" ToolTip.Tip="The step's runs">
                    <mi:MaterialIcon Kind="MenuDown" Width="16" Height="16"/>
                </Button>
                <Button Classes="tool" Command="{Binding CancelCommand}" ToolTip.Tip="{Binding CancelText}">
                    <mi:MaterialIcon Kind="Stop" Width="16" Height="16"/>
                </Button>
                <Border Classes="rule"/>
                <Button Name="HelpButton" Classes="tool" ToolTip.Tip="Help">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ── Status strip: one line, one progress bar, one Cancel ──────────────── -->
        <!-- One height, running or not (owner, review 3): the Cancel button is taller than the line, so the strip grew by a
             few pixels for the length of every run and the whole window shifted with it. The row is held at the button's
             height, which the button is sized to. -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0" Padding="8,2">
            <Grid ColumnDefinitions="*,Auto" Height="22">
                <SelectableTextBlock Name="StatusLine" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsRunning}">
                    <TextBlock Classes="lbl" Text="{Binding TaskStage}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Width="160" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                 IsIndeterminate="{Binding !ProgressKnown}" VerticalAlignment="Center"/>
                    <Button Classes="tool" Command="{Binding CancelCommand}" ToolTip.Tip="{Binding CancelText}"
                            Height="22" Padding="4,0" VerticalAlignment="Center">
                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Panel>
            <!-- ── The panes ─────────────────────────────────────────────────────── -->
            <Grid Name="PaneGrid" ColumnDefinitions="280,4,*,4,340" IsVisible="{Binding !IsChoosingKind}">
                <v:StepsPanelView Grid.Column="0" IsVisible="{Binding ShowSteps}"/>
                <GridSplitter Name="LeftSplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent"/>
                <v:PlotsPanelView Name="PlotsPanel" Grid.Column="2" IsVisible="{Binding ShowPlots}"/>
                <GridSplitter Name="RightSplitter" Grid.Column="3" ResizeDirection="Columns" Background="Transparent"/>
                <Grid Name="RightColumn" Grid.Column="4" RowDefinitions="*,4,*" IsVisible="{Binding ShowRightColumn}">
                    <v:NetworkPanelView Name="NetworkPanel" Grid.Row="0" IsVisible="{Binding ShowNetwork}"/>
                    <GridSplitter Name="RightRowSplitter" Grid.Row="1" ResizeDirection="Rows" Background="Transparent"/>
                    <v:ValuesPanelView Grid.Row="2" IsVisible="{Binding ShowValues}"/>
                </Grid>
            </Grid>

            <!-- ── A new document: Active or Passive ─────────────────────────────── -->
            <StackPanel IsVisible="{Binding IsChoosingKind}" Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding ChooseKindCommand}" CommandParameter="Active" Width="180" Height="120"
                        ToolTip.Tip="A three-terminal FET model">
                    <StackPanel Spacing="8">
                        <mi:MaterialIcon Kind="IntegratedCircuitChip" Width="40" Height="40"/>
                        <TextBlock Text="Active" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ChooseKindCommand}" CommandParameter="Passive" Width="180" Height="120"
                        ToolTip.Tip="An N-port passive model">
                    <StackPanel Spacing="8">
                        <mi:MaterialIcon Kind="Resistor" Width="40" Height="40"/>
                        <TextBlock Text="Passive" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Panel>
    </DockPanel>
</Window>
