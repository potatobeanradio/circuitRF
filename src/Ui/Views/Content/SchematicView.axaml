<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:schemDoc="using:CircuitRF.Ui.Schematic"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Content.SchematicView"
             x:DataType="schemDoc:SchematicDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Styles>
        <!-- Show tooltips even on disabled buttons/toggles throughout this view -->
        <Style Selector="Button">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>

        <!--
            Active tool button states. The Fluent theme sets hover/pressed backgrounds directly
            on the inner ContentPresenter (not on Button.Background), so we must target the
            template part explicitly to prevent the theme's grey hover from overriding accent.
        -->
        <Style Selector="Button.ToolActive">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ToolActive /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection-dependent buttons: dim icon when disabled -->
        <Style Selector="Button.SelectionBtn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- ── Breadcrumb bar styles ──────────────────────────────────────── -->
        <!-- Base style: flat, transparent, accent foreground for clickable crumbs -->
        <Style Selector="Button.BreadcrumbBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.BreadcrumbBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.BreadcrumbBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
        </Style>
        <!-- Current crumb: bold, base foreground, non-interactive -->
        <Style Selector="Button.BreadcrumbBtn.BreadcrumbCurrent">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
        </Style>
        <Style Selector="Button.BreadcrumbBtn.BreadcrumbCurrent /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.BreadcrumbBtn.BreadcrumbCurrent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.BreadcrumbBtn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">

            <StackPanel Orientation="Horizontal" Spacing="2" Classes="Toolbar">

                <!-- Zoom to Fit -->
                <Button Click="OnZoomToFit"
                        ToolTip.Tip="Zoom to Fit  (F)"
                        Padding="6,3">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                    </StackPanel>
                </Button>

                <!-- Zoom 1:1 -->
                <Button Click="OnZoomToPage"
                        ToolTip.Tip="Reset to 1:1 zoom"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="Magnify" Width="16" Height="16"/>
                </Button>

                <!-- Zoom Box -->
                <Button x:Name="ZoomBoxToolBtn"
                        Click="OnZoomBoxTool"
                        ToolTip.Tip="Zoom Box  (Z)"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Select tool -->
                <Button x:Name="SelectToolBtn"
                        Click="OnSelectTool"
                        ToolTip.Tip="Select  (S)"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="CursorDefault" Width="16" Height="16"/>
                </Button>

                <!-- Wire tool -->
                <Button x:Name="WireToolBtn"
                        Click="OnWireTool"
                        ToolTip.Tip="Wire  (W)"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/>
                </Button>

                <!-- Ground symbol -->
                <Button x:Name="PlaceGroundBtn"
                        Click="OnPlaceGround"
                        ToolTip.Tip="Place Ground"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="ArrowCollapseDown" Width="16" Height="16"/>
                </Button>

                <!-- Term (S-param port) -->
                <Button x:Name="PlacePortBtn"
                        Click="OnPlaceTerm"
                        ToolTip.Tip="Place Term"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="SquareCircle" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Rotate CCW -->
                <Button x:Name="RotateCcwBtn"
                        Classes="SelectionBtn"
                        Click="OnRotateCcw"
                        ToolTip.Tip="Rotate 90° CCW  (R)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="RotateLeft" Width="16" Height="16"/>
                </Button>

                <!-- Rotate CW -->
                <Button x:Name="RotateCwBtn"
                        Classes="SelectionBtn"
                        Click="OnRotateCw"
                        ToolTip.Tip="Rotate 90° CW  (Shift+R)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="RotateRight" Width="16" Height="16"/>
                </Button>

                <!-- Mirror H -->
                <Button x:Name="MirrorHBtn"
                        Classes="SelectionBtn"
                        Click="OnMirrorH"
                        ToolTip.Tip="Mirror Horizontal  (M)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="FlipHorizontal" Width="16" Height="16"/>
                </Button>

                <!-- Mirror V -->
                <Button x:Name="MirrorVBtn"
                        Classes="SelectionBtn"
                        Click="OnMirrorV"
                        ToolTip.Tip="Mirror Vertical  (Shift+M)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="FlipVertical" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Delete -->
                <Button x:Name="DeleteBtn"
                        Classes="SelectionBtn"
                        Click="OnDelete"
                        ToolTip.Tip="Delete  (Del)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="Delete" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Grid Snap toggle -->
                <ToggleButton x:Name="GridSnapToggle"
                              IsChecked="True"
                              Click="OnGridSnapToggle"
                              ToolTip.Tip="Snap to Grid"
                              Padding="6,3">
                    <mi:MaterialIcon Kind="Grid" Width="16" Height="16"/>
                </ToggleButton>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Disable to Open -->
                <Button x:Name="DisableOpenBtn"
                        Classes="SelectionBtn"
                        Click="OnDisableOpen"
                        ToolTip.Tip="Disable → Open circuit (toggles if all selected are already disabled)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="EyeOff" Width="16" Height="16"/>
                </Button>

                <!-- Disable to Short -->
                <Button x:Name="DisableShortBtn"
                        Classes="SelectionBtn"
                        Click="OnDisableShort"
                        ToolTip.Tip="Disable → Short circuit (toggles if all selected are already disabled)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="EyeOffOutline" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Save .csch -->
                <Button Click="OnSaveCsch"
                        ToolTip.Tip="Save schematic  (Ctrl+S)"
                        Padding="6,3">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Push Into Cell -->
                <Button x:Name="PushInBtn"
                        Classes="SelectionBtn"
                        Click="OnToolbarPushIn"
                        ToolTip.Tip="Push Into Cell  (Ctrl+])"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="ArrowDown" Width="16" Height="16"/>
                </Button>

                <!-- Pop Out -->
                <Button x:Name="PopOutBtn"
                        Classes="SelectionBtn"
                        Click="OnToolbarPopOut"
                        ToolTip.Tip="Pop Out  (Ctrl+[)"
                        IsEnabled="False"
                        Padding="6,3">
                    <mi:MaterialIcon Kind="ArrowUp" Width="16" Height="16"/>
                </Button>

                <!-- Separator -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- FPS readout -->
                <TextBlock x:Name="FpsText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontFamily="Monospace"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           Opacity="0.8"/>

            </StackPanel>
        </Border>

        <!-- ── Breadcrumb bar — visible only when pushed in (CanPopOut) ─────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding CanPopOut}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,1">
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

                <!-- Pop to Top button -->
                <Button x:Name="PopToTopBtn"
                        Click="OnPopToTop"
                        ToolTip.Tip="Pop to Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="Home" Width="13" Height="13"/>
                </Button>

                <!-- Divider between Pop to Top and crumb list -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,2"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Crumb list -->
                <ItemsControl x:Name="BreadcrumbItems"
                              ItemsSource="{Binding Breadcrumbs}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="schemDoc:BreadcrumbItem">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Separator glyph before non-first crumbs -->
                                <TextBlock Text=" ▸ "
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           IsVisible="{Binding IsNotFirst}"/>
                                <!-- Crumb button: flat/link style, bold+inert when current -->
                                <Button Classes="BreadcrumbBtn"
                                        Classes.BreadcrumbCurrent="{Binding IsCurrent}"
                                        IsEnabled="{Binding !IsCurrent}"
                                        Content="{Binding Text}"
                                        Tag="{Binding FrameIndex}"
                                        Click="OnBreadcrumbClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- ── Canvas + overlay ─────────────────────────────────────────────── -->
        <Grid>
            <ctrl:SchematicCanvas x:Name="SchematicCanvasCtrl"
                                  Model="{Binding Model}"
                                  ShowFps="True"
                                  ClipToBounds="True">

                <!-- Right-click context menu for components/wires -->
                <ctrl:SchematicCanvas.ContextMenu>
                    <ContextMenu x:Name="ComponentContextMenu"
                                 Opening="OnContextMenuOpening">
                        <MenuItem x:Name="CtxEditParameters"
                                  Header="Edit Parameters"
                                  Click="OnCtxEditParameters">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="Pencil" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="CtxPushIn"
                                  Header="Push In"
                                  IsEnabled="False"
                                  Click="OnCtxPushIn">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="ArrowRight" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="CtxOpenInNewTab"
                                  Header="Open Cell in New Tab"
                                  IsVisible="False"
                                  Click="OnCtxOpenInNewTab">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="OpenInNew" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator x:Name="CtxSep1"/>

                        <MenuItem Header="Rotate 90°"
                                  Click="OnCtxRotate">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="RotateLeft" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="CtxMoveLabels"
                                  Header="Move Labels"
                                  Click="OnCtxMoveLabels"
                                  InputGesture="F5">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="LabelOutline" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="CtxResetLabels"
                                  Header="Reset Label Position"
                                  Click="OnCtxResetLabels">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="LabelOff" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="CtxLabelsSubMenu"
                                  Header="Labels">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="Label" Width="14" Height="14"/>
                            </MenuItem.Icon>
                            <MenuItem x:Name="CtxShowTypeLabel"
                                      Header="Show Type Label"
                                      Click="OnCtxShowTypeLabel"/>
                            <MenuItem x:Name="CtxShowInstanceName"
                                      Header="Show Name"
                                      Click="OnCtxShowInstanceName"/>
                        </MenuItem>

                        <Separator x:Name="CtxSep2"/>

                        <MenuItem x:Name="CtxDisconnect"
                                  Header="Disconnect"
                                  Click="OnCtxDisconnect">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="LinkOff" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator/>

                        <MenuItem Header="Copy"
                                  Click="OnCtxCopy">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Delete"
                                  Click="OnCtxDelete">
                            <MenuItem.Icon>
                                <mi:MaterialIcon Kind="Delete" Width="14" Height="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ctrl:SchematicCanvas.ContextMenu>
            </ctrl:SchematicCanvas>

            <!-- Inline text edit overlay — positioned via Margin from code-behind.
                 Padding="4,2" is explicit so ShowInlineEditBox can use known constants.
                 ContextMenu replaces the theme's built-in ContextFlyout so we can track
                 Opening/Closed and prevent LostFocus from dismissing the box prematurely. -->
            <TextBox x:Name="InlineEditBox"
                     IsVisible="False"
                     Width="140"
                     FontSize="11"
                     FontFamily="{DynamicResource IBMPlexSans}"
                     TextAlignment="Left"
                     Padding="4,2"
                     MinHeight="0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     LostFocus="OnInlineEditLostFocus"
                     KeyDown="OnInlineEditKeyDown">
                <TextBox.ContextMenu>
                    <ContextMenu Opening="OnInlineEditContextMenuOpening">
                        <MenuItem x:Name="InlineCtxCut"
                                  Header="Cut"
                                  Click="OnInlineCtxCut"/>
                        <MenuItem x:Name="InlineCtxCopy"
                                  Header="Copy"
                                  Click="OnInlineCtxCopy"/>
                        <MenuItem Header="Paste"
                                  Click="OnInlineCtxPaste"/>
                        <Separator/>
                        <MenuItem Header="Select All"
                                  Click="OnInlineCtxSelectAll"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </Grid>

    </DockPanel>
</UserControl>
