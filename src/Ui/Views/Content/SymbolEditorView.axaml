<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:symDoc="using:CircuitRF.Ui.Schematic"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:converters="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Content.SymbolEditorView"
             x:DataType="symDoc:SymbolEditorDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <converters:EnumEqualsToBoolConverter x:Key="EnumEqualsBool"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Show tooltips even on disabled buttons throughout this view -->
        <Style Selector="Button">
            <Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
        </Style>

        <!--
            Active tool button states.  Targets the inner ContentPresenter so the Fluent theme's
            grey hover does not override the accent colour (same fix as SchematicView).
        -->
        <Style Selector="Button.ToolActive">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ToolActive /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snap button — ConnectionGrid: opaque accent bg (same strength as ToolActive) -->
        <Style Selector="Button.snap-connection">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.snap-connection /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.snap-connection:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snap button — FineGrid: semi-transparent accent bg -->
        <Style Selector="Button.snap-fine /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.snap-fine:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.65"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- snap-none: no custom style — default button appearance signals snap is off -->
    </UserControl.Styles>

    <DockPanel>

        <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="2">

                    <!-- ── Navigation ──────────────────────────────────────── -->

                    <Button Click="OnZoomToFit"
                            ToolTip.Tip="Zoom to Fit  (F)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Select ──────────────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Select}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Select"
                            ToolTip.Tip="Select / Move  (S)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="CursorDefault" Width="16" Height="16"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Line primitives ─────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Line}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Line"
                            ToolTip.Tip="Line — click and drag"
                            Padding="6,3">
                        <!-- diagonal line, slightly downward left→right — coords in 16×16 px space -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 1,6 L 15,10"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Polyline}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Polyline"
                            ToolTip.Tip="Polyline — click points; Enter or double-click to finish"
                            Padding="6,3">
                        <!-- 4-point zigzag -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 1,11 L 5,5 L 10,11 L 15,6"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Rectangle / circle primitives ──────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Rect}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Rect"
                            ToolTip.Tip="Rectangle — drag corner to corner"
                            Padding="6,3">
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 1,3 H 15 V 13 H 1 Z"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=RoundedRect}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="RoundedRect"
                            ToolTip.Tip="Rounded Rectangle — drag corner to corner"
                            Padding="6,3">
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 3,3 H 13 Q 15,3 15,5 V 11 Q 15,13 13,13 H 3 Q 1,13 1,11 V 5 Q 1,3 3,3 Z"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Circle}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Circle"
                            ToolTip.Tip="Circle — drag from centre"
                            Padding="6,3">
                        <!-- circle cx=8 cy=8 r=6, two semicircles -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 2,8 A 6,6 0 0 1 14,8 A 6,6 0 0 1 2,8 Z"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Ellipse}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Ellipse"
                            ToolTip.Tip="Ellipse — drag bounding box"
                            Padding="6,3">
                        <!-- wider-than-tall ellipse cx=8 cy=8 rx=7 ry=4 -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 1,8 A 7,4 0 0 1 15,8 A 7,4 0 0 1 1,8 Z"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Arc ────────────────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Arc}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Arc"
                            ToolTip.Tip="Arc — drag from centre; 270° sweep"
                            Padding="6,3">
                        <!-- ~270° open arc, center (8,8) r=6 -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 8,2 A 6,6 0 1 1 2,8"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Polygon / triangle ─────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Triangle}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Triangle"
                            ToolTip.Tip="Triangle — click 3 points (auto-commits)"
                            Padding="6,3">
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 8,2 L 15,14 L 1,14 Z"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Polygon}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Polygon"
                            ToolTip.Tip="Polygon — click points; Enter or double-click to close"
                            Padding="6,3">
                        <!-- 5-sided polygon, center (8,8) r=6 -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent"
                              Data="M 8,2 L 14,6 L 12,13 L 4,13 L 2,6 Z"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Bezier curves ───────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=QuadCurve}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="QuadCurve"
                            ToolTip.Tip="Quadratic Bézier — click start, control, end (3 points)"
                            Padding="6,3">
                        <!-- upward arch -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 1,13 Q 8,2 15,13"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=CubicCurve}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="CubicCurve"
                            ToolTip.Tip="Cubic Bézier — click start, ctrl1, ctrl2, end (4 points)"
                            Padding="6,3">
                        <!-- S-curve -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 1,13 C 5,2 11,14 15,3"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Wave shapes ────────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Sine}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Sine"
                            ToolTip.Tip="Sine wave — drag to set length and amplitude"
                            Padding="6,3">
                        <!-- one full sine period via cubic bezier approximation -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="1.5" Fill="Transparent" StrokeLineCap="Round"
                              Data="M 1,8 C 3,2 5,2 8,8 C 11,14 13,14 15,8"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=ExpTaper}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="ExpTaper"
                            ToolTip.Tip="Exponential taper — drag to set length and start width"
                            Padding="6,3">
                        <!-- filled taper: wide left, narrow right, exponential profile -->
                        <Path Width="16" Height="16" VerticalAlignment="Center"
                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              StrokeThickness="0.5"
                              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              Data="M 1,2 C 6,2 11,5 15,7 L 15,9 C 11,11 6,14 1,14 Z"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Text ───────────────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Text}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Text"
                            ToolTip.Tip="Text — click anchor, type, Enter to place"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="FormatText" Width="16" Height="16"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Pin tool ───────────────────────────────────────── -->

                    <Button Classes.ToolActive="{Binding ViewModel.ActiveTool,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Pin}"
                            Command="{Binding ViewModel.SetActiveToolCommand}"
                            CommandParameter="Pin"
                            IsEnabled="{Binding ViewModel.IsEditable}"
                            ToolTip.Tip="Pin — click empty space to place; use Select tool to move, delete, or rotate pins  (P)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="MapMarker" Width="16" Height="16"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Snap mode + Rotate ─────────────────────────────── -->

                    <Button Command="{Binding ViewModel.CycleSnapModeCommand}"
                            IsEnabled="{Binding ViewModel.IsEditable}"
                            Classes.snap-connection="{Binding ViewModel.SnapMode,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=ConnectionGrid}"
                            Classes.snap-fine="{Binding ViewModel.SnapMode,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=FineGrid}"
                            ToolTip.Tip="{Binding ViewModel.SnapModeTooltip}"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="Grid" Width="16" Height="16"/>
                    </Button>

                    <Button Command="{Binding ViewModel.RotateSelectionCommand}"
                            IsEnabled="{Binding ViewModel.IsEditable}"
                            ToolTip.Tip="Rotate Selection 90° CW about origin  (R)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="RotateRight" Width="16" Height="16"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Stroke tier ────────────────────────────────────── -->

                    <TextBlock Text="Stroke:" VerticalAlignment="Center"
                               Margin="2,0,4,0" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="11"/>

                    <Button Classes.ToolActive="{Binding ViewModel.CurrentStrokeTier,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Normal}"
                            Command="{Binding ViewModel.SetCurrentStrokeTierCommand}"
                            CommandParameter="Normal"
                            ToolTip.Tip="Normal stroke weight"
                            Padding="6,3">
                        <TextBlock Text="Normal" FontSize="11"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.CurrentStrokeTier,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Thin}"
                            Command="{Binding ViewModel.SetCurrentStrokeTierCommand}"
                            CommandParameter="Thin"
                            ToolTip.Tip="Thin stroke weight"
                            Padding="6,3">
                        <TextBlock Text="Thin" FontSize="11"/>
                    </Button>

                    <Button Classes.ToolActive="{Binding ViewModel.CurrentStrokeTier,
                                Converter={StaticResource EnumEqualsBool},
                                ConverterParameter=Thick}"
                            Command="{Binding ViewModel.SetCurrentStrokeTierCommand}"
                            CommandParameter="Thick"
                            ToolTip.Tip="Thick stroke weight"
                            Padding="6,3">
                        <TextBlock Text="Thick" FontSize="11"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                            Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- ── Undo / Redo ─────────────────────────────────────── -->

                    <Button Command="{Binding ViewModel.UndoCommand}"
                            ToolTip.Tip="Undo  (⌘Z / Ctrl+Z)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="UndoVariant" Width="16" Height="16"/>
                    </Button>

                    <Button Command="{Binding ViewModel.RedoCommand}"
                            ToolTip.Tip="Redo  (⌘⇧Z / Ctrl+Shift+Z)"
                            Padding="6,3">
                        <mi:MaterialIcon Kind="RedoVariant" Width="16" Height="16"/>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Symbol metadata bar ─────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,2">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                <!-- Locked indicator — visible when UserEditable = false -->
                <Border IsVisible="{Binding ViewModel.IsLocked}"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        CornerRadius="3" Padding="4,1">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <mi:MaterialIcon Kind="Lock" Width="12" Height="12"
                                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock Text="Read-only" FontSize="11"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Dirty marker -->
                <TextBlock Text="●" FontSize="11"
                           IsVisible="{Binding ViewModel.IsDirty}"
                           Foreground="{DynamicResource SystemAccentColor}"
                           ToolTip.Tip="Unsaved changes"
                           VerticalAlignment="Center"/>

                <!-- Current file path (abbreviated) -->
                <TextBlock Text="{Binding ViewModel.CurrentSymbolPath}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ViewModel.CurrentSymbolPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                           ToolTip.Tip="{Binding ViewModel.CurrentSymbolPath}"/>

                <Border Width="1" Height="14"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Port count (read-only; cell-bound = cell authority, orphan = pin count) -->
                <TextBlock Text="{Binding ViewModel.PortsLabel}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           ToolTip.Tip="Port count — cell-bound symbols show the cell's declared port count (read-only); orphan symbols show pin count"/>

                <Border Width="1" Height="14"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Save / Save As -->
                <Button Command="{Binding ViewModel.SaveSymbolCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        IsEnabled="{Binding ViewModel.IsEditable}"
                        ToolTip.Tip="Save  (⌘S / Ctrl+S)"
                        Padding="5,2" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <mi:MaterialIcon Kind="ContentSave" Width="13" Height="13"/>
                        <TextBlock Text="Save"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ViewModel.SaveSymbolAsCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        IsEnabled="{Binding ViewModel.IsEditable}"
                        ToolTip.Tip="Save As…"
                        Padding="5,2" FontSize="11">
                    <TextBlock Text="Save As…"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- ── Canvas ──────────────────────────────────────────────────────── -->
        <ctrl:SymbolEditorCanvas x:Name="SymbolEditorCanvasCtrl"
                                 ViewModel="{Binding ViewModel}"
                                 ClipToBounds="True">
            <ctrl:SymbolEditorCanvas.ContextMenu>
                <ContextMenu Opening="OnBitmapContextMenuOpening">
                    <MenuItem x:Name="CtxBitmapResolvePath" Header="Resolve Path…"  Click="OnCtxBitmapResolvePath"/>
                    <MenuItem x:Name="CtxBitmapRefreshCache" Header="Refresh Cache" Click="OnCtxBitmapRefreshCache"/>
                </ContextMenu>
            </ctrl:SymbolEditorCanvas.ContextMenu>
        </ctrl:SymbolEditorCanvas>

    </DockPanel>
</UserControl>
