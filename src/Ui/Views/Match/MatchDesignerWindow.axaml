<!-- The Match Designer window (match.md §9).

     Its opening size is the GOLDEN RATIO, 1360 : 841 (owner, 2026-08-20: "have the Match Designer
     window size open at the Golden Ratio"). The two response plots inside it are already laid out at
     1.618:1 by AspectRatioPanel, so the window and its contents now agree. MinHeight stays 700 —
     1000 / 1.618 is 618, and a Designer that short cannot show the specification pane at all.

     There is deliberately NO WindowStartupLocation here: the Designer is shown UNOWNED so it can go
     behind the workspace, and CenterOwner needs an Owner. MatchDesignerWindow.ShowUnowned sets both
     the location mode and the position — see its own note on why the owner had to go. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvm="using:CircuitRF.Ui.Matching"
        xmlns:mv="using:CircuitRF.Ui.Views.Match"
        xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:ddv="using:CircuitRF.Ui.DataDisplay.ViewModels"
        xmlns:ddvw="using:CircuitRF.Ui.Views.DataDisplay"
        xmlns:ctl="using:CircuitRF.Ui.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Match.MatchDesignerWindow"
        x:DataType="mvm:MatchDesignerViewModel"
        Title="{Binding Title}"
        Width="1360" Height="841"
        MinWidth="1000" MinHeight="700"
        CanResize="True">

    <!-- Undo/Redo act on the OWNING SCHEMATIC's stack — this window has none of its own, exactly as
         ParameterEditorDialog does. Every committed edit here is one SetParametersCommand, so a
         Designer edit undoes from the schematic tab and from here interchangeably. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"       Command="{Binding RedoCommand}"/>
        <!-- Delete removes a SELECTED MARKER, exactly as it does on a Data Display canvas (owner,
             2026-08-20: "clicking <delete> keystroke with a marker selected does not remove the
             marker from the trace"). DataDisplayView carries the same gesture; this window has no
             canvas and so had nothing bound at all. It is deliberately NOT DeleteSelected: that also
             removes selected PLOT containers, and the Designer's two plots are not deletable
             (CanDeletePlot="False" on both). A TextBox that has focus handles Delete itself, so
             typing is unaffected.

             Delete ONLY, not Backspace as well: several controls in this window are focusable
             without being text fields (InlineEditText at rest, the icon selectors), and a Backspace
             landing on one of those would delete a marker the user was not looking at. The Data
             Display binds Delete alone, and parity with the surface the owner says already works is
             the point of the fix. -->
        <KeyBinding Gesture="Delete"       Command="{Binding DeleteSelectedMarkersCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- One termination card. Two of them, identical in every way but which end they edit —
             which is what a template is for; two hand-written copies drift. -->
        <DataTemplate x:Key="TerminationTemplate" x:DataType="mvm:MatchTerminationViewModel">
            <Border Classes="card">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardhdr" Text="{Binding Header}"/>
                    <TextBlock Grid.Column="1" Text="⚑" FontSize="12"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               IsVisible="{Binding IsFlagged}"
                               ToolTip.Tip="A refusal names this termination — see the status strip"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <mv:MatchPictogramControl Width="44" Height="70" VerticalAlignment="Center"
                                              Pictogram="{Binding Pictogram}"
                                              ResistorOnLeft="{Binding ResistorOnLeft}"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                              ToolTip.Tip="{Binding Pictogram.Description}"/>

                    <!-- Label left, value right — the Array Inductance panel's row shape (owner,
                         2026-08-19: "see how the Array Inductance panel looks… get inspired by it").
                         A column of these is readable at a glance, which a mixed row of radio
                         buttons, boxes and combos never was. -->
                    <StackPanel Grid.Column="1" Spacing="3" Margin="6,0,0,0">
                        <!-- No "Topology" label (owner, 2026-08-20: "remove the Topology text
                             object (2 instance) and move the Parallel/Series UI selector to the
                             left in place of Topology"). The selector's own face already reads
                             "Series" or "Parallel", so the label was the word next to the word. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <ddc:IconSelectButton Width="56" Height="19"
                                                  HorizontalAlignment="Left"
                                                  Background="{DynamicResource ButtonBackground}"
                                                  IsEnabled="{Binding TopologyEnabled}"
                                                  ItemsSource="{x:Static mvm:MatchTerminationViewModel.TopologyOptions}"
                                                  SelectedItem="{Binding TopologyChoice, Mode=TwoWay}"
                                                  ToolTip.Tip="{Binding TopologyTooltip}">
                                <ddc:IconSelectButton.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ddc:IconSelectButton.ItemTemplate>
                            </ddc:IconSelectButton>
                        </Grid>

                        <!-- 24 px, the WIDTH OF THE KIND SELECTOR BELOW, with the letter centred
                             in it (owner, 2026-08-20: "the UI control to set L, C or - is not
                             horizontally aligned to the R text rendered above it"). It could not be:
                             an `Auto` column sized to a 7 px "R" while the row under it sized to a
                             24 px button, so the two glyphs started 10 px apart. One shared column
                             width is what makes them one column. -->
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Classes="detailLabel" Text="R" HorizontalAlignment="Center"/>
                            <ctl:InlineEditText Grid.Column="1" Classes="val" Margin="4,0,0,0"
                                                Text="{Binding ResistanceEntry, Mode=TwoWay}"
                                                ToolTip.Tip="Double-click to edit. Type a unit (50, 50 Ω, 1.2 kΩ) — the number is pre-selected and the unit is left alone."/>
                        </Grid>

                        <!-- ONE row for the reactance, not two (owner, 2026-08-20: "replace the
                             'X' text in the Termination readouts with the C, L, or - selector;
                             reduce [it] to be only 1 character wide; move the Value readout up a row
                             to occupy the former place where the C, L, or - selector used to be").
                             The selector is the row's LABEL now — it names the quantity beside it,
                             which is what the bare "X" was doing and less well.

                             The value is EDITABLE WHATEVER THE KIND IS, "–" included: a typed unit
                             sets the kind (any henry makes it an L, any farad a C) and a typed 0
                             clears it, so this one field is the whole reactance. Disabling it on "–"
                             would be a door that locks behind you — see
                             MatchTerminationViewModel.ReactanceEntry. -->
                        <Grid ColumnDefinitions="24,*">
                            <ddc:IconSelectButton Width="24" Height="19"
                                                  HorizontalAlignment="Left"
                                                  Background="{DynamicResource ButtonBackground}"
                                                  ItemsSource="{x:Static mvm:MatchTerminationViewModel.KindOptions}"
                                                  SelectedItem="{Binding KindChoice, Mode=TwoWay}"
                                                  ToolTip.Tip="C, L, or – for purely resistive (Q = 0, nothing to absorb)">
                                <ddc:IconSelectButton.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ddc:IconSelectButton.ItemTemplate>
                            </ddc:IconSelectButton>
                            <ctl:InlineEditText Grid.Column="1" Classes="val" Margin="4,0,0,0"
                                                Text="{Binding ReactanceEntry, Mode=TwoWay}"
                                                ToolTip.Tip="Double-click to edit. The UNIT decides the kind: any henry (2.2 nH) makes it an L, any farad (1.5 pF) a C, and 0 clears it to –."/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ── Probe (match.md §10) ──────────────────────────────────────
                     The button is disabled with a tooltip that says WHICH of §10.4's reasons it is.

                     Probe, and the provenance of what it last wrote. NO Conjugate checkbox (owner,
                     2026-08-20: "remove the Conjugate checkbox (2 instance) — we should not need it;
                     clicking Probe gets the answer of which R, L, C and topology to use"). The probe
                     reports the network it MEASURED looking outward, which is the termination the
                     synthesis absorbs; conjugating it was a second question asked at the wrong
                     moment. MatchDesign.Term1Conjugate/Term2Conjugate stay on the model and stay
                     false, so an older design that carries one still decodes. -->
                <!-- The button and NOTHING beside it. The "probed 2026-08-20 14:31" line that used
                     to sit here is gone (owner, 2026-08-20: "remove the 'probed' date text that can
                     sometimes appear next to the probe button") — it appeared only after a probe, so
                     the card changed shape under the user for a provenance nobody had asked for. The
                     provenance itself is unaffected: it lives on the design (Termination.Probed /
                     ProbedAtUtc), still survives a save and reload, and is still what §10.5's
                     "a hand edit clears the badge" rule is written against. -->
                <Button Content="Probe" FontSize="11" Padding="8,2" Margin="0,4,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding ProbeCommand}"
                        IsEnabled="{Binding CanProbe}"
                        ToolTip.Tip="{Binding ProbeTooltip}"/>

                <TextBlock Classes="warn" Text="{Binding ProbeError}"
                           IsVisible="{Binding ProbeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Classes="warn" Text="{Binding ProbeFlag}"
                           IsVisible="{Binding ProbeFlag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- The four-candidate listing is GONE (owner, 2026-08-20: "when clicking probe,
                     do not show all the options to the user — simply pick the best option and
                     automatically use it"). It was already applying the best fit; what it also did
                     was print the other three with their residuals and a Use button each, which is
                     a decision handed back to the user immediately after making it for them.

                     Nothing is lost that cannot be undone: applying a probed termination goes
                     through MatchDesignerViewModel.Commit, which is ONE SetParametersCommand on the
                     owning schematic's stack — so Ctrl/Cmd+Z in this window or in the schematic puts
                     the terminations back exactly as they were before the probe. §10.2's poor-fit
                     WARNING is still shown above (ProbeFlag): a fit the user should not trust is
                     said out loud, it is just not a menu. -->

              </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- ── The panel language, taken from the Array Inductance panel ───────────
             (owner, 2026-08-19: "the UI for the SPECIFICATION panel needs to be cleaned up… the
             group box needs a different background colour… get inspired by it to redesign the
             SPECIFICATION panel and any other panels in the Match Designer").

             Two tiers, and the whole point is that they are DIFFERENT: a pane is
             SystemChromeMediumLowColor, a card inside it is SystemChromeLowColor, so a group reads
             as a thing sitting ON the panel rather than as a rectangle drawn on it. Both carry the
             one tile border the rest of the application uses. Headings are sentence case, not
             SHOUTED (owner, same round). -->
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
        </Style>

        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.cardhdr">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style Selector="TextBlock.detailLabel">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Opacity"           Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.detailValue">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Opacity"      Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
            <Setter Property="Foreground"   Value="{DynamicResource CrfWarningBrush}"/>
        </Style>

        <!-- A settable value in a label-left/value-right row: same size and edge as detailValue, so
             the settable rows and the read-only ones line up as one column of numbers. -->
        <Style Selector="ctl|InlineEditText.val">
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- A DISABLED settable value has to LOOK disabled, and nothing else in the stack makes it
             (owner-reported, 2026-08-20, about the ripple field: "the inline text editor does not
             show when I double click on its value"). An InlineEditText at rest is a bare TextBlock,
             and Avalonia's Fluent theme dims neither a disabled TextBlock nor a disabled Panel — so a
             field that was switched off read exactly like one that was on and simply swallowed the
             double-click. `:disabled` follows IsEffectivelyEnabled, so a row whose GRID is disabled
             dims here too, which is what the ripple row and the locked transform rows both are. -->
        <Style Selector="ctl|InlineEditText:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.detailLabel:disabled">
            <Setter Property="Opacity" Value="0.3"/>
        </Style>

        <!-- A click-to-sort column header. Borderless, transparent and with NO horizontal padding,
             because the text under it is a bare TextBlock starting at the column's own left edge —
             any padding or centring here is a misalignment the user can see (owner, 2026-08-20). -->
        <Style Selector="Button.gridhdr">
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Padding"                    Value="0,2"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.gridhdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>

        <Style Selector="TextBox.num">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="4,2"/>
        </Style>

        <!-- The transform rack's N slider (owner-reported, 2026-08-19: "the N indicator in the
             TRANSFORMS panel has a very large height — perhaps the slider is messing with it").
             It was: Fluent's Slider reserves room for tick bands and a full-size thumb, so one in a
             row makes the whole row that tall. The Data Display's inspector already solved this and
             the fix is its fix — no explicit Height (which would squash the thumb off-centre), a
             negative vertical margin that pulls the layout footprint back in. The WIDTH is untouched,
             as asked. -->
        <Style Selector="Slider.compact">
            <Setter Property="Margin"            Value="4,-7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Title bar ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <!-- Icons, not words (owner, 2026-08-20: "change the Solutions, Export, Help and Close
                 buttons to icons, similar to how the Schematic editor toolbar looks"). That toolbar's
                 shape exactly: a bare MaterialIcon at 16 px in a Padding="6,3" button, with the word
                 that used to be on the face moved into ToolTip.Tip — nothing is lost, because a
                 toolbar button with no tooltip is the thing this style would otherwise cost.

                 SETTINGS went with them although the owner named only four. It is the same kind of
                 button on the same strip; left as the one word among the glyphs it reads as an
                 unstyled leftover rather than as a deliberate exception. CLOSE was dropped outright
                 in the same round — see below. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton Padding="6,3"
                              IsChecked="{Binding SolutionsPanelOpen, Mode=TwoWay}"
                              ToolTip.Tip="Solutions — every valid transform set, simplest first; click through them and watch the ladder and the response change">
                    <mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16"/>
                </ToggleButton>
                <Button Name="SettingsButton" Padding="6,3"
                        ToolTip.Tip="Settings — display units, significant digits, Qmin, and whether Q-adjusted solutions are offered">
                    <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16"/>
                </Button>
                <Button Name="ExportButton" Padding="6,3"
                        ToolTip.Tip="Export — Touchstone of the design response, the component listing, or the prototype g-values">
                    <mi:MaterialIcon Kind="ExportVariant" Width="16" Height="16"/>
                </Button>
                <Button Name="HelpButton" Padding="6,3"
                        ToolTip.Tip="Help — the Match chapter of the circuitRF reference">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                </Button>
                <!-- No Close button (owner, 2026-08-20). The window's own title bar already carries
                     one, and a second in the client area is a second thing to aim at that does the
                     same job — it made sense when this strip's buttons were words and the window read
                     as a panel; beside four glyphs it read as chrome duplicating chrome. -->
            </StackPanel>
        </Grid>

        <!-- ── The three panes, plus the solutions drawer ─────────────────── -->
        <!-- The specification column is 215, not 300 (owner, 2026-08-20: "reduce the width of the
             Specification panel so the text and UI elements are closer together within its panel —
             looks like a reduction of 100 pixels or so; careful, we don't want overlapping text").
             Nothing in it wraps or collides at that width because three things gave room back in the
             same round: the reactance's two rows became one, its kind selector went to a single
             character, and the pictogram and topology selector each lost a few pixels. The widest
             row left is "Topology" (about 46 px at 10 pt) plus a 56 px selector, in a card interior
             of 169 px once the pictogram's 44 + 6 is taken out — which leaves room for the pane's
             own scrollbar as well. -->
        <!-- Either of the two right-hand panes can be given the other's width (owner, 2026-08-20:
             "add a button in front of Impedance Matching Network… when clicked, the Schematic and
             Transforms panels expand to the right to occupy more space and the Response panel is no
             longer visible… do the same thing with the Response panel").

             Hiding a pane is NOT enough on its own — a collapsed IsVisible leaves its 380 px column
             standing and the window shows a hole — so the column WIDTH moves with it. The widths are
             set from code-behind (SyncPaneLayout), not bound here: a ColumnDefinition is not in the
             logical tree, so it inherits no DataContext and a {Binding} on one silently resolves to
             nothing. The specification column is untouched in both states: it is the input side, and
             an expansion that hid it would make the window unusable in exactly the moment the user is
             reading detail off the other two. -->
        <Grid Grid.Row="1" Name="PaneGrid" ColumnDefinitions="215,*,380,Auto">

            <!-- Specification -->
            <Border Grid.Column="0" Classes="pane">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="panelhdr" Text="Specification"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- The probe's PROGRESS is not here any more — it is in the footer, beside
                             the solutions summary (owner-reported, 2026-08-20: "if I click probe, the
                             Group box rendering glitches out then returns to normal. Need no
                             glitches"). It was a row that appeared for the duration of the run and
                             then vanished, INSIDE this pane's stack: every card under it slid down
                             when the probe started and back up when it finished. The footer is a
                             fixed Auto row whose content is always present, so the same two lines and
                             the same Cancel button now cost nothing to show. -->

                        <TextBlock Classes="warn" Text="{Binding PayloadError}"
                                   IsVisible="{Binding PayloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <ContentControl Content="{Binding Term1}" ContentTemplate="{StaticResource TerminationTemplate}"/>
                        <ContentControl Content="{Binding Term2}" ContentTemplate="{StaticResource TerminationTemplate}"/>

                        <!-- Band: TWO labelled edges (owner, 2026-08-19: "needs text labels for f1
                             and f2, there's currently only just 'f'"). One "f" over two boxes left
                             the reader to work out which was which from their order. The unit combo
                             that used to sit beside them is gone with the others — see the R row. -->
                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardhdr" Text="Frequency Band"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="detailLabel" Text="f1"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val"
                                                        Text="{Binding F1Entry, Mode=TwoWay}"
                                                        ToolTip.Tip="Lower band edge. Double-click to edit; a typed unit (2.4 GHz, 900 MHz) moves BOTH edges' display unit."/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="detailLabel" Text="f2"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val"
                                                        Text="{Binding F2Entry, Mode=TwoWay}"
                                                        ToolTip.Tip="Upper band edge. Double-click to edit; a typed unit moves BOTH edges' display unit."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardhdr" Text="Order"/>
                                <!-- A SELECTOR, not a typed field (owner, 2026-08-20: "the Order
                                     needs to be that custom icon selector UI element whose options
                                     change depending on the two terminations"). Its items ARE
                                     OrderOptions — only the parities this termination pair permits
                                     (match.md §4.2) — so the refusal the typed field had to spell out
                                     is now made by simply not offering the order. -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="detailLabel" Text="Elements"/>
                                    <ddc:IconSelectButton Grid.Column="1" Width="34" Height="19"
                                                          HorizontalAlignment="Right"
                                                          Background="{DynamicResource ButtonBackground}"
                                                          ItemsSource="{Binding OrderChoices}"
                                                          SelectedItem="{Binding OrderChoice, Mode=TwoWay}"
                                                          ToolTip.Tip="{Binding OrderTooltip}">
                                        <ddc:IconSelectButton.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ddc:IconSelectButton.ItemTemplate>
                                    </ddc:IconSelectButton>
                                </Grid>
                                <TextBlock Classes="note" Text="{Binding OrderNote}"
                                           IsVisible="{Binding OrderNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <!-- The response family is a ComboBox, not four radio buttons (owner,
                             2026-08-19). An infeasible family still APPEARS, disabled, carrying the
                             refusal that explains it — dropping it from the list would answer "why
                             can't I pick Bessel?" by saying nothing at all. It is a LIST of four with
                             one-line descriptions, which is the one selector an IconSelectButton
                             would make worse: that control shows a glyph, and these are sentences. -->
                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardhdr" Text="Filter Response"/>
                                <ComboBox FontSize="11" HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding ResponseOptions}"
                                          SelectedItem="{Binding SelectedResponseOption, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="mvm:MatchResponseOptionViewModel">
                                            <TextBlock Text="{Binding Display}" FontSize="11"
                                                       IsEnabled="{Binding IsEnabled}"
                                                       Opacity="{Binding ListOpacity}"
                                                       ToolTip.Tip="{Binding Tooltip}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="warn" Text="{Binding ResponseRefusal}"
                                           IsVisible="{Binding ResponseRefusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                <!-- Ripple: four characters is the whole ask ("0.05"). It IS an
                                     input — but only for the real-to-real prototype, and the row was
                                     disabled with nothing to show for it (owner, 2026-08-20: "is
                                     Ripple, dB supposed to be an input? If so, the inline text editor
                                     does not show when I double click on its value").

                                     It could not: InlineEditText rests as a bare TextBlock, and a
                                     disabled TextBlock in Avalonia looks EXACTLY like an enabled one
                                     — so the row read as a live field that ignored the gesture. Two
                                     things fix that and neither is "make it always editable": the
                                     row dims when it does not apply, and RippleNote says which of
                                     the two terminations is the reason. -->
                                <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding RippleEnabled}">
                                    <TextBlock Classes="detailLabel" Text="Ripple, dB"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val" MinWidth="46"
                                                        Text="{Binding RippleEntry, Mode=TwoWay}"
                                                        ToolTip.Tip="Equal-ripple level in dB — the real-to-real prototype only. Double-click to edit."/>
                                </Grid>
                                <TextBlock Classes="note" Text="{Binding RippleNote}"
                                           IsVisible="{Binding RippleNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="cardhdr" Text="Options"/>
                                <CheckBox FontSize="11" Content="Q-adjust" MinHeight="0"
                                          IsChecked="{Binding QAdjustEnabled, Mode=TwoWay}"
                                          ToolTip.Tip="Deliberately inflate the analysis end's Q so a lower order completes — adds one element at that end"/>
                                <CheckBox FontSize="11" Content="Allow negative components" MinHeight="0"
                                          IsChecked="{Binding AllowNegativeComponents, Mode=TwoWay}"
                                          ToolTip.Tip="Widens every transform's range past its positivity threshold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Network + Transforms -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding !ResponseExpanded}">
                <Border Classes="pane">
                    <!-- The schematic on top, the component listing UNDER it (owner, 2026-08-19:
                         "move the grid listing of components so that it appears in a scrollview under
                         the schematic; remove the schematic/grid radio UI selector"). They are two
                         views of one network, and a selector that showed one at a time made the user
                         choose between the picture and the numbers. -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                        <!-- The pane header carries its name and ONE control: the expander that
                             gives this pane the response pane's width (owner, 2026-08-20). The
                             glyph IS the state — down-and-right while there is room to take, up-and-
                             left once it has been taken. The "scroll to zoom…" line the header used
                             to carry is still gone (owner, same round). -->
                        <Grid ColumnDefinitions="Auto,*">
                            <ToggleButton Name="NetworkExpandButton" Padding="3,1" Margin="0,0,6,4"
                                          MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                          IsChecked="{Binding NetworkExpanded, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding NetworkExpandTooltip}">
                                <mi:MaterialIcon Kind="{Binding NetworkExpandIcon}" Width="14" Height="14"/>
                            </ToggleButton>
                            <TextBlock Grid.Column="1" Classes="panelhdr"
                                       Text="Impedance Matching Network"/>
                        </Grid>

                        <!-- A REAL circuitRF schematic, drawn by the editor's own renderer. See
                             MatchSchematicCanvas — nothing here is editable. -->
                        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                                BorderBrush="{DynamicResource CrfTileBorderBrush}">
                            <!-- The canvas and, over it, the SCHEMATIC EDITOR'S OWN inline text box
                                 (owner, 2026-08-20: "reuse the exact same inline text editor from the
                                 regular schematic — that is the preferred solution"). The box is added
                                 from code rather than declared here so both surfaces get it from the
                                 one place that defines it, Controls/SchematicInlineEditBox; a second
                                 declaration is a second set of paddings to drift.

                                 It is a sibling of the canvas in a Panel — NOT a child of it — because
                                 the canvas is a Control that renders through a Skia draw operation and
                                 has no visual children of its own. -->
                            <Panel Name="NetworkSchematicHost">
                                <mv:MatchSchematicCanvas Name="NetworkSchematic" Layout="{Binding Ladder}"/>
                                <!-- OVERLAID, top-left, and outside the canvas's own transform, so it
                                     stays put through any zoom or pan (owner, 2026-08-20: "add a Zoom
                                     to Fit (F) button overlayed in the top left corner of the
                                     schematic… it should look and feel exactly like the Schematic
                                     editor's Zoom to Fit button"). Same glyph, same 16 px, same
                                     Padding="6,3", same tooltip text as SchematicView's toolbar
                                     button — a source-scan test holds the three together.

                                     It is why the double-click re-frame is gone: two ways to do one
                                     thing, one of which also had to be told apart from the
                                     double-click that opens a value's inline editor. -->
                                <Button Name="NetworkZoomFitButton"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="4" Padding="6,3"
                                        ToolTip.Tip="Zoom to Fit  (F)">
                                    <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                                </Button>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock Classes="note" Text="{Binding LadderLegend}"
                                       IsVisible="{Binding LadderLegend, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- What the last inline value edit did. A typed element value is a
                                 TARGET the transforms are searched for, so "the closest this ladder
                                 can reach is X" is an ordinary outcome and has to be said. -->
                            <TextBlock Classes="warn" Text="{Binding InlineEditNote}"
                                       IsVisible="{Binding InlineEditNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- The value listing. A plain header-plus-rows Grid rather than a DataGrid:
                             the DataGrid control lives in a package this project does not reference,
                             and three read-only columns with click-to-sort headers do not justify
                             adding one.

                             THE TWO COLUMN STRINGS BELOW MUST STAY IDENTICAL — a source-scan test
                             holds them together (MatchRound3Tests). Owner-reported, 2026-08-20: "the
                             column headers in the grid view are not horizontally aligned with the
                             contents below it". They could not be: the header carried a SIXTH `Auto`
                             column for the Copy as CSV button, so the star pool it divided was ~80px
                             narrower than the rows' and every boundary landed somewhere else. The
                             button is gone entirely — copying is on the listing's own context menu
                             now, which is where a grid's copy belongs. -->
                        <Grid Grid.Row="3" ColumnDefinitions="1.6*,*,1.4*" Margin="0,6,0,0">
                            <Button Classes="gridhdr" Content="Instance" Tag="instance" Click="OnSortGrid"/>
                            <Button Grid.Column="1" Classes="gridhdr" Content="Type"  Tag="type"  Click="OnSortGrid"/>
                            <Button Grid.Column="2" Classes="gridhdr" Content="Value" Tag="value" Click="OnSortGrid"/>
                        </Grid>
                        <ScrollViewer Grid.Row="4" MaxHeight="170" Margin="0,2,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <!-- Transparent, so the whole listing area takes the pointer and a
                                 right-click on the empty part below the last row still opens the
                                 menu. A panel with no background is not hit-testable in Avalonia. -->
                            <ItemsControl Name="ElementsList" ItemsSource="{Binding Elements}"
                                          Background="Transparent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvm:MatchElementRowViewModel">
                                        <Grid ColumnDefinitions="1.6*,*,1.4*" Margin="0,1">
                                            <TextBlock Text="{Binding Instance}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueWithUnit}" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="pane" MinHeight="150">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="Transforms"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <!-- "+" and a chevron, no word (owner, 2026-08-20: "remove the word
                                     'add' from the add transform button"). The chevron is what says
                                     it opens a menu; beside the "−" next to it the pair reads as one
                                     control. The tooltip carries what the word used to. -->
                                <Button Name="AddTransformButton" FontSize="11" Padding="6,2"
                                        ToolTip.Tip="Add a transform on one of the pairs this ladder offers">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="+" VerticalAlignment="Center"/>
                                        <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Name="RemoveTransformButton" Content="−" FontSize="11" Padding="8,2"
                                        IsEnabled="{Binding CanRemoveTransform}"/>
                                <!-- Icons, not emoji. The user-docs factory measured it (2026-08-20):
                                     U+1F517 and U+1F512 are covered by NO circuitRF typeface and by no
                                     shipped fallback either, so Skia substituted the platform colour-emoji
                                     font and the generated figures carried a name that only resolves on
                                     this machine. The same fix the Technology chevron already took. -->
                                <!-- The glyph alone (owner, 2026-08-20: "remove the word 'link' from
                                     the link button"). A chain link beside a lock in the same rack is
                                     already the pair the user reads; the word only repeated it. -->
                                <ToggleButton FontSize="11" Padding="6,2"
                                              IsChecked="{Binding LinkTransforms, Mode=TwoWay}"
                                              ToolTip.Tip="Link — moving one N re-solves the unlocked others so Π N² stays on target">
                                    <mi:MaterialIcon Kind="LinkVariant" Width="13" Height="13"/>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- One refusal line for the whole rack, not one per row: a per-row message
                             would move every row below it the moment it appeared, which is the shift
                             the inline editor was built to avoid in the first place. -->
                        <TextBlock Grid.Row="2" Classes="warn" Text="{Binding TransformNote}"
                                   IsVisible="{Binding TransformNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Transforms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvm:MatchTransformRowViewModel">
                                        <!-- Five columns, not six: the trailing "on (C2, C3)"
                                             indicator is gone (owner, 2026-08-20). The pair a
                                             transform acts on is already said by the brace drawn
                                             under those very elements in the schematic above. -->
                                        <Grid ColumnDefinitions="34,44,74,*,30" Margin="0,1">
                                            <TextBlock Classes="lbl" Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <ddc:IconSelectButton Grid.Column="1" Width="34" Height="19"
                                                                  IsEnabled="{Binding !IsDropped}"
                                                                  ItemsSource="{x:Static mvm:MatchTransformRowViewModel.FormOptions}"
                                                                  SelectedItem="{Binding FormChoice, Mode=TwoWay}"
                                                                  ToolTip.Tip="Which three-element equivalent this transform produces: π or T">
                                                <ddc:IconSelectButton.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ddc:IconSelectButton.ItemTemplate>
                                            </ddc:IconSelectButton>
                                            <!-- N reads as TEXT and opens the same inline editor every
                                                 other settable value in this window uses (owner,
                                                 2026-08-20: "the textedit box of the N1/N2… transforms
                                                 to text; allow user to change it using the inline text
                                                 editor; its input must be validated/refused if bad
                                                 input"). The refusal is the view-model's — see
                                                 MatchTransformRowViewModel.NEntry — and it names the
                                                 range rather than silently clamping into it. -->
                                            <ctl:InlineEditText Grid.Column="2" Classes="val"
                                                               Margin="4,0,0,0"
                                                               HorizontalContentAlignment="Center"
                                                               IsEnabled="{Binding CanEditN}"
                                                               Text="{Binding NEntry, Mode=TwoWay}"
                                                               ToolTip.Tip="{Binding NTooltip}"/>
                                            <Slider Grid.Column="3" Classes="compact"
                                                    Minimum="{Binding NMin}" Maximum="{Binding NMax}"
                                                    Value="{Binding N, Mode=TwoWay}"
                                                    IsEnabled="{Binding CanEditN}"
                                                    Tag="{Binding}"
                                                    Loaded="OnSliderLoaded"/>
                                            <ToggleButton Grid.Column="4" FontSize="11" Padding="2"
                                                          MinHeight="0" MinWidth="0"
                                                          IsChecked="{Binding Locked, Mode=TwoWay}"
                                                          ToolTip.Tip="A locked transform is never written by the linkage">
                                                <mi:MaterialIcon Kind="Lock" Width="13" Height="13"/>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Response -->
            <!-- The pane sits on the Data Display's own canvas colour (owner, 2026-08-20: "background
                 color of the Response group UI needs to be the same as the background color of the
                 Data display"). CrfDataDisplayCanvasBrush is the same application-scope key
                 PlotCanvasView paints with — see Styles/CircuitRfResources.axaml. -->
            <Border Grid.Column="2" Classes="pane"
                    IsVisible="{Binding !NetworkExpanded}"
                    Background="{DynamicResource CrfDataDisplayCanvasBrush}">
              <!-- The two plots are laid out at a FIXED aspect ratio, so their height follows the
                   pane's width rather than the pane's height — which means a short window can run out
                   of room. Scroll rather than squash: a golden-ratio plot that has been squashed is
                   not a golden-ratio plot. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <!-- The Response pane's own expander, mirrored: down-and-LEFT at rest, because
                         the space it takes is the network pane's and that is where it comes from
                         (owner, 2026-08-20), and up-and-right once it has it. The two toggles are
                         mutually exclusive — see MatchDesignerViewModel.NetworkExpanded. -->
                    <Grid ColumnDefinitions="Auto,*">
                        <ToggleButton Name="ResponseExpandButton" Padding="3,1" Margin="0,0,6,4"
                                      MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                      IsChecked="{Binding ResponseExpanded, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding ResponseExpandTooltip}">
                            <mi:MaterialIcon Kind="{Binding ResponseExpandIcon}" Width="14" Height="14"/>
                        </ToggleButton>
                        <TextBlock Grid.Column="1" Classes="panelhdr" Text="Response"/>
                    </Grid>
                    <!-- Golden aspect ratio on both rect plots (owner, 2026-08-19). AspectRatioPanel
                         LAYS the plot out at 1.618:1 — a Viewbox would scale the axis text and the
                         stroke weights along with the frame, which is a different thing entirely. -->
                    <ctl:AspectRatioPanel Grid.Row="1" Margin="0,2">
                        <!-- CanDeletePlot / CanEditPlotProperties are OFF here (owner, 2026-08-20:
                             "the plot's context menu shows Delete Plot as enabled — it should be
                             disabled in a Match Designer window. Same with Plot Properties…").
                             Neither is meaningful on a fixed pair of plots the Designer owns: there
                             is nothing to delete them from, and their traces are rebuilt from the
                             design on every edit, so an inspector edit would not survive the next
                             keystroke. PlotTheme follows the window's own light/dark variant —
                             without it the axes, ticks and marker glyphs render out of
                             RenderTheme.Light whatever the application theme is. -->
                        <ddc:PlotControl Name="MagnitudePlotControl"
                                         Plot="{Binding MagnitudePlot}"
                                         Library="{Binding PlotHost.Library}"
                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                    </ctl:AspectRatioPanel>
                    <ctl:AspectRatioPanel Grid.Row="2" Margin="0,2">
                        <ddc:PlotControl Name="PhasePlotControl"
                                         Plot="{Binding PhasePlot}"
                                         Library="{Binding PlotHost.Library}"
                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                    </ctl:AspectRatioPanel>

                    <!-- Both boxes commit on RETURN as well as on focus loss (owner, 2026-08-20:
                         "committing using return key on band and points textedit boxes does not
                         update the frequency response plots"). They only ever had a LostFocus
                         handler, so a user who typed a number and pressed Return saw nothing move
                         and had no reason to think the value had not been taken. -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*" Margin="0,4">
                        <TextBlock Classes="detailLabel" Text="± band "/>
                        <TextBox Grid.Column="1" Classes="num" Name="BandFractionBox"/>
                        <TextBlock Grid.Column="2" Classes="detailLabel" Text=" points "/>
                        <TextBox Grid.Column="3" Classes="num" Name="PlotPointsBox"/>
                    </Grid>

                    <Border Grid.Row="4" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Status.QText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.ReturnLossText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.LossText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.RatioText}" FontSize="11"/>
                            <TextBlock Classes="warn" Text="{Binding Status.Refusal.Message}"
                                       IsVisible="{Binding Status.IsRefused}"/>
                            <TextBlock Classes="warn" Text="{Binding ResponseError}"
                                       IsVisible="{Binding ResponseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="note" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!--
                        Marker info-box overlay — the Data Display's own, item for item: an
                        ItemsControl over a Canvas, both with Background="{x:Null}" so they are NOT
                        hit-testable and every click falls through to the plots beneath, while each
                        MarkerInfoBoxView (which sets its own Background="Transparent") is.

                        It spans the whole pane rather than one plot's cell because an info box is
                        DRAGGABLE and belongs to the display, not to the plot it was made from —
                        MarkerInfoBoxViewModel.ViewLeft/ViewTop are in this panel's coordinates, which
                        is why MatchDesignerWindow.SyncPlotContainers keeps each container's
                        Left/Top/Width/Height equal to its PlotControl's rectangle in the same space.
                    -->
                    <ItemsControl Name="MarkerInfoBoxLayer" Grid.Row="0" Grid.RowSpan="5"
                                  ItemsSource="{Binding PlotHost.MarkerInfoBoxes}"
                                  Background="{x:Null}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="{x:Null}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{ReflectionBinding ViewLeft}"/>
                                <Setter Property="Canvas.Top"  Value="{ReflectionBinding ViewTop}"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ddv:MarkerInfoBoxViewModel">
                                <ddvw:MarkerInfoBoxView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
              </ScrollViewer>
            </Border>

            <!-- Solutions — a dockable drawer, NOT a modal sheet: the user has to be able to click
                 through candidates and watch the ladder and the response change. -->
            <Border Grid.Column="3" Classes="pane" Width="330"
                    IsVisible="{Binding SolutionsPanelOpen}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="panelhdr" Text="Solutions"/>
                    <TextBlock Grid.Row="1" Classes="warn" Text="{Binding SolutionsRefusal}"
                               IsVisible="{Binding SolutionsRefusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Solutions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mvm:MatchSolutionRowViewModel">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="18,*,Auto">
                                            <TextBlock Text="{Binding BadgeGlyph}" FontSize="12"
                                                       ToolTip.Tip="{Binding BadgeTooltip}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Classes="note" Text="{Binding PairsText}"/>
                                                <TextBlock Classes="note" Text="{Binding QAdjustText}"
                                                           IsVisible="{Binding QAdjustText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBlock Classes="note" Text="{Binding ReturnLossText}"/>
                                                <TextBlock Classes="warn" Text="{Binding ImplausibleNote}"
                                                           IsVisible="{Binding ImplausibleValues}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Apply" FontSize="10" Padding="6,2"
                                                    VerticalAlignment="Top"
                                                    Tag="{Binding}" Click="OnApplySolution"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Footer ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,6">
            <!-- The solutions summary, replaced while the background analysis runs: the two occupy
                 the same slot because the summary IS what that analysis produces, and showing a
                 stale count beside a spinner would be two answers to one question. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- The ORPHAN line replaces both, because it is the only thing worth saying about a
                     window whose component has been deleted (owner, 2026-08-20). Everything that
                     writes is already shut off at MatchDesignerViewModel.Commit; this is the part the
                     user can see. -->
                <TextBlock Classes="warn" Text="{Binding OrphanNote}" TextWrapping="NoWrap"
                           VerticalAlignment="Center" IsVisible="{Binding IsOrphaned}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !IsOrphaned}">
                    <TextBlock Text="{Binding SolutionsSummary}" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding !IsAnalysing}"/>
                    <TextBlock Text="Searching solutions and response families…" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center" IsVisible="{Binding IsAnalysing}"/>
                </StackPanel>

                <!-- A probe is a real S-parameter sweep, and on a biased transistor a real DC solve
                     first, so it runs off the UI thread with the engine's own progress and
                     cancellation — and it reports HERE, in a row that already exists, rather than by
                     growing the specification pane for the duration of the run. -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsProbing}">
                    <TextBlock FontSize="11" Opacity="0.85" VerticalAlignment="Center"
                               Text="{Binding ProbeStatus}"/>
                    <ProgressBar Width="120" Height="4" Minimum="0" Maximum="1"
                                 VerticalAlignment="Center" Value="{Binding ProbeProgress}"/>
                    <Button Content="Cancel" FontSize="10" Padding="6,1"
                            Command="{Binding CancelProbeCommand}"/>
                </StackPanel>
                <!-- Where a standalone Designer says what its Flatten did. A schematic-bound one
                     posts the same sentence to the workspace's Messages pane through its schematic's
                     MessageSink; with no schematic there is no sink, and a flatten that writes a
                     folder and says nothing is one the user has no reason to believe happened. -->
                <TextBlock Text="{Binding FlattenOutcome}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding FlattenOutcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="{Binding FlattenOutcome}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Flatten to Cell…" FontSize="11" Padding="8,3"
                        IsEnabled="{Binding CanFlatten}"
                        Click="OnFlattenToCell"
                        ToolTip.Tip="{Binding FlattenTooltip}"/>
                <Button Name="RevertButton" Content="Revert" FontSize="11" Padding="8,3"
                        IsEnabled="{Binding !IsOrphaned}"
                        ToolTip.Tip="Put the design back the way this window found it — one undoable step"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
