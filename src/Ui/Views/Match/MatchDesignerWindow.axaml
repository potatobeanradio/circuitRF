<!-- The Match Designer window (match.md §9).

     Its opening size is the GOLDEN RATIO, 1199 : 741 (owner, 2026-08-20: "have the Match Designer
     window size open at the Golden Ratio", then "reduce the Match Designer window height by ~100
     pixels; reduce width to maintain the Golden ratio"). 841 - 100 = 741, and 741 x 1.618 = 1199, so
     the ratio is held to four figures rather than approximately. The two response plots inside it are
     already laid out at 1.618:1 by AspectRatioPanel, so the window and its contents still agree.
     MinHeight stays 700 — 1000 / 1.618 is 618, and a Designer that short cannot show the
     specification pane at all; 741 clears it, so the opening size is still a size the window can
     actually take.

     There is deliberately NO WindowStartupLocation here: the Designer is shown UNOWNED so it can go
     behind the workspace, and CenterOwner needs an Owner. MatchDesignerWindow.ShowUnowned sets both
     the location mode and the position — see its own note on why the owner had to go. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvm="using:CircuitRF.Ui.Matching"
        xmlns:mv="using:CircuitRF.Ui.Views.Match"
        xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:ddv="using:CircuitRF.Ui.DataDisplay.ViewModels"
        xmlns:ddvw="using:CircuitRF.Ui.Views.DataDisplay"
        xmlns:ctl="using:CircuitRF.Ui.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Match.MatchDesignerWindow"
        x:DataType="mvm:MatchDesignerViewModel"
        Title="{Binding Title}"
        Width="1199" Height="741"
        MinWidth="1000" MinHeight="700"
        CanResize="True">

    <!-- Undo/Redo act on the OWNING SCHEMATIC's stack — this window has none of its own, exactly as
         ParameterEditorDialog does. Every committed edit here is one SetParametersCommand, so a
         Designer edit undoes from the schematic tab and from here interchangeably. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"       Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"       Command="{Binding RedoCommand}"/>
        <!-- Delete removes a SELECTED MARKER, exactly as it does on a Data Display canvas (owner,
             2026-08-20: "clicking <delete> keystroke with a marker selected does not remove the
             marker from the trace"). DataDisplayView carries the same gesture; this window has no
             canvas and so had nothing bound at all. It is deliberately NOT DeleteSelected: that also
             removes selected PLOT containers, and the Designer's two plots are not deletable
             (CanDeletePlot="False" on both). A TextBox that has focus handles Delete itself, so
             typing is unaffected.

             Delete ONLY, not Backspace as well: several controls in this window are focusable
             without being text fields (InlineEditText at rest, the icon selectors), and a Backspace
             landing on one of those would delete a marker the user was not looking at. The Data
             Display binds Delete alone, and parity with the surface the owner says already works is
             the point of the fix. -->
        <KeyBinding Gesture="Delete"       Command="{Binding DeleteSelectedMarkersCommand}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- One termination card. Two of them, identical in every way but which end they edit —
             which is what a template is for; two hand-written copies drift. -->
        <DataTemplate x:Key="TerminationTemplate" x:DataType="mvm:MatchTerminationViewModel">
            <Border Classes="card">
              <StackPanel Spacing="3">
                <!-- ── The header row carries the Probe button ───────────────────
                     Owner, 2026-08-28: each Probe button had a row of its own, and the two
                     termination cards were asked to give some of that vertical height back — with the
                     right of the "Termination <x>" heading suggested as where the button could go.

                     Exactly there. The button used to be the card's last row, under the R/X block,
                     with its own 4 px top margin and the stack's 3 px spacing above that — a whole
                     row of the specification column spent on one small button per card, twice. Beside
                     the heading it costs the difference between a 11 pt line and a 17 px button,
                     which is four pixels, and the two cards give back the rest to the Solutions list
                     below (see that pane's own note).

                     The flag stays on the FAR right, in its own `*`-separated column: it marks the
                     card, not the button, and a refusal's flag sitting immediately beside a control
                     would read as being about that control. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Classes="cardhdr" Text="{Binding Header}" VerticalAlignment="Center"/>
                    <!-- The button is disabled with a tooltip that says WHICH of match.md §10.4's
                         reasons it is. NO Conjugate checkbox (owner, 2026-08-20: "remove the
                         Conjugate checkbox (2 instance) — we should not need it; clicking Probe gets
                         the answer of which R, L, C and topology to use"). The probe reports the
                         network it MEASURED looking outward, which is the termination the synthesis
                         absorbs; conjugating it was a second question asked at the wrong moment.
                         MatchDesign.Term1Conjugate/Term2Conjugate stay on the model and stay false,
                         so an older design that carries one still decodes.

                         The "probed 2026-08-20 14:31" line that used to sit beside it is gone (owner,
                         2026-08-20: "remove the 'probed' date text that can sometimes appear next to
                         the probe button") — it appeared only after a probe, so the card changed shape
                         under the user for a provenance nobody had asked for. The provenance itself is
                         unaffected: it lives on the design (Termination.Probed / ProbedAtUtc), still
                         survives a save and reload, and is still what §10.5's "a hand edit clears the
                         badge" rule is written against. -->
                    <!-- HARD RIGHT, under the card's own padding, which is what puts it over the
                         right edge of the R and X value fields below (owner, 2026-08-28: move it to
                         hug the right side of the group box, with some padding, aligned with the R
                         and X values below it). Those fields are the `*` column of their own rows and
                         so run to that same edge — one line, and the three right edges agree.

                         No Height. A fixed one was what left the label sitting against the top of the
                         button; the fix for that is global (see CircuitRfStyles' Button style) and a
                         button sized by its own padding does not raise the question at all. -->
                    <Button Grid.Column="2" Content="Probe" FontSize="10"
                            Padding="8,1" MinHeight="0" Margin="8,0,0,2"
                            VerticalAlignment="Center"
                            Command="{Binding ProbeCommand}"
                            IsEnabled="{Binding CanProbe}"
                            ToolTip.Tip="{Binding ProbeTooltip}"/>
                    <TextBlock Grid.Column="3" Text="⚑" FontSize="12" Margin="4,0,0,0"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               IsVisible="{Binding IsFlagged}"
                               ToolTip.Tip="A refusal names this termination — see the status strip"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*">
                    <mv:MatchPictogramControl Width="44" Height="70" VerticalAlignment="Center"
                                              Pictogram="{Binding Pictogram}"
                                              ResistorOnLeft="{Binding ResistorOnLeft}"
                                              Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                              ToolTip.Tip="{Binding Pictogram.Description}"/>

                    <!-- Label left, value right — the Array Inductance panel's row shape (owner,
                         2026-08-19: "see how the Array Inductance panel looks… get inspired by it").
                         A column of these is readable at a glance, which a mixed row of radio
                         buttons, boxes and combos never was. -->
                    <StackPanel Grid.Column="1" Spacing="3" Margin="6,0,0,0">
                        <!-- No "Topology" label (owner, 2026-08-20: "remove the Topology text
                             object (2 instance) and move the Parallel/Series UI selector to the
                             left in place of Topology"). The selector's own face already reads
                             "Series" or "Parallel", so the label was the word next to the word. -->
                        <Grid ColumnDefinitions="Auto,*">
                            <ddc:IconSelectButton Width="56" Height="19"
                                                  HorizontalAlignment="Left"
                                                  Background="{DynamicResource ButtonBackground}"
                                                  IsEnabled="{Binding TopologyEnabled}"
                                                  ItemsSource="{x:Static mvm:MatchTerminationViewModel.TopologyOptions}"
                                                  SelectedItem="{Binding TopologyChoice, Mode=TwoWay}"
                                                  ToolTip.Tip="{Binding TopologyTooltip}">
                                <ddc:IconSelectButton.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ddc:IconSelectButton.ItemTemplate>
                            </ddc:IconSelectButton>
                        </Grid>

                        <!-- 24 px, the WIDTH OF THE KIND SELECTOR BELOW, with the letter centred
                             in it (owner, 2026-08-20: "the UI control to set L, C or - is not
                             horizontally aligned to the R text rendered above it"). It could not be:
                             an `Auto` column sized to a 7 px "R" while the row under it sized to a
                             24 px button, so the two glyphs started 10 px apart. One shared column
                             width is what makes them one column. -->
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Classes="detailLabel" Text="R" HorizontalAlignment="Center"/>
                            <ctl:InlineEditText Grid.Column="1" Classes="val" Margin="4,0,0,0"
                                                Text="{Binding ResistanceEntry, Mode=TwoWay}"
                                                ToolTip.Tip="Double-click to edit. Type a unit (50, 50 Ω, 1.2 kΩ) — the number is pre-selected and the unit is left alone."/>
                        </Grid>

                        <!-- ONE row for the reactance, not two (owner, 2026-08-20: "replace the
                             'X' text in the Termination readouts with the C, L, or - selector;
                             reduce [it] to be only 1 character wide; move the Value readout up a row
                             to occupy the former place where the C, L, or - selector used to be").
                             The selector is the row's LABEL now — it names the quantity beside it,
                             which is what the bare "X" was doing and less well.

                             The value is EDITABLE WHATEVER THE KIND IS, "–" included: a typed unit
                             sets the kind (any henry makes it an L, any farad a C) and a typed 0
                             clears it, so this one field is the whole reactance. Disabling it on "–"
                             would be a door that locks behind you — see
                             MatchTerminationViewModel.ReactanceEntry. -->
                        <Grid ColumnDefinitions="24,*">
                            <ddc:IconSelectButton Width="24" Height="19"
                                                  HorizontalAlignment="Left"
                                                  Background="{DynamicResource ButtonBackground}"
                                                  ItemsSource="{x:Static mvm:MatchTerminationViewModel.KindOptions}"
                                                  SelectedItem="{Binding KindChoice, Mode=TwoWay}"
                                                  ToolTip.Tip="C, L, or – for purely resistive (Q = 0, nothing to absorb)">
                                <ddc:IconSelectButton.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ddc:IconSelectButton.ItemTemplate>
                            </ddc:IconSelectButton>
                            <ctl:InlineEditText Grid.Column="1" Classes="val" Margin="4,0,0,0"
                                                Text="{Binding ReactanceEntry, Mode=TwoWay}"
                                                ToolTip.Tip="Double-click to edit. The UNIT decides the kind: any henry (2.2 nH) makes it an L, any farad (1.5 pF) a C, and 0 clears it to –."/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ── Probe (match.md §10) ──────────────────────────────────────
                     The BUTTON is up in the header row now (owner, 2026-08-28) — see its note there.
                     What is left here is what the probe has to SAY, and it stays at the bottom of the
                     card because that is where a card's own messages belong. Both lines are empty
                     until there is something to report, so a probe that works costs no height at
                     all. -->
                <TextBlock Classes="warn" Text="{Binding ProbeError}"
                           IsVisible="{Binding ProbeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <TextBlock Classes="warn" Text="{Binding ProbeFlag}"
                           IsVisible="{Binding ProbeFlag, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- The four-candidate listing is GONE (owner, 2026-08-20: "when clicking probe,
                     do not show all the options to the user — simply pick the best option and
                     automatically use it"). It was already applying the best fit; what it also did
                     was print the other three with their residuals and a Use button each, which is
                     a decision handed back to the user immediately after making it for them.

                     Nothing is lost that cannot be undone: applying a probed termination goes
                     through MatchDesignerViewModel.Commit, which is ONE SetParametersCommand on the
                     owning schematic's stack — so Ctrl/Cmd+Z in this window or in the schematic puts
                     the terminations back exactly as they were before the probe. §10.2's poor-fit
                     WARNING is still shown above (ProbeFlag): a fit the user should not trust is
                     said out loud, it is just not a menu. -->

              </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- ── The panel language, taken from the Array Inductance panel ───────────
             (owner, 2026-08-19: "the UI for the SPECIFICATION panel needs to be cleaned up… the
             group box needs a different background colour… get inspired by it to redesign the
             SPECIFICATION panel and any other panels in the Match Designer").

             Two tiers, and the whole point is that they are DIFFERENT: a pane is
             SystemChromeMediumLowColor, a card inside it is SystemChromeLowColor, so a group reads
             as a thing sitting ON the panel rather than as a rectangle drawn on it. Both carry the
             one tile border the rest of the application uses. Headings are sentence case, not
             SHOUTED (owner, same round). -->
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
        </Style>

        <!-- ── The applied solution's card ────────────────────────────────────────
             (owner, 2026-08-28: "the solution that is currently being viewed has a check mark
             indicator on its card. This needs to be more prominent and obvious to the user… Consider
             using bold text in the card's title, perhaps change the check mark color indictor to
             green?")

             All three, and all three from ONE class: `Classes.current="{Binding IsCurrent}"` on the
             card, with these selectors reaching its children. A tick alone could not carry it — at
             12 px in the same foreground as the ring beside it, on a list that is now long enough to
             scroll, it was a character the eye had to hunt for.

             The green is stated here rather than taken from a theme key because there is no success
             brush in CircuitRfResources (CrfWarningBrush is the only semantic colour there, and it is
             red). #2FA85A reads as green against both SystemChromeLowColor variants without being the
             saturated one that would compete with the schematic's own accents. -->
        <Style Selector="Border.card.current">
            <Setter Property="BorderBrush"     Value="#2FA85A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="TextBlock.solbadge">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="Border.card.current TextBlock.solbadge">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2FA85A"/>
        </Style>
        <!-- ── `:is(TextBlock)`, NOT `TextBlock`, on the three classes the solution card uses ──
             An Avalonia type selector matches that type EXACTLY. `SelectableTextBlock` derives from
             `TextBlock`, so `TextBlock.note` skips it silently and the card's lines fell back to the
             inherited font size — which is what made them jump when they became selectable
             (owner-reported, 2026-08-28). `:is()` is the selector that includes derived types.

             Only these three move, because only these three are worn by a SelectableTextBlock. The
             rest stay exact-type selectors: nothing in this window subclasses them, and a widened
             selector is a wider blast radius for no gain. -->
        <Style Selector=":is(TextBlock).soltitle">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.card.current :is(TextBlock).soltitle">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── The solutions list virtualizes ─────────────────────────────────────
             A bare ItemsControl inside a ScrollViewer is NOT virtualized: Avalonia's ItemsControl
             defaults to a plain StackPanel and, given a ScrollViewer's infinite measure height,
             realizes EVERY item. That was fine when the panel held one order's solutions in one
             family; it is not fine now that it holds the whole cross-product — the shipped default
             document comes back with 444 rows, each a card of seven text blocks, and realizing three
             thousand controls is the opposite of the responsiveness this round is for.

             ListBox is the fix, its default ItemsPanel being a VirtualizingStackPanel, and it is the
             SAME answer this codebase already settled on twice (TechEditorView's row lists, the
             wBond Touchstone export dialog's port list) — including the class name. These styles are
             those styles: flatten the selection chrome so a virtualized row reads as a card rather
             than as something to pick from. The card's own `current` border is what marks the applied
             one; a selection highlight beside it would be a second, contradictory mark. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Margin"                     Value="0"/>
            <Setter Property="MinHeight"                  Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.cardhdr">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style Selector="TextBlock.detailLabel">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Opacity"           Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.detailValue">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- :is() for the same reason as .soltitle above — the solution card wears both of these
             on a SelectableTextBlock. -->
        <Style Selector=":is(TextBlock).note">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Opacity"      Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector=":is(TextBlock).warn">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
            <Setter Property="Foreground"   Value="{DynamicResource CrfWarningBrush}"/>
        </Style>

        <!-- A settable value in a label-left/value-right row: same size and edge as detailValue, so
             the settable rows and the read-only ones line up as one column of numbers. -->
        <Style Selector="ctl|InlineEditText.val">
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>

        <!-- A DISABLED settable value has to LOOK disabled, and nothing else in the stack makes it
             (owner-reported, 2026-08-20, about the ripple field: "the inline text editor does not
             show when I double click on its value"). An InlineEditText at rest is a bare TextBlock,
             and Avalonia's Fluent theme dims neither a disabled TextBlock nor a disabled Panel — so a
             field that was switched off read exactly like one that was on and simply swallowed the
             double-click. `:disabled` follows IsEffectivelyEnabled, so a row whose GRID is disabled
             dims here too, which is what the ripple row and the locked transform rows both are. -->
        <Style Selector="ctl|InlineEditText:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBlock.detailLabel:disabled">
            <Setter Property="Opacity" Value="0.3"/>
        </Style>

        <!-- A click-to-sort column header. Borderless, transparent and with NO horizontal padding,
             because the text under it is a bare TextBlock starting at the column's own left edge —
             any padding or centring here is a misalignment the user can see (owner, 2026-08-20). -->
        <Style Selector="Button.gridhdr">
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Padding"                    Value="0,2"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>
        <Style Selector="Button.gridhdr:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>

        <Style Selector="TextBox.num">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="4,2"/>
        </Style>

        <!-- The transform rack's N slider (owner-reported, 2026-08-19: "the N indicator in the
             TRANSFORMS panel has a very large height — perhaps the slider is messing with it").
             It was: Fluent's Slider reserves room for tick bands and a full-size thumb, so one in a
             row makes the whole row that tall. The Data Display's inspector already solved this and
             the fix is its fix — no explicit Height (which would squash the thumb off-centre), a
             negative vertical margin that pulls the layout footprint back in. The WIDTH is untouched,
             as asked. -->
        <Style Selector="Slider.compact">
            <Setter Property="Margin"            Value="4,-7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Title bar ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,6">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <!-- Icons, not words (owner, 2026-08-20: "change the Solutions, Export, Help and Close
                 buttons to icons, similar to how the Schematic editor toolbar looks"). That toolbar's
                 shape exactly: a bare MaterialIcon at 16 px in a Padding="6,3" button, with the word
                 that used to be on the face moved into ToolTip.Tip — nothing is lost, because a
                 toolbar button with no tooltip is the thing this style would otherwise cost.

                 SETTINGS went with them although the owner named only four. It is the same kind of
                 button on the same strip; left as the one word among the glyphs it reads as an
                 unstyled leftover rather than as a deliberate exception. CLOSE was dropped outright
                 in the same round — see below. -->
            <!-- No Solutions toggle (owner, 2026-08-28: "move the Solutions listing to be under the
                 Frequency Band group in the Specification panel"). The list is not a drawer any more
                 and there is nothing left for a toggle to open; a button that hid the specification
                 pane's own lower half would be a different control answering a question nobody asked. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <!-- ── Undo and Redo (owner, 2026-08-28) ──────────────────────────
                     Left of Settings, in the same glyph language as the rest of the strip. The
                     COMMANDS are not new and neither is the behaviour: MatchDesignerViewModel's
                     UndoCommand and RedoCommand have always delegated to the owning schematic's own
                     stack, because a Designer edit IS a schematic edit and a second history beside it
                     would be two answers to "what did I just do". Ctrl+Z in this window already went
                     there; what was missing was somewhere to aim a pointer.

                     Their tooltips name the entry, so the strip says WHAT would be undone rather than
                     just that something would be — the same UndoDescription the application's own
                     Edit menu reads, and it is why a Designer that has just amended its own commit
                     (see CommitCore) reads as one entry here too.

                     IsEnabled IS STATED, and that is not belt-and-braces (owner-reported, 2026-08-28:
                     the two buttons were always disabled). Binding Command alone leaves a Button's
                     enablement to arrive through ICommand.CanExecuteChanged, and its first evaluation
                     happens when the binding attaches — which is after SetTarget has run, against an
                     empty stack, so the answer is false and stays false. Every other gated button in
                     this window says so outright for the same reason: Probe reads CanProbe, the
                     scroll-to-applied button reads HasAppliedSolution. -->
                <Button Name="UndoButton" Padding="6,3"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}"
                        ToolTip.Tip="{Binding UndoTooltip}">
                    <mi:MaterialIcon Kind="UndoVariant" Width="16" Height="16"/>
                </Button>
                <Button Name="RedoButton" Padding="6,3"
                        Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}"
                        ToolTip.Tip="{Binding RedoTooltip}">
                    <mi:MaterialIcon Kind="RedoVariant" Width="16" Height="16"/>
                </Button>
                <Button Name="SettingsButton" Padding="6,3"
                        ToolTip.Tip="Settings — display units, significant digits and Qmin">
                    <mi:MaterialIcon Kind="CogOutline" Width="16" Height="16"/>
                </Button>
                <Button Name="ExportButton" Padding="6,3"
                        ToolTip.Tip="Export — Touchstone of the design response, the component listing, or the prototype g-values">
                    <mi:MaterialIcon Kind="ExportVariant" Width="16" Height="16"/>
                </Button>
                <Button Name="HelpButton" Padding="6,3"
                        ToolTip.Tip="Help — the Match chapter of the circuitRF reference">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                </Button>
                <!-- No Close button (owner, 2026-08-20). The window's own title bar already carries
                     one, and a second in the client area is a second thing to aim at that does the
                     same job — it made sense when this strip's buttons were words and the window read
                     as a panel; beside four glyphs it read as chrome duplicating chrome. -->
            </StackPanel>
        </Grid>

        <!-- ── The three panes ────────────────────────────────────────────── -->
        <!-- The specification column is 285, WIDENED from 215 (owner, 2026-08-28: "widen the
             Specification panel slightly"), and there is no fourth column any more. Both are the
             same change: the Solutions list moved out of its own 330 px drawer and into this pane,
             so the pane has to hold a card that carries a family name, an order, a pair listing and
             an Apply button — which 215 cannot. The window is 70 px narrower in total for it, since
             what left was 330 wide whenever it was open.

             215 was itself a reduction from 300 (owner, 2026-08-20: "reduce the width of the
             Specification panel so the text and UI elements are closer together within its panel").
             What that round bought is not given back: the reactance's two rows are still one row,
             its kind selector is still a single character, and the termination cards are unchanged —
             they simply have 70 px of slack now, which is where a solution card's own text goes. -->
        <!-- Either of the two right-hand panes can be given the other's width (owner, 2026-08-20:
             "add a button in front of Impedance Matching Network… when clicked, the Schematic and
             Transforms panels expand to the right to occupy more space and the Response panel is no
             longer visible… do the same thing with the Response panel").

             Hiding a pane is NOT enough on its own — a collapsed IsVisible leaves its 380 px column
             standing and the window shows a hole — so the column WIDTH moves with it. The widths are
             set from code-behind (SyncPaneLayout), not bound here: a ColumnDefinition is not in the
             logical tree, so it inherits no DataContext and a {Binding} on one silently resolves to
             nothing. The specification column is untouched in both states: it is the input side, and
             an expansion that hid it would make the window unusable in exactly the moment the user is
             reading detail off the other two. -->
        <Grid Grid.Row="1" Name="PaneGrid" ColumnDefinitions="285,*,380">

            <!-- Specification -->
            <!-- THREE CARDS LEFT (owner, 2026-08-28): the two terminations, the band, and the ripple.
                 Order, Filter Response and Options were removed in the same round — "they are no
                 longer needed because we now have the Solution panel displaying all the possible
                 solutions". Each of the three was an INPUT that narrowed a search to one answer; the
                 search now runs the whole order x family cross-product with Q-adjusted candidates and
                 negative components both included, so the same four knobs live on the Solutions
                 filter as a view over the result. What stays here is what genuinely specifies the
                 PROBLEM rather than the search: what is at each end, over what band, to what ripple.

                 The two automatic-change notes those cards carried (OrderNote, QAdjustNote) moved to
                 the top of the pane rather than going with them. They are not about a control — they
                 say that the design changed underneath the user, which is still true and still worth
                 saying when there is no longer a control to say it beside. -->
            <Border Grid.Column="0" Classes="pane">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Classes="panelhdr" Text="Specification"/>

                    <!-- MaxHeight, so the solutions list below always has room. An Auto row over a
                         star row takes what it wants first, and three cards plus four notes can
                         exceed a short window on their own — at which point the star row underneath
                         collapses to nothing and the list the user came here to read is not on
                         screen at all. Bounded here and scrolled, the two divide the pane instead.

                         300, DOWN FROM 392 (owner, 2026-08-28: the Solutions listing needs more
                         vertical space, room is to be made for it, and the height the changes above
                         free is to go to it). Ninety-two pixels of it, and the two
                         changes above are where they come from: the band and ripple cards became one
                         (a border, a heading and a card margin), and each termination's Probe button
                         moved off its own row and onto the card's heading. The cards fit in what is
                         left, so what this cap actually decides is the FLOOR under the Solutions
                         list, which is the half of the pane the owner asked to grow — a cap that
                         merely tracked the content would have handed the saving straight back the
                         first time a note appeared. -->
                    <ScrollViewer Grid.Row="1" MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- The probe's PROGRESS is not here — it is in the footer, beside the
                             solutions summary (owner-reported, 2026-08-20: "if I click probe, the
                             Group box rendering glitches out then returns to normal. Need no
                             glitches"). It was a row that appeared for the duration of the run and
                             then vanished, INSIDE this pane's stack: every card under it slid down
                             when the probe started and back up when it finished. The footer is a
                             fixed Auto row whose content is always present, so the same two lines and
                             the same Cancel button now cost nothing to show. -->

                        <TextBlock Classes="warn" Text="{Binding PayloadError}"
                                   IsVisible="{Binding PayloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- An echo parameter that has fallen behind the design — reachable since the
                             payload became hand-editable. See CheckEchoParameters for why it is
                             reported and not rewritten. -->
                        <TextBlock Classes="note" Text="{Binding EchoNote}"
                                   IsVisible="{Binding EchoNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- An order the terminations no longer permit is MOVED, and a Q-adjust they
                             have overtaken is CLEARED. Both used to sit inside the card whose control
                             they were about; both cards are gone and both changes still happen, so
                             they say so here. See AdjustOrderForParity and AdjustQAdjustForAnalysisEnd. -->
                        <TextBlock Classes="note" Text="{Binding OrderNote}"
                                   IsVisible="{Binding OrderNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Classes="note" Text="{Binding QAdjustNote}"
                                   IsVisible="{Binding QAdjustNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <ContentControl Content="{Binding Term1}" ContentTemplate="{StaticResource TerminationTemplate}"/>
                        <ContentControl Content="{Binding Term2}" ContentTemplate="{StaticResource TerminationTemplate}"/>

                        <!-- ── Frequency Band & Ripple — ONE card, three rows ─────────────
                             Owner, 2026-08-28: the Frequency Band and Ripple groups are to become one
                             group headed "Frequency Band & Ripple", with three rows — f1, f2 and
                             Ripple, dB.

                             They were two cards, and the second held ONE row. A card costs its
                             border, its 8,5 padding, its 5 px bottom margin and a heading line, so
                             the second one spent roughly thirty pixels of the specification column
                             on framing a single field — height the Solutions list below wanted
                             more (see that pane's own note). Nothing about either input changes:
                             both edges and the ripple keep their own row, their own label and their
                             own tooltip, and the ripple row keeps the IsEnabled and the note that go
                             with it.

                             TWO labelled band edges, not one "f" (owner, 2026-08-19: "needs text
                             labels for f1 and f2, there's currently only just 'f'"). One "f" over
                             two boxes left the reader to work out which was which from their order.

                             RIPPLE SURVIVED the Filter Response card it used to live in, and had to:
                             it is an input to the PROBLEM (the equal-ripple level the real-to-real
                             prototype is built to), not a choice of family. Its row dims when it does
                             not apply and RippleNote says which end is the reason. It could not
                             before (owner, 2026-08-20: "is Ripple, dB supposed to be an input? If so,
                             the inline text editor does not show when I double click on its value")
                             — an InlineEditText rests as a bare TextBlock and Avalonia does not dim a
                             disabled one, so a switched-off row read as live and swallowed the
                             gesture. RippleNote is ONE SHORT LINE; the paragraph it used to be is on
                             the row's own tooltip.

                             The three label columns are all `Auto` and each row sizes its own, which
                             is right here and not an oversight: "f1" and "Ripple, dB" are of very
                             different widths, and one shared column would push both value fields in
                             by the width of the longest label to buy an alignment nobody reads down.
                             The shared-column rule this window does keep is the termination card's
                             R-over-kind-selector, where the two glyphs sit in ONE column and had to
                             be told to. -->
                        <Border Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="cardhdr" Text="Frequency Band &amp; Ripple"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="detailLabel" Text="f1"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val"
                                                        Text="{Binding F1Entry, Mode=TwoWay}"
                                                        ToolTip.Tip="Lower band edge. Double-click to edit; a typed unit (2.4 GHz, 900 MHz) moves BOTH edges' display unit."/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="detailLabel" Text="f2"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val"
                                                        Text="{Binding F2Entry, Mode=TwoWay}"
                                                        ToolTip.Tip="Upper band edge. Double-click to edit; a typed unit moves BOTH edges' display unit."/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding RippleEnabled}">
                                    <TextBlock Classes="detailLabel" Text="Ripple, dB"/>
                                    <ctl:InlineEditText Grid.Column="1" Classes="val" MinWidth="46"
                                                        Text="{Binding RippleEntry, Mode=TwoWay}"
                                                        ToolTip.Tip="{Binding RippleTooltip}"/>
                                </Grid>
                                <TextBlock Classes="note" Text="{Binding RippleNote}"
                                           IsVisible="{Binding RippleNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- ── Solutions ────────────────────────────────────────────────────────
                         Owner, 2026-08-28: "move the Solutions listing to be under the Frequency Band
                         group in the Specification panel", and "the Solutions panel [lists] all the
                         solutions for every filter response and order". It is not a drawer any more
                         and it is not opened; it is the lower half of this pane, always out, because
                         picking a network from it IS how the design is now specified.

                         It fills as the background search finds them (owner: "UI needs to feel
                         responsive so if the solution list is built (and added to the UI) in the
                         background that would be nice") — the design's own order and family are
                         searched first and land immediately, the rest are inserted around them in
                         canonical order. SolutionsProgressNote is what says the list is not final
                         yet, so a short list mid-search is never mistaken for the whole answer. -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Classes="cardhdr" Text="Solutions" VerticalAlignment="Center"/>

                            <!-- Back to the applied card (owner, 2026-08-28: "add a button next to
                                 the filter button that will auto-scroll to the current solution
                                 card"). The list scrolls there once when it first has one to show,
                                 and after that it stays where the user put it — which is right, and
                                 leaves them with no way back once they have scrolled through four
                                 hundred rows looking for something better. This is that way back.

                                 Same borderless transparent shape as the filter beside it. Disabled
                                 when there is nothing to go to: a design on a hand-set transform set
                                 matches no row, and a button that scrolls nowhere is worse than one
                                 that is plainly unavailable. -->
                            <Button Grid.Column="1" Name="ScrollToAppliedButton"
                                    ToolTip.Tip="Scroll to the applied solution"
                                    IsEnabled="{Binding HasAppliedSolution}"
                                    Padding="3,2" Background="Transparent" BorderThickness="0">
                                <mi:MaterialIcon Kind="TargetVariant" Width="14" Height="14"
                                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            </Button>
                            <!-- The Project Tree's own filter control, to the letter (owner,
                                 2026-08-28: "change the Filter UI in the Solutions panel to be more
                                 like the Project Tree filter UI for workspaces. It uses checkboxes
                                 and overall has a way better UX; I also like its icon better"). Same
                                 borderless transparent button, same MaterialIcon Kind="Filter" in
                                 SystemBaseMediumColor, same Button.Flyout holding a spaced StackPanel
                                 of 12 pt CheckBoxes — see ProjectTreeView.axaml, which is where all
                                 of it comes from.

                                 The two ItemsControls are the one thing that view does not need: its
                                 eight categories are fixed, and the orders here come from
                                 MatchOrders.ValidOrders and change with the termination pair (two for
                                 a like pair, three for a mixed one, five when either end is
                                 resistive). A checkbox per row, generated, is the same control with
                                 the same behaviour — what could not be written out is the LIST, not
                                 the line.

                                 NO DOT ON THE BUTTON (owner, 2026-08-28: it is distracting). It was
                                 a small warning-coloured ellipse that appeared whenever the filter was
                                 hiding something, so "no solutions" and "no solutions shown" could be
                                 told apart at a glance — but the default filter hides negative-
                                 component solutions, so it was lit on almost every design, at a
                                 warning colour, for a state that is normal. A mark that is always on
                                 marks nothing. The distinction it was for is still made, twice and
                                 in words: the tooltip is Filter.Summary, which says what is hidden,
                                 and the footer's own line counts what is listed. -->
                            <Button Grid.Column="2" Name="SolutionsFilterButton"
                                    ToolTip.Tip="{Binding Filter.Summary}"
                                    Padding="3,2" Background="Transparent" BorderThickness="0">
                                <mi:MaterialIcon Kind="Filter" Width="14" Height="14"
                                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="3" Margin="8">
                                            <!-- Form first (match.md §16.7). It is the coarsest cut
                                                 in the list and the one a user reaches for to
                                                 compare like with like: three bandpass rows and
                                                 three lowpass rows at the same order are two
                                                 different networks answering the same question. -->
                                            <ItemsControl ItemsSource="{Binding Filter.Forms}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mvm:MatchSolutionFilterToggle">
                                                        <CheckBox IsChecked="{Binding IsOn}"
                                                                  Content="{Binding Label}" FontSize="12"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Separator/>
                                            <ItemsControl ItemsSource="{Binding Filter.Orders}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mvm:MatchSolutionFilterToggle">
                                                        <CheckBox IsChecked="{Binding IsOn}"
                                                                  Content="{Binding Label}" FontSize="12"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Separator/>
                                            <ItemsControl ItemsSource="{Binding Filter.Responses}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="mvm:MatchSolutionFilterToggle">
                                                        <CheckBox IsChecked="{Binding IsOn}"
                                                                  Content="{Binding Label}" FontSize="12"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Separator/>
                                            <CheckBox IsChecked="{Binding Filter.ShowQAdjusted}"
                                                      Content="Q-adjusted" FontSize="12"
                                                      ToolTip.Tip="§4.6's deliberately inflated analysis-end Q — an ordinary network with one more element at that end. Listed by default."/>
                                            <CheckBox IsChecked="{Binding Filter.ShowNegativeComponents}"
                                                      Content="Allow negative components" FontSize="12"
                                                      ToolTip.Tip="Solutions carrying an element at or below zero — exact, and only buildable by absorbing it into a neighbour. Hidden by default."/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" Classes="note" Text="{Binding SolutionsProgressNote}"
                                   IsVisible="{Binding IsSearchingSolutions}"/>
                        <TextBlock Grid.Row="2" Classes="warn" Text="{Binding SolutionsRefusal}"
                                   IsVisible="{Binding SolutionsRefusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- ── APPLYING A SOLUTION MUST NOT MOVE THE LIST ────────────────
                             Owner-reported, 2026-08-28: applying a solution — by double-clicking a
                             card, or by its Apply button — nudges the scroll view. It should not move
                             at all; the only things that change are the applied card's green border
                             and the button's own wording.

                             It scrolled for TWO independent reasons, and both had to go or the
                             remaining one would still nudge it:

                             * `AutoScrollToSelectedItem` is a SelectingItemsControl default of TRUE.
                               A double-click on a card selects its ListBoxItem on the way through,
                               and the ListBox then scrolls the whole item into view — so a card that
                               was half off the bottom edge slid up under the pointer at the exact
                               moment the user was reading the result of their own double-click.
                               Selection means NOTHING in this list (the styles above flatten every
                               piece of its chrome — the `current` border is the mark, not the
                               selection), so nothing is lost by switching the scroll off.

                             * `ScrollViewer.BringIntoViewOnFocusChange` is a ScrollContentPresenter
                               default of TRUE: clicking the Apply button focuses it, and the focus
                               change asks the nearest scroller to bring it into view. That is the
                               half the button click hit, which is why the two gestures scrolled by
                               slightly different amounts.

                             Neither switch touches the EXPLICIT scroll: `ListBox.ScrollIntoView` is
                             what the header's target button and the once-only automatic scroll call
                             (see ScrollToApplied), and it still works — these two only stop the
                             list scrolling itself as a side effect of a click.

                             Keyboard scrolling does not come from here either: Page Up/Down, Home and
                             End are routed to this list by the window, through the same
                             PanelScrollKeys the Project Tree and the .ctech editor use, so they work
                             wherever the focus happens to be. See OnPanelScrollKeyDown. -->
                        <ListBox Grid.Row="3" Name="SolutionsList" Classes="rows" Margin="0,4,0,0"
                                 AutoScrollToSelectedItem="False"
                                 ScrollViewer.BringIntoViewOnFocusChange="False"
                                 ItemsSource="{Binding Solutions}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="mvm:MatchSolutionRowViewModel">
                                        <!-- Classes.current drives all three marks of the applied row
                                             from one flag: the green tick, the bold title and the
                                             card's own accent border. See the styles at the top. -->
                                        <!-- ── THE CARD IS THE BUTTON ────────────────────────
                                             Owner, 2026-08-28: the Apply / Applied button comes off
                                             the card and a solution is applied as soon as the user
                                             clicks the card itself.

                                             So there is no Click handler here and no DoubleTapped
                                             either: SELECTING a row is what applies it, and the
                                             ListBox already turns a click — and an arrow key — into a
                                             selection. One path, and it is the framework's own, which
                                             is why the keyboard gesture needed no second
                                             implementation. See OnSolutionSelectionChanged.

                                             The hand cursor is the whole affordance now that the
                                             button is gone. What marks the applied row is unchanged:
                                             the green border, the bold title and the tick, all three
                                             from Classes.current — see the styles at the top. -->
                                        <!-- ── EVERY LINE IS SELECTABLE TEXT ────────────────
                                             Owner, 2026-08-28: the card's text is a readout — the
                                             element pairs, the return loss, the refusal-adjacent
                                             warnings — and a readout you cannot copy out of is one
                                             you have to retype. Same rule the Messages pane and the
                                             harmonicaRF readout strip already follow.

                                             The badge stays a plain TextBlock: it is a tick or a
                                             ring, there is nothing in it to copy, and it carries the
                                             tooltip that explains it.

                                             SelectableTextBlock SETS e.Handled ON PointerPressed and
                                             CAPTURES the pointer, and InputElement's class handler
                                             for that event is registered WITHOUT handledEventsToo —
                                             so ListBoxItem.OnPointerPressed never runs and clicking
                                             a card's TEXT would no longer apply it. The gesture is
                                             restored deterministically by a TUNNELLING handler on
                                             the list itself; see OnSolutionsPointerPressed. -->
                                        <Border Classes="card" Classes.current="{Binding IsCurrent}"
                                                Cursor="Hand">
                                            <Grid ColumnDefinitions="16,*">
                                                <TextBlock Classes="solbadge" Text="{Binding BadgeGlyph}"
                                                           ToolTip.Tip="{Binding BadgeTooltip}"/>
                                                <StackPanel Grid.Column="1">
                                                    <SelectableTextBlock Classes="soltitle" Text="{Binding TitleText}"
                                                                         TextWrapping="Wrap"/>
                                                    <SelectableTextBlock Classes="note" Text="{Binding CountText}"/>
                                                    <SelectableTextBlock Classes="note" Text="{Binding PairsText}"/>
                                                    <!-- A Q-adjust and a negative element get a line
                                                         each; their ABSENCE gets nothing (owner,
                                                         2026-08-28). -->
                                                    <SelectableTextBlock Classes="note" Text="{Binding QAdjustText}"
                                                                         IsVisible="{Binding QAdjustText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    <SelectableTextBlock Classes="note" Text="{Binding ReturnLossText}"/>
                                                    <SelectableTextBlock Classes="warn" Text="{Binding NegativeNote}"
                                                                         IsVisible="{Binding HasNegativeComponents}"/>
                                                    <SelectableTextBlock Classes="warn" Text="{Binding ImplausibleNote}"
                                                                         IsVisible="{Binding ImplausibleValues}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Network + Transforms -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding !ResponseExpanded}">
                <Border Classes="pane">
                    <!-- The schematic on top, the component listing UNDER it (owner, 2026-08-19:
                         "move the grid listing of components so that it appears in a scrollview under
                         the schematic; remove the schematic/grid radio UI selector"). They are two
                         views of one network, and a selector that showed one at a time made the user
                         choose between the picture and the numbers. -->
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                        <!-- The pane header carries its name and ONE control: the expander that
                             gives this pane the response pane's width (owner, 2026-08-20). The
                             glyph IS the state — down-and-right while there is room to take, up-and-
                             left once it has been taken. The "scroll to zoom…" line the header used
                             to carry is still gone (owner, same round). -->
                        <Grid ColumnDefinitions="Auto,*">
                            <ToggleButton Name="NetworkExpandButton" Padding="3,1" Margin="0,0,6,4"
                                          MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                          IsChecked="{Binding NetworkExpanded, Mode=TwoWay}"
                                          ToolTip.Tip="{Binding NetworkExpandTooltip}">
                                <mi:MaterialIcon Kind="{Binding NetworkExpandIcon}" Width="14" Height="14"/>
                            </ToggleButton>
                            <TextBlock Grid.Column="1" Classes="panelhdr"
                                       Text="Impedance Matching Network"/>
                        </Grid>

                        <!-- A REAL circuitRF schematic, drawn by the editor's own renderer. See
                             MatchSchematicCanvas — nothing here is editable. -->
                        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                                BorderBrush="{DynamicResource CrfTileBorderBrush}">
                            <!-- The canvas and, over it, the SCHEMATIC EDITOR'S OWN inline text box
                                 (owner, 2026-08-20: "reuse the exact same inline text editor from the
                                 regular schematic — that is the preferred solution"). The box is added
                                 from code rather than declared here so both surfaces get it from the
                                 one place that defines it, Controls/SchematicInlineEditBox; a second
                                 declaration is a second set of paddings to drift.

                                 It is a sibling of the canvas in a Panel — NOT a child of it — because
                                 the canvas is a Control that renders through a Skia draw operation and
                                 has no visual children of its own. -->
                            <Panel Name="NetworkSchematicHost">
                                <mv:MatchSchematicCanvas Name="NetworkSchematic" Layout="{Binding Ladder}"/>
                                <!-- OVERLAID, top-left, and outside the canvas's own transform, so it
                                     stays put through any zoom or pan (owner, 2026-08-20: "add a Zoom
                                     to Fit (F) button overlayed in the top left corner of the
                                     schematic… it should look and feel exactly like the Schematic
                                     editor's Zoom to Fit button"). Same glyph, same 16 px, same
                                     Padding="6,3", same tooltip text as SchematicView's toolbar
                                     button — a source-scan test holds the three together.

                                     It is why the double-click re-frame is gone: two ways to do one
                                     thing, one of which also had to be told apart from the
                                     double-click that opens a value's inline editor. -->
                                <Button Name="NetworkZoomFitButton"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="4" Padding="6,3"
                                        ToolTip.Tip="Zoom to Fit  (F)">
                                    <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                                </Button>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,4,0,0">
                            <TextBlock Classes="note" Text="{Binding LadderLegend}"
                                       IsVisible="{Binding LadderLegend, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- What the last inline value edit did. A typed element value is a
                                 TARGET the transforms are searched for, so "the closest this ladder
                                 can reach is X" is an ordinary outcome and has to be said. -->
                            <TextBlock Classes="warn" Text="{Binding InlineEditNote}"
                                       IsVisible="{Binding InlineEditNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>

                        <!-- The value listing. A plain header-plus-rows Grid rather than a DataGrid:
                             the DataGrid control lives in a package this project does not reference,
                             and three read-only columns with click-to-sort headers do not justify
                             adding one.

                             THE TWO COLUMN STRINGS BELOW MUST STAY IDENTICAL — a source-scan test
                             holds them together (MatchRound3Tests). Owner-reported, 2026-08-20: "the
                             column headers in the grid view are not horizontally aligned with the
                             contents below it". They could not be: the header carried a SIXTH `Auto`
                             column for the Copy as CSV button, so the star pool it divided was ~80px
                             narrower than the rows' and every boundary landed somewhere else. The
                             button is gone entirely — copying is on the listing's own context menu
                             now, which is where a grid's copy belongs. -->
                        <Grid Grid.Row="3" ColumnDefinitions="1.6*,*,1.4*" Margin="0,6,0,0">
                            <Button Classes="gridhdr" Content="Instance" Tag="instance" Click="OnSortGrid"/>
                            <Button Grid.Column="1" Classes="gridhdr" Content="Type"  Tag="type"  Click="OnSortGrid"/>
                            <Button Grid.Column="2" Classes="gridhdr" Content="Value" Tag="value" Click="OnSortGrid"/>
                        </Grid>
                        <ScrollViewer Grid.Row="4" MaxHeight="170" Margin="0,2,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <!-- Transparent, so the whole listing area takes the pointer and a
                                 right-click on the empty part below the last row still opens the
                                 menu. A panel with no background is not hit-testable in Avalonia. -->
                            <ItemsControl Name="ElementsList" ItemsSource="{Binding Elements}"
                                          Background="Transparent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvm:MatchElementRowViewModel">
                                        <Grid ColumnDefinitions="1.6*,*,1.4*" Margin="0,1">
                                            <TextBlock Text="{Binding Instance}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="11"/>
                                            <!-- The VALUE is editable, by the same control and the
                                                 same validator as the drawing above it (owner,
                                                 2026-08-20). Double-click opens it, the unit is left
                                                 alone while the number is pre-selected, and the
                                                 commit goes through
                                                 MatchDesignerViewModel.CommitInlineEdit — see
                                                 MatchElementRowViewModel.ValueEntry. -->
                                            <ctl:InlineEditText Grid.Column="2" FontSize="11"
                                                                Text="{Binding ValueEntry, Mode=TwoWay}"
                                                                ToolTip.Tip="Double-click to edit. An element value is aimed at through the transform rack, exactly as it is on the drawing above."/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="pane" MinHeight="150">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="panelhdr" Text="Transforms"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        IsVisible="{Binding TransformRackApplies}">
                                <!-- "+" and a chevron, no word (owner, 2026-08-20: "remove the word
                                     'add' from the add transform button"). The chevron is what says
                                     it opens a menu; beside the "−" next to it the pair reads as one
                                     control. The tooltip carries what the word used to. -->
                                <Button Name="AddTransformButton" FontSize="11" Padding="6,2"
                                        ToolTip.Tip="Add a transform on one of the pairs this ladder offers">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="+" VerticalAlignment="Center"/>
                                        <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Name="RemoveTransformButton" Content="−" FontSize="11" Padding="8,2"
                                        IsEnabled="{Binding CanRemoveTransform}"/>
                                <!-- Icons, not emoji. The user-docs factory measured it (2026-08-20):
                                     U+1F517 and U+1F512 are covered by NO circuitRF typeface and by no
                                     shipped fallback either, so Skia substituted the platform colour-emoji
                                     font and the generated figures carried a name that only resolves on
                                     this machine. The same fix the Technology chevron already took. -->
                                <!-- The glyph alone (owner, 2026-08-20: "remove the word 'link' from
                                     the link button"). A chain link beside a lock in the same rack is
                                     already the pair the user reads; the word only repeated it. -->
                                <ToggleButton FontSize="11" Padding="6,2"
                                              IsChecked="{Binding LinkTransforms, Mode=TwoWay}"
                                              ToolTip.Tip="Link — moving one N re-solves the unlocked others so Π N² stays on target">
                                    <mi:MaterialIcon Kind="LinkVariant" Width="13" Height="13"/>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- One refusal line for the whole rack, not one per row: a per-row message
                             would move every row below it the moment it appeared, which is the shift
                             the inline editor was built to avoid in the first place. -->
                        <TextBlock Grid.Row="2" Classes="warn" Text="{Binding TransformNote}"
                                   IsVisible="{Binding TransformNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- match.md §16.5's empty state. NOT the rack's "no transformable pair"
                             refusal, which is a fault; this is the normal and finished state of a
                             lowpass or highpass ladder, so it is a note and not a warning. -->
                        <TextBlock Grid.Row="1" Classes="note" TextWrapping="Wrap" Margin="0,4"
                                   VerticalAlignment="Top"
                                   Text="{Binding TransformRackNote}"
                                   IsVisible="{Binding !TransformRackApplies}"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      IsVisible="{Binding TransformRackApplies}">
                            <ItemsControl ItemsSource="{Binding Transforms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="mvm:MatchTransformRowViewModel">
                                        <!-- Five columns, not six: the trailing "on (C2, C3)"
                                             indicator is gone (owner, 2026-08-20). The pair a
                                             transform acts on is already said by the brace drawn
                                             under those very elements in the schematic above. -->
                                        <Grid ColumnDefinitions="34,44,74,*,30" Margin="0,1">
                                            <TextBlock Classes="lbl" Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <ddc:IconSelectButton Grid.Column="1" Width="34" Height="19"
                                                                  IsEnabled="{Binding !IsDropped}"
                                                                  ItemsSource="{x:Static mvm:MatchTransformRowViewModel.FormOptions}"
                                                                  SelectedItem="{Binding FormChoice, Mode=TwoWay}"
                                                                  ToolTip.Tip="Which three-element equivalent this transform produces: π or T">
                                                <ddc:IconSelectButton.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ddc:IconSelectButton.ItemTemplate>
                                            </ddc:IconSelectButton>
                                            <!-- N reads as TEXT and opens the same inline editor every
                                                 other settable value in this window uses (owner,
                                                 2026-08-20: "the textedit box of the N1/N2… transforms
                                                 to text; allow user to change it using the inline text
                                                 editor; its input must be validated/refused if bad
                                                 input"). The refusal is the view-model's — see
                                                 MatchTransformRowViewModel.NEntry — and it names the
                                                 range rather than silently clamping into it. -->
                                            <ctl:InlineEditText Grid.Column="2" Classes="val"
                                                               Margin="4,0,0,0"
                                                               HorizontalContentAlignment="Center"
                                                               IsEnabled="{Binding CanEditN}"
                                                               Text="{Binding NEntry, Mode=TwoWay}"
                                                               ToolTip.Tip="{Binding NTooltip}"/>
                                            <Slider Grid.Column="3" Classes="compact"
                                                    Minimum="{Binding NMin}" Maximum="{Binding NMax}"
                                                    Value="{Binding N, Mode=TwoWay}"
                                                    IsEnabled="{Binding CanEditN}"
                                                    Tag="{Binding}"
                                                    Loaded="OnSliderLoaded"/>
                                            <ToggleButton Grid.Column="4" FontSize="11" Padding="2"
                                                          MinHeight="0" MinWidth="0"
                                                          IsChecked="{Binding Locked, Mode=TwoWay}"
                                                          ToolTip.Tip="A locked transform is never written by the linkage">
                                                <mi:MaterialIcon Kind="Lock" Width="13" Height="13"/>
                                            </ToggleButton>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Response -->
            <!-- The pane sits on the Data Display's own canvas colour (owner, 2026-08-20: "background
                 color of the Response group UI needs to be the same as the background color of the
                 Data display"). CrfDataDisplayCanvasBrush is the same application-scope key
                 PlotCanvasView paints with — see Styles/CircuitRfResources.axaml. -->
            <Border Grid.Column="2" Classes="pane"
                    IsVisible="{Binding !NetworkExpanded}"
                    Background="{DynamicResource CrfDataDisplayCanvasBrush}">
              <!-- The two plots are laid out at a FIXED aspect ratio, so their height follows the
                   pane's width rather than the pane's height — which means a short window can run out
                   of room. Scroll rather than squash: a golden-ratio plot that has been squashed is
                   not a golden-ratio plot. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <!-- The Response pane's own expander, mirrored: down-and-LEFT at rest, because
                         the space it takes is the network pane's and that is where it comes from
                         (owner, 2026-08-20), and up-and-right once it has it. The two toggles are
                         mutually exclusive — see MatchDesignerViewModel.NetworkExpanded. -->
                    <Grid ColumnDefinitions="Auto,*">
                        <ToggleButton Name="ResponseExpandButton" Padding="3,1" Margin="0,0,6,4"
                                      MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                      IsChecked="{Binding ResponseExpanded, Mode=TwoWay}"
                                      ToolTip.Tip="{Binding ResponseExpandTooltip}">
                            <mi:MaterialIcon Kind="{Binding ResponseExpandIcon}" Width="14" Height="14"/>
                        </ToggleButton>
                        <TextBlock Grid.Column="1" Classes="panelhdr" Text="Response"/>
                    </Grid>
                    <!-- Golden aspect ratio on both rect plots (owner, 2026-08-19). AspectRatioPanel
                         LAYS the plot out at 1.618:1 — a Viewbox would scale the axis text and the
                         stroke weights along with the frame, which is a different thing entirely. -->
                    <ctl:AspectRatioPanel Grid.Row="1" Margin="0,2">
                        <!-- CanDeletePlot / CanEditPlotProperties are OFF here (owner, 2026-08-20:
                             "the plot's context menu shows Delete Plot as enabled — it should be
                             disabled in a Match Designer window. Same with Plot Properties…").
                             Neither is meaningful on a fixed pair of plots the Designer owns: there
                             is nothing to delete them from, and their traces are rebuilt from the
                             design on every edit, so an inspector edit would not survive the next
                             keystroke. PlotTheme follows the window's own light/dark variant —
                             without it the axes, ticks and marker glyphs render out of
                             RenderTheme.Light whatever the application theme is. -->
                        <ddc:PlotControl Name="MagnitudePlotControl"
                                         Plot="{Binding MagnitudePlot}"
                                         Library="{Binding PlotHost.Library}"
                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                    </ctl:AspectRatioPanel>
                    <ctl:AspectRatioPanel Grid.Row="2" Margin="0,2">
                        <ddc:PlotControl Name="PhasePlotControl"
                                         Plot="{Binding PhasePlot}"
                                         Library="{Binding PlotHost.Library}"
                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                    </ctl:AspectRatioPanel>

                    <!-- Both boxes commit on RETURN as well as on focus loss (owner, 2026-08-20:
                         "committing using return key on band and points textedit boxes does not
                         update the frequency response plots"). They only ever had a LostFocus
                         handler, so a user who typed a number and pressed Return saw nothing move
                         and had no reason to think the value had not been taken. -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,*" Margin="0,4">
                        <TextBlock Classes="detailLabel" Text="± band "/>
                        <TextBox Grid.Column="1" Classes="num" Name="BandFractionBox"/>
                        <TextBlock Grid.Column="2" Classes="detailLabel" Text=" points "/>
                        <TextBox Grid.Column="3" Classes="num" Name="PlotPointsBox"/>
                    </Grid>

                    <Border Grid.Row="4" Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Status.QText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.ReturnLossText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.LossText}" FontSize="11"/>
                            <TextBlock Text="{Binding Status.RatioText}" FontSize="11"/>
                            <TextBlock Classes="warn" Text="{Binding Status.Refusal.Message}"
                                       IsVisible="{Binding Status.IsRefused}"/>
                            <TextBlock Classes="warn" Text="{Binding ResponseError}"
                                       IsVisible="{Binding ResponseError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="note" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!--
                        Marker info-box overlay — the Data Display's own, item for item: an
                        ItemsControl over a Canvas, both with Background="{x:Null}" so they are NOT
                        hit-testable and every click falls through to the plots beneath, while each
                        MarkerInfoBoxView (which sets its own Background="Transparent") is.

                        It spans the whole pane rather than one plot's cell because an info box is
                        DRAGGABLE and belongs to the display, not to the plot it was made from —
                        MarkerInfoBoxViewModel.ViewLeft/ViewTop are in this panel's coordinates, which
                        is why MatchDesignerWindow.SyncPlotContainers keeps each container's
                        Left/Top/Width/Height equal to its PlotControl's rectangle in the same space.
                    -->
                    <ItemsControl Name="MarkerInfoBoxLayer" Grid.Row="0" Grid.RowSpan="5"
                                  ItemsSource="{Binding PlotHost.MarkerInfoBoxes}"
                                  Background="{x:Null}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Background="{x:Null}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{ReflectionBinding ViewLeft}"/>
                                <Setter Property="Canvas.Top"  Value="{ReflectionBinding ViewTop}"/>
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ddv:MarkerInfoBoxViewModel">
                                <ddvw:MarkerInfoBoxView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
              </ScrollViewer>
            </Border>

        </Grid>

        <!-- ── Footer ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="10,6">
            <!-- The solutions summary, replaced while the background analysis runs: the two occupy
                 the same slot because the summary IS what that analysis produces, and showing a
                 stale count beside a spinner would be two answers to one question. -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- The ORPHAN line replaces both, because it is the only thing worth saying about a
                     window whose component has been deleted (owner, 2026-08-20). Everything that
                     writes is already shut off at MatchDesignerViewModel.Commit; this is the part the
                     user can see. -->
                <TextBlock Classes="warn" Text="{Binding OrphanNote}" TextWrapping="NoWrap"
                           VerticalAlignment="Center" IsVisible="{Binding IsOrphaned}"/>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !IsOrphaned}">
                    <TextBlock Text="{Binding SolutionsSummary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="searching…" FontSize="11" Opacity="0.7"
                               VerticalAlignment="Center" IsVisible="{Binding IsAnalysing}"/>
                </StackPanel>

                <!-- A probe is a real S-parameter sweep, and on a biased transistor a real DC solve
                     first, so it runs off the UI thread with the engine's own progress and
                     cancellation — and it reports HERE, in a row that already exists, rather than by
                     growing the specification pane for the duration of the run. -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsProbing}">
                    <TextBlock FontSize="11" Opacity="0.85" VerticalAlignment="Center"
                               Text="{Binding ProbeStatus}"/>
                    <ProgressBar Width="120" Height="4" Minimum="0" Maximum="1"
                                 VerticalAlignment="Center" Value="{Binding ProbeProgress}"/>
                    <Button Content="Cancel" FontSize="10" Padding="6,1"
                            Command="{Binding CancelProbeCommand}"/>
                </StackPanel>
                <!-- Where a standalone Designer says what its Flatten did. A schematic-bound one
                     posts the same sentence to the workspace's Messages pane through its schematic's
                     MessageSink; with no schematic there is no sink, and a flatten that writes a
                     folder and says nothing is one the user has no reason to believe happened. -->
                <TextBlock Text="{Binding FlattenOutcome}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding FlattenOutcome, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           ToolTip.Tip="{Binding FlattenOutcome}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Flatten to Cell…" FontSize="11" Padding="8,3"
                        IsEnabled="{Binding CanFlatten}"
                        Click="OnFlattenToCell"
                        ToolTip.Tip="{Binding FlattenTooltip}"/>
                <Button Name="RevertButton" Content="Revert" FontSize="11" Padding="8,3"
                        IsEnabled="{Binding !IsOrphaned}"
                        ToolTip.Tip="Put the design back the way this window found it — one undoable step"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
