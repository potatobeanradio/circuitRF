<!-- The Filter Designer: a specification column, the two response plots side by side with the
     response choice above them, and the ladder drawn by the schematic editor's own renderer. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:flt="using:CircuitRF.Ui.Filters"
        xmlns:df="using:CircuitRF.Design.Filters"
        xmlns:mv="using:CircuitRF.Ui.Views.Match"
        xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Filters.FilterDesignerWindow"
        x:DataType="flt:FilterDesignerViewModel"
        Title="Filter Designer"
        Width="1199" Height="741"
        MinWidth="1000" MinHeight="700"
        CanResize="True">

    <Window.Styles>
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,0,5"/>
        </Style>
        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.cardhdr">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="Opacity"      Value="0.75"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,2,0,0"/>
            <Setter Property="Foreground"   Value="{DynamicResource CrfWarningBrush}"/>
        </Style>
        <Style Selector="TextBlock.detailLabel">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Side-panel value column: every TextBox and ComboBox shares one width. -->
        <Style Selector="TextBox.num">
            <Setter Property="FontSize"             Value="11"/>
            <Setter Property="Padding"              Value="4,2"/>
            <Setter Property="MinWidth"             Value="140"/>
            <Setter Property="HorizontalAlignment"  Value="Stretch"/>
        </Style>
        <Style Selector="Border.card ComboBox">
            <Setter Property="MinWidth"            Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TextBlock.tblhdr">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="8,0"/>
        </Style>
        <Style Selector="TextBlock.tblcell">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="8,0"/>
        </Style>
        <!-- Dashed colour swatch matching the plot mask line for that edge / Ap / As. -->
        <Style Selector="Line.maskleg">
            <Setter Property="StartPoint"           Value="2,0"/>
            <Setter Property="EndPoint"             Value="24,0"/>
            <Setter Property="StrokeThickness"      Value="2"/>
            <Setter Property="StrokeDashArray"      Value="4,3"/>
            <Setter Property="Stretch"              Value="Fill"/>
            <Setter Property="Height"               Value="10"/>
            <Setter Property="VerticalAlignment"    Value="Center"/>
            <Setter Property="HorizontalAlignment"  Value="Stretch"/>
            <Setter Property="Margin"               Value="0,0,4,0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="292,*" RowDefinitions="*,*">

        <!-- ── Specification ─────────────────────────────────────────────── -->
        <Border Grid.RowSpan="2" Classes="pane">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Classes="panelhdr" Text="Specification"/>

                    <Border Classes="card">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="cardhdr" Text="Impedances"/>
                            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="3">
                                <TextBlock Classes="lbl" Text="Source"/>
                                <TextBox Grid.Column="1" Classes="num" Text="{Binding SourceText}"/>
                                <TextBlock Grid.Row="1" Classes="lbl" Text="Load"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Classes="num" Text="{Binding LoadText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="cardhdr" Text="Topology"/>
                            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                <TextBlock Classes="lbl" Text="First"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FirstElements}"
                                          SelectedItem="{Binding First}"/>
                                <TextBlock Grid.Row="1" Classes="lbl" Text="Order"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding OrderModes}"
                                          SelectedItem="{Binding OrderMode}"
                                          ToolTip.Tip="Minimum is the smallest prototype order that meets Ap, As and the mask edges. Specify overrides it."/>
                                <TextBlock Grid.Row="2" Classes="lbl" Text="N"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Classes="num" Text="{Binding OrderText}"
                                         IsEnabled="{Binding OrderEditable}"
                                         ToolTip.Tip="Prototype order. A bandpass or bandstop replaces each element by a resonator. An even-order inverse Chebyshev or elliptic has no ladder."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="cardhdr" Text="Shape"/>
                            <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="3">
                                <TextBlock Classes="lbl" Text="Response"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ResponseChoices}"
                                          SelectedItem="{Binding ResponseChoice}"/>
                                <TextBlock Grid.Row="1" Classes="lbl" Text="Form"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Forms}"
                                          SelectedItem="{Binding Form}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70,28,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="3" Margin="0,3,0,0">
                                <TextBlock Classes="lbl" Text="Ap, dB" ToolTip.Tip="{Binding TipAp}"/>
                                <Line Grid.Column="1" Classes="maskleg" Stroke="#C0392B"
                                      ToolTip.Tip="{Binding TipAp}"/>
                                <TextBox Grid.Column="2" Classes="num" Text="{Binding ApText}"
                                         ToolTip.Tip="{Binding TipAp}"/>
                                <TextBlock Grid.Row="1" Classes="lbl" Text="Ripple, dB" ToolTip.Tip="{Binding TipRipple}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Classes="num" Text="{Binding RippleText}"
                                         ToolTip.Tip="{Binding TipRipple}"/>
                                <TextBlock Grid.Row="2" Classes="lbl" Text="As, dB" ToolTip.Tip="{Binding TipAs}"/>
                                <Line Grid.Row="2" Grid.Column="1" Classes="maskleg" Stroke="#7F8C8D"
                                      ToolTip.Tip="{Binding TipAs}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Classes="num" Text="{Binding AsText}"
                                         ToolTip.Tip="{Binding TipAs}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="3">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="cardhdr" Text="Edges"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                                          MinWidth="72" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid ColumnDefinitions="70,28,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                <TextBlock Classes="lbl" Text="{Binding LabelA}" ToolTip.Tip="{Binding TipA}"/>
                                <Line Grid.Column="1" Classes="maskleg" Stroke="#E67E22"
                                      ToolTip.Tip="{Binding TipA}"/>
                                <TextBox Grid.Column="2" Classes="num" Text="{Binding FaText}"
                                         ToolTip.Tip="{Binding TipA}"/>
                                <TextBlock Grid.Row="1" Classes="lbl" Text="{Binding LabelB}" ToolTip.Tip="{Binding TipB}"/>
                                <Line Grid.Row="1" Grid.Column="1" Classes="maskleg" Stroke="#2980B9"
                                      ToolTip.Tip="{Binding TipB}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Classes="num" Text="{Binding FbText}"
                                         ToolTip.Tip="{Binding TipB}"/>
                                <TextBlock Grid.Row="2" Classes="lbl" Text="{Binding LabelC}" IsVisible="{Binding ShowC}"
                                           ToolTip.Tip="{Binding TipC}"/>
                                <Line Grid.Row="2" Grid.Column="1" Classes="maskleg" Stroke="#27AE60"
                                      IsVisible="{Binding ShowC}" ToolTip.Tip="{Binding TipC}"/>
                                <TextBox Grid.Row="2" Grid.Column="2" Classes="num" Text="{Binding FcText}"
                                         IsVisible="{Binding ShowC}" ToolTip.Tip="{Binding TipC}"/>
                                <TextBlock Grid.Row="3" Classes="lbl" Text="{Binding LabelD}" IsVisible="{Binding ShowD}"
                                           ToolTip.Tip="{Binding TipD}"/>
                                <Line Grid.Row="3" Grid.Column="1" Classes="maskleg" Stroke="#8E44AD"
                                      IsVisible="{Binding ShowD}" ToolTip.Tip="{Binding TipD}"/>
                                <TextBox Grid.Row="3" Grid.Column="2" Classes="num" Text="{Binding FdText}"
                                         IsVisible="{Binding ShowD}" ToolTip.Tip="{Binding TipD}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="cardhdr" Text="Values"/>
                            <ComboBox ItemsSource="{Binding SeriesKinds}" SelectedItem="{Binding Series}"
                                      ToolTip.Tip="Exact theoretical values, or the nearest IEC preferred number."/>
                            <Button Content="Load library series" Command="{Binding LoadLibrariesCommand}"
                                    HorizontalAlignment="Left" Margin="0,2,0,0"
                                    ToolTip.Tip="Index the workspace's vendor libraries and offer one inductor series and one capacitor series."/>
                            <TextBlock Classes="lbl" Text="Inductors" IsVisible="{Binding LibraryAvailable}"/>
                            <ComboBox ItemsSource="{Binding InductorSeries}" SelectedItem="{Binding InductorChoice}"
                                      IsVisible="{Binding LibraryAvailable}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="df:FilterLibrarySeries">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="lbl" Text="Capacitors" IsVisible="{Binding LibraryAvailable}"/>
                            <ComboBox ItemsSource="{Binding CapacitorSeries}" SelectedItem="{Binding CapacitorChoice}"
                                      IsVisible="{Binding LibraryAvailable}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="df:FilterLibrarySeries">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="cardhdr" Text="Design information"/>
                            <TextBlock Classes="note" Text="{Binding DesignInfo}"/>
                            <TextBlock Classes="warn" Text="{Binding Status}"
                                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <Button Content="Design" Command="{Binding DesignCommand}"/>
                        <Button Content="Apply to Filter" Click="OnApply" IsVisible="{Binding CanApply}"/>
                        <Button Content="Save netlist…" Click="OnSave"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── The ladder, drawn ─────────────────────────────────────────── -->
        <Border Grid.Row="1" Grid.Column="1" Classes="pane">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Classes="panelhdr" Text="Filter network"/>
                <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                        BorderBrush="{DynamicResource CrfTileBorderBrush}">
                    <Panel>
                        <mv:MatchSchematicCanvas Name="NetworkSchematic" Layout="{Binding Ladder}"/>
                        <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="4" Padding="6,3" Click="OnZoomFit"
                                ToolTip.Tip="Zoom to Fit  (F)">
                            <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                        </Button>
                    </Panel>
                </Border>

                <!-- Realization table — header + zebra rows, chain-budget style. -->
                <Border Grid.Row="2" Margin="0,8,0,0" BorderBrush="#D0D0D0" BorderThickness="1"
                        CornerRadius="2" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1"
                                Padding="0,6">
                            <Grid ColumnDefinitions="1.2*,1.2*,*,*,*">
                                <TextBlock Classes="tblhdr" Text="Instance"/>
                                <Border Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                                    <TextBlock Classes="tblhdr" Text="Type"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                                    <TextBlock Classes="tblhdr" Text="Exact"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                                    <TextBlock Classes="tblhdr" Text="Value"/>
                                </Border>
                                <Border Grid.Column="4" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                                    <TextBlock Classes="tblhdr" Text="Part"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Elements}" MaxHeight="160"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                                <!-- Transparent so the row Border's zebra fill is what you see. -->
                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="flt:FilterElementRow">
                                    <Border Background="{Binding RowBackground}" Padding="0,5"
                                            BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="1.2*,1.2*,*,*,*">
                                            <TextBlock Classes="tblcell" Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" Classes="tblcell" Text="{Binding Kind}"/>
                                            <TextBlock Grid.Column="2" Classes="tblcell" Text="{Binding Exact}"/>
                                            <TextBlock Grid.Column="3" Classes="tblcell" Text="{Binding Used}"/>
                                            <TextBlock Grid.Column="4" Classes="tblcell" Text="{Binding Part}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ── Response plots, side by side ──────────────────────────────── -->
        <Border Grid.Column="1" Classes="pane">
            <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,*">
                <ddc:PlotControl Name="MagnitudePlotControl"
                                 Plot="{Binding MagnitudePlot}"
                                 Library="{Binding PlotHost.Library}"
                                 CanDeletePlot="False" CanEditPlotProperties="False"/>
                <ddc:PlotControl Grid.Column="1" Name="PhasePlotControl" Margin="6,0,0,0"
                                 Plot="{Binding PhasePlot}"
                                 Library="{Binding PlotHost.Library}"
                                 CanDeletePlot="False" CanEditPlotProperties="False"/>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" Margin="0,6,0,0">
                    <TextBlock Classes="detailLabel" Text="± band "/>
                    <TextBox Grid.Column="1" Classes="num" Name="BandFractionBox" MinWidth="64"/>
                    <TextBlock Grid.Column="2" Classes="detailLabel" Text=" points "/>
                    <TextBox Grid.Column="3" Classes="num" Name="PlotPointsBox" MinWidth="64"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
