<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:ptvm="using:CircuitRF.Ui.ViewModels.ProjectTree"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.ProjectTree.ProjectTreeView"
             x:DataType="vm:ProjectTreeTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Styles>
        <Style Selector="Button.pt-link">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Toolbar: title + refresh + new cell + new folder + filter + search.
             The search FIELD lives in column 0, taking the workspace name's place while a search is
             open (owner, 2026-08-25) — so the toolbar stays one row, every button stays where it was,
             and the field gets the whole width without overlaying anything it would then have to
             hit-test around. Closing the search puts the name back. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="4,4,4,2">

            <!-- Workspace name — right-click to reveal (Item 3) -->
            <TextBlock Grid.Column="0"
                       IsVisible="{Binding !IsSearchOpen}"
                       Text="{Binding WorkspaceName}"
                       FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"
                       TextTrimming="CharacterEllipsis">
                <!-- The menu itself is always available now: with a workspace open it acts on that
                     workspace, and with none open it is how one gets opened — the "No workspace
                     open" text is the only thing on this panel to right-click at that point. Each
                     item's own IsVisible is what switches between the two sets. -->
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding RevealLabel}" Command="{Binding RevealWorkspaceCommand}"
                                  IsVisible="{Binding HasWorkspace}">
                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderSearchOutline" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Archive Workspace…" Command="{Binding ArchiveWorkspaceCommand}"
                                  IsVisible="{Binding HasWorkspace}">
                            <MenuItem.Icon><mi:MaterialIcon Kind="ZipBox" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Close Workspace" Command="{Binding CloseWorkspaceCommand}"
                                  IsVisible="{Binding HasWorkspace}">
                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderRemoveOutline" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="Open…" Command="{Binding OpenWorkspaceCommand}"
                                  IsVisible="{Binding !HasWorkspace}">
                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Unarchive Workspace…" Command="{Binding UnarchiveWorkspaceCommand}"
                                  IsVisible="{Binding !HasWorkspace}">
                            <MenuItem.Icon><mi:MaterialIcon Kind="ZipBoxOutline" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>

            <!-- Refresh button (Layer 4 — manual refresh) -->
            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Refresh workspace"
                    Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                <mi:MaterialIcon Kind="Refresh" Width="14" Height="14"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>

            <!-- New Cell button — only visible when a workspace is loaded -->
            <Button Grid.Column="2"
                    Command="{Binding NewCellInWorkspaceCommand}"
                    ToolTip.Tip="New Cell in workspace"
                    IsVisible="{Binding HasWorkspace}"
                    Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                <mi:MaterialIcon Kind="PlusBox" Width="14" Height="14"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>

            <!-- New Folder button — a board import can add dozens of cells at once, and this is what
                 lets the user put them somewhere. Same visibility rule as New Cell. -->
            <Button Grid.Column="3"
                    Command="{Binding NewFolderInWorkspaceCommand}"
                    ToolTip.Tip="New Folder in workspace"
                    IsVisible="{Binding HasWorkspace}"
                    Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                <mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>

            <!-- Search toggle — the magnifier is the affordance, and the field only exists while it
                 is on. A always-present field would spend the whole session eating the width the
                 workspace name needs, for a control most sessions never touch. -->
            <Button Grid.Column="5"
                    Command="{Binding ToggleSearchCommand}"
                    ToolTip.Tip="Search by name"
                    IsVisible="{Binding HasWorkspace}"
                    Padding="3,2" Background="Transparent" BorderThickness="0">
                <mi:MaterialIcon Kind="Magnify" Width="14" Height="14"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>

            <!-- Filter toggle (Layer 3 — category-toggle filter §3.3) -->
            <Button Grid.Column="4"
                    ToolTip.Tip="Filter categories"
                    Padding="3,2" Background="Transparent" BorderThickness="0">
                <mi:MaterialIcon Kind="Filter" Width="14" Height="14"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Spacing="3" Margin="8">
                            <CheckBox IsChecked="{Binding FilterState.WorkspaceFileSystem}" Content="Workspace File-System" FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.TestBenches}"         Content="TestBenches"           FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.Cells}"               Content="Cells"                 FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.DataDisplays}"        Content="Data Displays"         FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.Libraries}"           Content="Libraries"             FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.KnownFiles}"          Content="Known Files"           FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.ColorThemes}"         Content="Color Themes"          FontSize="12"/>
                            <CheckBox IsChecked="{Binding FilterState.TechFiles}"           Content="Technology Files"      FontSize="12"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- The field itself — column 0, in the workspace name's place, only while open.
                 Clear-button overlay mirrors the Library palette's field. -->
            <Grid Grid.Column="0" IsVisible="{Binding IsSearchOpen}" Margin="0,0,4,0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search…"
                         FontSize="12"
                         Padding="6,2,22,2"
                         MinHeight="0"
                         VerticalContentAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="2" Padding="2"
                        Background="Transparent" BorderThickness="0"
                        IsVisible="{Binding HasSearchText}"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip.Tip="Clear search">
                    <mi:MaterialIcon Kind="Close" Width="10" Height="10"
                                     Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
            </Grid>

        </Grid>

        <!-- Tree area -->
        <Grid Grid.Row="1">

            <!-- No-workspace placeholder with recent workspaces list (Item 1) -->
            <StackPanel IsVisible="{Binding !HasWorkspace}" Margin="8,6" Spacing="4">
                <TextBlock Text="Recent Workspaces" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="{Binding HasRecentWorkspaces}"/>
                <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectTreeTool+RecentEntry">
                            <Button Classes="pt-link" Padding="0" Margin="0,1"
                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                                    Content="{Binding Name}"
                                    ToolTip.Tip="{Binding Path}"
                                    Command="{Binding $parent[ItemsControl].((vm:ProjectTreeTool)DataContext).OpenRecentCommand}"
                                    CommandParameter="{Binding Path}">
                                <!-- The menu's own DataContext is the RecentEntry — a ContextMenu is
                                     a separate popup tree, so the $parent walk the Button above uses
                                     to reach the tool VM does not resolve from in here. That is why
                                     the entry carries its own label and command. -->
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <!-- The same command the row's own click runs — the menu is for
                                             the user who right-clicked first and then looked for the
                                             obvious verb, and finding only "Reveal" there reads as if
                                             opening from here were not offered. -->
                                        <MenuItem Header="Open Workspace"
                                                  Command="{Binding OpenCommand}"
                                                  CommandParameter="{Binding Path}"/>
                                        <MenuItem Header="{Binding RevealLabel}"
                                                  Command="{Binding RevealCommand}"
                                                  CommandParameter="{Binding Path}"/>
                                        <!-- Separated because this one alone changes something. The two
                                             above act ON the workspace; this forgets the path and the
                                             workspace itself stays where it is. -->
                                        <Separator/>
                                        <MenuItem Header="Remove from Recent"
                                                  Command="{Binding RemoveCommand}"
                                                  CommandParameter="{Binding Path}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No recent workspaces." FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="{Binding !HasRecentWorkspaces}"/>
                <Button Content="Clear Recent" FontSize="11" Margin="0,4,0,0"
                        Command="{Binding ClearRecentCommand}"
                        IsVisible="{Binding HasRecentWorkspaces}"/>
            </StackPanel>

            <!-- Tree (Layer 2 — disclosure, bold primaries, warning styling) -->
            <!-- HorizontalScrollBarVisibility is Auto because a ScrollViewer's DEFAULT is Disabled,
                 and Disabled does not mean "no scrollbar" — it constrains the content to the viewport
                 width, so a long cell or file name was clipped with no way to reach the rest of it
                 (owner, 2026-08-25). Auto also stops a long row squeezing the columns beside it, which
                 is what made the disclosure triangle hard to pick out. -->
            <!-- Focusable so activating the PANEL can put focus in here: TreeView and ScrollViewer are
                 BOTH Focusable=false by default (probed), so without this the activation-focus fix
                 would be a silent no-op and Page Up/Down would still need a click inside first.
                 IsTabStop=false keeps it out of the tab order — same pairing TechEditorView uses. -->
            <ScrollViewer x:Name="TreeScroll"
                          Focusable="True" IsTabStop="False"
                          HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasWorkspace}">
                <TreeView x:Name="TheTreeView"
                          ItemsSource="{Binding TopLevelItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                    <TreeView.Resources>
                        <!-- Shadow the Fluent theme's pressed/hover-pressed brushes for selected items
                             so the accent highlight stays stable — no grey flash when clicking or
                             hovering over an already-selected tree node. -->
                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed"
                                         Color="{DynamicResource SystemAccentColor}"/>
                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver"
                                         Color="{DynamicResource SystemAccentColor}"/>
                    </TreeView.Resources>

                    <TreeView.Styles>
                        <!-- Bind tree-item expansion to the VM's IsExpanded for refresh-state persistence.
                             x:DataType tells the AXAML compiler the style's DataContext is the item VM. -->
                        <Style Selector="TreeViewItem" x:DataType="ptvm:ProjectTreeNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                        <!-- Bold for primary view files (§3.2) -->
                        <Style Selector="TextBlock.pt-bold">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <!-- Italic for warning nodes (§3.2) -->
                        <Style Selector="TextBlock.pt-italic">
                            <Setter Property="FontStyle" Value="Italic"/>
                        </Style>
                        <!-- System.Warning color for broken refs — uses CrfWarningBrush DynamicResource
                             so it follows the active color theme instead of a literal color value. -->
                        <Style Selector="TextBlock.pt-warning">
                            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
                        </Style>
                    </TreeView.Styles>

                    <TreeView.ItemTemplate>
                        <!-- ItemsSource=FilteredChildren provides the category filter AND ensures
                             no expander triangle appears for empty nodes (Avalonia hides it when
                             the bound collection is empty). -->
                        <TreeDataTemplate x:DataType="ptvm:ProjectTreeNodeViewModel"
                                          ItemsSource="{Binding FilteredChildren}">
                            <Grid ColumnDefinitions="Auto,Auto,*" Background="Transparent">
                                <!-- Per-kind icon (NodeKind + IsTestBench → MaterialIconKind) -->
                                <mi:MaterialIcon Grid.Column="0"
                                                Kind="{Binding IconKind}"
                                                Width="14" Height="14"
                                                Margin="0,0,4,0"
                                                Foreground="{DynamicResource SystemBaseMediumColor}"/>

                                <!-- Dirty bullet: any node with unsaved work — a cell with a dirty session, or a
                                     .cdd / .ctech / .cem file whose editor is dirty. -->
                                <TextBlock Grid.Column="1"
                                           Text="•"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,2,0"
                                           Foreground="{DynamicResource SystemAccentColor}"
                                           IsVisible="{Binding IsDirty}"/>

                                <!-- Workspace-default technology affordance — shown on the .ctech node
                                     that is currently CwsFile.DefaultTechRef. -->
                                <mi:MaterialIcon Grid.Column="1"
                                                  Kind="CheckCircleOutline"
                                                  Width="11" Height="11"
                                                  Margin="0,0,2,0"
                                                  Foreground="{DynamicResource SystemAccentColor}"
                                                  ToolTip.Tip="Workspace default technology"
                                                  IsVisible="{Binding IsWorkspaceDefaultTech}"/>

                                <!-- Name: bold for IsPrimary, italic + warning-color for IsWarning.
                                     Tooltip: WarningReason first (if warning), then RelativePath. -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="12"
                                           Classes.pt-bold="{Binding IsBold}"
                                           Classes.pt-italic="{Binding IsItalic}"
                                           Classes.pt-warning="{Binding IsWarning}">
                                    <ToolTip.Tip>
                                        <StackPanel MaxWidth="320" Spacing="2">
                                            <TextBlock Text="{Binding WarningReason}"
                                                       IsVisible="{Binding IsWarning}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                                            <TextBlock Text="{Binding TooltipPath}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                        </StackPanel>
                                    </ToolTip.Tip>
                                </TextBlock>

                                <!-- Context menu — items shown per NodeKind via IsVisible bindings.
                                     DataContext is the item VM (ProjectTreeNodeViewModel).
                                     Commands are RelayCommands / AsyncRelayCommands on the VM,
                                     delegating to ITreeActions (WorkspaceViewModel). -->
                                <Grid.ContextMenu>
                                    <ContextMenu Opening="OnNodeContextMenuOpening">

                                        <!-- Cell: open primary views at the top for quick access -->
                                        <MenuItem Header="Open Schematic"
                                                  Command="{Binding OpenSchematicCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FileDocumentOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open Cell"
                                                  Command="{Binding ActivateCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="IntegratedCircuitChip" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open Symbol"
                                                  Command="{Binding OpenSymbolCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="VectorSquare" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open Layout"
                                                  Command="{Binding OpenLayoutCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="LayersOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Save dirty node — visible only when IsSaveable (resolved at menu-open) -->
                                        <MenuItem Header="{Binding SaveHeader}"
                                                  Command="{Binding SaveCommand}"
                                                  IsVisible="{Binding IsSaveable}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="ContentSave" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Open leaf files (.csch / .csym / .cdd) — same as double-click -->
                                        <MenuItem Header="Open"
                                                  Command="{Binding ActivateCommand}"
                                                  IsVisible="{Binding IsOpenableFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="OpenInApp" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Technology (.ctech) node actions — no editor yet (L0d) -->
                                        <MenuItem Header="Set as Workspace Default"
                                                  Command="{Binding SetAsWorkspaceDefaultCommand}"
                                                  IsVisible="{Binding IsTechFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="Star" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reload Technology"
                                                  Command="{Binding ReloadTechnologyCommand}"
                                                  IsVisible="{Binding IsTechFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="Refresh" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsTechFile}"/>

                                        <!-- wBond (.wBond) node actions — wbond.md §9.2 routes 2 and 3.
                                             Route 1 (open it standalone) is the double-click. -->
                                        <MenuItem Header="Add to Schematic"
                                                  Command="{Binding AddWBondToSchematicCommand}"
                                                  IsVisible="{Binding IsWBondFile}"
                                                  ToolTip.Tip="Place these wires as a component in the schematic currently in front.">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="VectorPolyline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Add as Cell…"
                                                  Command="{Binding AddWBondAsCellCommand}"
                                                  IsVisible="{Binding IsWBondFile}"
                                                  ToolTip.Tip="Create a cell whose layout view is this design's embedded geometry and whose schematic view holds the wirebond component.">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsWBondFile}"/>

                                        <!-- Known File actions -->
                                        <MenuItem Header="Open External…"
                                                  Command="{Binding OpenExternalCommand}"
                                                  IsVisible="{Binding IsKnownFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="OpenInNew" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy to Workspace"
                                                  Command="{Binding CopyToWorkspaceCommand}"
                                                  IsVisible="{Binding IsKnownFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy to Workspace as Cell…"
                                                  Command="{Binding CopyToWorkspaceAsCellCommand}"
                                                  IsVisible="{Binding IsKnownFileCopyableAsCell}"
                                                  ToolTip.Tip="Create a new cell in this workspace whose view is a copy of this file. The file is checked first; an unreadable one creates nothing.">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="IntegratedCircuitChip" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy to Workspace as Cell…"
                                                  Command="{Binding CreateCellFromModelCardCommand}"
                                                  IsVisible="{Binding IsModelCardFile}"
                                                  ToolTip.Tip="Build a new cell from a SPICE .model card or .subckt definition in this file. A card becomes the native circuitRF component carrying its parameters with an editable copy of that component's symbol; a subcircuit becomes its own netlist, wired as the file wires it, with a generic box for a symbol. Either way the pins are already wired. The file is read first; anything circuitRF has no model for is refused by name.">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="IntegratedCircuitChip" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove Reference"
                                                  Command="{Binding RemoveKnownFileCommand}"
                                                  IsVisible="{Binding IsKnownFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="LinkVariantOff" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsKnownFile}"/>

                                        <!-- View file actions (Make Primary) -->
                                        <MenuItem Header="Make Primary"
                                                  Command="{Binding MakePrimaryCommand}"
                                                  IsVisible="{Binding IsViewFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="Star" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Separator before creation actions -->
                                        <Separator IsVisible="{Binding CanCreateInside}"/>
                                        <Separator IsVisible="{Binding IsCell}"/>

                                        <!-- Workspace / Library / user-folder node actions -->
                                        <MenuItem Header="New Cell"
                                                  Command="{Binding NewCellCommand}"
                                                  IsVisible="{Binding CanCreateInside}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="IntegratedCircuitChip" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Folder…"
                                                  Command="{Binding NewFolderCommand}"
                                                  IsVisible="{Binding CanCreateInside}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderPlusOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Technology…"
                                                  Command="{Binding NewTechnologyCommand}"
                                                  IsVisible="{Binding CanCreateInside}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="LayersOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- Cell node actions -->
                                        <MenuItem Header="New Schematic"
                                                  Command="{Binding NewSchematicCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FilePlusOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Symbol"
                                                  Command="{Binding NewSymbolCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="ShapePlusOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="New Layout"
                                                  Command="{Binding NewLayoutCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="LayersPlus" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Duplicate…"
                                                  Command="{Binding DuplicateCellCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="ContentDuplicate" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Rename…"
                                                  Command="{Binding RenameCellCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FormTextbox" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsCell}"/>
                                        <MenuItem Header="Edit Parameters"
                                                  Command="{Binding ActivateCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="Pencil" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator IsVisible="{Binding IsCell}"/>

                                        <!-- Remove to Trash -->
                                        <MenuItem Header="Remove Data Display"
                                                  Command="{Binding RemoveDataDisplayCommand}"
                                                  IsVisible="{Binding IsDataDisplayFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Remove"
                                                  Command="{Binding RemoveFileCommand}"
                                                  IsVisible="{Binding IsRemovableFile}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <!-- All revealable nodes — above Remove Cell so it groups with the other removes -->
                                        <MenuItem Header="{Binding RevealLabel}"
                                                  Command="{Binding RevealCommand}"
                                                  IsVisible="{Binding CanReveal}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="FolderSearchOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                        <Separator IsVisible="{Binding IsCell}"/>
                                        <MenuItem Header="Remove Cell"
                                                  Command="{Binding RemoveCellCommand}"
                                                  IsVisible="{Binding IsCell}">
                                            <MenuItem.Icon><mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/></MenuItem.Icon>
                                        </MenuItem>

                                    </ContextMenu>
                                </Grid.ContextMenu>

                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>

                </TreeView>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
