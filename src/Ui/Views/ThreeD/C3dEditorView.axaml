<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v3="using:CircuitRF.Ui.Viewer3D"
             xmlns:t3="using:CircuitRF.Ui.ThreeD"
             xmlns:ctl="using:CircuitRF.Ui.Controls"
             xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
             xmlns:vv3="using:CircuitRF.Ui.Views.Viewer3D"
             xmlns:s3="using:CircuitRF.Render.Scene3D"
             xmlns:converters="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vl="using:CircuitRF.Ui.Views.Layout"
             xmlns:t3v="using:CircuitRF.Ui.Views.ThreeD"
             x:Class="CircuitRF.Ui.Views.ThreeD.C3dEditorView"
             x:DataType="t3:C3dEditorDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <!-- brief-em3d-43 — the 3D editor: brief 28's pane (one implementation, R-em3d43-1a) drawing the .c3d's
         elaboration, with the document's tree on the left and the selection's Properties on the right.
         Toolbar glyphs are Material icons (kinds verified against Material.Icons 3.0.2 — an unknown kind
         renders nothing, with no error). -->
    <UserControl.Resources>
        <converters:ToLowerStringConverter x:Key="ToLower"/>
        <!-- 3D editor bugs round 2 — a unit shown lower case, as every other units combobox shows it (the stored value is
             the enum's name, which the parsers read case-blind). -->
        <DataTemplate x:Key="LowerUnit">
            <TextBlock Text="{Binding Converter={StaticResource ToLower}}"/>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ToggleButton, Button">
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <!-- brief-em3d-91 — the Hide / Show Selection button's backdrop: a theme resource, so the dark theme follows. -->
        <Style Selector="Border.selectionBackdrop">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.selectionBackdrop.visible">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.selectionBackdrop.mixed">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="IndianRed"/>
        </Style>
        <!-- The clip-plane slider set the toolbar's height: Fluent's Slider reserves room for tick bands and a full-size thumb.
             The negative vertical margin pulls its layout footprint back in without squashing the thumb (the Match designer's
             Slider.compact, the same fix; an explicit Height would push the thumb off the track). -->
        <Style Selector="Slider.compact">
            <Setter Property="Margin" Value="0,-7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 3D editor round 5 — a side panel's edge is a grip: drag it to resize the panel. A view setting, never the
             document's. The theme styles a Thumb only inside a scroll bar or a slider: a bare one has no template, so it
             drew nothing and took no pointer — hence its own, which shows on hover. Round 6: the Variables panel's too. -->
        <Style Selector="Thumb.panelGrip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Thumb.panelGrip:pointerover, Thumb.panelGrip:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
        </Style>
        <!-- 3D editor bugs round 6 — the Variables panel's row actions: square glyph buttons, the Setup Analyses toolbar's look. -->
        <Style Selector="Button.varGlyph">
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.varGlyph mi|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="4,2" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <WrapPanel x:Name="Toolbar" Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                <!-- 3D icons round — the Box tool took CubeOutline, so Object mode is that cube with its corners marked. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsObjectMode}" ToolTip.Tip="Object mode: select whole solids, sheets and instances  (O)">
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.ObjectMode}"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsFaceMode}" ToolTip.Tip="Face mode: select one face of a solid or sheet  (F)">
                    <mi:MaterialIcon Kind="VectorSquare" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-67 R-em3d67-1c — between Face and Vertex: surfaces, then edges, then points. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsEdgeMode}" ToolTip.Tip="Edge mode: select edges; Shift-click adds  (E)">
                    <mi:MaterialIcon Kind="VectorLine" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsVertexMode}" ToolTip.Tip="Vertex mode: select one vertex  (V)">
                    <mi:MaterialIcon Kind="VectorPoint" Width="16" Height="16"/>
                </ToggleButton>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Hierarchy navigation — the layout editor's Push Into Cell / Pop Out pair: same glyphs, same keys. Push In
                     is enabled on one selected instance (a 3D child is edited here, alone; a layout child opens in the
                     layout editor); Pop Out once pushed in. -->
                <Button IsVisible="{Binding ViewModel.IsEditable}" IsEnabled="{Binding ViewModel.CanPushIn}" Click="OnPushInClick"
                        ToolTip.Tip="Push Into Cell: edit the selected instance's cell — a 3D view here; a layout in the layout editor  (Ctrl+])">
                    <mi:MaterialIcon Kind="ArrowDown" Width="16" Height="16"/>
                </Button>
                <Button IsVisible="{Binding ViewModel.IsEditable}" IsEnabled="{Binding ViewModel.CanPopOut}" Click="OnPopOutClick"
                        ToolTip.Tip="Pop Out: back to the parent  (Ctrl+[)">
                    <mi:MaterialIcon Kind="ArrowUp" Width="16" Height="16"/>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Button Command="{Binding ViewModel.Viewer.FitCommand}" ToolTip.Tip="Fit  (Home)">
                    <mi:MaterialIcon Kind="FitToPageOutline" Width="16" Height="16"/>
                </Button>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsPerspective}" ToolTip.Tip="Perspective view  (P toggles)">
                    <mi:MaterialIcon Kind="PerspectiveMore" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsOrthographic}" ToolTip.Tip="Orthographic view  (P toggles)">
                    <mi:MaterialIcon Kind="PerspectiveLess" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-106 R-em3d106-1b — the realistic view, after the projection pair, in every host (read-only included).
                     View state: never saved, off on every open; L toggles it. Glyph: a camera aperture (D1). -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsRealistic}"
                              ToolTip.Tip="Realistic view: materials, lighting and shadows, for pictures. Changes nothing in the model.  (L)">
                    <mi:MaterialIcon Kind="CameraIris" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-108 R-em3d108-3a — the Look panel's drop-down, right beside the toggle (owner decision D1). Opening it turns the
                     realistic view on (D2). A setup's view has no Look to edit, so it is not offered there.
                     It opens LEFTWARD (right edges aligned), over the Objects tree rather than the viewport, so the picture being
                     tuned stays in view; the viewport takes the wheel while it is open (code-behind: OverlayInputPassThroughElement). -->
                <Button x:Name="LookButton" Padding="1,4" Margin="-3,0,0,0" IsVisible="{Binding ViewModel.IsEditable}"
                        ToolTip.Tip="Look: environment, lighting, background and what the realistic view shows. Opening it turns the realistic view on.">
                    <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opened="OnLookOpened" Closed="OnLookClosed">
                            <t3v:LookPanel DataContext="{Binding ViewModel.LookPanel}" CloseRequested="OnLookCloseRequested"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Iso}" ToolTip.Tip="Isometric view  (1)">
                    <!-- The cube with the three faces an isometric view shows, filled. -->
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Isometric}"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Top}" ToolTip.Tip="Top view, orthographic  (2)">
                    <v3:Viewer3DViewGlyph Face="Top"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Front}" ToolTip.Tip="Front view, orthographic  (3)">
                    <v3:Viewer3DViewGlyph Face="Front"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Right}" ToolTip.Tip="Right view, orthographic  (4)">
                    <v3:Viewer3DViewGlyph Face="Right"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Back}" ToolTip.Tip="Back view, orthographic  (5)">
                    <v3:Viewer3DViewGlyph Face="Back"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Left}" ToolTip.Tip="Left view, orthographic  (6)">
                    <v3:Viewer3DViewGlyph Face="Left"/>
                </Button>
                <Button Command="{Binding ViewModel.Viewer.StandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Bottom}" ToolTip.Tip="Bottom view, orthographic  (7)">
                    <v3:Viewer3DViewGlyph Face="Bottom"/>
                </Button>

                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- 3D editor bugs round 2 — the tools come first and the snap switches after the drawing plane (owner's order). -->
                <!-- brief-em3d-45 R-em3d45-3 — the tools (Shift+A opens them at the cursor, one letter each). Arming one keeps
                     the selection mode; Esc disarms. Icon kinds verified in Material.Icons 3.0.2: there is no Cylinder
                     kind, and Database (a stack of discs) read badly, so the cylinder is drawn (Viewer3DPathGlyph). -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsBoxArmed}" ToolTip.Tip="Box: corner, opposite corner, height  (Shift+A, B)">
                    <!-- 3D icons round — an outlined box, as the cylinder and sphere beside it are outlined solids. -->
                    <mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- 3D editor keys round — the two solids side by side: Cylinder right after Box (owner's order). -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsCylinderArmed}" ToolTip.Tip="Cylinder: centre, radius, height  (Shift+A, Y)">
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Cylinder}"/>
                </ToggleButton>
                <!-- brief-em3d-102 — the third solid, right after Cylinder; drawn, as the icon set has no sphere (D5). -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsSphereArmed}" ToolTip.Tip="Sphere: centre, radius  (Shift+A, E)">
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Sphere}"/>
                </ToggleButton>
                <!-- brief-sar-3 R-sar3-1 — an ellipsoid, right after the sphere it starts as. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsEllipsoidArmed}" ToolTip.Tip="Ellipsoid: centre, then its semi-axes; each is edited apart in the Inspector  (Shift+A, O)">
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Ellipsoid}"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsSheetArmed}" ToolTip.Tip="Sheet: a rectangle, two clicks  (Shift+A, S)">
                    <!-- The layout editor's Rectangle glyph: VectorRectangle draws vertex handles on the corners. -->
                    <mi:MaterialIcon Kind="RectangleOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsPolygonArmed}" ToolTip.Tip="Polygon: a closed sheet, a click per vertex  (Shift+A, G)">
                    <mi:MaterialIcon Kind="VectorPolygon" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsPolylineArmed}" ToolTip.Tip="Polyline: construction geometry, a click per vertex  (Shift+A, L)">
                    <mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-101 R-em3d101-2a — a reference image as a sheet: a Button (nothing is armed), beside the sheet tools. -->
                <Button IsVisible="{Binding ViewModel.IsEditable}" Click="OnInsertImage" ToolTip.Tip="Insert Image…: a reference image as a sheet on the drawing plane, not modelled">
                    <mi:MaterialIcon Kind="ImagePlusOutline" Width="16" Height="16"/>
                </Button>
                <!-- brief-em3d-49 R-em3d49-2d — a port, drawn like a sheet; its polarity is inferred from what it touches. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsPortArmed}" ToolTip.Tip="Port: two corners on the drawing plane, between two conductors. The arrow runs from − to +; right-click it to flip  (Shift+A, P)">
                    <mi:MaterialIcon Kind="ArrowUpBoldBoxOutline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-sar-3 R-sar3-3 — a lumped R, L or C, drawn as a port is: not a port, no row in S. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsLumpedElementArmed}" ToolTip.Tip="Lumped element: two corners across a gap between two conductors; R, L and C in the Inspector  (Shift+A, C)">
                    <v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Capacitor}"/>
                </ToggleButton>
                <!-- brief-em3d-50 R-em3d50-3 — a bond wire, pad to pad, then its loop height (assembly: lower foot to apex top). -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsWireArmed}" ToolTip.Tip="Wire: click any face of a metal object or a sheet, then another (inside a placed cell too) — each end attaches to that object's top — then set the loop height — measured from the lower foot to the top of the wire — with the mouse or by typing it  (W, or Shift+A, W)">
                    <mi:MaterialIcon Kind="VectorCurve" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-em3d-75 R-em3d75-1a — the thermal places: records beside the ports, drawn in the overlay only. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsHeatSourceArmed}"
                              ToolTip.Tip="Heat Source: a rectangle on the drawing plane, as a port's sheet is drawn; then its name and power (3D ▸ Draw ▸ Heat Source for a polygon)  (Shift+A, H)">
                    <mi:MaterialIcon Kind="FireCircle" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsProbeArmed}"
                              ToolTip.Tip="Probe: click the point on a face where temperature is read (3D ▸ Draw ▸ Probe for a spot or a line; right-click a face, solid or wire for those)  (Shift+A, T)">
                    <mi:MaterialIcon Kind="ThermometerProbe" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.IsMeshRegionArmed}"
                              ToolTip.Tip="Mesh Region: a box drawn as the Box tool draws one; then its element size. Refines the Gmsh mesh that Palace and thermal runs use; openEMS builds its own grid and ignores it  (Shift+A, M)">
                    <mi:MaterialIcon Kind="CubeScan" Width="16" Height="16"/>
                </ToggleButton>
                <!-- 3D editor bugs round 5 — both are editing chrome; one of the two shows at a time. -->
                <Panel VerticalAlignment="Center" IsVisible="{Binding ViewModel.IsEditable}">
                    <ComboBox MinWidth="90" VerticalAlignment="Center" ItemsSource="{Binding ViewModel.MaterialChoices}" SelectedItem="{Binding ViewModel.CurrentMaterial}"
                              IsVisible="{Binding !ViewModel.IsWireArmed}"
                              ToolTip.Tip="The material every new object gets, from the technology's materials"/>
                    <!-- brief-em3d-50 R-em3d50-3b — the next wire's values, changeable before the first click. -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ViewModel.IsWireArmed}">
                        <TextBox Width="64" VerticalAlignment="Center" Text="{Binding ViewModel.WireDiameterText}"
                                 Classes.error="{Binding ViewModel.WireDiameterError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                 ToolTip.Tip="The wire's diameter, in the display unit (25.4um, 1mil …)"/>
                        <ComboBox MinWidth="80" ItemsSource="{Binding ViewModel.WireMetals}" SelectedItem="{Binding ViewModel.WireMaterial}"
                                  ToolTip.Tip="The wire's metal, from the technology's materials with a conductivity"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding ViewModel.WireStartStyle}"
                                  ToolTip.Tip="How the start is bonded: a wedge's foot, or a ball"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding ViewModel.WireEndStyle}"
                                  ToolTip.Tip="How the end is bonded: a wedge's foot, or a ball"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.WireSections}" SelectedItem="{Binding ViewModel.WireSection}"
                                  ToolTip.Tip="The swept section: a flat-bottomed hexagon (a foot lands face to face), or round"/>
                    </StackPanel>
                </Panel>

                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-45 R-em3d45-1a — the drawing plane and its offset along the normal, in the display unit (a
                     suffix is honoured). Editor state, saved in the workspace's window state. One small combo rather than three
                     buttons (3D editor round 1: fewer toolbar buttons). -->
                <ComboBox IsVisible="{Binding ViewModel.IsEditable}" MinWidth="58" VerticalAlignment="Center" FontSize="11"
                          ItemsSource="{x:Static t3:C3dEditorViewModel.PlaneChoices}" SelectedItem="{Binding ViewModel.PlaneKind}"
                          ToolTip.Tip="The drawing plane: XY (normal z), YZ (normal x) or XZ (normal y). Ctrl/Cmd-click a face with a tool armed to draw on it."/>
                <TextBox IsVisible="{Binding ViewModel.IsEditable}" x:Name="PlaneOffsetBox" Width="72" VerticalAlignment="Center" Text="{Binding ViewModel.PlaneOffsetText}"
                         Classes.error="{Binding ViewModel.PlaneOffsetError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         KeyDown="OnPlaneOffsetKey" LostFocus="OnPlaneOffsetLostFocus"
                         ToolTip.Tip="The plane's offset along its normal, in the display unit (25um, 10mil …). Ctrl/Cmd+Shift-click a snapped point to move it there."/>

                <!-- 3D editor bugs round 6 — the view's chrome, together: the axis indicator, the drawing grid and the scale
                     legend. What they show is what every picture of the view shows (Copy, Export Picture…, Copy as Vector,
                     Export as Vector…). The separators keep one between groups in both the editor and the read-only view. -->
                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowAxisIndicator}" ToolTip.Tip="Axis indicator  (A)">
                    <mi:MaterialIcon Kind="AxisArrow" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.ShowDrawingGrid}" ToolTip.Tip="The drawing grid on the plane">
                    <mi:MaterialIcon Kind="GridLarge" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowScaleLegend}" ToolTip.Tip="Scale legend: the scale bar at the bottom right">
                    <mi:MaterialIcon Kind="MapLegend" Width="16" Height="16"/>
                </ToggleButton>
                <Border IsVisible="{Binding ViewModel.IsViewOnly}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-44 R-em3d44-5 — snapping: the master switch, then one per kind (each glyph is the
                     marker's), saved per user. Hold Alt / Option to suspend geometry snap; the grid remains. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapEnabled}"
                              ToolTip.Tip="Snap to vertices, midpoints, edges, face centres and the grid. S or F3 turns geometry snap off and on (the grid still applies), F9 the grid — the layout editor's keys. Hold Alt / Option to suspend geometry snap.">
                    <mi:MaterialIcon Kind="Magnet" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapVertex}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to vertices">
                    <mi:MaterialIcon Kind="SquareOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapMidpoint}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to edge midpoints">
                    <mi:MaterialIcon Kind="TriangleOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapEdge}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to the nearest point on an edge">
                    <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapFaceCentre}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to face centres">
                    <mi:MaterialIcon Kind="CircleOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.Viewer.SnapGridOn}" IsEnabled="{Binding ViewModel.Viewer.SnapEnabled}" ToolTip.Tip="Snap to the drawing grid when no geometry is in range  (F9)">
                    <mi:MaterialIcon Kind="Grid" Width="16" Height="16"/>
                </ToggleButton>

                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-46 R-em3d46-6 — Measure: two snapped points, their deltas and distance; nothing is written. -->
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.IsMeasureArmed}" ToolTip.Tip="Measure: two snapped points — x, y, z, the deltas and the distance, every number copyable  (M)">
                    <mi:MaterialIcon Kind="RulerSquare" Width="16" Height="16"/>
                </ToggleButton>

                <ToggleButton IsChecked="{Binding ViewModel.ShowTree}" ToolTip.Tip="Object tree">
                    <mi:MaterialIcon Kind="FileTreeOutline" Width="16" Height="16"/>
                </ToggleButton>
                <!-- 3D editor round 1 — the selection's fields are in the application's Properties Inspector: this brings it
                     forward, opening it when it was closed. -->
                <Button IsVisible="{Binding ViewModel.IsEditable}" Command="{Binding ViewModel.ShowPropertiesPanelCommand}" ToolTip.Tip="Properties: bring the Properties Inspector forward (it opens if it was closed)">
                    <mi:MaterialIcon Kind="CardTextOutline" Width="16" Height="16"/>
                </Button>

                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- brief-em3d-49 — the active setup's air box, the setups (Simulate ▸ Setup Analyses…), and Simulate. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.AirBoxShown}"
                              ToolTip.Tip="Air box: the active setup's, each face tinted by its boundary (PEC grey, PMC orange, symmetry hatched, absorbing clear). In Face mode its faces are picked last; right-click one to set its boundary or padding.">
                    <mi:MaterialIcon Kind="BorderOutside" Width="16" Height="16"/>
                </ToggleButton>
                <Button IsVisible="{Binding ViewModel.IsEditable}" Command="{Binding ViewModel.OpenSetupAnalysesCommand}" ToolTip.Tip="Setups: the EM setups this 3D view carries, and which one is active (Simulate ▸ Setup Analyses…)">
                    <mi:MaterialIcon Kind="TuneVariant" Width="16" Height="16"/>
                </Button>
                <!-- brief-em3d-51 R-em3d51-4a — the Variables panel. -->
                <ToggleButton IsVisible="{Binding ViewModel.IsEditable}" IsChecked="{Binding ViewModel.ShowVariables}" ToolTip.Tip="Variables: this 3D view's VARs and its cell's parameters — the names its dimensions may use">
                    <mi:MaterialIcon Kind="Variable" Width="16" Height="16"/>
                </ToggleButton>
                <!-- 3D editor bugs round 2 — the workspace toolbar's Run button, glyph and look alike: here it runs the active
                     setup, as Simulate ▸ Run (Ctrl/Cmd+R) does with a 3D view in front. The workspace's Stop does not reach an EM
                     run (it stops a schematic run); an EM run is cancelled from its progress row in the Messages panel, so
                     there is no Stop beside this one. -->
                <Button IsVisible="{Binding ViewModel.IsEditable}" Command="{Binding ViewModel.SimulateActiveCommand}"
                        ToolTip.Tip="{Binding ViewModel.SimulateBlockedReason, TargetNullValue='Run Analysis: the active setup (Ctrl+R)'}"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="PlayCircleOutline" Width="18" Height="18"/>
                </Button>
                <!-- brief-dfr36-1 R-dfr36-1-1 — the active setup's mesh with no solve. Greyed in place, with the reason, on a setup with
                     no Gmsh mesh; it is stopped from its progress row in the Messages panel, as a run is. -->
                <Button IsVisible="{Binding ViewModel.IsEditable}" Command="{Binding ViewModel.MeshActiveCommand}"
                        ToolTip.Tip="{Binding ViewModel.MeshBlockedReason, TargetNullValue='Mesh: the mesh a run of the active setup would solve on, with no solve. Simulate reuses it while it is current.'}"
                        ToolTip.ShowOnDisabled="True" Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="GridLarge" Width="18" Height="18"/>
                </Button>

                <Border IsVisible="{Binding ViewModel.IsEditable}" Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Owner decision D4: the layout editor's Unit control. A document preference, not geometry:
                     it dirties the document and is saved, adds no undo entry, and moves nothing. -->
                <StackPanel IsVisible="{Binding ViewModel.IsEditable}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Unit:" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="64" ItemsSource="{x:Static t3:C3dEditorViewModel.AllUnits}"
                              SelectedItem="{Binding ViewModel.DisplayUnit, Mode=TwoWay}"
                              ToolTip.Tip="The unit every length is shown in. Changing it moves nothing.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToLower}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 3D editor bugs round 2 — the layout editor's Snap control (its ladder is SnapLadder, shared): the snap
                     step on the drawing plane, a document preference like the unit. -->
                <StackPanel IsVisible="{Binding ViewModel.IsEditable}" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Snap:" VerticalAlignment="Center"/>
                    <ComboBox MinWidth="90" ItemsSource="{Binding ViewModel.SnapLadderOptions}" IsEditable="True"
                              Text="{Binding ViewModel.SnapDistanceText, Mode=TwoWay}"
                              LostFocus="OnSnapDistanceLostFocus" KeyDown="OnSnapDistanceKey"
                              SelectionChanged="OnSnapDistanceSelectionChanged"
                              ToolTip.Tip="Snap distance: the step a point snaps to on the drawing plane when no geometry is in range. Pick a rung or type a length (2.5mil, 10um). F9 turns grid snap off and on."/>
                </StackPanel>

                <!-- 3D editor bugs round 5 — a setup's 3D view (IsViewOnly): the switches the read-only viewer had and the editor
                     does not need — the kinds its scene is built of, and the solver's mesh and FDTD grid. -->
                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" IsVisible="{Binding ViewModel.IsViewOnly}"/>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowDielectrics}" IsVisible="{Binding ViewModel.IsViewOnly}" ToolTip.Tip="Dielectrics">
                    <mi:MaterialIcon Kind="LayersOutline" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowAir}" IsVisible="{Binding ViewModel.IsViewOnly}" ToolTip.Tip="Air">
                    <mi:MaterialIcon Kind="CubeScan" Width="16" Height="16"/>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowBoundaryFaces}" IsVisible="{Binding ViewModel.IsViewOnly}"
                              ToolTip.Tip="Air-box faces, coloured by boundary kind (grey PEC, blue absorbing, orange PMC, violet symmetry)">
                    <mi:MaterialIcon Kind="TextureBox" Width="16" Height="16"/>
                </ToggleButton>
                <!-- The run's tools, in the toolbar with the rest (owner request, 2026-09-28: they had a row of their own under
                     it). The mesh: disabled until a mesh is on disk, with the tooltip saying who made it (brief-dfr36-1) — in the
                     editor and the viewer alike. -->
                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <!-- brief-em3d-91 R-em3d91-3 — Hide / Show Selection (H). A Button, not a ToggleButton: a checked style would
                     compete with the three-way backdrop. The glyph never changes; the backdrop says the state — the accent when
                     all of the selection is shown, the accent dimmed when some of it is hidden, nothing when all of it is. -->
                <Button Command="{Binding ViewModel.ToggleSelectionVisibilityCommand}" Padding="0"
                        ToolTip.Tip="{Binding ViewModel.SelectionVisibilityTip}" ToolTip.ShowOnDisabled="True">
                    <Panel>
                        <Border Classes="selectionBackdrop" CornerRadius="{Binding $parent[Button].CornerRadius}"
                                Classes.visible="{Binding ViewModel.IsSelectionAllVisible}" Classes.mixed="{Binding ViewModel.IsSelectionMixed}"/>
                        <mi:MaterialIcon Kind="EyeOff" Width="16" Height="16" Margin="6,3"/>
                    </Panel>
                </Button>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowMesh}" IsEnabled="{Binding ViewModel.Viewer.CanShowMesh}"
                              ToolTip.Tip="{Binding ViewModel.Viewer.MeshTip}" ToolTip.ShowOnDisabled="True">
                    <mi:MaterialIcon Kind="VectorTriangle" Width="16" Height="16"/>
                </ToggleButton>
                <!-- brief-dfr36-1 — the mesh's own plane, apart from the clip plane and every field plot's plane. -->
                <Button IsEnabled="{Binding ViewModel.Viewer.CanShowMesh}" ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="Mesh plane: the tetrahedra on a plane of their own. The clip plane and the field plots' planes do not move it.">
                    <mi:MaterialIcon Kind="VectorSquare" Width="16" Height="16"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="6" MinWidth="220">
                                <CheckBox Content="Show the tetrahedra on a plane" IsChecked="{Binding ViewModel.Viewer.MeshPlaneEnabled}"
                                          ToolTip.Tip="With the mesh on, the tetrahedra this plane cuts. It also cuts the solids so they can be seen, unless the clip plane is on, which then does the cutting."/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox ItemsSource="{Binding ViewModel.Viewer.MeshPlaneAxes}" SelectedItem="{Binding ViewModel.Viewer.MeshPlaneAxis}"
                                              IsEnabled="{Binding ViewModel.Viewer.MeshPlaneEnabled}" MinWidth="70"
                                              ToolTip.Tip="The plane's normal"/>
                                    <ToggleButton IsChecked="{Binding ViewModel.Viewer.MeshPlaneFlip}" IsEnabled="{Binding ViewModel.Viewer.MeshPlaneEnabled}"
                                                  ToolTip.Tip="Keep the other side of the plane">
                                        <mi:MaterialIcon Kind="SetSplit" Width="16" Height="16"/>
                                    </ToggleButton>
                                    <TextBlock Text="{Binding ViewModel.Viewer.MeshPlaneText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Slider Classes="compact" Minimum="0" Maximum="1" Value="{Binding ViewModel.Viewer.MeshPlanePosition}"
                                        IsEnabled="{Binding ViewModel.Viewer.MeshPlaneEnabled}"
                                        ToolTip.Tip="Drag the mesh plane through the model"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- brief-em3d-75 R-em3d75-4d / -4e — a thermal run's two readings that add nothing to the document. -->
                <Button Command="{Binding ViewModel.StartTemperatureAlongCommand}"
                        IsVisible="{Binding ViewModel.ShowThermalRunTools}"
                        ToolTip.Tip="Temperature Along… — pick two points: T between them, both ends and ΔT (Rth by hand). Nothing is added to the document.">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                        <TextBlock Text="Along…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ToggleButton IsChecked="{Binding ViewModel.ProbeTableOpen}" IsVisible="{Binding ViewModel.ShowThermalRunTools}"
                              ToolTip.Tip="Every probe statistic and every measure at the sweep point shown; a probe past its limit is flagged">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="TableLarge" Width="16" Height="16"/>
                        <TextBlock Text="Probes" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ShowGrid}" IsEnabled="{Binding ViewModel.Viewer.GridAvailable}" IsVisible="{Binding ViewModel.IsViewOnly}"
                              ToolTip.Tip="{Binding ViewModel.Viewer.GridTip}" ToolTip.ShowOnDisabled="True">
                    <mi:MaterialIcon Kind="GridLarge" Width="16" Height="16"/>
                </ToggleButton>

                <!-- 3D editor bugs round 2 — the clip plane's controls, moved to the end of the toolbar, after Snap. -->
                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ClipEnabled}" ToolTip.Tip="Clip plane  (C)">
                    <mi:MaterialIcon Kind="ContentCut" Width="16" Height="16"/>
                </ToggleButton>
                <ComboBox ItemsSource="{Binding ViewModel.Viewer.ClipAxes}" SelectedItem="{Binding ViewModel.Viewer.ClipAxis}"
                          IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}" MinWidth="70" VerticalAlignment="Center"
                          ToolTip.Tip="The plane's normal: an axis, the current view direction, or Section (the plane Section Through… set)"/>
                <Slider Classes="compact" Width="120" Minimum="0" Maximum="1" Value="{Binding ViewModel.Viewer.ClipPosition}"
                        IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}" VerticalAlignment="Center"
                        ToolTip.Tip="Drag the clip plane through the model"/>
                <ToggleButton IsChecked="{Binding ViewModel.Viewer.ClipFlip}" IsEnabled="{Binding ViewModel.Viewer.ClipEnabled}"
                              ToolTip.Tip="Keep the other side of the plane">
                    <mi:MaterialIcon Kind="SetSplit" Width="16" Height="16"/>
                </ToggleButton>

                <!-- brief-em3d-29 R-em3d29-5 — the GPU's own pixels, read back at up to 4x the window. 3D editor bugs round 5:
                     the read-only viewer's, now the editor's too. -->
                <Border Width="1" Margin="2,3" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                <Button ToolTip.Tip="Export picture… (PNG of this view, read back from the GPU)">
                    <mi:MaterialIcon Kind="CameraOutline" Width="16" Height="16"/>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Spacing="6" MinWidth="200">
                                <TextBlock Text="Export picture" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Size" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ViewModel.Viewer.ExportScales}" SelectedItem="{Binding ViewModel.Viewer.ExportScale}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0}× the window'}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- brief-em3d-107 R-em3d107-5 — the realistic view's picture: drawn at k × the size and brought down, and
                                     optionally with no background (the ground's shadow then lands in the PNG's alpha) -->
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ViewModel.Viewer.IsRealistic}">
                                    <TextBlock Text="Supersampling" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding ViewModel.Viewer.ExportSupersamples}" SelectedItem="{Binding ViewModel.Viewer.ExportSupersample}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0}×'}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding ViewModel.Viewer.ExportTransparent}" Content="Transparent background"
                                          IsVisible="{Binding ViewModel.Viewer.IsRealistic}"/>
                                <CheckBox IsChecked="{Binding ViewModel.Viewer.ExportLegend}" Content="Legend"/>
                                <CheckBox IsChecked="{Binding ViewModel.Viewer.ExportCaption}" Content="Frequency or mode caption"/>
                                <Button Content="Save PNG…" Click="OnExportPicture" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ── brief-em3d-48: the push-in breadcrumb (hier4's shape); a click pops out to that level ── -->
        <Border DockPanel.Dock="Top" Padding="6,3" BorderThickness="0,0,0,1" IsVisible="{Binding ViewModel.CanPopOut}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Pop Out" FontSize="11" Padding="6,1" Click="OnPopOutClick" ToolTip.Tip="Back to the parent (Ctrl/Cmd+[). A dirty child is saved or discarded as you answer."/>
                <ItemsControl ItemsSource="{Binding ViewModel.Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dBreadcrumb">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="›" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                <Button Content="{Binding Text}" FontSize="11" Padding="4,1" Tag="{Binding FrameIndex}"
                                        IsEnabled="{Binding !IsCurrent}" Click="OnBreadcrumbClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- brief-em3d-49 R-em3d49-5b's strip under the toolbar is retired (owner request, 2026-09-28): the mesh and a thermal
             run's Along… and Probes are toolbar buttons, and the stale-fields sentence is the Properties Inspector's, on the
             selected field plot. -->

        <!-- ── brief-em3d-75 R-em3d75-4d / -4e: the line plot and the probe table ──────────── -->
        <Border DockPanel.Dock="Bottom" Padding="6,4" BorderThickness="0,1,0,0" IsVisible="{Binding ViewModel.HasThermalLine}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Command="{Binding ViewModel.CloseThermalLineCommand}" Padding="4,1" ToolTip.Tip="Close the plot">
                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                    </Button>
                    <SelectableTextBlock Text="{Binding ViewModel.ThermalLineText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <ddc:PlotControl x:Name="ThermalLinePlot" Height="200" Plot="{Binding ViewModel.ThermalLinePlot}"
                                 CanDeletePlot="False" CanEditPlotProperties="False"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="6,4" BorderThickness="0,1,0,0" IsVisible="{Binding ViewModel.ProbeTableOpen}" MaxHeight="260"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding ViewModel.ProbeTableAllPoints}" Content="Every point" FontSize="11" Padding="4,1"
                                  ToolTip.Tip="A column per sweep point (⚠ where a probe reached its limit)"/>
                    <!-- brief-em3d-79 R-em3d79-4: what ▶ plots a row against — the sweep variable, or a circuit cube the run carried -->
                    <ComboBox DockPanel.Dock="Right" FontSize="11" Margin="0,0,6,0" MinWidth="90" ItemsSource="{Binding ViewModel.ProbeTableXChoices}"
                              SelectedItem="{Binding ViewModel.ProbeTableX}" IsVisible="{Binding ViewModel.HasProbeTableX}"
                              ToolTip.Tip="What ▶ plots a row against: the sweep's variable, or a cube the circuit's HB carried (wire temperature against Pout)"/>
                    <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Text="against"
                               IsVisible="{Binding ViewModel.HasProbeTableX}"/>
                    <SelectableTextBlock Text="{Binding ViewModel.ProbeTableHeading}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ViewModel.ProbeTable}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="t3:C3dProbeTableRow">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProbeName"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProbeValue"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="▶" FontSize="9" Padding="3,0" Margin="0,0,6,0"
                                            Command="{Binding $parent[ItemsControl].((t3:C3dEditorDocument)DataContext).ViewModel.PlotProbeTableRowCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Name}" ToolTip.Tip="Plot this row against the sweep (or the cube picked above)"/>
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" Margin="0,0,12,0"
                                                         FontStyle="{Binding IsMeasure, Converter={x:Static t3:C3dProbeTableStyle.Italic}}"/>
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" FontSize="11" Margin="0,0,12,0"
                                                         Foreground="{Binding Crossed, Converter={x:Static t3:C3dProbeTableStyle.Flag}}"/>
                                    <SelectableTextBlock Grid.Column="3" Text="{Binding AllPoints}" FontSize="11" Opacity="0.8"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Status ──────────────────────────────────────────────────────────── -->
        <!-- 3D editor bugs round 2 — hidden: the text under the viewport is kept for debugging only, and comes back with
             CRF_3D_STATUS_PANE=1 in the environment (C3dEditorViewModel.ShowStatusPane). -->
        <Border DockPanel.Dock="Bottom" Padding="6,2" BorderThickness="0,1,0,0"
                IsVisible="{Binding ViewModel.ShowsStatusPane}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="1">
                <DockPanel>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Text="{Binding ViewModel.Viewer.CursorText}"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.GridText}"
                                         IsVisible="{Binding ViewModel.GridText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         ToolTip.Tip="The drawn grid's minor spacing, and the snap step when it differs (the document's SnapDbu)"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.PlaneText}"
                                         ToolTip.Tip="The drawing plane"/>
                    <SelectableTextBlock DockPanel.Dock="Right" FontSize="11" Margin="0,0,16,0" Text="{Binding ViewModel.Viewer.SnapText}"
                                         IsVisible="{Binding ViewModel.Viewer.SnapText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         ToolTip.Tip="What the cursor snaps to, in the display unit. ≈ marks a point that is not an exact database-unit point (a rotated object, or another scale)."/>
                    <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.Status}" TextWrapping="Wrap"/>
                </DockPanel>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.SelectionText}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.Viewer.SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.MeshText}" IsVisible="{Binding ViewModel.Viewer.MeshText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.MeshStaleText}" TextWrapping="Wrap" IsVisible="{Binding ViewModel.Viewer.MeshStaleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.FieldText}" IsVisible="{Binding ViewModel.Viewer.FieldText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.PictureText}" IsVisible="{Binding ViewModel.Viewer.PictureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <!-- brief-em3d-106 R-em3d106-1d — the realistic view's environment and exposure, and what fell back. -->
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.RealisticText}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.Viewer.RealisticText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.ToolPrompt}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.ToolPrompt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <DockPanel IsVisible="{Binding ViewModel.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <!-- brief-em3d-51 R-em3d51-6 — a drag refused on an expression offers the field's number in its place. -->
                    <Button DockPanel.Dock="Right" Content="Replace with Number" FontSize="11" Padding="6,1"
                            Command="{Binding ViewModel.ReplaceWithNumberCommand}" IsVisible="{Binding ViewModel.CanReplaceWithNumber}"/>
                    <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.StatusMessage}" TextWrapping="Wrap"/>
                </DockPanel>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.FrameText}" TextWrapping="Wrap"
                                     IsVisible="{Binding ViewModel.FrameText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.LodText}" TextWrapping="Wrap" Foreground="{DynamicResource CrfWarningBrush}"
                                     IsVisible="{Binding ViewModel.Viewer.LodText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock FontSize="11" Text="{Binding ViewModel.Viewer.Notes}" TextWrapping="Wrap" Opacity="0.85"
                                     IsVisible="{Binding ViewModel.Viewer.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <!-- ── The object tree (R-em3d43-6a), fed from the document ─────────── -->
            <Border Grid.Column="0" x:Name="TreePanel" Width="230" IsVisible="{Binding ViewModel.ShowTree}" BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <DockPanel>
                <!-- 3D editor round 5 — the panel's right edge is a grip: drag it to widen the tree and read a long name. -->
                <Thumb DockPanel.Dock="Right" x:Name="TreeGrip" Classes="panelGrip" Width="6" Cursor="SizeWestEast"
                       DragDelta="OnTreeGripDrag" ToolTip.Tip="Drag to resize the object tree"/>
                <!-- 3D editor round 2 — the panel's header: its name, how its objects are grouped (by material, the
                     default, or by primitive type), and at the top right the filter, whose icon changes while it hides
                     anything. The filter hides tree rows only; the 3D view still draws every object. -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="6,3,3,3">
                    <TextBlock Grid.Column="0" Text="Objects" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="TreeGroupingCombo" FontSize="11" MinHeight="0" Padding="6,1" VerticalAlignment="Center"
                              ItemsSource="{x:Static t3:C3dEditorViewModel.TreeGroupingChoices}" SelectedItem="{Binding ViewModel.TreeGroupingText}"
                              ToolTip.Tip="List the objects by material or by primitive type"/>
                    <!-- 3D editor round 5 — every listed row shown or hidden at once: the .ctech Layers switch's eye glyphs. -->
                    <Button Grid.Column="2" Margin="3,0,0,0" Padding="3" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            Command="{Binding ViewModel.ShowAllTreeObjectsCommand}"
                            ToolTip.Tip="Show every object the tree lists. With a filter active, the rows it hides are left as they are.">
                        <mi:MaterialIcon Kind="Eye" Width="15" Height="15" Opacity="0.7"/>
                    </Button>
                    <Button Grid.Column="3" Padding="3" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            Command="{Binding ViewModel.HideAllTreeObjectsCommand}"
                            ToolTip.Tip="Hide every object the tree lists. With a filter active, the rows it hides are left as they are.">
                        <mi:MaterialIcon Kind="EyeOff" Width="15" Height="15" Opacity="0.7"/>
                    </Button>
                    <Button Grid.Column="4" Padding="3" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTip.Tip="Filter the tree by object type or material. The 3D view still draws everything.">
                        <Panel>
                            <mi:MaterialIcon Kind="Filter" Width="15" Height="15" Opacity="0.7" IsVisible="{Binding !ViewModel.IsTreeFilterActive}"/>
                            <mi:MaterialIcon Kind="FilterCheck" Width="15" Height="15" Foreground="{DynamicResource SystemAccentColor}"
                                             IsVisible="{Binding ViewModel.IsTreeFilterActive}"/>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="4" MinWidth="170">
                                    <TextBlock Text="Types" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding ViewModel.TypeFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="t3:C3dTreeFilterEntry">
                                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" MinHeight="0" Padding="4,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Materials" FontWeight="SemiBold" Margin="0,4,0,0"
                                               IsVisible="{Binding ViewModel.HasMaterialFilters}"/>
                                    <ItemsControl ItemsSource="{Binding ViewModel.MaterialFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="t3:C3dTreeFilterEntry">
                                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" MinHeight="0" Padding="4,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Show All" Command="{Binding ViewModel.ShowAllTreeRowsCommand}" HorizontalAlignment="Right"
                                            IsEnabled="{Binding ViewModel.IsTreeFilterActive}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <!-- 3D editor round 5 — Shift selects a range, Ctrl/Cmd adds or removes a row, as on the canvas. The
                     selection is mirrored in code (SelectedTreeItems, in the order it was made), never bound. -->
                <!-- brief-em3d-95 — a Background, so a right-click on the empty area below the rows reaches the tree (Paste). -->
                <TreeView x:Name="ObjectTree" ItemsSource="{Binding ViewModel.Tree}" SelectionMode="Multiple" Background="Transparent"
                          SelectionChanged="OnTreeSelectionChanged"
                          ContextRequested="OnTreeContextRequested">
                    <TreeView.Styles>
                        <!-- 3D editor round 1 — expansion is the node's, so it survives the rebuild every edit makes. -->
                        <Style Selector="TreeViewItem" x:DataType="t3:C3dTreeNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.DataTemplates>
                        <TreeDataTemplate DataType="t3:C3dTreeGroup" ItemsSource="{Binding Items}">
                            <!-- brief-em3d-83 R-em3d83-3 — a group may add a member from its header (Field Plots' +). -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding HeaderTip}">
                                <!-- Every row of this section shown or hidden at once; the dash while some are (C3dTreeGroup.AllVisible). -->
                                <CheckBox IsChecked="{Binding AllVisible, Mode=TwoWay}" IsThreeState="False" MinWidth="0" Padding="0"
                                          IsVisible="{Binding HasVisibilitySwitch}" ToolTip.Tip="{Binding VisibilityTip}"/>
                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" ToolTip.Tip="{Binding AddTip}"
                                        Padding="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                    <mi:MaterialIcon Kind="Plus" Width="13" Height="13" Opacity="0.75"/>
                                </Button>
                            </StackPanel>
                        </TreeDataTemplate>
                        <TreeDataTemplate DataType="t3:C3dTreeItem" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0" IsVisible="{Binding !IsFeature}"
                                          ToolTip.Tip="{Binding VisibleTip}"/>
                                <!-- brief-em3d-66 R-em3d66-3a — an operation's icon; dimmed while it is disabled. -->
                                <mi:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" VerticalAlignment="Center"
                                                 IsVisible="{Binding HasIcon}" Opacity="{Binding IconOpacity}"/>
                                <!-- brief-em3d-93 R-em3d93-3 — a row that is not modelled is greyed, and its tooltip says why. -->
                                <ctl:TextBaselineRow Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding OrderTip}" Opacity="{Binding NameOpacity}"/>
                                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" ToolTip.Tip="{Binding DetailTip}"/>
                                </ctl:TextBaselineRow>
                                <!-- brief-em3d-50 R-em3d50-4 — a wire whose end is on no pad: flagged, with the refusal's words. -->
                                <mi:MaterialIcon Kind="AlertOutline" Width="12" Height="12" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource CrfWarningBrush}"
                                                 IsVisible="{Binding Refusal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                 ToolTip.Tip="{Binding Refusal}"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>
              </DockPanel>
            </Border>

            <!-- ── The pane, and its 2D chrome ─────────────────────────────────── -->
            <Panel Grid.Column="1" x:Name="ViewportPanel">
                <v3:Viewer3DPane x:Name="Pane" DataContext="{Binding ViewModel.Viewer}"/>
                <v3:Viewer3DOverlay x:Name="Overlay" DataContext="{Binding ViewModel.Viewer}"/>
                <!-- brief-em3d-86 R-em3d86-3 — the sweep slider, on the viewport with the field's legend: one control per sweep
                     axis, labelled with its variable, value and unit. A drag previews and its release keeps the step (the drawn
                     plot's Solution, one undo entry: SweepCard's PointerReleased); ◀ and ▶ keep it per press. -->
                <Border x:Name="SweepCard" IsVisible="{Binding ViewModel.SweepControlVisible}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12" Padding="8,6" CornerRadius="4" MinWidth="236"
                        Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}">
                    <ItemsControl ItemsSource="{Binding ViewModel.SweepAxes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="t3:C3dSweepAxis">
                                <StackPanel Spacing="2" Margin="0,2">
                                    <TextBlock Text="{Binding Label}" FontSize="12"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="◀" Padding="6,0" FontSize="11" Command="{Binding PreviousCommand}"
                                                ToolTip.Tip="The previous sweep point"/>
                                        <Button DockPanel.Dock="Right" Content="▶" Padding="6,0" FontSize="11" Command="{Binding NextCommand}"
                                                ToolTip.Tip="The next sweep point"/>
                                        <Slider Minimum="0" Maximum="{Binding Max}" Value="{Binding Index}" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Focusable="False" Margin="6,0" MinWidth="140"
                                                ToolTip.Tip="{Binding Name, StringFormat='The sweep of {0}: the drawn plot moves to the point, and keeps it'}"/>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <!-- Designer feedback 02 — the first scene of a large board takes seconds, and the status pane that says so is
                     hidden: say it on the canvas until something is drawn. -->
                <Border IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}"
                        IsVisible="{Binding ViewModel.Viewer.IsBuildingFirstScene}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressBar IsIndeterminate="True" Width="48" MinWidth="0" Height="4" VerticalAlignment="Center"/>
                        <TextBlock Text="Building the 3D view…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- brief-dfr31-5 R-dfr31-5-3 — a first scene that has not arrived after 30 s says so and offers Retry. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,8" CornerRadius="4"
                        Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}"
                        IsVisible="{Binding ViewModel.Viewer.IsFirstSceneStalled}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="The 3D view did not finish building —" VerticalAlignment="Center"/>
                        <Button Content="Retry" Padding="8,2" Command="{Binding ViewModel.Viewer.RetryFirstSceneCommand}"/>
                    </StackPanel>
                </Border>
                <!-- brief-dfr26-1 R-dfr26-1-5 — a scene drawn although a solve would refuse it (a port that cannot be built)
                     says why over the viewport, rather than the refusal replacing the scene. ONE line, so it never covers the
                     scene (designer round 33: four wrapped lines hid a small preview); the whole sentence is the tooltip and
                     the first line of the notes. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="96,8" Padding="10,3"
                        CornerRadius="4" MaxWidth="900" Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}"
                        ToolTip.Tip="{Binding ViewModel.Viewer.Banner}"
                        IsVisible="{Binding ViewModel.Viewer.Banner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock FontSize="12" Text="{Binding ViewModel.Viewer.Banner}" MaxLines="1" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource CrfWarningBrush}"/>
                </Border>
                <vv3:Viewer3DMeasureCard DataContext="{Binding ViewModel.Viewer}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,104"/>
                <!-- 3D editor bugs round 2 — the status pane's one line, on the viewport between the axis indicator and the
                     scale bar: the last message, else the tool's prompt (C3dEditorViewModel.ViewportLine). The text lets the
                     pointer through to the view; only the Replace with Number button, when offered, takes a click. -->
                <DockPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="96,0,200,8"
                           IsVisible="{Binding ViewModel.ViewportLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Button DockPanel.Dock="Right" Content="Replace with Number" FontSize="11" Padding="6,1" Margin="6,0,0,0"
                            Command="{Binding ViewModel.ReplaceWithNumberCommand}" IsVisible="{Binding ViewModel.CanReplaceWithNumber}"/>
                    <Border IsHitTestVisible="False" Padding="6,2" CornerRadius="3" VerticalAlignment="Center"
                            Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}">
                        <TextBlock FontSize="11" Text="{Binding ViewModel.ViewportLine}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    </Border>
                </DockPanel>
                <!-- brief-em3d-46 R-em3d46-4b — Array…: a popover, not a modal dialog (no gesture is in progress), with a live
                     preview through per-batch transforms. Accept writes independent copies as one undo entry. -->
                <Border IsVisible="{Binding ViewModel.ArrayOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Padding="10,8" CornerRadius="4" BorderThickness="1" Width="300"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Array" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="60,*,4,*,4,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="x" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="y" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="z" FontSize="11" Opacity="0.7"/>
                            <TextBlock Grid.Row="1" Text="Count" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.ArrayCountX}"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ViewModel.ArrayCountY}"/>
                            <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding ViewModel.ArrayCountZ}"/>
                            <TextBlock Grid.Row="2" Text="Pitch" VerticalAlignment="Center" ToolTip.Tip="In the display unit; a suffix (25um, 10mil) is honoured"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.ArrayPitchX}"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ViewModel.ArrayPitchY}"/>
                            <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding ViewModel.ArrayPitchZ}"/>
                        </Grid>
                        <TextBlock Text="{Binding ViewModel.ArrayError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.ArrayError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ViewModel.ArrayNote}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.ArrayNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding ViewModel.CloseArrayCommand}"/>
                            <Button Content="Accept" Command="{Binding ViewModel.AcceptArrayCommand}" Classes="accent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- brief-em3d-66 R-em3d66-2 — the Boolean panel: a popover like Array…, not a modal dialog. The camera stays free
                     and the preview is live and asynchronous: a busy mark while a request is outstanding, OK only once a reply is
                     drawn. One row per selected solid in selection order; exactly one is the Blank, every other a Tool. -->
                <Border IsVisible="{Binding ViewModel.BooleanOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Padding="10,8" CornerRadius="4" BorderThickness="1" Width="340"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding ViewModel.CancelBooleanCommand}"/>
                        <KeyBinding Gesture="Enter" Command="{Binding ViewModel.AcceptBooleanCommand}"/>
                    </Border.KeyBindings>
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ViewModel.BooleanTitle}" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="48" MinWidth="0" Height="4" VerticalAlignment="Center"
                                         IsVisible="{Binding ViewModel.BooleanBusy}" ToolTip.Tip="Previewing: OK waits for the result."/>
                        </Grid>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BooleanOps}" SelectedItem="{Binding ViewModel.BooleanOp}"
                                  HorizontalAlignment="Stretch"/>
                        <ItemsControl ItemsSource="{Binding ViewModel.BooleanRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dBooleanRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tip}" Margin="0,1">
                                        <RadioButton IsChecked="{Binding IsBlank}" Content="{Binding Role}" MinWidth="72"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Kind}" Opacity="0.6" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding MaterialText}" Opacity="0.75" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Swap" Command="{Binding ViewModel.SwapBooleanCommand}" IsVisible="{Binding ViewModel.BooleanCanSwap}"
                                HorizontalAlignment="Left" ToolTip.Tip="The Tool becomes the Blank, and the Blank the Tool."/>
                        <CheckBox Content="Keep tools" IsChecked="{Binding ViewModel.BooleanKeepTools}" IsEnabled="{Binding ViewModel.BooleanKeepToolsEnabled}"
                                  ToolTip.Tip="{x:Static t3:C3dEditorViewModel.BooleanKeepToolsTip}"/>
                        <TextBlock Text="{Binding ViewModel.BooleanKeeps}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ViewModel.BooleanNote}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.BooleanNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ViewModel.BooleanError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.BooleanError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding ViewModel.CancelBooleanCommand}"/>
                            <Button Content="OK" Command="{Binding ViewModel.AcceptBooleanCommand}" Classes="accent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- brief-em3d-67 R-em3d67-5b — the Fillet / Chamfer panel: brief 66's popover, reused. Not modal: while it is
                     open a click, a Shift-click or a double-click (a chain) in Edge mode edits the edge list. The size field
                     takes a number or an expression; a name nothing defines is offered as a VAR. OK only once a reply is drawn. -->
                <Border IsVisible="{Binding ViewModel.FilletOpen}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                        Padding="10,8" CornerRadius="4" BorderThickness="1" Width="320"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Border.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding ViewModel.CancelFilletCommand}"/>
                        <KeyBinding Gesture="Enter" Command="{Binding ViewModel.AcceptFilletCommand}"/>
                    </Border.KeyBindings>
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ViewModel.FilletTitle}" FontWeight="SemiBold"/>
                            <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="48" MinWidth="0" Height="4" VerticalAlignment="Center"
                                         IsVisible="{Binding ViewModel.FilletBusy}" ToolTip.Tip="Previewing: OK waits for the result."/>
                        </Grid>
                        <!-- No GroupName: a named group is shared by the whole window, and two 3D editors' pairs then unchecked each
                             other forever (a hang). Unnamed, the two group with each other only (RadioGroupNameGateTests). -->
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ViewModel.IsChamferPanel}">
                            <RadioButton Content="Equal distances" IsChecked="{Binding !ViewModel.ChamferTwoDistances}"/>
                            <RadioButton Content="Two distances" IsChecked="{Binding ViewModel.ChamferTwoDistances}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <TextBlock Text="{Binding ViewModel.FilletSizeLabel}" VerticalAlignment="Center" FontSize="11" Opacity="0.75"/>
                            <TextBox Grid.Column="1" Text="{Binding ViewModel.FilletSizeText}"
                                     ToolTip.Tip="A length, or an expression (r_edge, 2*t): a bare number is in the display unit."/>
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.FilletUnit}" VerticalAlignment="Center" FontSize="11" Opacity="0.75"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ViewModel.ChamferTwoDistances}">
                            <TextBlock Text="Distance 2" VerticalAlignment="Center" FontSize="11" Opacity="0.75"/>
                            <TextBox Grid.Column="1" Text="{Binding ViewModel.FilletSize2Text}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.FilletUnit}" VerticalAlignment="Center" FontSize="11" Opacity="0.75"/>
                            <ToggleButton Grid.Column="3" Content="Flip" IsChecked="{Binding ViewModel.ChamferFlip}"
                                          ToolTip.Tip="Which face the first distance is measured on; the note below says which."/>
                        </Grid>
                        <TextBlock Text="{Binding ViewModel.FilletSizePreview}" FontSize="11" Opacity="0.8"
                                   IsVisible="{Binding ViewModel.FilletSizePreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding ViewModel.HasFilletUnknown}">
                            <TextBlock Text="{Binding ViewModel.FilletUnknown, StringFormat='Define {0} ='}" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding ViewModel.FilletDefineValue}" PlaceholderText="50 um"/>
                            <Button Grid.Column="2" Content="Define" Command="{Binding ViewModel.DefineFilletNameCommand}"
                                    ToolTip.Tip="A VAR of this 3D view: one undo entry of its own."/>
                        </Grid>
                        <TextBlock Text="{Binding ViewModel.FilletEdgesText}" FontSize="11" Opacity="0.75"
                                   ToolTip.Tip="Shift-click in the view adds or removes an edge; double-click adds a tangent chain."/>
                        <ItemsControl ItemsSource="{Binding ViewModel.FilletEdgeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dFilletEdgeRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                        <SelectableTextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="×" Padding="5,0" Command="{Binding RemoveCommand}"
                                                ToolTip.Tip="Leave this edge unrounded."/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ViewModel.FilletNote}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.FilletNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding ViewModel.FilletError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                   IsVisible="{Binding ViewModel.FilletError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding ViewModel.CancelFilletCommand}"/>
                            <Button Content="OK" Command="{Binding ViewModel.AcceptFilletCommand}" Classes="accent"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- brief-em3d-45 R-em3d45-4 — the typed field: inline at the cursor, never a dialog. Tab moves between the
                     step's dimensions, Enter accepts the step, Esc returns to the mouse. An entry that does not parse stays,
                     red. The space under it is left for brief 51's Define strip. -->
                <Canvas>
                    <Border Canvas.Left="{Binding ViewModel.FieldX}" Canvas.Top="{Binding ViewModel.FieldY}" IsVisible="{Binding ViewModel.FieldOpen}"
                            Padding="6,4" CornerRadius="4" BorderThickness="1" MinWidth="170"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ViewModel.FieldLabel}" FontSize="11" Opacity="0.75"/>
                            <TextBox x:Name="FieldInput" Text="{Binding ViewModel.FieldText}" MinWidth="150"
                                     Classes.error="{Binding ViewModel.FieldError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <TextBlock Text="{Binding ViewModel.FieldError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap" MaxWidth="260"
                                       IsVisible="{Binding ViewModel.FieldError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- brief-em3d-51 R-em3d51-3b — the live preview: the value in the display unit, or what is unknown. -->
                            <TextBlock Text="{Binding ViewModel.FieldPreview}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" MaxWidth="260"
                                       IsVisible="{Binding ViewModel.FieldPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <!-- brief-em3d-51 R-em3d51-3c — the Define strip: one row per unknown name. Enter defines them all and
                                 takes the step; Esc returns to the field with its text. -->
                            <StackPanel Spacing="3" IsVisible="{Binding ViewModel.DefineOpen}" Margin="0,4,0,0">
                                <TextBlock Text="Define (Enter: define and continue, Esc: back to the field)" FontSize="11" Opacity="0.75"/>
                                <ItemsControl ItemsSource="{Binding ViewModel.DefineRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="t3:C3dDefineRow">
                                            <StackPanel Spacing="2" Margin="0,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="40"/>
                                                    <TextBlock Text="=" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding ValueText}" MinWidth="70" KeyDown="OnDefineKey"/>
                                                    <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.DefineUnits}" SelectedItem="{Binding Unit}" MinWidth="60" ItemTemplate="{StaticResource LowerUnit}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <RadioButton Content="VAR in this 3D view" IsChecked="{Binding !AsParameter}" FontSize="11"/>
                                                    <RadioButton Content="Cell parameter" IsChecked="{Binding AsParameter}" IsEnabled="{Binding CanBeParameter}" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Error}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ViewModel.DefineError}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap" MaxWidth="260"
                                           IsVisible="{Binding ViewModel.DefineError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>
                <!-- brief-dfr34-5 R-dfr34-5-2 — the pane's fault, with a way back that is not closing the view. -->
                <StackPanel x:Name="FaultPanel" IsVisible="False" Margin="24" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <SelectableTextBlock x:Name="FaultText" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <Button Content="Reconnect" Padding="8,2" HorizontalAlignment="Center"
                            Command="{Binding ViewModel.Viewer.ReconnectPaneCommand}"/>
                </StackPanel>
            </Panel>


            <!-- ── brief-em3d-51 R-em3d51-4a: the Variables panel — the VARs (name, expression, unit, value, link, uses), then the
                 cell's parameters, read-only. Every action is one undo entry. ── -->
            <Border Grid.Column="4" x:Name="VariablesPanel" Width="300" IsVisible="{Binding ViewModel.ShowVariables}" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <DockPanel>
                <!-- 3D editor bugs round 6 — the left edge is a grip, as the object tree's right edge is. Not saved. -->
                <Thumb DockPanel.Dock="Left" x:Name="VariablesGrip" Classes="panelGrip" Width="6" Cursor="SizeWestEast"
                       DragDelta="OnVariablesGripDrag" ToolTip.Tip="Drag to resize the Variables panel"/>
                <ScrollViewer Padding="2,6,8,6">
                    <StackPanel Spacing="6" DataContext="{Binding ViewModel.Variables}" x:DataType="t3:C3dVariablesViewModel">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dVariableRow">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="0,4">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ValueText}" Opacity="0.85"/>
                                                <TextBlock Text="{Binding UsesText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LinkText}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                                       IsVisible="{Binding LinkText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <Grid ColumnDefinitions="*,4,70">
                                                <TextBox Grid.Column="0" Text="{Binding EditExpression}" KeyDown="OnVariableKey"
                                                         ToolTip.Tip="The value or expression. A linked VAR's is the cell parameter's default: editing it writes the .ccell."/>
                                                <ComboBox Grid.Column="2" ItemsSource="{x:Static t3:C3dVariablesViewModel.UnitChoices}" SelectedItem="{Binding EditUnit}" ItemTemplate="{StaticResource LowerUnit}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" Foreground="IndianRed" FontSize="11" TextWrapping="Wrap"
                                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <!-- 3D editor bugs round 6 — glyphs, Delete last. Delete is disabled while anything uses the VAR, and
                                                 its tooltip says what: the refusal it used to write below the rows went unseen once they scrolled. -->
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="2" LineSpacing="4">
                                                <Button Classes="varGlyph" Click="OnVariableSet" ToolTip.Tip="Set">
                                                    <mi:MaterialIcon Kind="Check"/>
                                                </Button>
                                                <TextBox Text="{Binding EditName}" MinWidth="70" FontSize="11" Margin="2,0" ToolTip.Tip="A new name; Rename rewrites every reference"/>
                                                <Button Classes="varGlyph" Click="OnVariableRename" ToolTip.Tip="Rename">
                                                    <mi:MaterialIcon Kind="FormTextbox"/>
                                                </Button>
                                                <Button Classes="varGlyph" Click="OnVariableInline" ToolTip.Tip="Inline its value, then delete">
                                                    <mi:MaterialIcon Kind="Numeric"/>
                                                </Button>
                                                <Button Classes="varGlyph" Click="OnVariableLink" IsVisible="{Binding CanLink}" ToolTip.Tip="Link to the cell parameter">
                                                    <mi:MaterialIcon Kind="LinkVariant"/>
                                                </Button>
                                                <Button Classes="varGlyph" Click="OnVariableUnlink" IsVisible="{Binding CanUnlink}" ToolTip.Tip="Unlink from the cell parameter">
                                                    <mi:MaterialIcon Kind="LinkVariantOff"/>
                                                </Button>
                                                <Button Classes="varGlyph" Click="OnVariablePromote" IsVisible="{Binding CanPromote}" ToolTip.Tip="Promote to cell parameter">
                                                    <mi:MaterialIcon Kind="ArrowUpBoldBoxOutline"/>
                                                </Button>
                                                <Button Classes="varGlyph" Click="OnVariableDelete" IsEnabled="{Binding CanDelete}" ToolTip.Tip="{Binding DeleteTip}" ToolTip.ShowOnDisabled="True">
                                                    <mi:MaterialIcon Kind="Delete"/>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Add a VAR" FontSize="11" Opacity="0.7"/>
                        <TextBlock Text="{Binding UnknownText}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                                   IsVisible="{Binding UnknownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Grid ColumnDefinitions="70,4,*,4,70">
                            <TextBox Grid.Column="0" Text="{Binding NewName}" PlaceholderText="name" KeyDown="OnNewVariableKey"/>
                            <TextBox Grid.Column="2" Text="{Binding NewExpression}" PlaceholderText="value or expression" KeyDown="OnNewVariableKey"
                                     ToolTip.Tip="Enter or + adds it."/>
                            <ComboBox Grid.Column="4" ItemsSource="{x:Static t3:C3dVariablesViewModel.UnitChoices}" SelectedItem="{Binding NewUnit}" ItemTemplate="{StaticResource LowerUnit}"/>
                        </Grid>
                        <Button Classes="varGlyph" Click="OnVariableAdd" ToolTip.Tip="Add">
                            <mi:MaterialIcon Kind="Plus"/>
                        </Button>
                        <SelectableTextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                                             IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="Cell parameters (edit them in the cell's parameter editor)" FontSize="11" Opacity="0.7"
                                   IsVisible="{Binding InCell}"/>
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="t3:C3dVariableRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Expression}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding Unit}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding ValueText}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding UsesText}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
