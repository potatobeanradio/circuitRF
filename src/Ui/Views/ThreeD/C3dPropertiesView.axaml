<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="using:CircuitRF.Ui.ThreeD"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:apv="using:CircuitRF.Ui.Views.Appearance"
             x:Class="CircuitRF.Ui.Views.ThreeD.C3dPropertiesView"
             x:DataType="t3:C3dPropertiesViewModel">

    <!-- brief-em3d-43 R-em3d43-6b — a 3D view's selection, in the document's display unit. 3D editor round 1: hosted by the
         application's Properties Inspector (the dock panel a schematic and a layout use), not by a panel of the editor's own. -->
    <UserControl.Styles>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="IndianRed"/>
        </Style>
        <!-- A point list's held coordinate (a sheet's normal): shown, dimmed, not typed. -->
        <Style Selector="TextBox.dim[IsReadOnly=True]">
            <Setter Property="Opacity" Value="0.55"/>
        </Style>
        <!-- 3D editor round 4 — a dimension's box: narrow enough for x, y and z to share a line. -->
        <Style Selector="TextBox.dim">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="8,6">
            <SelectableTextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>

            <!-- brief-em3d-101 R-em3d101-9d — an image mapped onto a face: its own section, every edit one undo entry. Its
                 Transparency is its OWN, never its object's. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasFaceImage}">
                <TextBlock Text="{Binding FaceImageTitle}" FontSize="11" Opacity="0.7"/>
                <TextBlock Text="{Binding FaceImageProblem}" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding FaceImageProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding FaceImageFile}" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse…" FontSize="11" Padding="8,3" Command="{Binding BrowseFaceImageCommand}"/>
                    <Button Grid.Column="2" Content="Reveal" FontSize="11" Padding="8,3" Command="{Binding RevealFaceImageCommand}"/>
                </Grid>
                <TextBlock FontSize="11" Opacity="0.8" Text="{Binding FaceImagePixels, StringFormat='Pixels: {0}'}"/>
                <TextBlock Text="Transparency" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <Slider x:Name="FaceImageTransparencySlider" Grid.Column="0" Minimum="0" Maximum="{x:Static t3:C3dPropertiesViewModel.TransparencyMax}"
                            Value="{Binding FaceImageTransparencySlider}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <!-- As tall as its text, as the object's Transparency box is: without the centre alignment it stretched to the
                         slider's row. -->
                    <TextBox Grid.Column="1" Classes="dim" Width="44" VerticalAlignment="Center" Text="{Binding FaceImageTransparencyText}" PlaceholderText="0"
                             KeyDown="OnFaceImageTransparencyKey" LostFocus="OnFaceImageTransparencyLostFocus"/>
                    <Button Grid.Column="2" Content="Default" FontSize="11" Padding="8,3" VerticalAlignment="Center" Command="{Binding FaceImageDefaultTransparencyCommand}"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Grid.Column="0" Text="Rotation °" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Classes="dim" Text="{Binding FaceImageRotation}" KeyDown="OnFaceImageRotationKey" LostFocus="OnFaceImageRotationLostFocus"/>
                    <Button Grid.Column="2" Content="⟲ 90°" FontSize="11" Padding="6,3" Command="{Binding FaceImageRotateLeftCommand}"/>
                    <Button Grid.Column="3" Content="⟳ 90°" FontSize="11" Padding="6,3" Command="{Binding FaceImageRotateRightCommand}"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                    <TextBlock Grid.Column="0" Text="Width" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Classes="dim" Text="{Binding FaceImageWidth}" PlaceholderText="fitted" KeyDown="OnFaceImageWidthKey" LostFocus="OnFaceImageWidthLostFocus"/>
                    <TextBlock Grid.Column="2" Text="Height" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Classes="dim" Text="{Binding FaceImageHeight}" PlaceholderText="fitted" KeyDown="OnFaceImageHeightKey" LostFocus="OnFaceImageHeightLostFocus"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                    <TextBlock Grid.Column="0" Text="Offset right" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Classes="dim" Text="{Binding FaceImageOffsetRight}" KeyDown="OnFaceImageOffsetKey" LostFocus="OnFaceImageOffsetLostFocus"/>
                    <TextBlock Grid.Column="2" Text="up" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Classes="dim" Text="{Binding FaceImageOffsetUp}" KeyDown="OnFaceImageOffsetKey" LostFocus="OnFaceImageOffsetLostFocus"/>
                </Grid>
                <TextBlock Text="{Binding FaceImageError}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                           IsVisible="{Binding FaceImageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Keep aspect" IsChecked="{Binding FaceImageKeepAspect}"/>
                    <Button Content="Fit to Face" FontSize="11" Padding="8,3" Command="{Binding FitFaceImageCommand}"
                            ToolTip.Tip="As large as fits in the face, centred, its aspect kept; no offset."/>
                </StackPanel>
                <CheckBox Content="Hidden" IsChecked="{Binding FaceImageHidden}" ToolTip.Tip="Saved with the document; the face is drawn as before."/>
                <Button Content="Remove Image" FontSize="11" Padding="8,3" Command="{Binding RemoveFaceImageCommand}"
                        ToolTip.Tip="The image comes off the face; the face is drawn as before."/>
            </StackPanel>

            <!-- brief-em3d-101 R-em3d101-3b — an image sheet's Image section, above the sheet's own rows. Each edit is one undo entry;
                 its transparency is the Transparency row below (one knob: the image IS the sheet's surface). -->
            <StackPanel Spacing="4" IsVisible="{Binding HasImage}">
                <TextBlock Text="Image" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBox Grid.Column="0" Text="{Binding ImageFile}" IsReadOnly="True" ToolTip.Tip="The stored path: relative to this .c3d inside its workspace, absolute outside it."/>
                    <Button Grid.Column="1" Content="Browse…" FontSize="11" Padding="8,3" Command="{Binding BrowseImageCommand}"
                            ToolTip.Tip="Point this sheet at another image file (one undo entry)."/>
                    <Button Grid.Column="2" Content="Reveal" FontSize="11" Padding="8,3" Command="{Binding RevealImageCommand}"/>
                </Grid>
                <TextBlock FontSize="11" Opacity="0.8" Text="{Binding ImagePixels, StringFormat='Pixels: {0}'}"/>
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="4">
                    <TextBlock Grid.Column="0" Text="Width" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Classes="dim" Text="{Binding ImageWidthText}" KeyDown="OnImageWidthKey" LostFocus="OnImageWidthLostFocus"/>
                    <TextBlock Grid.Column="2" Text="Height" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="3" Classes="dim" Text="{Binding ImageHeightText}" KeyDown="OnImageHeightKey" LostFocus="OnImageHeightLostFocus"/>
                    <TextBlock Grid.Column="4" Text="{Binding ImageUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding ImageSizeError}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                           IsVisible="{Binding ImageSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Keep aspect" IsChecked="{Binding ImageKeepAspect}" ToolTip.Tip="A change to one follows with the other."/>
                    <Button Content="Reset to Image Aspect" FontSize="11" Padding="8,3" Command="{Binding ResetImageAspectCommand}"
                            ToolTip.Tip="The height follows the width at the image's own pixel aspect."/>
                </StackPanel>
                <CheckBox Content="Locked" IsChecked="{Binding ImageLocked}"
                          ToolTip.Tip="A locked image stays selectable and editable here, but Move, Rotate, the gizmo and vertex moves are refused."/>
                <CheckBox Content="In front of faces" IsChecked="{Binding ImageInFront}"
                          ToolTip.Tip="Draw the image over any face lying on its plane — a picture placed on a solid's face. Off, it is an underlay: what is traced on its plane is drawn over it."/>
                <Button Content="Remove Image" FontSize="11" Padding="8,3" Command="{Binding RemoveSheetImageCommand}"
                        ToolTip.Tip="The sheet stays, an ordinary sheet: a traced reference becomes a real one."/>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding IsEditable}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="NameBox" Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Materials}" SelectedItem="{Binding Material}" HorizontalAlignment="Stretch"
                              PlaceholderText="{Binding MaterialPlaceholder}" IsEnabled="{Binding IsMaterialEditable}"/>
                    <Button Grid.Column="1" Content="Edit…" FontSize="11" Padding="8,3" VerticalAlignment="Stretch"
                            Command="{Binding EditMaterialsCommand}" IsEnabled="{Binding IsMaterialEditable}"
                            ToolTip.Tip="Open the Materials editor on this material: every property it states, and the technology's other materials — see, edit, duplicate or make one, then assign it."/>
                </Grid>
                <TextBlock Text="Role" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.Roles}" SelectedItem="{Binding Role}" HorizontalAlignment="Stretch"
                          PlaceholderText="{Binding RolePlaceholder}" IsEnabled="{Binding IsMaterialEditable}"
                          ToolTip.Tip="What the solver treats the object as. From material: the material decides."/>
                <!-- 3D editor round 3 — a bond wire has no placement: its points are world points (below). Round 4: the
                     placement origin is edited on its one line among the dimensions below, not twice. -->
                <StackPanel Spacing="4" IsVisible="{Binding IsPlaced}">
                    <TextBlock Text="Rotations, in order" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding RotateText}" PlaceholderText="z 30, x 90" KeyDown="OnRotateKey" LostFocus="OnRotateLostFocus"/>
                    <CheckBox IsChecked="{Binding MirrorX}" Content="Mirror x"/>
                </StackPanel>
            </StackPanel>

            <!-- brief-em3d-93 R-em3d93-4 — in the solve or not: an object, an instance, a group whole, a multi-selection, the
                 selected ports or a heat source. Indeterminate where the members differ; a click writes every one, one undo entry. -->
            <CheckBox Content="Model" IsVisible="{Binding HasModel}" IsChecked="{Binding ModelChecked}" IsThreeState="False"
                      ToolTip.Tip="{Binding ModelTip}"/>

            <!-- brief-sar-3 R-sar3-2 — a phantom's layers, outermost first: each one's material, one undo entry per choice. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPhantom}">
                <TextBlock Text="{Binding LayersHeader}" FontSize="11" Opacity="0.7"/>
                <ItemsControl ItemsSource="{Binding PhantomLayers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dPhantomLayerRow">
                            <Grid ColumnDefinitions="64,*" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11" SelectedItem="{Binding Material}"
                                          ItemsSource="{Binding $parent[UserControl].((t3:C3dPropertiesViewModel)DataContext).Materials}"
                                          PlaceholderText="No material: left out of the solve"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-66 R-em3d66-4 — a boolean: each field one undo entry, re-evaluated at once. An evaluation that
                 fails is not rolled back: the node carries the refusal, and undo is one keystroke away. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsBoolean}">
                <TextBlock Text="Operation" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BooleanOps}" SelectedItem="{Binding BooleanOperation}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding BooleanEditable}" ToolTip.Tip="{Binding BooleanTip}"/>
                <CheckBox IsChecked="{Binding BooleanEnabled}" Content="Enabled" IsEnabled="{Binding BooleanEditable}"
                          ToolTip.Tip="Unticked, the Blank and the Tools are objects of their own — drawn, edited and simulated — as Dissolve would write them."/>
                <CheckBox IsChecked="{Binding BooleanKeepTools}" Content="Keep tools" IsEnabled="{Binding BooleanKeepToolsEnabled}"
                          ToolTip.Tip="{x:Static t3:C3dEditorViewModel.BooleanKeepToolsTip}"/>
                <TextBlock Text="Blank" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding BooleanOperands}" SelectedItem="{Binding BooleanBlank}" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding BooleanEditable}"
                              ToolTip.Tip="The object the Tools act on. The boolean takes its name; the old Blank becomes a Tool."/>
                    <Button Grid.Column="1" Content="Swap" Margin="4,0,0,0" Command="{Binding SwapBooleanCommand}" IsVisible="{Binding BooleanCanSwap}"
                            ToolTip.Tip="The Tool becomes the Blank, and the Blank the Tool."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-67 R-em3d67-6b — a fillet's or chamfer's row: each field one undo entry, re-evaluated through the
                 client. An evaluation that fails is not rolled back: the row carries the refusal. Its size fields are the
                 dimension lines below (a number or an expression). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsFeature}">
                <CheckBox IsChecked="{Binding FeatureEnabled}" Content="Enabled" IsEnabled="{Binding FeatureEditable}"
                          ToolTip.Tip="Unticked, the solid elaborates unrounded — a cheap A/B for the simulation."/>
                <Button Content="Flip" Command="{Binding FlipChamferCommand}" IsVisible="{Binding FeatureCanFlip}" HorizontalAlignment="Left"
                        ToolTip.Tip="Measure the first distance on the edge's other face."/>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                    <TextBlock Text="Edges" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Show" Command="{Binding ShowFeatureEdgesCommand}"
                            ToolTip.Tip="Select them in the view (Edge mode)."/>
                    <Button Grid.Column="2" Content="Edit…" Command="{Binding EditFeatureEdgesCommand}" IsEnabled="{Binding FeatureEditable}"
                            ToolTip.Tip="{Binding FeatureTip}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding FeatureEdges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Remove" Command="{Binding RemoveFeatureCommand}" HorizontalAlignment="Left"
                        ToolTip.Tip="The solid returns unrounded, in its place and under its name. One undo entry."/>
            </StackPanel>

            <!-- 3D editor round 3 — a bond wire: its bonds, its section, and every point of its axis in world coordinates.
                 A point commits on Enter or lost focus (one undo entry); an end is re-seated on its pad's top as a drag's is. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsWire}">
                <Grid ColumnDefinitions="*,6,*">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Start bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireStartStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="End bond" FontSize="11" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.BondStyles}" SelectedItem="{Binding WireEndStyle}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Section" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dEditorViewModel.WireSections}" SelectedItem="{Binding WireSection}" HorizontalAlignment="Stretch"/>
                <!-- 3D editor round 4 — loop height and span, as a wBond or Layout wire offers them. -->
                <Grid ColumnDefinitions="Auto,*,8,Auto,*,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="Loop height:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding WireLoopHeight}" Classes="dim" PlaceholderText="no pad"
                             Classes.error="{Binding WireLoopHeightRefused}"
                             KeyDown="OnWireLoopHeightKey" LostFocus="OnWireLoopHeightLostFocus"
                             ToolTip.Tip="From the top of the lower pad to the top of the wire at its apex. Every x and y is kept; the rise above the feet scales. A number sets it once; an expression holds it, so the wire follows its variables; empty lets go and keeps the wire as it is."/>
                    <TextBlock Grid.Column="3" Text="Span:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="4" Text="{Binding WireSpan}" Classes="dim"
                             Classes.error="{Binding WireSpanRefused}"
                             KeyDown="OnWireSpanKey" LostFocus="OnWireSpanLostFocus"
                             ToolTip.Tip="Foot to foot, in plan. The end moves along the wire's direction and lands on the pad under it; the start stays. A number sets it once; an expression holds it, so the wire follows its variables; empty lets go and keeps the wire as it is."/>
                    <TextBlock Grid.Column="5" Text="{Binding LengthUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
                <SelectableTextBlock Text="{Binding WireShapeNotes}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                     IsVisible="{Binding WireShapeNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock Text="{Binding WireShapeErrors}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                                     IsVisible="{Binding WireShapeErrors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="Points (x, y, z)" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                           ToolTip.Tip="The wire's axis, start to end, in world coordinates: a number or an expression each. Each end sits on the top of its pad. +▲ and +▼ add a point on the curve through its neighbours; − removes one."/>
                <ItemsControl ItemsSource="{Binding WirePoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dWirePointRow">
                          <!-- brief-em3d-133 R-em3d133-1 — each coordinate a number or an expression, as every dimension is. -->
                          <StackPanel Spacing="1">
                            <Grid ColumnDefinitions="36,*,3,*,3,*,3,54" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding XField.Text}" Classes="dim" Padding="3,1" ToolTip.Tip="{Binding XField.Label}"
                                         Classes.error="{Binding XField.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="3" Text="{Binding YField.Text}" Classes="dim" Padding="3,1" ToolTip.Tip="{Binding YField.Label}"
                                         Classes.error="{Binding YField.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <TextBox Grid.Column="5" Text="{Binding ZField.Text}" Classes="dim" Padding="3,1" ToolTip.Tip="{Binding ZField.Label}"
                                         Classes.error="{Binding ZField.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                         KeyDown="OnWirePointKey" LostFocus="OnWirePointLostFocus"/>
                                <!-- Add a point above or below this one, on the curve through its neighbours; remove an interior one. -->
                                <Grid Grid.Column="7" ColumnDefinitions="18,18,18">
                                    <Button Grid.Column="0" Content="+▲" FontSize="9" Padding="0" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding CanAddAbove}" Click="OnWirePointAddAbove"
                                            ToolTip.Tip="Add a point between this one and the one above, on the smooth curve through the points around them."/>
                                    <Button Grid.Column="1" Content="+▼" FontSize="9" Padding="0" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding CanAddBelow}" Click="OnWirePointAddBelow"
                                            ToolTip.Tip="Add a point between this one and the one below, on the smooth curve through the points around them."/>
                                    <Button Grid.Column="2" Content="−" FontSize="11" Padding="0" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding CanRemove}" Click="OnWirePointRemove"
                                            ToolTip.Tip="Remove this point. The start and the end are bonded to their pads and stay."/>
                                </Grid>
                            </Grid>
                            <SelectableTextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="36,0,0,0"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Text="{Binding Errors}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap" Margin="36,0,0,0"
                                                 IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- A polygon sheet's, a prism's or a polyline's points, as the layout editor's Inspector lists a polygon's vertices:
                 world x, y, z in the display unit, each row committing on Enter or lost focus (one undo entry). Its OWN bounded,
                 scrolling list — a polygon of hundreds of points must not stretch the panel. The coordinate along a sheet's or
                 prism's normal is read-only: the point stays on its plane, and the Offset field moves the whole outline. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasOutlinePoints}">
                <TextBlock Text="{Binding OutlinePointsTitle}" FontSize="11" Opacity="0.7" Margin="0,4,0,0"
                           ToolTip.Tip="Each point in world coordinates. Type a number (a unit suffix may name another) and press Enter or leave the box. The last column is the edge to the next point."/>
                <ListBox ItemsSource="{Binding OutlinePoints}" MaxHeight="260"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="t3:C3dOutlineRingHeader">
                            <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold" Opacity="0.7" Margin="0,5,0,1"/>
                        </DataTemplate>
                        <DataTemplate DataType="t3:C3dOutlinePointRow">
                            <Grid ColumnDefinitions="22,*,3,*,3,*,46" Margin="0,1">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding X}" Classes="dim" Padding="3,1" IsReadOnly="{Binding XReadOnly}"
                                         KeyDown="OnOutlinePointKey" LostFocus="OnOutlinePointLostFocus"/>
                                <TextBox Grid.Column="3" Text="{Binding Y}" Classes="dim" Padding="3,1" IsReadOnly="{Binding YReadOnly}"
                                         KeyDown="OnOutlinePointKey" LostFocus="OnOutlinePointLostFocus"/>
                                <TextBox Grid.Column="5" Text="{Binding Z}" Classes="dim" Padding="3,1" IsReadOnly="{Binding ZReadOnly}"
                                         KeyDown="OnOutlinePointKey" LostFocus="OnOutlinePointLostFocus"/>
                                <TextBlock Grid.Column="6" Text="{Binding EdgeText}" FontSize="9" Opacity="0.6"
                                           VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </StackPanel>

            <!-- brief-em3d-47 R-em3d47-3e — Set Coordinates: the typed Vertex Move, world, in the display unit. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsVertexEditable}">
                <TextBlock Text="Set coordinates (x, y, z)" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,4,*,4,*">
                    <TextBox Grid.Column="0" Text="{Binding VertexX}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="2" Text="{Binding VertexY}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                    <TextBox Grid.Column="4" Text="{Binding VertexZ}" KeyDown="OnVertexKey" LostFocus="OnVertexLostFocus"/>
                </Grid>
            </StackPanel>

            <!-- A port drawn in the 3D view: its name, number and Z0, and its place on its plane. Lengths are in the .c3d's display
                 unit, shown to the right of each box (a suffix typed in the box may name another). Enter or leaving a box writes
                 it, one undo entry. -->
            <StackPanel Name="PortPage" Spacing="4" IsVisible="{Binding IsPortPage}" Grid.IsSharedSizeScope="True">
                <!-- The label column is shared with the Plane row's grid, so the boxes and the Plane picker start at one edge. -->
                <Grid RowDefinitions="Auto,4,Auto,4,Auto,4,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PortLabel"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="Name" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Name="PortNameBox" Grid.Row="0" Grid.Column="2" Text="{Binding PortName}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                    <TextBlock Grid.Row="2" Text="Number" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding PortNumber}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                    <!-- brief-hzn-11 R-hzn11-1 — a wave port's S referred to an impedance or to its own mode: a picker, never typed text.
                         Shown disabled on a port that cannot be normalised to its mode, so the rows below never move. -->
                    <TextBlock Grid.Row="4" Text="Reference" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{x:Static t3:C3dPropertiesViewModel.PortReferences}"
                              SelectedItem="{Binding PortReference}" IsEnabled="{Binding PortCanBeModeNormalised}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Impedance: the S-parameters are referred to the Z0 below. Mode: a wave port's S-parameters are normalised to its own mode's power wave, with nothing renormalised; the result file then states R 1, which is not an impedance. EMerge and Palace report it; a lumped port always has an impedance."/>
                    <TextBlock Grid.Row="6" Text="Z0" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding PortZ0}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"
                             IsEnabled="{Binding PortZ0Editable}" PlaceholderText="the port's mode"
                             ToolTip.Tip="Reference impedance: a number of ohms, or a complex one such as 25+j10."/>
                    <TextBlock Grid.Row="6" Grid.Column="4" Text="Ω" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Spacing="4" IsVisible="{Binding PortPlaceEditable}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PortLabel"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Plane" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="2" ItemsSource="{x:Static t3:C3dPropertiesViewModel.PortPlanes}" SelectedItem="{Binding PortPlane}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="The plane the port's sheet lies in. Changing it keeps the port's centre where it is, and its width and height."/>
                    </Grid>
                    <Grid ColumnDefinitions="*,4,28,10,*,4,28" RowDefinitions="Auto,2,Auto,6,Auto,2,Auto,6,Auto,2,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PortULabel, StringFormat='Centre {0}'}" FontSize="11" Opacity="0.7"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PortVLabel, StringFormat='Centre {0}'}" FontSize="11" Opacity="0.7"/>
                        <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding PortCentreU}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding PortCentreV}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                        <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding PortULabel, StringFormat='Width ({0})'}" FontSize="11" Opacity="0.7"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding PortVLabel, StringFormat='Height ({0})'}" FontSize="11" Opacity="0.7"/>
                        <TextBox Name="PortWidthBox" Grid.Row="6" Grid.Column="0" Text="{Binding PortWidth}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding PortHeight}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                        <TextBlock Grid.Row="6" Grid.Column="6" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding PortAtLabel, StringFormat='Plane at {0}'}" FontSize="11" Opacity="0.7"/>
                        <TextBox Grid.Row="10" Grid.Column="0" Text="{Binding PortAt}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"/>
                        <TextBlock Grid.Row="10" Grid.Column="2" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="8" Grid.Column="4" Text="Angle" FontSize="11" Opacity="0.7"/>
                        <TextBox Grid.Row="10" Grid.Column="4" Text="{Binding PortAngle}" KeyDown="OnPortKey" LostFocus="OnPortLostFocus"
                                 ToolTip.Tip="Degrees the port is turned about its centre, counter-clockwise seen from +z. A lumped port in the XY plane turns; each end must lie along a straight side of its copper."/>
                        <TextBlock Grid.Row="10" Grid.Column="6" Text="°" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- A component port: built from its part's pads, so its place follows the layout. What it states of its own — Z0
                 and its width across the gap — is the setup's entry for the part. Blank is the default. -->
            <StackPanel Name="ComponentPortPage" Spacing="4" IsVisible="{Binding IsComponentPortPage}">
                <Grid ColumnDefinitions="Auto,8,*,4,28" RowDefinitions="Auto,4,Auto">
                    <TextBlock Grid.Row="0" Text="Z0" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ComponentZ0}" PlaceholderText="50"
                             KeyDown="OnComponentPortKey" LostFocus="OnComponentPortLostFocus"
                             ToolTip.Tip="Reference impedance: a number of ohms, or a complex one such as 25+j10. Blank is 50 Ω."/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Ω" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="Width" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox Name="ComponentWidthBox" Grid.Row="2" Grid.Column="2" Text="{Binding ComponentWidth}" PlaceholderText="{Binding ComponentWidthPlaceholder}"
                             KeyDown="OnComponentPortKey" LostFocus="OnComponentPortLostFocus"
                             ToolTip.Tip="The port's width across its gap, centred where the pads put it. Blank is the width the part's two pads share."/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding LengthUnit}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- brief-hzn-12 — the active setup's incident plane wave: what its row or its arrows select. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPlaneWave}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="PlaneWaveNameBox" Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <CheckBox Content="Enabled" IsChecked="{Binding PlaneWaveEnabled}"
                          ToolTip.Tip="An enabled plane wave drives the 3D view's Driven setups instead of their ports; at most one is enabled, so enabling this one disables the others."/>
                <Grid ColumnDefinitions="Auto,6,*" RowDefinitions="Auto,4,Auto,4,Auto,4,Auto,4,Auto,4,Auto">
                    <TextBlock Grid.Row="0" Text="Direction" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PlaneWaveDirection}" KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus"
                             ToolTip.Tip="The way the wave travels, x, y, z: any length. 0, 0, -1 falls from above."/>
                    <TextBlock Grid.Row="2" Text="E-field" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding PlaneWaveEField}" KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus"
                             ToolTip.Tip="The wave's polarisation, x, y, z, at right angles to its direction."/>
                    <TextBlock Grid.Row="4" Text="E0 (V/m)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding PlaneWaveE0}" PlaceholderText="1" KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus"
                             ToolTip.Tip="The wave's peak amplitude. A cross-section does not depend on it."/>
                    <TextBlock Grid.Row="6" Text="{Binding LengthUnit, StringFormat='Phase origin ({0})'}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding PlaneWaveOrigin}" PlaceholderText="0, 0, 0" KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus"
                             ToolTip.Tip="Where the wave's phase is zero: x, y, z in the display unit (a suffix may name another)."/>
                    <TextBlock Grid.Row="8" Text="θ step (°)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding PlaneWaveThetaStep}" PlaceholderText="{x:Static t3:C3dPropertiesViewModel.PlaneWaveDefaultStep}"
                             KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus" ToolTip.Tip="The cross-section is read from θ 0 to 180° in this step."/>
                    <TextBlock Grid.Row="10" Text="φ step (°)" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="10" Grid.Column="2" Text="{Binding PlaneWavePhiStep}" PlaceholderText="{x:Static t3:C3dPropertiesViewModel.PlaneWaveDefaultStep}"
                             KeyDown="OnPlaneWaveKey" LostFocus="OnPlaneWaveLostFocus" ToolTip.Tip="… and from φ 0 to 360° in this step."/>
                </Grid>
                <TextBlock Text="{Binding PlaneWaveSolver}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}"
                           IsVisible="{Binding PlaneWaveSolver, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- 3D editor round 3 — what fills the air box: Air by default, Vacuum or any technology material by choice. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBoxRow}">
                <TextBlock Text="Material" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding AirBoxMaterials}" SelectedItem="{Binding AirBoxMaterial}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What fills the air box where no object is. Air by default; pick Vacuum for free space."/>
            </StackPanel>

            <!-- 3D editor round 1 — the air box: padding per axis as a share of the content's extent, and each face's boundary. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsAirBox}">
                <TextBlock FontSize="11" Opacity="0.7" Text="{Binding LengthUnit, StringFormat='Padding ({0}; or type 10 % for a share of the extent)'}"
                           TextWrapping="Wrap"
                           ToolTip.Tip="Each box shows how far that face stands from the geometry now, in the display unit; a smaller number shrinks the box on that side. A number ending in % is a share of the design's extent along that axis: 10 % on +X pads a tenth of its x-extent beyond its +X side."/>
                <Grid ColumnDefinitions="Auto,*,6,Auto,*,6,Auto,*" RowDefinitions="Auto,4,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="−X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PadXMinPercent}" ToolTip.Tip="{Binding PadXMinTip}" Tag="xmin" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="−Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding PadYMinPercent}" ToolTip.Tip="{Binding PadYMinTip}" Tag="ymin" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="−Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="0" Grid.Column="7" Text="{Binding PadZMinPercent}" ToolTip.Tip="{Binding PadZMinTip}" Tag="zmin" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="+X" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PadXMaxPercent}" ToolTip.Tip="{Binding PadXMaxTip}" Tag="xmax" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="+Y" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding PadYMaxPercent}" ToolTip.Tip="{Binding PadYMaxTip}" Tag="ymax" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Text="+Z" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Row="2" Grid.Column="7" Text="{Binding PadZMaxPercent}" ToolTip.Tip="{Binding PadZMaxTip}" Tag="zmax" PlaceholderText="—" KeyDown="OnPadKey" LostFocus="OnPadLostFocus"/>
                </Grid>
                <TextBlock Text="Faces" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                <ItemsControl ItemsSource="{Binding AirBoxFaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="t3:C3dAirBoxFaceRow">
                            <!-- Designer round 33 — the face's padding rule in full is the tooltip of that direction's padding
                                 box above (and of this row); the row prints it in a few words. -->
                            <Grid ColumnDefinitions="44,120,*" Margin="0,1" ToolTip.Tip="{Binding Tip}">
                                <TextBlock Grid.Column="0" Text="{Binding Face}" VerticalAlignment="Center"/>
                                <!-- brief-dfr34-2 R-dfr34-2-5 — the padding as a length and its rule ("30.6 mm — λ/4 at 2.45 GHz"). -->
                                <TextBlock Grid.Column="2" Text="{Binding Padding}" FontSize="11" Opacity="0.8" Margin="6,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static t3:C3dPropertiesViewModel.BoundaryKinds}"
                                          SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" FontSize="11">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static conv:Em3dBoundaryKindNameConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-75 R-em3d75-1c — a heat source, probe or mesh region: its name and its other fields (its
                 dimensions are the ordinary dimension lines below, expressions included). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsThermalPlace}">
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"
                         ToolTip.Tip="A measure names a probe by it; a setup names a heat source by it. Renaming rewrites both."/>
                <ItemsControl ItemsSource="{Binding ThermalFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="t3:C3dThermalTextField">
                            <StackPanel Margin="0,2" Spacing="1">
                                <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7"/>
                                <TextBox Text="{Binding Text}" PlaceholderText="{Binding Hint}" ToolTip.Tip="{Binding Hint}"
                                         IsVisible="{Binding !HasChoices}"
                                         KeyDown="OnThermalFieldKey" LostFocus="OnThermalFieldLostFocus"/>
                                <!-- a field of a few values (a lumped element's topology, a unit): picking one commits it -->
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text, Mode=OneWay}"
                                          IsVisible="{Binding HasChoices}" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Hint}"
                                          SelectionChanged="OnThermalFieldChoice"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- brief-em3d-90 R-em3d90-4 — a thermal boundary of the active thermal setup: each commit is right-click ▸ Thermal's
                 own write (one undo entry). Switching the kind keeps the other kind's values while the row stays selected. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsThermalBoundary}">
                <TextBlock Text="Kind" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.ThermalBoundaryKinds}" SelectedItem="{Binding BoundaryKind}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding BoundaryEditable}"
                          ToolTip.Tip="A fixed temperature, or convection to an ambient. Every face no boundary names is insulated."/>
                <StackPanel Spacing="4" IsVisible="{Binding BoundaryIsFixed}">
                    <TextBlock Text="T, °C" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryT}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="A number or an expression, in °C"/>
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding !BoundaryIsFixed}">
                    <TextBlock Text="h, W/(m²·K)" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryH}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="The heat transfer coefficient: a number or an expression"/>
                    <TextBlock Text="Ambient, °C" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding BoundaryAmbient}" IsEnabled="{Binding BoundaryEditable}" KeyDown="OnBoundaryKey" LostFocus="OnBoundaryLostFocus"
                             ToolTip.Tip="A number or an expression, in °C"/>
                </StackPanel>
                <TextBlock Text="Face" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <SelectableTextBlock Text="{Binding BoundaryFace}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="Select face" FontSize="11" Padding="8,3" Command="{Binding SelectBoundaryFaceCommand}"
                            ToolTip.Tip="Select the face this boundary lies on, in Face mode (B from the boundary in the view reaches it too)."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-83 R-em3d83-4 — a field plot: every field one undo entry. The Solution picker lists what the run
                 saved, by value; the Quantity picker only what the step offers. The phase controls at the foot are the view's. -->
            <StackPanel Spacing="4" IsVisible="{Binding IsFieldPlot}">
                <SelectableTextBlock Text="{Binding PlotProblem}" Foreground="{DynamicResource CrfWarningBrush}" TextWrapping="Wrap" FontSize="11"
                                     IsVisible="{Binding PlotProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <SelectableTextBlock Text="{Binding PlotStale}" Foreground="{DynamicResource CrfWarningBrush}" TextWrapping="Wrap" FontSize="11"
                                     IsVisible="{Binding PlotStale, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="Name" FontSize="11" Opacity="0.7"/>
                <TextBox Text="{Binding NameText}" KeyDown="OnNameKey" LostFocus="OnNameLostFocus"/>
                <TextBlock Text="Setup" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotSetups}" SelectedItem="{Binding PlotSetup}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="The setup whose run the plot reads. Active follows whichever setup is active when it is drawn."/>
                <TextBlock Text="Solver" FontSize="11" Opacity="0.7" IsVisible="{Binding PlotHasSolver}"/>
                <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotSolvers}" SelectedItem="{Binding PlotSolver}"
                          HorizontalAlignment="Stretch" IsVisible="{Binding PlotHasSolver}"
                          ToolTip.Tip="A setup that runs both solvers saves two sets of fields: which one this plot draws."/>
                <TextBlock Text="Solution" FontSize="11" Opacity="0.7"/>
                <!-- brief-dfr31-3 R-dfr31-3-4 — before the setup has run, one disabled row says what will appear here. -->
                <ComboBox ItemsSource="{Binding PlotSolutions}" SelectedItem="{Binding PlotSolution}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What the run saved: a frequency (driven), a mode (eigenmode), a terminal (static), a sweep point (thermal). The plot keeps the VALUE, so a run that saves more never moves it.">
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem" x:DataType="t3:C3dPlotSolutionChoice">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
                <StackPanel Spacing="2" IsVisible="{Binding PlotOtherOpen}">
                    <TextBlock Text="Other frequency, GHz — saved by the next run" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding PlotOtherText}" PlaceholderText="e.g. 6" KeyDown="OnPlotOtherKey"
                             ToolTip.Tip="Added to the setup's Save fields at, and this plot moved to it. The plot says it is missing until you Simulate again."/>
                </StackPanel>
                <!-- brief-em3d-100 R-em3d100-4 — the drive a driven field is shown at. Display only: the solve is linear, so it
                     rescales what is drawn, never needs a re-run and never marks a result stale. -->
                <StackPanel Spacing="4" IsVisible="{Binding PlotIsDriven}">
                    <TextBlock Text="Drive power" FontSize="11" Opacity="0.7"/>
                    <TextBox Text="{Binding PlotDriveText}" PlaceholderText="e.g. 10 W, 250 mW, 30 dBm"
                             KeyDown="OnPlotDriveKey" LostFocus="OnPlotDriveLostFocus"
                             ToolTip.Tip="{x:Static t3:C3dPropertiesViewModel.DrivePowerTip}"/>
                    <TextBlock Text="Referred to" FontSize="11" Opacity="0.7"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotDriveReferences}" SelectedItem="{Binding PlotDriveReferredTo}"
                              HorizontalAlignment="Stretch" ToolTip.Tip="{x:Static t3:C3dPropertiesViewModel.DriveReferredTip}"/>
                </StackPanel>
                <TextBlock Text="Quantity" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotQuantities}" SelectedItem="{Binding PlotQuantity}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="What is drawn — only what the solver's files hold is offered. Before the setup has run, what its run will offer, greyed until it has.">
                    <ComboBox.Styles>
                        <Style Selector="ComboBoxItem" x:DataType="t3:C3dPlotQuantityChoice">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
                <TextBlock Text="On" FontSize="11" Opacity="0.7"/>
                <ComboBox ItemsSource="{Binding PlotTargets}" SelectedItem="{Binding PlotTarget}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Where it is drawn: a cut on the plot's own plane; surfaces (the selected solid's faces, or the conductors for J_s; every exposed face for a temperature); or the faces it lists."/>
                <!-- The offset box is narrow so the slider shares its row: the slider sweeps the plane across the model, drawn
                     live, and writes on release. -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="4" IsVisible="{Binding PlotIsAxisClip}">
                    <TextBlock Text="Across" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotAxes}" SelectedItem="{Binding PlotAxis}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="The axis the plane is square to: the plot owns its plane, so two plots cut in two places."/>
                    <TextBox Grid.Column="2" Width="64" Text="{Binding PlotOffsetText}" Classes="dim" VerticalAlignment="Center"
                             KeyDown="OnPlotOffsetKey" LostFocus="OnPlotOffsetLostFocus"
                             ToolTip.Tip="{x:Static t3:C3dPropertiesViewModel.PlotOffsetTip}"/>
                    <TextBlock Grid.Column="3" Text="{Binding LengthUnit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <Slider x:Name="PlotOffsetSlider" Grid.Column="4" MinWidth="60" VerticalAlignment="Center"
                            Minimum="{Binding PlotOffsetMin}" Maximum="{Binding PlotOffsetMax}" Value="{Binding PlotOffsetSlider}"
                            SmallChange="{Binding PlotOffsetStep}" LargeChange="{Binding PlotOffsetStep}"
                            IsVisible="{Binding PlotHasOffsetRange}"
                            ToolTip.Tip="{x:Static t3:C3dPropertiesViewModel.PlotOffsetSliderTip}"/>
                </Grid>
                <!-- brief-dfr31-3 R-dfr31-3-1/2 — the plane is drawn in the view while this plot is selected; Through… puts it
                     through an object with one click. -->
                <!-- brief-dfr34-3 — a section through two points (Section Through…): the points, and the way back to an axis. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" IsVisible="{Binding PlotIsSection}">
                    <TextBlock Text="Section" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding PlotSectionText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                         ToolTip.Tip="The vertical plane through these two points, spanning the whole height. The plot's own axes are the distance along the line and z."/>
                    <Button Grid.Column="2" Content="Use an Axis" Command="{Binding PlotUseAxisCommand}" Padding="6,2"
                            ToolTip.Tip="Cut on an axis plane again instead of through the two points."/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding PlotIsClip}">
                    <ToggleButton Content="Through…" IsChecked="{Binding PlotThroughArmed}" IsVisible="{Binding PlotIsAxisClip}"
                                  ToolTip.Tip="Then click an object in the 3D view: the plane moves through its centre on this axis. Esc cancels."/>
                    <CheckBox IsChecked="{Binding PlotShowPlane}" Content="Always show the plane" VerticalAlignment="Center"
                              ToolTip.Tip="Draw the plane in the 3D view while this plot is not selected too. It is always drawn while the plot is selected."/>
                </StackPanel>
                <StackPanel Spacing="1" IsVisible="{Binding PlotIsFaces}">
                    <TextBlock Text="Faces" FontSize="11" Opacity="0.7"/>
                    <SelectableTextBlock Text="{Binding PlotFacesText}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !PlotIsTemperature}">
                    <CheckBox IsChecked="{Binding PlotDb}" Content="dB" ToolTip.Tip="Decibels: 20·log10 of a field strength, 10·log10 of a power or energy density; 40 dB below the top of the range"/>
                    <CheckBox IsChecked="{Binding PlotSmooth}" Content="Smooth"
                              ToolTip.Tip="Average each value over the cells meeting at a point, within one material: a smooth picture of a field solved cell by cell (Palace at element order 1). Never across a material's boundary, where the field really jumps."/>
                    <TextBlock Text="Top of range" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{x:Static t3:C3dPropertiesViewModel.PlotPercentiles}" SelectedItem="{Binding PlotPercentile}"
                              ToolTip.Tip="This percentile of the values drawn, so one singular edge does not wash out the picture. Beyond it, the end colour.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='{}{0} %'}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- brief-sar-6 R-sar6-5 -->
                <CheckBox IsChecked="{Binding PlotMip}" Content="Maximum-intensity projection" IsVisible="{Binding PlotCanMip}"
                          ToolTip.Tip="Each point of the plane shows the largest SAR on the line through it along the plane's axis, so the hottest tissue shows wherever it lies. The plane is drawn through the middle of the tissue."/>
                <CheckBox IsChecked="{Binding PlotFixRange}" Content="Fix range across the sweep" IsVisible="{Binding PlotIsTemperature}"
                          ToolTip.Tip="The colour range is the minimum and maximum over EVERY sweep point, so stepping the sweep never rescales. Off: each point its own true minimum and maximum."/>
                <!-- The view's: the phase animation — ONE clock for every drawn plot (brief-em3d-96). Not saved. -->
                <StackPanel Spacing="4" Margin="0,6,0,0" IsVisible="{Binding PlotIsDrawn}">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !PlotIsTemperature}">
                        <ToggleButton IsChecked="{Binding Viewer.FieldPlaying}" IsEnabled="{Binding Viewer.FieldCanAnimate}"
                                      ToolTip.Tip="Play the phase: Re{v·e^jφ} through one cycle (choose an animated quantity). One clock: every drawn plot animates with it, in step" ToolTip.ShowOnDisabled="True">
                            <TextBlock Text="▶ ❚❚"/>
                        </ToggleButton>
                        <Slider Width="120" Minimum="0" Maximum="360" Value="{Binding Viewer.FieldPhaseDegrees}"
                                IsEnabled="{Binding Viewer.FieldCanAnimate}" VerticalAlignment="Center" ToolTip.Tip="Phase φ, degrees — the view's, not saved. One clock: moving it here moves every drawn plot's φ"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !PlotIsTemperature}">
                        <NumericUpDown Value="{Binding Viewer.FieldLoopSeconds}" Minimum="0.2" Maximum="30" Increment="0.5" FormatString="0.#"
                                       IsEnabled="{Binding Viewer.FieldCanAnimate}" Width="100"
                                       ToolTip.Tip="Seconds per cycle on screen — a display choice, the same for every drawn plot; the frequency is the legend's"/>
                        <TextBlock Text="s / cycle" VerticalAlignment="Center" Opacity="0.7" FontSize="11"/>
                    </StackPanel>
                    <!-- Hidden while the plot's problem shows above: the view copies that problem into FieldText for its status
                         line, and the panel said it twice. -->
                    <SelectableTextBlock Text="{Binding Viewer.FieldText}" FontSize="11" Opacity="0.8" TextWrapping="Wrap">
                        <SelectableTextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="Viewer.FieldText" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                <Binding Path="PlotProblem" Converter="{x:Static StringConverters.IsNullOrEmpty}"/>
                            </MultiBinding>
                        </SelectableTextBlock.IsVisible>
                    </SelectableTextBlock>
                </StackPanel>
            </StackPanel>

            <SelectableTextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- brief-em3d-51 R-em3d51-4b — each named dimension: its expression and resolved value, editable as either.
                 3D editor round 4 — a vector's components share one line ("Size: x [ ] y [ ] z [ ]"), labels aligned. -->
            <ItemsControl ItemsSource="{Binding FieldRows}" IsVisible="{Binding FieldsVisible}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dDimensionRow">
                        <StackPanel Margin="0,2" Spacing="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimLabel"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DimUnit"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="t3:C3dDimensionField">
                                            <DockPanel Margin="0,0,4,0">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Axis, StringFormat='{}{0}:'}" FontSize="11" Opacity="0.7"
                                                           VerticalAlignment="Center" Margin="0,0,2,0"
                                                           IsVisible="{Binding Axis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                <TextBox Text="{Binding Text}" Classes="dim" ToolTip.Tip="{Binding Path}"
                                                         KeyDown="OnDimensionKey" LostFocus="OnDimensionLostFocus"
                                                         Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="11" Opacity="0.7" VerticalAlignment="Center"/>
                            </Grid>
                            <SelectableTextBlock Text="{Binding Notes}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"
                                                 IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <SelectableTextBlock Text="{Binding Errors}" FontSize="11" Foreground="IndianRed" TextWrapping="Wrap"
                                                 IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="t3:C3dPropertyRow">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7"/>
                            <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- How the selection LOOKS — Transparency and the appearance — comes last, after everything that defines what it IS
                 (owner's ordering: the viewing properties at the foot of the Inspector). -->
            <!-- brief-em3d-92 R-em3d92-3 — how see-through the selection is drawn, independent of its material's colour: an
                 object, an instance, a group whole (every member) or a multi-selection. The slider previews while dragged and
                 writes ONE undo entry on release; the box takes a whole number; Default clears it back to the kind's. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasTransparency}">
                <TextBlock Text="Transparency" FontSize="11" Opacity="0.7"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <Slider x:Name="TransparencySlider" Grid.Column="0" Minimum="0" Maximum="{x:Static t3:C3dPropertiesViewModel.TransparencyMax}"
                            Value="{Binding TransparencySlider}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                            ToolTip.Tip="How see-through it is drawn, percent. Drag to preview; the value is kept when you let go."/>
                    <!-- As tall as its text: without the compact class and a centre alignment it stretched to the slider's
                         row, about three lines high. -->
                    <TextBox Grid.Column="1" Width="92" Classes="dim" VerticalAlignment="Center"
                             Text="{Binding TransparencyText}" PlaceholderText="{Binding TransparencyPlaceholder}"
                             KeyDown="OnTransparencyKey" LostFocus="OnTransparencyLostFocus"
                             ToolTip.Tip="A whole number, percent. Empty shows the kind's default greyed, or 'mixed' where the selection differs."/>
                    <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Default" FontSize="11" Padding="8,3" Command="{Binding ResetTransparencyCommand}"
                            ToolTip.Tip="Draw it as its kind is drawn: a dielectric translucent, a conductor opaque."/>
                </Grid>
            </StackPanel>

            <!-- brief-em3d-108 R-em3d108-2 — the selection's appearance over its material's, under Transparency and for what Transparency
                 is shown for: each field its resolved value (stated ones plain, the rest greyed with where they come from), a slider
                 that previews while dragged and writes ONE undo entry on release, Like for plating, Clear override. -->
            <StackPanel Spacing="4" IsVisible="{Binding HasAppearance}">
                <TextBlock Text="Appearance" FontSize="11" Opacity="0.7"/>
                <apv:AppearanceEditorView DataContext="{Binding Appearance}"/>
            </StackPanel>
            <!-- An operand (a boolean's Blank or Tool, a kept Tool included) has no Appearance group: this says where its look comes
                 from instead of showing nothing, which read as a bug (owner-reported). -->
            <StackPanel Spacing="4" IsVisible="{Binding HasOperandLookNote}">
                <TextBlock Text="Appearance" FontSize="11" Opacity="0.7"/>
                <TextBlock Text="{Binding OperandLookNote}" FontSize="11" Opacity="0.8" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
