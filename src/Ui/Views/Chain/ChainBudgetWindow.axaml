<!-- The RF Chain Budget: a receive chain as a table of stages, each a System block with its own parameters, the system
     inputs above it, the chain drawn two ways (blocks, and the schematic it transfers to) and the cascade below,
     recomputed on every edit. Transfer to Schematic writes the chain's test benches and their Data Displays. Styled as the S-Parameter Viewer is: `pane` borders on the theme's chrome
     brushes, sentence-case headings. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.Chain"
        xmlns:chain="using:CircuitRF.Design.Chain"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:chv="using:CircuitRF.Ui.Views.Chain"
        xmlns:ddc="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:ctl="using:CircuitRF.Ui.Controls"
        x:Class="CircuitRF.Ui.Views.Chain.ChainBudgetWindow"
        x:DataType="vm:ChainBudgetViewModel"
        Title="{Binding Title}"
        Width="1300" Height="960" MinWidth="900" MinHeight="600"
        CanResize="True">

    <Window.Styles>
        <Style Selector="Border.pane">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="Margin"          Value="4"/>
        </Style>
        <Style Selector="TextBlock.panelhdr">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Opacity"           Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,4,0"/>
        </Style>
        <Style Selector="TextBox.p">
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="MinWidth"  Value="70"/>
            <Setter Property="Padding"   Value="4,2"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="ComboBox.p">
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="MinWidth"  Value="90"/>
            <Setter Property="Padding"   Value="4,1"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Border.block">
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Border.block.sel">
            <Setter Property="BorderBrush"     Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize"      Value="10.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tb">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin"  Value="0,0,4,0"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Toolbar: the file, the stage list, the transfer. -->
        <Border Classes="pane" DockPanel.Dock="Top">
            <WrapPanel>
                <Button Classes="tb" Command="{Binding NewCommand}" ToolTip.Tip="A new chain">New</Button>
                <Button Classes="tb" Command="{Binding OpenCommand}" ToolTip.Tip="Open a .cchain">Open…</Button>
                <Button Classes="tb" Command="{Binding SaveCommand}">Save</Button>
                <Button Classes="tb" Command="{Binding SaveAsCommand}">Save As…</Button>
                <Separator Width="16"/>
                <ComboBox Classes="p" ItemsSource="{x:Static vm:ChainStageViewModel.Parts}" SelectedItem="{Binding PartToAdd}"
                          MinWidth="210" Margin="0,0,4,0" ToolTip.Tip="The part the next stage is">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="chain:ChainPart"><TextBlock Text="{Binding Title}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="tb" Command="{Binding AddStageCommand}" ToolTip.Tip="Add a stage of this part after the selected one">Add Stage</Button>
                <Button Classes="tb" Command="{Binding RemoveStageCommand}">Remove</Button>
                <Button Classes="tb" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move the selected stage toward the input">Up</Button>
                <Button Classes="tb" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move the selected stage toward the output">Down</Button>
                <Separator Width="16"/>
                <Button Classes="tb" Name="TransferButton" Click="OnTransferClick"
                        ToolTip.Tip="Write the chain's 1-Tone, 2-Tone and Envelope test benches (and an array's Steering and Combiners benches), with their analyses and the budget's numbers beside the simulated ones, and a Data Display of each">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="TransferRight" Width="16" Height="16"/>
                        <TextBlock Text="Transfer to Schematic…"/>
                    </StackPanel>
                </Button>
                <Button Classes="tb" Click="OnHelpClick">Help</Button>
            </WrapPanel>
        </Border>

        <!-- The system inputs. -->
        <Border Classes="pane" DockPanel.Dock="Top">
            <WrapPanel>
                <TextBlock Classes="lbl" Text="Frequency, GHz"/>
                <TextBox Classes="p" Text="{Binding FrequencyGHz}" Margin="0,0,14,0" ToolTip.Tip="The input (RF) frequency"/>
                <TextBlock Classes="lbl" Text="Bandwidth, MHz"/>
                <TextBox Classes="p" Text="{Binding BandwidthMHz}" Margin="0,0,14,0" ToolTip.Tip="The noise bandwidth the floor, the MDS and the SNR are read in"/>
                <TextBlock Classes="lbl" Text="Input power, dBm"/>
                <TextBox Classes="p" Text="{Binding InputPowerDbm}" Margin="0,0,14,0" ToolTip.Tip="The signal at the input; in an array, at each element"/>
                <TextBlock Classes="lbl" Text="Source temperature, K"/>
                <TextBox Classes="p" Text="{Binding TemperatureK}" Margin="0,0,14,0" ToolTip.Tip="The source's (antenna's) noise temperature; 290 K is T0"/>
                <TextBlock Classes="lbl" Text="Required SNR, dB"/>
                <TextBox Classes="p" Text="{Binding RequiredSnrDb}" Margin="0,0,14,0" ToolTip.Tip="The SNR the demodulator needs: sensitivity is the MDS plus this"/>
                <TextBlock Classes="lbl" Text="Blockers"/>
                <TextBox Classes="p" Text="{Binding Blockers}" MinWidth="200" Watermark="offset MHz, level dBm; …"
                         ToolTip.Tip="Blockers at the input: an offset from the frequency (MHz when bare) and a level, dBm, separated by ';'. Each is carried through every stage's gain and every filter's rejection at its own frequency."/>
            </WrapPanel>
        </Border>

        <!-- The chain's totals, and anything the budget has to say. -->
        <Border Classes="pane" DockPanel.Dock="Bottom">
            <StackPanel Spacing="4">
                <TextBlock Classes="panelhdr" Text="Chain"/>
                <SelectableTextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/>
                <SelectableTextBlock Text="{Binding Refusals}" IsVisible="{Binding HasRefusals}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{DynamicResource CrfWarningBrush}"/>
                <SelectableTextBlock Text="{Binding Notes}" IsVisible="{Binding HasNotes}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid RowDefinitions="Auto,*,Auto">
            <!-- The chain, two ways, one selection. Blocks: an idealised block per stage with its System block's symbol, its
                 own numbers and the cascade at its output; an array's branch once, "× N", into one combiner block drawn
                 as its variant. Schematic: the chain itself, as Transfer to Schematic places it, drawn by circuitRF's own
                 schematic renderer with the same numbers over each stage; wheel to zoom, middle-drag to pan,
                 double-click to fit. A click on a block or a part selects its stage, in both and in the stage list. -->
            <Border Classes="pane" Grid.Row="0" Height="290">
                <TabControl Padding="0,4,0,0">
                    <TabItem Header="Blocks" FontSize="13">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="IN" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChainStageViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⟶" FontSize="18" VerticalAlignment="Center" Margin="4,0" Opacity="0.7"/>
                                                <Border Classes="block" Classes.sel="{Binding IsSelected}" PointerPressed="OnBlockPressed"
                                                        ToolTip.Tip="{Binding Part.Summary}">
                                                    <StackPanel Spacing="1" MinWidth="104">
                                                        <TextBlock Classes="small" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                                        <ItemsControl ItemsSource="{Binding Glyphs}" HorizontalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ChainBlockGlyph">
                                                                    <StackPanel Margin="1,0">
                                                                        <ctl:PaletteGlyphControl Kind="{Binding Kind}" Monochrome="True" Width="64" Height="40"/>
                                                                        <TextBlock Classes="small" Text="{Binding Caption}" IsVisible="{Binding HasCaption}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Classes="small" Text="{Binding TimesN}" FontSize="13" FontWeight="SemiBold"
                                                                   IsVisible="{Binding TimesN, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Classes="small" Text="{Binding Extra}" Opacity="0.8"
                                                                   IsVisible="{Binding Extra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Classes="small" Text="{Binding KeyLine}"/>
                                                        <TextBlock Classes="small" Text="{Binding CascadeLine}" Opacity="0.75"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="⟶  OUT" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Schematic" FontSize="13">
                        <chv:ChainSchematicCanvas Diagram="{Binding Diagram}" SelectedStage="{Binding SelectedStageIndex}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- The stages, one row each: name, part, the part's own parameters, and the stage's budget on its own. -->
            <Border Classes="pane" Grid.Row="1">
                <DockPanel>
                    <TextBlock Classes="panelhdr" DockPanel.Dock="Top" Text="Stages, input to output"/>
                    <ListBox ItemsSource="{Binding Stages}" SelectedItem="{Binding SelectedStage}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChainStageViewModel">
                                <Grid ColumnDefinitions="110,220,*" Margin="0,2">
                                    <TextBox Grid.Column="0" Classes="p" Text="{Binding Name}" VerticalAlignment="Top" ToolTip.Tip="The stage's name: its instance name on the schematic"/>
                                    <ComboBox Grid.Column="1" Classes="p" ItemsSource="{x:Static vm:ChainStageViewModel.Parts}" SelectedItem="{Binding Part}"
                                              Margin="6,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip.Tip="{Binding Part.Summary}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="chain:ChainPart"><TextBlock Text="{Binding Title}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChainParamViewModel">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,2" ToolTip.Tip="{Binding Tip}">
                                                        <TextBlock Classes="lbl" Text="{Binding Name}"/>
                                                        <TextBox Classes="p" Text="{Binding Value}" IsVisible="{Binding IsText}" Watermark="{Binding Watermark}"/>
                                                        <ComboBox Classes="p" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" IsVisible="{Binding HasOptions}"/>
                                                        <TextBlock Classes="lbl" Text="{Binding Unit}" Margin="3,0,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The cascade, the levels node by node and a canceller's depth, as Data Display plots over the budget's own
                 data: the cascade table over the stage axis; the levels over the node axis (0 the input, k stage k's
                 output), with the transferred benches' simulated points once they have run, and a marker on a trace
                 selecting that node's stage; and the depth a canceller's errors leave, in closed form. -->
            <Border Classes="pane" Grid.Row="2" Height="280">
                <TabControl Padding="0,4,0,0">
                    <TabItem Header="Cascade" FontSize="13">
                        <ddc:PlotControl Name="CascadePlotControl" ClipToBounds="True"
                                         Plot="{Binding CascadePlot}" Library="{Binding PlotHost.Library}"
                                         CanDeletePlot="False" CanEditPlotProperties="False"/>
                    </TabItem>
                    <TabItem Header="Levels" FontSize="13">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding LevelsNote}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,4,*">
                                <ddc:PlotControl Grid.Column="0" Name="LevelsPlotControl" ClipToBounds="True"
                                                 Plot="{Binding LevelsPlot}" Library="{Binding PlotHost.Library}"
                                                 CanDeletePlot="False" CanEditPlotProperties="False"/>
                                <ddc:PlotControl Grid.Column="2" Name="LevelsDbPlotControl" ClipToBounds="True"
                                                 Plot="{Binding LevelsDbPlot}" Library="{Binding PlotHost.Library}"
                                                 CanDeletePlot="False" CanEditPlotProperties="False"/>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Canceller" FontSize="13" IsVisible="{Binding HasCanceller}">
                        <Grid ColumnDefinitions="*,4,*">
                            <ddc:PlotControl Grid.Column="0" Name="DepthPhasePlotControl" ClipToBounds="True"
                                             Plot="{Binding DepthPhasePlot}" Library="{Binding PlotHost.Library}"
                                             CanDeletePlot="False" CanEditPlotProperties="False"/>
                            <ddc:PlotControl Grid.Column="2" Name="DepthBandPlotControl" ClipToBounds="True"
                                             Plot="{Binding DepthBandPlot}" Library="{Binding PlotHost.Library}"
                                             CanDeletePlot="False" CanEditPlotProperties="False"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
