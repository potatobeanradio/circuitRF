<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.ParameterEditor.ParameterEditorView"
             x:DataType="vm:ParameterEditorViewModel"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Styles>
        <!-- SL3/MW2: the warning role for a notice band. Defined locally because a UserControl's
             Classes.<name> binding needs a style in scope — without one the class attaches and paints
             nothing, which is a notice the user never sees. -->
        <Style Selector=":is(TextBlock).warn">
            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Empty-state overlay: spans all rows, shown when IsEmptyState -->
        <TextBlock Grid.Row="0" Grid.RowSpan="5"
                   IsVisible="{Binding IsEmptyState}"
                   Text="{Binding EmptyMessage}"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Opacity="0.5"/>

        <!-- ── Row 0: Header — type label + editable instance name, and (SL3) the
                 interface-changed notice directly beneath it ──────────────────── -->
        <StackPanel Grid.Row="0" IsVisible="{Binding IsNotEmptyState}" Spacing="0">
        <Grid ColumnDefinitions="Auto,*"
              Margin="6,6,6,4">
            <TextBlock Grid.Column="0"
                       Text="{Binding TypeDisplayName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     x:Name="InstanceNameBox"
                     Text="{Binding StagedInstanceName}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     LostFocus="OnInstanceNameLostFocus"
                     KeyDown="OnInstanceNameKeyDown"/>
        </Grid>

        <!-- SL3 R-sl3-9/-10: the cell this instance references changed shape underneath it. The
             glyph on the canvas is the librarian's new symbol and it is correct — what is marked is
             that the design may no longer mean what it did. Accepting is one explicit gesture, and
             never happens on open, on save, or as a side effect of any edit (R-sl3-10). -->
        <Border IsVisible="{Binding HasInterfaceChanged}"
                Margin="6,0,6,4" Padding="6,4" CornerRadius="3"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding InterfaceChangedNoticeText}" FontSize="11" TextWrapping="Wrap"
                           Classes="warn"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Accept new interface" FontSize="11" Padding="6,2"
                            Command="{Binding AcceptNewInterfaceCommand}"/>
                    <Button Content="…for every instance" FontSize="11" Padding="6,2"
                            Command="{Binding AcceptNewInterfaceEverywhereCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TM2 R-tm2-12/-13/-14: the cell this instance references has MOVED, and the reference
             resolved through the owning root's .cmoves forwarding record. Deliberately NOT the "warn"
             class the band above uses — an expected, correct state that happens to be worth
             mentioning must not be coloured like a problem, or users learn to ignore the colour that
             also marks real breakage. Adopting is one explicit gesture and never automatic. -->
        <Border IsVisible="{Binding HasMovedCell}"
                Margin="6,0,6,4" Padding="6,4" CornerRadius="3"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding MovedNoticeText}" FontSize="11" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Content="Update references" FontSize="11" Padding="6,2"
                            Command="{Binding UpdateReferencesCommand}"/>
                    <Button Content="…for every instance" FontSize="11" Padding="6,2"
                            Command="{Binding UpdateReferencesEverywhereCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- ── Row 1: Label-visibility flags ──────────────────────────────── -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="6,0,6,4">
            <CheckBox IsChecked="{Binding ShowTypeLabel}"
                      Content="Type label"
                      FontSize="11"/>
            <CheckBox IsChecked="{Binding ShowInstanceName}"
                      Content="Instance name"
                      FontSize="11"/>
            <!-- MKlopf entry-mode switch: Z1/Z2 <-> W1/W2, L <-> F3db (converts, never resets) -->
            <Button Content="{Binding MklopfImpedanceToggleLabel}"
                    IsVisible="{Binding IsMklopfTarget}"
                    FontSize="10"
                    Padding="6,2"
                    ToolTip.Tip="Switch between impedance (Z1/Z2) and width (W1/W2) entry — converts the current design to the equivalent values, it does not reset it"
                    Command="{Binding ToggleMklopfImpedanceEntryCommand}"/>
            <Button Content="{Binding MklopfLengthToggleLabel}"
                    IsVisible="{Binding IsMklopfTarget}"
                    FontSize="10"
                    Padding="6,2"
                    ToolTip.Tip="Switch between length (L) and 3dB-cutoff-frequency (F3db) entry — converts the current design to the equivalent value, it does not reset it"
                    Command="{Binding ToggleMklopfLengthEntryCommand}"/>
        </StackPanel>

        <!-- ── Row 2: Scrollable parameter list ───────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      IsVisible="{Binding IsNotEmptyState}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- A vertical StackPanel, NOT a Panel, and the difference is a shipped bug.
                 A Panel gives every child the whole area, which was harmless while SnP was the only
                 custom panel — it REPLACES the generic rows (`IsVisible="{Binding !IsSnp}"`). The wBond
                 panel shows BESIDE them (Temp stays an ordinary row), so on a Panel it
                 painted straight over them: the owner's "the Add button and some other text render
                 overtop of the parameters fields". Hidden children take no space in a StackPanel, so
                 SnP's replace-the-rows arrangement is unchanged. -->
            <StackPanel>
                <!-- ══ wBond custom panel ═══════════════════════════════════════════════════
                     Above the generic rows, deliberately — see their own note below.

                     Four of a wBond's parameters are not text and were showing as text: `Design` is
                     the base64 of the entire wirebond design (the owner's "gibberish" — documented
                     as HIDDEN in wbond.md §5.0), `Arrays` is drift-detection bookkeeping (also
                     hidden), and the other two want the controls SnP's equivalents already have.
                     They are filtered out of the generic rows above; this is where they live.
                     `GroundPlane` joined them on 2026-08-17 — a boolean, so a picker. `Temp` is an
                     ordinary engine value and stays a generic row. -->
                <!-- ══ Match compact panel (match.md §9.8) ═══════════════════════════════
                     A READOUT and one button, not a half-editor. A matching network's parameters are
                     a band, two terminations and a rack of linked sliders; none of that fits in a
                     420 px column of text rows, and a second place to type them is how the design and
                     the label come to disagree. The `Design` blob is filtered out of the generic rows
                     above (IsMatchPanelParameter); the ECHO rows stay, because they are what a
                     user reads on the schematic page itself. -->
                <StackPanel IsVisible="{Binding IsMatch}" Margin="6,4" Spacing="4">
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Band" FontSize="11"/>
                        <!-- The band line shows the EFFECTIVE bands of match.md §18.3; when
                             symmetrisation moved one of them, the tooltip carries the requested pair
                             and the reason, so the line stays one line and nothing is hidden. -->
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                             TextWrapping="Wrap"
                                             Text="{Binding MatchBandSummary}"
                                             ToolTip.Tip="{Binding MatchBandTooltip}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Network" FontSize="11"/>
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                             Text="{Binding MatchOrderSummary}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Term 1" FontSize="11"/>
                        <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                             Text="{Binding MatchTerm1Summary}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Term 2" FontSize="11"/>
                        <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                             Text="{Binding MatchTerm2Summary}"/>
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="3">
                            <TextBlock Text="Match" FontSize="11"/>
                            <!-- One glyph, two states: a refusal and an unreached Π N² are both things
                                 to act on, and a user reading a match summary needs the same warning
                                 for either. -->
                            <TextBlock Text="⚑" FontSize="11"
                                       Foreground="{DynamicResource CrfWarningBrush}"
                                       IsVisible="{Binding MatchNeedsAttention}"/>
                        </StackPanel>
                        <SelectableTextBlock Grid.Row="4" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                             Text="{Binding MatchReturnLossSummary}"/>
                    </Grid>

                    <TextBlock Text="{Binding MatchPayloadError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               IsVisible="{Binding MatchPayloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <Button Content="Open Match Designer…"
                            HorizontalAlignment="Right"
                            FontSize="11" Padding="8,3"
                            Command="{Binding OpenMatchDesignerCommand}"
                            ToolTip.Tip="Band, terminations, order, response, the ladder, its response, and the Norton-transform sliders"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsWBond}"
                            Margin="6,4"
                            Spacing="8">

                    <!-- What this component IS, at a glance — the same one-line summary the symbol
                         body carries. This is what replaces the unreadable `Design` row: the payload
                         is machine-written and there is nothing in it to type, but "how much wire is
                         in here" is exactly what the row was failing to answer. -->
                    <!-- Two ROWS, not two columns (owner, 2026-08-17: the summary and the button
                         "render overtop of each other if the text string gets too long").

                         The summary is generated text whose length is not bounded by anything — it
                         grows with the array count and gains "· with overrides" — so any share of one
                         row is a share it will eventually outgrow. Giving it the whole row and putting
                         the button on the next one removes the competition rather than tuning it. The
                         button keeps its right edge, so it still lines up with the arrays' own Add
                         button below. -->
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Design"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                             Text="{Binding WBondSummary}"
                                             FontSize="11" VerticalAlignment="Center"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <!-- Update Layout — directly under the design summary and above the arrays'
                             own Add button (owner, 2026-08-17): "here is what this component is" and
                             "put it in the layout" are one thought, and the two buttons line up in the
                             same column. Narrower than Design ▸ Update Layout from Schematic: it
                             writes THIS wBond and nothing else, so no other instance moves under the
                             user while they are editing wires. Absent with no workspace to write into,
                             rather than present and only able to refuse. -->
                        <Button Grid.Row="1" Grid.Column="1" Content="Update Layout"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Right"
                                FontSize="11" Padding="8,3"
                                IsVisible="{Binding CanUpdateWBondLayout}"
                                Command="{Binding UpdateWBondLayoutCommand}"
                                ToolTip.Tip="Write this wBond's wires into the cell's layout and open it — this component only, and closes this dialog"/>
                    </Grid>

                    <!-- An unreadable payload is a reported, repairable state — never an empty panel
                         that reads as "this component has nothing in it". -->
                    <TextBlock Text="{Binding WBondPayloadError}"
                               IsVisible="{Binding WBondPayloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource CrfWarningBrush}"/>

                    <!-- ── The arrays ───────────────────────────────────────────────────────
                         An array IS a port: its name is the pin-pair name, and its position is the
                         pin-pair position. That is why this list is the one place the array list
                         should ever be edited from the schematic — and why reordering is deliberately
                         NOT offered here: pin order is array order, so a reorder moves every pin
                         while its name moves to a different row, which is the silent re-pointing
                         wbond.md §9.2/WB35a exists to prevent. -->
                    <Grid ColumnDefinitions="80,*,Auto">
                        <TextBlock Grid.Column="0" Text="Arrays"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Each array is one port: a + terminal left, a − terminal right."
                                   FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <Button Grid.Column="2" Content="Add"
                                FontSize="11" Padding="8,3"
                                Command="{Binding AddWBondArrayCommand}"
                                ToolTip.Tip="Add a wire array — a new pin pair on the symbol, carrying one wire to move into place"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WBondArrays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WBondArrayEditRow">
                                <!-- No pin-name column. "G1.i / G1.o" was an internal spelling of
                                     "this array's + and − terminals" and told the user nothing they
                                     needed (owner, 2026-08-17) — the terminals are on the symbol,
                                     where they are actually wired up.

                                     Column 0 stays as an EMPTY 80px gutter: every other row in this
                                     panel (Design, Arrays, Symbol Pitch) puts its label there, so the
                                     name boxes line up under their values instead of hanging out to
                                     the left of them. -->
                                <Grid ColumnDefinitions="80,*,Auto,Auto" Margin="0,0,0,3">
                                    <!-- Committed on Enter or lost focus, never per keystroke: a
                                         half-typed name is routinely blank or a duplicate, and both
                                         are refused, so committing per character would fight the
                                         user for the box. -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Name, Mode=TwoWay}"
                                             FontSize="11" Padding="4,3"
                                             VerticalAlignment="Center"
                                             LostFocus="OnWBondArrayNameCommit"
                                             KeyDown="OnWBondArrayNameKeyDown"
                                             ToolTip.Tip="The array's name — this is the pin name on the symbol"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding WiresText}"
                                               FontSize="10" VerticalAlignment="Center"
                                               Margin="8,0,4,0"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                    <Button Grid.Column="3" Content="✕"
                                            FontSize="10" Padding="5,1" Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding $parent[ItemsControl].((vm:ParameterEditorViewModel)DataContext).CanRemoveWBondArray, FallbackValue=False}"
                                            Command="{Binding $parent[ItemsControl].((vm:ParameterEditorViewModel)DataContext).RemoveWBondArrayCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Remove this array AND every wire in it"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── §5.5.1/WB44: the controlling parameters ─────────────────────────
                         These are NOT the geometry — the 3D coordinates in the design are the truth.
                         They are an override layer applied to the DECODED design on its way to the
                         solver, which never writes back: a 21-point sweep re-elaborates 21 times and
                         mutates the stored wires zero times.

                         `Material` is an enumeration over the design's OWN metals (the table is
                         user-extensible), so it is a dropdown rather than a text box a typo can reach.
                         The unsuffixed `LoopHeight` and `Diameter` are generic rows at the bottom of
                         this dialog on purpose: they are ordinary expression fields, which is what
                         makes `LoopHeight = loopH` typable and therefore sweepable.

                         "As drawn" is the FIRST entry and means unset. It is deliberately not a blank
                         row and never "0": zero is an error the run refuses by name, and a wire
                         flattened onto the ground plane is not the same statement as a wire left as
                         the user drew it. -->
                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Text="Material"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="Overrides every wire's metal at simulation time. As drawn = leave each wire's own metal alone."/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding WBondMaterialOptions}"
                                  SelectedIndex="{Binding WBondMaterialIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>

                    <!-- Per-ARRAY overrides. The scope is the array because array names ARE the pin
                         names on the symbol (O-10), and it is the only scope there is. The rows are
                         generated from THIS instance's array list, so they name G1/G2 instead of
                         asking anyone to spell a suffix.

                         Span is deliberately absent (WB44a/O-11): it is not a loop property but the
                         pad positions, it scales by factor rather than to a value, and it moves a
                         bonded foot off its pad — which the layout editor makes safe with live
                         snapping and the schematic, being blind to the artwork, cannot. -->
                    <Grid ColumnDefinitions="80,*"
                          IsVisible="{Binding WBondControls.Count}">
                        <TextBlock Grid.Column="0" Text="Per array"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Blank = as drawn. A wire dragged loose from its profile keeps its drawn loop height, and the run says how many."
                                   FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WBondControls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WBondControlRow">
                                <Grid ColumnDefinitions="80,*,*,*" Margin="0,0,0,3">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ArrayName}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding LoopHeight, Mode=TwoWay}"
                                             PlaceholderText="height"
                                             FontSize="11" Padding="4,3" Margin="0,0,3,0"
                                             LostFocus="OnWBondControlLoopHeightCommit"
                                             KeyDown="OnWBondControlLoopHeightKeyDown"
                                             ToolTip.Tip="Loop height for this array, in mil unless a unit is given. A VAR name is typable, which is what makes it sweepable."/>
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Diameter, Mode=TwoWay}"
                                             PlaceholderText="diameter"
                                             FontSize="11" Padding="4,3" Margin="0,0,3,0"
                                             LostFocus="OnWBondControlDiameterCommit"
                                             KeyDown="OnWBondControlDiameterKeyDown"
                                             ToolTip.Tip="Wire diameter for this array, in mil unless a unit is given"/>
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding Materials}"
                                              SelectedIndex="{Binding MaterialIndex}"
                                              FontSize="11" Padding="4,3"
                                              HorizontalAlignment="Stretch"
                                              ToolTip.Tip="Wire metal for this array"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Symbol Pitch + external reference pin — the two artwork controls.
                         "Symbol Pitch", not "Pitch" (owner): on a wirebond component "pitch" reads as
                         the WIRE pitch, the centre-to-centre spacing of the bonds themselves, which
                         this has nothing to do with. It is how far apart the symbol's port ROWS sit. -->
                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Text="Symbol Pitch"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="How far apart the symbol's port rows sit — artwork only, not the wire pitch"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding WBondSymbolPitchOptions}"
                                  SelectedIndex="{Binding WBondSymbolPitchIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>

                    <!-- Ground plane — a BOOLEAN the engine reads through IsTrue, so a picker rather
                         than the text box it used to be (owner, 2026-08-17). Three values: "As
                         designed" is the blank that means the design's own setting, and the other two
                         are the override. See WBondGroundPlaneOptions for what the picker costs. -->
                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Text="Ground plane"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="Overrides whether this component's wires see a ground plane — 'As designed' leaves the wirebond design's own setting alone"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding WBondGroundPlaneChoices}"
                                  SelectedIndex="{Binding WBondGroundPlaneIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>

                    <CheckBox IsChecked="{Binding WBondRefPin}"
                              Content="External reference pin"
                              FontSize="11"
                              ToolTip.Tip="Adds a REF terminal for saying which net is the reference plane. With capacitance included the shunt capacitors return to it; with capacitance off it carries no current at all. Either way the return path is the ground plane set above, and a design with the plane disabled is refused whether or not this pin is shown."/>

                    <!-- brief-wbond-capacitance. The ONE wBond parameter whose default changes the
                         answer for designs that already exist — so it is a checkbox with a definite
                         state rather than a three-value "As designed" picker like Ground plane: a
                         reader has to be able to see, without opening the payload, whether this
                         component is stamping capacitance. -->
                    <CheckBox IsChecked="{Binding WBondIncludeCapacitance}"
                              Content="Include capacitance"
                              FontSize="11"
                              ToolTip.Tip="Stamps the wires' capacitance to the reference plane, and between arrays, alongside the inductance. On by default — turning it off reproduces exactly the answer this component gave before capacitance was modelled."/>

                    <!-- The plastic overmold, directly under the switch that decides whether any
                         capacitance is computed at all — the two only mean anything together. A TEXT
                         box and not a stepper: `er` is an ordinary real expression, so `er = moldEr`
                         is typable and a sweep or an optimiser can turn it, which is how a package is
                         characterised against measured data. See WBondEr. -->
                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Text="Overmold εr"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="Relative permittivity of the plastic the wires are molded in. 1 = air (no encapsulant); a typical mold compound is 3–4. Scales every capacitance by this factor and leaves the inductance alone."/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding WBondEr}"
                                 FontSize="11" Padding="4,3"
                                 PlaceholderText="1"
                                 ToolTip.Tip="A number, or an expression such as a VAR name — so it can be swept or optimised."/>
                    </Grid>

                    <!-- ── WB45: where the wires come from — LAST, as the panel's advanced tail
                         (owner, 2026-08-17: "an advanced feature that only wBond experts would use").
                         Carried (still the portable one — the wires travel inside the schematic, no
                         path to break) or Linked (the netlist names the cell's .wBond, so there is ONE
                         copy of the wires and staleness becomes unrepresentable rather than reported).

                         It sat third, right under the design summary, which put the panel's most
                         consequential and least-used control in front of the ones every user touches —
                         the arrays, the per-array overrides, the artwork. Nobody needs to SET it in the
                         ordinary flow: a placed wBond is Carried by construction and Update Layout from
                         Schematic is what flips it to Linked and says so (WB45a, WBondCellSeeding). The
                         box exists to go BACK to Carried — for a schematic that has to travel on its
                         own — and to repair a link, which are both expert moves.

                         Moved WITHIN this panel rather than below the generic rows underneath it: those
                         are LAST by the owner's own earlier decision (see their comment below), and a
                         wBond's only generic row is `Temp`.

                         The CONSEQUENCE stays stated on the note line directly under the box, the same
                         shape as the MKlopf entry-mode toggle: the two differ in exactly one thing —
                         what the next Run simulates after a layout edit — and nothing else on screen
                         would say which is in force. That is load-bearing wherever it sits, and more so
                         down here where it is read less often. -->
                    <Grid ColumnDefinitions="80,*">
                        <TextBlock Grid.Column="0" Text="Source"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="Whether this component's wires travel inside the schematic (Carried) or are read from the cell's wirebond file (Linked)"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding WBondSourceOptions}"
                                  SelectedIndex="{Binding WBondSourceIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>
                    <TextBlock Text="{Binding WBondSourceNote}"
                               Margin="80,0,0,0"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </StackPanel>

                <!-- Generic parameter rows, LAST — after every custom panel.
                     Hidden entirely for SnP, which replaces them. For a wBond the only one left is
                     `Temp` (`GroundPlane` moved into the panel above on 2026-08-17, being a boolean),
                     and the owner wants it at the BOTTOM (2026-08-17): the panel above
                     is what the component IS — its wires, its arrays, its artwork — and these two are
                     ordinary engine values that belong under it rather than in front of it. Nothing
                     changes for any type with no custom panel of its own, which is all the rest. -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding !IsSnp}"
                              Grid.IsSharedSizeScope="True"
                              Margin="4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParameterRowViewModel">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ParamName"    Width="Auto" MinWidth="40"/>
                                    <ColumnDefinition Width="*"                                   MinWidth="50"/>
                                    <ColumnDefinition SharedSizeGroup="ParamUnit"    Width="Auto" MinWidth="60"/>
                                    <ColumnDefinition SharedSizeGroup="ParamPreview" Width="Auto"/>
                                    <ColumnDefinition SharedSizeGroup="ParamDisplay" Width="Auto"/>
                                    <ColumnDefinition SharedSizeGroup="ParamRemove"  Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding StagedName}"
                                         IsReadOnly="{Binding NameReadOnly}"
                                         PlaceholderText="{Binding NameWatermark}"
                                         FontSize="11"
                                         Padding="2,3"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         ToolTip.Tip="{Binding NameTooltip}"
                                         LostFocus="OnParamNameLostFocus"
                                         KeyDown="OnParamNameKeyDown"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding StagedExpression}"
                                         IsVisible="{Binding ShowExpressionTextBox}"
                                         IsReadOnly="{Binding ExpressionReadOnly}"
                                         FontSize="11"
                                         Padding="4,3"
                                         VerticalAlignment="Center"
                                         LostFocus="OnParamExprLostFocus"
                                         KeyDown="OnParamExprKeyDown"/>
                                <!-- Enum-style parameter (e.g. MBend's Miter): a named-mode ComboBox
                                     instead of a raw 0/1/2 number box — commits immediately, no
                                     LostFocus/KeyDown staging needed. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EnumOptions}"
                                          SelectedIndex="{Binding SelectedEnumIndex}"
                                          IsVisible="{Binding IsEnumParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                                <!-- Layer-choice parameter (SignalLayer/GroundReference, R-tec-6/10):
                                     ONE combobox, nothing else — no adjacent text field. A value the
                                     picker doesn't offer (a custom/renamed layer) is set via the
                                     schematic canvas's own inline label text-edit instead. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LayerChoiceOptions}"
                                          SelectedItem="{Binding SelectedLayerChoice}"
                                          IsVisible="{Binding IsLayerChoiceParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{Binding LayerChoiceMissingWarning}"/>
                                <!-- Cell-declared choice parameter (e.g. an imported kit part that
                                     ships more than one formulation of the same device): the cell's
                                     own closed value set, as a picker. A choice circuitRF cannot
                                     build is still listed — the tooltip and the Run message both say
                                     so, which is more useful than the value being absent. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ChoiceOptions}"
                                          SelectedItem="{Binding SelectedChoice}"
                                          IsVisible="{Binding IsChoiceParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{Binding ChoiceUnsupportedWarning}"/>
                                <!-- A file-valued parameter (a model library, a data table): a path
                                     is exactly the kind of value nobody should be asked to type, and
                                     a mistyped one fails much later with a worse message. -->
                                <Button Grid.Column="2"
                                        Content="Browse…"
                                        IsVisible="{Binding ShowBrowseButton}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnParamBrowseClick"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding StagedUnit}"
                                          IsVisible="{Binding ShowUnitCombo}"
                                          FontSize="11"
                                          Padding="4,3"
                                          MinWidth="60"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnUnitSelectionChanged"/>
                                <!-- Subtle, read-only readout of the enum combo's underlying numeric
                                     value — makes clear that the schematic label/inline text-edit
                                     ("Miter = 2") is the SAME raw number the combo commits, not a
                                     separately-tracked value. -->
                                <SelectableTextBlock Grid.Column="2"
                                                     Text="{Binding EnumIndexReadout}"
                                                     IsVisible="{Binding IsEnumParam}"
                                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                                     FontSize="11"
                                                     Opacity="0.55"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,0,0"
                                                     ToolTip.Tip="The numeric value this mode stores — the schematic label and inline text edit both show this raw number"/>
                                <SelectableTextBlock Grid.Column="3"
                                                     Text="{Binding ValuePreview}"
                                                     IsVisible="{Binding HasValuePreview}"
                                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                                     FontSize="11"
                                                     Opacity="0.7"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,4,0"
                                                     ToolTip.Tip="Approximate value at current schematic state (pre-simulation)"/>
                                <CheckBox Grid.Column="4"
                                          IsChecked="{Binding ShowOnSchematic}"
                                          ToolTip.Tip="Show on schematic"
                                          Margin="6,0,2,0"
                                          VerticalAlignment="Center"/>
                                <!-- Per-row remove. NOT the footer's "−", which removes the last
                                     indexed GROUP — correct for P1Tone's Z[k] and ToneSource's
                                     Freq[n]/V[n]/Phase[n], and no way at all to reach the first of a
                                     hundred independent model parameters. Shown only on a row that
                                     is genuinely independent of its neighbours. -->
                                <Button Grid.Column="5"
                                        Content="✕"
                                        IsVisible="{Binding CanRemove}"
                                        FontSize="10"
                                        Padding="5,1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding RemoveTooltip}"
                                        Click="OnParamRemoveClick"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SpiceModel custom panel: which FILE, which DEFINITION in it, and — for a
                     .subckt only — how its box is laid out. The generic rows above are the chosen
                     subcircuit's own declared parameters. -->
                <StackPanel IsVisible="{Binding IsSpiceModel}"
                            Margin="6,4"
                            Spacing="8">
                    <!-- File -->
                    <Grid ColumnDefinitions="60,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="File"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SpiceModelFilePath}"
                                 FontSize="11"
                                 Padding="4,3"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"
                                 ToolTip.Tip="The SPICE file holding the .model card or .subckt definition"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                Command="{Binding PickSpiceModelFileCommand}"/>
                        <Button Grid.Column="3"
                                Content="Show"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                ToolTip.Tip="Reveal this file in the system file manager"
                                Command="{Binding ShowSpiceModelFileCommand}"/>
                    </Grid>
                    <!-- Section: which .lib alternative in that file. Present only when the file
                         declares any — nearly none do, and a combo with a single entry that can
                         never change is a question with no answer. -->
                    <Grid ColumnDefinitions="60,*" IsVisible="{Binding SpiceModelShowSections}">
                        <TextBlock Grid.Column="0" Text="Section"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SpiceModelSectionOptions}"
                                  SelectedIndex="{Binding SpiceModelSectionIndex}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Which .lib section to read. Sections are alternatives — a file that offers several and has none chosen reads nothing from any of them."/>
                    </Grid>
                    <!-- Name: which definition in that file. The checkbox is the SAME
                         "Show in schematic" every generic parameter row carries — Name has no
                         generic row (the panel owns it), so it is carried here instead. -->
                    <Grid ColumnDefinitions="60,*,Auto">
                        <TextBlock Grid.Column="0" Text="Name"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SpiceModelNameOptions}"
                                  SelectedIndex="{Binding SpiceModelNameIndex}"
                                  HorizontalAlignment="Stretch"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Which definition in the file to run. A file often holds a part plus the pieces it is built from."/>
                        <CheckBox Grid.Column="2"
                                  IsChecked="{Binding SpiceModelShowNameOnSchematic}"
                                  ToolTip.Tip="Show on schematic"
                                  Margin="6,0,2,0"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <!-- What was found, or exactly why nothing will simulate. Two blocks rather
                         than one restyled: a refusal has to READ as one, and the warning brush is
                         how every other refusal in this dialog says so. -->
                    <TextBlock Text="{Binding SpiceModelStatus}"
                               IsVisible="{Binding !SpiceModelStatusIsProblem}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,-2,0,0"/>
                    <TextBlock Text="{Binding SpiceModelStatus}"
                               IsVisible="{Binding SpiceModelStatusIsProblem}"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,-2,0,0"/>
                    <!-- PinConfig + Pitch: a .subckt draws as a box and the box needs laying out.
                         Hidden for a .model card, which draws as the device itself. -->
                    <Grid ColumnDefinitions="60,*,Auto,*"
                          IsVisible="{Binding SpiceModelShowPinLayout}">
                        <TextBlock Grid.Column="0" Text="Pins"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpPinConfigOptions}"
                                  SelectedIndex="{Binding SpiceModelPinConfigIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                        <TextBlock Grid.Column="2" Text="Pitch"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpPitchOptions}"
                                  SelectedIndex="{Binding SpiceModelPitchIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>
                </StackPanel>

                <!-- VerilogA panel: the one setting on a compiled model that is circuitRF's own
                     rather than the model author's, and that has two states rather than a value. -->
                <StackPanel IsVisible="{Binding IsVerilogA}"
                            Margin="6,4"
                            Spacing="8">
                    <CheckBox IsChecked="{Binding VerilogAOpVars}"
                              Content="Report operating-point variables"
                              FontSize="11"
                              ToolTip.Tip="Publish the quantities this model computes at each operating point — transconductances, capacitances, node temperatures — as an OP result. On by default; turn it off on devices you are not studying to keep a swept result small."/>
                </StackPanel>

                <!-- SnP custom panel: file picker + layout controls -->
                <StackPanel IsVisible="{Binding IsSnp}"
                            Margin="6,4"
                            Spacing="8">
                    <!-- Port count -->
                    <Grid ColumnDefinitions="60,*">
                        <TextBlock Grid.Column="0" Text="Ports"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SnpPortCountText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </Grid>
                    <!-- File -->
                    <Grid ColumnDefinitions="60,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="File"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SnpFilePath}"
                                 FontSize="11"
                                 Padding="4,3"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                Command="{Binding PickSnpFileCommand}"/>
                        <Button Grid.Column="3"
                                Content="Show"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                ToolTip.Tip="Reveal this file in the system file manager"
                                Command="{Binding ShowSnpFileCommand}"/>
                    </Grid>
                    <!-- RefNode toggle -->
                    <CheckBox IsChecked="{Binding SnpRefNode}"
                              Content="External reference pin"
                              FontSize="11"/>
                    <!-- PinConfig + Pitch -->
                    <Grid ColumnDefinitions="60,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Pins"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpPinConfigOptions}"
                                  SelectedIndex="{Binding SnpPinConfigIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                        <TextBlock Grid.Column="2" Text="Pitch"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpPitchOptions}"
                                  SelectedIndex="{Binding SnpPitchIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>
                    <!-- Interp Mode + Interp Domain -->
                    <Grid ColumnDefinitions="60,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Interp"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="How the stored S-parameters are interpolated between the file's own frequency points"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpInterpModeOptions}"
                                  SelectedIndex="{Binding SnpInterpModeIndex}"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Interp Mode — Linear, Cubic Spline (default), or Makima"/>
                        <TextBlock Grid.Column="2" Text="Domain"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpInterpDomainOptions}"
                                  SelectedIndex="{Binding SnpInterpDomainIndex}"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Interp Domain — RI: interpolate real/imaginary parts (default). MA: interpolate magnitude/angle."/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Row 3: the VerilogA notes ────────────────────────────────────
             A STACKPANEL, not three children of one grid row. As siblings in row 3 they were all
             laid out at the same origin and PAINTED OVER EACH OTHER whenever more than one was
             visible at once — which is the common case, since a file note and a thermal note arise
             from the same act of choosing a file. A Grid row stacks nothing by itself. -->
        <StackPanel Grid.Row="3" Spacing="0">

            <!-- A compiled model file that could not be read, said at the moment it is chosen rather
                 than at Run — the parameters are left exactly as typed. -->
            <TextBlock Text="{Binding VerilogAFileNote}"
                       IsVisible="{Binding HasVerilogAFileNote}"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="6,2,6,0"/>

            <TextBlock Text="{Binding VerilogAUnknownParamsNote}"
                       IsVisible="{Binding HasVerilogAUnknownParamsNote}"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="6,2,6,0"/>

            <!-- What the compile step said, when the File is Verilog-A source, is NOT here: it goes
                 to the Messages panel. See ParameterEditorViewModel.SyncVerilogAFromModelFile. -->

            <!-- A thermal terminal deliberately left off. NOT the warning brush: this confirms the
                 ordinary configuration for a self-heating part, and colouring it as a problem would
                 invite the user to "fix" it by adding the pin — which floats the thermal node and
                 leaves the DC solve with no solution at all. -->
            <TextBlock Text="{Binding VerilogAThermalNote}"
                       IsVisible="{Binding HasVerilogAThermalNote}"
                       Opacity="0.7"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="6,2,6,0"/>
        </StackPanel>

        <!-- ── Row 4: Footer — +/- group buttons + Help + optional Close ───── -->
        <StackPanel Grid.Row="4"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="6,4,6,6"
                    Spacing="6">
            <!-- Remove top group: visible only for extensible types, disabled when nothing to remove -->
            <Button Content="−"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    IsEnabled="{Binding CanRemoveTopGroup}"
                    ToolTip.Tip="Remove last parameter group"
                    Command="{Binding RemoveTopGroupCommand}"/>
            <!-- Add next group: visible only for extensible types -->
            <Button Content="+"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    ToolTip.Tip="Add parameter group"
                    Command="{Binding AddGroupCommand}"/>
            <!-- An SDD's slots are two-dimensional and bounded by its port count, so the generic
                 "+" above cannot express them (it offered I[n], which duplicated a seeded I[n,0]
                 and then named ports that do not exist). It gets a picker over what this device
                 can still take instead. -->
            <Button Content="Add Equation…"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowAddSddEquation}"
                    ToolTip.Tip="Choose an equation slot this SDD can use"
                    Command="{Binding AddSddEquationCommand}"/>
            <!-- The model's parameters are chosen from what the FILE declares, not typed from
                 memory of it. A parameter not added stays absent, which already means "use the
                 model's own default" — so this list is deliberately not materialised as rows. -->
            <Button Content="Add Parameter…"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowAddModelParameter}"
                    ToolTip.Tip="Choose one of the parameters this compiled model declares"
                    Command="{Binding AddModelParameterCommand}"/>
            <!-- A whole FITTED SET at once. Both published physics-based model families ship their
                 sets as Verilog-A parameter declarations rather than as SPICE model cards, and
                 without this one set is 50-200 gestures through the picker beside it. Names the
                 model does not declare are reported, never dropped in silence. -->
            <Button Content="Load Parameters…"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowAddModelParameter}"
                    ToolTip.Tip="Load a fitted parameter set written as Verilog-A parameter declarations"
                    Command="{Binding LoadModelParametersCommand}"/>
            <Button Content="Edit CV..."
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowCvEditorButton}"
                    Command="{Binding OpenCvEditorCommand}"/>
            <Button Content="Help"
                    FontSize="11"
                    Padding="8,3"
                    Click="OnHelpClick"/>
            <Button Content="Close"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowClose}"
                    Click="OnCloseClick"/>
        </StackPanel>

    </Grid>
</UserControl>
