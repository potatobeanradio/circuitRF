<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.ParameterEditor.ParameterEditorView"
             x:DataType="vm:ParameterEditorViewModel"
             Background="{DynamicResource SystemChromeLowColor}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Empty-state overlay: spans all rows, shown when IsEmptyState -->
        <TextBlock Grid.Row="0" Grid.RowSpan="4"
                   IsVisible="{Binding IsEmptyState}"
                   Text="{Binding EmptyMessage}"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Opacity="0.5"/>

        <!-- ── Row 0: Header — type label + editable instance name ─────────── -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsNotEmptyState}"
              ColumnDefinitions="Auto,*"
              Margin="6,6,6,4">
            <TextBlock Grid.Column="0"
                       Text="{Binding TypeDisplayName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     x:Name="InstanceNameBox"
                     Text="{Binding StagedInstanceName}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     LostFocus="OnInstanceNameLostFocus"
                     KeyDown="OnInstanceNameKeyDown"/>
        </Grid>

        <!-- ── Row 1: Label-visibility flags ──────────────────────────────── -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="6,0,6,4">
            <CheckBox IsChecked="{Binding ShowTypeLabel}"
                      Content="Type label"
                      FontSize="11"/>
            <CheckBox IsChecked="{Binding ShowInstanceName}"
                      Content="Instance name"
                      FontSize="11"/>
        </StackPanel>

        <!-- ── Row 2: Scrollable parameter list ───────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      IsVisible="{Binding IsNotEmptyState}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- Generic parameter rows: hidden for SnP (which uses the custom panel below) -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding !IsSnp}"
                              Grid.IsSharedSizeScope="True"
                              Margin="4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParameterRowViewModel">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ParamName"    Width="Auto" MinWidth="40"/>
                                    <ColumnDefinition Width="*"                                   MinWidth="50"/>
                                    <ColumnDefinition SharedSizeGroup="ParamUnit"    Width="Auto" MinWidth="60"/>
                                    <ColumnDefinition SharedSizeGroup="ParamPreview" Width="Auto"/>
                                    <ColumnDefinition SharedSizeGroup="ParamDisplay" Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding StagedName}"
                                         IsReadOnly="{Binding NameReadOnly}"
                                         FontSize="11"
                                         Padding="2,3"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         ToolTip.Tip="{Binding NameError}"
                                         LostFocus="OnParamNameLostFocus"
                                         KeyDown="OnParamNameKeyDown"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding StagedExpression}"
                                         FontSize="11"
                                         Padding="4,3"
                                         VerticalAlignment="Center"
                                         LostFocus="OnParamExprLostFocus"
                                         KeyDown="OnParamExprKeyDown"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding StagedUnit}"
                                          FontSize="11"
                                          Padding="4,3"
                                          MinWidth="60"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnUnitSelectionChanged"/>
                                <SelectableTextBlock Grid.Column="3"
                                                     Text="{Binding ValuePreview}"
                                                     IsVisible="{Binding HasValuePreview}"
                                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                                     FontSize="11"
                                                     Opacity="0.7"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,4,0"
                                                     ToolTip.Tip="Approximate value at current schematic state (pre-simulation)"/>
                                <CheckBox Grid.Column="4"
                                          IsChecked="{Binding ShowOnSchematic}"
                                          ToolTip.Tip="Show on schematic"
                                          Margin="6,0,2,0"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SnP custom panel: file picker + layout controls -->
                <StackPanel IsVisible="{Binding IsSnp}"
                            Margin="6,4"
                            Spacing="8">
                    <!-- Port count -->
                    <Grid ColumnDefinitions="60,*">
                        <TextBlock Grid.Column="0" Text="Ports"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SnpPortCountText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </Grid>
                    <!-- File -->
                    <Grid ColumnDefinitions="60,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="File"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SnpFilePath}"
                                 FontSize="11"
                                 Padding="4,3"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                Command="{Binding PickSnpFileCommand}"/>
                        <Button Grid.Column="3"
                                Content="Show"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                ToolTip.Tip="Reveal this file in the system file manager"
                                Command="{Binding ShowSnpFileCommand}"/>
                    </Grid>
                    <!-- RefNode toggle -->
                    <CheckBox IsChecked="{Binding SnpRefNode}"
                              Content="Floating reference pin"
                              FontSize="11"/>
                    <!-- PinConfig + Pitch -->
                    <Grid ColumnDefinitions="60,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Pins"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpPinConfigOptions}"
                                  SelectedIndex="{Binding SnpPinConfigIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                        <TextBlock Grid.Column="2" Text="Pitch"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpPitchOptions}"
                                  SelectedIndex="{Binding SnpPitchIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- ── Row 3: Footer — +/- group buttons + Help + optional Close ───── -->
        <StackPanel Grid.Row="3"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="6,4,6,6"
                    Spacing="6">
            <!-- Remove top group: visible only for extensible types, disabled when nothing to remove -->
            <Button Content="−"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    IsEnabled="{Binding CanRemoveTopGroup}"
                    ToolTip.Tip="Remove last parameter group"
                    Command="{Binding RemoveTopGroupCommand}"/>
            <!-- Add next group: visible only for extensible types -->
            <Button Content="+"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    ToolTip.Tip="Add parameter group"
                    Command="{Binding AddGroupCommand}"/>
            <Button Content="Help"
                    FontSize="11"
                    Padding="8,3"
                    Click="OnHelpClick"/>
            <Button Content="Close"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowClose}"
                    Click="OnCloseClick"/>
        </StackPanel>

    </Grid>
</UserControl>
