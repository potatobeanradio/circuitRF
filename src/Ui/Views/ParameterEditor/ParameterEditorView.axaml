<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.ParameterEditor.ParameterEditorView"
             x:DataType="vm:ParameterEditorViewModel"
             Background="{DynamicResource SystemChromeLowColor}">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Empty-state overlay: spans all rows, shown when IsEmptyState -->
        <TextBlock Grid.Row="0" Grid.RowSpan="5"
                   IsVisible="{Binding IsEmptyState}"
                   Text="{Binding EmptyMessage}"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Opacity="0.5"/>

        <!-- ── Row 0: Header — type label + editable instance name ─────────── -->
        <Grid Grid.Row="0"
              IsVisible="{Binding IsNotEmptyState}"
              ColumnDefinitions="Auto,*"
              Margin="6,6,6,4">
            <TextBlock Grid.Column="0"
                       Text="{Binding TypeDisplayName}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     x:Name="InstanceNameBox"
                     Text="{Binding StagedInstanceName}"
                     FontSize="12"
                     VerticalAlignment="Center"
                     LostFocus="OnInstanceNameLostFocus"
                     KeyDown="OnInstanceNameKeyDown"/>
        </Grid>

        <!-- ── Row 1: Label-visibility flags ──────────────────────────────── -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="6,0,6,4">
            <CheckBox IsChecked="{Binding ShowTypeLabel}"
                      Content="Type label"
                      FontSize="11"/>
            <CheckBox IsChecked="{Binding ShowInstanceName}"
                      Content="Instance name"
                      FontSize="11"/>
            <!-- MKlopf entry-mode switch: Z1/Z2 <-> W1/W2, L <-> F3db (converts, never resets) -->
            <Button Content="{Binding MklopfImpedanceToggleLabel}"
                    IsVisible="{Binding IsMklopfTarget}"
                    FontSize="10"
                    Padding="6,2"
                    ToolTip.Tip="Switch between impedance (Z1/Z2) and width (W1/W2) entry — converts the current design to the equivalent values, it does not reset it"
                    Command="{Binding ToggleMklopfImpedanceEntryCommand}"/>
            <Button Content="{Binding MklopfLengthToggleLabel}"
                    IsVisible="{Binding IsMklopfTarget}"
                    FontSize="10"
                    Padding="6,2"
                    ToolTip.Tip="Switch between length (L) and 3dB-cutoff-frequency (F3db) entry — converts the current design to the equivalent value, it does not reset it"
                    Command="{Binding ToggleMklopfLengthEntryCommand}"/>
        </StackPanel>

        <!-- ── Row 2: Scrollable parameter list ───────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      IsVisible="{Binding IsNotEmptyState}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- Generic parameter rows: hidden for SnP (which uses the custom panel below) -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding !IsSnp}"
                              Grid.IsSharedSizeScope="True"
                              Margin="4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParameterRowViewModel">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ParamName"    Width="Auto" MinWidth="40"/>
                                    <ColumnDefinition Width="*"                                   MinWidth="50"/>
                                    <ColumnDefinition SharedSizeGroup="ParamUnit"    Width="Auto" MinWidth="60"/>
                                    <ColumnDefinition SharedSizeGroup="ParamPreview" Width="Auto"/>
                                    <ColumnDefinition SharedSizeGroup="ParamDisplay" Width="Auto"/>
                                    <ColumnDefinition SharedSizeGroup="ParamRemove"  Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding StagedName}"
                                         IsReadOnly="{Binding NameReadOnly}"
                                         PlaceholderText="{Binding NameWatermark}"
                                         FontSize="11"
                                         Padding="2,3"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         ToolTip.Tip="{Binding NameTooltip}"
                                         LostFocus="OnParamNameLostFocus"
                                         KeyDown="OnParamNameKeyDown"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding StagedExpression}"
                                         IsVisible="{Binding ShowExpressionTextBox}"
                                         IsReadOnly="{Binding ExpressionReadOnly}"
                                         FontSize="11"
                                         Padding="4,3"
                                         VerticalAlignment="Center"
                                         LostFocus="OnParamExprLostFocus"
                                         KeyDown="OnParamExprKeyDown"/>
                                <!-- Enum-style parameter (e.g. MBend's Miter): a named-mode ComboBox
                                     instead of a raw 0/1/2 number box — commits immediately, no
                                     LostFocus/KeyDown staging needed. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding EnumOptions}"
                                          SelectedIndex="{Binding SelectedEnumIndex}"
                                          IsVisible="{Binding IsEnumParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                                <!-- Layer-choice parameter (SignalLayer/GroundReference, R-tec-6/10):
                                     ONE combobox, nothing else — no adjacent text field. A value the
                                     picker doesn't offer (a custom/renamed layer) is set via the
                                     schematic canvas's own inline label text-edit instead. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LayerChoiceOptions}"
                                          SelectedItem="{Binding SelectedLayerChoice}"
                                          IsVisible="{Binding IsLayerChoiceParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{Binding LayerChoiceMissingWarning}"/>
                                <!-- Cell-declared choice parameter (e.g. an imported kit part that
                                     ships more than one formulation of the same device): the cell's
                                     own closed value set, as a picker. A choice circuitRF cannot
                                     build is still listed — the tooltip and the Run message both say
                                     so, which is more useful than the value being absent. -->
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ChoiceOptions}"
                                          SelectedItem="{Binding SelectedChoice}"
                                          IsVisible="{Binding IsChoiceParam}"
                                          FontSize="11"
                                          Padding="4,3"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ToolTip.Tip="{Binding ChoiceUnsupportedWarning}"/>
                                <!-- A file-valued parameter (a model library, a data table): a path
                                     is exactly the kind of value nobody should be asked to type, and
                                     a mistyped one fails much later with a worse message. -->
                                <Button Grid.Column="2"
                                        Content="Browse…"
                                        IsVisible="{Binding ShowBrowseButton}"
                                        FontSize="11"
                                        Padding="6,2"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnParamBrowseClick"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding UnitOptions}"
                                          SelectedItem="{Binding StagedUnit}"
                                          IsVisible="{Binding ShowUnitCombo}"
                                          FontSize="11"
                                          Padding="4,3"
                                          MinWidth="60"
                                          Margin="3,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnUnitSelectionChanged"/>
                                <!-- Subtle, read-only readout of the enum combo's underlying numeric
                                     value — makes clear that the schematic label/inline text-edit
                                     ("Miter = 2") is the SAME raw number the combo commits, not a
                                     separately-tracked value. -->
                                <SelectableTextBlock Grid.Column="2"
                                                     Text="{Binding EnumIndexReadout}"
                                                     IsVisible="{Binding IsEnumParam}"
                                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                                     FontSize="11"
                                                     Opacity="0.55"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,0,0"
                                                     ToolTip.Tip="The numeric value this mode stores — the schematic label and inline text edit both show this raw number"/>
                                <SelectableTextBlock Grid.Column="3"
                                                     Text="{Binding ValuePreview}"
                                                     IsVisible="{Binding HasValuePreview}"
                                                     Foreground="{DynamicResource SystemBaseMediumColor}"
                                                     FontSize="11"
                                                     Opacity="0.7"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,4,0"
                                                     ToolTip.Tip="Approximate value at current schematic state (pre-simulation)"/>
                                <CheckBox Grid.Column="4"
                                          IsChecked="{Binding ShowOnSchematic}"
                                          ToolTip.Tip="Show on schematic"
                                          Margin="6,0,2,0"
                                          VerticalAlignment="Center"/>
                                <!-- Per-row remove. NOT the footer's "−", which removes the last
                                     indexed GROUP — correct for P1Tone's Z[k] and ToneSource's
                                     Freq[n]/V[n]/Phase[n], and no way at all to reach the first of a
                                     hundred independent model parameters. Shown only on a row that
                                     is genuinely independent of its neighbours. -->
                                <Button Grid.Column="5"
                                        Content="✕"
                                        IsVisible="{Binding CanRemove}"
                                        FontSize="10"
                                        Padding="5,1"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Remove this parameter — the model's own default applies again"
                                        Click="OnParamRemoveClick"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SnP custom panel: file picker + layout controls -->
                <StackPanel IsVisible="{Binding IsSnp}"
                            Margin="6,4"
                            Spacing="8">
                    <!-- Port count -->
                    <Grid ColumnDefinitions="60,*">
                        <TextBlock Grid.Column="0" Text="Ports"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SnpPortCountText}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    </Grid>
                    <!-- File -->
                    <Grid ColumnDefinitions="60,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="File"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SnpFilePath}"
                                 FontSize="11"
                                 Padding="4,3"
                                 VerticalAlignment="Center"
                                 IsReadOnly="True"/>
                        <Button Grid.Column="2"
                                Content="Browse…"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                Command="{Binding PickSnpFileCommand}"/>
                        <Button Grid.Column="3"
                                Content="Show"
                                FontSize="11"
                                Padding="6,3"
                                Margin="4,0,0,0"
                                ToolTip.Tip="Reveal this file in the system file manager"
                                Command="{Binding ShowSnpFileCommand}"/>
                    </Grid>
                    <!-- RefNode toggle -->
                    <CheckBox IsChecked="{Binding SnpRefNode}"
                              Content="Floating reference pin"
                              FontSize="11"/>
                    <!-- PinConfig + Pitch -->
                    <Grid ColumnDefinitions="60,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Pins"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpPinConfigOptions}"
                                  SelectedIndex="{Binding SnpPinConfigIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                        <TextBlock Grid.Column="2" Text="Pitch"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpPitchOptions}"
                                  SelectedIndex="{Binding SnpPitchIndex}"
                                  FontSize="11"
                                  Padding="4,3"/>
                    </Grid>
                    <!-- Interp Mode + Interp Domain -->
                    <Grid ColumnDefinitions="60,*,Auto,*">
                        <TextBlock Grid.Column="0" Text="Interp"
                                   FontSize="11" VerticalAlignment="Center"
                                   ToolTip.Tip="How the stored S-parameters are interpolated between the file's own frequency points"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding SnpInterpModeOptions}"
                                  SelectedIndex="{Binding SnpInterpModeIndex}"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Interp Mode — Linear, Cubic Spline (default), or Makima"/>
                        <TextBlock Grid.Column="2" Text="Domain"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SnpInterpDomainOptions}"
                                  SelectedIndex="{Binding SnpInterpDomainIndex}"
                                  FontSize="11"
                                  Padding="4,3"
                                  ToolTip.Tip="Interp Domain — RI: interpolate real/imaginary parts (default). MA: interpolate magnitude/angle."/>
                    </Grid>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <!-- A compiled model file that could not be read, said at the moment it is chosen rather
             than at Run — the parameters are left exactly as typed. -->
        <TextBlock Grid.Row="3"
                   Text="{Binding VerilogAFileNote}"
                   IsVisible="{Binding HasVerilogAFileNote}"
                   Foreground="{DynamicResource CrfWarningBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="6,2,6,0"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding VerilogAUnknownParamsNote}"
                   IsVisible="{Binding HasVerilogAUnknownParamsNote}"
                   Foreground="{DynamicResource CrfWarningBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="6,2,6,0"/>

        <!-- ── Row 4: Footer — +/- group buttons + Help + optional Close ───── -->
        <StackPanel Grid.Row="4"
                    IsVisible="{Binding IsNotEmptyState}"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="6,4,6,6"
                    Spacing="6">
            <!-- Remove top group: visible only for extensible types, disabled when nothing to remove -->
            <Button Content="−"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    IsEnabled="{Binding CanRemoveTopGroup}"
                    ToolTip.Tip="Remove last parameter group"
                    Command="{Binding RemoveTopGroupCommand}"/>
            <!-- Add next group: visible only for extensible types -->
            <Button Content="+"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding AllowsAddParameter}"
                    ToolTip.Tip="Add parameter group"
                    Command="{Binding AddGroupCommand}"/>
            <!-- The model's parameters are chosen from what the FILE declares, not typed from
                 memory of it. A parameter not added stays absent, which already means "use the
                 model's own default" — so this list is deliberately not materialised as rows. -->
            <Button Content="Add Parameter…"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowAddModelParameter}"
                    ToolTip.Tip="Choose one of the parameters this compiled model declares"
                    Command="{Binding AddModelParameterCommand}"/>
            <Button Content="Edit CV..."
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowCvEditorButton}"
                    Command="{Binding OpenCvEditorCommand}"/>
            <Button Content="Help"
                    FontSize="11"
                    Padding="8,3"
                    Click="OnHelpClick"/>
            <Button Content="Close"
                    FontSize="11"
                    Padding="8,3"
                    IsVisible="{Binding ShowClose}"
                    Click="OnCloseClick"/>
        </StackPanel>

    </Grid>
</UserControl>
