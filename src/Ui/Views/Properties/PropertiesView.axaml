<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:param="using:CircuitRF.Ui.Views.ParameterEditor"
             xmlns:symInsp="using:CircuitRF.Ui.Views.Properties"
             xmlns:body="using:CircuitRF.Ui.Views.Content"
             xmlns:ddv="using:CircuitRF.Ui.Views.DataDisplay"
             x:Class="CircuitRF.Ui.Views.Properties.PropertiesView"
             x:DataType="vm:PropertiesTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: text changes by selection type — "Cell" / "Component" / "Symbol" / "Properties" -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,2">
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Symbol Primitive Inspector (shown when a symbol editor document is active) -->
            <Panel IsVisible="{Binding IsSymbolEditorActive}">
                <symInsp:SymbolPrimitiveInspectorView DataContext="{Binding SymbolInspectorVm}"/>
            </Panel>

            <!-- Cell Properties Inspector (shown when a cell node or document is active) -->
            <Panel IsVisible="{Binding IsCellActive}">
                <body:CellParameterBodyView DataContext="{Binding CellEditorVm}"/>
            </Panel>

            <!-- Layout Shape Properties (shown when a layout editor document is active) -->
            <Panel IsVisible="{Binding IsLayoutActive}">
                <symInsp:LayoutShapePropertiesView DataContext="{Binding LayoutInspectorVm}"/>
            </Panel>

            <!-- Data Display: Datasets list (document-level, R-dd-4/5) + Plot Inspector
                 (shown when a data display document is active; the inspector portion is only
                 rendered once a single plot is also selected — HasSelectedPlot, not just
                 IsDataDisplayActive, so its "+ Trace"/plot-type chrome never shows uninitialized
                 with a null DataContext when nothing is selected). -->
            <Panel IsVisible="{Binding IsDataDisplayActive}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="0">
                        <symInsp:DatasetsListView DataContext="{Binding DatasetsVm}"/>
                        <Panel IsVisible="{Binding HasSelectedPlot}">
                            <ddv:PlotInspectorView DataContext="{Binding PlotInspectorVm}"/>
                        </Panel>
                    </StackPanel>
                </ScrollViewer>
            </Panel>

            <!-- File Info Inspector (shown when a Known File leaf or OtherFile node is selected) -->
            <StackPanel IsVisible="{Binding IsFileInfoActive}" Margin="8" Spacing="6">
                <SelectableTextBlock Text="{Binding FileInfoVm.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size" Margin="0,0,8,2"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileInfoVm.SizeText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified" Margin="0,0,8,0"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileInfoVm.ModifiedText}"/>
                </Grid>
            </StackPanel>

            <!--
                COEXISTENCE_FLAG: "content-switch" (default) — parameter editor when one non-Ground
                component is selected, palette placeholder otherwise. To switch to "stack" (show both
                simultaneously), replace this Grid with a StackPanel and remove the IsVisible toggles.
            -->
            <Grid IsVisible="{Binding IsSchematicContextActive}">

                <!-- Placeholder (hidden when cell or specific component is active) -->
                <TextBlock Text="Select object to inspect its properties."
                           IsVisible="{Binding EditorVm.IsEmptyState}"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.5"/>

                <!-- Parameter editor (shown when exactly one non-Ground component is selected) -->
                <param:ParameterEditorView
                    DataContext="{Binding EditorVm}"
                    IsVisible="{Binding IsNotEmptyState}"/>

            </Grid>

        </Grid>

    </Grid>
</UserControl>
