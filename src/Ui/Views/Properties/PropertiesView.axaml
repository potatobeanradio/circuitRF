<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:param="using:CircuitRF.Ui.Views.ParameterEditor"
             xmlns:symInsp="using:CircuitRF.Ui.Views.Properties"
             xmlns:body="using:CircuitRF.Ui.Views.Content"
             xmlns:ddv="using:CircuitRF.Ui.Views.DataDisplay"
             x:Class="CircuitRF.Ui.Views.Properties.PropertiesView"
             x:DataType="vm:PropertiesTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: text changes by selection type — "Cell" / "Component" / "Symbol" / "Properties" -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,2">
            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Symbol Primitive Inspector (shown when a symbol editor document is active) -->
            <Panel IsVisible="{Binding IsSymbolEditorActive}">
                <symInsp:SymbolPrimitiveInspectorView DataContext="{Binding SymbolInspectorVm}"/>
            </Panel>

            <!-- Cell Properties Inspector (shown when a cell node or document is active) -->
            <Panel IsVisible="{Binding IsCellActive}">
                <body:CellParameterBodyView DataContext="{Binding CellEditorVm}"/>
            </Panel>

            <!-- Data Display Plot Inspector (shown when a data display is active with a single plot selected) -->
            <Panel IsVisible="{Binding IsDataDisplayActive}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ddv:PlotInspectorView DataContext="{Binding PlotInspectorVm}"/>
                </ScrollViewer>
            </Panel>

            <!--
                COEXISTENCE_FLAG: "content-switch" (default) — parameter editor when one non-Ground
                component is selected, palette placeholder otherwise. To switch to "stack" (show both
                simultaneously), replace this Grid with a StackPanel and remove the IsVisible toggles.
            -->
            <Grid IsVisible="{Binding IsSchematicContextActive}">

                <!-- Placeholder (hidden when cell or specific component is active) -->
                <TextBlock Text="Select object to inspect its properties."
                           IsVisible="{Binding EditorVm.IsEmptyState}"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.5"/>

                <!-- Parameter editor (shown when exactly one non-Ground component is selected) -->
                <param:ParameterEditorView
                    DataContext="{Binding EditorVm}"
                    IsVisible="{Binding IsNotEmptyState}"/>

            </Grid>

        </Grid>

    </Grid>
</UserControl>
