<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.WBondTransformDialog"
        Title="Transform Wires"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="16" Spacing="10" MinWidth="320">
        <TextBlock x:Name="SelectionText" FontSize="11" Opacity="0.7"/>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <RadioButton x:Name="MirrorMode" Content="Mirror" GroupName="Mode" IsChecked="True"
                         IsCheckedChanged="OnModeChanged"/>
            <RadioButton x:Name="DuplicateMode" Content="Duplicate" GroupName="Mode"
                         IsCheckedChanged="OnModeChanged"/>
            <RadioButton x:Name="BendMode" Content="Bend" GroupName="Mode"
                         IsCheckedChanged="OnModeChanged"/>
            <RadioButton x:Name="ExtendMode" Content="Extend" GroupName="Mode"
                         IsCheckedChanged="OnModeChanged"/>
        </StackPanel>

        <!-- Mirror -->
        <StackPanel x:Name="MirrorPanel" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Axis:" VerticalAlignment="Center" Width="70"/>
                <RadioButton x:Name="MirrorX" Content="X" GroupName="MirrorAxis" IsChecked="True"/>
                <RadioButton x:Name="MirrorY" Content="Y" GroupName="MirrorAxis"/>
                <RadioButton x:Name="MirrorZ" Content="Z" GroupName="MirrorAxis"/>
            </StackPanel>

            <!-- Surfaced as a checkbox precisely because getting it wrong flips every mutual sign
                 involving the mirrored wire (WB3) — a plausible-looking wrong answer, not a failure. -->
            <CheckBox x:Name="ReverseTraversalCheck" IsChecked="True"
                      Content="Reverse traversal direction"/>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="300"
                       Text="A mirrored wire's input normally stays on the input side. Clearing this keeps the original direction, which flips the sign of every mutual inductance involving these wires."/>
        </StackPanel>

        <!-- Duplicate with pitch -->
        <StackPanel x:Name="DuplicatePanel" Spacing="6" IsVisible="False">
            <Grid ColumnDefinitions="70,110,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pitch X:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="PitchXBox" Text="0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="PitchUnitX" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Pitch Y:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PitchYBox" Text="6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="PitchUnitY" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Count:" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="CountUpDown"
                               Minimum="1" Maximum="600" Increment="1" Value="4" FormatString="0"/>
            </Grid>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="300"
                       Text="Creates the copies in one step, in the source wire's own array. Minimum-pitch checking against the assembly rules arrives with the wirebond DRC."/>
        </StackPanel>

        <!-- Bend -->
        <StackPanel x:Name="BendPanel" Spacing="6" IsVisible="False">
            <Grid ColumnDefinitions="70,110,Auto" RowDefinitions="Auto,6,Auto,6,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="dX:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="BendXBox" Text="0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BendUnitX" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="dY:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BendYBox" Text="0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="BendUnitY" VerticalAlignment="Center" Margin="6,0,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="dZ:" VerticalAlignment="Center"/>
                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="BendZBox" Text="0"/>
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="BendUnitZ" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" MaxWidth="300"
                       Text="Displaces the interior points and leaves both feet where they are, so the wire still lands on its pads."/>
        </StackPanel>

        <!-- Extend -->
        <StackPanel x:Name="ExtendPanel" Spacing="6" IsVisible="False">
            <Grid ColumnDefinitions="70,110" RowDefinitions="Auto,6,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Factor:" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="ExtendFactorUpDown"
                               Minimum="0.05" Maximum="20" Increment="0.05" Value="1.10"
                               FormatString="0.###"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="From:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="ExtendFromOutput" Content="Output end" GroupName="ExtendEnd" IsChecked="True"/>
                    <RadioButton x:Name="ExtendFromInput" Content="Input end" GroupName="ExtendEnd"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}"
                   TextWrapping="Wrap" MaxWidth="300" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80"
                    HorizontalContentAlignment="Center" Click="OnCancel"/>
            <Button Content="Apply" IsDefault="True" MinWidth="80"
                    HorizontalContentAlignment="Center" Click="OnApply"/>
        </StackPanel>
    </StackPanel>
</Window>
