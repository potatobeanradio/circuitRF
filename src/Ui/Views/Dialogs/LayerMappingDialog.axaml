<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="using:CircuitRF.Ui.Views.Dialogs"
        xmlns:lay="using:CircuitRF.Ui.Layout"
        x:Class="CircuitRF.Ui.Views.Dialogs.LayerMappingDialog"
        Title="Layer Mapping"
        Width="1000"
        Height="620"
        MinWidth="700"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="20,16,20,16">

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="HeaderText" Grid.Row="1" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- brief-gerber-import-target-technology R-gt-8: which technology a Gerber import lands in.
             Gerber only — every other caller leaves it hidden — and left-aligned with the table's edge
             below it. No explanatory text: the combo's tooltip says what choosing a technology means. -->
        <StackPanel x:Name="TechnologyRow" Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    Margin="0,0,0,10" IsVisible="False">
            <TextBlock Text="Technology:" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox x:Name="TechnologyCombo" FontSize="12" MinWidth="360" MaxDropDownHeight="400"
                      VerticalContentAlignment="Center"
                      ToolTip.Tip="The layout uses this technology; no new technology is written. New technology from the files writes one of its own beside the cell."/>
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="3" RowDefinitions="*,0">
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4" Padding="0">
            <!-- The columns' own MinWidths add up to 570 px before spacing, margins and the window's
                 own 40, so the table needs ~660 to show its last column at all — and at the old 620
                 the "Map to" combo was simply off the right edge with the horizontal scroll bar
                 DISABLED, so there was no way to reach it. Auto, so a user who shrinks the window can
                 still scroll to it. "From" adds no minimum: it is empty for the importers whose
                 source layer has no separate origin to name, and an empty column must not cost width.
                 R-rail27-1b's "In the stackup as" adds none for the same reason: only a Gerber
                 import's unclassified rows are ever asked it. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

                <!-- Header and rows declare IDENTICAL ColumnDefinitions (SharedSizeGroup) so columns
                     never drift — mirrors TechEditorView.axaml's layer-table pattern. -->
                <Grid RowDefinitions="Auto,*" Grid.IsSharedSizeScope="True">

                    <Grid Grid.Row="0" Margin="8,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"    SharedSizeGroup="MLayer"  MinWidth="140"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MFrom"   MinWidth="0"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MCount"  MinWidth="50"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MStack"  MinWidth="0"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MMatch"  MinWidth="140"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MAction" MinWidth="120"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MTarget" MinWidth="120"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MRead"   MinWidth="0"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Source layer" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="From" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Text="Shapes"      FontSize="11" FontWeight="SemiBold" Opacity="0.7" HorizontalAlignment="Right"/>
                        <!-- R-rail27-1b. The stackup question, beside the shape count that answers it:
                             a plane is the row with hundreds of shapes on it and it sorts to the top. -->
                        <TextBlock Grid.Column="3" x:Name="StackupHeader" Text="In the stackup as" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="4" x:Name="MatchHeader"  Text="Match"       FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="5" x:Name="ActionHeader" Text="Action"      FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="6" x:Name="TargetHeader" Text="Map to"      FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                        <TextBlock Grid.Column="7" x:Name="ReadingHeader" Text="Read as"    FontSize="11" FontWeight="SemiBold" Opacity="0.7" IsVisible="False"/>
                    </Grid>

                    <ItemsControl x:Name="RowsControl" Grid.Row="1" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="d:LayerMappingRowViewModel">
                                <Grid ColumnSpacing="8" Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"    SharedSizeGroup="MLayer"  MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MFrom"   MinWidth="0"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MCount"  MinWidth="50"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MStack"  MinWidth="0"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MMatch"  MinWidth="140"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MAction" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MTarget" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MRead"   MinWidth="0"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding SourceLabel}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SourceDetail}" IsVisible="{Binding HasSourceDetail}"
                                               FontSize="12" FontFamily="Courier New,Consolas,monospace"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="220" ToolTip.Tip="{Binding SourceDetail}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ShapeCountText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding StackupOptions}"
                                              SelectedItem="{Binding SelectedStackup, Mode=TwoWay}"
                                              IsVisible="{Binding ShowStackupCombo}"
                                              FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center"
                                              ToolTip.Tip="Only a conductor enters the stackup. A file left as artwork is drawn, and is priced by nothing, extracted by nothing, and cannot be named as a reference return."/>

                                    <TextBlock Grid.Column="4" Text="{Binding MatchLabel}" IsVisible="{Binding ShowReconciliation}"
                                               FontSize="11" Opacity="0.65" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                    <ComboBox Grid.Column="5" ItemsSource="{Binding Actions}"
                                              SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                              IsVisible="{Binding ShowReconciliation}"
                                              FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center"/>

                                    <ComboBox Grid.Column="6" ItemsSource="{Binding MapTargets}"
                                              SelectedItem="{Binding SelectedMapTarget, Mode=TwoWay}"
                                              IsVisible="{Binding ShowMapTargetCombo}"
                                              FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="lay:LayerPickerItem">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="10" Height="10" CornerRadius="2"
                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding SwatchColor}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ComboBox Grid.Column="7" ItemsSource="{Binding ReadingOptions}"
                                              SelectedItem="{Binding SelectedReading, Mode=TwoWay}"
                                              IsVisible="{Binding ShowReadingCombo}"
                                              FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center"
                                              ToolTip.Tip="Filled chains this layer's outlines into loops; the outermost is copper, what it encloses is not, and so on inward. Inverted takes the other reading. Vias makes a plated via of each circle."/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Brief DFR38-1 R-dfr38-1-6: a DXF import only. What the rows above would import as, drawn by the
             layout editor's renderer, beside what would be reported. Nothing is written until Continue. -->
        <Grid x:Name="PreviewPane" Grid.Row="1" IsVisible="False" Margin="0,10,0,0" ColumnDefinitions="2*,*" ColumnSpacing="10">
            <Border x:Name="PreviewHost" Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform"/>
            </Border>
            <TextBox Grid.Column="1" x:Name="PreviewNotes" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11"
                     VerticalContentAlignment="Top"/>
        </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" Margin="0,10,0,0">
            <StackPanel Grid.Column="0" x:Name="BulkActions" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Map all unmatched to:" FontSize="11" VerticalAlignment="Center"/>
                <ComboBox x:Name="MapAllUnmatchedCombo" FontSize="11" Padding="6,2" MinHeight="0"
                          VerticalContentAlignment="Center" MinWidth="120"/>
                <Button Content="Apply" FontSize="11" Padding="8,2" Click="OnMapAllUnmatchedClick"/>
                <Button Content="Keep All Unknown" FontSize="11" Padding="8,2" Margin="10,0,0,0"
                        Click="OnKeepAllUnknownClick"/>
            </StackPanel>
            <StackPanel Grid.Column="1" x:Name="JoinToleranceRow" Orientation="Horizontal" Spacing="6" Margin="16,0,0,0"
                        VerticalAlignment="Center" IsVisible="False">
                <TextBlock Text="Close gaps up to" FontSize="11" VerticalAlignment="Center"/>
                <TextBox x:Name="JoinToleranceBox" FontSize="11" Padding="6,2" MinHeight="0" Width="56" VerticalContentAlignment="Center"
                         ToolTip.Tip="Two open ends this close join into one point. Anything further apart is listed and left as an outline, since closing a real gap would short two nets."/>
                <TextBlock Text="µm" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="SummaryText" FontSize="11" Opacity="0.7"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button Content="Continue" Width="80" IsDefault="True" FontSize="12" HorizontalContentAlignment="Center" Click="OnOkClick"/>
        </StackPanel>

    </Grid>
</Window>
