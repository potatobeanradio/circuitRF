<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.DxfExportOptionsDialog"
        Title="Export DXF"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="This export will change the design as follows:" FontSize="12" FontWeight="SemiBold"/>

            <TextBlock x:Name="CurveLine" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="HoleLine" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="BitmapLine" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock x:Name="MixedLine" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
            <TextBlock x:Name="PathLine" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
            <TextBlock x:Name="EscapedTextLine" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
            <TextBlock x:Name="NoChangesLine" Text="No curves, holes, or bitmaps — geometry exports unchanged."
                       FontSize="11" Opacity="0.7" IsVisible="False"/>

            <TextBlock x:Name="UnresolvedHeader"
                       Text="Warning — the following instances reference a cell that could not be resolved and will export as a dangling reference:"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
            <ScrollViewer x:Name="UnresolvedScroll" MaxHeight="100" IsVisible="False">
                <ItemsControl x:Name="UnresolvedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
            <TextBlock Text="Options" FontSize="12" FontWeight="SemiBold"/>
            <CheckBox x:Name="FlattenSplinesCheck" Content="Flatten curves to polylines (for viewers that don't read SPLINE)" FontSize="11"/>
            <CheckBox x:Name="PathOutlineCheck" Content="Export paths as their outline polygon (loses end-cap style, gains exact width)" FontSize="11"/>

            <TextBlock Text="View on open" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ComboBox x:Name="ViewModeCombo" FontSize="11" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Fit to extents"/>
                <ComboBoxItem Content="Match current view"/>
            </ComboBox>

            <TextBlock Text="File version" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ComboBox x:Name="AcadVersionCombo" FontSize="11" HorizontalAlignment="Stretch"
                      SelectionChanged="OnAcadVersionChanged">
                <ComboBoxItem Content="AutoCAD 2000/R2000 — widest compatibility, approximate colour"/>
                <ComboBoxItem Content="AutoCAD 2004/R2004 — exact colour"/>
                <ComboBoxItem Content="AutoCAD 2018/R2018 — exact colour (default)"/>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="FormatVersionLine"
                   Grid.Row="2"
                   Margin="0,16,0,0"
                   FontSize="10" Opacity="0.55"
                   TextWrapping="Wrap"
                   ToolTip.Tip="The DXF file format version this exporter writes."/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button x:Name="ExportButton" Content="Export" Width="80" IsDefault="True" FontSize="12"
                    HorizontalContentAlignment="Center" Click="OnExportClick"/>
        </StackPanel>

    </Grid>
</Window>
