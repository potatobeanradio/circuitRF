<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:CircuitRF.Ui.Views.Dialogs"
        x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaSettingsDialog"
        Title="harmonicaRF Settings"
        Width="640" Height="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!--
    brief-harmonicarf-r6a §2.2 — the ONE Settings dialog, merging what used to be Edit ▸ Preferences…
    (HarmonicaPreferencesDialog) and Display ▸ Advanced Settings… (HarmonicaAdvancedSettingsDialog).
    Both former dialogs' own code-behind is reused verbatim, lifted into a UserControl per tab
    (HarmonicaAppearanceSettingsView / HarmonicaAdvancedSettingsView) rather than retyped.
  -->

  <Grid RowDefinitions="*,Auto" Margin="12">
    <TabControl Grid.Row="0">
      <TabItem Header="Appearance">
        <dlg:HarmonicaAppearanceSettingsView x:Name="AppearanceTab"/>
      </TabItem>
      <TabItem Header="Advanced">
        <dlg:HarmonicaAdvancedSettingsView x:Name="AdvancedTab"/>
      </TabItem>

      <!--
        R-AU-42. harmonicaRF does not use SettingsView, so without this tab a user who has only
        harmonicaRF installed could never turn automatic updates off — nor, since 2026-08-25, refuse
        a kit its external device worker, which harmonicaRF resolves through HarmonicaDutCatalog just
        as circuitRF does. Both controls are the SAME ones circuitRF and wBond host, reading and
        writing the same AppPreferences properties. Neither dialog owns them.

        The tab is named for what it holds rather than for updates alone, matching SettingsView: a
        user auditing what this binary may RUN or FETCH should find both answers in one place, in
        whichever of the three applications they happen to have. Section headers are shown here
        because the tab now carries two sections and its title can no longer name either.
      -->
      <TabItem Header="Security &amp; Permissions">
        <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4" Spacing="0">
            <dlg:ExternalWorkerSettingsView x:Name="WorkersTab"/>
            <dlg:UpdateSettingsView x:Name="UpdatesTab" Margin="0,24,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
      <Button Content="Close" Width="80" IsCancel="True" IsDefault="True"
              HorizontalContentAlignment="Center" Click="OnCloseClick"/>
    </StackPanel>
  </Grid>
</Window>
