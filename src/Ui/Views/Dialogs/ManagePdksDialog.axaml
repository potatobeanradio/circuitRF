<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.ManagePdksDialog"
        Title="Manage PDKs"
        Width="640"
        Height="440"
        MinWidth="520"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- The state is in the WORDS; the tint is a second cue, never the only one. -->
        <Style Selector="TextBlock.result">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.result.problem">
            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="20,16,20,16">

        <!--
            No blanket note about sharing here, deliberately. Whether sharing the workspace carries a
            kit depends on WHICH kit: one inside the workspace tree travels with it, one outside does
            not. A single sentence covering both is wrong for one of them, so each row says it for
            itself (see UpdateDetail).
        -->
        <TextBlock Grid.Row="0"
                   Text="Kits this workspace references"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <!-- One row per referenced kit -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <TextBlock x:Name="EmptyMessage"
                           Text="This workspace references no PDKs."
                           FontSize="11"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="False"/>

                <ListBox x:Name="RefList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnSelectionChanged"
                         PointerPressed="OnListPointerPressed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>

        <!-- Detail for the selected row -->
        <TextBlock Grid.Row="2"
                   x:Name="DetailText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="2,8,2,4"
                   MinHeight="30"
                   Opacity="0.85"/>

        <!-- What the last action found. Hidden until there is something to say. -->
        <Border Grid.Row="3"
                x:Name="ResultPanel"
                IsVisible="False"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource CrfTileBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,7"
                Margin="0,0,0,10">
            <StackPanel Spacing="5">
                <TextBlock x:Name="ResultHeadline"
                           Classes="result"
                           FontSize="11"
                           TextWrapping="Wrap"/>
                <!-- Adding or validating a kit READS it, which on a real one is a few hundred
                     milliseconds of file enumeration and netlist parsing. Without this the dialog
                     simply sat there. Indeterminate: the read has no honest denominator. -->
                <ProgressBar x:Name="BusyBar"
                             IsVisible="False"
                             IsIndeterminate="True"
                             Height="3"
                             Margin="0,2,0,0"/>
                <ItemsControl x:Name="ResultLines" IsVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding}"
                                                 FontSize="11"
                                                 Opacity="0.85"
                                                 TextWrapping="Wrap"
                                                 Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <Button Grid.Column="0" x:Name="AddButton"      Content="Add…"      Click="OnAddClick"      HorizontalContentAlignment="Center" MinWidth="76" Margin="0,0,6,0"/>
            <Button Grid.Column="1" x:Name="RemoveButton"   Content="Remove"    Click="OnRemoveClick"   HorizontalContentAlignment="Center" MinWidth="76" Margin="0,0,6,0"/>
            <Button Grid.Column="2" x:Name="RevealButton"   Content="Reveal"    Click="OnRevealClick"   HorizontalContentAlignment="Center" MinWidth="76" Margin="0,0,6,0"/>
            <Button Grid.Column="3" x:Name="ValidateButton" Content="Validate"  Click="OnValidateClick" HorizontalContentAlignment="Center" MinWidth="76"/>
            <Button Grid.Column="5" x:Name="CloseButton"    Content="Close"     Click="OnCloseClick"    HorizontalContentAlignment="Center" MinWidth="76" IsDefault="True" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
