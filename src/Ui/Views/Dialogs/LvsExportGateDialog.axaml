<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.LvsExportGateDialog"
        Title="Layout versus schematic"
        Width="520"
        SizeToContent="Height"
        MinHeight="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- DrcExportGateDialog's own shape (R-lvs12-1e), with one difference on the checkbox: it is
         DEFAULT OFF for LVS, because LVS needs a schematic and an artwork-only export is a
         legitimate thing to do. Like the DRC one, this appears ONLY when the comparison found
         something — a modal that says "the artwork matches" before every export is exactly the
         dialog people learn to dismiss unread. -->
    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="HeadlineLabel"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TechnologyLabel"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"/>

            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="FindingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Opacity="0.85"
                                       TextWrapping="Wrap" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="The export can still go ahead — this comparison reports, it does not block."
                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>

            <CheckBox x:Name="KeepCheckingCheck"
                      Content="Compare layout against schematic before exporting"
                      FontSize="12"
                      IsChecked="False"
                      Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="90"
                    FontSize="12"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    Click="OnCancelClick"/>
            <Button Content="Export Anyway"
                    Width="130"
                    IsDefault="True"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    Click="OnExportClick"/>
        </StackPanel>
    </Grid>
</Window>
