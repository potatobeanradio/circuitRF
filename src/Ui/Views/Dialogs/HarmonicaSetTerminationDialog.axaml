<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaSetTerminationDialog"
        Title="Set Termination"
        Width="320" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!--
    R-h9r2-7's "Set…" — three combined-text rows, each editable in place: Γ (real/imag), Γ (mag/angle),
    Z (real/imag). All three stay in sync live; OK writes through whichever the user typed in last.
  -->

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="14">

    <TextBlock Grid.Row="0" x:Name="MarkerLabel" FontWeight="SemiBold" Margin="0,0,0,10"/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Γ (R + jX)" VerticalAlignment="Center" Width="90" Opacity="0.7"/>
      <TextBox x:Name="GammaRealImagBox" Grid.Column="1"
               TextChanged="OnGammaRealImagChanged" LostFocus="OnFieldLostFocus"/>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Γ (∠)" VerticalAlignment="Center" Width="90" Opacity="0.7"/>
      <TextBox x:Name="GammaMagAngleBox" Grid.Column="1"
               TextChanged="OnGammaMagAngleChanged" LostFocus="OnFieldLostFocus"/>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Z (R + jX)" VerticalAlignment="Center" Width="90" Opacity="0.7"/>
      <TextBox x:Name="ZRealImagBox" Grid.Column="1"
               TextChanged="OnZRealImagChanged" LostFocus="OnFieldLostFocus"/>
    </Grid>

    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancelClick"/>
      <Button Content="OK" Click="OnOkClick" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
