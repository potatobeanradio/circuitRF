<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaSetTerminationDialog"
        Title="Set Termination"
        Width="300" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!--
    R-h9c-7's "Set…" — a small dialog editing one marker's termination in EITHER format: as an
    impedance (R + jX) or as Γ (magnitude ∠ angle). The two groups are kept in sync live, so typing
    in either one moves both; OK writes the final impedance through SetMarkerImpedance, the same
    call a drag uses.
  -->

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="14">

    <TextBlock Grid.Row="0" x:Name="MarkerLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="R (Ω)" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
      <TextBox x:Name="RealBox" Grid.Column="1" Margin="0,0,10,0" TextChanged="OnRealImagChanged"/>
      <TextBlock Grid.Column="2" Text="X (Ω)" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
      <TextBox x:Name="ImagBox" Grid.Column="3" TextChanged="OnRealImagChanged"/>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,10">
      <TextBlock Grid.Column="0" Text="|Γ|" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
      <TextBox x:Name="MagBox" Grid.Column="1" Margin="0,0,10,0" TextChanged="OnMagAngleChanged"/>
      <TextBlock Grid.Column="2" Text="∠ (°)" VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0.7"/>
      <TextBox x:Name="AngleBox" Grid.Column="3" TextChanged="OnMagAngleChanged"/>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancelClick"/>
      <Button Content="OK" Click="OnOkClick" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
