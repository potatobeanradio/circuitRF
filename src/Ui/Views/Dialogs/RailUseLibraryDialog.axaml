<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.RailUseLibraryDialog"
        Title="Use Existing Part Library"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto" Margin="20,16,20,16">

        <SelectableTextBlock Grid.Row="0" x:Name="MessageText" FontSize="12" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" FontSize="12" HorizontalContentAlignment="Center"
                    IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="SecondButton" MinWidth="150" FontSize="12" HorizontalContentAlignment="Center"
                    Click="OnSecondClick"/>
            <Button x:Name="FirstButton" MinWidth="150" FontSize="12" HorizontalContentAlignment="Center"
                    IsDefault="True" Click="OnFirstClick"/>
        </StackPanel>

    </Grid>
</Window>
