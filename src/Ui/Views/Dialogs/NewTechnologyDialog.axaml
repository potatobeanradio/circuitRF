<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.NewTechnologyDialog"
        Title="New Technology"
        Width="420"
        SizeToContent="Height"
        MinHeight="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Technology name:" FontSize="12"/>
            <TextBox x:Name="NameBox"
                     FontSize="12"
                     MaxLength="200"
                     TextChanged="OnNameChanged"
                     KeyDown="OnKeyDown"/>
            <TextBlock x:Name="ValidationMessage"
                       FontSize="11"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       IsVisible="False"
                       TextWrapping="Wrap"/>

            <TextBlock Text="Starting point:" FontSize="12" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton x:Name="StarterPcbRadio"   GroupName="Starter" Content="PCB (2-layer)" FontSize="12" IsChecked="True"/>
                <RadioButton x:Name="StarterPcb4Radio"  GroupName="Starter" Content="PCB (4-layer)" FontSize="12"/>
                <RadioButton x:Name="StarterMmicRadio"  GroupName="Starter" Content="MMIC starter"  FontSize="12"/>
                <RadioButton x:Name="StarterEmptyRadio" GroupName="Starter" Content="Empty"         FontSize="12"/>
            </StackPanel>

            <CheckBox x:Name="SetAsDefaultCheck"
                      Content="Set as workspace default"
                      FontSize="12"
                      Margin="0,4,0,0"/>

            <TextBlock x:Name="PreviewLabel"
                       FontSize="11"
                       Opacity="0.7"
                       IsVisible="False"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="80"
                    FontSize="12"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    Click="OnCancelClick"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    IsDefault="True"
                    IsEnabled="False"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    Click="OnOkClick"/>
        </StackPanel>

    </Grid>
</Window>
