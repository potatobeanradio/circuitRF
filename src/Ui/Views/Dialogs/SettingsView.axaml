<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dlg="clr-namespace:CircuitRF.Ui.Views.Dialogs"
        xmlns:dialogs="clr-namespace:CircuitRF.Ui.Views.Dialogs"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Dialogs.SettingsView"
        Title="circuitRF Settings"
        Width="720"
        Height="640"
        MinWidth="720"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="14">

        <!-- Button.ToolActive — copied from LayoutEditorView.axaml so the Theme buttons are the same
             control the Layout Editor's tool buttons are, down to the accent fill. Scoped, never a
             global selector: this dialog is not the only place Buttons live.

             ON THE CONTENT ROOT AND NOT ON Window.Styles, and that is not cosmetic: the User-Docs
             factory LIFTS this Grid out of the window and hosts it elsewhere (a Window cannot live
             inside another Window), so a style declared on the Window stops applying the moment the
             figure is captured — the active button would be drawn unaccented in the documentation
             while being accented in the application, with nothing failing anywhere. -->
        <Grid.Styles>
            <Style Selector="Button.ToolActive">
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style Selector="Button.ToolActive /template/ ContentPresenter">
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColor}"/></Setter.Value>
                </Setter>
            </Style>
            <Style Selector="Button.ToolActive:pointerover /template/ ContentPresenter">
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/></Setter.Value>
                </Setter>
            </Style>
        </Grid.Styles>

        <!-- ── Tabs ───────────────────────────────────────────────────────── -->
        <TabControl Grid.Row="0" Name="Tabs">

            <!-- TabControl's DEFAULT ItemsPanel is a WrapPanel, so headers that do not fit SPILL ONTO
                 A SECOND ROW — they do not clip, and nothing errors. That is exactly how four headers
                 silently became two rows in TechEditorView as its window narrowed, and adding a fifth
                 header here brings this dialog to the same edge. The fix is the one already in the
                 tree at TechEditorView.axaml: a horizontal StackPanel keeps them on one row
                 unconditionally, and the scoped TabItem style then pins the size explicitly rather
                 than inheriting the theme's Pivot-scale header metrics — because the panel alone makes
                 one row a PROMISE and the style is what makes it a FIT.

                 SCOPED to this TabControl's own Styles, never a global TabItem selector: this dialog
                 is not the only TabControl in the application.

                 BOTH HALVES ARE NECESSARY HERE, and that was MEASURED at MinWidth="620" rather than
                 assumed — a tab strip that fits at 720 and wraps at 620 is the same defect arriving
                 later. On the theme's own header metrics the five headers measure 850 px against
                 592 px of usable width, and under the default WrapPanel "Color Theme" and "Wirebonds"
                 duly land on a SECOND ROW, silently. TechEditorView's values below bring them to
                 529 px, one row, 63 px spare.

                 (Those per-header widths also say the four-tab dialog was ALREADY over the line
                 before this tab existed: 656 px against 592. It fitted at the 720 default and spilled
                 as the window narrowed, which is exactly the failure TechEditorView records — nobody
                 had looked at 620.)

                 MinWidth IS 720 BECAUSE OF THE SIXTH HEADER, and that was measured too, on the same
                 headless harness: with the style below, General/Technology/Security & Permissions/
                 Revision Control/Color Theme/Wirebonds measure 68/91/158/119/99/85 = 620 px. The old
                 MinWidth="620" leaves 592 px usable, so the strip overran it by 28 px — and because
                 the ItemsPanel is a StackPanel the overrun CLIPS rather than wraps, so the symptom
                 would have been a "Wirebond" header with its last letters missing, at a width the
                 user chose and nobody tests at. 720 leaves 692 px usable, 72 px spare. The window
                 can no longer be dragged narrower than its own tab strip, which is the honest
                 constraint; a seventh header will need this number raised again, or shorter names.

                 The SEVENTH header took the second route: "Solvers" (brief-em3d-6, first headed "3D EM"),
                 estimated at ~66 px, ~6 px spare — see that tab's own comment for how the estimate was
                 made and that it was not measured. An eighth header will not fit at 720. -->
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
                <!-- Fluent's TabItem draws the selection pipe in the SAME Panel as the header text,
                     bottom-aligned with a 2 px margin. The theme's MinHeight of 48 leaves room below
                     the centred text; with MinHeight 0 that Panel is only as tall as the text, so the
                     pipe of the selected tab crosses its descenders. A bottom margin on the header
                     keeps a strip below the text for the pipe. Heights only: the widths measured
                     above are unchanged. -->
                <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </TabControl.Styles>

            <!-- ── General tab ────────────────────────────────────────────── -->
            <TabItem Header="General">
                <!-- Owner request (designer feedback round 25): the page is grouped the way the Solvers tab is —
                     each subject in its own Border.group box, two boxes to a row so the whole page fits the
                     dialog's default height with no scroll bar. The ScrollViewer stays for a window the user
                     has made SHORTER than that. Boxes on one row share its height (Grid rows stretch them).
                     Labels sit in a 110 px column so every ComboBox in a box starts at the same x. -->
                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                        <Grid.Styles>
                            <Style Selector="Border.group">
                                <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CrfTileBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                            <Style Selector="TextBlock.groupTitle">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                        </Grid.Styles>

                        <!-- On Launch -->
                        <Border Grid.Row="0" Grid.Column="0" Classes="group">
                            <StackPanel>
                                <TextBlock Classes="groupTitle" Text="On Launch"/>
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Action:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                          Name="LaunchActionCombo" FontSize="12" MinWidth="180"
                                          SelectionChanged="OnLaunchSettingChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Window Layout:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                                          Name="WindowLayoutCombo" FontSize="12" MinWidth="180"
                                          SelectionChanged="OnLaunchSettingChanged"/>
                                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2"                                           Name="ShowDockersOnLaunchCheck" FontSize="12"
                                          Content="Show Dockers"
                                          IsCheckedChanged="OnShowDockersOnLaunchChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Appearance: the light/dark VARIANT (not the Color Theme tab's palette — every palette
                             carries both variants and the two compose), and whether a .c3d opens in the realistic
                             view, which is a property of this machine's GPU rather than of the design
                             (Realistic3DPreference), and likewise whether a 3D view with no usable GPU interop draws
                             in software (View3DSoftwarePresent; Linux only, the one renderer that can, so the
                             macOS-generated settings figure is unchanged). The theme buttons are radio buttons in the Layout Editor's
                             toolbar-button clothes; SyncThemeButtons sets the active one's Button.ToolActive. -->
                        <Border Grid.Row="0" Grid.Column="2" Classes="group">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupTitle" Text="Appearance"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Theme:" FontSize="12" VerticalAlignment="Center" Width="110"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Name="ThemeSystemBtn" Click="OnThemeModeClick" Tag="System"
                                    ToolTip.Tip="System" Padding="6,3">
                                    <mi:MaterialIcon Kind="ThemeLightDark" Width="16" Height="16"/>
                                    </Button>
                                    <Button Name="ThemeLightBtn" Click="OnThemeModeClick" Tag="Light"
                                    ToolTip.Tip="Light" Padding="6,3">
                                    <mi:MaterialIcon Kind="WhiteBalanceSunny" Width="16" Height="16"/>
                                    </Button>
                                    <Button Name="ThemeDarkBtn" Click="OnThemeModeClick" Tag="Dark"
                                    ToolTip.Tip="Dark" Padding="6,3">
                                    <mi:MaterialIcon Kind="WeatherNight" Width="16" Height="16"/>
                                    </Button>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox  Name="RealisticOnOpenCheck" FontSize="12"
                                          Content="Open 3D designs in realistic view"
                                          IsCheckedChanged="OnRealisticOnOpenChanged"
                                          ToolTip.Tip="Opens every 3D design with the realistic view already on, as if you had pressed its toolbar button. The look itself — environment, exposure, edges, grid — is saved in each design. Leave this off on a machine whose graphics card makes the realistic view slow; the toolbar button still turns it on for one design."/>
                                <CheckBox  Name="SoftwarePresentCheck" FontSize="12" IsVisible="{OnPlatform False, Linux=True}"
                                          Content="Software 3D without GPU interop"
                                          IsCheckedChanged="OnSoftwarePresentChanged"
                                          ToolTip.Tip="Where the window cannot show the graphics card's 3D frames directly — a remote desktop, a virtual machine, a session without GPU acceleration — copies each frame back and draws it in software, more slowly. Turn it off to have the 3D view say so instead. Takes effect when a 3D view next opens."/>
                            </StackPanel>
                        </Border>

                        <!-- Copy / Export -->
                        <Border Grid.Row="2" Grid.Column="0" Classes="group">
                            <StackPanel>
                                <TextBlock Classes="groupTitle" Text="Copy / Export"/>
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Copy color:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                                          Name="CopyColorCombo" FontSize="12" MinWidth="180"
                                          SelectionChanged="OnCopyColorChanged"/>
                                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2"                                           Name="TransparentBgCheck"
                                          Content="Transparent background" FontSize="12"
                                          IsCheckedChanged="OnTransparentBgChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Messages -->
                        <Border Grid.Row="2" Grid.Column="2" Classes="group">
                            <StackPanel>
                                <TextBlock Classes="groupTitle" Text="Messages"/>
                                <Grid ColumnDefinitions="110,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Timestamps:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Name="MsgTimestampCombo"
                                          FontSize="12" MinWidth="180"
                                          SelectionChanged="OnMsgTimestampChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Design Rules — R16d's own "not mandatory, not silent"; also reachable from the
                             pre-export prompt itself. brief-lvs-12-gui.md R-lvs12-1e: the LVS offer is DEFAULT OFF —
                             LVS needs a schematic, and exporting artwork alone is a legitimate thing to do. -->
                        <Border Grid.Row="4" Grid.Column="0" Classes="group">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="groupTitle" Text="Design Rules"/>
                                <CheckBox  Name="CheckDrcOnExportCheck"
                                          Content="Run DRC before exporting" FontSize="12"
                                          IsCheckedChanged="OnCheckDrcOnExportChanged"
                                          ToolTip.Tip="Runs a design-rule check before writing GDSII, DXF or Gerber. A clean design exports with no interruption; violations are shown first and the export can still go ahead."/>
                                <CheckBox  Name="CheckLvsOnExportCheck"
                                          Content="Run LVS before exporting" FontSize="12"
                                          IsCheckedChanged="OnCheckLvsOnExportChanged"
                                          ToolTip.Tip="Compares this cell's artwork against its schematic before writing GDSII, DXF or Gerber. Off by default, because an artwork-only export is a legitimate thing to do and LVS needs a drawing to compare against."/>
                            </StackPanel>
                        </Border>

                        <!-- Layout. Link orientation — designer report (round 15): the schematic and the layout
                             may be drawn independently. The ruler combo's index == RulerSizeMode ordinal, which is
                             serialized as a number in preferences.json. -->
                        <Border Grid.Row="4" Grid.Column="2" Classes="group">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupTitle" Text="Layout"/>
                                <CheckBox  Name="LinkOrientationCheck"
                                          Content="Link symbol and footprint orientation" FontSize="12"
                                          IsCheckedChanged="OnLinkOrientationChanged"
                                          ToolTip.Tip="On: turning a symbol turns its footprint at the next Update Layout from Schematic, and Create Schematic from Artwork draws each shunt part on the side of its line its copper is on. Off: the schematic and the layout are arranged independently."/>
                                <CheckBox  Name="ConnectPartsCheck"
                                          Content="Connect parts on Update Layout from Schematic" FontSize="12"
                                          IsCheckedChanged="OnConnectPartsChanged"
                                          ToolTip.Tip="On: lines, tees, bends and crosses the schematic joins are placed so their pins meet, and a loop that does not close is reported. Off: every new part is placed in rows, and the ratsnest shows what joins what."/>
                                <CheckBox  Name="EmSetupOnUpdateCheck"
                                          Content="Create or update EM setup on Update Layout from Schematic" FontSize="12"
                                          IsCheckedChanged="OnEmSetupOnUpdateChanged"
                                          ToolTip.Tip="On: a layout with no EM setup gets one, with the schematic's port impedances and S-parameter sweep; a layout that has setups gets an impedance for each new port number. An impedance set in a setup by hand is never changed."/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Default Ruler Size Mode:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox  Name="DefaultRulerSizeModeCombo" FontSize="12" MinWidth="100"
                                          SelectionChanged="OnDefaultRulerSizeModeChanged"
                                          ToolTip.Tip="The size mode a ruler starts in when it is placed. Fixed: its readout is the same size on screen at every zoom. Scaled: its readout is a height in the layout and grows and shrinks with the artwork. Rulers already placed keep their own mode."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Units — brief-dfr22-1. The unit circuitRF chooses for something NEW; index 0 is
                             Automatic (null in preferences.json), the rest are PreferredUnits' choices in order,
                             stored by NAME. Length also sets the unit the Gerber arc tolerance is shown in. -->
                        <Border Grid.Row="6" Grid.Column="0" Classes="group">
                            <StackPanel>
                                <TextBlock Classes="groupTitle" Text="Units"/>
                                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="6"
                                      ToolTip.Tip="Used for new workspaces, layouts, analyses and plots; any document can still choose its own.">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Length:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Name="PreferredLengthUnitCombo"
                                          FontSize="12" MinWidth="180"
                                          SelectionChanged="OnPreferredLengthUnitChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency:" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Name="PreferredFrequencyUnitCombo"
                                          FontSize="12" MinWidth="180"
                                          SelectionChanged="OnPreferredFrequencyUnitChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gerber Import (owner: the two Gerber-specific settings together). Coalesce — R-rf3-7, ON by default: an imported board whose pours arrived as
                             tens of thousands of painted scanlines is neither editable copper nor meshable; the
                             switch is for comparing an import against its CAM source or chasing an import bug.
                             Arc tolerance — designer feedback round 25: shown in the Units box's Length unit,
                             stored in microns; GerberImport.DefaultArcToleranceMicrons when unset. -->
                        <Border Grid.Row="6" Grid.Column="2" Classes="group">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="groupTitle" Text="Gerber Import"/>
                                <CheckBox  Name="CoalesceRasterFillCheck"
                                          Content="Coalesce imported painted fill into regions" FontSize="12"
                                          IsCheckedChanged="OnCoalesceRasterFillChanged"
                                          ToolTip.Tip="Some CAM tools paint a copper pour as thousands of abutting strokes instead of one filled region. Importing Gerber or a board file turns those back into the region they paint, which is the shape that draws quickly, meshes for EM and checks against design rules. Turn it off to get the primitives exactly as they were authored — the import reports every layer it coalesces either way."/>
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            ToolTip.Tip="How far a straight segment may stray from a curve when a Gerber import turns an arc into straight segments: round pads and strokes, arcs in pours, holes and thermals. Smaller follows the curve more closely and makes the layout much larger and slower; 1 µm is far finer than any PCB process. Applies to the next import.">
                                    <TextBlock Text="Gerber arc tolerance:" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBox   Name="GerberArcToleranceBox" FontSize="12" Width="80"
                                               LostFocus="OnGerberArcToleranceLostFocus"
                                               KeyDown="OnGerberArcToleranceKeyDown"/>
                                    <TextBlock Name="GerberArcToleranceUnit" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── Technology tab ─────────────────────────────────────────────
                 Immediately after General, and before the three administrative tabs. What is on it is
                 about the DESIGNS you make — which technologies File ▸ New Workspace offers, and which
                 one it opens on — and that is the same kind of thing General is about. Security,
                 Revision Control and Color Theme are about what the application is permitted to do and
                 what it looks like; a designer looking for "where do I put my fab's stackup" will not
                 look under any of them.

                 The controls and their handlers live in TechnologySettingsView, as Revision Control's
                 do, so this file stays about which tabs exist rather than about what is on them. The
                 RULES — what is offered, what an id collision means, what the default falls back to —
                 are below the firewall in TechnologyCatalog, because `circuitrf new workspace` has to
                 reach the same answers with no display attached. -->
            <TabItem Header="Technology">
                <dlg:TechnologySettingsView Margin="0,8,0,0"/>
            </TabItem>

            <!-- ── Security & Permissions tab ─────────────────────────────────
                 Everything that decides what circuitRF is allowed to RUN or to FETCH lives here,
                 rather than being spread across the tab a feature happened to arrive in. Automatic
                 updates moved out of General for that reason (owner, 2026-08-25): the checkbox that
                 governs whether the application downloads and installs code from the internet is a
                 security setting first and a convenience second, and a user auditing what this
                 binary is permitted to do should find it in one place. -->
            <TabItem Header="Security &amp; Permissions">
                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0">

                        <!-- External PDKs: which kits may run their own artwork scripts, one row per
                             kit (PCellTrustSettingsView). The controls and their handlers live there,
                             as the workers' and updates' do below. -->
                        <dlg:PCellTrustSettingsView/>

                        <!-- External device workers. The OTHER kind of program a kit can make
                             circuitRF run: pcell-generators.json ships scripts, device-provider.json
                             ships a worker, and until 2026-08-25 only the first of the two asked.
                             Same one-control-two-hosts arrangement as the Updates section below. -->
                        <dlg:ExternalWorkerSettingsView Margin="0,24,0,0"/>

                        <!-- Updates. The controls and their handlers live in UpdateSettingsView so
                             that harmonicaRF's own dialog — which does not use SettingsView at all —
                             hosts the SAME implementation rather than a second copy of it. Both read
                             and write the same two AppPreferences properties; neither owns them. -->
                        <dlg:UpdateSettingsView Margin="0,24,0,0"/>

                        <!-- The Verilog-A compiler, LAST on this tab (owner, 2026-09-03). It belongs
                             here at all because it names a program circuitRF is permitted to RUN,
                             which is the question this tab answers — but it is the one control here
                             that most users never touch (blank means "use PATH"), so it sits below
                             the two that govern what runs without being asked. -->
                        <dlg:VerilogACompilerSettingsView Margin="0,24,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Revision Control tab ───────────────────────────────────────
                 Immediately to the right of Security & Permissions (owner, 2026-09-06), and a tab of
                 its own rather than a section on that one. Security & Permissions answers exactly one
                 question — what circuitRF is allowed to RUN and to FETCH — and its own header records
                 that things were collected there for that SHAPE rather than for the tab they arrived
                 in. Naming a git executable is the only row here that would fit it; the other nine are
                 about what is KEPT, and a designer looking for "how long are my restore points kept"
                 will not look under Security.

                 SHOWN ON EVERY MACHINE, whether or not there is a git (owner, 2026-09-07). §4.3 as
                 first written hid the whole tab when git was absent, so that absence stayed silent —
                 and hiding it also hid the fact that circuitRF CAN keep a history and is not keeping
                 one here, which is the same false belief the design is written against reached from
                 the other side. Without a git the rows are greyed and one sentence says why; the git
                 path and its Detect stay live, because they are the remedy. See
                 RevisionTabAvailability. -->
            <TabItem Header="Revision Control" Name="RevisionTab">
                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <dlg:RevisionControlSettingsView Name="RevisionSettings"/>
                </ScrollViewer>
            </TabItem>

            <!-- ── Color Theme tab ────────────────────────────────────────── -->
            <TabItem Header="Color Theme">
                <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">

                    <!-- Theme selector row -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <!-- Variant toggle (right-docked first so it doesn't collapse) -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <RadioButton Name="LightRadio" Content="Light"
                                         GroupName="Variant" Click="OnVariantChanged" FontSize="12"/>
                            <RadioButton Name="DarkRadio"  Content="Dark"
                                         GroupName="Variant" Click="OnVariantChanged" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Color Theme:" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Name="ThemeCombo" FontSize="12" MinWidth="140"
                                      SelectionChanged="OnThemeComboChanged"/>
                            <Button Name="SaveThemeButton" Content="Save Theme…" FontSize="12"
                                    Click="OnSaveThemeClick" Padding="8,4"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main editor panel -->
                    <Grid Grid.Row="1" ColumnDefinitions="200,10,*">

                        <!-- Role list -->
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <ListBox Name="RoleList"
                                     SelectionMode="Single"
                                     SelectionChanged="OnRoleSelected"
                                     DoubleTapped="OnRoleDoubleTapped"
                                     FontSize="11.5"
                                     Padding="2">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="dialogs:RoleRowModel">
                                        <StackPanel Orientation="Horizontal" Spacing="7" Margin="2,1">
                                            <Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2"
                                                       VerticalAlignment="Center">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="{Binding SwatchColor}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Color editor (right panel) -->
                        <StackPanel Grid.Column="2" Spacing="10">

                            <!-- Color preview swatch -->
                            <Border CornerRadius="4" ClipToBounds="True" Height="40">
                                <Rectangle Name="ColorPreviewRect"/>
                            </Border>

                            <!-- RGBA sliders + linked integer edit boxes -->
                            <Grid ColumnDefinitions="14,*,46" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <Slider    Grid.Row="0" Grid.Column="1" Name="SliderR" Minimum="0" Maximum="255"
                                           IsSnapToTickEnabled="True" TickFrequency="1"
                                           ValueChanged="OnSliderChanged" Margin="6,0"/>
                                <TextBox   Grid.Row="0" Grid.Column="2" Name="LabelR"
                                           FontSize="12" Width="42" MaxLength="3" TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Courier New,Consolas,monospace"
                                           LostFocus="OnRgbaBoxLostFocus" KeyDown="OnRgbaBoxKeyDown"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <Slider    Grid.Row="1" Grid.Column="1" Name="SliderG" Minimum="0" Maximum="255"
                                           IsSnapToTickEnabled="True" TickFrequency="1"
                                           ValueChanged="OnSliderChanged" Margin="6,0"/>
                                <TextBox   Grid.Row="1" Grid.Column="2" Name="LabelG"
                                           FontSize="12" Width="42" MaxLength="3" TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Courier New,Consolas,monospace"
                                           LostFocus="OnRgbaBoxLostFocus" KeyDown="OnRgbaBoxKeyDown"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <Slider    Grid.Row="2" Grid.Column="1" Name="SliderB" Minimum="0" Maximum="255"
                                           IsSnapToTickEnabled="True" TickFrequency="1"
                                           ValueChanged="OnSliderChanged" Margin="6,0"/>
                                <TextBox   Grid.Row="2" Grid.Column="2" Name="LabelB"
                                           FontSize="12" Width="42" MaxLength="3" TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Courier New,Consolas,monospace"
                                           LostFocus="OnRgbaBoxLostFocus" KeyDown="OnRgbaBoxKeyDown"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                                <Slider    Grid.Row="3" Grid.Column="1" Name="SliderA" Minimum="0" Maximum="255"
                                           IsSnapToTickEnabled="True" TickFrequency="1"
                                           ValueChanged="OnSliderChanged" Margin="6,0"/>
                                <TextBox   Grid.Row="3" Grid.Column="2" Name="LabelA"
                                           FontSize="12" Width="42" MaxLength="3" TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontFamily="Courier New,Consolas,monospace"
                                           LostFocus="OnRgbaBoxLostFocus" KeyDown="OnRgbaBoxKeyDown"/>

                            </Grid>

                            <!-- Hex input -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="#" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Width="14"/>
                                <TextBox Name="HexBox" FontSize="12" Width="88" MaxLength="8"
                                         LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown"
                                         FontFamily="Courier New,Consolas,monospace"/>
                            </StackPanel>

                            <!-- Role path label -->
                            <TextBlock Name="RoleNameLabel" FontSize="10.5" Opacity="0.5"/>

                        </StackPanel>
                    </Grid>

                </Grid>
            </TabItem>

            <!-- ── Wirebonds tab ──────────────────────────────────────────── -->
            <TabItem Header="Wirebonds">
                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="0">

                        <!-- wbond.md §6.4's creation defaults. Per USER, not per design: they
                             describe how one shop's bonder is set up, and a .wBond arriving from
                             someone else must not change what the next wire you draw looks like. -->
                        <TextBlock Text="Wirebonds" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.55" Margin="0,0,0,6"/>
                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,6,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Points per wire:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Name="WBondPointsUpDown"
                                           Minimum="3" Maximum="101" Increment="1" FormatString="0"
                                           Width="110" HorizontalAlignment="Left" FontSize="12"
                                           ValueChanged="OnWBondPointsChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Wire diameter:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Name="WBondDiameterUpDown" Minimum="0.05" Maximum="20"
                                               Increment="0.1" FormatString="0.###"
                                               Width="110" FontSize="12"
                                               ValueChanged="OnWBondDiameterChanged"/>
                                <TextBlock Text="mil" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Wire material:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Name="WBondMaterialCombo"
                                      Width="150" HorizontalAlignment="Left" FontSize="12"
                                      SelectionChanged="OnWBondMaterialChanged"/>

                            <!-- Wire z-height (owner, 2026-08-17). Minimum is deliberately NEGATIVE and
                                 zero is a real value: a foot at z=0 lands on the reference plane and a
                                 negative one sits in a cavity below it. Both are geometry someone bonds,
                                 which is why this preference alone treats "absent" and "zero" as
                                 different things. -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Wire z-height:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Name="WBondFootZUpDown" Minimum="-100" Maximum="1000"
                                               Increment="1" FormatString="0.###"
                                               Width="110" FontSize="12"
                                               ValueChanged="OnWBondFootZChanged"/>
                                <TextBlock Text="mil" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Paste pitch:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Name="WBondPastePitchUpDown" Minimum="0.1" Maximum="1000"
                                               Increment="1" FormatString="0.###"
                                               Width="110" FontSize="12"
                                               ValueChanged="OnWBondPastePitchChanged"/>
                                <TextBlock Text="mil" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>

                            <TextBlock Grid.Row="9" Grid.Column="1" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Applies to newly drawn wires. Existing wires keep whatever they were drawn with. Nudge steps stay 1 mil / 5 mil — those are bonder-process quantities, not display settings.&#10;Wire z-height is where BOTH feet of a new wire land — a wire drawn in the layout view, and the wire a new wBond component is created with. The profile view is unaffected: there you click the height you want.&#10;Paste pitch places a pasted wire clear of what is already there, stepping in +y until it lands free. It never re-spaces the wires on the clipboard."/>
                        </Grid>

                        <!-- The built-in assembly rule set's one number. It lives on the WIREBONDS tab
                             rather than beside "Run DRC before exporting" because what a
                             user is looking for here is a wire dimension, and it sits next to the
                             other four. -->
                        <TextBlock Text="Design Rules" FontSize="11" FontWeight="SemiBold"
                                   Opacity="0.55" Margin="0,20,0,6"/>
                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Wire clearance:"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Name="WireClearanceUpDown" Minimum="0" Maximum="100"
                                               Increment="0.1" FormatString="0.###"
                                               Width="110" FontSize="12"
                                               ValueChanged="OnWireClearanceChanged"/>
                                <TextBlock Text="mil" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Opacity="0.6"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="circuitRF's built-in assembly rule: how close two wires may pass, measured surface to surface between their outer edges. Reported as an error by a design-rule check, whether or not a .wasm assembly rule file is referenced — a house's rule file is not what makes overlapping metal invalid. Zero reports only wires that actually touch or overlap. A .wasm's own spacing rules are checked as well as this one, never instead of it."/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Solvers tab (brief-em3d-6 R-em3d6-4a; renamed from "3D EM", owner, 2026-10-04) ──
                 LAST, so no per-tab figure index above it moves. One row per program a 3D EM run can
                 need — Palace, Gmsh, openEMS — each saying what was found, where, which version,
                 whether circuitRF has validated it and how it was found. The controls live in
                 Em3dSolverSettingsView, as Revision Control's and Technology's do; its own heading
                 still reads "3D EM Solvers".

                 The header is short because of the tab strip's width (see the note at the top of this
                 TabControl): the six headers before it measured 620 px against 692 usable at MinWidth
                 720. "Solvers" at FontSize 13 is ~45.6 px of Inter Regular advances (~47 px SemiBold),
                 against ~40.6 px for the old "3D EM" — so about 66 px with padding, leaving roughly
                 6 px spare. ESTIMATED from the Inter glyph advances that reproduce "Wirebonds"' and
                 "General"'s measured widths, NOT measured on the headless harness. -->
            <TabItem Header="Solvers">
                <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <dlg:Em3dSolverSettingsView/>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ── Footer buttons (shared across all tabs) ─────────────────────
             Help at the leading edge and everything that ACTS on the dialog at the trailing one,
             which is the platform convention on all three operating systems. Revert moved across
             to join them (owner, 2026-09-03): it is a destructive action on the settings, and the
             bottom-left corner is where a reader looks for the documentation, not for a button
             that throws their edits away. -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Name="HelpButton" Content="Help" FontSize="12"
                    Click="OnHelpClick" Padding="8,4"
                    ToolTip.Tip="Open the Settings chapter of the circuitRF User Documentation"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Revert" FontSize="12" Padding="8,4"
                        HorizontalContentAlignment="Center" Click="OnRevertClick"/>
                <Button Content="Cancel" FontSize="12" Width="80"
                        HorizontalContentAlignment="Center" Click="OnCancelClick"/>
                <Button Content="Close"  FontSize="12" Width="80" IsDefault="True"
                        Classes="accent" HorizontalContentAlignment="Center" Click="OnCloseClick"/>
            </StackPanel>
        </DockPanel>

    </Grid>
</Window>
