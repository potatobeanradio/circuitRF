<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.KeepThisVersionDialog"
        Title="Keep This Version"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Margin="16" Spacing="10">

    <!-- Owner, 2026-09-07: three sentences cut to one. "What you come back to, and what you send
         out" and "six weeks from now the title is the only thing…" were the dialog explaining its own
         value to somebody who has already chosen to use it — which is text a designer skips, and text
         that gets skipped makes the field beneath it harder to find rather than easier.

         The useful half of the deleted hint is now the FIELD LABEL: "what changed" is the whole of
         "write what changed, not what you did", in two words, in the place a person is already
         looking. -->
    <TextBlock Text="Records this workspace as a version, under a title you write."
               TextWrapping="Wrap" />

    <StackPanel Spacing="4">
      <TextBlock Text="What changed?" FontSize="11" Opacity="0.75" />
      <TextBox x:Name="TitleBox" PlaceholderText="Output match retuned for 3.5 GHz" />
    </StackPanel>

    <!-- §5.12. THE TITLE IS ONE LINE AND SOME DECISIONS NEED A PARAGRAPH. What was tried first, what
         the measurement said, which of two options this is and why — none of that fits in the line a
         designer scans for, and none of it can be recovered from the files afterwards.

         Behind an expander, and closed by default, for the reason the escape hatch below it is: most
         versions do not need one, and a second field in front of every designer would make the one
         that matters harder to reach rather than easier. The keyboard path is unchanged — Tab from the
         title reaches the expander's own header. -->
    <Expander x:Name="NoteExpander" Header="Add more detail (optional)" FontSize="11" Classes="fill">
      <StackPanel Spacing="4" Margin="2,6,2,4">
        <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="90" MaxHeight="200"
                 HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PlaceholderText="Series inductor moved to the drain side; the 3.9 pF shunt was measured 0.4 dB better than the 4.7 pF and the band edge is now flat to 3.7 GHz." />
        <!-- It is not a second title. A designer who writes nothing here loses nothing, and the entry
             is written exactly as it was before this field existed. -->
        <TextBlock FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                   Text="This is kept with the version and travels with it. You can correct it later." />
      </StackPanel>
    </Expander>

    <!-- R-rc7-6. A restore since the last version is recorded in this one, and the designer is told
         so BEFORE they press the button rather than discovering it in the list afterwards. Two
         consecutive versions where the second reverts the first read as a change of mind with no
         record of the moment; this is the line that stops that. -->
    <Border x:Name="RestoredPanel" IsVisible="False"
            Background="{DynamicResource SystemChromeLowColor}"
            CornerRadius="3" Padding="10,8">
      <TextBlock x:Name="RestoredText" TextWrapping="Wrap" FontSize="11" />
    </Border>

    <!-- R-rc7-21. §8.3's escape hatch, in plain language, beside the action a user would look for it
         from. History rewriting is the only real remedy for something already recorded, circuitRF
         must not offer a button for it, and a user who genuinely needs it should be TOLD rather than
         left to conclude the application has no answer — which is how somebody ends up deleting the
         whole history and losing everything else with it.

         Collapsed by default: it is the answer to a question most designers never ask, and putting it
         in front of every version would make the ordinary case read as a warning. -->
    <Expander Header="What if something should not have gone in?" FontSize="11">
      <TextBlock x:Name="RewritingText" TextWrapping="Wrap" FontSize="11" Margin="0,4"
                 MaxWidth="560" HorizontalAlignment="Left" />
    </Expander>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" />
      <Button x:Name="KeepButton"   Content="Keep"   Click="OnKeep"   IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
