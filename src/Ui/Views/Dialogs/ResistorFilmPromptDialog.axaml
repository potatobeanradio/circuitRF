<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.ResistorFilmPromptDialog"
        Title="Resistor film"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="16" Spacing="8" MinWidth="300" MaxWidth="380">
        <TextBlock x:Name="PromptText" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel x:Name="NameRow" Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Name:" Width="110" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="NameBox" Width="140" FontSize="12" TextChanged="OnChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Sheet resistance:" Width="110" VerticalAlignment="Center" FontSize="12"/>
            <TextBox x:Name="ValueBox" Width="80" FontSize="12" PlaceholderText="e.g. 50" TextChanged="OnChanged"/>
            <TextBlock Text="Ω/sq" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
