<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.FootprintPickerDialog"
        Title="Place Footprint"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="20,16,20,16">

        <TextBlock Grid.Row="0" FontSize="12" Opacity="0.7" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Choose a land pattern to place. Every case size reads its metric twin and its body size, because two real case sizes are spelled 0201."/>

        <ListBox x:Name="CaseList" Grid.Row="1" MaxHeight="300" FontSize="12"/>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,10,0,0">
            <TextBlock Grid.Column="0" Text="Density" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
            <ComboBox x:Name="DensityCombo" Grid.Column="1" HorizontalAlignment="Left" FontSize="12"
                      ToolTip.Tip="IPC-7351B density level — Most, Nominal or Least land protrusion."/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center"/>
            <Button x:Name="OkButton" Content="Place" Width="80" IsDefault="True" FontSize="12" HorizontalContentAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
