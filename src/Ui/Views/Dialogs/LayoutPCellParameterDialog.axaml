<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.ViewModels"
        xmlns:props="using:CircuitRF.Ui.Views.Properties"
        x:Class="CircuitRF.Ui.Views.Dialogs.LayoutPCellParameterDialog"
        x:DataType="vm:LayoutShapePropertiesViewModel"
        Title="Component Properties"
        Width="380"
        MinWidth="320"
        MinHeight="220"
        MaxHeight="720"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Undo/Redo act on the LAYOUT EDITOR's own stack — this dialog has no independent stack.
         A PCell parameter commit routes through LayoutEditorViewModel.EditInstancePCellParameters
         (R-L5-2's copy-on-write), so an edit made here is undoable exactly as it is from the docked
         Properties panel or the layout canvas itself — mirrors ParameterEditorDialog's own
         Undo/Redo-delegates-to-the-owning-document convention. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z"       Command="{Binding EditorVm.UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"       Command="{Binding EditorVm.UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding EditorVm.RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding EditorVm.RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"       Command="{Binding EditorVm.RedoCommand}"/>
    </Window.KeyBindings>

    <!-- TWO sections, in the docked panel's own order: what the placement IS, then what its
         generator takes. Before the owner's 2026-09-20 report this window hosted the parameter list
         ALONE, which is empty for a built-in land pattern (a generated cell that declares no
         parameters — its case and its density are its identity, R-fp1-4c), so double-clicking a
         capacitor footprint opened a window showing a "Parameters" header over nothing. Both
         sections are the SAME controls the docked Properties panel embeds, never a second
         implementation of either; the parameter list carries its own visibility (ShowPCellParameterList
         is already false when the rows are empty) so a footprint gets the instance surface with no
         empty header under it, and a microstrip PCell gets both. -->
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="10">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="440">
            <props:LayoutInstancePropertiesView IsEnabled="{Binding IsEditingEnabled}"/>
        </ScrollViewer>
        <props:PCellParameterListView Grid.Row="1" IsVisible="{Binding ShowPCellParameterList}"
                                      MaxHeight="220" Margin="0,6,0,0"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
            <Button Content="Close" FontSize="11" Padding="10,4" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>

</Window>
