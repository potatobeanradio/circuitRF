<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.Ipc2581StepDialog"
        Title="Import IPC-2581 — Which Step?"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20,16,20,16">

        <TextBlock Grid.Row="0" FontSize="12" TextWrapping="Wrap"
                   Text="This file holds more than one step. Choose the one to import."/>

        <ListBox Grid.Row="1" x:Name="StepList" Margin="0,10,0,0" MaxHeight="240"
                 DoubleTapped="OnStepDoubleTapped"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Width="90" FontSize="12" HorizontalContentAlignment="Center"
                    Click="OnCancelClick"/>
            <Button Content="Import" x:Name="ImportButton" Width="90" IsDefault="True"
                    FontSize="12" HorizontalContentAlignment="Center" Click="OnImportClick"/>
        </StackPanel>

    </Grid>
</Window>
