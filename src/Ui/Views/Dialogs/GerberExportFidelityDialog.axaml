<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.GerberExportFidelityDialog"
        Title="Export Gerber"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="8">
            <SelectableTextBlock Text="This export will change the design as follows:" FontSize="12" FontWeight="SemiBold"/>

            <SelectableTextBlock x:Name="CubicLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="HierarchyLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="LabelsLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="PortLabelsLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="BitmapLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="PathsRegionLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="FormatLine" FontSize="11" TextWrapping="Wrap"/>
            <SelectableTextBlock x:Name="UnpairedDrillLine" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource CrfWarningBrush}"/>
            <!-- Shown only when nothing needed converting, so the list of WHAT did not need it was
                 telling the reader about categories that were never in play. The line says the
                 outcome; the lines above it are where the exceptions appear when there are any. -->
            <SelectableTextBlock x:Name="NoChangesLine"
                       Text="Geometry exports unchanged."
                       FontSize="11" Opacity="0.7" IsVisible="False"/>

            <SelectableTextBlock x:Name="UnresolvedHeader"
                       Text="Warning — the following instances reference a cell that could not be resolved and export no geometry:"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
            <ScrollViewer x:Name="UnresolvedScroll" MaxHeight="100" IsVisible="False">
                <ItemsControl x:Name="UnresolvedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <SelectableTextBlock x:Name="BlockedHeader"
                       Text="Export blocked:"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource CrfWarningBrush}"
                       TextWrapping="Wrap"
                       IsVisible="False"/>
            <ScrollViewer x:Name="BlockedScroll" MaxHeight="140" IsVisible="False">
                <ItemsControl x:Name="BlockedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource CrfWarningBrush}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button x:Name="ExportButton" Content="Export" Width="80" IsDefault="True" FontSize="12"
                    HorizontalContentAlignment="Center" Click="OnExportClick"/>
        </StackPanel>

    </Grid>
</Window>
