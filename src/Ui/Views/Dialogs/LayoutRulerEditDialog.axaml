<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.ViewModels"
        xmlns:props="using:CircuitRF.Ui.Views.Properties"
        x:Class="CircuitRF.Ui.Views.Dialogs.LayoutRulerEditDialog"
        x:DataType="vm:LayoutShapePropertiesViewModel"
        Title="Ruler"
        Width="340"
        MinWidth="300"
        MinHeight="200"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Undo/Redo act on the LAYOUT EDITOR's own stack — this dialog has no independent one. Every
         edit here commits through LayoutEditorViewModel.ApplyToEachRuler, exactly as the docked
         Properties panel does, so an edit made in either place is one undo entry on the same stack.
         Mirrors LayoutPCellParameterDialog's own convention. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z"       Command="{Binding EditorVm.UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"       Command="{Binding EditorVm.UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding EditorVm.RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z" Command="{Binding EditorVm.RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"       Command="{Binding EditorVm.RedoCommand}"/>
    </Window.KeyBindings>

    <Grid RowDefinitions="*,Auto" Margin="10">
        <props:LayoutRulerPropertiesView Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,10,0,0">
            <Button Content="Close" FontSize="11" Padding="10,4" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>

</Window>
