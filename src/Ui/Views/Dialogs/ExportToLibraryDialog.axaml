<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.ViewModels"
        xmlns:ctl="using:CircuitRF.Ui.Controls"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="CircuitRF.Ui.Views.Dialogs.ExportToLibraryDialog"
        x:DataType="vm:ExportToLibraryViewModel"
        Title="Export to Library"
        Width="940" Height="860"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- brief vendorlib-10 R-vl10-3: the target and the fields on the left; the symbol, what will be copied in and every
         refusal on the right, live, before Export is pressed. -->
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="470,16,*" Margin="16,14,16,14">

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Margin="0,0,8,0">

                <!-- Target -->
                <TextBlock Text="Target" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="90,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Library" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LibraryBox" Text="{Binding LibraryPath}" FontSize="12"
                               ToolTip.Tip="The model library's folder. An empty folder starts a new library."/>
                    <Button    Grid.Row="0" Grid.Column="2" Content="Browse…" FontSize="12" Margin="6,0,0,0" Click="OnBrowseLibrary"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="KnownLibraryCombo"
                               ItemsSource="{Binding KnownLibraries}" PlaceholderText="Libraries this workspace references"
                               FontSize="12" HorizontalAlignment="Stretch" SelectionChanged="OnKnownLibraryChosen"
                               IsEnabled="{Binding !!KnownLibraries.Count}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Category" FontSize="12" VerticalAlignment="Center"/>
                    <AutoCompleteBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Category}"
                                     ItemsSource="{Binding Categories}" FilterMode="StartsWith" MinimumPrefixLength="0"
                                     FontSize="12"
                                     ToolTip.Tip="A folder in the library, which is a palette sub-menu. Typing Amplifiers/LNA creates both."/>
                </Grid>

                <!-- Library: only for a new one -->
                <TextBlock Text="Library" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" IsEnabled="{Binding LibraryIsNew}">
                    <TextBlock Grid.Row="0" Text="Name" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding LibraryName}" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="Publisher" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Publisher}" FontSize="12"/>
                    <TextBlock Grid.Row="2" Text="Version" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding LibraryVersion}" FontSize="12"/>
                    <TextBlock Grid.Row="3" Text="License" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding License}" FontSize="12"/>
                </Grid>

                <!-- Part -->
                <TextBlock Text="Part" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="90,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                    <TextBlock Grid.Row="0" Text="Part number" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PartBox" Text="{Binding PartNumber}" FontSize="12"/>
                    <TextBlock Grid.Row="1" Text="Description" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="12"/>
                    <TextBlock Grid.Row="2" Text="Kind" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="KindCombo" ItemsSource="{Binding Kinds}"
                               SelectedItem="{Binding EffectiveKind, Mode=OneWay}" SelectionChanged="OnKindChosen" FontSize="12"
                               HorizontalAlignment="Stretch"
                               ToolTip.Tip="Active when any component is nonlinear (Verilog-A, ComposedFET, a FET, a diode, SDD, an external device); Passive otherwise."/>
                    <TextBlock Grid.Row="3" Text="Value" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Value}" FontSize="12" IsEnabled="{Binding IsPassive}"
                               PlaceholderText="{Binding ValuePlaceholder}" ToolTip.ShowOnDisabled="True"
                               ToolTip.Tip="A passive's value. Optional; it makes the part findable by value. An active part has none."/>
                    <TextBlock Grid.Row="4" Text="Frequency" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding FrequencyLow}" FontSize="12" PlaceholderText="0 Hz"/>
                    <TextBox   Grid.Row="4" Grid.Column="2" Text="{Binding FrequencyHigh}" FontSize="12" PlaceholderText="20 GHz"/>
                    <TextBlock Grid.Row="5" Text="Conditions" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Conditions}" FontSize="12"
                               PlaceholderText="Vds = 3 V, 25 °C"
                               ToolTip.Tip="Optional. The bias, temperature or other conditions the model was made at and holds for, as text for whoever places the part. It is recorded with the part; the simulation does not use it."/>
                    <TextBlock Grid.Row="6" Text="Footprint" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Footprint}" FontSize="12"
                               PlaceholderText="1005M(0402)"/>
                </Grid>

                <!-- Parameters (brief vendorlib-13 R-vl13-1b): each parameter's tolerance, typed in the Yield panel's own
                     grammar after the distribution is chosen, written as the distribution function on its default in
                     the SOURCE cell's .ccell. Only Gaussian and Uniform have a function, so only they are offered. -->
                <TextBlock Text="Parameters" FontWeight="SemiBold" FontSize="12" IsVisible="{Binding HasParameters}"/>
                <StackPanel Spacing="4" IsVisible="{Binding HasParameters}">
                    <Grid ColumnDefinitions="90,100,96,*" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="Name" FontSize="11" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="Nominal" FontSize="11" Opacity="0.7"/>
                        <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="Tolerance" FontSize="11" Opacity="0.7"
                                   ToolTip.Tip="{x:Static vm:ExportToLibraryDialogText.ToleranceTip}"/>
                    </Grid>
                    <ItemsControl x:Name="ParameterTable" ItemsSource="{Binding ParameterRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExportParameterRowViewModel">
                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="90,100,96,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Nominal}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ComboBox  Grid.Column="2" ItemsSource="{x:Static vm:ExportParameterRowViewModel.DistributionLabels}"
                                                   SelectedIndex="{Binding DistributionIndex}" FontSize="12"
                                                   HorizontalAlignment="Stretch" ToolTip.Tip="{Binding DistributionTip}"/>
                                        <TextBox   Grid.Column="3" Text="{Binding Spread, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                                   IsEnabled="{Binding HasSpread}" PlaceholderText="± 5 % at 3σ"
                                                   ToolTip.Tip="± 2 %, ± 2 % at 2σ, σ 1 Ω, or 45 … 55 Ω on a Uniform"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Error}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource CrfWarningBrush}"
                                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Corners (brief vendorlib-13 R-vl13-2c): rows are corner names, columns the cell's parameters; a blank
                     value is nominal. Written to the source cell's .ccell, as the tolerances are. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasParameters}">
                    <TextBlock Grid.Column="0" Text="Corners" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Add corner" FontSize="12" Command="{Binding AddCornerCommand}"
                            ToolTip.Tip="A named set of this part's own parameter values — its stated min / typ / max."/>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding !!CornerRows.Count}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Corner" Width="80" FontSize="11" Opacity="0.7"/>
                            <ItemsControl ItemsSource="{Binding ParameterNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Width="80" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl x:Name="CornerTable" ItemsSource="{Binding CornerRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExportCornerRowViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="80" FontSize="12"/>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ExportCornerCellViewModel">
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="80" FontSize="12"
                                                             PlaceholderText="nominal"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Padding="4,2" Background="Transparent" ToolTip.Tip="Remove this corner"
                                                Command="{Binding $parent[Window].((vm:ExportToLibraryViewModel)DataContext).RemoveCornerCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding CornerProblem}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource CrfWarningBrush}"
                           IsVisible="{Binding CornerProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding CellEditNote}" FontSize="11" TextWrapping="Wrap" Opacity="0.8"
                           IsVisible="{Binding CellEditNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Frequency (brief vendorlib-11 R-vl11-4): the plan technology-bound parts are sampled over — the EM
                     Setup's own plan editor. Greyed when nothing uses the technology. -->
                <TextBlock Text="Frequency" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Text="{Binding ConversionLine}" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Spacing="4" IsEnabled="{Binding IsFrequencyPlanEnabled}">
                    <ctl:FrequencyPlanEditor x:Name="FrequencyPlan" Segments="{Binding FrequencySegments}"
                                             AddSegmentCommand="{Binding AddFrequencySegmentCommand}"/>
                    <TextBlock Text="DC is always included." FontSize="11" Opacity="0.6"/>
                </StackPanel>

                <!-- Compiled models (brief vendorlib-15 R-vl15-1d). Both rows are always shown and greyed when they do not
                     apply, so nothing below them moves as the plan changes. The checkbox starts unticked. -->
                <TextBlock Text="Compiled models" FontWeight="SemiBold" FontSize="12"/>
                <CheckBox x:Name="CompileModelsBox" IsChecked="{Binding CompileModels}" IsEnabled="{Binding IsCompileEnabled}"
                          ToolTip.Tip="Compile each Verilog-A source and ComposedFET the cell places, and ship the compiled build in its place, without the source. A ComposedFET is written as Verilog-A first, as Model Composer's Verilog-A export writes it.">
                    <TextBlock Text="Compile Verilog-A models (ship the build, not the source)" FontSize="12"/>
                </CheckBox>
                <TextBlock Text="{Binding CompileNote}" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Spacing="4" IsEnabled="{Binding IsBuildsEnabled}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Builds for other platforms…" FontSize="12" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Add build" FontSize="12" Command="{Binding AddBuildCommand}"
                                ToolTip.Tip="A build of the compiled model made on another platform, copied into models/&lt;platform&gt;/."/>
                    </Grid>
                    <ItemsControl x:Name="BuildTable" ItemsSource="{Binding BuildRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExportBuildRowViewModel">
                                <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,4">
                                    <ComboBox Grid.Column="0" FontSize="12" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding $parent[Window].((vm:ExportToLibraryViewModel)DataContext).OtherPlatforms}"
                                              SelectedItem="{Binding Rid}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                             PlaceholderText="builds/TSTFET100.osdi"/>
                                    <Button Grid.Column="2" Content="Browse…" FontSize="12" Click="OnBrowseBuild"/>
                                    <Button Grid.Column="3" Padding="4,2" Background="Transparent" ToolTip.Tip="Remove this build"
                                            Command="{Binding $parent[Window].((vm:ExportToLibraryViewModel)DataContext).RemoveBuildCommand}"
                                            CommandParameter="{Binding}">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding BuildsNote}" FontSize="11" TextWrapping="Wrap" Opacity="0.6"/>
                </StackPanel>

                <!-- Compile netlist (brief vendorlib-16 R-vl16-2a). Always shown, greyed with a sentence when no compiler is
                     found; the checkbox starts unticked. Ticked, the list on the right becomes what is compiled, what stays
                     outside and the terminal count, and the refusals join the list below it. -->
                <TextBlock Text="Protected model" FontWeight="SemiBold" FontSize="12"/>
                <CheckBox x:Name="CompileNetlistBox" IsChecked="{Binding CompileNetlist}" IsEnabled="{Binding IsCompileNetlistEnabled}"
                          ToolTip.Tip="Compile the cell's netlist into one Verilog-A module and publish the compiled build in place of the cell. The source is written outside the library.">
                    <TextBlock Text="Compile netlist (protected model)" FontSize="12"/>
                </CheckBox>
                <TextBlock Text="{Binding CompileNetlistNote}" FontSize="11" TextWrapping="Wrap" Opacity="0.8"/>
                <StackPanel Spacing="4" IsVisible="{Binding ShowsProofBias}">
                    <Grid ColumnDefinitions="90,*">
                        <TextBlock Grid.Column="0" Text="Proof bias" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox Grid.Column="1" Text="{Binding CheckBiasText}" FontSize="12" AcceptsReturn="True" MinHeight="44"
                                 PlaceholderText="g=-0.5 d=5"/>
                    </Grid>
                    <TextBlock Text="{Binding CheckBiasNote}" FontSize="11" TextWrapping="Wrap" Opacity="0.6"/>
                </StackPanel>
                <!-- The Builds table (R-vl16-6a), once a protected export has run. -->
                <StackPanel Spacing="2" IsVisible="{Binding HasBuilds}">
                    <TextBlock Text="Builds" FontWeight="SemiBold" FontSize="12"/>
                    <SelectableTextBlock Text="{Binding UnavailableLine}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource CrfWarningBrush}"
                                         IsVisible="{Binding UnavailableLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <!-- Where the export wrote: each a link that reveals the folder in the file manager. -->
                    <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" Margin="0,2,0,4">
                        <TextBlock Grid.Row="0" Text="Model" FontSize="11" Opacity="0.7" VerticalAlignment="Top"
                                   IsVisible="{Binding FinishedModelFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <SelectableTextBlock Grid.Row="0" Grid.Column="1" x:Name="ModelFolderLink" Text="{Binding FinishedModelFolder}"
                                             FontSize="11" TextWrapping="Wrap" Cursor="Hand" TextDecorations="Underline"
                                             Foreground="{DynamicResource SystemAccentColor}" Tapped="OnRevealModelFolder"
                                             ToolTip.Tip="Show this folder in the file manager"
                                             IsVisible="{Binding FinishedModelFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Grid.Row="1" Text="Source" FontSize="11" Opacity="0.7" VerticalAlignment="Top"
                                   IsVisible="{Binding FinishedSourceFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" x:Name="SourceFolderLink" Text="{Binding FinishedSourceFolder}"
                                             FontSize="11" TextWrapping="Wrap" Cursor="Hand" TextDecorations="Underline"
                                             Foreground="{DynamicResource SystemAccentColor}" Tapped="OnRevealSourceFolder"
                                             ToolTip.Tip="Show this folder in the file manager"
                                             IsVisible="{Binding FinishedSourceFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </Grid>
                    <ItemsControl x:Name="BuildsResult" ItemsSource="{Binding BuildLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid ColumnDefinitions="90,*,Auto">
                    <TextBlock Grid.Column="0" Text="Documents" FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="1" CornerRadius="3" MinHeight="44">
                        <ListBox x:Name="DocumentsList" ItemsSource="{Binding Documents}" FontSize="11" MaxHeight="80" Background="Transparent"/>
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="4" Margin="6,0,0,0">
                        <Button Content="Add…" FontSize="12" Click="OnAddDocument" HorizontalAlignment="Stretch"/>
                        <Button Content="Remove" FontSize="12" Click="OnRemoveDocument" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="0" Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
            <!-- The symbol (R-vl10-3d): one picture; a click opens the menu of every symbol this model can take. -->
            <StackPanel Grid.Row="0" Spacing="2" HorizontalAlignment="Left">
                <TextBlock Text="Symbol" FontWeight="SemiBold" FontSize="12"/>
                <Button x:Name="SymbolButton" Background="Transparent" Width="170" Padding="4"
                        HorizontalContentAlignment="Stretch" ToolTip.Tip="Choose the symbol" Click="OnSymbolButton">
                    <StackPanel Spacing="2">
                        <ctl:PaletteGlyphControl x:Name="SymbolGlyph" Height="90"/>
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock FontSize="11" Text="{Binding CurrentSymbol.Label, FallbackValue=''}" VerticalAlignment="Center"/>
                            <mi:MaterialIcon Kind="MenuDown" Width="14" Height="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding CopiedHeader}" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="1" CornerRadius="3">
                <ScrollViewer>
                    <StackPanel Margin="6,4">
                        <TextBlock Text="The cell's own schematic and pins, and nothing else." FontSize="11" Opacity="0.6"
                                   IsVisible="{Binding !CopyLines.Count}"/>
                        <ItemsControl ItemsSource="{Binding CopyLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <ItemsControl Grid.Row="3" ItemsSource="{Binding RefusalLines}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <SelectableTextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"
                                             Foreground="{DynamicResource CrfWarningBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Grid.Row="4" Text="{Binding ReplaceNote}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       IsVisible="{Binding ReplaceNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <CheckBox Grid.Row="5" IsChecked="{Binding AddToWorkspace}" IsEnabled="{Binding AddToWorkspaceEnabled}" Margin="0,8,0,0"
                      ToolTip.Tip="Reference this library from the workspace, so the part is in the palette as soon as the export finishes.">
                <TextBlock Text="Add this library to the workspace" FontSize="12"/>
            </CheckBox>
        </Grid>

        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <SelectableTextBlock Grid.Column="0" Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.8"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding CancelLabel}" Width="80" HorizontalContentAlignment="Center" IsCancel="True" Click="OnCancel"/>
                <Button Content="Export" Width="80" HorizontalContentAlignment="Center" IsDefault="True"
                        IsEnabled="{Binding CanExport}" Click="OnExport"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
