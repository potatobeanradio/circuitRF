<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.InstanceCellPickerDialog"
        Title="Place Cell Instance"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="20,16,20,16">

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Choose a cell to place as an instance."
                   FontSize="12" Opacity="0.7" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ListBox x:Name="ChoiceList" Grid.Row="1" MaxHeight="280" FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{Binding RowOpacity}">
                        <TextBlock Text="{Binding DisplayName}"/>
                        <TextBlock Text="{Binding Annotation}" FontStyle="Italic" FontSize="11" Opacity="0.75"
                                   IsVisible="{Binding HasAnnotation}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" FontSize="12" Opacity="0.6"
                   Text="No cells were found in this workspace." IsVisible="False"/>

        <TextBlock x:Name="DisabledReasonText" Grid.Row="2" FontSize="11" Margin="0,4,0,0"
                   Foreground="{DynamicResource CrfWarningBrush}" IsVisible="False" TextWrapping="Wrap"/>

        <!-- Quieter than Place, but still unmistakably a BUTTON: it keeps the theme's own button
             background and border and is only made smaller (owner, 2026-09-05 — a transparent one read
             as a label). Taking a cell from another project is a real act with its own consequences
             (see WorkspaceViewModel.CellDrop), not a second way to pick from the list above, so it
             stays small, left-aligned and away from the default button. -->
        <Button x:Name="BrowseButton" Grid.Row="3" Content="Reference Cell…" FontSize="11" Padding="10,4"
                HorizontalAlignment="Left" Margin="0,10,0,0"
                ToolTip.Tip="Use a cell that lives outside this workspace"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center"/>
            <Button x:Name="OkButton" Content="Place" Width="80" IsDefault="True" FontSize="12" HorizontalContentAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
