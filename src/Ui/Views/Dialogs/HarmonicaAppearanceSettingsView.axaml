<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaAppearanceSettingsView">

  <!--
    brief-harmonicarf-r6a §2.2 — lifted verbatim from the former HarmonicaPreferencesDialog (its own
    §7.9.4 colour editor), as a UserControl tab of HarmonicaSettingsDialog. Reuses circuitRF's existing
    colour UI rather than a new one — the role-list + hex-field pattern from Views/Dialogs/SettingsView,
    and Views/Dialogs/ColorPickerDialog for the picker itself — because that code has already absorbed
    two non-obvious fixes worth inheriting rather than rediscovering:

      • THE HEX-FIELD KEY HANDLING. Return applies AND sets e.Handled = true, or the window's default
        button closes the dialog instead of applying; Escape reverts; LostFocus applies; the value is
        RRGGBBAA, with a 6-digit entry taken as opaque.
      • ColorView must be GIVEN its Fluent theme or it instantiates blank. It is included in the
        app's App.axaml today; §3.1 warns that the standalone harmonicaRF entry point has its own
        Application.Styles and must carry the same include, because it fails silently.
  -->

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Variant" VerticalAlignment="Center" Opacity="0.7"/>
      <RadioButton x:Name="LightRadio" Content="Light" GroupName="Variant" IsCheckedChanged="OnVariantChanged"/>
      <RadioButton x:Name="DarkRadio"  Content="Dark"  GroupName="Variant" IsChecked="True" IsCheckedChanged="OnVariantChanged"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="240,*">

      <ListBox x:Name="RoleList" Grid.Column="0" SelectionChanged="OnRoleSelected"
               ToolTip.Tip="Right-click a role to reset just that one, in both variants."/>

      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">

        <TextBlock x:Name="RoleNameLabel" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border x:Name="ColorPreviewRect" Width="48" Height="24"
                  BorderThickness="1" BorderBrush="{DynamicResource CrfTileBorderBrush}"/>
          <TextBox x:Name="HexBox" Width="110" PlaceholderText="RRGGBBAA"
                   KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus"
                   ToolTip.Tip="RRGGBBAA. A six-digit entry is taken as fully opaque. Return applies, Escape reverts."/>
          <Button  x:Name="PickButton" Content="Pick…" Click="OnPickClick"/>
          <Button  x:Name="RevertButton" Content="Reset This Role" Click="OnRevertClick"/>
        </StackPanel>

      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="ImportButton" Content="Import .ccolor…" Click="OnImportClick"/>
      <Button x:Name="ExportButton" Content="Export .ccolor…" Click="OnExportClick"/>
      <Button x:Name="ResetAllButton" Content="Reset All Colours" Click="OnResetAllClick"/>
      <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
    </StackPanel>

  </Grid>
</UserControl>
