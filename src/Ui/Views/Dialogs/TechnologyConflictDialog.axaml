<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.TechnologyConflictDialog"
        Title="Different Technology"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="20,16,20,16" Spacing="0">

        <TextBlock x:Name="HeaderText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBlock x:Name="DetailText" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                   Opacity="0.85"/>

        <TextBlock Text="What would you like to do?" FontSize="12" Margin="0,16,0,0"/>

        <RadioButton x:Name="UseForLayoutRadio" GroupName="Remedy" FontSize="12" Margin="0,10,0,0"
                     IsChecked="True"/>
        <TextBlock x:Name="UseForLayoutNote" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Margin="22,2,0,0"/>

        <RadioButton x:Name="UseForWorkspaceRadio" GroupName="Remedy" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="UseForWorkspaceNote" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Margin="22,2,0,0"/>

        <RadioButton x:Name="CopyCellRadio" GroupName="Remedy" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="CopyCellNote" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                   Margin="22,2,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
            <Button Content="Cancel" Width="80" FontSize="12"
                    HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button Content="OK" Width="80" IsDefault="True" FontSize="12"
                    HorizontalContentAlignment="Center" Click="OnOkClick"/>
        </StackPanel>

    </StackPanel>
</Window>
