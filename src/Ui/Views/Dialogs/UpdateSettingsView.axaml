<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CircuitRF.Ui.Views.Dialogs.UpdateSettingsView">

  <!--
    The Updates settings, ONCE. Hosted by circuitRF's and wBond's shared SettingsView (in the General
    tab's "Updates" section) and by harmonicaRF's own HarmonicaSettingsDialog (as its own tab).

    R-AU-42: harmonicaRF does not use SettingsView at all, and without this a user who has only
    harmonicaRF installed could never turn automatic updates off. Both dialogs read and write the
    same two AppPreferences properties; NEITHER OWNS THEM — which is why the controls and their
    handlers live here rather than being written twice.

    ONE preferences.json serves all three applications (AppDataRoot is a single directory), so this
    checkbox governs circuitRF, harmonicaRF and wBond together. The help text says so, because the
    scope of a checkbox should not be a surprise.
  -->

  <StackPanel Spacing="0">
    <TextBlock Text="Updates" FontSize="11" FontWeight="SemiBold"
               Opacity="0.55" Margin="0,0,0,6" Name="SectionHeader"/>

    <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <CheckBox  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                 Name="AutoUpdateCheck"
                 Content="Automatic updates" FontSize="12"
                 IsCheckedChanged="OnAutoUpdateChanged"/>
      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11"
                 Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Downloads new versions in the background and installs them the next time the application is relaunched. This setting is shared by circuitRF, harmonicaRF and wBond."/>

      <!-- A sub-item, and disabled while automatic updates are off. -->
      <CheckBox  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 Name="IncludeBetasCheck"
                 Content="Include beta releases" FontSize="12"
                 Margin="20,8,0,0"
                 IsCheckedChanged="OnIncludeBetasChanged"/>

      <!-- Costs nothing, and it is the first thing anyone looks at when wondering whether the
           feature is working at all. Read from the updater's state file; never written here. -->
      <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11"
                 Opacity="0.55" Margin="0,10,0,0"
                 Name="LastCheckedText" Text="Last checked: never"/>

      <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" FontSize="11"
                 Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"
                 Name="UpdateOverrideText" IsVisible="False" Text=""/>
    </Grid>
  </StackPanel>
</UserControl>
