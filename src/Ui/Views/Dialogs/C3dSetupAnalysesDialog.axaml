<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t3="using:CircuitRF.Ui.ThreeD"
        xmlns:t3v="using:CircuitRF.Ui.Views.ThreeD"
        x:Class="CircuitRF.Ui.Views.Dialogs.C3dSetupAnalysesDialog"
        x:DataType="t3:C3dEditorViewModel"
        Title="Setup Analyses"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveDocumentCommand}"/>
        <KeyBinding Gesture="Meta+S" Command="{Binding SaveDocumentCommand}"/>
    </Window.KeyBindings>

    <!-- Simulate ▸ Setup Analyses… with a 3D view active: the 3D view's setups (C3dSetupAnalysesView, the control the
         Analyses panel shows for a .c3d too) and a footer. -->
    <Grid RowDefinitions="*,Auto" Background="{DynamicResource SystemChromeLowColor}">
        <t3v:C3dSetupAnalysesView Grid.Row="0"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,2,12,8">
            <TextBlock Grid.Column="0" Text="The active setup is the one Simulate ▸ Run runs and whose air box is drawn."
                       Foreground="{DynamicResource SystemBaseMediumLowColor}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" IsDefault="True" IsCancel="True" HorizontalContentAlignment="Center"
                    Padding="20,6" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>
