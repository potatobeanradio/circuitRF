<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.ScaleDialog"
        Title="Scale"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">

        <StackPanel Grid.Row="0" Spacing="10">

            <CheckBox x:Name="UniformCheck" Content="Uniform (lock X/Y)" FontSize="12" IsChecked="True"/>

            <Grid ColumnDefinitions="70,*,70,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Factor:" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="FactorBox" Grid.Row="0" Grid.Column="1" FontSize="12"
                         LostFocus="OnFactorLostFocus" KeyDown="OnFactorKeyDown"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Factor Y:" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="FactorYBox" Grid.Row="0" Grid.Column="3" FontSize="12"
                         LostFocus="OnFactorYLostFocus" KeyDown="OnFactorYKeyDown"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Width:" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthBox" Grid.Row="1" Grid.Column="1" FontSize="12"
                         LostFocus="OnWidthLostFocus" KeyDown="OnWidthKeyDown"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Height:" FontSize="12" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="3" FontSize="12"
                         LostFocus="OnHeightLostFocus" KeyDown="OnHeightKeyDown"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Anchor:" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox x:Name="AnchorCombo" FontSize="12" MinWidth="160"/>
            </StackPanel>

            <TextBlock x:Name="PreviewText" FontSize="11" Opacity="0.7"/>
            <TextBlock Text="Scaling by an arbitrary factor is not exactly reversible with integer coordinates — scaling by 3 then 1/3 may differ by a DBU."
                       FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button Content="Scale" Width="80" IsDefault="True" FontSize="12" HorizontalContentAlignment="Center" Click="OnOkClick"/>
        </StackPanel>

    </Grid>
</Window>
