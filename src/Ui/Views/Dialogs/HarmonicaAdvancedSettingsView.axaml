<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaAdvancedSettingsView">

  <!--
    brief-harmonicarf-r6a §2.2/§3 — lifted from the former HarmonicaAdvancedSettingsDialog, as a
    UserControl tab of HarmonicaSettingsDialog, plus §3's new contour-kernel controls (kernel / smooth
    / epsilon) threaded into ContourGrid.Fit via Rbf2D.Factorize.
  -->

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto"
        Margin="14">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Loadline samples" VerticalAlignment="Center"
                 ToolTip.Tip="Time samples the loadline is drawn at. Exact at any count — not a solve setting."/>
      <TextBox x:Name="LoadlineSamplesBox" Grid.Column="1" Width="100"
               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="FFT oversampling" VerticalAlignment="Center"
                 ToolTip.Tip="FFT oversampling factor. Structural — the time grid changes size."/>
      <TextBox x:Name="FftOverSampleBox" Grid.Column="1" Width="100"
               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Multiplicity (M)" VerticalAlignment="Center"
                 ToolTip.Tip="Device multiplier — how many identical devices in parallel."/>
      <TextBox x:Name="MultiplicityBox" Grid.Column="1" Width="100"
               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Compute charge" VerticalAlignment="Center"
                 ToolTip.Tip="Whether the DUT's charge terms are evaluated. With charge OFF the load glyph coincides with its marker on a bare device."/>
      <CheckBox x:Name="ComputeChargeCheck" Grid.Column="1" Click="OnComputeChargeClick"/>
    </Grid>

    <Border Grid.Row="4" Height="1" Opacity="0.2" Background="{DynamicResource CrfTileBorderBrush}" Margin="0,4,0,10"/>

    <TextBlock Grid.Row="5" Text="Contour surface" FontWeight="SemiBold" Margin="0,0,0,8"/>

    <Grid Grid.Row="6" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="RBF kernel" VerticalAlignment="Center"
                 ToolTip.Tip="The radial basis function ContourGrid.Fit factorizes the loadpull surface with."/>
      <ComboBox x:Name="KernelCombo" Grid.Column="1" Width="140" SelectionChanged="OnKernelChanged"/>
    </Grid>

    <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Smooth / Epsilon" VerticalAlignment="Center"
                 ToolTip.Tip="Smooth: the RBF's smoothing term, ≥ 0. Epsilon: the shape parameter — leave blank for Rbf2D's own auto value."/>
      <TextBox x:Name="ContourSmoothBox" Grid.Column="1" Width="80" Margin="0,0,6,0"
               LostFocus="OnContourFieldLostFocus" KeyDown="OnContourFieldKeyDown"/>
      <TextBox x:Name="ContourEpsilonBox" Grid.Column="2" Width="80" PlaceholderText="auto"
               LostFocus="OnContourFieldLostFocus" KeyDown="OnContourFieldKeyDown"/>
    </Grid>

    <!-- R8A §3 — moved here from Appearance, verbatim (markup and the handlers/state that back it). -->

    <Border Grid.Row="8" Height="1" Opacity="0.2" Background="{DynamicResource CrfTileBorderBrush}" Margin="0,4,0,10"/>

    <TextBlock Grid.Row="9" Text="Iso-line fade" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="10" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="α floor" VerticalAlignment="Center" Width="60" Opacity="0.7"/>
      <Slider x:Name="AlphaFloorSlider" Minimum="0" Maximum="1" Width="220"
              ValueChanged="OnFadeChanged"
              ToolTip.Tip="1 flattens the fade entirely — every contour fully opaque — with no code change."/>
      <TextBlock x:Name="AlphaFloorLabel" VerticalAlignment="Center" Width="40"/>
    </StackPanel>
    <StackPanel Grid.Row="11" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="exponent" VerticalAlignment="Center" Width="60" Opacity="0.7"/>
      <Slider x:Name="AlphaExpSlider" Minimum="0.05" Maximum="4" Width="220"
              ValueChanged="OnFadeChanged"
              ToolTip.Tip="The shaping exponent p. Larger fades the lower levels harder."/>
      <TextBlock x:Name="AlphaExpLabel" VerticalAlignment="Center" Width="40"/>
    </StackPanel>
    <CheckBox Grid.Row="12" x:Name="IsoLabelsCheck" Content="Iso-line labels" Click="OnIsoLabelsChanged"
              Margin="0,0,0,8"
              ToolTip.Tip="Off by default — a dense unfilled contour set reads better without them."/>

    <Border Grid.Row="13" Height="1" Opacity="0.2" Background="{DynamicResource CrfTileBorderBrush}" Margin="0,4,0,10"/>

    <TextBlock Grid.Row="14" Text="Tickle default" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="15" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,0,0,8"
               Text="What a BRAND NEW harmonicaRF document opens with. A document you already have keeps its own tickle regardless of this — it is per-user, not something a .charm from someone else can silently change."/>
    <StackPanel Grid.Row="16" Orientation="Horizontal" Spacing="8">
      <CheckBox x:Name="TickleDefaultEnabledCheck" Content="Enabled" Click="OnTickleDefaultChanged"/>
      <TextBlock Text="level" VerticalAlignment="Center" Opacity="0.7"/>
      <TextBox x:Name="TickleDefaultDbmBox" Width="70"
               KeyDown="OnTickleDefaultDbmKeyDown" LostFocus="OnTickleDefaultDbmLostFocus"/>
      <TextBlock Text="dBm" VerticalAlignment="Center" Opacity="0.7"/>
    </StackPanel>

    <StackPanel Grid.Row="18" Orientation="Vertical" Spacing="8" Margin="0,8,0,0">
      <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>
  </Grid>
</UserControl>
