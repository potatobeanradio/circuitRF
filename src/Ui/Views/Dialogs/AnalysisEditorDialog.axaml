<Window xmlns="https://github.com/avaloniaui"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:analyses="using:CircuitRF.Ui.Views.Analyses"
        xmlns:vm="using:CircuitRF.Ui.ViewModels"
        x:Class="CircuitRF.Ui.Views.Dialogs.AnalysisEditorDialog"
        x:DataType="vm:AnalysisEditorViewModel"
        Title="Add Analysis"
        Width="520"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="650"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- The sweep rows' TextBlocks draw the same whether enabled or not, so the disabled section
             fades as a whole to read as greyed out. -->
        <Style Selector="StackPanel.sweeps:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="20,16,20,16">

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,6,0">

            <!-- Dialog title -->
            <TextBlock x:Name="DialogTitle"
                       Text="Add Analysis"
                       FontSize="15"
                       FontWeight="SemiBold"/>

            <!-- Type picker -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Type:"
                               FontSize="12"
                               Opacity="0.75"/>
                    <!-- Two columns of four: the circuit solves (DC, S, HB, envelope) and the rest (loadpull, pursuit, fields, TRL). -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="3">
                            <RadioButton x:Name="DcRadio"
                                         Content="DC"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="SpRadio"
                                         Content="S-Parameter"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="HbRadio"
                                         Content="Harmonic Balance"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="EnvRadio"
                                         Content="Envelope (modulated)"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="3">
                            <RadioButton x:Name="LpRadio"
                                         Content="Load Pull"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="LppRadio"
                                         Content="LP Pursuit"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="FieldsRadio"
                                         Content="Fields (SAR, B1, pattern)"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                            <RadioButton x:Name="TrlRadio"
                                         Content="TRL Calibration"
                                         GroupName="AnalysisType"
                                         FontSize="12"
                                         ToolTip.Tip="Two fixture files from measured Thru, Reflect and Line standards, for Deembed blocks"
                                         IsCheckedChanged="OnTypeRadioChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Name + Enabled (on the same row) -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Name:"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           x:Name="NameBox"
                           FontSize="12"
                           MaxLength="64"
                           TextChanged="OnNameChanged"/>
                <CheckBox  Grid.Row="0" Grid.Column="2"
                           x:Name="EnabledCheck"
                           Content="Enabled"
                           FontSize="12"
                           IsChecked="True"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           x:Name="NameErrorLabel"
                           FontSize="11"
                           Foreground="{DynamicResource CrfWarningBrush}"
                           IsVisible="False"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
            </Grid>

            <!-- brief-sdl-6 R-sdl6-1: what the analysis's circuit is built from. The setup picker is always there, so the
                 row does not move when EM is chosen; it is enabled only when the layout has several setups. -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Simulate by:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="SimulateByCombo" FontSize="12" HorizontalAlignment="Stretch"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="EM setup:" FontSize="12" VerticalAlignment="Center" Margin="0,6,8,0"/>
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="EmSetupCombo" FontSize="12" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
            </Grid>

            <!-- ── DC body ──────────────────────────────────────────────────────── -->
            <Border x:Name="DcBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="12,10">
                <TextBlock Text="Operating point — no additional configuration required."
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ── S-Parameter body ─────────────────────────────────────────────── -->
            <Border x:Name="SpBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="0,10"
                    IsVisible="False">
                <analyses:SpBodyView x:Name="SpBodyViewControl"/>
            </Border>

            <!-- ── Harmonic Balance body ─────────────────────────────────────────── -->
            <Border x:Name="HbBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <analyses:HbBodyView x:Name="HbBodyViewControl"/>
            </Border>

            <!-- ── Loadpull body ─────────────────────────────────────────────────── -->
            <Border x:Name="LpBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <analyses:LpBodyView x:Name="LpBodyViewControl"/>
            </Border>

            <!-- ── Loadpull-Pursuit body ─────────────────────────────────────────── -->
            <Border x:Name="LppBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <analyses:LppBodyView x:Name="LppBodyViewControl"/>
            </Border>

            <!-- ── Fields body (brief-sar-9): an EM block's per-port fields recombined by this circuit ──── -->
            <Border x:Name="FieldsBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <Grid x:Name="FieldsBodyGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,14,Auto,Auto,Auto"
                      RowSpacing="6" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Block:" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" HorizontalAlignment="Stretch"
                               ItemsSource="{Binding FieldsBody.Blocks}" SelectedItem="{Binding FieldsBody.Block}" IsEnabled="{Binding FieldsBody.CanChooseBlock}"
                               PlaceholderText="no EM Field Data block found"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency:" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" FontSize="12" IsEditable="True" HorizontalAlignment="Stretch"
                               ItemsSource="{Binding FieldsBody.Frequencies}" Text="{Binding FieldsBody.Freq, Mode=TwoWay}"
                               PlaceholderText="one its 3D run kept fields at"/>
                    <ComboBox  Grid.Row="1" Grid.Column="2" FontSize="12" ItemsSource="{x:Static vm:FieldsBodyViewModel.FreqUnits}"
                               SelectedItem="{Binding FieldsBody.FreqUnit}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}"
                               Text="{Binding FieldsBody.FreqProblem}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Drive port:" FontSize="12" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="2">
                        <ItemsControl ItemsSource="{Binding FieldsBody.Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FieldDriveRowViewModel">
                                    <Grid ColumnDefinitions="*,150,Auto" RowDefinitions="Auto,14" ColumnSpacing="4">
                                        <ComboBox FontSize="12" HorizontalAlignment="Stretch" ItemsSource="{Binding Items}" SelectedItem="{Binding Driver}"/>
                                        <TextBox Grid.Column="1" FontSize="12" Text="{Binding Weight}" PlaceholderText="{Binding AmplitudeHint}"
                                                 ToolTip.Tip="This drive's complex amplitude, with no units: a number or an expression, such as W2 or polar(1,-90). Only the ratios between drives matter. Empty is 1, or a P1Tone's Pavl and Phase."/>
                                        <Button Grid.Column="2" Padding="6,3" VerticalAlignment="Center" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}"
                                                ToolTip.Tip="Remove this drive">
                                            <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}"
                                                   Text="{Binding Problem}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Padding="6,3" HorizontalAlignment="Right" Command="{Binding FieldsBody.AddDriveCommand}"
                                ToolTip.Tip="Add a drive: the ports listed are driven together, each at its amplitude">
                            <mi:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Per watt:" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" ItemsSource="{x:Static vm:FieldsBodyViewModel.Norms}"
                               SelectedItem="{Binding FieldsBody.Norm}" IsEnabled="{Binding FieldsBody.HasSarFields}"/>
                    <CheckBox  Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Content="Averaged SAR"
                               IsChecked="{Binding FieldsBody.Average}" IsEnabled="{Binding FieldsBody.HasSarFields}"/>
                </Grid>
            </Border>

            <!-- ── TRL body (brief-de-4): three measured standards in, two fixture files out ──────────── -->
            <Border x:Name="TrlBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <analyses:TrlBodyView x:Name="TrlBodyViewControl"/>
            </Border>

            <!-- ── Envelope body ─────────────────────────────────────────────────── -->
            <Border x:Name="EnvBodyPanel"
                    Background="{DynamicResource SystemRegionColor}"
                    CornerRadius="6"
                    Padding="10,10"
                    IsVisible="False">
                <analyses:EnvBodyView x:Name="EnvBodyViewControl"/>
            </Border>

            <!-- ── Parametric Sweeps section (DC/SP/HB; hidden for LP/LPP in v1) ─── -->
            <Expander Header="Parametric Sweeps"
                      IsExpanded="{Binding SweepsExpanded, Mode=TwoWay}"
                      IsVisible="{Binding ShowSweeps}"
                      FontSize="12">

                <!-- Disabled with the analysis: a disabled analysis runs none of its sweeps, so
                     they grey out to say so. On the body, not the Expander, so it still opens. -->
                <StackPanel Classes="sweeps" Spacing="6" Margin="0,8,0,0"
                            IsEnabled="{Binding #EnabledCheck.IsChecked}">

                    <TextBlock Text="Top = innermost sweep = plot X axis. Rows below are outer (slower) sweeps."
                               FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,2"/>

                    <!-- Axis rows -->
                    <ItemsControl ItemsSource="{Binding SweepAxes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SweepAxisRowViewModel">
                                <analyses:SweepAxisRowView/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add axis button -->
                    <Button Content="+ Add sweep axis"
                            FontSize="11"
                            Padding="8,4"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Command="{Binding AddSweepAxisCommand}"/>

                </StackPanel>
            </Expander>

        </StackPanel>
        </ScrollViewer>

        <!-- Buttons (HIG: Cancel then OK, right-aligned, centered labels) -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="80"
                    FontSize="12"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    Click="OnCancelClick"/>
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="80"
                    FontSize="12"
                    IsDefault="True"
                    IsEnabled="False"
                    HorizontalContentAlignment="Center"
                    Click="OnOkClick"/>
        </StackPanel>

    </Grid>

</Window>
