<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CircuitRF.Ui.Views.Dialogs.SpiceCellPickerDialog"
        Title="Import Model or Subcircuit"
        Width="620"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,16">

        <TextBlock x:Name="Intro" Grid.Row="0" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                   Margin="0,0,0,10"/>

        <!-- Every card AND subcircuit in the file, supported or not. A refused one is listed WITH
             its reason rather than hidden: "my VDMOS is missing" is otherwise a mystery, and the
             reason is the answer to the question the user is about to ask. -->
        <ListBox x:Name="ChoiceList" Grid.Row="1" MaxHeight="340" FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                    <StackPanel Margin="0,3,0,3" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Opacity="{Binding NameOpacity}"/>
                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6"
                                   TextWrapping="Wrap" MaxWidth="540"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="Footnote" Grid.Row="2" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                   Margin="0,10,0,0" IsVisible="False"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" FontSize="12"
                    HorizontalContentAlignment="Center"/>
            <Button x:Name="OkButton" Content="Import" Width="90" IsDefault="True" FontSize="12"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>
