<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        x:Class="CircuitRF.Ui.Views.Dialogs.ColorPickerDialog"
        Title="Pick Color"
        Width="380"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="12">

        <cp:ColorView Grid.Row="0" Name="ColorViewControl" IsAlphaVisible="True"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" IsCancel="True"
                    HorizontalContentAlignment="Center" Click="OnCancelClick"/>
            <Button Content="OK" Width="80" IsDefault="True" Classes="accent"
                    HorizontalContentAlignment="Center" Click="OnOkClick"/>
        </StackPanel>

    </Grid>
</Window>
