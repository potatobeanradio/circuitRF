<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hvm="clr-namespace:CircuitRF.Ui.Harmonica"
        x:Class="CircuitRF.Ui.Views.Dialogs.HarmonicaTracePickerDialog"
        Title="Add Trace"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!--
    §7.7 — "The trace picker plots anything harmonicaRF solved", over the §5 DataSet, using the
    existing trace card's parser (CubeTraceSpecParser). This dialog is a LIST of what the published
    DataSet contains plus a spec box; the parsing and the slicing are not here.

    Zs_conv is the interesting one (§4.5.3): the full source-side conversion matrix is published
    precisely so its off-diagonals are plottable, and until H7 nothing displayed them.
  -->

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12">

    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Opacity="0.75"
               Text="Everything the current frame solved. Pick a cube for a ready-made slice, then edit the specification if you want a different one."/>

    <ListBox Grid.Row="1" x:Name="OfferList" SelectionChanged="OnOfferSelected">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="hvm:HarmonicaTracePicker+Offer">
          <StackPanel Margin="0,2">
            <TextBlock Text="{Binding Spec}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <TextBlock Text="Specification" VerticalAlignment="Center" Opacity="0.7"/>
      <TextBox x:Name="SpecBox" Width="380" KeyDown="OnSpecKeyDown" LostFocus="OnSpecCommitted"
               ToolTip.Tip="The same shorthand the Data Display trace card takes: db20 V[0, :], mag(Zs_conv[1, :]), Gamma_intr[1, 2]. Return validates."/>
      <TextBlock Text="Label" VerticalAlignment="Center" Opacity="0.7"/>
      <TextBox x:Name="LabelBox" Width="140"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
      <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"/>
      <Button Content="Cancel" Width="80" IsCancel="True" HorizontalAlignment="Right"
              HorizontalContentAlignment="Center" Click="OnCancelClick"/>
      <Button x:Name="AddButton" Content="Add" Width="80" IsDefault="True" Classes="accent"
              HorizontalContentAlignment="Center" Click="OnAddClick"/>
    </StackPanel>

  </Grid>
</Window>
