<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:yld="using:CircuitRF.Ui.Yield"
             xmlns:tun="using:CircuitRF.Ui.Tuning"
             xmlns:yldv="using:CircuitRF.Ui.Views.Yield"
             xmlns:optv="using:CircuitRF.Ui.Views.Optimization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Yield.YieldToolView"
             x:DataType="dockVm:YieldPanelTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <!-- One view, two dock tools (brief-sens-3 R-sens3-1): the Yield panel's five modes, or the Sensitivity panel's one.
         A control a mode does not use is hidden by mode; with one mode the radio row is never shown and the toolbar
         starts that row. -->
    <!-- brief-yield-10 §2. Header (schematic + run status), the mode, a toolbar of the Analyses panel's own small
         icon buttons, the live yield readout, the run settings collapsed to one line, then Variables, Specs and
         either the trial table or the corners. Readouts carry no prose: a value or a short status. -->

    <UserControl.Resources>
        <!-- The centering digits menu: one radio item per choice (TuningDigitsChoice), as the Optimizer's header has. -->
        <ControlTheme x:Key="DigitsMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="tun:TuningDigitsChoice">
            <Setter Property="Header" Value="{Binding Label}"/>
            <Setter Property="ToggleType" Value="Radio"/>
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Digits}"/>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tb">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
        </Style>
        <Style Selector="Button.tb mi|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="Button.tb:disabled mi|MaterialIcon">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Fluent paints a disabled button's presenter grey, which on a borderless icon reads as PRESSED. -->
        <Style Selector="Button.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Transparent when off: Fluent's grey unchecked fill on a borderless icon reads as PRESSED. Checked keeps
             Fluent's accent fill, which is what says "on". -->
        <Style Selector="ToggleButton.tb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ToggleButton.tb mi|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>
        <Style Selector="ToggleButton.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton.mode">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bd" Padding="8,2" CornerRadius="3" Background="Transparent"
                            BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" Margin="0,0,2,0">
                        <ContentPresenter Content="{TemplateBinding Content}" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.mode:checked /template/ Border#bd">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="RadioButton.mode:checked /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ComboBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="ListBox.AddRows ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, x:DataType=tun:TuningAddRow}"/>
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="2,0,3,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}"/>
        </Style>
        <Style Selector="TextBlock.gridcell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="TextBlock.gridcell.fail">
            <Setter Property="Foreground" Value="#FFD94F4F"/>
        </Style>
        <Style Selector="TextBlock.gridcell.worst">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- The SnP matrix tile (brief-sens-3 R-sens3-6): the selected port's row and column, and the selected entry. -->
        <Style Selector="Border.snpcell">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}"/>
            <Setter Property="BorderThickness" Value="0.5"/>
        </Style>
        <Style Selector="Border.snpcell.port">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.snpcell.entry">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2.5"/>
        </Style>
        <Style Selector="Border.excludedrow">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <TextBlock IsVisible="{Binding !Panel.HasSchematic}"
                   Text="{Binding Panel.NoSchematicMessage}"
                   Margin="8" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" IsVisible="{Binding HasSchematic}"
              DataContext="{Binding Panel}" x:DataType="yld:YieldPanelViewModel">

            <!-- Header: schematic, and the run's trials / elapsed / time left. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,4,4,1">
                <TextBlock Grid.Column="0" Text="{Binding HeaderLabel}" FontWeight="SemiBold" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrialsDoneText}" FontSize="11" Opacity="0.75"
                               ToolTip.Tip="Trials done / cap"/>
                    <TextBlock Text="{Binding ElapsedText}" FontSize="11" Opacity="0.75" ToolTip.Tip="Elapsed"/>
                    <TextBlock Text="{Binding EtaText}" FontSize="11" Opacity="0.75"/>
                </StackPanel>
            </Grid>

            <!-- Mode and toolbar. -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="4,0,4,2">
                <!-- Fixed per panel (the Sensitivity tool has one mode): never toggled while the panel is in use. -->
                <StackPanel Orientation="Horizontal" IsVisible="{Binding ShowModeRow}">
                <RadioButton Classes="mode" Content="Monte Carlo" IsChecked="{Binding IsMonteCarlo}"
                             ToolTip.Tip="The spread of every measurement — no pass/fail"/>
                <RadioButton Classes="mode" Content="Yield" IsChecked="{Binding IsYield}"
                             ToolTip.Tip="The fraction of trials meeting every yield spec, with its interval"/>
                <RadioButton Classes="mode" Content="Corners" IsChecked="{Binding IsCorners}"
                             ToolTip.Tip="Every enabled corner, once each — or a Monte Carlo at each"/>
                <RadioButton Classes="mode" Content="Centering" IsChecked="{Binding IsCentering}"
                             ToolTip.Tip="Move the designable nominals to maximize yield, then verify on fresh trials"/>
                <RadioButton Classes="mode" Content="DOE" IsChecked="{Binding IsDoe}"
                             ToolTip.Tip="Design of experiments — which factors matter, how they interact, and a response model"/>

                <Border Classes="divider"/>
                </StackPanel>

                <Button Classes="tb" Command="{Binding RunCommand}" ToolTip.Tip="{Binding RunTip}">
                    <mi:MaterialIcon Kind="Play"/>
                </Button>
                <Button Classes="tb" Command="{Binding PauseResumeCommand}" ToolTip.Tip="{Binding PauseResumeTip}">
                    <Panel>
                        <mi:MaterialIcon Kind="Pause" IsVisible="{Binding !IsPaused}"/>
                        <mi:MaterialIcon Kind="PlayPause" IsVisible="{Binding IsPaused}"/>
                    </Panel>
                </Button>
                <Button Classes="tb" Command="{Binding StopCommand}" ToolTip.Tip="Stop — keeps every finished trial">
                    <mi:MaterialIcon Kind="Stop"/>
                </Button>

                <!-- Centering: keep the centred nominals as the Optimizer keeps its best point. -->
                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsCentering}">
                    <Border Classes="divider"/>
                    <Button Classes="tb" Command="{Binding LockInCentredCommand}" ToolTip.Tip="Lock in — keep the centred nominals as a preset">
                        <mi:MaterialIcon Kind="LockOutline"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding PushCentredCommand}" ToolTip.Tip="Push the centred nominals into the schematic (undoable)">
                        <mi:MaterialIcon Kind="TrayArrowDown"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding SendCentredToTuningCommand}" ToolTip.Tip="Send the centred nominals to Tuning">
                        <mi:MaterialIcon Kind="TuneVertical"/>
                    </Button>
                    <Button Classes="tb" ToolTip.Tip="Significant digits for tuned, optimized and centred values">
                        <mi:MaterialIcon Kind="DecimalDecrease"/>
                        <Button.Flyout>
                            <MenuFlyout ItemsSource="{Binding DigitsChoices}" ItemContainerTheme="{StaticResource DigitsMenuItem}"/>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- DOE: the fitted model's best point, confirmed by simulation, then handed on. -->
                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsDoe}">
                    <Border Classes="divider"/>
                    <Button Classes="tb" Command="{Binding FindModelOptimumCommand}"
                            ToolTip.Tip="Model optimum — search the fitted model for the goals' best point, then confirm it by simulation">
                        <mi:MaterialIcon Kind="Crosshairs"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding SendOptimumToTuningCommand}" ToolTip.Tip="Send the model optimum to Tuning">
                        <mi:MaterialIcon Kind="TuneVertical"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding SendOptimumToOptimizerCommand}" ToolTip.Tip="Send the model optimum to the Optimizer as its start point">
                        <mi:MaterialIcon Kind="Target"/>
                    </Button>
                </StackPanel>

                <Border Classes="divider"/>

                <Button Classes="tb" Command="{Binding OpenDisplayCommand}"
                        ToolTip.Tip="{Binding OpenDisplayTip}" ToolTip.ShowOnDisabled="True">
                    <mi:MaterialIcon Kind="ChartBoxOutline"/>
                </Button>
                <Button Classes="tb" Click="OnHelp" ToolTip.Tip="Help">
                    <mi:MaterialIcon Kind="HelpCircleOutline"/>
                </Button>
            </WrapPanel>

            <!-- The yield: value, interval bar against the target, did-not-evaluate. -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="6,0,6,2">
                <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasYield"/>
                        <Binding Path="ShowYieldReadout"/>
                    </MultiBinding>
                </Grid.IsVisible>
                <TextBlock Grid.Column="0" Text="{Binding YieldText}" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding IntervalText}"/>
                <yldv:FractionBar Grid.Column="1" Height="14" MinWidth="60" VerticalAlignment="Center"
                                  Lower="{Binding YieldLower}" Upper="{Binding YieldUpper}" Value="{Binding YieldEstimate}"
                                  Target="{Binding TargetFraction}" ToolTip.Tip="{Binding IntervalText}"/>
                <TextBlock Grid.Column="2" Text="{Binding DidNotEvaluateText}" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="#FFD98C2F"/>
            </Grid>

            <!-- What the last action did, and the one-time display offer. -->
            <StackPanel Grid.Row="3" Margin="6,0,6,2" Spacing="2">
                <!-- Centering: yield vs iteration (the Optimizer's chart, yield on its axis), the best so far, the fit,
                     and the simulated verification. -->
                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasYieldHistory}">
                    <optv:CostSparkline Grid.Column="0" Values="{Binding YieldHistory}" LogScale="False" Height="16" MinWidth="60"
                                        ToolTip.Tip="Best yield per iteration"/>
                    <TextBlock Grid.Column="1" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Text="{Binding SearchYieldText, StringFormat='{}{0} (search)'}"
                               ToolTip.Tip="The best yield the search has found — on the common trials, or the surrogate's virtual ones"/>
                    <TextBlock Grid.Column="2" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                               Text="{Binding FitText}" ToolTip.Tip="The surrogate's poorest fit this iteration"/>
                </Grid>
                <TextBlock FontSize="11" IsVisible="{Binding HasVerification}" TextTrimming="CharacterEllipsis"
                           Text="{Binding VerificationText}"
                           ToolTip.Tip="Start → centred, each verified on the same fresh trials, with its interval"/>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetail}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding OfferYieldDisplay}">
                    <Button Content="Open yield display" FontSize="11" Padding="6,1" MinHeight="0"
                            Command="{Binding OpenDisplayCommand}"/>
                    <Button Classes="tb" Command="{Binding DismissDisplayOfferCommand}" ToolTip.Tip="Dismiss">
                        <mi:MaterialIcon Kind="Close"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Run settings: one summary line, expanded by the chevron. -->
            <!-- Each settings grid is two label/value pairs wide. When that no longer fits, the right-hand pairs (rl/rv)
                 move under the left-hand ones, in their own order (r0…r3 → rows 5…8), so nothing on the left moves.
                 Each threshold is that grid's measured natural width (run 366, centering 388, DOE 325 px) less one.
                 Row and column are set in these styles, not on the elements: a local value would beat the query. -->
            <StackPanel Grid.Row="4" Margin="4,0,4,2" Container.Name="yieldSettings" Container.Sizing="Width">
                <StackPanel.Styles>
                    <Style Selector=":is(Control).rl"><Setter Property="Grid.Column" Value="2"/><Setter Property="Margin" Value="10,0,6,0"/></Style>
                    <Style Selector=":is(Control).rv"><Setter Property="Grid.Column" Value="3"/></Style>
                    <Style Selector=":is(Control).r0"><Setter Property="Grid.Row" Value="0"/></Style>
                    <Style Selector=":is(Control).r1"><Setter Property="Grid.Row" Value="1"/></Style>
                    <Style Selector=":is(Control).r2"><Setter Property="Grid.Row" Value="2"/></Style>
                    <Style Selector=":is(Control).r3"><Setter Property="Grid.Row" Value="3"/></Style>
                    <ContainerQuery Name="yieldSettings" Query="max-width:365">
                        <Style Selector="Grid.sg-run > :is(Control).rl"><Setter Property="Grid.Column" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                        <Style Selector="Grid.sg-run > :is(Control).rv"><Setter Property="Grid.Column" Value="1"/></Style>
                        <Style Selector="Grid.sg-run > :is(Control).r0"><Setter Property="Grid.Row" Value="5"/></Style>
                        <Style Selector="Grid.sg-run > :is(Control).r1"><Setter Property="Grid.Row" Value="6"/></Style>
                        <Style Selector="Grid.sg-run > :is(Control).r2"><Setter Property="Grid.Row" Value="7"/></Style>
                        <Style Selector="Grid.sg-run > :is(Control).r3"><Setter Property="Grid.Row" Value="8"/></Style>
                    </ContainerQuery>
                    <ContainerQuery Name="yieldSettings" Query="max-width:387">
                        <Style Selector="Grid.sg-center > :is(Control).rl"><Setter Property="Grid.Column" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                        <Style Selector="Grid.sg-center > :is(Control).rv"><Setter Property="Grid.Column" Value="1"/></Style>
                        <Style Selector="Grid.sg-center > :is(Control).r0"><Setter Property="Grid.Row" Value="5"/></Style>
                        <Style Selector="Grid.sg-center > :is(Control).r1"><Setter Property="Grid.Row" Value="6"/></Style>
                        <Style Selector="Grid.sg-center > :is(Control).r2"><Setter Property="Grid.Row" Value="7"/></Style>
                        <Style Selector="Grid.sg-center > :is(Control).r3"><Setter Property="Grid.Row" Value="8"/></Style>
                    </ContainerQuery>
                    <ContainerQuery Name="yieldSettings" Query="max-width:324">
                        <Style Selector="Grid.sg-doe > :is(Control).rl"><Setter Property="Grid.Column" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                        <Style Selector="Grid.sg-doe > :is(Control).rv"><Setter Property="Grid.Column" Value="1"/></Style>
                        <Style Selector="Grid.sg-doe > :is(Control).r0"><Setter Property="Grid.Row" Value="5"/></Style>
                        <Style Selector="Grid.sg-doe > :is(Control).r1"><Setter Property="Grid.Row" Value="6"/></Style>
                        <Style Selector="Grid.sg-doe > :is(Control).r2"><Setter Property="Grid.Row" Value="7"/></Style>
                        <Style Selector="Grid.sg-doe > :is(Control).r3"><Setter Property="Grid.Row" Value="8"/></Style>
                    </ContainerQuery>
                </StackPanel.Styles>
                <!-- Sensitivity (brief-sens-3 R-sens3-4): the sensitivity line, each box written only when it differs from
                     its default. The dB and degree boxes are disabled with S-parameters off and keep their place. -->
                <StackPanel IsVisible="{Binding IsSensitivity}" Margin="2,0,0,0" Spacing="1">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Factors" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="cell" Width="104" Margin="0,1"
                                  ItemsSource="{Binding SensFactorChoices}" SelectedIndex="{Binding SensFactorIndex}"
                                  ToolTip.Tip="All: every value the design offers, each at its tolerance when it has one. Toleranced: the values with a tolerance, at ± kσ. Designable: the values the Optimizer moves (opt), at ± step."/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Step" FontSize="11" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="3">
                            <TextBox Classes="cell commit" Width="44" PlaceholderText="1" Margin="0,1"
                                     Text="{Binding SensStepText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip.Tip="A value with no tolerance steps ± this percent of its value"/>
                            <TextBlock Text="%" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="σ" FontSize="11" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox Grid.Row="0" Grid.Column="6" Classes="cell commit" Width="40" PlaceholderText="1" Margin="0,1"
                                 Text="{Binding SensSigmaText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip.Tip="A value with a tolerance steps ± this many σ of its own distribution"/>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Spacing="3">
                            <CheckBox Content="S-parameters" FontSize="11" IsChecked="{Binding SensSnp}" MinHeight="0" Padding="4,0,6,0"
                                      ToolTip.Tip="Step every entry of every S-parameter block — off leaves every block out, keeping each one's own choice below"/>
                            <TextBox Classes="cell commit" Width="44" PlaceholderText="0.1" Margin="0,1" IsEnabled="{Binding SensSnp}"
                                     Text="{Binding SensSnpDbText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip.Tip="An S-parameter entry with no tolerance steps ± this many dB in magnitude"/>
                            <TextBlock Text="dB" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Classes="cell commit" Width="40" PlaceholderText="1" Margin="0,1" IsEnabled="{Binding SensSnp}"
                                     Text="{Binding SensSnpDegText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip.Tip="… and ± this many degrees in phase"/>
                            <TextBlock Text="°" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SensPlanText}" Classes="muted" TextWrapping="Wrap" Margin="0,1,0,0"
                               ToolTip.Tip="What Run will simulate: the nominal, then each factor + and −"/>
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding ShowStatisticsSettings}">
                    <Button Classes="tb" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="Run settings">
                        <Panel>
                            <mi:MaterialIcon Kind="ChevronRight" IsVisible="{Binding !SettingsExpanded}"/>
                            <mi:MaterialIcon Kind="ChevronDown" IsVisible="{Binding SettingsExpanded}"/>
                        </Panel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding SettingsSummary}" FontSize="11" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Classes="sg-run" ColumnDefinitions="Auto,90,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20,2,0,2">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="SettingsExpanded"/>
                            <Binding Path="ShowStatisticsSettings"/>
                        </MultiBinding>
                    </Grid.IsVisible>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Trials" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Classes="cell commit" PlaceholderText="100" Margin="0,1"
                             Text="{Binding TrialsText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="The number of trials — with auto-stop, the cap"/>
                    <TextBlock Classes="rl r0" Text="Seed" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Classes="rv r0" Orientation="Horizontal">
                        <TextBox Classes="cell commit" Width="70" PlaceholderText="1" Margin="0,1"
                                 Text="{Binding SeedText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip.Tip="The same seed draws the same trials"/>
                        <Button Classes="tb" Command="{Binding NewSeedCommand}" ToolTip.Tip="A new seed">
                            <mi:MaterialIcon Kind="DiceMultipleOutline"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sampling" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Classes="cell" Margin="0,1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SamplingChoices}" SelectedIndex="{Binding SamplingIndex}"/>
                    <TextBlock Classes="rl r1" Text="Target %" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Classes="rv r1 cell commit" Width="70" HorizontalAlignment="Left"
                             PlaceholderText="none" Margin="0,1"
                             Text="{Binding TargetText, UpdateSourceTrigger=LostFocus}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Confidence %" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="cell commit" PlaceholderText="95" Margin="0,1"
                             Text="{Binding ConfidenceText, UpdateSourceTrigger=LostFocus}"/>
                    <CheckBox Classes="rl r2" Grid.ColumnSpan="2" Content="Auto-stop at the target" FontSize="11"
                              IsChecked="{Binding AutoStop}"
                              ToolTip.Tip="Stop once the interval lies wholly above or below the target (50 trials at least)"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Did not evaluate" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Classes="cell" Margin="0,1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding NonConvergedChoices}" SelectedIndex="{Binding NonConvergedIndex}"
                              ToolTip.Tip="Fail: counted as a fail. Warn: left out of the yield."/>
                    <TextBlock Classes="rl r3" Text="Save" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Classes="rv r3 cell commit" Width="70" HorizontalAlignment="Left"
                             PlaceholderText="auto" Margin="0,1"
                             Text="{Binding SaveText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="auto, scalars, all, or the first N trials' sweeps"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Parallel" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Classes="cell commit" PlaceholderText="auto" Margin="0,1"
                             Text="{Binding ParallelText, UpdateSourceTrigger=LostFocus}"/>
                </Grid>

                <!-- Centering settings: the center line, one summary line, expanded by its chevron. -->
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsCentering}">
                    <Button Classes="tb" Command="{Binding ToggleCenterSettingsCommand}" ToolTip.Tip="Centering settings">
                        <Panel>
                            <mi:MaterialIcon Kind="ChevronRight" IsVisible="{Binding !CenterSettingsExpanded}"/>
                            <mi:MaterialIcon Kind="ChevronDown" IsVisible="{Binding CenterSettingsExpanded}"/>
                        </Panel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding CenterSettingsSummary}" FontSize="11" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Classes="sg-center" ColumnDefinitions="Auto,90,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20,2,0,2">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsCentering"/>
                            <Binding Path="CenterSettingsExpanded"/>
                        </MultiBinding>
                    </Grid.IsVisible>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Algorithm" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Classes="cell" Margin="0,1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding CenterAlgorithmChoices}" SelectedIndex="{Binding CenterAlgorithmIndex}"/>
                    <TextBlock Classes="rl r0" Text="Surrogate" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Classes="rv r0 cell" Width="96" HorizontalAlignment="Left" Margin="0,1"
                              ItemsSource="{Binding SurrogateChoices}" SelectedIndex="{Binding SurrogateIndex}"
                              ToolTip.Tip="quadratic: search on a quadratic fit of the margins — the result is still verified by simulation"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Common trials" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="cell commit" PlaceholderText="200" Margin="0,1"
                             Text="{Binding CenterTrialsText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="M — the trials every candidate is scored on"/>
                    <TextBlock Classes="rl r1" Text="Verify" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Classes="rv r1 cell commit" Width="70" HorizontalAlignment="Left"
                             PlaceholderText="1000" Margin="0,1"
                             Text="{Binding CenterVerifyText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="Fresh trials the start and the centred point are each verified on"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Max iterations" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="cell commit" PlaceholderText="100" Margin="0,1"
                             Text="{Binding CenterMaxIterText, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Classes="rl r2" Text="Max simulations" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Classes="rv r2 cell commit" Width="70" HorizontalAlignment="Left"
                             PlaceholderText="none" Margin="0,1"
                             Text="{Binding CenterMaxEvalsText, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
                <!-- DOE settings: the doe line, one summary line, expanded by its chevron. -->
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsDoe}">
                    <Button Classes="tb" Command="{Binding ToggleDoeSettingsCommand}" ToolTip.Tip="Design settings">
                        <Panel>
                            <mi:MaterialIcon Kind="ChevronRight" IsVisible="{Binding !DoeSettingsExpanded}"/>
                            <mi:MaterialIcon Kind="ChevronDown" IsVisible="{Binding DoeSettingsExpanded}"/>
                        </Panel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding DoeSettingsSummary}" FontSize="11" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Grid Classes="sg-doe" ColumnDefinitions="Auto,110,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20,2,0,2">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsDoe"/>
                            <Binding Path="DoeSettingsExpanded"/>
                        </MultiBinding>
                    </Grid.IsVisible>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Design" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Classes="cell" Margin="0,1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DoeDesignChoices}" SelectedIndex="{Binding DoeDesignIndex}"
                              ToolTip.Tip="Full factorial for a few factors; Plackett–Burman to screen many; a composite for a quadratic model"/>
                    <TextBlock Classes="rl r0" Text="Resolution" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding IsDoeFrac}"/>
                    <ComboBox Classes="rv r0 cell" Width="64" HorizontalAlignment="Left" Margin="0,1"
                              ItemsSource="{Binding DoeResolutionChoices}" SelectedIndex="{Binding DoeResolutionIndex}"
                              IsVisible="{Binding IsDoeFrac}"
                              ToolTip.Tip="IV: main effects clear of interactions. V: interactions clear of each other."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Factors" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Classes="cell" Margin="0,1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DoeFactorChoices}" SelectedIndex="{Binding DoeFactorIndex}"
                              ToolTip.Tip="The Opt rows over their ranges, or the Stat rows at nominal ± k σ"/>
                    <TextBlock Classes="rl r1" Text="± σ" FontSize="11" VerticalAlignment="Center"
                               IsVisible="{Binding IsDoeStat}"/>
                    <TextBox Classes="rv r1 cell commit" Width="64" HorizontalAlignment="Left"
                             PlaceholderText="1" Margin="0,1" IsVisible="{Binding IsDoeStat}"
                             Text="{Binding DoeSigmaText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="k — each tolerance's levels are nominal ± k σ"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Centre points" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="cell commit" PlaceholderText="1" Margin="0,1"
                             Text="{Binding DoeCentreText, UpdateSourceTrigger=LostFocus}"
                             ToolTip.Tip="Centre points check a two-level model for curvature"/>
                    <TextBlock Classes="rl r2" Text="Goals" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Classes="rv r2 cell" Width="72" HorizontalAlignment="Left" Margin="0,1"
                              ItemsSource="{Binding DoeResponseChoices}" SelectedIndex="{Binding DoeResponseIndex}"
                              ToolTip.Tip="goals: those the factors are for. all: every enabled goal. Scalar measures always."/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,6">

                    <!-- ── Variables ───────────────────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,Auto" Margin="6,4,4,0" IsVisible="{Binding !IsSensitivity}">
                        <TextBlock Text="Variables" Classes="section"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="tb" x:Name="AddButton" ToolTip.Tip="Add tolerances…">
                                <mi:MaterialIcon Kind="Plus"/>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Grid RowDefinitions="Auto,Auto,*" Width="320" Height="300"
                                              DataContext="{Binding Add}" x:DataType="tun:TuningAddViewModel">
                                            <!-- The search box takes what the × leaves: the popup's width is unchanged. -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" x:Name="AddSearch" Text="{Binding SearchText}"
                                                         PlaceholderText="Name, instance, parameter or cell" FontSize="12">
                                                    <TextBox.InnerLeftContent>
                                                        <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Margin="6,0,0,0" Opacity="0.6"/>
                                                    </TextBox.InnerLeftContent>
                                                </TextBox>
                                                <Button Grid.Column="1" Classes="tb" Margin="4,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding CloseCommand}" ToolTip.Tip="Close">
                                                    <mi:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                            <CheckBox Grid.Row="1" Content="Include sub-cells" FontSize="12" Margin="0,4"
                                                      IsChecked="{Binding IncludeSubCells}"/>
                                            <ListBox Grid.Row="2" x:Name="AddList" Classes="AddRows"
                                                     ItemsSource="{Binding Results}" SelectionMode="Multiple,Toggle">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="tun:TuningAddRow">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding Display}" FontSize="12"/>
                                                                <TextBlock Text="{Binding Location}" Classes="muted" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11"
                                                                       Opacity="0.8" Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="tb" Command="{Binding EditCorrelationsCommand}"
                                    ToolTip.Tip="Correlations… between toleranced values">
                                <mi:MaterialIcon Kind="VectorLink"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Kit statistics: what the kits' statistical sections draw. -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="6,1,4,1">
                        <Grid.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasKitStatistics"/>
                                <Binding Path="ShowVariableTolerances"/>
                            </MultiBinding>
                        </Grid.IsVisible>
                        <TextBlock Grid.Column="0" Text="Kit statistics" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox Grid.Column="1" Content="Process" FontSize="11" IsChecked="{Binding KitProcess}" Margin="0,0,6,0"/>
                        <CheckBox Grid.Column="2" Content="Mismatch" FontSize="11" IsChecked="{Binding KitMismatch}" Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding KitSectionsText}" ToolTip.Tip="{Binding KitStreamsText}"/>
                        <Button Grid.Column="4" Content="Choose a corner…" FontSize="11" Padding="4,0" MinHeight="0"
                                IsVisible="{Binding KitNeedsSection}" Command="{Binding ShowCornerPickerCommand}"
                                ToolTip.Tip="{Binding KitNote}"/>
                    </Grid>

                    <!-- Library parts (brief vendorlib-13 R-vl13-1c): each placed part whose model holds a distribution, its
                         spreads read-only; unticked, its draws are held at nominal (statistics nominalparts=). They are
                         mismatch draws, so the Mismatch switch above holds them too. -->
                    <StackPanel Margin="6,1,4,1" Spacing="1">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasLibraryParts"/>
                                <Binding Path="ShowVariableTolerances"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Text="Library parts" FontSize="11" Margin="0,2,0,0"
                                   ToolTip.Tip="Tolerances written in a library part's own model. Unticked, that part is held at nominal; the Mismatch switch holds every part's."/>
                        <ItemsControl x:Name="LibraryPartList" ItemsSource="{Binding LibraryPartRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="yld:LibraryPartRowViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,1,0,1">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsDrawn}" FontSize="12" Margin="0,0,6,0"
                                                  Content="{Binding Part}"
                                                  ToolTip.Tip="Draw this part's own tolerances; unticked, they are held at nominal."/>
                                        <TextBlock Grid.Column="1" Text="{Binding InstancesText}" Classes="muted" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SpreadsText}" Classes="muted" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SpreadsText}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Centering: the designable nominals with their ranges and the tolerances beside them, start → best. -->
                    <ItemsControl ItemsSource="{Binding CenterRows}" IsVisible="{Binding IsCentering}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="yld:YieldCenterRowViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,60" Margin="6,1,4,1">
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12" MinWidth="64"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RangeText}" Classes="muted" ToolTip.Tip="Range"/>
                                        <TextBlock Text="{Binding ToleranceText}" Classes="muted" IsVisible="{Binding HasTolerance}"
                                                   ToolTip.Tip="Tolerance"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                IsVisible="{Binding HasBest}" Margin="6,0">
                                        <TextBlock Text="{Binding StartText}" FontSize="11" Opacity="0.7" ToolTip.Tip="Start"/>
                                        <TextBlock Text="→" FontSize="11" Opacity="0.7"/>
                                        <TextBlock Text="{Binding BestText}" FontSize="11" ToolTip.Tip="Centred"/>
                                    </StackPanel>
                                    <optv:RangeMarkBar Grid.Column="4" Height="14" VerticalAlignment="Center"
                                                       Position="{Binding BestPosition}" RailedMin="{Binding RailedMin}"
                                                       RailedMax="{Binding RailedMax}">
                                        <optv:RangeMarkBar.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="HasBest"/>
                                                <Binding Path="IsDesignable"/>
                                            </MultiBinding>
                                        </optv:RangeMarkBar.IsVisible>
                                    </optv:RangeMarkBar>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- One line wherever it fits; the distribution and the spread move to a second line under the
                         name only as a last resort (below about 330 px, 360 px with the contribution bar). The star
                         column's MinWidth is what keeps the spread from being arranged over the distribution: a child
                         wider than its cell is centred on it, i.e. pushed LEFT over its neighbour. Grid.Row/Column
                         live in the styles because a local value would beat the query's setters. -->
                    <ItemsControl ItemsSource="{Binding Variables}" IsVisible="{Binding ShowVariableTolerances}"
                                  Grid.IsSharedSizeScope="True" Container.Name="yieldVars" Container.Sizing="Width">
                        <ItemsControl.Styles>
                            <Style Selector="ComboBox.dist">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                            <Style Selector="TextBox.spread">
                                <Setter Property="Grid.Row" Value="0"/>
                                <Setter Property="Grid.Column" Value="3"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                                <Setter Property="Margin" Value="4,0"/>
                            </Style>
                            <Style Selector="TextBlock.nominal">
                                <Setter Property="Grid.Column" Value="4"/>
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </Style>
                            <ContainerQuery Name="yieldVars" Query="max-width:330">
                                <Style Selector="Grid.yv > ComboBox.dist">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Margin" Value="0,2,0,2"/>
                                </Style>
                                <Style Selector="Grid.yv > TextBox.spread">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="5"/>
                                    <Setter Property="Margin" Value="4,2,0,2"/>
                                </Style>
                                <!-- The nominal takes the spread's empty columns on the first line, so the star column's
                                     minimum is not paid twice and the row still fits at 300 px. -->
                                <Style Selector="Grid.yv > TextBlock.nominal">
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </ContainerQuery>
                            <!-- A row showing its contribution bar needs 44 px more before it gives up its one line. -->
                            <ContainerQuery Name="yieldVars" Query="max-width:360">
                                <Style Selector="Grid.yv.shared > ComboBox.dist">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="1"/>
                                    <Setter Property="Margin" Value="0,2,0,2"/>
                                </Style>
                                <Style Selector="Grid.yv.shared > TextBox.spread">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="5"/>
                                    <Setter Property="Margin" Value="4,2,0,2"/>
                                </Style>
                                <!-- The nominal takes the spread's empty columns on the first line, so the star column's
                                     minimum is not paid twice and the row still fits at 300 px. -->
                                <Style Selector="Grid.yv.shared > TextBlock.nominal">
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </ContainerQuery>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="yld:YieldVariableRowViewModel">
                                <Grid Classes="yv" Classes.shared="{Binding HasShare}" RowDefinitions="Auto,Auto" Margin="6,1,4,1"
                                      ToolTip.Tip="{Binding DisabledReason}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="yvKey"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="64"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="yvNominal"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsStat}" MinWidth="0" Padding="0"
                                              Margin="0,0,4,0" ToolTip.Tip="Draw this value in every trial"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Key}" FontSize="12"/>
                                        <TextBlock Text="{Binding Location}" Classes="muted" IsVisible="{Binding HasLocation}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox Classes="cell dist" Width="92" ItemsSource="{Binding Distributions}"
                                              SelectedItem="{Binding Distribution}" VerticalAlignment="Center"
                                              ToolTip.Tip="Distribution"/>
                                    <TextBox Classes="cell spread" VerticalAlignment="Center"
                                             Text="{Binding SpreadText, Mode=OneWay}"
                                             ToolTip.Tip="Spread: ± 2 %, ± 5 % at 3σ, σ 1 Ω (Gaussian); 45 … 55 Ω (Uniform); 4 … 8 by 2 (Discrete); then , trunc 3σ"/>
                                    <TextBlock Classes="nominal" Text="{Binding NominalText}" FontSize="11" Opacity="0.8"
                                               VerticalAlignment="Center" Margin="2,0,6,0" ToolTip.Tip="Nominal"/>
                                    <yldv:FractionBar Grid.Column="5" Width="44" Height="12" IsVisible="{Binding HasShare}"
                                                      Upper="{Binding ShareValue}" VerticalAlignment="Center"
                                                      ToolTip.Tip="{Binding ShareText}"/>
                                    <Button Grid.Column="6" Classes="tb" ToolTip.Tip="More">
                                        <mi:MaterialIcon Kind="DotsVertical"/>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Remove tolerance" Command="{Binding RemoveCommand}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Sensitivity (brief-sens-3 R-sens3-4…6) ─────────────────────── -->
                    <StackPanel IsVisible="{Binding IsSensitivity}" Grid.IsSharedSizeScope="True">
                        <!-- S-parameter blocks: there BEFORE a run, so a fixed block can be left out before its cost is spent. -->
                        <StackPanel IsVisible="{Binding HasSnpBlocks}" Margin="0,4,0,0">
                            <TextBlock Text="S-parameter blocks" Classes="section" Margin="6,0,4,1"/>
                            <ListBox Classes="rows" ItemsSource="{Binding VisibleSnpBlocks}" SelectedItem="{Binding SelectedSnpBlock}"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="yld:SnpBlockRowViewModel">
                                        <Grid ColumnDefinitions="Auto,Auto,*" ToolTip.Tip="{Binding TieReason}">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded}" IsEnabled="{Binding IsEnabled}"
                                                      MinWidth="0" Padding="0" Margin="0,0,4,0"
                                                      ToolTip.Tip="Include — step this block's entries; unticked, it is left out (snpexclude)"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Instance}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="{Binding ShowAllSnpText}" Command="{Binding ToggleShowAllSnpCommand}" IsVisible="{Binding HasMoreSnpBlocks}"
                                    FontSize="11" Padding="6,0" MinHeight="0" Margin="6,1,0,0" Background="Transparent"
                                    Foreground="{DynamicResource SystemAccentColor}"/>
                        </StackPanel>

                        <!-- The ranking: one row per contributor of the selected response, by entry, port or instance.
                             A WrapPanel, not a three-column Grid: a horizontal StackPanel in a star column does not
                             clip, so in a narrow panel the radios ran on under the button. Here the button wraps to the
                             next line instead. -->
                        <WrapPanel Orientation="Horizontal" Margin="6,6,4,1">
                            <TextBlock Text="Ranking" Classes="section" Margin="0,0,8,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <RadioButton Classes="mode" Content="Entry" IsChecked="{Binding IsByEntry}"
                                             ToolTip.Tip="One row per value — an S-parameter's dB and phase together"/>
                                <RadioButton Classes="mode" Content="Port" IsChecked="{Binding IsByPort}"
                                             ToolTip.Tip="An S-parameter block by port: every entry in that port's row or column (shares overlap)"/>
                                <RadioButton Classes="mode" Content="Instance" IsChecked="{Binding IsByInstance}"
                                             ToolTip.Tip="One row per part, block or variable — expand to its entries"/>
                            </StackPanel>
                            <Button Content="Run Yield on these" FontSize="11" Padding="6,1" MinHeight="0"
                                    VerticalAlignment="Center"
                                    Command="{Binding RunYieldOnTheseCommand}"
                                    ToolTip.Tip="The Yield panel, on this schematic, in Monte Carlo mode"/>
                        </WrapPanel>
                        <ComboBox Classes="cell" Margin="6,0,4,2" HorizontalAlignment="Stretch" IsVisible="{Binding HasSensResult}"
                                  ItemsSource="{Binding SensResponses}" SelectedItem="{Binding SelectedSensResponse}"
                                  ToolTip.Tip="The goal or measure ranked — or select a goal under Specs"/>
                        <!-- The header's columns are the rows' (the item's 6 px padding, the expander, the shared basis). -->
                        <Grid Margin="6,0,6,0" IsVisible="{Binding HasSensRows}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="sensBasis"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="basis" Classes="muted" Margin="6,0,8,0"/>
                            <TextBlock Grid.Column="3" Text="Δ" Classes="muted" TextAlignment="Right" Margin="0,0,6,0"
                                       ToolTip.Tip="(m⁺ − m⁻)/2 — a goal's change in normalized margin, a measure's in its own unit; a group's is √ΣΔ²"/>
                            <TextBlock Grid.Column="4" Text="{Binding ShareHeader}" Classes="muted"/>
                        </Grid>
                        <ListBox x:Name="SensList" Classes="rows" ItemsSource="{Binding SensRows}" SelectedItem="{Binding SelectedSensRow}"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="yld:SensitivityRowViewModel">
                                    <Border Classes.excludedrow="{Binding IsExcluded}" Background="Transparent">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Add tolerance" Command="{Binding AddToleranceCommand}" IsEnabled="{Binding CanAddTolerance}"/>
                                                <MenuItem Header="Send to Tuning" Command="{Binding SendToTuningCommand}" IsEnabled="{Binding CanTuneOrOptimize}"/>
                                                <MenuItem Header="Use in Optimizer" Command="{Binding UseInOptimizerCommand}" IsEnabled="{Binding CanTuneOrOptimize}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="sensBasis"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="18"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="{Binding Indent}"/>
                                            <Button Grid.Column="1" Classes="tb" IsVisible="{Binding CanExpand}" Command="{Binding ToggleExpandCommand}"
                                                    ToolTip.Tip="Expand">
                                                <Panel>
                                                    <mi:MaterialIcon Kind="ChevronRight" Width="12" Height="12" IsVisible="{Binding !IsExpanded}"/>
                                                    <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" IsVisible="{Binding IsExpanded}"/>
                                                </Panel>
                                            </Button>
                                            <CheckBox Grid.Column="1" IsVisible="{Binding IsExcluded}" IsChecked="{Binding IsIncluded}"
                                                      MinWidth="0" Padding="0" ToolTip.Tip="Include in the next run"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Basis}" Classes="muted" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DeltaText}" FontSize="11" TextAlignment="Right"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <yldv:FractionBar Grid.Column="5" Height="12" Upper="{Binding Share}" IsVisible="{Binding HasShare}"
                                                              VerticalAlignment="Center" ToolTip.Tip="{Binding ShareText}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding ShareText}" FontSize="11" TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <Panel Grid.Column="7" Background="Transparent" ToolTip.Tip="{Binding StatusTip}" VerticalAlignment="Center">
                                                <mi:MaterialIcon Kind="SineWave" Width="13" Height="13" IsVisible="{Binding IsNonlinear}" Foreground="#FFD98C2F"/>
                                                <mi:MaterialIcon Kind="ContrastCircle" Width="13" Height="13" IsVisible="{Binding IsOneSided}" Foreground="#FFD98C2F"/>
                                                <mi:MaterialIcon Kind="AlertCircleOutline" Width="13" Height="13" IsVisible="{Binding IsFailed}" Foreground="#FFD94F4F"/>
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- The SnP matrix tile (R-sens3-6). -->
                        <Border IsVisible="{Binding HasSnpTile}" Margin="6,6,4,0" Padding="6" CornerRadius="3"
                                BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1">
                            <StackPanel DataContext="{Binding SnpTile}" x:DataType="yld:SnpMatrixTileViewModel" Spacing="4">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Instance}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <CheckBox Content="Include" FontSize="11" MinHeight="0" Margin="0,0,10,0"
                                              IsChecked="{Binding IsIncluded}" IsEnabled="{Binding IsIncludeEnabled}"
                                              ToolTip.Tip="Step this block's entries — the same setting as its row under S-parameter blocks"/>
                                    <CheckBox Content="Tie reciprocal pairs (S21 = S12)" FontSize="11" MinHeight="0"
                                              IsChecked="{Binding IsTied}" IsEnabled="{Binding CanTie}"
                                              ToolTip.Tip="{Binding TieTip}" ToolTip.ShowOnDisabled="True"/>
                                </WrapPanel>
                                <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding Ports}" x:DataType="yld:SnpMatrixTileViewModel"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="yld:SnpMatrixCell">
                                            <Border Classes="snpcell" Classes.port="{Binding InSelectedPort}" Classes.entry="{Binding IsSelectedEntry}"
                                                    Width="{Binding Size}" Height="{Binding Size}" Margin="1"
                                                    Background="{Binding Intensity, Converter={x:Static yldv:YieldToolView.ShareBrush}}"
                                                    ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Text="{Binding Label}" FontSize="9" IsVisible="{Binding ShowLabel}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{Binding Intensity, Converter={x:Static yldv:YieldToolView.ShareText}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasShares}">
                                    <TextBlock Text="0" Classes="muted" VerticalAlignment="Center"/>
                                    <Border Width="90" Height="8" CornerRadius="2" Background="{x:Static yldv:YieldToolView.ShareLegend}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LegendMaxText}" Classes="muted" VerticalAlignment="Center"/>
                                    <TextBlock Text="share" Classes="muted" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── DOE: the plan, the effects, the model optimum ─────────────────── -->
                    <StackPanel IsVisible="{Binding IsDoe}">
                        <TextBlock Text="Factors" Classes="section" Margin="6,6,4,0"/>
                        <TextBlock Text="{Binding DoePlanText}" Classes="muted" TextWrapping="Wrap" Margin="6,0,4,2"/>
                        <ItemsControl ItemsSource="{Binding DoeFactors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="yld:DoeFactorRow">
                                    <Grid ColumnDefinitions="18,*,Auto" Margin="6,1,4,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Low}" Classes="muted"/>
                                            <TextBlock Text="·" Classes="muted"/>
                                            <TextBlock Text="{Binding Centre}" Classes="muted"/>
                                            <TextBlock Text="·" Classes="muted"/>
                                            <TextBlock Text="{Binding High}" Classes="muted"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid ColumnDefinitions="Auto,*" Margin="6,6,4,0" IsVisible="{Binding HasDoeEffects}">
                            <TextBlock Text="Effects" Classes="section" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Classes="cell" Margin="8,0,0,0" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding DoeResponses}" SelectedItem="{Binding SelectedDoeResponse}"
                                      ToolTip.Tip="The response whose effects are listed"/>
                        </Grid>
                        <TextBlock Text="{Binding DoeFitText}" Classes="muted" Margin="6,0,4,2" IsVisible="{Binding HasDoeEffects}"
                                   ToolTip.Tip="An effect beyond Lenth's margin is active (bold)"/>
                        <ItemsControl ItemsSource="{Binding DoeEffects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="yld:DoeEffectRow">
                                    <Grid ColumnDefinitions="44,80,*" Margin="6,0,4,0" ToolTip.Tip="{Binding Aliases}">
                                        <TextBlock Grid.Column="0" Text="{Binding Term}" FontSize="12"
                                                   FontWeight="{Binding Active, Converter={x:Static yldv:YieldToolView.ActiveWeight}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Effect}" FontSize="12" TextAlignment="Right" Margin="0,0,8,0"
                                                   FontWeight="{Binding Active, Converter={x:Static yldv:YieldToolView.ActiveWeight}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Aliases}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel IsVisible="{Binding HasDoeOptimum}" Margin="6,6,4,0">
                            <TextBlock Text="Model optimum" Classes="section"/>
                            <TextBlock Text="{Binding DoeOptimumText}" FontSize="11" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding DoeOptimumGoals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="yld:DoeOptimumRow">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                                            <TextBlock Grid.Column="0" Text="{Binding Goal}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Predicted, StringFormat='predicted {0}'}" Classes="muted" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Simulated, StringFormat='simulated {0}'}" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Specs ─────────────────────────────────────────────────────── -->
                    <Grid ColumnDefinitions="*,Auto" Margin="6,6,4,0">
                        <TextBlock Text="Specs" Classes="section"/>
                        <Button Grid.Column="1" Classes="tb" Command="{Binding EditGoalsCommand}"
                                ToolTip.Tip="Edit goals… in the Optimizer">
                            <mi:MaterialIcon Kind="Pencil"/>
                        </Button>
                    </Grid>
                    <ListBox Classes="rows" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}"
                             Background="Transparent" Grid.IsSharedSizeScope="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="yld:YieldGoalRowViewModel">
                                <!-- The readout column is shared, so every row's Use box lines up whatever its readout says. -->
                                <Grid ToolTip.Tip="{Binding Summary}"
                                      Opacity="{Binding IsEnabled, Converter={x:Static yldv:YieldToolView.EnabledOpacity}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="goalReadout"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="muted" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <optv:GoalUseTicksView Grid.Column="2" Margin="4,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding YieldText}" FontSize="11" MinWidth="46"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                               ToolTip.Tip="{Binding IntervalText}"/>
                                    <!-- Sensitivity: m₀ and σ_g, and the first-order pass estimate when SENS-1 D5 allows one. -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding HasSens}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding SensText}" FontSize="11"
                                                   ToolTip.Tip="The normalized margin at the nominal (m₀) and the predicted spread (σ)"/>
                                        <TextBlock Text="{Binding EstimateText}" Classes="muted" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <yldv:FractionBar Grid.Column="4" Height="12" IsVisible="{Binding HasYield}"
                                                      Lower="{Binding Lower}" Upper="{Binding Upper}" Value="{Binding Estimate}"
                                                      Target="{Binding Target}" IsBad="{Binding BelowTarget}"
                                                      VerticalAlignment="Center" ToolTip.Tip="{Binding IntervalText}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ── Trials (Monte Carlo and Yield) ───────────────────────────────── -->
                    <StackPanel IsVisible="{Binding ShowTrials}">
                        <Grid ColumnDefinitions="*,Auto" Margin="6,6,4,0" IsVisible="{Binding HasTrials}">
                            <TextBlock Text="Trials" Classes="section"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton Classes="tb" IsChecked="{Binding FailOnly}" ToolTip.Tip="Fails only">
                                    <mi:MaterialIcon Kind="FilterOutline"/>
                                </ToggleButton>
                                <Button Classes="tb" Command="{Binding SortByTrialCommand}" ToolTip.Tip="Sort by trial">
                                    <mi:MaterialIcon Kind="SortNumericAscending"/>
                                </Button>
                                <Button Classes="tb" Command="{Binding SortByMarginCommand}" ToolTip.Tip="Sort by margin, tightest first">
                                    <mi:MaterialIcon Kind="SortAscending"/>
                                </Button>
                                <Button Classes="tb" Command="{Binding ContributionsCommand}"
                                        ToolTip.Tip="Contributions — which variables drive the selected spec">
                                    <mi:MaterialIcon Kind="ChartBar"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="TrialList" Classes="rows" ItemsSource="{Binding Trials}" MaxHeight="260"
                                 SelectedItem="{Binding SelectedTrial}" Background="Transparent"
                                 IsVisible="{Binding HasTrials}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Send trial to Tuning" Command="{Binding SendTrialToTuningCommand}"/>
                                    <MenuItem Header="Re-run trial" Command="{Binding RerunSelectedTrialCommand}"/>
                                    <MenuItem Header="Copy values" Command="{Binding CopyTrialValuesCommand}"/>
                                    <MenuItem Header="Save as corner…" Command="{Binding SaveTrialAsCornerCommand}"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="yld:YieldTrialRowViewModel">
                                    <Grid ColumnDefinitions="44,40,*,64" ToolTip.Tip="{Binding Reason}">
                                        <TextBlock Grid.Column="0" Text="{Binding Trial}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PassText}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{Binding IsFail, Converter={x:Static yldv:YieldToolView.FailBrush}}"/>
                                        <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding WorstGoal}" IsVisible="{Binding !DidNotEvaluate}"/>
                                        <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Reason}" Opacity="0.7" IsVisible="{Binding DidNotEvaluate}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding MarginText}" FontSize="11" TextAlignment="Right"
                                                   VerticalAlignment="Center" ToolTip.Tip="Margin on the tightest spec"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- ── Corners ────────────────────────────────────────────────────── -->
                    <StackPanel IsVisible="{Binding IsCorners}">
                        <Grid ColumnDefinitions="*,Auto" Margin="6,6,4,0">
                            <TextBlock Text="Corners" Classes="section"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <CheckBox Content="MC at each corner" FontSize="11" IsChecked="{Binding MonteCarloAtEachCorner}"
                                          ToolTip.Tip="A Monte Carlo at each corner — mismatch drawn around each"/>
                                <Button Classes="tb" Command="{Binding GenerateCornersCommand}"
                                        ToolTip.Tip="Generate… corners from kit sections, temperatures and values">
                                    <mi:MaterialIcon Kind="TableLarge"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Corners}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="yld:YieldCornerRowViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,1,4,1">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" MinWidth="0" Padding="0"
                                                  Margin="0,0,4,0" ToolTip.Tip="Enabled"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KitText}" Classes="muted"/>
                                            <TextBlock Text="{Binding TempText}" Classes="muted"/>
                                            <TextBlock Text="{Binding ValuesText}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TrialText}" Classes="muted" FontStyle="Italic"
                                                       IsVisible="{Binding IsStatistical}"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="tb" ToolTip.Tip="More">
                                            <mi:MaterialIcon Kind="DotsVertical"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Remove corner" Command="{Binding RemoveCommand}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The result: corner × goal, failing cells red, each goal's worst corner bold. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding HasCornerGrid}" Margin="6,6,4,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="90" Text="" />
                                    <ItemsControl ItemsSource="{Binding CornerGoals}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Classes="gridcell" Text="{Binding}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding CornerGrid}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="yld:CornerGridRow">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Width="90" Text="{Binding Corner}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="yld:CornerGridCell">
                                                            <TextBlock Classes="gridcell" Text="{Binding Text}"
                                                                       Classes.fail="{Binding Fails}" Classes.worst="{Binding IsWorst}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
