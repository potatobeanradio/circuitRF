<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:msg="using:CircuitRF.Ui.Messages"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Messages.MessagesView"
             x:DataType="vm:MessagesTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <conv:MessageLevelToIconConverter  x:Key="LevelToIcon"  />
        <conv:MessageLevelToColorConverter x:Key="LevelToColor" />
        <conv:IsNotNullConverter           x:Key="IsNotNull"    />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header strip. Copy All is deliberately pinned LEFT and Clear RIGHT, at opposite ends of
             the strip: they are a benign action and a destructive one, and putting them side by side
             invites clearing the log when you meant to copy it (owner's explicit request). -->
        <Grid Grid.Row="0" Margin="4,1,4,1">
            <Button x:Name="CopyAllButton"
                    HorizontalAlignment="Left"
                    Click="OnCopyAllMessagesClick"
                    ToolTip.Tip="Copy all messages to the clipboard"
                    Padding="4,1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11">
                <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
            </Button>

            <Button HorizontalAlignment="Right"
                    Command="{Binding ClearMessagesCommand}"
                    ToolTip.Tip="Clear messages"
                    Padding="4,1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11">
                <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14"/>
            </Button>
        </Grid>

        <!-- Message list — scrollable, selectable. Named for scroll-to-bottom in code-behind. -->
        <ListBox Grid.Row="1"
                 x:Name="MessagesListBox"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:MessageEntry">
                    <!-- The progress bar sits INLINE, immediately after the message text, and the
                         changing counter comes AFTER the bar. That ordering is what keeps it still:
                         the text before it is constant for the whole run (the analysis name), so
                         there is nothing on the bar's left that can grow and shove it. Putting the
                         counter back into the message text would undo this. -->
                    <Grid ColumnDefinitions="Auto,*" Margin="4,1">

                        <!-- Level icon (meaning, not color alone) -->
                        <mi:MaterialIcon Grid.Column="0"
                                         Kind="{Binding Level, Converter={StaticResource LevelToIcon}}"
                                         Foreground="{Binding Level, Converter={StaticResource LevelToColor}}"
                                         Width="14" Height="14"
                                         Margin="0,1,6,0"
                                         VerticalAlignment="Top"/>

                        <!-- One line: timestamp · message (plain) · file-path link. Only the path is
                             a link: it is a separate SelectableTextBlock hosted in an InlineUIContainer
                             so it flows inline right after the text (wrapping naturally), is itself
                             selectable/copyable, and is the ONLY element that reveals on tap. The
                             timestamp and message text are plain runs — not clickable, no link cursor. -->
                        <SelectableTextBlock Grid.Column="1"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Top"
                                             ContextFlyout="{x:Null}">
                            <!-- Our own menu REPLACES the stock SelectableTextBlock one, whose Copy
                                 disables itself whenever the selection runs past Inlines.Text.Length
                                 (see MessageTextSelection for the decompiled root cause). Declared
                                 once per row in XAML and owned by the framework — never constructed
                                 per right-click, which is the menu-stacking bug this codebase has
                                 already fixed twice (LayoutCanvas, PlotControl). Copy is always
                                 enabled: with no selection it falls back to the whole message, so
                                 there is no state in which the user cannot copy. -->
                            <SelectableTextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="OnCopyMessageClick"/>
                                    <MenuItem Header="Copy All Messages" Click="OnCopyAllMessagesClick"/>
                                </ContextMenu>
                            </SelectableTextBlock.ContextMenu>
                            <Run Text="{Binding TimeText}"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <Run Text="{Binding TextInline}"
                                 Foreground="{DynamicResource SystemBaseHighColor}"/>

                            <!-- Progress bar for a LIVE message (a running simulation). Absent — not
                                 merely empty — on every ordinary message, so the log is unchanged
                                 when nothing is running. Indeterminate while the work has no honest
                                 denominator (a single HB solve is one Newton loop, not N steps).
                                 Purely data-driven (HasProgress/ProgressValue/ProgressIndeterminate)
                                 — whether it survives completion or disappears is entirely up to
                                 whichever IProgressMessage.Finish/Complete call settled the row (see
                                 LiveProgressMessage.cs). Owner request, 2026-08-14: every long-running
                                 row (EM, circuit Analysis, Mesh) now drops it on completion
                                 (Finish(..., keepBar: false)), leaving only the row's text —
                                 keepBar: true survives as the default for any future caller that
                                 wants a completed bar to read as its own "how much work that was"
                                 summary, but nothing currently uses it that way. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <ProgressBar Width="100"
                                             Height="6"
                                             Margin="2,0,2,0"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding ProgressIndeterminate}"
                                             IsVisible="{Binding HasProgress}"/>
                            </InlineUIContainer>

                            <!-- The counter, RIGHT-ALIGNED in a fixed-width box: the numerator grows
                                 leftwards into the gap, so the "/" and the denominator — the parts
                                 the eye actually tracks — never move. Left-aligning it here would
                                 put the twitch back, just one element further along. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <TextBlock Text="{Binding ProgressText}"
                                           IsVisible="{Binding HasProgressText}"
                                           MinWidth="118"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemBaseHighColor}"/>
                            </InlineUIContainer>

                            <InlineUIContainer BaselineAlignment="TextBottom">
                                <SelectableTextBlock Text="{Binding FilePath}"
                                                     IsVisible="{Binding FilePath, Converter={StaticResource IsNotNull}}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource SystemAccentColor}"
                                                     TextDecorations="Underline"
                                                     Cursor="Hand"
                                                     Tapped="OnRevealPathTapped"/>
                            </InlineUIContainer>
                        </SelectableTextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </ControlTheme>
            </ListBox.ItemContainerTheme>

        </ListBox>
    </Grid>
</UserControl>
