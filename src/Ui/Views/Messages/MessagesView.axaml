<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:msg="using:CircuitRF.Ui.Messages"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Messages.MessagesView"
             x:DataType="vm:MessagesTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <conv:MessageLevelToIconConverter  x:Key="LevelToIcon"  />
        <conv:MessageLevelToColorConverter x:Key="LevelToColor" />
        <conv:IsNotNullConverter           x:Key="IsNotNull"    />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header strip. Copy All is deliberately pinned LEFT and Clear RIGHT, at opposite ends of
             the strip: they are a benign action and a destructive one, and putting them side by side
             invites clearing the log when you meant to copy it (owner's explicit request). -->
        <Grid Grid.Row="0" Margin="4,1,4,1">
            <Button x:Name="CopyAllButton"
                    HorizontalAlignment="Left"
                    Click="OnCopyAllMessagesClick"
                    ToolTip.Tip="Copy all messages to the clipboard"
                    Padding="4,1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11">
                <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14"/>
            </Button>

            <Button HorizontalAlignment="Right"
                    Command="{Binding ClearMessagesCommand}"
                    ToolTip.Tip="Clear messages"
                    Padding="4,1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11">
                <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14"/>
            </Button>
        </Grid>

        <!-- Message list — scrollable, selectable. Named for scroll-to-bottom in code-behind. -->
        <ListBox Grid.Row="1"
                 x:Name="MessagesListBox"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:MessageEntry">
                    <!-- The progress bar sits INLINE, immediately after the message text, and the
                         changing counter comes AFTER the bar. That ordering is what keeps it still:
                         the text before it is constant for the whole run (the analysis name), so
                         there is nothing on the bar's left that can grow and shove it. Putting the
                         counter back into the message text would undo this. -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="4,1">

                        <!-- Level icon (meaning, not color alone) -->
                        <mi:MaterialIcon Grid.Column="0"
                                         Kind="{Binding Level, Converter={StaticResource LevelToIcon}}"
                                         Foreground="{Binding Level, Converter={StaticResource LevelToColor}}"
                                         Width="14" Height="14"
                                         Margin="0,1,6,0"
                                         VerticalAlignment="Top"/>

                        <!-- One line: timestamp · message (plain) · file-path link. Only the path is
                             a link: it is a separate SelectableTextBlock hosted in an InlineUIContainer
                             so it flows inline right after the text (wrapping naturally), is itself
                             selectable/copyable, and is the ONLY element that reveals on tap. The
                             timestamp and message text are plain runs — not clickable, no link cursor. -->
                        <SelectableTextBlock Grid.Column="1"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Top"
                                             ContextFlyout="{x:Null}">
                            <!-- Our own menu REPLACES the stock SelectableTextBlock one, whose Copy
                                 disables itself whenever the selection runs past Inlines.Text.Length
                                 (see MessageTextSelection for the decompiled root cause). Declared
                                 once per row in XAML and owned by the framework — never constructed
                                 per right-click, which is the menu-stacking bug this codebase has
                                 already fixed twice (LayoutCanvas, PlotControl). Copy is always
                                 enabled: with no selection it falls back to the whole message, so
                                 there is no state in which the user cannot copy. -->
                            <SelectableTextBlock.ContextMenu>
                                <ContextMenu>
                                    <!-- CANCEL LIVES IN THIS MENU, NOT IN A SECOND ONE ON THE BAR
                                         (owner report, 2026-08-19: "the Copy All Messages context
                                         menu interferes with the progress bar cancel context menu").
                                         The bar is an InlineUIContainer INSIDE this SelectableTextBlock,
                                         so a ContextMenu of its own puts two menus on one right-click
                                         and which one wins depends on which control the hit test
                                         resolved to — the row's text and its bar are one target, and
                                         they get one menu. Right-clicking the bar opens this, with
                                         Cancel at the top; right-clicking the row's text opens the
                                         same thing, which is a superset of what was asked for rather
                                         than a compromise.

                                         Hidden — not merely disabled — on a row with no bar, so an
                                         ordinary message's menu is exactly the two Copy items it has
                                         always been. Disabled WITH THE REASON IN ITS TOOLTIP once the
                                         stop has been asked for or the run has settled. -->
                                    <!-- Stop ABOVE Cancel, and only where one exists (owner request,
                                         2026-09-11). The two are not alternatives: Stop finishes now
                                         and KEEPS what has been solved; Cancel abandons the run and
                                         writes nothing. Only the EM run offers a Stop today, so the
                                         item is hidden rather than greyed everywhere else — a
                                         permanently-disabled item teaches nothing. -->
                                    <MenuItem Header="Stop"
                                              Click="OnStopRunClick"
                                              IsVisible="{Binding ShowStopRun}"
                                              IsEnabled="{Binding CanStopRun}"
                                              ToolTip.Tip="{Binding StopTooltip}"/>
                                    <MenuItem Header="Cancel"
                                              Click="OnCancelRunClick"
                                              IsVisible="{Binding HasProgress}"
                                              IsEnabled="{Binding CanCancelRun}"
                                              ToolTip.Tip="{Binding CancelTooltip}"/>
                                    <Separator IsVisible="{Binding HasProgress}"/>
                                    <MenuItem Header="Copy" Click="OnCopyMessageClick"/>
                                    <MenuItem Header="Copy All Messages" Click="OnCopyAllMessagesClick"/>
                                    <Separator/>
                                    <MenuItem Header="Open Log Folder" Click="OnOpenLogFolderClick"
                                              ToolTip.Tip="The folder holding each day's Messages, one file per day, kept for 14 days"/>
                                </ContextMenu>
                            </SelectableTextBlock.ContextMenu>
                            <Run Text="{Binding TimeText}"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <Run Text="{Binding TextInline}"
                                 Foreground="{DynamicResource SystemBaseHighColor}"/>

                            <!-- ── HOW MANY TIMES, WHERE IT WAS SAID THREE TIMES ────────────────
                                 A designer arming footprint placement three times on a technology
                                 with no courtyard layer got the same 300-character warning three
                                 times in a row (field report, 2026-09-22). The warning is right and
                                 is reported per arming on purpose; the log just repeated it instead
                                 of counting. MessageOrdering.Insert collapses only CONSECUTIVE
                                 identical messages, so two episodes with anything between them stay
                                 two rows — which is what a timestamped log is for.

                                 ABSENT, NOT EMPTY, on a message said once, so every ordinary row
                                 renders exactly as it always did. -->
                            <Run Text="{Binding RepeatText}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>

                            <!-- ── EVERY ROW IS ONE TEXT LINE TALL, WHATEVER IT HOSTS ────────────────
                                 An InlineUIContainer's control is laid out with its whole height
                                 (margin included) ABOVE the text baseline, and BaselineAlignment
                                 does not change that — so any control taller than the font's
                                 ascent (~11.6 px at 12 px) made its own row taller than a plain
                                 one: the file link by 3 px, the bar's counter by 3, the expand
                                 toggle by 4 and the Relaunch button by 8, with the row's text
                                 pushed down below the button's centre. Measured headlessly with
                                 UiSnapshot's messages mode, which prints every row's height.

                                 The fix is a SYMMETRIC margin of (4.35 - H/2) on each hosted
                                 control of height H: its layout height becomes ~9 px, under the
                                 ascent, so the line keeps its plain height; and its visible centre
                                 lands 4.35 px above the baseline, which is the middle of the cap
                                 height — the text's own centre line. The controls are also held
                                 to 16 px so they fit inside a 17 px row instead of overlapping
                                 the rows either side. A control added here needs the same pair:
                                 a fixed Height and the margin that goes with it. -->
                            <!-- Progress bar for a LIVE message (a running simulation). Absent — not
                                 merely empty — on every ordinary message, so the log is unchanged
                                 when nothing is running. Indeterminate while the work has no honest
                                 denominator (a single HB solve is one Newton loop, not N steps).
                                 Purely data-driven (HasProgress/ProgressValue/ProgressIndeterminate)
                                 — whether it survives completion or disappears is entirely up to
                                 whichever IProgressMessage.Finish/Complete call settled the row (see
                                 LiveProgressMessage.cs). Owner request, 2026-08-14: every long-running
                                 row (EM, circuit Analysis, Mesh) now drops it on completion
                                 (Finish(..., keepBar: false)), leaving only the row's text —
                                 keepBar: true survives as the default for any future caller that
                                 wants a completed bar to read as its own "how much work that was"
                                 summary, but nothing currently uses it that way. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <ProgressBar Width="100"
                                             Height="6"
                                             Margin="2,1.5,2,1.5"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding ProgressValue}"
                                             IsIndeterminate="{Binding ProgressIndeterminate}"
                                             IsVisible="{Binding HasProgress}"
                                             ToolTip.Tip="{Binding ProgressTip}"/>
                            </InlineUIContainer>

                            <!-- The counter, RIGHT-ALIGNED in a fixed-width box: the numerator grows
                                 leftwards into the gap, so the "/" and the denominator — the parts
                                 the eye actually tracks — never move. Left-aligning it here would
                                 put the twitch back, just one element further along. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <TextBlock Text="{Binding ProgressText}"
                                           IsVisible="{Binding HasProgressText}"
                                           Height="15"
                                           Margin="0,-3,0,-3"
                                           MinWidth="118"
                                           TextAlignment="Right"
                                           FontSize="12"
                                           Foreground="{DynamicResource SystemBaseHighColor}"/>
                            </InlineUIContainer>

                            <!-- The ACTION button — "Relaunch circuitRF" on the update announcement,
                                 and nothing else at present. A REAL Button, hosted the same way the
                                 progress bar above is (owner's explicit choice, 2026-09-06): the
                                 file-path link's underlined run is the right weight for "show me
                                 where that file is" and the wrong one for an action that closes the
                                 application, which should look like something you press.

                                 Absent, not disabled, on every row with no action — so an ordinary
                                 message keeps exactly the row height it has always had, and only
                                 the one row carrying an action is taller.

                                 Cursor="Arrow" is NOT redundant (owner report, 2026-09-16: hovering
                                 Relaunch showed the text I-beam). Avalonia's Cursor property
                                 INHERITS down the visual tree, and this Button is hosted inside the
                                 row's SelectableTextBlock, which sets the I-beam for text selection
                                 — so without an explicit cursor the button reads as text to the
                                 pointer. Stating it here fixes every platform at once, because
                                 StandardCursorType.Arrow is what each backend maps to its own
                                 default pointer. Same reason the file-path link below states Hand. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <Button Content="{Binding ActionLabel}"
                                        IsVisible="{Binding HasAction}"
                                        Click="OnActionButtonClick"
                                        Padding="8,0"
                                        Margin="4,-3.5,2,-3.5"
                                        MinHeight="0"
                                        Height="16"
                                        VerticalContentAlignment="Center"
                                        FontSize="11"
                                        Cursor="Arrow"
                                        VerticalAlignment="Center"/>
                            </InlineUIContainer>

                            <!-- brief-artsch-8 R-as8-4: a row that EXPANDS to the places it is about (Create
                                 Schematic from Artwork's report, one line per class). Absent on every other row. -->
                            <InlineUIContainer BaselineAlignment="Center">
                                <ToggleButton Content="{Binding ExpandGlyph}"
                                              IsChecked="{Binding IsExpanded}"
                                              IsVisible="{Binding HasItems}"
                                              Padding="4,0"
                                              Margin="2,-3.5,2,-3.5"
                                              MinHeight="0"
                                              Height="16"
                                              VerticalContentAlignment="Center"
                                              FontSize="11"
                                              Cursor="Arrow"
                                              ToolTip.Tip="Show the places this line is about; double-click one to go there."/>
                            </InlineUIContainer>

                            <InlineUIContainer BaselineAlignment="Center">
                                <SelectableTextBlock Text="{Binding FilePath}"
                                                     IsVisible="{Binding FilePath, Converter={StaticResource IsNotNull}}"
                                                     Height="15"
                                                     Margin="0,-3,0,-3"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource SystemAccentColor}"
                                                     TextDecorations="Underline"
                                                     Cursor="Hand"
                                                     Tapped="OnRevealPathTapped"/>
                            </InlineUIContainer>
                        </SelectableTextBlock>

                        <ItemsControl Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding Items}"
                                      IsVisible="{Binding IsExpanded}"
                                      Margin="18,0,0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="msg:MessageItem">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Background="Transparent"
                                               Cursor="Hand"
                                               Foreground="{DynamicResource SystemBaseMediumHighColor}"
                                               DoubleTapped="OnMessageItemDoubleTapped"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </ControlTheme>
            </ListBox.ItemContainerTheme>

        </ListBox>
    </Grid>
</UserControl>
