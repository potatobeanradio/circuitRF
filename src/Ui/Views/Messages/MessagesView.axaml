<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:msg="using:CircuitRF.Ui.Messages"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Messages.MessagesView"
             x:DataType="vm:MessagesTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <conv:MessageLevelToIconConverter  x:Key="LevelToIcon"  />
        <conv:MessageLevelToColorConverter x:Key="LevelToColor" />
        <conv:IsNotNullConverter           x:Key="IsNotNull"    />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header strip: Clear button only (tab title already labels the panel) -->
        <Grid Grid.Row="0" Margin="4,1,4,1">
            <Button HorizontalAlignment="Right"
                    Command="{Binding ClearMessagesCommand}"
                    ToolTip.Tip="Clear messages"
                    Padding="4,1"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11">
                <mi:MaterialIcon Kind="DeleteOutline" Width="14" Height="14"/>
            </Button>
        </Grid>

        <!-- Message list — scrollable, selectable. Named for scroll-to-bottom in code-behind. -->
        <ListBox Grid.Row="1"
                 x:Name="MessagesListBox"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single">

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="msg:MessageEntry">
                    <Grid ColumnDefinitions="Auto,*" Margin="4,1">

                        <!-- Level icon (meaning, not color alone) -->
                        <mi:MaterialIcon Grid.Column="0"
                                         Kind="{Binding Level, Converter={StaticResource LevelToIcon}}"
                                         Foreground="{Binding Level, Converter={StaticResource LevelToColor}}"
                                         Width="14" Height="14"
                                         Margin="0,1,6,0"
                                         VerticalAlignment="Top"/>

                        <!-- One line: timestamp · message (plain) · file-path link. Only the path is
                             a link: it is a separate SelectableTextBlock hosted in an InlineUIContainer
                             so it flows inline right after the text (wrapping naturally), is itself
                             selectable/copyable, and is the ONLY element that reveals on tap. The
                             timestamp and message text are plain runs — not clickable, no link cursor. -->
                        <SelectableTextBlock Grid.Column="1"
                                             FontSize="12"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Top">
                            <Run Text="{Binding TimeText}"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <Run Text="{Binding TextInline}"
                                 Foreground="{DynamicResource SystemBaseHighColor}"/>
                            <InlineUIContainer BaselineAlignment="TextBottom">
                                <SelectableTextBlock Text="{Binding FilePath}"
                                                     IsVisible="{Binding FilePath, Converter={StaticResource IsNotNull}}"
                                                     FontSize="12"
                                                     Foreground="{DynamicResource SystemAccentColor}"
                                                     TextDecorations="Underline"
                                                     Cursor="Hand"
                                                     Tapped="OnRevealPathTapped"/>
                            </InlineUIContainer>
                        </SelectableTextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </ControlTheme>
            </ListBox.ItemContainerTheme>

        </ListBox>
    </Grid>
</UserControl>
