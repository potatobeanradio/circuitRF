<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CircuitRF.Ui.ViewModels"
        xmlns:s3="using:CircuitRF.Render.Scene3D"
        xmlns:v3="using:CircuitRF.Ui.Viewer3D"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:ctl="using:CircuitRF.Ui.DataDisplay.Controls"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="CircuitRF.Ui.Views.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemChromeLowColor}">

    <Design.DataContext>
        <vm:WorkspaceViewModel/>
    </Design.DataContext>

    <!-- ── macOS native menu bar ────────────────────────────────────────── -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="New Cell…"        Command="{Binding NewCellInWorkspaceCommand}"   Gesture="Meta+Shift+N"/>
                                    <NativeMenuItem Header="New Schematic"    Command="{Binding NewScratchSchematicCommand}"/>
                                    <NativeMenuItem Header="New Symbol"       Command="{Binding NewScratchSymbolCommand}"/>
                                    <NativeMenuItem Header="New Layout"       Command="{Binding NewLayoutCommand}"/>
                                    <NativeMenuItem Header="New 3D Design…"   Command="{Binding NewThreeDDesignCommand}"/>
                                    <NativeMenuItem Header="New Data Display" Command="{Binding NewDataDisplayCommand}"       Gesture="Meta+Shift+D"/>
                                    <NativeMenuItem Header="New Technology…"  Command="{Binding NewTechnologyCommand}"        CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="New EM Setup…"    Command="{Binding NewEmSetupCommand}"           CommandParameter="{Binding $parent[Window]}"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="New Workspace…"  Command="{Binding NewWorkspaceCommand}"      CommandParameter="{Binding $parent[Window]}" Gesture="Meta+N"/>
                        <NativeMenuItem Header="New Window"      Command="{Binding NewWindowCommand}"         Gesture="Meta+Shift+N"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Open Workspace…" Command="{Binding OpenWorkspaceCommand}"      CommandParameter="{Binding $parent[Window]}" Gesture="Meta+O"/>
                        <NativeMenuItem Header="Open Workspace in New Window…" Command="{Binding OpenWorkspaceInNewWindowCommand}" CommandParameter="{Binding $parent[Window]}" Gesture="Meta+Shift+O"/>
                        <NativeMenuItem Header="Open Recent">
                            <NativeMenuItem.Menu>
                                <NativeMenu/>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Open">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Open Schematic…"    Command="{Binding OpenSchematicFileCommand}"    CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Open Technology…"   Command="{Binding OpenTechnologyFileCommand}"   CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Open Symbol…"       Command="{Binding OpenSymbolFileCommand}"       CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Open Layout…"       Command="{Binding OpenLayoutFileCommand}"       CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Open Data Display…" Command="{Binding OpenDataDisplayFileCommand}"  CommandParameter="{Binding $parent[Window]}"/>
                                    <!-- R-rail24-1a — the part library is a document like the others, so
                                         it is on the menu the others are on. Mirrored in the in-window
                                         File menu below; the two surfaces are hand-maintained and must
                                         not drift. -->
                                    <NativeMenuItem Header="Open Part Library…" Command="{Binding OpenPartLibraryFileCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <!-- Open wBond…: WITHDRAWN FOR v1 (owner, 2026-08-17), for the same
                                         reason Tools ▸ wBond is — it opens the standalone wirebond
                                         WINDOW, which is a v2 feature. This was the second entry point
                                         to it, so leaving it would make the withdrawal a half-measure.
                                         `OpenWBondFileCommand` and the whole `.wBond` document type stay
                                         in place; only the way in is deferred. A `.wBond` still reaches
                                         v1 through the wBond COMPONENT and the wirebond CELL — see
                                         Schematic ▸ Import Wires from wBond and New ▸ Cell from wBond,
                                         both unaffected. Mirrored in the in-window File menu below; the
                                         two surfaces are hand-maintained and must not drift.
                                    <NativeMenuItem Header="Open wBond…"        Command="{Binding OpenWBondFileCommand}"        CommandParameter="{Binding $parent[Window]}"/>
                                    -->
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Save"                 Command="{Binding SaveAllDocumentsCommand}"   CommandParameter="{Binding $parent[Window]}" Gesture="Meta+S"/>
                        <NativeMenuItem Header="Save Schematic As…"  Command="{Binding SaveLooseSchematicCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Save Symbol As…"     Command="{Binding SaveLooseSymbolCommand}"    CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Save Layout As…"     Command="{Binding SaveLooseLayoutCommand}"     CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Save Workspace As…"  Command="{Binding SaveWorkspaceAsCommand}"   CommandParameter="{Binding $parent[Window]}" Gesture="Meta+Shift+S"/>
                        <NativeMenuItem Header="Keep This State…"    Command="{Binding KeepThisStateCommand}"     CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Keep This Version…"  Command="{Binding KeepThisVersionCommand}"   CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Add Cell to Workspace…" Command="{Binding AddCellToWorkspaceCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Reference Workspace…" Command="{Binding ReferenceWorkspaceCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Clone Workspace…"     Command="{Binding CopyWorkspaceHereCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Pull Changes"         Command="{Binding BringInChangesCommand}"/>
                        <NativeMenuItem Header="Push Changes"         Command="{Binding SendChangesCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Archive Workspace…"   Command="{Binding ArchiveWorkspaceCommand}"   CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Unarchive Workspace…" Command="{Binding UnarchiveWorkspaceCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Import">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Data…" Command="{Binding ImportDataCommand}"         CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="GDSII…" Command="{Binding ImportGdsiiLibraryCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <!-- brief-oasis-gdstk.md §7a: the second GDSII route and OASIS, through the gdstk worker; disabled with the reason when this build has none. -->
                                    <NativeMenuItem Header="GDSII (gdstk)…" ToolTip="{Binding GdstkImportGdsiiTip}" Command="{Binding ImportGdsiiGdstkCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="OASIS (gdstk)…" ToolTip="{Binding GdstkImportOasisTip}" Command="{Binding ImportOasisGdstkCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="DXF…"   Command="{Binding ImportDxfLibraryCommand}"   CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Board…" Command="{Binding ImportBoardCommand}"        CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Gerber…" Command="{Binding ImportGerberCommand}"      CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="STEP…" ToolTip="{Binding ThreeDImportStepTip}" Command="{Binding ImportStepCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Component…" Command="{Binding ImportComponentCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="PDK…"   Command="{Binding ImportPdkCommand}"          CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Model or Subcircuit…" Command="{Binding ImportModelCardCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Technology…" Command="{Binding ImportTechnologyCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Into Open Technology…" Command="{Binding ImportIntoTechnologyCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Wirebond Table…" Command="{Binding ImportWireTableCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Wirebond Wires…" Command="{Binding ImportWirebondWiresCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Wirebond as Cell…" Command="{Binding ImportWirebondAsCellCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Export">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Data"   Command="{Binding ExportDataCommand}"/>
                                    <NativeMenuItem Header="Technology Sections…" Command="{Binding ExportTechnologySectionsCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="GDSII"  Command="{Binding ExportGdsiiCommand}"/>
                                    <NativeMenuItem Header="GDSII (gdstk)" ToolTip="{Binding GdstkExportGdsiiTip}" Command="{Binding ExportGdsiiGdstkCommand}"/>
                                    <NativeMenuItem Header="OASIS (gdstk)" ToolTip="{Binding GdstkExportOasisTip}" Command="{Binding ExportOasisGdstkCommand}"/>
                                    <NativeMenuItem Header="DXF"    Command="{Binding ExportDxfCommand}"/>
                                    <NativeMenuItem Header="Gerber" Command="{Binding ExportGerberCommand}"/>
                                    <NativeMenuItem Header="Board…" Command="{Binding ExportBoardCommand}"/>
                                    <NativeMenuItem Header="STEP…" ToolTip="{Binding ThreeDExportStepTip}" Command="{Binding ExportStepCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="glTF…" ToolTip="{Binding ThreeDExportGltfTip}" Command="{Binding ExportGltfCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <!-- 3D vector copy and drawing export (2026-09-27) — the 3D pane's own Export Drawing…; mirrored below and in the torn-off File menu. -->
                                    <NativeMenuItem Header="Drawing…" ToolTip="A drawing of the active 3D document: isometric, top, front and other views, and sections, at one scale, as SVG or PDF. Requires an active 3D document." Command="{Binding ExportDrawingCommand}" CommandParameter="{Binding $parent[Window]}"/>
                                    <NativeMenuItem Header="Board netlist (IPC-D-356)…" Command="{Binding ExportBoardNetlistCommand}"/>
                                    <NativeMenuItem Header="Placement…" Command="{Binding ExportPlacementCommand}"/>
                                    <NativeMenuItem Header="Bill of materials…" Command="{Binding ExportBomCommand}"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Manage PDKs…" Command="{Binding ManagePdksCommand}" CommandParameter="{Binding $parent[Window]}" Gesture="Meta+P"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Close Window"    Command="{Binding CloseWindowCommand}" Gesture="Meta+W"/>
                        <NativeMenuItem Header="Close Workspace" Command="{Binding CloseWorkspaceCommand}"/>
                        <NativeMenuItem Header="Close Workspace Window" Command="{Binding CloseWorkspaceWindowCommand}" Gesture="Meta+Shift+W"/>
                        <!-- Settings is in the app menu on macOS; omit here to avoid duplication -->
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="Edit">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Undo"       Command="{Binding UndoCommand}"     Gesture="Meta+Z"/>
                        <NativeMenuItem Header="Redo"       Command="{Binding RedoCommand}"     Gesture="Meta+Shift+Z"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Cut"        Command="{Binding CutCommand}"/>
                        <NativeMenuItem Header="Copy"       Command="{Binding CopyCommand}"/>
                        <NativeMenuItem Header="Paste"      Command="{Binding PasteCommand}"/>
                        <NativeMenuItem Header="Paste Image as Schematic…" Command="{Binding PasteImageAsSchematicCommand}" ToolTip="Read the picture on the clipboard and write it as a schematic in a new cell. Enabled when the clipboard holds a picture."/>
                        <NativeMenuItem Header="Paste Image as Layout…"    Command="{Binding PasteImageAsLayoutCommand}" ToolTip="Trace the picture on the clipboard into a new layout cell. Enabled when the clipboard holds a picture."/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="Design">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Place Cell Instance…"       Command="{Binding PlaceCellInstanceCommand}" Gesture="Meta+Shift+I"/>
                        <NativeMenuItem Header="Find Instance…"             Command="{Binding FindInstanceCommand}" Gesture="Meta+F"/>
                        <NativeMenuItem Header="New 3D View from Layout"    Command="{Binding NewThreeDViewFromLayoutCommand}" ToolTip="A 3D view holding one instance of this cell's own layout, with a copy of every 3D setup naming it. Requires an active layout document saved to a cell."/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Update Layout from Schematic"   Command="{Binding UpdateLayoutFromSchematicCommand}" Gesture="Meta+U"/>
                        <NativeMenuItem Header="Update Schematic from Layout"   Command="{Binding UpdateSchematicFromLayoutCommand}" Gesture="Meta+Shift+U"/>
                        <NativeMenuItem Header="Create Schematic from Artwork…" Command="{Binding CreateSchematicFromArtworkCommand}" ToolTip="Recognise the layout's copper — ground, vias, ports, parts and lines — and write it as a schematic of native components, reviewed first in a parts table. Requires an active layout document saved to a cell."/>
                        <NativeMenuItem Header="Create Schematic from Image…"   Command="{Binding CreateSchematicFromImageCommand}" ToolTip="Read a picture of a layout — dropped, pasted or browsed to — and write it as a schematic of native components in a new cell, reviewed first in a parts table. Requires an open workspace."/>
                        <NativeMenuItem Header="Create Layout from Image…"      Command="{Binding CreateLayoutFromImageCommand}" ToolTip="Trace a picture of a layout — dropped, pasted or browsed to — into the copper, vias and outline of a new layout cell. Requires an open workspace."/>
                        <NativeMenuItem Header="Draw Ground Pour"               Command="{Binding DrawGroundPourCommand}" ToolTip="Redraws the ground artwork Update Layout from Schematic draws, from where the parts are now: the ground pour under the microstrip lines and ground vias, with a clearance round every via passing through it, and the ground vias following their pads. Copper you drew or edited yourself is left alone. Requires an active layout document."/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Check Design Rules"             Command="{Binding CheckDesignRulesCommand}" Gesture="Meta+Shift+K"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <!-- brief-em3d-43 R-em3d43-6c (owner decision D9) — ONE top-level 3D menu. A window's NativeMenu
                 is fixed for its lifetime, so the item is never added or removed: 3D editor bugs round 4 binds
                 its IsVisible, so it shows only while a 3D document (the editor or the read-only viewer) is the
                 active one. Hand-mirrored with the in-window menu below. -->
            <NativeMenuItem Header="3D" IsVisible="{Binding IsThreeDMenuVisible}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Select Mode" ToolTip="Requires an active 3D document.">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Object" ToolTip="Requires an active 3D document." Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Object"/>
                                    <NativeMenuItem Header="Face" ToolTip="Requires an active 3D document."   Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Face"/>
                                    <NativeMenuItem Header="Edge" ToolTip="Requires an active 3D document."   Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Edge"/>
                                    <NativeMenuItem Header="Vertex" ToolTip="Requires an active 3D document." Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Vertex"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <!-- 3D menu cleanup — no key equivalent: on macOS one is taken by the menu before any control sees it, so
                             Cmd+A would stop selecting a text box's text while a 3D view is active. The pane answers Cmd+A itself. -->
                        <NativeMenuItem Header="Select All Objects" ToolTip="Every shown object; hidden ones are left out. Cmd+A in the view. Requires an active 3D document." Command="{Binding ThreeDSelectAllCommand}"/>
                        <!-- brief-em3d-91 — no key equivalent, as Select All: a bare H on the menu would be taken from every text box. -->
                        <NativeMenuItem Header="Hide / Show Selection" ToolTip="Hides the selection when all of it is shown; otherwise shows all of it. H in the view or the object tree. Requires an active 3D document." Command="{Binding ThreeDHideShowSelectionCommand}"/>
                        <NativeMenuItem Header="View" ToolTip="Requires an active 3D document.">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Fit" ToolTip="Requires an active 3D document." Command="{Binding ThreeDFitCommand}"/>
                                    <NativeMenuItem Header="Standard Views" ToolTip="Requires an active 3D document.">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Isometric" ToolTip="Requires an active 3D document." Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Iso}"/>
                                                <NativeMenuItem Header="Top" ToolTip="Requires an active 3D document."       Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Top}"/>
                                                <NativeMenuItem Header="Front" ToolTip="Requires an active 3D document."     Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Front}"/>
                                                <NativeMenuItem Header="Right" ToolTip="Requires an active 3D document."     Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Right}"/>
                                                <NativeMenuItem Header="Back" ToolTip="Requires an active 3D document."      Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Back}"/>
                                                <NativeMenuItem Header="Left" ToolTip="Requires an active 3D document."      Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Left}"/>
                                                <NativeMenuItem Header="Bottom" ToolTip="Requires an active 3D document."    Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Bottom}"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Perspective" ToolTip="Requires an active 3D document."    Command="{Binding ThreeDPerspectiveCommand}"/>
                                    <!-- brief-em3d-106 R-em3d106-1c — a check item. No key equivalent: a bare L on the menu would be taken from
                                         every text box; the view answers L itself. -->
                                    <NativeMenuItem Header="Realistic View" ToggleType="CheckBox" IsChecked="{Binding ThreeDRealistic, Mode=OneWay}"
                                                    ToolTip="Materials, lighting and shadows, for pictures. Changes nothing in the model. L in the view. Requires an active 3D document."
                                                    Command="{Binding ToggleThreeDRealisticCommand}"/>
                                    <!-- brief-em3d-108 R-em3d108-3a — the Look panel: how the realistic view looks; opening it turns the view on. -->
                                    <NativeMenuItem Header="Look…" ToolTip="Environment, lighting, background and what the realistic view shows. Opening it turns the realistic view on. Requires an active 3D design."
                                                    Command="{Binding ThreeDLookCommand}"/>
                                    <NativeMenuItem Header="Clip Plane" ToolTip="Requires an active 3D document."     Command="{Binding ThreeDClipPlaneCommand}"/>
                                    <NativeMenuItem Header="Axis Indicator" ToolTip="Requires an active 3D document." Command="{Binding ThreeDAxisIndicatorCommand}"/>
                                    <NativeMenuItem Header="Scale Legend" ToolTip="Requires an active 3D document." Command="{Binding ThreeDScaleLegendCommand}"/>
                                    <NativeMenuItemSeparator/>
                                    <!-- brief-em3d-75 R-em3d75-4 — open with any 3D editor; the items that plot refuse with the reason without a current thermal result. -->
                                    <NativeMenuItem Header="Temperature" ToolTip="{Binding ThreeDTemperatureTip}" IsEnabled="{Binding ThreeDTemperatureSubmenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="All Faces" ToolTip="Temperature on every exposed face." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="AllFaces"/>
                                                <NativeMenuItem Header="On Clip Plane" ToolTip="Temperature on the clip plane's section." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="OnClip"/>
                                                <NativeMenuItem Header="Fix Range Across Sweep" ToolTip="One colour range for every sweep point." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="FixRange"/>
                                                <NativeMenuItem Header="Mirror Symmetric Halves" ToolTip="Draw the temperature mirrored across the document's symmetry planes too (on by default)." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Mirror"/>
                                                <NativeMenuItemSeparator/>
                                                <NativeMenuItem Header="Temperature Along…" ToolTip="Pick two points: T between them, both ends and ΔT." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Along"/>
                                                <NativeMenuItem Header="Probe Table" ToolTip="Every probe statistic and measure at the step shown." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Table"/>
                                                <NativeMenuItemSeparator/>
                                                <NativeMenuItem Header="Clear" ToolTip="Take the temperature off every face and the clip plane." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Clear"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Heat Sources" ToolTip="Show or hide the heat sources. Requires an active 3D editor." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="HeatSources"/>
                                    <NativeMenuItem Header="Probes" ToolTip="Show or hide the probes. Requires an active 3D editor." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Probes"/>
                                    <NativeMenuItem Header="Mesh Regions" ToolTip="Show or hide the mesh regions. Requires an active 3D editor." Command="{Binding ThreeDTemperatureCommand}" CommandParameter="MeshRegions"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Snap" ToolTip="Requires an active 3D document.">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Snap On / Off" ToolTip="Snapping as a whole. Hold Option to suspend geometry snap. Requires an active 3D document." Command="{Binding ThreeDSnapCommand}" CommandParameter="All"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Vertices" ToolTip="Requires an active 3D document."       Command="{Binding ThreeDSnapCommand}" CommandParameter="Vertex"/>
                                    <NativeMenuItem Header="Edge Midpoints" ToolTip="Requires an active 3D document." Command="{Binding ThreeDSnapCommand}" CommandParameter="Midpoint"/>
                                    <NativeMenuItem Header="Edges" ToolTip="Requires an active 3D document."          Command="{Binding ThreeDSnapCommand}" CommandParameter="Edge"/>
                                    <NativeMenuItem Header="Face Centres" ToolTip="Requires an active 3D document."   Command="{Binding ThreeDSnapCommand}" CommandParameter="FaceCentre"/>
                                    <NativeMenuItem Header="Grid" ToolTip="Requires an active 3D document."           Command="{Binding ThreeDSnapCommand}" CommandParameter="Grid"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Draw" ToolTip="Requires an active 3D editor.">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Box" ToolTip="Corner, opposite corner, height. Requires an active 3D editor."      Command="{Binding ThreeDDrawCommand}" CommandParameter="Box"/>
                                    <NativeMenuItem Header="Sheet" ToolTip="A rectangle, two clicks. Requires an active 3D editor."            Command="{Binding ThreeDDrawCommand}" CommandParameter="Sheet"/>
                                    <NativeMenuItem Header="Polygon" ToolTip="A closed sheet, a click per vertex. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="Polygon"/>
                                    <NativeMenuItem Header="Polyline" ToolTip="Construction geometry, a click per vertex. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="Polyline"/>
                                    <NativeMenuItem Header="Image…" ToolTip="A reference image as a sheet on the drawing plane, not modelled. Requires an active 3D editor." Command="{Binding ThreeDInsertImageCommand}"/>
                                    <NativeMenuItem Header="Cylinder" ToolTip="Centre, radius, height. Requires an active 3D editor."          Command="{Binding ThreeDDrawCommand}" CommandParameter="Cylinder"/>
                                    <NativeMenuItem Header="Sphere" ToolTip="Centre, radius. Requires an active 3D editor."                    Command="{Binding ThreeDDrawCommand}" CommandParameter="Sphere"/>
                                    <NativeMenuItem Header="Port" ToolTip="A port between two conductors, two clicks; its polarity is inferred from what it touches. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="Port"/>
                                    <NativeMenuItem Header="Wire" ToolTip="A bond wire between two metal objects or sheets (click any face of each), then its loop height. W in the view. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="Wire"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Heat Source" ToolTip="Where heat is put: a sheet (a record, not an object). Requires an active 3D editor.">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Rectangle" ToolTip="Two corners on the drawing plane, as a port's sheet; then its name and power. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="HeatSource"/>
                                                <NativeMenuItem Header="Polygon" ToolTip="A click per vertex on the drawing plane; then its name and power. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="HeatSourcePolygon"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Probe" ToolTip="Where temperature is read. A face, solid or wire probe: right-click it. Requires an active 3D editor.">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Point" ToolTip="One click on a face. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbePoint"/>
                                                <NativeMenuItem Header="Spot" ToolTip="A centre on a face, then a diameter — an IR spot. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbeSpot"/>
                                                <NativeMenuItem Header="Line" ToolTip="Two points: T along the segment. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbeLine"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Mesh Region" ToolTip="A box drawn as a Box is; then its element size. Refines the Gmsh mesh that Palace and thermal runs use; openEMS ignores it. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="MeshRegion"/>
                                    <NativeMenuItem Header="Effective Block" ToolTip="A box over a via field, drawn as a Box is and made disabled: enabled, a thermal run replaces the board, planes and vias inside it with one anisotropic block. Requires an active 3D editor." Command="{Binding ThreeDDrawCommand}" CommandParameter="EffectiveBlock"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Drawing Plane" ToolTip="Requires an active 3D editor.">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="XY" ToolTip="Draw on the XY plane. Requires an active 3D editor." Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="XY"/>
                                    <NativeMenuItem Header="YZ" ToolTip="Draw on the YZ plane. Requires an active 3D editor." Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="YZ"/>
                                    <NativeMenuItem Header="XZ" ToolTip="Draw on the XZ plane. Requires an active 3D editor." Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="XZ"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Show Grid" ToolTip="The drawing grid on the plane. Requires an active 3D editor." Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="Grid"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Modify" ToolTip="Select something first. Requires an active 3D editor." IsEnabled="{Binding ThreeDModifyMenuEnabled}">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Move" ToolTip="G. Base point, then target point, both snapped. X/Y/Z locks an axis. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Move"/>
                                    <NativeMenuItem Header="Move Along" ToolTip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="X" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveX"/>
                                                <NativeMenuItem Header="Y" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveY"/>
                                                <NativeMenuItem Header="Z" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveZ"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Rotate" ToolTip="R. About the drawing plane's normal through the pivot; 15° steps, Shift free, or typed. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Rotate"/>
                                    <NativeMenuItem Header="Rotate 90°" ToolTip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="+90° about X" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotX+"/>
                                                <NativeMenuItem Header="−90° about X" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotX-"/>
                                                <NativeMenuItem Header="+90° about Y" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotY+"/>
                                                <NativeMenuItem Header="−90° about Y" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotY-"/>
                                                <NativeMenuItem Header="+90° about Z" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotZ+"/>
                                                <NativeMenuItem Header="−90° about Z" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="RotZ-"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Mirror" ToolTip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Across XY" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorXY"/>
                                                <NativeMenuItem Header="Across YZ" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorYZ"/>
                                                <NativeMenuItem Header="Across XZ" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorXZ"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Duplicate" Gesture="Meta+D" ToolTip="Copies in place, then moves them. Esc cancels both. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Duplicate"/>
                                    <NativeMenuItem Header="Array…" ToolTip="Copies along up to three axes at a pitch, previewed live. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Array"/>
                                    <NativeMenuItem Header="Re-Seat Wire Ends" ToolTip="Each selected wire's ends moved up or down onto the pad now under them. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="ReseatWires"/>
                                    <NativeMenuItem Header="Align" ToolTip="Select two or more: the others line up with the last one selected. Requires an active 3D editor." IsEnabled="{Binding ThreeDAlignMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="X min" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXMin"/>
                                                <NativeMenuItem Header="X centre" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXCentre"/>
                                                <NativeMenuItem Header="X max" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXMax"/>
                                                <NativeMenuItem Header="Y min" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYMin"/>
                                                <NativeMenuItem Header="Y centre" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYCentre"/>
                                                <NativeMenuItem Header="Y max" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYMax"/>
                                                <NativeMenuItem Header="Z min" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZMin"/>
                                                <NativeMenuItem Header="Z centre" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZCentre"/>
                                                <NativeMenuItem Header="Z max" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZMax"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Order" ToolTip="Construction order: a later object wins where solids overlap. Requires an active 3D editor." IsEnabled="{Binding ThreeDOrderMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Bring to Front" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Front"/>
                                                <NativeMenuItem Header="Bring Forward" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Forward"/>
                                                <NativeMenuItem Header="Send Backward" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Backward"/>
                                                <NativeMenuItem Header="Send to Back" ToolTip="Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Back"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Group Objects" Gesture="Meta+G" ToolTip="The selection becomes one group: a click on any of it then selects all of it. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Group"/>
                                    <NativeMenuItem Header="Ungroup" Gesture="Meta+Shift+G" ToolTip="The selected group's members, and the groups inside it, go back to where it was. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="Ungroup"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Extrude" ToolTip="A selected sheet, or a polyline selected in the tree, into a prism. Requires an active 3D editor." Command="{Binding ThreeDExtrudeCommand}"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Face" ToolTip="Face mode (F): the selected face. Requires an active 3D editor." IsEnabled="{Binding ThreeDFaceMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Move Along Normal" ToolTip="N. Push or pull the selected face; its neighbours keep their planes. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="PushPull"/>
                                                <NativeMenuItem Header="Move" ToolTip="G. The face's corners follow base point to target point; its neighbours tilt, or fold. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="FaceMove"/>
                                                <NativeMenuItem Header="Extrude to New Solid" ToolTip="Shift+E. A new solid grows from the face along its normal. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="ExtrudeFace"/>
                                                <NativeMenuItem Header="Align to Face…" ToolTip="Then click a parallel face: the object moves until they are coplanar. T toggles Touching and Flush. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignFace"/>
                                                <NativeMenuItem Header="Copy as Sheet" ToolTip="A new sheet exactly on the face. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="CopySheet"/>
                                                <NativeMenuItem Header="Measure" ToolTip="Area, perimeter and normal in Properties; Shift-click a parallel face for the distance. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MeasureFace"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <!-- brief-em3d-67 R-em3d67-5a — mirrored by the in-window menu's Modify ▸ Edge below. -->
                                    <NativeMenuItem Header="Edge" ToolTip="Edge mode (E): the selected edges of one solid. Requires an active 3D editor." IsEnabled="{Binding ThreeDEdgeMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Fillet…" ToolTip="{Binding ThreeDFilletTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="Fillet"/>
                                                <NativeMenuItem Header="Chamfer…" ToolTip="{Binding ThreeDChamferTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="Chamfer"/>
                                                <NativeMenuItem Header="Select Tangent Chain" ToolTip="Every edge that continues the selected one smoothly (or double-click the edge). Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="TangentChain"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Vertex" ToolTip="Vertex mode (V): the selected vertex. Requires an active 3D editor." IsEnabled="{Binding ThreeDVertexMenuEnabled}">
                                        <NativeMenuItem.Menu>
                                            <NativeMenu>
                                                <NativeMenuItem Header="Move" ToolTip="G. The vertex follows base point to target point; the faces on it tilt, or fold. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="VertexMove"/>
                                                <NativeMenuItem Header="Measure From" ToolTip="Measure, starting at the selected vertex. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="MeasureFrom"/>
                                            </NativeMenu>
                                        </NativeMenuItem.Menu>
                                    </NativeMenuItem>
                                    <NativeMenuItem Header="Convert to Polyhedron" ToolTip="Object mode: the selected box, prism or cylinder, with every vertex editable and the face names kept. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="ConvertPoly"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <!-- brief-em3d-66 R-em3d66-7 — mirrored by the in-window 3D menu below (brief 43 §1m). -->
                        <NativeMenuItem Header="Boolean" ToolTip="{Binding ThreeDBooleanTip}" IsEnabled="{Binding ThreeDBooleanMenuEnabled}">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Subtract…" ToolTip="The Blank, less every Tool: the first object you select is a Tool, the last the Blank. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanSubtract"/>
                                    <NativeMenuItem Header="Unite…" ToolTip="The Blank and every Tool as one solid, with the Blank's name and material. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanUnite"/>
                                    <NativeMenuItem Header="Intersect…" ToolTip="What the Blank and every Tool have in common. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanIntersect"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Dissolve Boolean" ToolTip="The selected boolean's operands become top-level objects again. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanDissolve"/>
                                    <NativeMenuItem Header="Edit Operands" ToolTip="Cmd+], or double-click it: enter the selected boolean to edit its operands; Esc or Cmd+[ leaves. Requires an active 3D editor." Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanEnter"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <!-- 3D menu cleanup — Import STEP… and Export STEP… are File ▸ Import / Export ▸ STEP… only: the 3D menu's
                             copies were the same commands twice. brief-em3d-129 — what acts on an imported STEP object is here, mirrored
                             by the in-window 3D menu below. -->
                        <NativeMenuItem Header="STEP">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Reload from Source" ToolTip="{Binding ThreeDStepReloadTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepReload"/>
                                    <NativeMenuItem Header="Split into Solids" ToolTip="{Binding ThreeDStepSplitTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepSplit"/>
                                    <NativeMenuItemSeparator/>
                                    <NativeMenuItem Header="Replace with Prism" ToolTip="{Binding ThreeDStepPrismTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepPrism"/>
                                    <NativeMenuItem Header="Replace with Box…" ToolTip="{Binding ThreeDStepBoxTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepBox"/>
                                    <NativeMenuItem Header="Convert to Polyhedron" ToolTip="{Binding ThreeDStepPolyhedronTip}" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepPolyhedron"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Measure" ToolTip="Two snapped points: x, y, z, the deltas and the distance, every number copyable (M). Requires an active 3D document." Command="{Binding ThreeDMeasureCommand}"/>
                        <NativeMenuItem Header="Materials…" ToolTip="The active 3D view's technology, opened on its Materials tab: its own materials and the libraries it names. Requires an active 3D document." Command="{Binding ThreeDMaterialsCommand}"/>
                        <NativeMenuItem Header="Triangle Budget…" ToolTip="How many triangles a frame draws before array elements, farthest first, are drawn as their bounding boxes. Stored per user." Command="{Binding ThreeDTriangleBudgetCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Show All" ToolTip="Requires an active 3D document." Command="{Binding ThreeDShowAllCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="Simulate">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Setup Analyses…" Command="{Binding SetupAnalysesCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItem Header="Generate Netlist" Command="{Binding GenerateNetlistCommand}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Run"  Command="{Binding RunAnalysisCommand}"  Gesture="Meta+R"/>
                        <NativeMenuItem Header="Stop" Command="{Binding StopAnalysisCommand}" Gesture="Meta+OemPeriod"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <!-- Tools (D10 / R-h45-13). Moved forward from H7 deliberately: a document nobody can
                 open cannot be tested through the product path. H7 fills this out; today it has one
                 entry. Note harmonicaRF needs NO workspace (§1.2), so there is no gating here. -->
            <NativeMenuItem Header="Tools">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="harmonicaRF" Command="{Binding NewHarmonicaCommand}"/>
                        <NativeMenuItem Header="Match Designer" Command="{Binding NewMatchDesignerCommand}"/>
                        <!-- railRF (railrf.md §11.4). Needs NO workspace to open, for harmonicaRF's
                             own reason — what needs one is the import's default of landing the
                             artwork in it as a cell, and railRF offers to create one there. -->
                        <NativeMenuItem Header="railRF" Command="{Binding NewRailRfCommand}"/>
                        <!-- Smith Chart (smith-chart.md §5.8). The ONE entry here that opens a DOCKED
                             DOCUMENT rather than a window of its own — R-smith4-1, and the reason is
                             that this tool has neither of the reasons the other three have. No
                             workspace is needed, so there is no gating here either. Mirrored in the
                             in-window Tools menu below; the two surfaces are hand-maintained and must
                             not drift. -->
                        <NativeMenuItem Header="Smith Chart" Command="{Binding NewSmithChartCommand}"/>
                        <NativeMenuItemSeparator/>
                        <!-- Examples: the rows are filled in by RebuildNativeExamplesMenu, because
                             what is shipped is read off disk rather than listed here, and the whole
                             item is REMOVED when a build carries none. A NativeMenuItem is an
                             AvaloniaObject with no DataContext, so it cannot bind to the view
                             model's collection the way the in-window mirror below does. -->
                        <NativeMenuItem Header="Examples">
                            <NativeMenuItem.Menu>
                                <NativeMenu/>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <!-- wBond: WITHDRAWN FOR v1 (owner, 2026-08-17). The standalone wirebond
                             WINDOW is a v2 feature; wirebonds reach v1 through the wBond COMPONENT and
                             the wirebond CELL (WB40) — the layout editor's own wire tools, panels and
                             menus, which are unaffected by this. Commented out rather than deleted,
                             with `NewWBondCommand` and the whole document type left in place, because
                             the entry point is the only part being deferred. Mirrored in the in-window
                             Tools menu below; the two surfaces are hand-maintained and must not drift.
                        <NativeMenuItem Header="wBond" Command="{Binding NewWBondCommand}"/>
                        -->
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="View">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Reset Layout"     Command="{Binding ResetLayoutCommand}"/>
                        <!-- Header is relabelled at runtime from DockersMenuHeader by
                             WorkspaceWindow.axaml.cs — a NativeMenuItem is an AvaloniaObject with no
                             DataContext, so it cannot bind. -->
                        <NativeMenuItem Header="Hide Dockers" Command="{Binding HideShowDockersCommand}" Gesture="Meta+Shift+H"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Panels">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="Workspace" Command="{Binding ShowToolPanelCommand}" CommandParameter="ProjectTree"/>
                                    <NativeMenuItem Header="Library"      Command="{Binding ShowToolPanelCommand}" CommandParameter="Palette"/>
                                    <NativeMenuItem Header="Properties"   Command="{Binding ShowToolPanelCommand}" CommandParameter="Properties"/>
                                    <NativeMenuItem Header="Analyses"     Command="{Binding ShowToolPanelCommand}" CommandParameter="Analyses"/>
                                    <NativeMenuItem Header="Tuning"       Command="{Binding ShowToolPanelCommand}" CommandParameter="Tuning"/>
                                    <NativeMenuItem Header="Optimizer"    Command="{Binding ShowToolPanelCommand}" CommandParameter="Optimizer"/>
                                    <NativeMenuItem Header="Yield"        Command="{Binding ShowToolPanelCommand}" CommandParameter="Yield"/>
                                    <NativeMenuItem Header="Messages"     Command="{Binding ShowToolPanelCommand}" CommandParameter="Messages"/>
                                    <NativeMenuItem Header="DRC"          Command="{Binding ShowToolPanelCommand}" CommandParameter="Drc"/>
                                    <NativeMenuItem Header="LVS"          Command="{Binding ShowToolPanelCommand}" CommandParameter="Lvs"/>
                                    <NativeMenuItem Header="Instances"    Command="{Binding ShowToolPanelCommand}" CommandParameter="Instances"/>
                                    <NativeMenuItem Header="Impedance"    Command="{Binding ShowToolPanelCommand}" CommandParameter="Impedance"/>
                                    <NativeMenuItem Header="History"      Command="{Binding ShowToolPanelCommand}" CommandParameter="History"/>
                                    <NativeMenuItem Header="Wire Profile"     Command="{Binding ShowToolPanelCommand}" CommandParameter="WBondProfile"/>
                                    <NativeMenuItem Header="Array Inductance" Command="{Binding ShowToolPanelCommand}" CommandParameter="WBondInductance"/>
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Zoom to Fit"      Command="{Binding ZoomToFitCommand}"   Gesture="Meta+D0"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Push Into Cell"       Command="{Binding HierarchyPushInCommand}"       Gesture="Meta+OemCloseBrackets"/>
                        <NativeMenuItem Header="Pop Out"              Command="{Binding HierarchyPopOutCommand}"       Gesture="Meta+OemOpenBrackets"/>
                        <NativeMenuItem Header="Open Cell in New Tab" Command="{Binding HierarchyOpenInNewTabCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <!-- Window: populated in code-behind (RebuildNativeWindowMenu) from the SAME
                 EnumerateWindowEntries() the in-window menu uses, so the two surfaces cannot
                 disagree about contents or order. -->
            <NativeMenuItem Header="Window">
                <NativeMenuItem.Menu>
                    <NativeMenu/>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="Help">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="circuitRF Documentation" Command="{Binding OpenDocumentationCommand}"/>
                        <!-- The last few published releases, fetched when asked. The launch-time
                             showing of the running version's notes is a different thing and is not
                             reachable from a menu. -->
                        <NativeMenuItem Header="Release Notes…" Command="{Binding ShowReleaseNotesCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Crash Reports…" Command="{Binding OpenCrashReportsCommand}"/>
                        <NativeMenuItemSeparator/>
                        <!-- Reports through the Message Panel, never a dialog. Disabled when
                             automatic updates are off (a manual check is still a network call) and
                             when the install site is read-only. -->
                        <NativeMenuItem Header="Check for Updates…" Command="{Binding CheckForUpdatesCommand}"/>
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- ── Keyboard shortcuts (cross-platform) ──────────────────────────── -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N"        Command="{Binding NewWorkspaceCommand}"          CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Meta+N"        Command="{Binding NewWorkspaceCommand}"          CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+Shift+N"  Command="{Binding NewCellInWorkspaceCommand}"/>
        <KeyBinding Gesture="Meta+Shift+N"  Command="{Binding NewCellInWorkspaceCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+D"  Command="{Binding NewDataDisplayCommand}"/>
        <KeyBinding Gesture="Meta+Shift+D"  Command="{Binding NewDataDisplayCommand}"/>
        <KeyBinding Gesture="Ctrl+O"        Command="{Binding OpenWorkspaceCommand}"  CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Meta+O"        Command="{Binding OpenWorkspaceCommand}"  CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+W"        Command="{Binding CloseWindowCommand}"/>
        <KeyBinding Gesture="Meta+W"        Command="{Binding CloseWindowCommand}"/>
        <KeyBinding Gesture="Ctrl+P"        Command="{Binding ManagePdksCommand}"     CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Meta+P"        Command="{Binding ManagePdksCommand}"     CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+S"        Command="{Binding SaveAllDocumentsCommand}" CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Meta+S"        Command="{Binding SaveAllDocumentsCommand}" CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+Shift+S"  Command="{Binding SaveWorkspaceAsCommand}" CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Meta+Shift+S"  Command="{Binding SaveWorkspaceAsCommand}" CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+Z"        Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Meta+Z"        Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z"  Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Meta+Shift+Z"  Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y"        Command="{Binding RedoCommand}"/>
        <!-- Cut/Copy/Paste/SelectAll are intentionally NOT window-level key bindings.
             Routing them here would intercept before the focused TextBox (inline edit) or
             canvas can handle them. Each control handles its own clipboard keys natively. -->
        <!-- Hide/Show Dockers (brief-dock-layout-persistence.md §4A). Ctrl/Meta+Shift+H was audited
             against every existing gesture in this file and every editor's own key handler before
             being taken: H is completely unused app-wide. -->
        <KeyBinding Gesture="Ctrl+Shift+H"  Command="{Binding HideShowDockersCommand}"/>
        <KeyBinding Gesture="Meta+Shift+H"  Command="{Binding HideShowDockersCommand}"/>
        <KeyBinding Gesture="Ctrl+R"        Command="{Binding RunAnalysisCommand}"/>
        <KeyBinding Gesture="Meta+R"        Command="{Binding RunAnalysisCommand}"/>
        <KeyBinding Gesture="Ctrl+U"        Command="{Binding UpdateLayoutFromSchematicCommand}"/>
        <KeyBinding Gesture="Meta+U"        Command="{Binding UpdateLayoutFromSchematicCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+U"  Command="{Binding UpdateSchematicFromLayoutCommand}"/>
        <KeyBinding Gesture="Meta+Shift+U"  Command="{Binding UpdateSchematicFromLayoutCommand}"/>
        <!-- L5b DRC. K for "check"; Shift because the unshifted Ctrl/Meta+K is conventionally a
             different thing in most editors and this is not a per-keystroke action. Audited against
             every other gesture in this file before choosing it — nothing else uses it. -->
        <KeyBinding Gesture="Ctrl+Shift+K"  Command="{Binding CheckDesignRulesCommand}"/>
        <KeyBinding Gesture="Meta+Shift+K"  Command="{Binding CheckDesignRulesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+I"  Command="{Binding PlaceCellInstanceCommand}"/>
        <KeyBinding Gesture="Meta+Shift+I"  Command="{Binding PlaceCellInstanceCommand}"/>
        <!-- brief-find-instance-panel.md R-fi-12. Ctrl/Meta+F was audited (2026-09-22) against every
             gesture in this file and every canvas's own key handler before being taken: harmonicaRF's
             Class F uses it in harmonicaRF's OWN menu, and every canvas's bare-F Zoom to Fit rejects a
             Ctrl/Meta modifier. Greyed out (so handling nothing) unless a schematic or layout is
             focused, which also leaves a docked harmonicaRF document's own Meta+F alone. -->
        <KeyBinding Gesture="Ctrl+F"        Command="{Binding FindInstanceCommand}"/>
        <KeyBinding Gesture="Meta+F"        Command="{Binding FindInstanceCommand}"/>
        <!-- §9B.6 R-rul-13: clear every in-design ruler annotation, one undo entry, no prompt. The
             UNSHIFTED K is free — Ctrl+Shift+K above is Check Design Rules and is left alone. -->
        <KeyBinding Gesture="Ctrl+K"        Command="{Binding ClearAllRulersCommand}"/>
        <KeyBinding Gesture="Meta+K"        Command="{Binding ClearAllRulersCommand}"/>
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding ShowSettingsCommand}" CommandParameter="{Binding $parent[Window]}"/>
        <KeyBinding Gesture="Ctrl+Q"        Command="{Binding QuitApplicationCommand}"/>
        <KeyBinding Gesture="Escape"        Command="{Binding DisarmPlacementCommand}"/>
    </Window.KeyBindings>

    <DockPanel>

        <!-- ── In-window menu bar (hidden on macOS — uses NativeMenu above) ── -->
        <Menu DockPanel.Dock="Top" IsVisible="{OnPlatform True, macOS=False}">

            <MenuItem Header="_File" Padding="8,4">
                <MenuItem Header="_New">
                    <MenuItem.Icon><mi:MaterialIcon Kind="PlusBox" Width="16" Height="16"/></MenuItem.Icon>
                    <MenuItem Header="New _Cell…"
                              Command="{Binding NewCellInWorkspaceCommand}"
                              InputGesture="Ctrl+Shift+N">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderPlus" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _Schematic"
                              Command="{Binding NewScratchSchematicCommand}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FilePlus" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New S_ymbol"
                              Command="{Binding NewScratchSymbolCommand}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="PencilBoxOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _Layout"
                              Command="{Binding NewLayoutCommand}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="LayersPlus" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _3D Design…"
                              Command="{Binding NewThreeDDesignCommand}"
                              ToolTip.Tip="Create a new cell holding an empty 3D view (.c3d) and open it. Needs an open workspace.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _Data Display"
                              Command="{Binding NewDataDisplayCommand}"
                              InputGesture="Ctrl+Shift+D">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _Technology…"
                              Command="{Binding NewTechnologyCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="LayersOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New _EM Setup…"
                              Command="{Binding NewEmSetupCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="SineWave" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="New _Workspace…"
                          Command="{Binding NewWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+N">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderPlus" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New Win_dow"
                          Command="{Binding NewWindowCommand}"
                          InputGesture="Ctrl+Shift+N">
                    <MenuItem.Icon><mi:MaterialIcon Kind="WindowMaximize" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Open _Workspace…"
                          Command="{Binding OpenWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+O">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Workspace in _New Window…"
                          Command="{Binding OpenWorkspaceInNewWindowCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+Shift+O">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open _Recent"
                          ItemsSource="{Binding RecentMenuItems}"
                          IsEnabled="{Binding HasRecentWorkspaces}"
                          ToolTip.Tip="No recent workspaces.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="History" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    <MenuItem Header="Open Sc_hematic…"
                              Command="{Binding OpenSchematicFileCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open _Technology…"
                              Command="{Binding OpenTechnologyFileCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="A technology file opens on its own — no workspace needed.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="LayersOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open S_ymbol…"
                              Command="{Binding OpenSymbolFileCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open _Layout…"
                              Command="{Binding OpenLayoutFileCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Open Data _Display…"
                              Command="{Binding OpenDataDisplayFileCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- R-rail24-1a. Mirrors the NativeMenu row above; the two must not drift. -->
                    <MenuItem Header="Open _Part Library…"
                              Command="{Binding OpenPartLibraryFileCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="A .crlib opens on its own — no workspace needed.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FormatListBulletedType" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- Open wBond…: WITHDRAWN FOR v1 (owner, 2026-08-17) — see the NativeMenu's own
                         note above for why. Mirrored there; the two surfaces must not drift.
                    <MenuItem Header="Open _wBond…"
                              Command="{Binding OpenWBondFileCommand}"
                              CommandParameter="{Binding $parent[Window]}">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    -->
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding SaveMenuHeader}"
                          Command="{Binding SaveAllDocumentsCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+S"
                          ToolTip.Tip="{Binding SaveMenuTooltip}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentSave" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Schematic _As…"
                          Command="{Binding SaveLooseSchematicCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Requires an active schematic document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save S_ymbol As…"
                          Command="{Binding SaveLooseSymbolCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Requires an active symbol document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _Layout As…"
                          Command="{Binding SaveLooseLayoutCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Requires an active layout document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Workspace _As…"
                          Command="{Binding SaveWorkspaceAsCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+Shift+S">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentSaveEdit" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- revision-control.md §5.3's second boundary, R-rc5-4c. Beside the save commands,
                     because that is where a user looking for it will be: §5.3 describes it as
                     something the user asks for, and it is not a save — it keeps the state you are in
                     so you can come back to it. -->
                <!-- The tooltip is BOUND because the item greys out when there is nothing to record
                     (owner, 2026-09-08) and a greyed item with no reason on it is indistinguishable
                     from a feature that was never built. -->
                <MenuItem Header="_Keep This State…"
                          Command="{Binding KeepThisStateCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="{Binding KeepThisStateTooltip}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="BookmarkOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- revision-control.md §5.2, RC-7 R-rc7-1. Beside Keep This State… and deliberately
                     NOT merged with it: one writes a safety-net entry nobody else ever sees, the other
                     records a version the designer titled and sends out. Two commands, because they
                     are two histories (R-rc7-9). -->
                <MenuItem Header="Keep This _Version…"
                          Command="{Binding KeepThisVersionCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="{Binding KeepThisVersionTooltip}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TagOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Add _Cell to Workspace…"
                          Command="{Binding AddCellToWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Take a cell from another project into this one — copy it in, or reference it where it is. The same choice the drag-drop gesture offers.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderMoveOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reference Workspace…"
                          Command="{Binding ReferenceWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Let this workspace instance cells that live in another project, by reference.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderNetworkOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- RC-9 R-rc9-1/-6. Below Reference Workspace… and separated from it, because these
                     three are the group that reaches ANOTHER MACHINE: point at a workspace already
                     here is one question, bringing one onto this machine and exchanging with where it
                     came from is another. NOTHING HERE IS AUTOMATIC — an automatic fetch would
                     silently change what a design resolves against, which is the failure the pin
                     exists to prevent. Mirrored in the macOS NativeMenu above; the two surfaces are
                     hand-maintained and must not drift.

                     GIT'S OWN WORDS, by the owner's decision (2026-09-07). revision-control.md §0 says
                     nothing git-shaped appears unbidden, and these three items are the deliberate
                     exception to it: they ARE clone, fetch and push, they reach a git host, and an
                     engineer who has been given an address already knows those three words. The
                     tooltips still carry circuitRF's own sentence, so the vocabulary is a label rather
                     than a prerequisite. The rule stands everywhere else — a restore point is still a
                     restore point and nothing anywhere says "commit". -->
                <Separator/>
                <MenuItem Header="_Clone Workspace…"
                          Command="{Binding CopyWorkspaceHereCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Copy a workspace onto this machine from an address someone gave you, and open it. Its versions come; their restore points stay on their machine.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pull Changes"
                          Command="{Binding BringInChangesCommand}"
                          ToolTip.Tip="See what is new on the copy this workspace came from. Nothing in your own files is touched.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="P_ush Changes"
                          Command="{Binding SendChangesCommand}"
                          ToolTip.Tip="Send the versions you have kept to the copy this workspace came from. Your restore points stay here.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TrayArrowUp" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Archive Workspace…"
                          Command="{Binding ArchiveWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Zip this workspace up so it can be sent to someone on another machine.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ZipBox" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Unarchive Workspace…"
                          Command="{Binding UnarchiveWorkspaceCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          ToolTip.Tip="Unpack a workspace archive and open it.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ZipBoxOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Import">
                    <MenuItem.Icon><mi:MaterialIcon Kind="DatabaseImportOutline" Width="16" Height="16"/></MenuItem.Icon>
                    <MenuItem Header="_Data…"
                              Command="{Binding ImportDataCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="_GDSII…"
                              Command="{Binding ImportGdsiiLibraryCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="GDSII (gdstk)…"
                              Command="{Binding ImportGdsiiGdstkCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="{Binding GdstkImportGdsiiTip}"/>
                    <MenuItem Header="OASIS (gdstk)…"
                              Command="{Binding ImportOasisGdstkCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="{Binding GdstkImportOasisTip}"/>
                    <MenuItem Header="_DXF…"
                              Command="{Binding ImportDxfLibraryCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="_Board…"
                              Command="{Binding ImportBoardCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Import a .kicad_pcb board: its stackup, nets, tracks, vias, zone fills and footprints. The file's version is reported, never branched on — every epoch reads."/>
                    <MenuItem Header="Ge_rber…"
                              Command="{Binding ImportGerberCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Import a Gerber/Excellon file set as one flat cell and a technology of its own. Point at a folder, or at one file and say whether its folder was meant. Vias are rebuilt where the drill data comes too."/>
                    <MenuItem Header="_STEP…"
                              Command="{Binding ImportStepCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="{Binding ThreeDImportStepTip}"/>
                    <MenuItem Header="_Component…"
                              Command="{Binding ImportComponentCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Import a component — its symbol, its land pattern(s) and the pin-to-pad map between them — as one cell. Point at a file or a folder; the folder is scanned for files that can be imported, and the formats read are .kicad_sym, .kicad_mod, .lib and .lbr."/>
                    <MenuItem Header="_PDK…"
                              Command="{Binding ImportPdkCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="_Model or Subcircuit…"
                              Command="{Binding ImportModelCardCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Build a cell from a SPICE .model card or .subckt definition. A card becomes the native circuitRF component carrying its parameters, with an editable copy of that component's symbol; a subcircuit becomes its own netlist, wired as the file wires it, with a generic box for a symbol. Anything circuitRF has no model for is refused by name rather than approximated."/>
                    <MenuItem Header="_Technology…"
                              Command="{Binding ImportTechnologyCommand}"
                              CommandParameter="{Binding $parent[Window]}"/>
                    <MenuItem Header="Into Open _Technology…"
                              Command="{Binding ImportIntoTechnologyCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Bring layers, stackup or DRC rules from another .ctech into the technology you are editing. Requires an open technology."/>
                    <MenuItem Header="_Wirebond Table…"
                              Command="{Binding ImportWireTableCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="A from-pad / to-pad wirebond table, as every packaging flow already has."/>
                    <MenuItem Header="Wirebond W_ires…"
                              Command="{Binding ImportWirebondWiresCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Bring a .wBond design's wires into the active schematic — into the selected wBond component, or as a new one. Artwork in the file is left behind. Requires an active schematic."/>
                    <MenuItem Header="Wirebond as _Cell…"
                              Command="{Binding ImportWirebondAsCellCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Create a cell from a .wBond: its wires become the schematic view, its embedded artwork the layout view."/>
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem.Icon><mi:MaterialIcon Kind="DatabaseExportOutline" Width="16" Height="16"/></MenuItem.Icon>
                    <MenuItem Header="_Data"
                              Command="{Binding ExportDataCommand}"
                              ToolTip.Tip="No data to export."/>
                    <MenuItem Header="Technology _Sections…"
                              Command="{Binding ExportTechnologySectionsCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="Write this technology's layers, stackup or DRC rules to a portable .ctech. Requires an open technology."/>
                    <MenuItem Header="_GDSII"
                              Command="{Binding ExportGdsiiCommand}"
                              ToolTip.Tip="Requires an active layout document."/>
                    <MenuItem Header="GDSII (gdstk)"
                              Command="{Binding ExportGdsiiGdstkCommand}"
                              ToolTip.Tip="{Binding GdstkExportGdsiiTip}"/>
                    <MenuItem Header="OASIS (gdstk)"
                              Command="{Binding ExportOasisGdstkCommand}"
                              ToolTip.Tip="{Binding GdstkExportOasisTip}"/>
                    <MenuItem Header="D_XF"
                              Command="{Binding ExportDxfCommand}"
                              ToolTip.Tip="Requires an active layout document."/>
                    <MenuItem Header="_Gerber"
                              Command="{Binding ExportGerberCommand}"
                              ToolTip.Tip="Requires an active layout document."/>
                    <MenuItem Header="_Board…"
                              Command="{Binding ExportBoardCommand}"
                              ToolTip.Tip="Write this layout as a .kicad_pcb board: stackup, nets, tracks, vias, copper zones and footprints. Design rules are never written — set them on the receiving side. Requires an active layout document."/>
                    <MenuItem Header="_STEP…"
                              Command="{Binding ExportStepCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="{Binding ThreeDExportStepTip}"/>
                    <MenuItem Header="_glTF…"
                              Command="{Binding ExportGltfCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="{Binding ThreeDExportGltfTip}"/>
                    <MenuItem Header="Dra_wing…"
                              Command="{Binding ExportDrawingCommand}"
                              CommandParameter="{Binding $parent[Window]}"
                              ToolTip.Tip="A drawing of the active 3D document: isometric, top, front and other views, and sections, at one scale, as SVG or PDF. Requires an active 3D document."/>
                    <MenuItem Header="Board _netlist (IPC-D-356)…"
                              Command="{Binding ExportBoardNetlistCommand}"
                              ToolTip.Tip="Write the net at every pad and via this board draws, as IPC-D-356. Projected from the artwork itself — railRF never needs it. Requires an active layout document."/>
                    <MenuItem Header="_Placement…"
                              Command="{Binding ExportPlacementCommand}"
                              ToolTip.Tip="Write a pick-and-place table: one row per placement, stating its units and its coordinate origin so nothing has to be asked on the way back in. Requires an active layout document."/>
                    <MenuItem Header="Bill of _materials…"
                              Command="{Binding ExportBomCommand}"
                              ToolTip.Tip="Write one row per placement: reference, value, footprint and type. No part numbers — a part number is a purchasing decision circuitRF does not hold. Requires an active layout document."/>
                </MenuItem>
                <MenuItem Header="_Manage PDKs…"
                          Command="{Binding ManagePdksCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+P"
                          ToolTip.Tip="Requires an open workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="PackageVariant" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Close _Window"
                          Command="{Binding CloseWindowCommand}"
                          InputGesture="Ctrl+W"
                          ToolTip.Tip="No open document to close.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="WindowClose" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Close Wor_kspace"
                          Command="{Binding CloseWorkspaceCommand}"
                          ToolTip.Tip="Requires an open workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FolderRemoveOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Close Workspace Window"
                          Command="{Binding CloseWorkspaceWindowCommand}"
                          InputGesture="Ctrl+Shift+W"
                          ToolTip.Tip="Closes this window. Other workspace windows stay open.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="WindowClose" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Settings…"
                          Command="{Binding ShowSettingsCommand}"
                          CommandParameter="{Binding $parent[Window]}"
                          InputGesture="Ctrl+OemComma">
                    <MenuItem.Icon><mi:MaterialIcon Kind="CogOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Quit circuitRF"
                          IsVisible="{OnPlatform True, macOS=False}"
                          Command="{Binding QuitApplicationCommand}"
                          InputGesture="Ctrl+Q">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ExitToApp" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Edit" Padding="8,4" SubmenuOpened="OnEditMenuOpened">
                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGesture="Ctrl+Z">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Undo" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGesture="Ctrl+Shift+Z">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Redo" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cu_t"
                          Command="{Binding CutCommand}"
                          InputGesture="Ctrl+X">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentCut" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Copy"
                          Command="{Binding CopyCommand}"
                          InputGesture="Ctrl+C">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Paste"
                          Command="{Binding PasteCommand}"
                          InputGesture="Ctrl+V">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ContentPaste" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- brief-img-6 R-im6-2: enabled only when the clipboard holds a picture, asked when this menu opens
                     (SubmenuOpened on the Edit item) and when the window is activated — never polled. -->
                <MenuItem Header="Paste _Image as Schematic…"
                          Command="{Binding PasteImageAsSchematicCommand}"
                          ToolTip.Tip="Read the picture on the clipboard and write it as a schematic in a new cell. Enabled when the clipboard holds a picture.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ImageSearchOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Paste Image as _Layout…"
                          Command="{Binding PasteImageAsLayoutCommand}"
                          ToolTip.Tip="Trace the picture on the clipboard into a new layout cell. Enabled when the clipboard holds a picture.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ImageEditOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Design" Padding="8,4">
                <MenuItem Header="_Place Cell Instance…"
                          Command="{Binding PlaceCellInstanceCommand}"
                          InputGesture="Ctrl+Shift+I"
                          ToolTip.Tip="Choose a cell and click to place an instance of it. Requires an active schematic, layout or 3D document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ShapeSquarePlus" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Find Instance…"
                          Command="{Binding FindInstanceCommand}"
                          InputGesture="Ctrl+F"
                          ToolTip.Tip="List the placed components of the active schematic or layout, filter them by name or type, and double-click one to zoom to it. Requires an active schematic or layout document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="New _3D View from Layout"
                          Command="{Binding NewThreeDViewFromLayoutCommand}"
                          ToolTip.Tip="A 3D view holding one instance of this cell's own layout, in its units and technology, with a copy of every 3D setup naming it. Requires an active layout document saved to a cell.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="CubeScan" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Update _Layout from Schematic"
                          Command="{Binding UpdateLayoutFromSchematicCommand}"
                          InputGesture="Ctrl+U"
                          ToolTip.Tip="Requires an active schematic document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="LayersPlus" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Update _Schematic from Layout"
                          Command="{Binding UpdateSchematicFromLayoutCommand}"
                          InputGesture="Ctrl+Shift+U"
                          ToolTip.Tip="Requires an active layout document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FilePlus" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- brief-artsch-8 R-as8-1: directly below Update Schematic from Layout, no gesture by default. That
                     command syncs linked instances; this one recognises artwork that has no links. -->
                <MenuItem Header="Create Schematic from _Artwork…"
                          Command="{Binding CreateSchematicFromArtworkCommand}"
                          ToolTip.Tip="Recognise the layout's copper — ground, vias, ports, parts and lines — and write it as a schematic of native components, reviewed first in a parts table. Requires an active layout document saved to a cell.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FileChart" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- brief-img-6 R-im6-1: below Create Schematic from Artwork…, enabled whenever a workspace is open
                     (no document needs to be focused), no gesture by default. -->
                <MenuItem Header="Create Schematic from _Image…"
                          Command="{Binding CreateSchematicFromImageCommand}"
                          ToolTip.Tip="Read a picture of a layout — dropped, pasted or browsed to — and write it as a schematic of native components in a new cell, reviewed first in a parts table. Requires an open workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ImageSearchOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Create La_yout from Image…"
                          Command="{Binding CreateLayoutFromImageCommand}"
                          ToolTip.Tip="Trace a picture of a layout — dropped, pasted or browsed to — into the copper, vias and outline of a new layout cell. Requires an open workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ImageEditOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Draw _Ground Pour"
                          Command="{Binding DrawGroundPourCommand}"
                          ToolTip.Tip="Redraws the ground artwork Update Layout from Schematic draws, from where the parts are now: the ground pour under the microstrip lines and ground vias, with a clearance round every via passing through it, and the ground vias following their pads. Copper you drew or edited yourself is left alone. Requires an active layout document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Texture" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Check Design Rules"
                          Command="{Binding CheckDesignRulesCommand}"
                          InputGesture="Ctrl+Shift+K"
                          ToolTip.Tip="Check the active layout against its technology's minimum-width and minimum-spacing rules. Requires an active layout document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ShieldCheckOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- brief-em3d-43 — the 3D menu, hand-mirrored with the macOS NativeMenu above (its visibility too). -->
            <MenuItem Header="_3D" Padding="8,4" IsVisible="{Binding IsThreeDMenuVisible}">
                <MenuItem Header="Select _Mode" ToolTip.Tip="Requires an active 3D document.">
                    <MenuItem Header="_Object" Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Object"
                              InputGesture="O" ToolTip.Tip="Select whole solids, sheets and instances. Requires an active 3D document.">
                        <MenuItem.Icon><v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.ObjectMode}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Face" Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Face"
                              InputGesture="F" ToolTip.Tip="Select one face. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorSquare" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Edge" Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Edge"
                              InputGesture="E" ToolTip.Tip="Select one edge; Shift-click adds, double-click takes its tangent chain. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorLine" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Vertex" Command="{Binding ThreeDSelectModeCommand}" CommandParameter="Vertex"
                              InputGesture="V" ToolTip.Tip="Select one vertex. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorPoint" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <!-- 3D menu cleanup — mirrors the macOS menu's Select All Objects. InputGesture is display-only: the pane answers Ctrl+A. -->
                <MenuItem Header="Select A_ll Objects" Command="{Binding ThreeDSelectAllCommand}" InputGesture="Ctrl+A"
                          ToolTip.Tip="Every shown object; hidden ones are left out. Requires an active 3D document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="SelectAll" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- brief-em3d-91 — InputGesture is display-only: the pane and the object tree answer H. -->
                <MenuItem Header="_Hide / Show Selection" Command="{Binding ThreeDHideShowSelectionCommand}" InputGesture="H"
                          ToolTip.Tip="Hides the selection when all of it is shown; otherwise shows all of it. Requires an active 3D document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="EyeOff" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_View" ToolTip.Tip="Requires an active 3D document.">
                    <MenuItem Header="_Fit" Command="{Binding ThreeDFitCommand}" InputGesture="Home"
                              ToolTip.Tip="Frame everything. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FitToPageOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Standard Views" ToolTip.Tip="Requires an active 3D document.">
                        <MenuItem Header="_Isometric" Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Iso}" InputGesture="D1" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="_Top"       Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Top}" InputGesture="D2" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="_Front"     Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Front}" InputGesture="D3" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="_Right"     Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Right}" InputGesture="D4" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="_Back"      Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Back}" InputGesture="D5" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="_Left"      Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Left}" InputGesture="D6" ToolTip.Tip="Requires an active 3D document."/>
                        <MenuItem Header="B_ottom"    Command="{Binding ThreeDStandardViewCommand}" CommandParameter="{x:Static s3:StandardView3D.Bottom}" InputGesture="D7" ToolTip.Tip="Requires an active 3D document."/>
                    </MenuItem>
                    <MenuItem Header="_Perspective" Command="{Binding ThreeDPerspectiveCommand}" InputGesture="P"
                              ToolTip.Tip="Toggle perspective and orthographic. Requires an active 3D document."/>
                    <!-- brief-em3d-106 R-em3d106-1c — mirrors the macOS menu's View ▸ Realistic View: a check item. L is the view's own key,
                         shown here as Perspective's P is. -->
                    <MenuItem Header="_Realistic View" Command="{Binding ToggleThreeDRealisticCommand}" ToggleType="CheckBox" InputGesture="L"
                              IsChecked="{Binding ThreeDRealistic, Mode=OneWay}"
                              ToolTip.Tip="Materials, lighting and shadows, for pictures. Changes nothing in the model. Requires an active 3D document."/>
                    <!-- brief-em3d-108 R-em3d108-3a — mirrors the macOS menu's View ▸ Look…. -->
                    <MenuItem Header="_Look…" Command="{Binding ThreeDLookCommand}"
                              ToolTip.Tip="Environment, lighting, background and what the realistic view shows. Opening it turns the realistic view on. Requires an active 3D design."/>
                    <MenuItem Header="_Clip Plane" Command="{Binding ThreeDClipPlaneCommand}" InputGesture="C"
                              ToolTip.Tip="Toggle the clip plane. Requires an active 3D document."/>
                    <MenuItem Header="_Axis Indicator" Command="{Binding ThreeDAxisIndicatorCommand}" InputGesture="A"
                              ToolTip.Tip="Toggle the axis indicator. Requires an active 3D document."/>
                    <MenuItem Header="Scale _Legend" Command="{Binding ThreeDScaleLegendCommand}"
                              ToolTip.Tip="Toggle the scale bar. Requires an active 3D document."/>
                    <Separator/>
                    <!-- brief-em3d-75 R-em3d75-4 — mirrors the macOS menu's View ▸ Temperature. Open with any 3D editor: Clear, the
                         Probe Table and Mirror must stay reachable while a stale plot is on screen; the items that PLOT refuse with the
                         reason (the tip says it too) when the active setup has no current thermal result. -->
                    <MenuItem Header="_Temperature" ToolTip.Tip="{Binding ThreeDTemperatureTip}" IsEnabled="{Binding ThreeDTemperatureSubmenuEnabled}"
                              ToolTip.ShowOnDisabled="True">
                        <MenuItem Header="_All Faces" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="AllFaces" ToolTip.Tip="Temperature on every exposed face."/>
                        <MenuItem Header="On _Clip Plane" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="OnClip" ToolTip.Tip="Temperature on the clip plane's section."/>
                        <MenuItem Header="_Fix Range Across Sweep" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="FixRange" ToolTip.Tip="One colour range for every sweep point."/>
                        <MenuItem Header="_Mirror Symmetric Halves" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Mirror" ToolTip.Tip="Draw the temperature mirrored across the document's symmetry planes too (on by default)."/>
                        <Separator/>
                        <MenuItem Header="Temperature _Along…" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Along" ToolTip.Tip="Pick two points: T between them, both ends and ΔT."/>
                        <MenuItem Header="_Probe Table" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Table" ToolTip.Tip="Every probe statistic and measure at the step shown."/>
                        <Separator/>
                        <MenuItem Header="C_lear" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Clear" ToolTip.Tip="Take the temperature off every face and the clip plane."/>
                    </MenuItem>
                    <MenuItem Header="_Heat Sources" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="HeatSources" ToolTip.Tip="Show or hide the heat sources. Requires an active 3D editor."/>
                    <MenuItem Header="_Probes" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="Probes" ToolTip.Tip="Show or hide the probes. Requires an active 3D editor."/>
                    <MenuItem Header="_Mesh Regions" Command="{Binding ThreeDTemperatureCommand}" CommandParameter="MeshRegions" ToolTip.Tip="Show or hide the mesh regions. Requires an active 3D editor."/>
                </MenuItem>
                <MenuItem Header="S_nap" ToolTip.Tip="Requires an active 3D document.">
                    <MenuItem Header="_Snap On / Off" Command="{Binding ThreeDSnapCommand}" CommandParameter="All"
                              ToolTip.Tip="Snapping as a whole. Hold Alt to suspend geometry snap; the grid still applies. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="Magnet" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="_Vertices" Command="{Binding ThreeDSnapCommand}" CommandParameter="Vertex"
                              ToolTip.Tip="Toggle snapping to vertices. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="SquareOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Edge _Midpoints" Command="{Binding ThreeDSnapCommand}" CommandParameter="Midpoint"
                              ToolTip.Tip="Toggle snapping to edge midpoints. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="TriangleOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Edges" Command="{Binding ThreeDSnapCommand}" CommandParameter="Edge"
                              ToolTip.Tip="Toggle snapping to the nearest point on an edge. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="Close" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Face Centres" Command="{Binding ThreeDSnapCommand}" CommandParameter="FaceCentre"
                              ToolTip.Tip="Toggle snapping to face centres. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="CircleOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Grid" Command="{Binding ThreeDSnapCommand}" CommandParameter="Grid"
                              ToolTip.Tip="Toggle snapping to the drawing grid. Requires an active 3D document.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="Grid" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Draw" ToolTip.Tip="Requires an active 3D editor. Shift+A opens it at the cursor.">
                    <MenuItem Header="_Box" Command="{Binding ThreeDDrawCommand}" CommandParameter="Box"
                              ToolTip.Tip="Corner, opposite corner, height. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="CubeOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Sheet" Command="{Binding ThreeDDrawCommand}" CommandParameter="Sheet"
                              ToolTip.Tip="A rectangle, two clicks. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="RectangleOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Poly_gon" Command="{Binding ThreeDDrawCommand}" CommandParameter="Polygon"
                              ToolTip.Tip="A closed sheet, a click per vertex. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorPolygon" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Poly_line" Command="{Binding ThreeDDrawCommand}" CommandParameter="Polyline"
                              ToolTip.Tip="Construction geometry, a click per vertex. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Image…" Command="{Binding ThreeDInsertImageCommand}"
                              ToolTip.Tip="A reference image as a sheet on the drawing plane, not modelled. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ImagePlusOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="C_ylinder" Command="{Binding ThreeDDrawCommand}" CommandParameter="Cylinder"
                              ToolTip.Tip="Centre, radius, height. Requires an active 3D editor.">
                        <MenuItem.Icon><v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Cylinder}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sph_ere" Command="{Binding ThreeDDrawCommand}" CommandParameter="Sphere"
                              ToolTip.Tip="Centre, radius. Requires an active 3D editor.">
                        <MenuItem.Icon><v3:Viewer3DPathGlyph Data="{x:Static v3:Viewer3DPathGlyph.Sphere}"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Port" Command="{Binding ThreeDDrawCommand}" CommandParameter="Port"
                              ToolTip.Tip="A port between two conductors, two clicks; its polarity is inferred from what it touches. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ArrowUpBoldBoxOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Wire" Command="{Binding ThreeDDrawCommand}" CommandParameter="Wire" InputGesture="W"
                              ToolTip.Tip="A bond wire between two metal objects or sheets (click any face of each), then its loop height. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="VectorCurve" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <!-- brief-em3d-75 R-em3d75-1a — mirrors the macOS menu's Draw ▸ Heat Source / Probe / Mesh Region above. -->
                    <MenuItem Header="_Heat Source" ToolTip.Tip="Where heat is put: a sheet (a record, not an object). Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FireCircle" Width="16" Height="16"/></MenuItem.Icon>
                        <MenuItem Header="_Rectangle" Command="{Binding ThreeDDrawCommand}" CommandParameter="HeatSource"
                                  ToolTip.Tip="Two corners on the drawing plane, as a port's sheet; then its name and power. Requires an active 3D editor."/>
                        <MenuItem Header="_Polygon" Command="{Binding ThreeDDrawCommand}" CommandParameter="HeatSourcePolygon"
                                  ToolTip.Tip="A click per vertex on the drawing plane; then its name and power. Requires an active 3D editor."/>
                    </MenuItem>
                    <MenuItem Header="Pro_be" ToolTip.Tip="Where temperature is read. A face, solid or wire probe: right-click it. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ThermometerProbe" Width="16" Height="16"/></MenuItem.Icon>
                        <MenuItem Header="_Point" Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbePoint" ToolTip.Tip="One click on a face. Requires an active 3D editor."/>
                        <MenuItem Header="_Spot" Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbeSpot" ToolTip.Tip="A centre on a face, then a diameter — an IR spot. Requires an active 3D editor."/>
                        <MenuItem Header="_Line" Command="{Binding ThreeDDrawCommand}" CommandParameter="ProbeLine" ToolTip.Tip="Two points: T along the segment. Requires an active 3D editor."/>
                    </MenuItem>
                    <MenuItem Header="_Mesh Region" Command="{Binding ThreeDDrawCommand}" CommandParameter="MeshRegion"
                              ToolTip.Tip="A box drawn as a Box is; then its element size. Refines the Gmsh mesh that Palace and thermal runs use; openEMS ignores it. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="CubeScan" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Effective Block" Command="{Binding ThreeDDrawCommand}" CommandParameter="EffectiveBlock"
                              ToolTip.Tip="A box over a via field, drawn as a Box is and made disabled: enabled, a thermal run replaces the board, planes and vias inside it with one anisotropic block. Requires an active 3D editor."/>
                </MenuItem>
                <MenuItem Header="Drawing _Plane" ToolTip.Tip="Requires an active 3D editor.">
                    <MenuItem Header="_XY" Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="XY" ToolTip.Tip="Draw on the XY plane. Requires an active 3D editor."/>
                    <MenuItem Header="_YZ" Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="YZ" ToolTip.Tip="Draw on the YZ plane. Requires an active 3D editor."/>
                    <MenuItem Header="X_Z" Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="XZ" ToolTip.Tip="Draw on the XZ plane. Requires an active 3D editor."/>
                    <Separator/>
                    <MenuItem Header="Show _Grid" Command="{Binding ThreeDDrawingPlaneCommand}" CommandParameter="Grid"
                              ToolTip.Tip="The drawing grid on the plane. Requires an active 3D editor.">
                        <MenuItem.Icon><mi:MaterialIcon Kind="GridLarge" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Modify" ToolTip.Tip="Select something first. Requires an active 3D editor." IsEnabled="{Binding ThreeDModifyMenuEnabled}">
                    <MenuItem Header="_Move" Command="{Binding ThreeDModifyCommand}" CommandParameter="Move" InputGesture="G" ToolTip.Tip="Base point, then target point, both snapped. X/Y/Z locks an axis. Requires an active 3D editor."/>
                    <MenuItem Header="Move _Along" ToolTip.Tip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                        <MenuItem Header="_X" Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveX"/>
                        <MenuItem Header="_Y" Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveY"/>
                        <MenuItem Header="_Z" Command="{Binding ThreeDModifyCommand}" CommandParameter="MoveZ"/>
                    </MenuItem>
                    <MenuItem Header="_Rotate" Command="{Binding ThreeDModifyCommand}" CommandParameter="Rotate" InputGesture="R" ToolTip.Tip="About the drawing plane's normal through the pivot; 15° steps, Shift free, or typed. Requires an active 3D editor."/>
                    <MenuItem Header="Rotate _90°" ToolTip.Tip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                        <MenuItem Header="+90° about X" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotX+"/>
                        <MenuItem Header="−90° about X" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotX-"/>
                        <MenuItem Header="+90° about Y" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotY+"/>
                        <MenuItem Header="−90° about Y" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotY-"/>
                        <MenuItem Header="+90° about Z" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotZ+"/>
                        <MenuItem Header="−90° about Z" Command="{Binding ThreeDModifyCommand}" CommandParameter="RotZ-"/>
                    </MenuItem>
                    <MenuItem Header="M_irror" ToolTip.Tip="Requires an active 3D editor." IsEnabled="{Binding ThreeDTransformMenuEnabled}">
                        <MenuItem Header="Across XY" Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorXY"/>
                        <MenuItem Header="Across YZ" Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorYZ"/>
                        <MenuItem Header="Across XZ" Command="{Binding ThreeDModifyCommand}" CommandParameter="MirrorXZ"/>
                    </MenuItem>
                    <MenuItem Header="_Duplicate" Command="{Binding ThreeDModifyCommand}" CommandParameter="Duplicate" InputGesture="Ctrl+D" ToolTip.Tip="Copies in place, then moves them. Esc cancels both. Requires an active 3D editor."/>
                    <MenuItem Header="Arra_y…" Command="{Binding ThreeDModifyCommand}" CommandParameter="Array" ToolTip.Tip="Copies along up to three axes at a pitch, previewed live. Requires an active 3D editor."/>
                    <MenuItem Header="Re-_Seat Wire Ends" Command="{Binding ThreeDModifyCommand}" CommandParameter="ReseatWires" ToolTip.Tip="Each selected wire's ends moved up or down onto the pad now under them. Requires an active 3D editor."/>
                    <MenuItem Header="Ali_gn" ToolTip.Tip="Select two or more: the others line up with the last one selected. Requires an active 3D editor." IsEnabled="{Binding ThreeDAlignMenuEnabled}">
                        <MenuItem Header="X min" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXMin"/>
                        <MenuItem Header="X centre" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXCentre"/>
                        <MenuItem Header="X max" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignXMax"/>
                        <MenuItem Header="Y min" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYMin"/>
                        <MenuItem Header="Y centre" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYCentre"/>
                        <MenuItem Header="Y max" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignYMax"/>
                        <MenuItem Header="Z min" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZMin"/>
                        <MenuItem Header="Z centre" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZCentre"/>
                        <MenuItem Header="Z max" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignZMax"/>
                    </MenuItem>
                    <MenuItem Header="_Order" ToolTip.Tip="Construction order: a later object wins where solids overlap. Requires an active 3D editor." IsEnabled="{Binding ThreeDOrderMenuEnabled}">
                        <MenuItem Header="Bring to Front" Command="{Binding ThreeDModifyCommand}" CommandParameter="Front"/>
                        <MenuItem Header="Bring Forward" Command="{Binding ThreeDModifyCommand}" CommandParameter="Forward"/>
                        <MenuItem Header="Send Backward" Command="{Binding ThreeDModifyCommand}" CommandParameter="Backward"/>
                        <MenuItem Header="Send to Back" Command="{Binding ThreeDModifyCommand}" CommandParameter="Back"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Group Objects" Command="{Binding ThreeDModifyCommand}" CommandParameter="Group" InputGesture="Ctrl+G"
                              ToolTip.Tip="The selection becomes one group: a click on any of it then selects all of it. Requires an active 3D editor."/>
                    <MenuItem Header="Ungroup" Command="{Binding ThreeDModifyCommand}" CommandParameter="Ungroup" InputGesture="Ctrl+Shift+G"
                              ToolTip.Tip="The selected group's members, and the groups inside it, go back to where it was. Requires an active 3D editor."/>
                    <Separator/>
                    <MenuItem Header="_Extrude" Command="{Binding ThreeDExtrudeCommand}"
                              ToolTip.Tip="A selected sheet, or a polyline selected in the tree, into a prism. Requires an active 3D editor."/>
                    <Separator/>
                    <MenuItem Header="_Face" ToolTip.Tip="Face mode (F): the selected face. Requires an active 3D editor." IsEnabled="{Binding ThreeDFaceMenuEnabled}">
                        <MenuItem Header="Move Along Normal" Command="{Binding ThreeDModifyCommand}" CommandParameter="PushPull" InputGesture="N" ToolTip.Tip="Push or pull the selected face; its neighbours keep their planes. Requires an active 3D editor."/>
                        <MenuItem Header="Move" Command="{Binding ThreeDModifyCommand}" CommandParameter="FaceMove" InputGesture="G" ToolTip.Tip="The face's corners follow base point to target point; its neighbours tilt, or fold. Requires an active 3D editor."/>
                        <MenuItem Header="Extrude to New Solid" Command="{Binding ThreeDModifyCommand}" CommandParameter="ExtrudeFace" InputGesture="Shift+E" ToolTip.Tip="A new solid grows from the face along its normal. Requires an active 3D editor."/>
                        <MenuItem Header="Align to Face…" Command="{Binding ThreeDModifyCommand}" CommandParameter="AlignFace" ToolTip.Tip="Then click a parallel face: the object moves until they are coplanar. T toggles Touching and Flush. Requires an active 3D editor."/>
                        <MenuItem Header="Copy as Sheet" Command="{Binding ThreeDModifyCommand}" CommandParameter="CopySheet" ToolTip.Tip="A new sheet exactly on the face. Requires an active 3D editor."/>
                        <MenuItem Header="Measure" Command="{Binding ThreeDModifyCommand}" CommandParameter="MeasureFace" ToolTip.Tip="Area, perimeter and normal in Properties; Shift-click a parallel face for the distance. Requires an active 3D editor."/>
                    </MenuItem>
                    <!-- brief-em3d-67 R-em3d67-5a — mirrors the macOS menu's Modify ▸ Edge above. -->
                    <MenuItem Header="E_dge" ToolTip.Tip="Edge mode (E): the selected edges of one solid. Requires an active 3D editor." IsEnabled="{Binding ThreeDEdgeMenuEnabled}">
                        <MenuItem Header="_Fillet…" Command="{Binding ThreeDModifyCommand}" CommandParameter="Fillet" ToolTip.Tip="{Binding ThreeDFilletTip}"/>
                        <MenuItem Header="_Chamfer…" Command="{Binding ThreeDModifyCommand}" CommandParameter="Chamfer" ToolTip.Tip="{Binding ThreeDChamferTip}"/>
                        <MenuItem Header="Select _Tangent Chain" Command="{Binding ThreeDModifyCommand}" CommandParameter="TangentChain" ToolTip.Tip="Every edge that continues the selected one smoothly (or double-click the edge). Requires an active 3D editor."/>
                    </MenuItem>
                    <MenuItem Header="_Vertex" ToolTip.Tip="Vertex mode (V): the selected vertex. Requires an active 3D editor." IsEnabled="{Binding ThreeDVertexMenuEnabled}">
                        <MenuItem Header="Move" Command="{Binding ThreeDModifyCommand}" CommandParameter="VertexMove" InputGesture="G" ToolTip.Tip="The vertex follows base point to target point; the faces on it tilt, or fold. Requires an active 3D editor."/>
                        <MenuItem Header="Measure From" Command="{Binding ThreeDModifyCommand}" CommandParameter="MeasureFrom" ToolTip.Tip="Measure, starting at the selected vertex. Requires an active 3D editor."/>
                    </MenuItem>
                    <MenuItem Header="_Convert to Polyhedron" Command="{Binding ThreeDModifyCommand}" CommandParameter="ConvertPoly" ToolTip.Tip="Object mode: the selected box, prism or cylinder, with every vertex editable and the face names kept. Requires an active 3D editor."/>
                </MenuItem>
                <!-- brief-em3d-66 R-em3d66-7 — mirrors the macOS menu's 3D ▸ Boolean above. -->
                <MenuItem Header="_Boolean" ToolTip.Tip="{Binding ThreeDBooleanTip}" IsEnabled="{Binding ThreeDBooleanMenuEnabled}">
                    <MenuItem Header="_Subtract…" Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanSubtract" ToolTip.Tip="The Blank, less every Tool: the first object you select is a Tool, the last the Blank. Requires an active 3D editor."/>
                    <MenuItem Header="_Unite…" Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanUnite" ToolTip.Tip="The Blank and every Tool as one solid, with the Blank's name and material. Requires an active 3D editor."/>
                    <MenuItem Header="_Intersect…" Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanIntersect" ToolTip.Tip="What the Blank and every Tool have in common. Requires an active 3D editor."/>
                    <Separator/>
                    <MenuItem Header="_Dissolve Boolean" Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanDissolve" ToolTip.Tip="The selected boolean's operands become top-level objects again. Requires an active 3D editor."/>
                    <MenuItem Header="_Edit Operands" Command="{Binding ThreeDModifyCommand}" CommandParameter="BooleanEnter" ToolTip.Tip="Ctrl+], or double-click it: enter the selected boolean to edit its operands; Esc or Ctrl+[ leaves. Requires an active 3D editor."/>
                </MenuItem>
                <!-- brief-em3d-129 — mirrors the macOS menu's 3D ▸ STEP above. -->
                <MenuItem Header="S_TEP">
                    <MenuItem Header="_Reload from Source" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepReload"
                              ToolTip.Tip="{Binding ThreeDStepReloadTip}" ToolTip.ShowOnDisabled="True"/>
                    <MenuItem Header="_Split into Solids" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepSplit"
                              ToolTip.Tip="{Binding ThreeDStepSplitTip}" ToolTip.ShowOnDisabled="True"/>
                    <Separator/>
                    <MenuItem Header="Replace with _Prism" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepPrism"
                              ToolTip.Tip="{Binding ThreeDStepPrismTip}" ToolTip.ShowOnDisabled="True"/>
                    <MenuItem Header="Replace with _Box…" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepBox"
                              ToolTip.Tip="{Binding ThreeDStepBoxTip}" ToolTip.ShowOnDisabled="True"/>
                    <MenuItem Header="Convert to Pol_yhedron" Command="{Binding ThreeDModifyCommand}" CommandParameter="StepPolyhedron"
                              ToolTip.Tip="{Binding ThreeDStepPolyhedronTip}" ToolTip.ShowOnDisabled="True"/>
                </MenuItem>
                <MenuItem Header="Mea_sure" Command="{Binding ThreeDMeasureCommand}"
                          ToolTip.Tip="Two snapped points: x, y, z, the deltas and the distance, every number copyable (M). Requires an active 3D document.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="RulerSquare" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Materials…" Command="{Binding ThreeDMaterialsCommand}"
                          ToolTip.Tip="The active 3D view's technology, opened on its Materials tab: its own materials and the libraries it names. Requires an active 3D document."/>
                <MenuItem Header="_Triangle Budget…" Command="{Binding ThreeDTriangleBudgetCommand}"
                          ToolTip.Tip="How many triangles a frame draws before array elements, farthest first, are drawn as their bounding boxes. Stored per user."/>
                <Separator/>
                <MenuItem Header="Show _All" Command="{Binding ThreeDShowAllCommand}"
                          ToolTip.Tip="Show every hidden object. Requires an active 3D document."/>
            </MenuItem>

            <MenuItem Header="_Simulate" Padding="8,4">
                <MenuItem Header="Setup _Analyses…"
                          Command="{Binding SetupAnalysesCommand}"
                          CommandParameter="{Binding $parent[Window]}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Generate Netlist"
                          Command="{Binding GenerateNetlistCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FileExportOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Run"
                          Command="{Binding RunAnalysisCommand}"
                          InputGesture="Ctrl+R">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Play" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Stop"
                          Command="{Binding StopAnalysisCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="Stop" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Tools (D10 / R-h45-13) — hand-mirrored with the macOS NativeMenu above, as every
                 other menu on these two surfaces is. -->
            <MenuItem Header="_Tools" Padding="8,4">
                <MenuItem Header="_harmonicaRF"
                          Command="{Binding NewHarmonicaCommand}"
                          ToolTip.Tip="Interactive harmonic-termination explorer. Opens with or without a workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TuneVariant" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Match Designer"
                          Command="{Binding NewMatchDesignerCommand}"
                          ToolTip.Tip="Synthesise an impedance-matching network from two terminations and a band, then flatten it to a cell. Opens with or without a workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TransitConnectionVariant" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- railRF — hand-mirrored with the macOS NativeMenu above, as every other menu on
                     these two surfaces is. -->
                <MenuItem Header="_railRF"
                          Command="{Binding NewRailRfCommand}"
                          ToolTip.Tip="Power-distribution analysis on a real board — the drop map, the ranked breakdown, the via check and Z(f). Opens with or without a workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="CurrentDc" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- Smith Chart — hand-mirrored with the macOS NativeMenu above, as every other
                     menu on these two surfaces is. -->
                <MenuItem Header="_Smith Chart"
                          Command="{Binding NewSmithChartCommand}"
                          ToolTip.Tip="Match an impedance by hand on a Smith chart — a generator impedance, a cascade of elements, and a curve per element showing where it takes you. Opens as a document, with or without a workspace.">
                    <!-- The drawn Smith glyph, not a Material icon: brief-7.1d-1 rejected
                         ChartArc/ChartDonut for exactly this and PlotTypeGlyphControl is what
                         replaced them everywhere a Smith chart is offered. -->
                    <MenuItem.Icon>
                        <ctl:PlotTypeGlyphControl Kind="Smith" Width="16" Height="16"
                            Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator IsVisible="{Binding HasExamples}"/>
                <!-- Examples — hand-mirrored with the macOS NativeMenu above. The rows come from the
                     view model rather than from here because what is shipped is read off disk, and a
                     build without them hides the whole entry rather than opening an empty submenu. -->
                <MenuItem Header="_Examples"
                          IsVisible="{Binding HasExamples}"
                          ItemsSource="{Binding ExampleMenuItems}"
                          ToolTip.Tip="Copy a reference workspace to a folder you pick, and open it. The copy is yours to edit.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="BookOpenVariant" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <!-- wBond: WITHDRAWN FOR v1 (owner, 2026-08-17) — see the NativeMenu's own note.
                     The standalone window is deferred to v2; every other wirebond surface stays.
                <MenuItem Header="_wBond"
                          Command="{Binding NewWBondCommand}"
                          ToolTip.Tip="Wirebond array editor. Opens with or without a workspace.">
                    <MenuItem.Icon><mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                -->
            </MenuItem>

            <MenuItem Header="_View" Padding="8,4">
                <MenuItem Header="Reset _Layout"
                          Command="{Binding ResetLayoutCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ViewDashboardOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding DockersMenuHeader}"
                          Command="{Binding HideShowDockersCommand}"
                          InputGesture="Ctrl+Shift+H">
                    <MenuItem.Icon><mi:MaterialIcon Kind="PageLayoutSidebarLeft" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- Reopen a closed tool panel. Without these, closing one strands it until
                     Reset Layout, which also discards every other panel placement. -->
                <MenuItem Header="_Panels">
                    <MenuItem Header="_Workspace"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="ProjectTree">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Library"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Palette">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ViewGridPlusOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="P_roperties"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Properties">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Analyses"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Analyses">
                        <MenuItem.Icon><mi:MaterialIcon Kind="PlayCircleOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-tuneopt-4. Tabbed behind Analyses in both shipped default layouts. -->
                    <MenuItem Header="T_uning"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Tuning">
                        <MenuItem.Icon><mi:MaterialIcon Kind="TuneVertical" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-tuneopt-10. Tabbed behind Tuning in both shipped default layouts. -->
                    <MenuItem Header="O_ptimizer"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Optimizer">
                        <MenuItem.Icon><mi:MaterialIcon Kind="TargetVariant" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-yield-10. Tabbed behind the Optimizer in both shipped default layouts. -->
                    <MenuItem Header="_Yield"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Yield">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ChartBellCurve" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Messages"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Messages">
                        <MenuItem.Icon><mi:MaterialIcon Kind="MessageTextOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_DRC"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Drc">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ShieldCheckOutline" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-lvs-12-gui.md. Not in either shipped default layout: LVS needs a cell
                         with both views drawn, which most documents being edited do not yet have. -->
                    <MenuItem Header="_LVS"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Lvs">
                        <MenuItem.Icon><mi:MaterialIcon Kind="CompareHorizontal" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-find-instance-panel.md. Not in either shipped default layout: it appears
                         when asked for, usually by Design ▸ Find Instance… (Ctrl/⌘+F). -->
                    <MenuItem Header="_Instances"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Instances">
                        <MenuItem.Icon><mi:MaterialIcon Kind="FormatListBulleted" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- brief-impedance-3. Not in either shipped default layout: the layout toolbar's
                         Z0 tile puts it on screen when an impedance review is wanted. -->
                    <MenuItem Header="I_mpedance"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="Impedance">
                        <MenuItem.Icon><mi:MaterialIcon Kind="Omega" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- revision-control.md §5.10, RC-10 R-rc10-1. ONE panel, replacing Restore Points
                         and Versions. §5's argument is about two kinds of ENTRY and rev 2 spent it as
                         an argument for two WINDOWS; the reason actually given for the split is
                         unreadability, which a filter answers better — and the designer never has to
                         know which panel to open, which is the question that is hardest at the moment
                         it is asked. Not in either shipped default layout: it is looked at on the days
                         something went wrong. -->
                    <MenuItem Header="_History"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="History">
                        <MenuItem.Icon><mi:MaterialIcon Kind="History" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <!-- wbond.md §10.1 — the two wBond panels, which follow the active layout. Not in
                         either shipped default layout: most designs have no wirebonds. -->
                    <MenuItem Header="Wire Pro_file"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="WBondProfile">
                        <MenuItem.Icon><mi:MaterialIcon Kind="ChartBellCurve" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Array Induc_tance"
                              Command="{Binding ShowToolPanelCommand}" CommandParameter="WBondInductance">
                        <MenuItem.Icon><mi:MaterialIcon Kind="TableLarge" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Zoom to _Fit"
                          Command="{Binding ZoomToFitCommand}"
                          InputGesture="Ctrl+D0">
                    <MenuItem.Icon><mi:MaterialIcon Kind="FitToPageOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Push _Into Cell"
                          Command="{Binding HierarchyPushInCommand}"
                          InputGesture="Ctrl+OemCloseBrackets">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ArrowRight" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pop _Out"
                          Command="{Binding HierarchyPopOutCommand}"
                          InputGesture="Ctrl+OemOpenBrackets">
                    <MenuItem.Icon><mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Cell in _New Tab"
                          Command="{Binding HierarchyOpenInNewTabCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Window: every open circuitRF window, selectable to bring it to the front. Contents
                 are rebuilt on SubmenuOpened (window lifetime and dirty state both change constantly;
                 the menu is only ever read at the moment it opens). -->
            <MenuItem Header="_Window"
                      Padding="8,4"
                      ItemsSource="{Binding WindowMenuItems}"
                      SubmenuOpened="OnWindowMenuOpened"/>

            <MenuItem Header="_Help" Padding="8,4">
                <MenuItem Header="circuitRF _Documentation"
                          Command="{Binding OpenDocumentationCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="BookOpenVariant" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Release Notes…"
                          Command="{Binding ShowReleaseNotesCommand}"
                          CommandParameter="{Binding $parent[Window]}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="TagOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Crash Reports…"
                          Command="{Binding OpenCrashReportsCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="BugCheckOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Check for _Updates…"
                          Command="{Binding CheckForUpdatesCommand}">
                    <MenuItem.Icon><mi:MaterialIcon Kind="CloudDownloadOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="About circuitRF…"
                          Click="OnAboutMenuItemClick">
                    <MenuItem.Icon><mi:MaterialIcon Kind="InformationOutline" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>

        </Menu>

        <!-- ── Workspace toolbar ─────────────────────────────────────────── -->
        <!-- §7.1: global controls — always visible at workspace level.
             Avalonia 12 has no built-in ToolBar control; we use a styled Border+StackPanel. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,0,0,1"
                Padding="2,2">
            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"
                        Classes="Toolbar">

                <!-- Start Page / New -->
                <Button Command="{Binding NewWorkspaceCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="New Workspace (Ctrl+N)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="FilePlus" Width="18" Height="18"/>
                </Button>

                <!-- Open / Save -->
                <Button Command="{Binding OpenWorkspaceCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Open Workspace (Ctrl+O)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding SaveWorkspaceCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Save Workspace (Ctrl+S)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="ContentSave" Width="18" Height="18"/>
                </Button>

                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"/>

                <!-- Cut / Copy / Paste -->
                <Button Command="{Binding CutCommand}" ToolTip.Tip="Cut (Ctrl+X)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="ContentCut" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copy (Ctrl+C)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="ContentCopy" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding PasteCommand}" ToolTip.Tip="Paste (Ctrl+V)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="ContentPaste" Width="18" Height="18"/>
                </Button>

                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"/>

                <!-- Undo / Redo -->
                <Button Command="{Binding UndoCommand}"
                        ToolTip.Tip="{Binding UndoDescription}"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="UndoVariant" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding RedoCommand}"
                        ToolTip.Tip="{Binding RedoDescription}"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="RedoVariant" Width="18" Height="18"/>
                </Button>

                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"/>

                <!-- Hide/Show Dockers -->
                <Button Command="{Binding HideShowDockersCommand}"
                        ToolTip.Tip="{Binding DockersMenuHeader}"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="PageLayoutSidebarLeft" Width="18" Height="18"/>
                </Button>

                <!-- Fit Windows to Frame -->
                <Button Command="{Binding FitWindowsToFrameCommand}"
                        ToolTip.Tip="Fit Windows to Frame"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="FitToPageOutline" Width="18" Height="18"/>
                </Button>

                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"/>

                <!-- Run / Stop Analysis -->
                <Button Command="{Binding RunAnalysisCommand}"
                        ToolTip.Tip="Run Analysis (Ctrl+R)"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="PlayCircleOutline" Width="18" Height="18"/>
                </Button>
                <Button Command="{Binding StopAnalysisCommand}"
                        ToolTip.Tip="Stop Analysis"
                        Background="Transparent" BorderThickness="0" Padding="4,2">
                    <mi:MaterialIcon Kind="StopCircleOutline" Width="18" Height="18"/>
                </Button>

                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"/>

                <!-- ── Tool panels: Library, Properties, Messages ──────────────────────────
                     Three TOGGLES, not three "open it" buttons (owner, 2026-08-18): press to show the
                     panel where the user last had it in THIS workspace, press again to close it, and
                     round again. That is ToggleToolPanelCommand — the same command, and therefore the
                     same two states and the same restore path, that the wBond panels' P and A keys and
                     the layout editor's own two buttons already use. View ▸ Panels keeps the plain
                     "show me that panel" command: a MENU item named after a panel must not close it.

                     ToggleButtons whose IsChecked is bound ONE WAY, so the button says whether its
                     panel is on screen. The truth is the dock tree, which a panel closed by its own tab
                     X — or a whole layout restore — also changes, so the state is re-read from the view
                     model on every notification rather than left wherever the click put it. -->
                <ToggleButton Classes="PanelToggle"
                              Command="{Binding ToggleToolPanelCommand}" CommandParameter="Palette"
                              IsChecked="{Binding IsLibraryPanelShowing, Mode=OneWay}"
                              ToolTip.Tip="Library">
                    <mi:MaterialIcon Kind="ViewGridPlusOutline" Width="18" Height="18"/>
                </ToggleButton>
                <ToggleButton Classes="PanelToggle"
                              Command="{Binding ToggleToolPanelCommand}" CommandParameter="Properties"
                              IsChecked="{Binding IsPropertiesPanelShowing, Mode=OneWay}"
                              ToolTip.Tip="Properties Inspector">
                    <mi:MaterialIcon Kind="FormatListBulleted" Width="18" Height="18"/>
                </ToggleButton>
                <ToggleButton Classes="PanelToggle"
                              Command="{Binding ToggleToolPanelCommand}" CommandParameter="Messages"
                              IsChecked="{Binding IsMessagesPanelShowing, Mode=OneWay}"
                              ToolTip.Tip="Messages">
                    <mi:MaterialIcon Kind="MessageTextOutline" Width="18" Height="18"/>
                </ToggleButton>

                <!-- ── The history panel (owner, 2026-09-07; ONE of them since RC-10, §5.10) ──────
                     Same three-state toggle as the three above, and the same glyph the View menu uses
                     for it — a button and a menu item that open the same panel under different
                     pictures are two things to learn.

                     PRESENT ONLY WHEN THERE IS A HISTORY TO LOOK AT: a workspace is open, there is a
                     usable git, and "keep a history" is on for this workspace (CanShowRevisionButtons).
                     Absent rather than greyed, which is RC-3's rule — a designer who never turns this
                     on should not carry a dead button across the toolbar for the life of the
                     application. The View menu still opens the panel whatever the toolbar shows, so
                     nothing becomes unreachable.

                     The separator is inside the same visibility, or a machine with no git would keep a
                     hairline rule with nothing after it. -->
                <Border Width="1" Margin="3,2" Background="{DynamicResource SystemBaseMediumLowColor}"
                        IsVisible="{Binding CanShowRevisionButtons}"/>
                <ToggleButton Classes="PanelToggle"
                              Command="{Binding ToggleToolPanelCommand}" CommandParameter="History"
                              IsChecked="{Binding IsHistoryPanelShowing, Mode=OneWay}"
                              IsVisible="{Binding CanShowRevisionButtons}"
                              ToolTip.Tip="History — the states of this workspace circuitRF kept for you and the versions you kept on purpose, in one list. Go back to any of them; what you have now is kept first.">
                    <mi:MaterialIcon Kind="History" Width="18" Height="18"/>
                </ToggleButton>

            </StackPanel>
        </Border>

        <!-- ── Recording indicator (RC-6 R-rc6-9, R-rc6-10) ───────────────
             THE PERSISTENT, NON-SCROLLING INDICATOR, and it is deliberately a strip at the foot of
             the window rather than a Messages entry or a badge on the project tree.

             §12 Q4 Refinement 2: a scrolling log is read once and then trained against, while "circuitRF
             is recording nothing for this workspace" is permanent for the session and should be
             displayed permanently. This is the measure most likely to actually prevent the false
             belief §1.4 is written against.

             It is NOT collapsed to a badge on the project-tree root, which the architecture offers as
             the alternative: that panel can be closed, floated, or replaced by a workspace layout, so
             the indicator would vanish exactly when the designer had stopped looking at the history.
             The window always has a foot.

             ONE indicator, THREE reasons — off, held, and a boundary that failed — because all three
             mean the same thing to a designer: nothing is being recorded right now. The reason is in
             the text beside it. Collapsed entirely when recording is normal: a badge that is always
             there is a badge nobody reads, and on a machine with no git the feature does not exist. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasRecordingIndicator}"
                Background="{DynamicResource SystemChromeLowColor}"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <mi:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Opacity="0.8"/>
                <TextBlock Text="{Binding RecordingIndicator}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RecordingIndicatorDetail}" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding RecordingIndicatorDetail}"/>
            </StackPanel>
        </Border>

        <!-- ── DockControl (the four Dock regions) ─────────────────────── -->
        <!-- RUNTIME NOTE: DockControl requires Dock.Avalonia styles to be loaded in
             App.axaml (see <StyleInclude Source="avares://Dock.Avalonia/..."/>).
             If the layout renders as blank panels, verify the style path. -->
        <dock:DockControl x:Name="MainDockControl"
                          Layout="{Binding Layout}"
                          Factory="{Binding DockFactory}"/>

    </DockPanel>
</Window>
