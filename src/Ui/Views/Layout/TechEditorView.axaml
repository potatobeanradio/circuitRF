<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lay="using:CircuitRF.Ui.Layout"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Layout.TechEditorView"
             x:DataType="lay:TechDocument"
             Focusable="True" IsTabStop="False"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <conv:ToLowerStringConverter x:Key="ToLower"/>
        <conv:SheetAtLabelConverter x:Key="SheetAtLabel"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.colhdr">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>

        <!-- ── The Name column's width grip (owner, 2026-09-17) ─────────────────
             Name is the one column on the layer table that cannot be read wider by widening the
             window: the ten fixed columns beside it already fill a default-sized window on their
             own, so the star-sized Name column sits pinned at its MinWidth and a long process layer
             name is cut off with nowhere to go. The grip is how a full name is read without
             touching the window — drag it right, read the name, double-click it to put the column
             back where it was.

             It sits at the RIGHT edge of the Name header, directly above the end of the column of
             name boxes, because the right edge is the one it moves. Two hairlines rather than a
             glyph or a word: in 10 px of header it is the only mark that reads as "grab me"
             without joining in with the column titles. Dimmed until the pointer is on it. -->
        <Style Selector="Border.colgrip">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.colgrip:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.colgrip Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── A FIELD AN EM RUN CANNOT USE (owner, 2026-09-08) ─────────────────
             A Gerber import used to leave every substrate value at zero, and the only thing that said
             so was a sentence in the problems list naming a layer by name — a long way from the box
             the number has to be typed into. Ten of those is a technology somebody believes is
             finished and that refuses at Simulate.

             AMBER, NOT RED, and 1px plus a wash you can barely see: red means the application refused
             something, while an unfilled thickness is a normal state of a freshly imported technology.
             The field must stay perfectly readable and typeable while it is marked — the job is to
             catch the eye scrolling a stackup, not to shout.

             The condition comes from StackupFieldReadiness (src/Design), which is also what
             TechValidation phrases its sentences from, so the mark beside the box and the problem in
             the list cannot disagree.

             A Style beats a ControlTheme in Avalonia, so this survives the theme's own :pointerover
             and :focus border setters without needing a copy for each. -->
        <Style Selector="TextBox.cell.needsvalue">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CrfNeedsValueBorderBrush}"/>
            <Setter Property="Background"  Value="{DynamicResource CrfNeedsValueFillBrush}"/>
        </Style>

        <!-- ── A cell that cannot overflow gets a stripped-down template ────────
             A row of this table is realized whole every time the list scrolls a page, and a
             stock TextBox is not a cheap thing to realize: its template carries a ScrollViewer,
             that ScrollViewer's two ScrollBars, and a DataValidationErrors wrapper — about
             twenty visual nodes each, for a single-line field a few characters wide. Measured on
             a 377-layer technology: 199 visual nodes per row and ~180 ms to page-scroll, of which
             the seven text cells were the largest single share.

             Setting the scroll-bar visibilities to Disabled does NOT help — the bars are built by
             the template whatever their visibility, which was measured too (no change at all).
             Replacing the template is what removes them.

             ONLY for fields of FIXED width holding short values — a layer number, a datatype, an
             opacity, a Z order. The saving comes from dropping the ScrollViewer, and the
             ScrollViewer is what scrolls a long value horizontally to keep the caret visible while
             it is being typed. A free-text column (Name, Purpose) keeps the stock template for
             exactly that reason; four digits in a 34 px box cannot outgrow it, and a layer name
             very much can.

             It also drops the watermark, so a field with PlaceholderText — the four filter boxes —
             keeps the stock template too. Nothing in the compact set has one. -->
        <Style Selector="TextBox.cell.compact">
            <Setter Property="Template">
                <ControlTemplate TargetType="TextBox">
                    <Border Name="PART_BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <TextPresenter Name="PART_TextPresenter"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ComboBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── The filter row (every tab) ───────────────────────────────────────
             `filter` is the search box; `coltoggle` is a bulk toggle that sits in, and is
             sized by, the narrow column it acts on (Vis and Sel are 30 px wide), so it has to
             shed the theme's default button metrics entirely rather than merely shrink. -->
        <Style Selector="TextBox.filter">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- The Stackup tab's summary readouts. One class rather than five copies of the same
             three setters, and the vertical margin is what keeps the row legible when the WrapPanel
             it lives in wraps onto a second line. -->
        <Style Selector="TextBlock.stat, SelectableTextBlock.stat">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="TextBlock.statsep">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Margin" Value="8,1"/>
        </Style>
        <Style Selector="TextBlock.filtercount">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <!-- ── The Stackup tab's two pane expanders (owner, 2026-09-13) ────────
             SMALL AND SUBTLE, which is the whole specification: they sit in the top-left corner of
             the two panes they collapse, and they are there to be found when wanted rather than to
             be part of the picture. So: no background, no border, a 14 px glyph, and two-thirds
             opacity until the pointer is on one.

             ── IT CARRIES ITS OWN TEMPLATE, AND THAT IS THE FIX ─────────────────
             Owner, 2026-09-13: "the expanders are invisible when I first open a .ctech file". They
             were, and only in the state they OPEN in. Both start expanded, which is IsChecked=True,
             and Fluent's ToggleButton theme paints a checked button with an accent background and a
             LIGHT ON ACCENT foreground. Overriding the background to transparent — which is what a
             subtle button wants — left the glyph painted in that light-on-accent brush over the
             pane's own pale ground, so it was there, drawn, and the same colour as what was behind
             it. Unchecking it made it appear, which is exactly backwards from how a control should
             behave.

             Overriding the two foregrounds per state would work and would have to be redone for
             every state the theme grows. A template with no state brushes in it at all cannot have
             the problem: the glyph takes this style's own Foreground, inherited, in every state.
             A Style beats a ControlTheme in Avalonia, which is the same lever TextBox.cell.compact
             above pulls.

             Transparent rather than unset Background — a ToggleButton with no background is not
             hit-testable, so a button that looked right would not be clickable. -->
        <Style Selector="ToggleButton.paneexpander">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.paneexpander:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SystemListLowColor}"/>
        </Style>

        <Style Selector="ToggleButton.coltoggle">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── The row lists ────────────────────────────────────────────────────
             A bare ItemsControl inside a ScrollViewer is NOT virtualized: Avalonia's
             ItemsControl defaults to a plain StackPanel and, given a ScrollViewer's
             infinite measure height, realizes EVERY item. That is fine for a starter
             technology's eight layers and lethal for a real process's several hundred
             (an imported PDK measured carries 377), where the Layers and
             Interchange tabs each realized ~377 rows of ten controls before the tab
             could paint.

             ListBox is the fix — its default ItemsPanel is a VirtualizingStackPanel —
             and it is the SAME answer this codebase already settled on for the layout
             editor's vertex list (see src/Ui/CLAUDE.md, "L1j post-ship fix"). The
             scroll-bar visibilities are set EXPLICITLY there for the same reason they
             are here: the theme's own default is not to be relied on.

             `rows` flattens the selection chrome so a virtualized row still reads as a
             row rather than a list item — these lists exist to hold editable fields,
             not to be selected from. -->
        <Style Selector="ListBox.rows">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- R-stk3-6: the stackup card whose band is selected in the drawing above.
             SHADE, not outline — the owner asked for the group background, so the clicked band and
             the fields below are unmistakably the same thing. Driven by the row VM's IsSelected, NOT
             by ListBoxItem:selected: the selection is the view model's (held by NAME, because every
             row VM is destroyed on every committed edit) and the ListBox's own is a second view of
             it, kept in step by TechEditorViewModel.SelectedStackupLayerRow. The chrome that WOULD
             have come from :selected is flattened away three styles above, deliberately. -->
        <Style Selector="Border.stackupcard.selected">
            <Setter Property="Background" Value="{DynamicResource CrfStackupSelectedCardBrush}"/>
        </Style>

        <!-- ── The conductor card's drawing-layer picker (R-stk2-8) ─────────────
             Three across, four down: twelve layers visible at once where four were, in less
             vertical space than the four took.

             THE ROW HEIGHT IS PINNED HERE, and that is what makes "a MaxHeight admitting exactly
             four rows" a true statement rather than a hopeful one. The theme's own CheckBox measures
             about 35 px — which is where the old typed MaxHeight="140" came from — and it is free to
             change on a theme upgrade, at which point a typed 140 would admit three rows or five and
             nothing would say so. MinHeight has to be zeroed as well: Avalonia clamps Height UP to
             MinHeight, so the theme's would simply win.

             The picker is NOT virtualized — a UniformGrid items panel cannot be. That is deliberate
             and it is the same bargain the file's own note at the top of these styles describes: the
             bounded height plus the filter box above it is what keeps a several-hundred-layer
             technology affordable, because only what fits is ever realized. -->
        <Style Selector="ListBox.layerpicker CheckBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="{x:Static lay:TechEditorMetrics.DrawingLayerRowHeight}"/>
            <Setter Property="Padding" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ── Header ───────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <!-- The identity block owns the ONLY star column, so it is the one that shrinks as the
                     window narrows. A horizontal StackPanel would keep its full desired width and paint
                     straight over the next column (the reported overlap), so this is a Grid whose middle
                     cell is itself starred: the technology NAME trims with an ellipsis while the fixed
                     "· Technology" suffix stays legible. ClipToBounds is the backstop for widths so
                     narrow that even the suffix no longer fits. -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                      VerticalAlignment="Center" ClipToBounds="True" MinWidth="0">
                    <mi:MaterialIcon Grid.Column="0" Kind="LayersOutline" Width="16" Height="16"
                                     Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ViewModel.Working.Name}"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ViewModel.Working.Name}"/>
                    <TextBlock Grid.Column="2" Text="· Technology"
                               Foreground="{DynamicResource SystemBaseMediumColor}" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="12,0">
                    <!-- Deliberately NOT "Display unit:" — R-tec-4: the label must not read as a live
                         per-layout setting. "for new layouts" is the load-bearing part of the wording and
                         stays; only the redundant "Default display" prefix was dropped. The full
                         explanation lives in the tooltip, now on the combo as well as the label. -->
                    <TextBlock Text="Unit for new layouts:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               ToolTip.Tip="Seeds a newly-created layout's own display-unit choice. Never changes any open or already-saved layout — each layout keeps its own unit once created."/>
                    <ComboBox Classes="cell" ItemsSource="{Binding ViewModel.DisplayUnitOptions}"
                              SelectedItem="{Binding ViewModel.DefaultDisplayUnit}"
                              ToolTip.Tip="Seeds a newly-created layout's own display-unit choice. Never changes any open or already-saved layout — each layout keeps its own unit once created.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToLower}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="2" Content="Undo" Command="{Binding ViewModel.UndoCommand}" FontSize="11" Padding="8,3" Margin="4,0,0,0"/>
                <Button Grid.Column="3" Content="Redo" Command="{Binding ViewModel.RedoCommand}" FontSize="11" Padding="8,3" Margin="4,0,0,0"/>
                <Button Grid.Column="4" Content="Save" Command="{Binding ViewModel.SaveCommand}" FontSize="11" Padding="8,3" Margin="4,0,0,0"/>

                <!-- Help, in the top-right corner, on the same ? glyph every other Help button in the
                     application uses. It is TAB-AWARE — see TechEditorView.OnHelp — because this one
                     window edits four unrelated things and there is no single page that documents all
                     of them; a button that always opened the same chapter would be right a quarter of
                     the time. Every destination it can emit is listed in DocAnchors, so the docs build
                     fails if one of those sections stops being emitted. -->
                <Button Grid.Column="5" Name="HelpButton" Padding="6,3" Margin="8,0,0,0"
                        ToolTip.Tip="{Binding ViewModel.HelpTip}">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Validation banner — live, never blocks Save, and SCOPED TO THE VISIBLE TAB ────
             It lists ActiveTabIssues, not every problem the technology has. An imported board's
             technology routinely carries a couple of dozen, nearly all of them interchange-alias
             clashes that mean nothing to someone editing the layer table, and reciting them over
             every tab on every open is the eye-sore this replaced. The counts on the other tab
             headers are what keeps this a filter rather than a hiding place.

             DOCKED TO THE BOTTOM, BELOW THE TABS, and that placement is load-bearing rather than
             stylistic. Above the TabControl it sat between the title bar and the tab header strip,
             so appearing and disappearing MOVED THE HEADERS — and since the banner is now per-tab,
             clicking along Layers → Stackup → DRC Rules → Interchange made the very row being
             clicked jump up and down under the pointer. Below the content, the headers never move
             and only the bottom edge of the editor changes. Declared BEFORE the TabControl because
             a DockPanel gives its remaining space to the last child: this reserves its strip, the
             TabControl fills what is left. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding ViewModel.HasActiveTabIssues}"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                BorderBrush="{DynamicResource CrfWarningBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,6"
                MaxHeight="120">
            <!-- HorizontalScrollBarVisibility is Disabled EXPLICITLY, so the row below is measured
                 against the banner's real width and the text has something to wrap at. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ViewModel.ActiveTabIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <!-- A GRID, not the horizontal StackPanel this was: a StackPanel measures
                                 its children with UNBOUNDED width on its own axis, so `TextWrapping`
                                 was set and could never fire — a long message (a suffix collision
                                 names several layers) simply ran off the right edge with no way to
                                 read the rest of it. The starred second column is what gives the
                                 wrap a width to happen at.

                                 SelectableTextBlock so the message can be COPIED — these name layers
                                 and values the user then goes and searches for. The icon aligns Top
                                 rather than Center so it stays beside the FIRST line of a message
                                 that now runs to several. -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertCircleOutline"
                                                 Width="12" Height="12" Margin="0,2,6,0"
                                                 VerticalAlignment="Top"
                                                 Foreground="{DynamicResource CrfWarningBrush}"/>
                                <SelectableTextBlock Grid.Column="1" Text="{Binding}" FontSize="11"
                                                     TextWrapping="Wrap"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Top"
                                                     Foreground="{DynamicResource CrfWarningBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Sections ─────────────────────────────────────────────────────── -->
        <TabControl x:Name="SectionTabs" SelectedIndex="{Binding ViewModel.SelectedTabIndex, Mode=TwoWay}">

            <!-- TabControl's DEFAULT ItemsPanel is a WrapPanel (Avalonia.Controls.TabControl:
                 DefaultPanel = new FuncTemplate<Panel>(() => new WrapPanel())) — that is why the four
                 headers spilled onto a second row as the window narrowed. A horizontal StackPanel keeps
                 them on one row unconditionally. The scoped TabItem style then pins the size explicitly
                 rather than inheriting the theme's Pivot-scale header metrics, so one row actually FITS
                 at a narrow width instead of merely being promised. -->
            <TabControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </TabControl.ItemsPanel>

            <TabControl.Styles>
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </TabControl.Styles>

            <!-- Layer table ────────────────────────────────────────────────── -->
            <TabItem Header="{Binding ViewModel.LayersTabHeader}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="6,4">
                        <Button Content="＋ Add Layer" Command="{Binding ViewModel.AddLayerCommand}" FontSize="11" Padding="8,3"/>
                    </StackPanel>

                    <!-- Both the header row and every item row below declare the SAME column list, so
                         a header always sits exactly above its control.

                         FIXED widths, not `Auto` + SharedSizeGroup, and that is a REQUIREMENT of
                         virtualizing the list below rather than a simplification. A shared size group
                         is the maximum over the participants that were actually MEASURED — with
                         virtualization only the rows on screen are, so the column widths would shift
                         under the user every time scrolling realized a wider row. Every column here
                         except Name holds fixed-width content already (the widths below are the ones
                         its own control declares), so pinning them loses nothing. -->
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- ── Filter + bulk toggles ─────────────────────────────────
                             Same column list as the header and the rows below, so each control
                             sits in the column it acts on: the search box in Name, and the two
                             bulk toggles directly above the Vis and Sel checkbox columns they
                             sweep. A row of buttons parked at the left, acting on a column 400 px
                             away, is the version of this that has to be read twice. -->
                        <Grid Grid.Row="0" Margin="4,4,4,2" ColumnSpacing="4" x:Name="LayerFilterColumns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="110"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Classes="filter" x:Name="LayerFilterBox"
                                         Text="{Binding ViewModel.LayerFilter, Mode=TwoWay}"
                                         PlaceholderText="Filter by layer name..."
                                         ToolTip.Tip="Shows only layers whose name contains this text (case-insensitive). Clear it to show every layer again."/>
                                <TextBlock Grid.Column="1" Classes="filtercount" Text="{Binding ViewModel.LayerFilterSummary}"/>
                            </Grid>

                            <ToggleButton Grid.Column="1" Classes="coltoggle"
                                          IsChecked="{Binding ViewModel.AllShownLayersVisible, Mode=TwoWay}"
                                          ToolTip.Tip="Show or hide every layer currently listed. With a filter active this applies to the filtered layers only, not to the ones it hid from view.">
                                <Panel>
                                    <mi:MaterialIcon Kind="Eye" Width="12" Height="12"
                                                     IsVisible="{Binding ViewModel.AllShownLayersVisible}"/>
                                    <mi:MaterialIcon Kind="EyeOff" Width="12" Height="12"
                                                     IsVisible="{Binding !ViewModel.AllShownLayersVisible}"/>
                                </Panel>
                            </ToggleButton>
                            <ToggleButton Grid.Column="2" Classes="coltoggle"
                                          IsChecked="{Binding ViewModel.AllShownLayersSelectable, Mode=TwoWay}"
                                          ToolTip.Tip="Make every layer currently listed selectable or unselectable. With a filter active this applies to the filtered layers only, not to the ones it hid from view.">
                                <Panel>
                                    <mi:MaterialIcon Kind="SelectAll" Width="12" Height="12"
                                                     IsVisible="{Binding ViewModel.AllShownLayersSelectable}"/>
                                    <mi:MaterialIcon Kind="SelectOff" Width="12" Height="12"
                                                     IsVisible="{Binding !ViewModel.AllShownLayersSelectable}"/>
                                </Panel>
                            </ToggleButton>
                        </Grid>

                        <Grid Grid.Row="1" Margin="4,4,4,2" ColumnSpacing="4" x:Name="LayerHeaderColumns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="110"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="colhdr" Text="Name" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Classes="colgrip" x:Name="LayerNameGrip"
                                        PointerPressed="OnLayerNameGripPressed"
                                        PointerMoved="OnLayerNameGripMoved"
                                        PointerReleased="OnLayerNameGripReleased"
                                        ToolTip.Tip="Drag to widen or narrow the Name column; the columns beside it move to follow. Double-click to restore its default width.">
                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle/>
                                        <Rectangle/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="1"  Classes="colhdr" Text="Vis"       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2"  Classes="colhdr" Text="Sel"       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3"  Classes="colhdr" Text="Color"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4"  Classes="colhdr" Text="Pattern"   HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5"  Classes="colhdr" Text="Fill"      HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6"  Classes="colhdr" Text="Z"         HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7"  Classes="colhdr" Text="Purpose"   HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8"  Classes="colhdr" Text="Layer"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="9"  Classes="colhdr" Text="Datatype"  HorizontalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="2" Classes="rows" x:Name="LayersList" ItemsSource="{Binding ViewModel.FilteredLayers}"
                                 Margin="4,0,4,4" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="lay:LayerRowViewModel">
                                        <Border BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                                            <Grid ColumnSpacing="4" Tag="LayerRowColumns" Loaded="OnLayerRowColumnsLoaded">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="82"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBox Grid.Column="0" Classes="cell" Tag="Name"
                                                         HorizontalAlignment="Stretch"
                                                         Text="{Binding StagedName}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <CheckBox Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding Visible}"/>
                                                <CheckBox Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding Selectable}"/>
                                                <Button Grid.Column="3" Width="48" Padding="2"
                                                        Command="{Binding PickColorCommand}"
                                                        CommandParameter="{Binding $parent[Window]}">
                                                    <Border Width="32" Height="14" CornerRadius="2"
                                                            BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="1">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="{Binding SwatchColor}"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Button>
                                                <!-- The stipple this layer fills through, beside the colour because the two together are
                                                     what identifies a layer: a process reuses its colours across far more layers than it
                                                     has colours, so the pattern is usually the half that tells two of them apart.
                                                     A dropdown over the technology's OWN pattern table, not a text field: a typed name
                                                     matching nothing would silently repaint the layer solid with nothing anywhere to say
                                                     why. Commits on selection, like the visibility checkboxes — a combo has no "finished
                                                     editing" moment of its own to wait for. -->
                                                <ComboBox Grid.Column="4" FontSize="11" Padding="4,2" MinHeight="0"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding FillPatternChoices}"
                                                          SelectedItem="{Binding SelectedFillPattern, Mode=TwoWay}"
                                                          ToolTip.Tip="Fill pattern (stipple). Layers a process gives the same colour are usually told apart by this."/>
                                                <TextBox Grid.Column="5" Classes="cell compact" Width="44" Tag="FillOpacity"
                                                         Text="{Binding StagedFillOpacity}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" Width="70" Spacing="2">
                                                    <TextBox Classes="cell compact" Width="36" Tag="ZOrder"
                                                             Text="{Binding StagedZOrder}"
                                                             LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                    <Button Content="↑" Padding="2,0" FontSize="10" Command="{Binding MoveUpCommand}"/>
                                                    <Button Content="↓" Padding="2,0" FontSize="10" Command="{Binding MoveDownCommand}"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="7" Classes="cell" Tag="Purpose"
                                                         Text="{Binding StagedPurpose}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <!-- Layer and Datatype are small integers — 34 px holds three digits with room to spare
                                                     and a rare four-digit value without clipping. Centred, because the column stays as
                                                     wide as its own header text ("Datatype" is the widest thing in that column, not the
                                                     field). The SAME 34 is used for the GDSII layer/datatype pair on the Interchange tab
                                                     — same quantity, same size. -->
                                                <TextBox Grid.Column="8" Classes="cell compact" Width="34" HorizontalAlignment="Center" Tag="LayerNumber"
                                                         Text="{Binding StagedLayerNumber}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBox Grid.Column="9" Classes="cell compact" Width="34" HorizontalAlignment="Center" Tag="Datatype"
                                                         Text="{Binding StagedDatatype}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="3">
                                                    <!-- The same two glyphs the analyses toolbar uses for the
                                                         same two actions, so one meaning has one icon across
                                                         the app rather than a word here and a glyph there. -->
                                                    <Button FontSize="10" Padding="4,2"
                                                            ToolTip.Tip="Copy layer"
                                                            Command="{Binding DuplicateCommand}">
                                                        <mi:MaterialIcon Kind="ContentCopy" Width="11" Height="11"/>
                                                    </Button>
                                                    <Button FontSize="10" Padding="4,2"
                                                            ToolTip.Tip="Remove layer"
                                                            Command="{Binding RemoveCommand}">
                                                        <mi:MaterialIcon Kind="Delete" Width="11" Height="11"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Stackup ────────────────────────────────────────────────────── -->
            <TabItem Header="{Binding ViewModel.StackupTabHeader}">
                <!-- ── FOUR rows, not the five the sections below might suggest ──────────────────
                     header / drawing / splitter / the cards pane, where the cards pane is the filter
                     row and the card list TOGETHER in one DockPanel.

                     They have to share a row. A GridSplitter resizes the definitions immediately
                     before and immediately after itself, so a filter row of its own between the
                     splitter and the cards would be the thing the splitter grew and shrank — an Auto
                     row holding one text box. Putting the filter INSIDE the bottom pane is also what
                     it means: the owner moved it down because it filters the cards and has nothing to
                     do with the drawing, and "belongs to the bottom pane" and "is in the bottom
                     pane's row" should be the same statement.

                     A DockPanel cannot express a splitter between two proportional panes at all,
                     which is why this stopped being one. -->
                <!-- x:Name'd because the two expanders resize these rows from code-behind: an
                     Avalonia RowDefinition is outside the logical tree and inherits no DataContext,
                     so its Height cannot be bound. See TechEditorView.ApplyStackupPaneLayout. -->
                <Grid x:Name="StackupTabGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- The drawing takes what is left over, and neither pane can be dragged out
                             of existence. Both of these are REWRITTEN by ApplyStackupPaneLayout when
                             a pane is collapsed; what is here is the both-expanded state. -->
                        <RowDefinition Height="*"
                                       MinHeight="{x:Static lay:TechEditorMetrics.StackupDrawingMinHeight}"/>
                        <RowDefinition Height="Auto"/>
                        <!-- R-stk2-6: the card list OPENS at roughly one conductor card and the
                             splitter is there for anyone who wants it the other way round. The height
                             tracks the card template rather than being a pixel count typed here —
                             see TechEditorMetrics. -->
                        <RowDefinition Height="{x:Static lay:TechEditorMetrics.StackupCardPaneOpeningHeight}"
                                       MinHeight="{x:Static lay:TechEditorMetrics.StackupCardPaneMinHeight}"/>
                    </Grid.RowDefinitions>

                    <!-- TWO rows, and which control is on which is the whole point of the arrangement:
                         the things you ACT with are on the top row (the two boundary conditions, and the
                         three Add buttons at the right edge), and the things you READ are on the row
                         below. The Add buttons used to be docked to the BOTTOM of the pane, a full
                         stackup's scroll away from the row being added to.

                         ClipToBounds on the top row is the backstop for a window narrow enough that the
                         starred spacer has run out: the Add buttons are then trimmed at the right edge
                         rather than painting over the Bottom combo beside them, which is what a Grid
                         does when its Auto columns no longer fit. -->
                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="4"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="6,6" ClipToBounds="True">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Top:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Classes="cell"
                                  ItemsSource="{x:Static lay:TechEditorViewModel.BoundaryConditions}"
                                  SelectedItem="{Binding ViewModel.StackupTop, Mode=TwoWay}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Bottom:" VerticalAlignment="Center" FontSize="11" Margin="12,0,4,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="3" Classes="cell"
                                  ItemsSource="{x:Static lay:TechEditorViewModel.BoundaryConditions}"
                                  SelectedItem="{Binding ViewModel.StackupBottom, Mode=TwoWay}"/>

                        <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Spacing="4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="＋ Dielectric" Command="{Binding ViewModel.AddDielectricLayerCommand}" FontSize="11" Padding="8,3"/>
                            <Button Content="＋ Conductor" Command="{Binding ViewModel.AddConductorLayerCommand}" FontSize="11" Padding="8,3"/>
                            <Button Content="＋ Via" Command="{Binding ViewModel.AddViaLayerCommand}" FontSize="11" Padding="8,3"/>
                        </StackPanel>

                        <!-- GI3 R-gi3-6/R-gi3-7, plus the three counts beside it. The height is the
                             cheapest possible check on a hand-entered stackup: does it add up? It
                             catches the common error directly — a stack transcribed one row at a time
                             and never totalled does not match the board it came from, and nothing said
                             so before a run gave a wrong answer. The board figure appears only when
                             some other document stated one (a job file's BoardThickness); a
                             disagreement is MARKED and never corrected.

                             A WrapPanel, not the StackPanel this was: a horizontal StackPanel measures
                             its children with UNBOUNDED width on its own axis, so a narrow window does
                             not shorten it — it runs out of the row and over whatever is beside it.
                             These readouts wrap onto a second line instead, which is why the row above
                             is where the buttons live and this one is free to grow downwards.

                             SelectableTextBlock throughout: every one of these is a number somebody
                             copies — into a fab note, a spreadsheet, or a message asking whether the
                             board is the one they think it is. -->
                        <!-- ── The two pane expanders (owner, 2026-09-13) ────────────────────────
                             HERE, on the Stack height row, and not in the panes they collapse.

                             They began at the top-left corner of each pane, which is where they were
                             asked for and is where they read best — and the card pane's one then MOVED
                             when it was used: collapsing a pane gives its space to the other, so
                             anything sitting at the top of the lower pane is pushed down by exactly the
                             height that was freed, and a second click has to chase it. In a vertical
                             stack the only y positions that do not move are the top of the tab and the
                             bottom of it, so the owner's answer was to put both in this fixed header
                             (2026-09-13). Side by side, because they are one pair of related controls
                             and a reader has to be able to tell which is which — hence the pane glyph
                             beside each chevron.

                             Column 0 with the readouts moved to columns 1-5: the WrapPanel is
                             right-aligned and wraps, so on a narrow window it would otherwise come
                             back across a toggle sharing its cell. -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="StackupDrawingExpander" Classes="paneexpander"
                                          IsChecked="{Binding ViewModel.StackupDrawingExpanded, Mode=TwoWay}"
                                          ToolTip.Tip="{x:Static lay:StackupCardText.DrawingPaneExpanderTip}">
                                <!-- Foreground stated on every glyph as well as on the style, so the
                                     icon stays legible whatever a future template does with a state
                                     brush — see the .paneexpander style for the bug that is about. -->
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <mi:MaterialIcon Kind="ChevronDown" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"
                                                     IsVisible="{Binding ViewModel.StackupDrawingExpanded}"/>
                                    <mi:MaterialIcon Kind="ChevronRight" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"
                                                     IsVisible="{Binding !ViewModel.StackupDrawingExpanded}"/>
                                    <mi:MaterialIcon Kind="Layers" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="StackupCardsExpander" Classes="paneexpander"
                                          IsChecked="{Binding ViewModel.StackupCardsExpanded, Mode=TwoWay}"
                                          ToolTip.Tip="{x:Static lay:StackupCardText.CardPaneExpanderTip}">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <mi:MaterialIcon Kind="ChevronDown" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"
                                                     IsVisible="{Binding ViewModel.StackupCardsExpanded}"/>
                                    <mi:MaterialIcon Kind="ChevronRight" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"
                                                     IsVisible="{Binding !ViewModel.StackupCardsExpanded}"/>
                                    <mi:MaterialIcon Kind="ViewList" Width="13" Height="13"
                                                     Foreground="{DynamicResource SystemBaseHighColor}"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                   HorizontalAlignment="Right">
                            <TextBlock Text="Stack height:" Classes="stat" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"/>
                            <SelectableTextBlock Text="{Binding ViewModel.StackTotalText}" Classes="stat"
                                                 FontWeight="SemiBold"
                                                 ToolTip.Tip="The sum of every Conductor and Dielectric thickness in this stackup, in the technology's display unit. Via entries are excluded — a via has no z band of its own, it traverses the dielectrics between the conductors it spans."/>
                            <TextBlock Text="·" Classes="statsep"/>
                            <SelectableTextBlock Text="{Binding ViewModel.ConductorCountText}" Classes="stat"
                                                 Foreground="{DynamicResource SystemBaseMediumColor}"
                                                 ToolTip.Tip="How many Conductor entries this stackup holds — the metal layers. On a board this is the layer count the fabricator quotes."/>
                            <TextBlock Text="·" Classes="statsep"/>
                            <SelectableTextBlock Text="{Binding ViewModel.DielectricCountText}" Classes="stat"
                                                 Foreground="{DynamicResource SystemBaseMediumColor}"
                                                 ToolTip.Tip="How many Dielectric entries this stackup holds — the insulating layers between the conductors. A dielectric is never drawn on and has no drawing layer."/>
                            <TextBlock Text="·" Classes="statsep"/>
                            <SelectableTextBlock Text="{Binding ViewModel.ViaCountText}" Classes="stat"
                                                 Foreground="{DynamicResource SystemBaseMediumColor}"
                                                 ToolTip.Tip="How many Via ENTRIES this stackup holds, not how many holes are drilled. A via entry is one kind of connection between two named conductors, and every via drawn on its drawing layer is an instance of it."/>
                            <TextBlock Text="·" Classes="statsep"
                                       IsVisible="{Binding ViewModel.HasBoardThickness}"/>
                            <TextBlock Text="board:" Classes="stat" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       IsVisible="{Binding ViewModel.HasBoardThickness}"/>
                            <SelectableTextBlock Text="{Binding ViewModel.BoardThicknessText}" Classes="stat"
                                                 IsVisible="{Binding ViewModel.HasBoardThickness}"
                                                 ToolTip.Tip="The overall board thickness the imported job file states. It is a second opinion, not a constraint: nothing derives geometry from it, and the stack a solver sees is built from the layer entries alone."/>
                            <TextBlock Text="⚠ does not match the stated board thickness" Classes="stat"
                                       Margin="6,0,0,0"
                                       Foreground="{DynamicResource CrfWarningBrush}"
                                       IsVisible="{Binding ViewModel.HasStackHeightMismatch}"
                                       ToolTip.Tip="{Binding ViewModel.StackHeightMismatchText}"/>
                        </WrapPanel>
                    </Grid>

                    <!-- ── The drawing (R-stk2-7) ────────────────────────────────────────────────
                         VERTICAL only. The scene fits the pane's width by construction (brief 1 §2),
                         so a horizontal scrollbar appearing here would mean the scene got its own
                         width wrong — and it would mean the drawing and a brief-3 click no longer
                         agree about where anything is.

                         The canvas measures to the scene's intrinsic height, which is what there is
                         to scroll: a 20-layer stack does not fit and is not squeezed until it does. -->
                    <ScrollViewer Grid.Row="1" Margin="6,0,6,0"
                                  IsVisible="{Binding ViewModel.StackupDrawingExpanded}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- R-stk4-2. A Panel, so the ONE inline edit box is a sibling of the
                             drawing rather than a child of it, sharing its origin: the box is placed
                             by Margin, and inside a ScrollViewer a margin is in CONTENT coordinates,
                             so the box scrolls with the drawing it is sitting on.

                             One box, hidden at rest, reused for every label. Never one per label —
                             and it is the schematic editor's own SchematicInlineEditBox, unchanged,
                             because that class already carries the StyleKeyOverride, the baseline
                             placement and the Skia width measurement that took three reports to get
                             right. The attributes below are SchematicView.axaml's, for the same
                             reason it states them: they are what the control's own constants mean. -->
                        <Panel>
                            <ctrl:StackupCanvas x:Name="StackupDrawing" ViewModel="{Binding ViewModel}">
                                <!-- R-stk6-1. ONE ContextMenu instance, declared once here on the
                                     control; StackupCanvas never constructs or opens one of its own.
                                     That is LayoutEditorView.axaml's own fix, adopted verbatim,
                                     because the bug it fixes is the one this pattern exists for:
                                     building and manually opening a menu per right-click STACKED
                                     them. The canvas only RECORDS the click; Avalonia opens this
                                     menu itself and raises Opening, which rebuilds ItemsSource
                                     fresh — never reusing item instances, whose Click handlers
                                     would then fire N times on the Nth opening. -->
                                <ctrl:StackupCanvas.ContextMenu>
                                    <ContextMenu Opening="OnStackupContextMenuOpening"/>
                                </ctrl:StackupCanvas.ContextMenu>
                            </ctrl:StackupCanvas>

                            <ctrl:SchematicInlineEditBox x:Name="StackupInlineEdit"
                                     IsVisible="False"
                                     FontSize="11"
                                     FontFamily="{DynamicResource IBMPlexSans}"
                                     Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                     TextAlignment="Left"
                                     Padding="4,2"
                                     MinHeight="0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     LostFocus="OnStackupInlineEditLostFocus"
                                     KeyDown="OnStackupInlineEditKeyDown"/>
                        </Panel>
                    </ScrollViewer>

                    <!-- Transparent and 6 px: a grab strip, not a rule. The card Border below already
                         draws the only line this seam needs. Hidden while either pane is collapsed —
                         a splitter between a fixed row and a collapsed one moves nothing. -->
                    <!-- ResizeBehavior stated rather than inferred: the default resolves it from the
                         splitter's own alignment, which is a property somebody could change for a
                         cosmetic reason and silently re-point what the drag moves. -->
                    <GridSplitter x:Name="StackupSplitter" Grid.Row="2" Height="6" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  HorizontalAlignment="Stretch" Background="Transparent"/>

                    <!-- ── The cards pane: the filter row and the cards it filters ───────────────── -->
                    <DockPanel Grid.Row="3">

                    <!-- The stackup rows are cards, not a column grid, so the filter row has only
                         the one control to align: the search box sits at the left edge the cards
                         start at. -->
                    <!-- The filter box and the count go with the CARDS: with the pane collapsed there
                         is nothing to filter, and a search box above a list that is not there is a
                         control that appears to do nothing. The pane's EXPANDER is not here — see the
                         header grid above for why it cannot be. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="220,Auto" ColumnSpacing="6" Margin="6,4,6,4">
                        <TextBox Grid.Column="0" Classes="filter" x:Name="StackupFilterBox"
                                 IsVisible="{Binding ViewModel.StackupCardsExpanded}"
                                 Text="{Binding ViewModel.StackupFilter, Mode=TwoWay}"
                                 PlaceholderText="Filter by stackup layer name..."
                                 ToolTip.Tip="Shows only stackup entries whose name contains this text (case-insensitive)."/>
                        <TextBlock Grid.Column="1" Classes="filtercount"
                                   IsVisible="{Binding ViewModel.StackupCardsExpanded}"
                                   Text="{Binding ViewModel.StackupFilterSummary}"/>
                    </Grid>

                    <!-- R-stk3-7: ONE selection model, two surfaces. SelectedItem is two-way against the
                         view model, which holds the selection by NAME and is what the drawing above
                         reads — so clicking a card selects its band and clicking a band shades its
                         card. Two independent selections on one list is a fight; this is the list
                         losing it on purpose. -->
                    <!-- AutoScrollToSelectedItem="False" — THE SCROLL IS OURS, and this is what makes
                         that true (owner, 2026-09-13, reported three times: "I see a quick flash in
                         the scrollview").

                         SelectingItemsControl.AutoScrollToSelectedItem defaults to TRUE and its
                         AutoScrollToSelectedItemIfNecessary POSTS a ScrollIntoView at a priority that
                         runs BEFORE this view's own Background-priority handler. So every selection
                         change produced TWO movements: the list's own instant jump, rendered, and then
                         our eased scroll starting from wherever that left it. The jump is the flash —
                         it was never the code in TechEditorView, which is why removing the
                         ScrollIntoView from there changed nothing.

                         Nothing is lost by switching it off: the selection is the view model's, and
                         ScrollStackupSelectionIntoView runs on every change of it, from the drawing,
                         from a card, from the context menu and from an undo alike. -->
                    <ListBox Classes="rows" x:Name="StackupList" ItemsSource="{Binding ViewModel.FilteredStackupLayers}"
                             SelectedItem="{Binding ViewModel.SelectedStackupLayerRow, Mode=TwoWay}"
                             IsVisible="{Binding ViewModel.StackupCardsExpanded}"
                             AutoScrollToSelectedItem="False"
                             Margin="6,0,6,4" SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="lay:StackupLayerRowViewModel">
                                  <StackPanel>
                                    <!-- GI3 R-gi3-9. Stackup.Layers is ordered top to bottom and that
                                         order IS z — but a via has no position in it, so a via row
                                         rendered among the conductors read as a layer, and a via added
                                         before them rendered above the top copper. The via entries are
                                         listed as their own group below the ordered ones, with this
                                         line saying why. The MODEL's order is untouched: a reversed
                                         stack simulates cleanly and answers a different question
                                         (R-L4d-5, restated by R-L4g-10). -->
                                    <TextBlock IsVisible="{Binding ShowsViaGroupHeader}"
                                               Text="Vias — outside the top-to-bottom order (each one spans two conductors)"
                                               FontSize="10" Margin="2,10,0,2"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                    <Border Classes="stackupcard" Classes.selected="{Binding IsSelected}"
                                            BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="1" CornerRadius="4"
                                            Margin="0,3" Padding="8,6">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="10"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                                           VerticalAlignment="Center" Width="70"/>
                                                <TextBox Grid.Column="1" Classes="cell" Tag="Name"
                                                         Text="{Binding StagedName}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <!-- GI3 R-gi3-10. Disabled on a via row: its position in the
                                                     list is not z and never was, so the swap changed the
                                                     reading order and nothing else — and under R-gi3-9's
                                                     grouping it would now appear to do nothing at all.
                                                     MoveStackupLayer refuses it too; this is the half that
                                                     says so before the click. -->
                                                <Button Grid.Column="2" Content="↑" Padding="4,2" FontSize="10" Margin="4,0,0,0"
                                                        IsEnabled="{Binding CanMove}"
                                                        Command="{Binding MoveUpCommand}"/>
                                                <Button Grid.Column="3" Content="↓" Padding="4,2" FontSize="10" Margin="4,0,0,0"
                                                        IsEnabled="{Binding CanMove}"
                                                        Command="{Binding MoveDownCommand}"/>
                                                <Button Grid.Column="4" Padding="4,2" FontSize="10" Margin="4,0,0,0"
                                                        Command="{Binding RemoveCommand}">
                                                    <mi:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                                </Button>
                                            </Grid>

                                            <!-- Label column is a fixed width shared between the Thickness and σ
                                                 rows so their TextBoxes start at the same x, even though
                                                 "Thickness:" and "σ (S/m):" are different lengths. -->
                                            <!-- Hidden on a via row. A via has no z band of its own —
                                                 PlanarExtractor.BuildStack skips every StackupKind.Via
                                                 entry and the barrel's length comes from the Spans pair
                                                 below, so this field is read by nothing. Shown, it read
                                                 as a real dimension left at 0 and invited a wrong answer
                                                 (user-reported, 2026-08-30: "I am not sure what the via
                                                 thickness should be"). The Spans row answers it. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsVia}">
                                                <TextBlock Text="Thickness:" Width="70" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Classes="cell compact" Width="60" Tag="Thickness"
                                                         Classes.needsvalue="{Binding ThicknessNeedsValue}"
                                                         ToolTip.Tip="{Binding ThicknessNeeds}"
                                                         Text="{Binding StagedThicknessText}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBlock Text="{Binding ThicknessUnitSuffix}" FontSize="10"
                                                           VerticalAlignment="Center" Opacity="0.6"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                <TextBlock Text="{Binding ThicknessError}" FontSize="10"
                                                           IsVisible="{Binding HasThicknessError}"
                                                           Foreground="{DynamicResource CrfWarningBrush}"/>
                                            </StackPanel>

                                            <!-- GI3 R-gi3-1/R-gi3-3. This field and the plated via's Wall
                                                 below were the only two on this panel with no tooltip and
                                                 no preset — and they are exactly the two a board import
                                                 leaves for someone to fill in. The combo is a SHORTCUT:
                                                 it writes into the text box, which stays freely typeable
                                                 and remains the source of truth, and a value matching no
                                                 metal reads back as "Custom". -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConductor}">
                                                <TextBlock Text="σ (S/m):" Width="70" FontSize="11" VerticalAlignment="Center"
                                                           ToolTip.Tip="Conductor conductivity at 20 °C, in siemens per metre. It sets conductor loss and skin depth — how deep the current actually flows at frequency, and therefore how much of this metal is doing any work. A conductor with a conductivity of zero or less is REFUSED by the EM path rather than solved, which is what an imported board hits if this is left blank."/>
                                                <TextBox Classes="cell compact" Width="60" Tag="Sigma"
                                                         Classes.needsvalue="{Binding SigmaNeedsValue}"
                                                         Text="{Binding StagedSigmaSm}"
                                                         ToolTip.Tip="Conductor conductivity at 20 °C, in siemens per metre. It sets conductor loss and skin depth — how deep the current actually flows at frequency, and therefore how much of this metal is doing any work. A conductor with a conductivity of zero or less is REFUSED by the EM path rather than solved, which is what an imported board hits if this is left blank."
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <ComboBox Classes="cell" MinWidth="96"
                                                          ItemsSource="{Binding ConductorMaterialChoices}"
                                                          SelectedItem="{Binding SelectedConductorMaterial, Mode=TwoWay}"
                                                          ToolTip.Tip="Fills the conductivity field with a metal's bulk value at 20 °C — copper 5.8e7, silver 6.3e7, gold 4.1e7, aluminium 3.77e7, nickel 1.43e7 S/m. A shortcut only: the field beside it stays typeable and is what gets saved, and a value matching none of these shows as Custom. Real plated or alloyed metal runs below the handbook figure, so lower it if your process states one."/>
                                                <CheckBox Content="{x:Static lay:StackupCardText.GroundReference}" FontSize="11" Margin="8,0,0,0"
                                                          IsChecked="{Binding IsGroundReference}"
                                                          ToolTip.Tip="{x:Static lay:StackupCardText.GroundReferenceTip}"/>
                                            </StackPanel>

                                            <!-- MIM-6. The full-wave planar kernel solves a conductor
                                                 as a zero-thickness sheet, and this says which surface
                                                 of its own band that sheet sits on; the band's
                                                 thickness is absorbed into the dielectric on the other
                                                 side. Bottom is the default and what every technology
                                                 authored before this field meant. Top is what a
                                                 capacitor's LOWER plate wants, so the modelled plate
                                                 gap is the capacitor dielectric alone. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsConductor}">
                                                <!-- Owner, 2026-09-09: this row used to read "EM sheet
                                                     at: Bottom / Top", which cannot be answered without
                                                     knowing what a conductor's z BAND is — a word the
                                                     control never defined and a reader has no reason to
                                                     know. The stored value is still a surface (see
                                                     ConductorSheetSurface, and a .ctech is byte-identical);
                                                     what the label and the rows now name is the CONSEQUENCE,
                                                     which is the half a process author is actually choosing
                                                     between. SheetAtLabelConverter is display-only.

                                                     Wider than the 70 px the rows above use, on the
                                                     "Patterned with:" precedent two cards down: a label
                                                     that says what the control does is worth one row's
                                                     alignment.

                                                     The tooltip is on the LABEL as well as on the combo —
                                                     the words are what a reader hovers when they do not
                                                     know what the control is for, and hovering the control
                                                     assumes you already do. Same text, so the two cannot
                                                     drift into saying different things. -->
                                                <TextBlock Text="{x:Static lay:StackupCardText.SheetAt}" Width="140" FontSize="11"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           ToolTip.Tip="{x:Static lay:StackupCardText.SheetAtTip}"/>
                                                <ComboBox Classes="cell" MinWidth="160"
                                                          ItemsSource="{Binding SheetAtChoices}"
                                                          SelectedItem="{Binding SelectedSheetAt, Mode=TwoWay}"
                                                          ToolTip.Tip="{x:Static lay:StackupCardText.SheetAtTip}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource SheetAtLabel}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsDielectric}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="εr:" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBox Classes="cell compact" Width="60" Tag="Epsr" Text="{Binding StagedEpsr}"
                                                             Classes.needsvalue="{Binding EpsrNeedsValue}"
                                                             ToolTip.Tip="{Binding EpsrNeeds}"
                                                             LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="tanδ:" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBox Classes="cell compact" Width="70" Tag="TanD" Text="{Binding StagedTanD}"
                                                             Classes.needsvalue="{Binding TanDNeedsValue}"
                                                             ToolTip.Tip="{Binding TanDNeeds}"
                                                             LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="µr:" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBox Classes="cell compact" Width="60" Tag="Mur" Text="{Binding StagedMur}"
                                                             Classes.needsvalue="{Binding MurNeedsValue}"
                                                             ToolTip.Tip="{Binding MurNeeds}"
                                                             LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- MIM-7. A thin-film capacitor's dielectric is not a
                                                 continuous layer of the sandwich: it is deposited
                                                 under its plate and etched away everywhere else.
                                                 Naming that plate here makes this dielectric enter
                                                 an EM run's medium only when the plate is one of
                                                 that run's analysis levels; every other run sees
                                                 air in its place, so one technology can carry a
                                                 capacitor module and still solve ordinary
                                                 interconnect unchanged. "(none)" is a continuous
                                                 dielectric and is what every other entry means.

                                                 MIM-11. The list is BOTH namespaces the tie
                                                 resolves in: the stackup's conductors first, then
                                                 the technology's drawing layers - a MASK, which on
                                                 a real process is the thing that actually defines
                                                 where the film is. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsDielectric}">
                                                <TextBlock Text="{x:Static lay:StackupCardText.PresentWith}" Width="86" FontSize="11"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           ToolTip.Tip="{x:Static lay:StackupCardText.PresentWithTip}"/>
                                                <ComboBox Classes="cell" MinWidth="110"
                                                          ItemsSource="{Binding PresentWithChoices}"
                                                          SelectedItem="{Binding SelectedPresentWith, Mode=TwoWay}"
                                                          ToolTip.Tip="{x:Static lay:StackupCardText.PresentWithTip}"/>
                                            </StackPanel>

                                            <!-- Via span (R-via-3). Shown ONLY for a via, and shown at
                                                 all because the stackup list is in LIST order, which a
                                                 via is deliberately outside of (it has no z band of its
                                                 own). Without this, "which two conductors does this via
                                                 join?" is unanswerable from the editor even though the
                                                 import resolved it. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsVia}">
                                                <TextBlock Text="Spans:" Width="70" FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Classes="cell" MinWidth="110"
                                                          ItemsSource="{Binding SpanChoices}"
                                                          SelectedItem="{Binding SelectedSpanFrom, Mode=TwoWay}"/>
                                                <TextBlock Text="→" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                                                <ComboBox Classes="cell" MinWidth="110"
                                                          ItemsSource="{Binding SpanChoices}"
                                                          SelectedItem="{Binding SelectedSpanTo, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsVia}">
                                                <TextBlock Text="Fill:" Width="70" FontSize="11" VerticalAlignment="Center"/>
                                                <CheckBox Content="{x:Static lay:StackupCardText.Plated}" FontSize="11"
                                                          IsChecked="{Binding IsPlated, Mode=TwoWay}"
                                                          ToolTip.Tip="{x:Static lay:StackupCardText.PlatedTip}"/>
                                                <ComboBox Classes="cell" MinWidth="90"
                                                          IsVisible="{Binding IsPlated}"
                                                          ItemsSource="{Binding FillChoices}"
                                                          SelectedItem="{Binding SelectedFill, Mode=TwoWay}"/>
                                                <!-- GI3 R-gi3-5. The question this field is actually asked
                                                     is "which wall thickness should I choose?", and it has
                                                     a good answer that was already written down in
                                                     TechModel.cs's own ViaFillKind documentation and
                                                     nowhere the user could see it. -->
                                                <TextBlock Text="Wall:" FontSize="11" VerticalAlignment="Center"
                                                           Margin="8,0,0,0" IsVisible="{Binding IsPlatedVia}"
                                                           ToolTip.Tip="Plated wall thickness — the metal deposited on the barrel wall, NOT the hole radius. 20-25 µm is typical for a plated through-hole board and is what circuitRF's own shipped technologies use. For RF above roughly 1 GHz this barely matters: a wall a few µm thick is already many skin depths, so a solver may treat a plated barrel and a solid one identically. For thermal it matters directly — it multiplies the conductive cross-section, which is exactly what a thermal via array is sized on."/>
                                                <TextBox Classes="cell compact" Width="60" Tag="WallThickness"
                                                         IsVisible="{Binding IsPlatedVia}"
                                                         Classes.needsvalue="{Binding WallThicknessNeedsValue}"
                                                         Text="{Binding StagedWallThickness}"
                                                         ToolTip.Tip="Plated wall thickness — the metal deposited on the barrel wall, NOT the hole radius. 20-25 µm is typical for a plated through-hole board and is what circuitRF's own shipped technologies use. For RF above roughly 1 GHz this barely matters: a wall a few µm thick is already many skin depths, so a solver may treat a plated barrel and a solid one identically. For thermal it matters directly — it multiplies the conductive cross-section, which is exactly what a thermal via array is sized on."
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBlock Text="{Binding ThicknessUnitSuffix}" FontSize="10"
                                                           VerticalAlignment="Center" Opacity="0.6"
                                                           IsVisible="{Binding IsPlatedVia}"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                            </StackPanel>

                                            <!-- ── Drawing layers ───────────────────────────────────
                                                 TWO controls, because §10.4 states two different
                                                 cardinalities and one control cannot honestly serve
                                                 both. A via binds AT MOST ONE, so it gets a plain
                                                 ComboBox with an explicit "(none)". A DIELECTRIC gets
                                                 no picker at all (ShowsDrawingLayerPicker) — the
                                                 binding never placed the slab, and the refusal it
                                                 existed to dodge is fixed at its source. A conductor
                                                 binds one or more, so it keeps a checkbox list — but a
                                                 FILTERED, bounded, virtualized one: a real process
                                                 carries several hundred drawing layers, and the previous
                                                 WrapPanel of one checkbox per layer neither fitted the
                                                 pane nor could be found in. -->
                                            <StackPanel Orientation="Horizontal" Spacing="4"
                                                        IsVisible="{Binding ShowsDrawingLayerPicker}">
                                                <TextBlock Text="{Binding DrawingLayersLabel}" Width="70"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <ComboBox Classes="cell" MinWidth="220"
                                                          ItemsSource="{Binding DrawingLayerChoices}"
                                                          SelectedItem="{Binding SelectedDrawingLayerChoice, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <StackPanel Spacing="3" IsVisible="{Binding AllowMultipleDrawingLayers}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding DrawingLayersLabel}" Width="70"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DrawingLayerSummary}" FontSize="11"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"
                                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="70,0,0,0">
                                                    <TextBox Classes="cell" Width="160"
                                                             PlaceholderText="Filter layers…"
                                                             Text="{Binding DrawingLayerFilter, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <!-- THREE ACROSS, FOUR DOWN, AND STILL VIRTUALIZED.
                                                     The items are chunked into rows of three by the
                                                     row VM and this list scrolls the ROWS, because
                                                     the obvious spelling — a UniformGrid items panel
                                                     over the flat item list — is not a virtualizing
                                                     panel and would realize all 377 of an imported
                                                     process's drawing layers per conductor card. See
                                                     FilteredDrawingLayerRows. -->
                                                <ListBox Classes="rows layerpicker" Margin="70,0,0,0"
                                                         MaxHeight="{x:Static lay:TechEditorMetrics.DrawingLayerPickerMaxHeight}"
                                                         SelectionMode="Single"
                                                         ItemsSource="{Binding FilteredDrawingLayerRows}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="lay:DrawingLayerCheckRow">
                                                            <UniformGrid Columns="{x:Static lay:TechEditorMetrics.DrawingLayerPickerColumns}">
                                                                <CheckBox Content="{Binding A.Name}" IsChecked="{Binding A.IsChecked}"
                                                                          FontSize="11" Margin="0,0,8,0"
                                                                          ToolTip.Tip="{Binding A.Name}"/>
                                                                <CheckBox Content="{Binding B.Name}" IsChecked="{Binding B.IsChecked}"
                                                                          IsVisible="{Binding HasB}"
                                                                          FontSize="11" Margin="0,0,8,0"
                                                                          ToolTip.Tip="{Binding B.Name}"/>
                                                                <CheckBox Content="{Binding C.Name}" IsChecked="{Binding C.IsChecked}"
                                                                          IsVisible="{Binding HasC}"
                                                                          FontSize="11" Margin="0,0,8,0"
                                                                          ToolTip.Tip="{Binding C.Name}"/>
                                                            </UniformGrid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                  </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- DRC rules ──────────────────────────────────────────────────── -->
            <TabItem Header="{Binding ViewModel.DrcTabHeader}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="6,4">
                        <Button Content="＋ Add Rule" Command="{Binding ViewModel.AddDrcRuleCommand}" FontSize="11" Padding="8,3"/>
                    </StackPanel>

                    <!-- Same fixed-column convention as the Layers tab, and for the same reason:
                         the list below is virtualized, and a SharedSizeGroup is the max over the
                         participants actually measured, so shared widths would shift while scrolling. -->
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="4,4,4,2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Classes="filter" x:Name="DrcFilterBox"
                                         Text="{Binding ViewModel.DrcFilter, Mode=TwoWay}"
                                         PlaceholderText="Filter by rule name..."
                                         ToolTip.Tip="Shows only rules whose name contains this text (case-insensitive)."/>
                                <TextBlock Grid.Column="1" Classes="filtercount" Text="{Binding ViewModel.DrcFilterSummary}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="4,4,4,2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="colhdr" Text="Name"/>
                            <TextBlock Grid.Column="1" Classes="colhdr" Text="Kind"     HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Classes="colhdr" Text="Layer"    HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Classes="colhdr" Text="Value"    HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Classes="colhdr" Text="Severity" HorizontalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="2" Classes="rows" x:Name="DrcRulesList" ItemsSource="{Binding ViewModel.FilteredDrcRules}"
                                 Margin="4,0,4,4" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="lay:DrcRuleRowViewModel">
                                        <StackPanel Margin="0,3" Spacing="2">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="120"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Classes="cell" Tag="Name" HorizontalAlignment="Stretch"
                                                     Text="{Binding StagedName}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                            <ComboBox Grid.Column="1" Classes="cell" Width="100" Tag="Kind"
                                                      ItemsSource="{x:Static lay:DrcRuleRowViewModel.AllKinds}"
                                                      SelectedItem="{Binding StagedKind}"
                                                      SelectionChanged="OnComboSelectionChanged"/>
                                            <ComboBox Grid.Column="2" Classes="cell" Width="140" Tag="Layer"
                                                      ItemsSource="{Binding LayerOptions}"
                                                      SelectedItem="{Binding StagedLayer}"
                                                      DisplayMemberBinding="{Binding Label}"
                                                      SelectionChanged="OnComboSelectionChanged"/>
                                            <StackPanel Grid.Column="3" Spacing="1" IsVisible="{Binding ShowValue}">
                                                <TextBox Classes="cell compact" Width="90" Tag="Value"
                                                         ToolTip.Tip="{Binding ValueLabel}"
                                                         Text="{Binding StagedValueText}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBlock Text="{Binding ValueError}" FontSize="9"
                                                           IsVisible="{Binding HasValueError}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource CrfWarningBrush}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="4" Classes="cell" Width="80" Tag="Severity"
                                                      ItemsSource="{x:Static lay:TechEditorViewModel.DrcSeverities}"
                                                      SelectedItem="{Binding StagedSeverity}"
                                                      SelectionChanged="OnComboSelectionChanged"/>
                                            <Button Grid.Column="5" Padding="4,2" FontSize="10"
                                                    Command="{Binding RemoveCommand}">
                                                <mi:MaterialIcon Kind="Close" Width="11" Height="11"/>
                                            </Button>
                                        </Grid>

                                        <!-- v2: the layer EXPRESSION a rule measures, plus the
                                             fields only some kinds carry. Laid out on a second line
                                             rather than widening the grid: an expression is long,
                                             and squeezing it into a column would make the common
                                             case (a bare layer, no expression) unreadable. -->
                                        <Grid ColumnSpacing="4" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Classes="label" Text="Region:"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Classes="cell" Tag="RegionA"
                                                     HorizontalAlignment="Stretch"
                                                     PlaceholderText="this rule&apos;s own layer"
                                                     Text="{Binding StagedRegionA}"
                                                     ToolTip.Tip="{x:Static lay:DrcRuleRowViewModel.RegionHint}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>

                                            <TextBlock Grid.Column="2" Classes="label" Text="and:"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding ShowRegionB}"/>
                                            <TextBox Grid.Column="3" Classes="cell" Tag="RegionB"
                                                     HorizontalAlignment="Stretch"
                                                     IsVisible="{Binding ShowRegionB}"
                                                     PlaceholderText="second region, e.g. 10/0"
                                                     Text="{Binding StagedRegionB}"
                                                     ToolTip.Tip="{x:Static lay:DrcRuleRowViewModel.RegionHint}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                        </Grid>

                                        <TextBlock Text="{Binding RegionAError}" FontSize="9" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasRegionAError}"
                                                   Foreground="{DynamicResource CrfWarningBrush}"/>
                                        <TextBlock Text="{Binding RegionBError}" FontSize="9" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasRegionBError}"
                                                   Foreground="{DynamicResource CrfWarningBrush}"/>

                                        <!-- Kind-specific fields. Hidden, not disabled, when they do
                                             not apply — a greyed "second region" on a width rule
                                             invites the question of what it would have meant. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding ShowDensity}">
                                            <TextBlock Classes="label" Text="Window:" VerticalAlignment="Center"/>
                                            <TextBox Classes="cell compact" Width="80" Tag="Window"
                                                     Text="{Binding StagedWindowText}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                            <TextBlock Classes="label" Text="Min:" VerticalAlignment="Center"/>
                                            <TextBox Classes="cell" Width="60" Tag="MinRatio"
                                                     PlaceholderText="0..1"
                                                     Text="{Binding StagedMinRatioText}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding ShowMaxRatio}">
                                            <TextBlock Classes="label" Text="Max ratio:" VerticalAlignment="Center"/>
                                            <TextBox Classes="cell compact" Width="70" Tag="MaxRatio"
                                                     Text="{Binding StagedMaxRatioText}"
                                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    IsVisible="{Binding ShowNetScope}">
                                            <TextBlock Classes="label" Text="Applies to:" VerticalAlignment="Center"/>
                                            <ComboBox Classes="cell" Width="130" Tag="NetScope"
                                                      ItemsSource="{x:Static lay:DrcRuleRowViewModel.AllNetScopes}"
                                                      SelectedItem="{Binding StagedNetScope}"
                                                      SelectionChanged="OnComboSelectionChanged"/>
                                        </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Interchange mappings (docs/design/layout-view.md §2.4 R7a) ───── -->
            <TabItem Header="{Binding ViewModel.InterchangeTabHeader}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="6,6,6,0" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="How each layer is named in an exported file. GDSII layer/datatype alias — blank uses the layer's own Layer/Datatype above. DXF layer name — used on export, and matched on import so an incoming DXF layer lands here. Gerber suffix — the exported file is named &lt;cell&gt;.&lt;suffix&gt;; blank falls back to a synthetic one. Gerber X2 file function — written into the file and its .gbrjob so a fab can identify it. All four are live; a duplicate suffix or name is reported below."/>

                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">
                        <Grid Grid.Row="0" Margin="4,4,4,2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="110"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <!-- Its own filter, not the Layers tab's: the two tabs list the same
                                     layers for different jobs, and one narrowing the other silently
                                     would be a surprise rather than a convenience. -->
                                <TextBox Grid.Column="0" Classes="filter" x:Name="InterchangeFilterBox"
                                         Text="{Binding ViewModel.InterchangeFilter, Mode=TwoWay}"
                                         PlaceholderText="Filter by layer name..."
                                         ToolTip.Tip="Shows only layers whose name contains this text (case-insensitive)."/>
                                <TextBlock Grid.Column="1" Classes="filtercount" Text="{Binding ViewModel.InterchangeFilterSummary}"/>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="4,4,4,2" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="110"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Classes="colhdr" Text="Name"/>
                            <TextBlock Grid.Column="1" Classes="colhdr" Text="GDSII Layer"    HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Classes="colhdr" Text="GDSII Datatype" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Classes="colhdr" Text="DXF Layer Name" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Classes="colhdr" Text="Gerber Suffix"  HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Classes="colhdr" Text="Gerber X2 Function" HorizontalAlignment="Center"/>
                        </Grid>

                        <ListBox Grid.Row="2" Classes="rows" x:Name="InterchangeList" ItemsSource="{Binding ViewModel.FilteredInterchangeLayers}"
                                 Margin="4,0,4,4" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="lay:LayerRowViewModel">
                                        <Border BorderBrush="{DynamicResource CrfTileBorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding StagedName}" VerticalAlignment="Center" FontSize="11"/>
                                                <TextBox Grid.Column="1" Classes="cell" Width="34" HorizontalAlignment="Center" Tag="GdsiiLayer"
                                                         Text="{Binding StagedGdsiiLayer}" PlaceholderText="{Binding StagedLayerNumber}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBox Grid.Column="2" Classes="cell" Width="34" HorizontalAlignment="Center" Tag="GdsiiDatatype"
                                                         Text="{Binding StagedGdsiiDatatype}" PlaceholderText="{Binding StagedDatatype}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBox Grid.Column="3" Classes="cell" Width="110" Tag="DxfLayerName"
                                                         Text="{Binding StagedDxfLayerName}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBox Grid.Column="4" Classes="cell" Width="90" Tag="GerberSuffix"
                                                         Text="{Binding StagedGerberSuffix}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                                <TextBox Grid.Column="5" Classes="cell" Width="110" Tag="GerberFileFunction"
                                                         Text="{Binding StagedGerberFileFunction}"
                                                         LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </TabItem>

        </TabControl>

    </DockPanel>

</UserControl>
