<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:em="using:CircuitRF.Ui.Layout.Em"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:shared="using:CircuitRF.Ui.Views.Shared"
             xmlns:ctl="using:CircuitRF.Ui.Controls"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Layout.EmSetupEditorView"
             x:DataType="em:EmSetupDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <!-- Owner report, 2026-08-12: "the .cem is not saved by the keyboard shortcut when the document
         is detached from the dock (it does save when docked)."

         Ctrl/Meta+S was bound ONLY on WorkspaceWindow. A torn-off document lives in its own
         CrfHostWindow, and the only gestures WorkspaceViewModel.WireWindowUndo injects into one are
         undo/redo — so a detached .cem had no Save binding at all. (An InputGesture on a menu item is
         display text, never a binding, so the menu could not supply it either.)

         Bound HERE, on the control, which is the same thing DataDisplayView does and works in both
         hosts: while docked the window-level Ctrl+S is processed first and routes through
         SaveAllDocumentsCommand, whose SingleDoc branch already dispatches an EmSetupDocument to this
         same SaveCommand; while floating there is no window binding, so this one is what fires. Bound
         to the document's OWN command rather than SaveAllDocuments so a floating window never has to
         resolve "which document is active" to save the one it is showing. -->
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding ViewModel.SaveCommand}"/>
        <KeyBinding Gesture="Meta+S" Command="{Binding ViewModel.SaveCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- BOTH text elements, because a Selector names a TYPE and SelectableTextBlock is not a
             TextBlock. The layout reference became selectable on 2026-09-15 and silently stopped
             matching this rule: it kept its Classes="colhdr" and rendered at the control default —
             12 px, full opacity, beside 10 px at 0.6 on every label around it. A class that is
             applied and does nothing is worse than one that was forgotten, because the markup says
             it is styled. -->
        <Style Selector="TextBlock.colhdr">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="SelectableTextBlock.colhdr">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBlock.sect">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="TextBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 4,2 and not the TextBox's 4,3: a ComboBox lays its selected-item text out inside the
             padding box and then CENTRES it, so an odd vertical padding leaves the line a rounded
             half-pixel off and the combos here disagreed with each other by 1 px. The even one puts
             every combobox in this panel — these, and the ones on the application default that
             Styles/CircuitRfStyles.axaml now pads 12,2,0,2 — on the same line. The horizontal 4 is
             this panel's own: these are narrow unit pickers, and the global 12 would crowd them. -->
        <Style Selector="ComboBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Owner request, 2026-08-09: "some of the text fields are using the full width of the
             window... I would think settings would never need more than 4 or 5 characters." A
             stretched box invites a sentence; a short one says what the field is for. Applied to
             every numeric setting (Z0, both mesh blocks); the frequency coefficients keep their own
             star sizing because they sit beside a unit combo that has to stay adjacent. -->
        <Style Selector="TextBox.num">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="86"/>
        </Style>

        <!-- Owner request: "need to use Group box UI or Panel UI type elements to create simple
             groupings for the users eyes." One card per concern, so the eye can find Frequency and
             Mesh without reading every label between them. -->
        <Style Selector="Border.group">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumLowColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.grouphdr">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Owner request, 2026-08-11: the two "…" pickers in the header (Change Layout, and the
             output file) must be the SAME size. One style rather than two hand-matched sets of
             Width/Height/Padding, so they cannot drift apart the next time one is touched. -->
        <Style Selector="Button.ellipsis">
            <Setter Property="Content" Value="…"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- brief-file-menu-restructure.md §4A: File menu, visible only when torn off. The EM Setup
             view was the ONE document view that never embedded it (found while fixing the detached-
             Ctrl+S report above), so a torn-off .cem had no File menu at all on Windows/Linux — no
             Save, no Close Window, nothing. macOS was unaffected either way: there the shared
             NativeMenu is attached per-window by WorkspaceViewModel.AttachSharedNativeMenuIfMacOS,
             which is document-type-agnostic. -->
        <shared:TornOffFileMenuView DockPanel.Dock="Top"/>

        <!-- ── Header: identity + D2's two buttons ──────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <!-- Owner report, 2026-08-09: "the Mesh button collides with the Browse button at small
                 widths." It was ONE Grid, `*,Auto,Auto,…`: the identity block sat in the star column
                 and every button was Auto, so once the star column hit its own content's MINIMUM it
                 stopped yielding and the buttons ran into it. A WrapPanel fixed that by reflowing.

                 Back to a Grid (owner request, 2026-08-12: the buttons belong on the Output-file row,
                 hugging the right edge — a WrapPanel can do neither, since it has no notion of "the
                 far side" and stacks its items top-aligned in source order). The 2026-08-09 collision
                 does NOT come back, because what caused it is gone: the star column's minimum used to
                 be its content's, since the identity row was a horizontal StackPanel and a StackPanel
                 hands its children UNBOUNDED width along its own axis. That row is a Grid now, with
                 the output-file TextBox in the star column — so the squeeze lands on the TextBox
                 (down to MinWidth 80, then it clips inside its own box) instead of on the far edge of
                 a StackPanel that had already decided how wide it was going to be. -->
            <!-- Owner report, 2026-09-09 (the second half of the same day's header work): at a
                 small enough width the Mesh/Simulate cluster renders on top of the Output file box.
                 A Grid gets the SHRINK ORDER right and the POSITION wrong — see
                 ShrinkThenOverflowPanel, which states both halves and why neither a Grid nor a
                 DockPanel can do it alone, and why shrinking the fields instead does not answer it.
                 Two children, content first, buttons second. -->
            <ctl:ShrinkThenOverflowPanel>
                <!-- TWO rows, not three (owner request, 2026-08-11). The name and the output file
                     share a line; the layout reference gets the second one. -->
                <!-- MinWidth is this block's own FLOOR, and ShrinkThenOverflowPanel reads it —
                     Avalonia clamps DesiredSize to whatever a control was offered, so a parent cannot
                     discover it (that class's own note has the measurement). It is the Output-file
                     row's un-shrinkable width with both names elided away: the "Output file:" label,
                     the 120 px box, the "…" picker and their three 6 px gaps. Measured at 282 px
                     against the bundled Inter face, which is why it does not move with the user's
                     system font. It is a floor, so drift is graceful in both directions — too low
                     lets a little overlap back at extreme widths, too high sends the buttons off the
                     edge slightly early. -->
                <StackPanel Orientation="Vertical" Margin="0,0,14,0" MinWidth="282">
                    <!-- Owner report, 2026-08-14: "the Output file '…' picker button is hugging the
                         Mesh button; it needs to hug its related text box (with some padding)."
                         The picker sat in a trailing Auto column with the TextBox in the STAR column,
                         and the TextBox is HorizontalAlignment=Left with MaxWidth 420 — so every pixel
                         of surplus width opened up BETWEEN the box and its own button, parking the
                         button against the Mesh/Simulate cluster it has nothing to do with.

                         Fixed by moving the star to a TRAILING SPACER column: the label, the box and
                         its picker are now consecutive Auto columns, so the picker is always exactly
                         one ColumnSpacing from the box it belongs to, and the surplus collects on the
                         far side where it belongs. **The 2026-08-09 collision does not come back** —
                         what protects against it is that each element is still its OWN grid column
                         (never a StackPanel, which hands children unbounded width along its axis), so
                         under squeeze the empty spacer yields first and then the TextBox compresses to
                         its MinWidth and clips inside its own box, exactly as before. -->
                    <!-- Owner report, 2026-09-09: with a long name and a narrow .cem window, the
                         Mesh/Simulate cluster renders on top of the name. The name was in an AUTO
                         column, and an Auto column never yields: it takes its content's full desired
                         width whatever is left, so the identity block simply overflowed its own cell
                         and the buttons — in the outer grid's Auto column, laid out independently —
                         drew over it.

                         The name is in a STAR column now, and it trims. A star column is measured
                         against what is actually left, so the TextBlock reports the smaller of its
                         natural width and that, and ellipsizes when it has to.

                         `HorizontalAlignment="Left"` on this Grid is what keeps the star column from
                         becoming a wide-width regression: left-aligned, the Grid arranges at its own
                         DESIRED width rather than filling the cell, so the one star column settles at
                         the name's natural width and no gap opens between the name and "Output
                         file:". That is also why the trailing spacer column this row used to carry is
                         gone — it existed only to collect surplus, and there is none to collect. The
                         2026-08-14 arrangement it was added for is unaffected: the picker is still the
                         column immediately after the TextBox, so it still hugs it. -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6"
                          HorizontalAlignment="Left">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ViewModel.Working.Name}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ViewModel.Working.Name}"/>

                        <!-- Where the s-parameters land (owner request, 2026-08-09). Modelled on the
                             Analyses panel's own "Results file:" field: staged text, committed on
                             LostFocus/Enter, and BLANK MEANS THE DEFAULT — shown as the placeholder
                             rather than pre-filled, so the default keeps tracking the layout's name
                             instead of freezing into a literal the moment anything is renamed. -->
                        <TextBlock Grid.Column="1"
                                   Text="Output file:" Classes="colhdr" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" Name="SnpOutputPathBox"
                                 Text="{Binding ViewModel.SnpOutputPathText}"
                                 PlaceholderText="{Binding ViewModel.SnpOutputPlaceholder}"
                                 FontSize="11" Padding="4,2"
                                 MinWidth="20" MaxWidth="210" Width="120"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="Where the s-parameters are written. Blank uses the layout's own name with an .sNp suffix, in the workspace's results folder. A relative path is taken from there; an absolute path is used as given. The .sNp suffix is added from the port count, so you do not need to type it."/>
                        <Button Grid.Column="3" Name="BrowseSnpOutputButton" Classes="ellipsis" Content="…"
                                ToolTip.Tip="Pick where the s-parameters are written."/>
                    </Grid>

                    <!-- Which .clay this setup is FOR, with the way to change it right beside it
                         (owner request, 2026-08-09). A .cem references its layout by path and reads
                         the geometry at run time, so the reference is a first-class, editable field
                         rather than a fact fixed at creation. Labelled now that it has its own row.

                         This row's height is the "…" button's height (every other child is shorter).

                         Same 2026-09-09 report, and the other half of it: this row was a horizontal
                         StackPanel, which hands its children UNBOUNDED width along its own axis — so
                         the reference's TextTrimming could never engage below its MaxWidth however
                         narrow the window got, and the row ran under the buttons exactly as the name
                         above did. A Grid, left-aligned, with the reference in the star column: same
                         shape as the row above, same reason. MaxWidth stays as the upper cap it
                         always was; the star column is what supplies the lower one. -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Margin="0,3,0,0"
                          HorizontalAlignment="Left">
                        <TextBlock Grid.Column="0"
                                   Text="Layout:" Classes="colhdr" VerticalAlignment="Center"/>
                        <!-- SELECTABLE, and with a way into the layout itself (owner request,
                             2026-09-15). Selectable for the reason every other reported string in
                             this panel is: this row is the reference, and a reference that cannot be
                             copied cannot be pasted into a bug report. The context menu is the other
                             half — the row NAMES a document, and naming one without being able to
                             open it is the same gap the EM button had. Both items are gated on the
                             reference having RESOLVED: "Open" on a path that resolves to nothing is
                             an item that can only fail. -->
                        <SelectableTextBlock Grid.Column="1" Name="LayoutRefText"
                                   Text="{Binding ViewModel.LayoutStatus}" Classes="colhdr"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   ToolTip.Tip="{Binding ViewModel.LayoutStatus}">
                            <SelectableTextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open…"
                                              Command="{Binding ViewModel.OpenLayoutCommand}"
                                              IsEnabled="{Binding ViewModel.CanOpenLayout}"
                                              ToolTip.Tip="Show this layout — focusing it if it is already open, opening it in the workspace otherwise."/>
                                    <MenuItem Header="Open in New Window…"
                                              Command="{Binding ViewModel.OpenLayoutInNewWindowCommand}"
                                              IsEnabled="{Binding ViewModel.CanOpenLayout}"
                                              ToolTip.Tip="Show this layout in a window of its own. A layout that is already in its own window is brought forward rather than moved again."/>
                                </ContextMenu>
                            </SelectableTextBlock.ContextMenu>
                        </SelectableTextBlock>
                        <Button Grid.Column="2" Name="ChangeLayoutButton" Classes="ellipsis" Content="…"
                                ToolTip.Tip="Point this EM setup at a different .clay. The cross-section, ports and mesh all re-derive against the new artwork, and the change is undoable."/>
                    </Grid>

                    <!-- The part of the layout this setup solves (round-7 designer feedback). Stored in
                         the .cem, drawn on the layout's own canvas, and the same Grid shape as the
                         Layout row above for the same reason. Selectable, like every reported string
                         here, so the coordinates can be copied. -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,3,0,0"
                          HorizontalAlignment="Left">
                        <TextBlock Grid.Column="0"
                                   Text="Solve region:" Classes="colhdr" VerticalAlignment="Center"/>
                        <SelectableTextBlock Grid.Column="1" Name="SolveRegionText"
                                   Text="{Binding ViewModel.SolveRegionText}" Classes="colhdr"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   ToolTip.Tip="Only the geometry inside this box is meshed and solved. Anything crossing its edge is cut there; a via is kept or left out by where its centre is. Every port must lie inside it."/>
                        <Button Grid.Column="2" Name="DrawSolveRegionButton" Padding="6,1" FontSize="11"
                                Content="Draw on layout…"
                                Command="{Binding ViewModel.DrawSolveRegionCommand}"
                                ToolTip.Tip="Open this setup's layout and drag a box around the part to solve. Escape cancels. The layout itself is not changed."/>
                        <Button Grid.Column="3" Name="ClearSolveRegionButton" Padding="6,1" FontSize="11"
                                Content="Clear"
                                Command="{Binding ViewModel.ClearSolveRegionCommand}"
                                IsVisible="{Binding ViewModel.HasSolveRegion}"
                                ToolTip.Tip="Solve the whole layout again."/>
                    </Grid>
                </StackPanel>

                <!-- The button cluster is ONE Grid cell, so it moves as a unit and the buttons never
                     separate from each other.

                     TOP-aligned and in the Auto column (owner request, 2026-08-12: "move these
                     buttons up one row so they are on the same row as the Output file, hugging the
                     right side"). Top rather than a margin: the identity block's FIRST row is the
                     output-file row, so aligning to the top of the block lands on it with no number
                     to go stale the next time a font size or a row changes. It replaces the
                     2026-08-11 bottom-alignment, which used the same trick against the block's LAST
                     row to line up with Change Layout. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">

                <!-- D2: Mesh computes the mesh ONLY and never solves. -->
                <!-- One Mesh button, and it means "mesh THIS setup" — it dispatches to whichever
                     kernel the registry chose. It used to be bound to the cross-section mesher
                     directly, which returns silently on a full-wave setup (owner report). -->
                <!-- Mesh and its Cancel share one cell, mutually exclusive on IsMeshing — the
                     button that STARTED the work is the one that turns into Cancel. Simulate is
                     disabled meanwhile (CanRun is gated on IsBusy), so the two long operations can
                     never overlap and mesh the same problem twice at once. -->
                <Button Name="MeshButton" Margin="4,0,0,0"
                        IsVisible="{Binding !ViewModel.IsMeshing}"
                        Command="{Binding ViewModel.BuildActiveMeshCommand}"
                        ToolTip.Tip="Compute the mesh only — no solve.">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="GridLarge" Width="14" Height="14"/>
                        <TextBlock Text="Mesh"/>
                    </StackPanel>
                </Button>

                <!-- The label and the enablement follow IsCancelling, not just IsMeshing: a stop
                     lands at the next grid row, so the button has to say the request was taken and
                     stop offering itself a second time. -->
                <Button Name="CancelMeshButton" Margin="4,0,0,0"
                        IsVisible="{Binding ViewModel.IsMeshing}"
                        Command="{Binding ViewModel.CancelMeshCommand}"
                        ToolTip.Tip="Stop meshing. It stops at the next grid row.">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Stop" Width="14" Height="14"/>
                        <TextBlock Text="{Binding ViewModel.CancelButtonText}"/>
                    </StackPanel>
                </Button>

                <!-- R-em-13/R-L1h-3: disabled WITH the live reason visible, never a silent no-op.

                     Simulate and Cancel are two buttons in ONE cell, mutually exclusive on IsRunning
                     (owner request: "perhaps the Simulate button changes to Cancel?"). Two buttons
                     rather than one whose icon and label are bound: MaterialIconKind is an Avalonia
                     type, and nothing under src/Ui/Layout/ may reference one — so the swap lives
                     here, in the view, and the view model stays framework-free. -->
                <Button Name="SimulateButton" Margin="4,0,0,0"
                        IsVisible="{Binding !ViewModel.IsRunning}"
                        Command="{Binding ViewModel.SimulateCommand}"
                        ToolTip.Tip="{Binding ViewModel.BlockingReason}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Play" Width="14" Height="14"/>
                        <TextBlock Text="Simulate"/>
                    </StackPanel>
                </Button>

                <!-- STOP, not Cancel (owner request, 2026-09-11). The button a user reaches for
                     while a sweep is running is the one they press because they have seen enough,
                     and what they mean by it is "finish now and keep what you solved" — which is
                     what Stop does and the opposite of what Cancel does. Cancel is still here, in
                     this button's own context menu, because "this should not have been started" is a
                     real case; it is just the rarer one, and it is the destructive one.

                     Same pending behaviour as the mesh Cancel: once either halt is asked for — here,
                     from the menu, or by right-clicking either of the run's two progress bars in the
                     Messages panel — the button says which one was asked for and goes inert until
                     the run actually ends. -->
                <Button Name="StopSimulateButton" Margin="4,0,0,0"
                        IsVisible="{Binding ViewModel.IsRunning}"
                        Command="{Binding ViewModel.StopSimulateCommand}"
                        ToolTip.Tip="{Binding ViewModel.StopButtonTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Stop" Width="14" Height="14"/>
                        <TextBlock Text="{Binding ViewModel.StopButtonText}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Name="CancelSimulateMenuItem"
                                      Header="Cancel"
                                      Command="{Binding ViewModel.CancelSimulateCommand}"
                                      ToolTip.Tip="Throw the run away. It stops at the next work boundary and writes nothing.">
                                <MenuItem.Icon>
                                    <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button Margin="8,0,0,0" Command="{Binding ViewModel.UndoCommand}"
                        ToolTip.Tip="Undo">
                    <mi:MaterialIcon Kind="UndoVariant" Width="14" Height="14"/>
                </Button>
                <Button Margin="2,0,0,0" Command="{Binding ViewModel.RedoCommand}"
                        ToolTip.Tip="Redo">
                    <mi:MaterialIcon Kind="RedoVariant" Width="14" Height="14"/>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ViewModel.SaveCommand}"
                        Content="Save"/>
                <Button Name="SaveAsButton" Margin="4,0,0,0" Content="Save As…"
                        ToolTip.Tip="Write this setup to a different .cem. The editor then follows the new file — the original is left exactly as it was on disk."/>

                <!-- brief-user-docs-content §7.11: the documentation for this panel, one click away.
                     SUBTLE by request — an icon button in the header beside the other affordances,
                     not a call to action. Same DocLauncher route every other Help button takes, and
                     its destination is listed in DocAnchors.WholePages so the docs build fails if
                     reference/em-setup.html ever stops being emitted. -->
                <Button Name="HelpButton" Margin="8,0,0,0"
                        ToolTip.Tip="Open the EM Setup documentation">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14"/>
                </Button>
                </StackPanel>
            </ctl:ShrinkThenOverflowPanel>
        </Border>

        <!-- ── The blocking reason, shown LIVE (R-em-13) ────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="8,6"
                Background="{DynamicResource CrfWarningBrush}"
                IsVisible="{Binding ViewModel.BlockingReason, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- SELECTABLE (owner request, 2026-09-15): this is where the mesher's unknown-count
                 refusal lands, and it is a paragraph naming measured numbers and the settings that
                 move them. A message a user cannot copy is a message they have to retype into a bug
                 report — and the numbers in it are the whole content. Same change, same reason, for
                 every warning-coloured string in this panel. -->
            <SelectableTextBlock Text="{Binding ViewModel.BlockingReason}" TextWrapping="Wrap" FontSize="11"/>
        </Border>

        <!-- Named so the code-behind can restore its offset across a window activation — see
             EmSetupEditorView.axaml.cs's own note on why focus restoration scrolls it to the top. -->
        <ScrollViewer Name="BodyScroll">
            <StackPanel Margin="10,6,10,14" Spacing="2">

                <!-- ── L8e: which analysis, and why (D2, R-res-1) ─────────────────
                     Automatic first, because D2's rule is conservative and right for nearly every
                     setup: the uniform-line analysis whenever the geometry reduces to a uniform
                     cross-section, full-wave planar otherwise. An explicit choice is NEVER
                     overridden — in either direction — and the reason line below always says which
                     was picked and why.

                     The items render through EmAnalysisKindNameConverter rather than as the enum's
                     own ToString(): "Auto"/"CrossSection"/"Planar" are OUR spellings. The labels the
                     user sees come from EmKernelRegistry.ChoiceLabel, which is also what the reason
                     prose names — so a message saying "set Analysis to X" always names something
                     this dropdown actually offers.

                     TWO COLUMNS, and a real Grid rather than a WrapPanel (owner request,
                     2026-08-11: "the whole point is to make the Analysis group occupy less vertical
                     space"). A WrapPanel only saves height while both blocks happen to fit side by
                     side — in a docked panel it reflowed to one column and the group came out
                     TALLER than before, which is what the first attempt did. A 50/50 Grid always
                     splits, so the group's height is max(left, right) rather than their sum.

                     Left is the CHOICE (what to run, and why that kernel); right is the OUTCOME
                     (what the geometry resolved to, and everything the extraction had to say).
                     ColumnSpacing is the padding between them. -->
                <!-- ── brief-em3d-7 R-em3d7-6b: which solver, and Palace's own section ─────────
                     Every control here writes a .cem field through the same undoable commit as the
                     rest of the panel (R-em-11). A blank Palace box is that field's default, shown
                     as its placeholder, and the defaults are PalaceSettings.Default — the ones the
                     writers read. -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="grouphdr" Text="Solver"/>
                    <ComboBox Classes="cell" MaxWidth="220" HorizontalAlignment="Left"
                              ItemsSource="{x:Static em:EmSetupEditorViewModel.Solver3DChoices}"
                              SelectedItem="{Binding ViewModel.Solver3DChoice}"/>
                    <TextBlock Classes="colhdr" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{Binding ViewModel.Solver3DDescription}"/>
                    <!-- brief-em3d-22 R-em3d22-5b: what the 3D setup solves, and a static problem's
                         terminals. Each row is a .cem Terminals3D entry, written when a box loses focus. -->
                    <StackPanel IsVisible="{Binding ViewModel.Is3DSetup}" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Classes="colhdr" Text="Problem" VerticalAlignment="Center"/>
                        <ComboBox Classes="cell" MinWidth="180"
                                  ItemsSource="{x:Static em:EmSetupEditorViewModel.Problem3DChoices}"
                                  SelectedItem="{Binding ViewModel.Problem3DChoice}"/>
                    </StackPanel>
                    <TextBlock IsVisible="{Binding ViewModel.Is3DSetup}" Classes="colhdr" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{Binding ViewModel.Problem3DDescription}"/>
                    <StackPanel IsVisible="{Binding ViewModel.IsStaticSetup}" Spacing="2" Margin="0,6,0,0">
                        <Grid ColumnDefinitions="110,110,70,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="colhdr" Text="Terminal"/>
                            <TextBlock Grid.Column="1" Classes="colhdr" Text="Net"/>
                            <TextBlock Grid.Column="2" Classes="colhdr" Text="Source port"
                                       IsVisible="{Binding ViewModel.IsMagnetostaticSetup}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ViewModel.TerminalRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="em:Em3dTerminalRow">
                                    <Grid ColumnDefinitions="110,110,70,Auto" ColumnSpacing="6" Margin="0,1">
                                        <TextBox Grid.Column="0" Classes="cell" Tag="Terminals3D" Text="{Binding Name}"
                                                 LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                                 ToolTip.Tip="The terminal's name: the label of its row and column in the matrix."/>
                                        <TextBox Grid.Column="1" Classes="cell" Tag="Terminals3D" Text="{Binding Net}"
                                                 LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                                 ToolTip.Tip="A net of the layout, or a .wBond wire array's name. Every conductor on it is in this terminal."/>
                                        <TextBox Grid.Column="2" Classes="cell" Tag="Terminals3D" Text="{Binding Source}"
                                                 IsVisible="{Binding $parent[ItemsControl].((em:EmSetupDocument)DataContext).ViewModel.IsMagnetostaticSetup, FallbackValue=False}"
                                                 LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                                 ToolTip.Tip="The port (its number) whose sheet drives this terminal's current, in and back."/>
                                        <Button Grid.Column="3" Content="✕" Padding="6,0"
                                                Command="{Binding $parent[ItemsControl].((em:EmSetupDocument)DataContext).ViewModel.RemoveTerminalCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Remove this terminal."/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add terminal" Command="{Binding ViewModel.AddTerminalCommand}"/>
                            <TextBlock Classes="colhdr" Text="Ground net" VerticalAlignment="Center"/>
                            <TextBox Classes="cell" MinWidth="110" Tag="Terminals3D" Text="{Binding ViewModel.Ground3DText}"
                                     PlaceholderText="ground-reference"
                                     LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                     ToolTip.Tip="The net that is the matrix's reference. Blank: the technology's ground-reference conductors, and the floor when it is a ground plane."/>
                        </StackPanel>
                    </StackPanel>
                    <!-- brief-em3d-21 R-em3d21-4: the preset. Its tooltip is the measured trade; the boxes
                         below show the chosen preset's values as their placeholders, and a box that is
                         filled in overrides the preset for that field only. -->
                    <StackPanel IsVisible="{Binding ViewModel.IsPalaceSetup}" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Classes="colhdr" Text="Quality" VerticalAlignment="Center"/>
                        <ComboBox Classes="cell" MinWidth="110"
                                  ItemsSource="{x:Static em:EmSetupEditorViewModel.PalaceQualityChoices}"
                                  SelectedItem="{Binding ViewModel.PalaceQualityChoice}"
                                  ToolTip.Tip="{x:Static em:EmSetupEditorViewModel.PalaceQualityTip}"/>
                    </StackPanel>
                    <Grid IsVisible="{Binding ViewModel.IsPalaceSetup}" Margin="0,6,0,0"
                          ColumnDefinitions="Auto,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="2" HorizontalAlignment="Left">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Largest element (λ)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Tag="Palace.MaxElementWavelengths"
                                   Text="{Binding ViewModel.PalaceMaxElementWavelengthsText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultMaxElementWavelengths}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The largest element in each material, as a fraction of the wavelength in that material at the sweep's top frequency. Only the starting mesh: Palace's adaptive refinement adds elements where its error estimate says the answer needs them."/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="At metal and ports" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Classes="num" Tag="Palace.EdgeRefinement"
                                   Text="{Binding ViewModel.PalaceEdgeRefinementText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultEdgeRefinement}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The element size at conductor surfaces, sheets and port sheets, as a fraction of the smallest largest-element size above."/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Grading" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Classes="num" Tag="Palace.Grading"
                                   Text="{Binding ViewModel.PalaceGradingText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultGrading}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="How fast elements grow away from metal and ports: the ratio between neighbouring element sizes. Greater than 1."/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhdr" Text="Element order" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Classes="num" Tag="Palace.ElementOrder"
                                   Text="{Binding ViewModel.PalaceElementOrderText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultElementOrder}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The finite-element order Palace solves with. 2 is accurate on a coarser mesh; 1 is several times cheaper per element and needs a finer one."/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="colhdr" Text="Refinement tolerance" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Classes="num" Tag="Palace.AdaptiveTol"
                                   Text="{Binding ViewModel.PalaceAdaptiveTolText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultAdaptiveTol}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The relative error at which Palace stops refining the mesh."/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="colhdr" Text="Refinement passes" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" Classes="num" Tag="Palace.AdaptiveMaxIterations"
                                   Text="{Binding ViewModel.PalaceAdaptiveMaxIterationsText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultAdaptiveMaxIterations}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The most adaptive refinement passes. 0 solves the starting mesh only. Each pass costs a solve and grows memory."/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Classes="colhdr" Text="Sweep tolerance" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="6" Grid.Column="1" Classes="num" Tag="Palace.SweepAdaptiveTol"
                                   Text="{Binding ViewModel.PalaceSweepAdaptiveTolText}"
                                   PlaceholderText="{Binding ViewModel.PalaceDefaultSweepAdaptiveTol}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The error tolerance of Palace's adaptive frequency sweep, which solves a few frequencies and interpolates the rest. 0 solves every frequency."/>
                        <SelectableTextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CrfWarningBrush}"
                                   Text="{Binding ViewModel.PalaceFieldError}"
                                   IsVisible="{Binding ViewModel.PalaceFieldError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>
                    <!-- brief-em3d-9 R-em3d9-6: openEMS's section — brief 8's grid fields and the two run
                         fields. The same rules as Palace's: a blank box is the default the generator and the
                         writer read, and every change is one undoable .cem edit. -->
                    <Grid IsVisible="{Binding ViewModel.IsOpenEmsSetup}" Margin="0,6,0,0"
                          ColumnDefinitions="Auto,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="2" HorizontalAlignment="Left">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Cells per wavelength" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Tag="OpenEms.CellsPerWavelength"
                                   Text="{Binding ViewModel.OpenEmsCellsPerWavelengthText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultCellsPerWavelength}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The largest grid cell, as the number of cells per wavelength in the densest material it passes through at the sweep's top frequency."/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="Grading" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Classes="num" Tag="OpenEms.GradingRatio"
                                   Text="{Binding ViewModel.OpenEmsGradingRatioText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultGradingRatio}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The largest ratio between two neighbouring grid cells. Above 1, at most 4."/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Merge lines closer than (µm)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Classes="num" Tag="OpenEms.MinCellUm"
                                   Text="{Binding ViewModel.OpenEmsMinCellUmText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultMinCellUm}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="Grid lines the geometry asks for that are closer than this are merged, and each merge is reported. Blank: a tenth of the smallest metal width or thickness. The smallest cell sets the time step for the whole run."/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhdr" Text="PML cells" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Classes="num" Tag="OpenEms.PmlCells"
                                   Text="{Binding ViewModel.OpenEmsPmlCellsText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultPmlCells}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The absorbing layer's thickness, in uniform cells added outside each absorbing face of the air box. 0 uses a first-order Mur boundary instead."/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="colhdr" Text="End criterion (dB)" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Classes="num" Tag="OpenEms.EndCriterionDb"
                                   Text="{Binding ViewModel.OpenEmsEndCriterionDbText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultEndCriterionDb}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="A run stops when every port's voltage and current has fallen this far below its peak. Negative."/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="colhdr" Text="Max time steps" VerticalAlignment="Center"/>
                        <TextBox   Grid.Row="5" Grid.Column="1" Classes="num" Tag="OpenEms.MaxTimeSteps"
                                   Text="{Binding ViewModel.OpenEmsMaxTimeStepsText}"
                                   PlaceholderText="{x:Static em:EmSetupEditorViewModel.OpenEmsDefaultMaxTimeSteps}"
                                   LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                   ToolTip.Tip="The most time steps one run may take. A run that reaches it before the end criterion has not converged; its result is written with a warning. Blank: ten times the grid's own estimate."/>
                        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Content="Thirds rule at metal edges"
                                  IsChecked="{Binding ViewModel.OpenEmsThirdsRule}"
                                  ToolTip.Tip="Places a strip's edge lines a third of the local cell inside the metal and two thirds outside, where the edge field lives, rather than one line on the edge."/>
                        <SelectableTextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource CrfWarningBrush}"
                                   Text="{Binding ViewModel.OpenEmsFieldError}"
                                   IsVisible="{Binding ViewModel.OpenEmsFieldError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="group">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Analysis"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                    <StackPanel Grid.Column="0" Spacing="2">
                        <!-- Owner request: the analysis type never needs the full panel width. -->
                        <ComboBox Classes="cell" MaxWidth="200" HorizontalAlignment="Left"
                                  ItemsSource="{x:Static em:EmSetupEditorViewModel.AnalysisKindChoices}"
                                  SelectedItem="{Binding ViewModel.AnalysisKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static conv:EmAnalysisKindNameConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="colhdr" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="{Binding ViewModel.AnalysisKindDescription}"/>
                        <TextBlock FontSize="11" Margin="0,4,0,0"
                                   Text="{Binding ViewModel.SelectedKernelName}" FontWeight="SemiBold"/>
                        <TextBlock Classes="colhdr" TextWrapping="Wrap"
                                   Text="{Binding ViewModel.KernelChoiceReason}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <!-- ── Cross-section readback (R-em-8: rendered, never recomputed) ──
                             The WHOLE block is gated on Readback, header included. Readback is the
                             cross-section kernel's own product and is null for a full-wave setup, so
                             without the gate a planar setup showed a "Cross-section" heading with
                             nothing whatsoever under it (owner report, 2026-08-11). A heading with
                             no content reads as a rendering failure, not as an empty section. -->
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding ViewModel.Readback, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="colhdr" FontWeight="SemiBold" Text="Cross-section"/>
                            <TextBlock Text="{Binding ViewModel.Readback.Summary}" TextWrapping="Wrap"
                                       FontSize="11"/>

                            <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Propagation axis"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.Readback.Axis}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="Signal layer"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.Readback.SignalLayerName}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Ground reference"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.Readback.GroundLayerName}"/>
                            </Grid>
                        </StackPanel>

                        <!-- The extraction notes — what geometry was seen, what was ignored and why,
                             and where each port resolved to. They live in the RIGHT column with the
                             readback, not full width below both, because that is what actually buys
                             the height back: they are the tallest thing in the group, and beside the
                             description they cost nothing instead of stacking under it.

                             HasNotes gates the label AND the list together, so the heading can never
                             be left standing over nothing — the exact failure the ungated
                             "Cross-section" heading produced. -->
                        <StackPanel IsVisible="{Binding ViewModel.HasNotes}" Margin="0,6,0,0" Spacing="2">
                            <!-- EM-SEV R-emsev-1 — the findings that change WHAT WAS SOLVED, above
                                 the ones that merely explain it, in the warning brush. The run has
                                 ranked these since EM-SEV; this panel joined them into the note
                                 block, so a level carrying a user's capacitor read as one paragraph
                                 of eighteen in the very dialog holding the tick box that fixes it.
                                 Still ONE block per class, per the 2026-09-09 copy instruction. -->
                            <!-- Selectable, like every other warning-coloured string here —
                                 EmSetupLayoutRowTests.EveryWarningColouredString_IsSelectable is
                                 mechanical about it, and a heading nobody can drag through breaks
                                 a selection that starts above it and ends below. -->
                            <SelectableTextBlock Classes="colhdr" FontWeight="SemiBold" Text="Warnings"
                                       Foreground="{DynamicResource CrfWarningBrush}"
                                       IsVisible="{Binding ViewModel.HasWarnings}"/>
                            <SelectableTextBlock Text="{Binding ViewModel.WarningsText}"
                                                 Foreground="{DynamicResource CrfWarningBrush}"
                                                 IsVisible="{Binding ViewModel.HasWarnings}"
                                                 TextWrapping="Wrap" FontSize="10"/>
                            <TextBlock Classes="colhdr" FontWeight="SemiBold" Text="Notes"/>
                            <!-- ONE block, not an ItemsControl of them — an ItemsControl selects one
                                 LINE at a time and copying a report out means dragging each note
                                 separately (owner instruction, 2026-09-09). -->
                            <SelectableTextBlock Text="{Binding ViewModel.NotesText}"
                                                 TextWrapping="Wrap" FontSize="10" Opacity="0.75"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                  </StackPanel>
                </Border>

                <!-- ── Signal layer (R-em-4b) ──────────────────────────────── -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Conductors"/>
                <TextBlock Classes="colhdr" Text="Signal conductor"/>
                <ComboBox Classes="cell" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ViewModel.ConductorLayerChoices}"
                          SelectedItem="{Binding ViewModel.SignalLayerChoice}"/>

                <!-- ── RP-1: which conductor every port returns through ─────────────────
                     Nothing is filtered out: R-rp1-4 permits a conductor the technology does not
                     designate as a ground reference, and a list that hid the legal choices would
                     teach the wrong rule. The designated ones are MARKED in the row text instead. -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Return plane"
                           IsVisible="{Binding ViewModel.IsPlanarAnalysis}"/>
                <ComboBox Classes="cell" HorizontalAlignment="Stretch"
                          IsVisible="{Binding ViewModel.IsPlanarAnalysis}"
                          ItemsSource="{Binding ViewModel.ReturnPlaneChoices}"
                          SelectedItem="{Binding ViewModel.ReturnPlaneChoice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- ── L9d/D5: which conductor levels the PLANAR analysis includes ──────────
                     Deliberately separate from the combo above, which is the CROSS-SECTION
                     kernel's own control and means a different thing (which single conductor a
                     uniform cross-section is about). Nothing checked = infer, which is every level
                     carrying artwork and is what every pre-L9d .cem asks for. -->
                <!-- Owner question, 2026-08-11: "will the Analysis levels listing grow to be extremely
                     large if the .ctech has lots of conductors?" It can — an imported process ships
                     hundreds of layers — so the list is COLLAPSED behind an Expander whose header
                     already answers the question the list would ("3 of 6 included"), and is
                     height-capped when open. Same shape as the Analyses panel's own Corners block.

                     An ItemsControl rather than a ListBox (this repo's usual rule for growing row
                     lists) because the rows are CHECKBOXES: a ListBox would add a selection highlight
                     that means nothing here. The MaxHeight ScrollViewer is what bounds it instead —
                     and only CONDUCTORS appear, which is a far smaller set than a layer table. -->
                <!-- IsExpanded is BOUND, not False: the view model opens this when something drawn
                     is being left out of the run, because R-emsev-6's sentence lives inside here and
                     a collapsed Expander renders none of its content. See AnalysisLevelsExpanded. -->
                <Expander Margin="0,8,0,0"
                          IsExpanded="{Binding ViewModel.AnalysisLevelsExpanded, Mode=TwoWay}"
                          IsVisible="{Binding ViewModel.IsPlanarAnalysis}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Classes="colhdr" Text="{Binding ViewModel.AnalysisLevelsSummary}"/>
                    </Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="10" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Which conductor levels the full-wave solve meshes, bottom-to-top. Anything not meshed is not in the answer. Leave all unchecked and the run takes every level that carries artwork — except one lying below everything the ports feed, which is left out so stray artwork cannot move the return plane (tick it to put it back), and except when Signal conductor above names one, which pins the run to that level alone."/>
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ViewModel.AnalysisLevelRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox FontSize="11" Content="{Binding Name}"
                                                  IsChecked="{Binding IsIncluded}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- EM-SEV R-emsev-6 — the only part of that brief that reaches the user
                             BEFORE the run. Everything else it asks for improves a report read
                             afterwards; this is one line, here, while the tick boxes that fix it are
                             on screen. Hidden unless there is something to say (the VM returns null
                             when the level list is empty, which is the common untouched case). -->
                        <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource CrfWarningBrush}"
                                   IsVisible="{Binding ViewModel.ExcludedArtworkNote,
                                                       Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding ViewModel.ExcludedArtworkNote}"/>
                    </StackPanel>
                </Expander>

                <!-- ── Frequency sweep ──────────────────────────────────────────
                     R-em-11: the EXISTING FrequencySpecViewModel, never a second frequency editor.
                     What that rule protects is the LOGIC — unit suffixes, the coefficient rescale on
                     a unit change, mode/kind, and the resolved-value preview — and every one of
                     those is the VM's, bound to below. The markup is presentation: SpBodyView's own
                     copy is an ItemTemplate inside a segment list with a Remove button, which is not
                     what a single-sweep panel wants, and extracting it into a shared UserControl
                     would churn the analysis editor for no behavioural gain. -->
                  </StackPanel>
                </Border>

                <Border Classes="group">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Frequency"/>
                <TextBlock Classes="colhdr" Text="Sweep"/>
                <!-- Owner report, 2026-08-09: "the Frequency UI elements overlap too." It was a
                     `*,*,Auto` Grid whose third column held FOUR seg-buttons behind a
                     MinWidth="130" they do not fit in — so that column overran its own minimum and
                     the two star columns were squeezed toward nothing. A WrapPanel of three blocks
                     instead: Start, Stop and the mode cluster each keep a legible width and drop to
                     the next line rather than crushing each other. -->
                <WrapPanel DataContext="{Binding ViewModel.Frequency}">
                    <StackPanel Spacing="2" Width="150" Margin="0,0,8,6">
                        <TextBlock Text="Start" Classes="colhdr"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Classes="cell" Text="{Binding StartCoeff, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1" Classes="cell"
                                      ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                                      SelectedItem="{Binding StartUnit, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding StartPreview}" FontSize="10" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Spacing="2" Width="150" Margin="0,0,8,6">
                        <TextBlock Text="Stop" Classes="colhdr"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Classes="cell" Text="{Binding StopCoeff, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1" Classes="cell"
                                      ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                                      SelectedItem="{Binding StopUnit, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Text="{Binding StopPreview}" FontSize="10" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Spacing="2" MinWidth="150" Margin="0,0,0,6">
                        <!-- Two groups rather than one row of four, so Lin/Log drops below
                             Step/Points instead of overrunning the block. -->
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,6,2">
                                <Button Content="Step"   Classes="seg-btn" Classes.active="{Binding IsStepMode}"
                                        Command="{Binding SetModeStepCommand}"/>
                                <Button Content="Points" Classes="seg-btn" Classes.active="{Binding IsPointsMode}"
                                        Command="{Binding SetModePointsCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,2">
                                <Button Content="Lin" Classes="seg-btn"
                                        Classes.active="{Binding IsLinear}" Command="{Binding SetKindLinearCommand}"/>
                                <Button Content="Log" Classes="seg-btn"
                                        Classes.active="{Binding IsLog}" Command="{Binding SetKindLogCommand}"/>
                            </StackPanel>
                        </WrapPanel>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStepMode}">
                            <TextBox Classes="cell" Text="{Binding StepCoeff, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1" Classes="cell"
                                      ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                                      SelectedItem="{Binding StepUnit, Mode=TwoWay}"/>
                        </Grid>
                        <TextBox Classes="cell" IsVisible="{Binding IsPointsMode}"
                                 Text="{Binding NumPointsExpr, Mode=TwoWay}"/>
                    </StackPanel>
                </WrapPanel>

                    <!-- Owner request, 2026-08-09: adaptive sampling belongs beside the sweep it
                         samples — it decides how many of THESE points are actually solved, so the
                         user has to see it while editing the range, not four sections away. -->
                    <CheckBox Name="AdaptiveSamplingCheck" FontSize="11" Margin="0,8,0,0"
                              Content="Adaptive sampling (solve fewer points, model the rest)"
                              IsChecked="{Binding ViewModel.AdaptiveSampling}"
                              IsEnabled="{Binding ViewModel.AdaptiveSamplingDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                              ToolTip.Tip="Solves a subset of the requested frequencies and models the rest, refining until a solved midpoint agrees with the model to 1e-3 in |S|. The published sweep is always exactly the grid you asked for, and every solved point carries the solver's own result unchanged. Both ends of the sweep are always solved, and a DC point is never modelled - 0 Hz is answered by its own conduction solve. Turn this off to solve every point."/>
                    <TextBlock Classes="colhdr" TextWrapping="Wrap"
                               Text="{Binding ViewModel.AdaptiveSamplingDisabledReason}"
                               IsVisible="{Binding ViewModel.AdaptiveSamplingDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- ANT-9. Directly under adaptive sampling because it is a MODE OF it, not a
                         peer: it needs the interpolant refinement builds, and it is the one control
                         in circuitRF that lets a sweep publish a frequency the user did not ask
                         for. The label says "add points" in those words for that reason. -->
                    <CheckBox Name="ResonanceSearchCheck" FontSize="11" Margin="16,4,0,0"
                              Content="Resonance search"
                              IsChecked="{Binding ViewModel.ResonanceSearch}"
                              IsEnabled="{Binding ViewModel.ResonanceSearchDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                              ToolTip.Tip="Finds resonances narrower than your frequency step. It looks for Im(Z_in) crossing zero, brackets each one by bisection, and reports f0, Q and the bandwidth as a diagnostic. This costs real solve time — a full-wave point is tens of seconds — so it is off by default."/>
                    <TextBlock Classes="colhdr" TextWrapping="Wrap" Margin="16,0,0,0"
                               Text="{Binding ViewModel.ResonanceSearchDisabledReason}"
                               IsVisible="{Binding ViewModel.ResonanceSearchDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </StackPanel>
                </Border>

                <!-- ── Ports ───────────────────────────────────────────────── -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                <!-- Owner request, 2026-08-11: the two paragraphs that used to sit in this group are
                     now the group header's TOOLTIP. They explain how ports WORK, which is worth one
                     hover and is not worth the vertical space on every setup — the same trade the
                     Adaptive-sampling checkbox already makes. The text follows the chosen kernel
                     (PortsHelpText), because the two analyses answer "where is the port?" completely
                     differently. -->
                <TextBlock Classes="grouphdr" Text="Ports"
                           ToolTip.Tip="{Binding ViewModel.PortsHelpText}"/>
                <!-- The near/far DEFAULT pair, shown only when the per-port list below is not
                     (ShowNearFarPortZ0). Owner report, 2026-08-25: "I don't see a Port 3 Z0 option"
                     — with both drawn, this captioned pair reads as the port list and stops at two.
                     They are also one value: a row falls back to this pair until it is overridden. -->
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="3"
                      IsVisible="{Binding ViewModel.ShowNearFarPortZ0}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Port 1 Z₀ (Ω)"
                               VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Tag="Port1Z0"
                               Text="{Binding ViewModel.Port1Z0Text}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="10"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               Text="{Binding ViewModel.Port1Z0Error}"
                               IsVisible="{Binding ViewModel.Port1Z0Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Port 2 Z₀ (Ω)"
                               VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Classes="num" Tag="Port2Z0"
                               Text="{Binding ViewModel.Port2Z0Text}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="10"
                               Foreground="{DynamicResource CrfWarningBrush}"
                               Text="{Binding ViewModel.Port2Z0Error}"
                               IsVisible="{Binding ViewModel.Port2Z0Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
                <!-- R-cpl-6: per-port list, shown only once the cross-section has more than a
                     single line's two ports. D3 numbering: port 2k-1 is conductor k's near end. -->
                <StackPanel IsVisible="{Binding ViewModel.ShowPortList}" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding ViewModel.PortRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="em:EmPortZ0Row">
                                <!-- Owner request, 2026-08-25: the port's NAME sits on the same row as
                                     its reference impedance, and the box carries a unit.

                                     This was a two-column grid whose second column held a StackPanel of
                                     [impedance, type, error]. The name was centred against that WHOLE
                                     stack, so on a planar row (which always shows the type combo) it
                                     came to rest between the two controls and read as labelling
                                     neither — and the impedance box, alone among the numeric fields in
                                     this panel, had no unit beside it, so "50" beside a port name read
                                     as a port number more readily than as ohms. Rows now place each
                                     control explicitly instead of stacking them. -->
                                <!-- COLUMN 1 IS Auto, NOT *, AND THE CONTROLS BELOW SPAN PAST IT.
                                     Owner report, 2026-08-25: "ohms is aligned right — it needs to be
                                     aligned left (with padding to the text edit box)." With a
                                     stretching middle column the 86-wide TextBox sat at its left edge
                                     while the unit was pushed to the far right of the panel, so the Ω
                                     had drifted a whole panel-width from the number it belongs to.
                                     Sizing column 1 to the box puts them together, and ColumnSpacing
                                     is the padding between them. The type combo and the two warning
                                     lines SPAN columns 1-2 so their own widths cannot push column 1
                                     back open and re-separate the pair. -->
                                <Grid ColumnDefinitions="190,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnSpacing="6" Margin="0,2,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="{Binding Label}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Classes="num" Tag="PortRow"
                                             Text="{Binding Text}"
                                             LostFocus="OnPortRowLostFocus" KeyDown="OnPortRowKeyDown"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="colhdr" Text="Ω"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <!-- The port TYPE, planar analysis only (ShowKind). The
                                         SelectedItem stays bound to the enum; the items render
                                         through the converter because "InternalDeltaGap" is our
                                         spelling, not a user's. Committing is the row's
                                         KindChanged event, wired by the VM, so this needs no
                                         code-behind handler of its own. -->
                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                              FontSize="11" Margin="0,2,0,0"
                                              HorizontalAlignment="Left" MinWidth="150"
                                              IsVisible="{Binding ShowKind}"
                                              ItemsSource="{x:Static em:EmPortZ0Row.KindChoices}"
                                              SelectedItem="{Binding Kind}"
                                              ToolTip.Tip="Edge: the port is at a conductor's end face, fed from outside your artwork, and IS de-embedded — the two-line calibration removes the port discontinuity so the answer is your structure's own response. Internal delta gap: the port is a cut across the middle of a conductor, with metal on both sides, for a lumped element or a device terminal embedded in the metal; it is NOT de-embedded, because there is no feed outside the cut to remove, and its s-parameters are reported at the gap in the reference impedance set above.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static conv:PlanarPortKindNameConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" FontSize="10"
                                               Foreground="{DynamicResource CrfWarningBrush}"
                                               Text="{Binding Error}"
                                               IsVisible="{Binding HasError}"/>
                                    <!-- Why this port did not resolve from the geometry. A row is
                                         listed even when its label is off the metal (owner request,
                                         2026-08-25) — listing it without saying why would be worse
                                         than not listing it. Spans all three columns and wraps: these
                                         are the extractor's own sentences, which name the port, its
                                         coordinate and the remedy. -->
                                    <SelectableTextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,4"
                                               Foreground="{DynamicResource CrfWarningBrush}"
                                               Text="{Binding Problem}"
                                               IsVisible="{Binding HasProblem}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                  </StackPanel>
                </Border>

                <!-- ── Mesh settings (all six — R-em-11) ───────────────────── -->
                <Border Classes="group" IsVisible="{Binding !ViewModel.IsPlanarAnalysis}">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Mesh"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6" RowSpacing="3">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Min cells across width" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Tag="MinCellsAcrossWidth"
                               Text="{Binding ViewModel.MinCellsAcrossWidthText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="Edge cells" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Classes="num" Tag="EdgeCells"
                               Text="{Binding ViewModel.EdgeCellsText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Edge fraction of width" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Classes="num" Tag="EdgeFractionOfWidth"
                               Text="{Binding ViewModel.EdgeFractionText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhdr" Text="Edge growth ratio" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Classes="num" Tag="EdgeGrowthRatio"
                               Text="{Binding ViewModel.EdgeGrowthText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="colhdr" Text="Truncation (substrate heights)" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Classes="num" Tag="TruncationHeights"
                               Text="{Binding ViewModel.TruncationHeightsText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="colhdr" Text="Truncation tail cells" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Classes="num" Tag="TruncationTailCells"
                               Text="{Binding ViewModel.TruncationTailCellsText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                </Grid>
                <SelectableTextBlock FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource CrfWarningBrush}"
                           Text="{Binding ViewModel.MeshFieldError}"
                           IsVisible="{Binding ViewModel.MeshFieldError, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- R-em-16: the engine's own report, VERBATIM. -->
                <TextBlock Classes="sect" Text="Mesh report"
                           IsVisible="{Binding ViewModel.MeshReport, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="6"
                      IsVisible="{Binding ViewModel.MeshReport, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Unknowns"/>
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.MeshReport.UnknownCount}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="Smallest cell"/>
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.MeshReport.MinCellLength}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Largest cell"/>
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.MeshReport.MaxCellLength}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhdr" Text="Truncation half-extent"/>
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="11" Text="{Binding ViewModel.MeshReport.TruncationHalfExtent}"/>
                </Grid>
                <SelectableTextBlock Text="{Binding ViewModel.MeshNotesText}" Margin="0,4,0,0"
                                     IsVisible="{Binding ViewModel.HasMeshNotes}"
                                     TextWrapping="Wrap" FontSize="10" Opacity="0.8"/>

                  </StackPanel>
                </Border>

                <!-- ── L8b/L8e: the surface mesh, the R17 verdict and the heat map ── -->
                <!-- Named so the user docs can CROP to it: the MoM chapter's worked example shows
                     the mesh settings on their own rather than a 2,000 px panel, and the crop is
                     taken from the live visual tree by this name (FigureCrop.Around). Renaming it
                     fails the docs build rather than silently photographing the wrong rows. -->
                <Border Classes="group" Name="SurfaceMeshGroup" IsVisible="{Binding ViewModel.IsPlanarAnalysis}">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Surface mesh"/>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnSpacing="6" RowSpacing="3">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="colhdr" Text="Cells per wavelength" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Classes="num" Tag="CellsPerWavelength"
                               Text="{Binding ViewModel.PlanarCellsPerWavelengthText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"/>
                    <!-- The transverse counterpart of Cells per wavelength, and on geometry-driven
                         artwork it is the one that actually binds: the pitch is
                         min(lambda_g/CellsPerWavelength, narrowest/this). A control since 2026-09-09
                         because mesh density is the user's to decide; 1 is accepted, and the mesher
                         NOTES what it produced rather than clamping or refusing. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="colhdr" Text="Cells across conductor" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Classes="num" Tag="PlanarMinCellsAcross"
                               Text="{Binding ViewModel.PlanarMinCellsAcrossText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                               ToolTip.Tip="Cells across the narrowest conductor — the transverse cell size. With Transmission line off, the mesh uses whichever is smaller, this or the wavelength cap, in BOTH directions, so on artwork with fine features this is the only setting that can change the cell count. With it on, this sets the pitch across the current and Cells per wavelength sets it along. Lowering it always coarsens the mesh, and it now coarsens the EDGE MESH with it: the graded edge cell is never more than ten times finer than the pitch this setting asks for, so the fan gets shorter as the mesh gets coarser rather than longer. 1 means no transverse current variation is representable at all."/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="colhdr" Text="Edge mesh" VerticalAlignment="Center"/>
                    <CheckBox  Grid.Row="2" Grid.Column="1" Name="PlanarEdgeMeshCheck" FontSize="11"
                               Content="Refine at conductor edges"
                               IsChecked="{Binding ViewModel.PlanarEdgeMesh}"/>
                    <!-- It had no tooltip at all, which is how the owner came to report in 2026-08-09
                         that setting it to 10 changed nothing: it is a FLOOR on how far the graded
                         fan reaches, not a control over how fine the edge cell is, and nothing said
                         so anywhere a user would look. -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="colhdr" Text="Edge cells" VerticalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Classes="num" Tag="PlanarEdgeCells"
                               Text="{Binding ViewModel.PlanarEdgeCellsText}"
                               LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                               ToolTip.Tip="How far the refinement at a conductor edge reaches inward, in cells — a FLOOR on the fan's length, never a control over how fine the edge cell is. That cell is a fixed fraction of the metal at each edge, capped against Cells across a conductor; raising this number widens the graded band and lowers the growth ratio, and past a point the ratio's own bounds stop it doing anything at all. The mesh report says which count was actually used and why."/>
                    <!-- The fourth control. Labelled for what it DOES, not for its implementation:
                         a user picks "follow the metal", not "cut cells". -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="colhdr" Text="Boundary cells" VerticalAlignment="Center"/>
                    <!-- Width sized to the longest option ("Staircase") plus the chevron and a
                         margin, not stretched (owner request, 2026-08-11): a two-item closed choice
                         gains nothing from spanning the panel, and it made the group read as one
                         wide control beside four short ones. -->
                    <ComboBox  Grid.Row="4" Grid.Column="1" Name="PlanarBoundaryCellsCombo" FontSize="11"
                               Width="110" HorizontalAlignment="Left"
                               ItemsSource="{Binding ViewModel.BoundaryCellsChoices}"
                               SelectedItem="{Binding ViewModel.PlanarBoundaryCells}"
                               ToolTip.Tip="How the mesh treats curved and oblique conductor edges. Staircase approximates them with the rectangular grid. Conformal cuts the boundary cells to follow the metal, which is more accurate on tapers, bends and curves."/>
                    <!-- M0's fifth control, and the only one that is a PERFORMANCE knob. Edited in
                         the sweep's own frequency unit through the same staged-text committer every
                         other dimensioned field here uses; blank means "max sweep". -->
                    <!-- The seventh control, and the one that makes the two wavelength controls
                         work at all. Owner report, 2026-09-09: lowering Cells per wavelength or Mesh
                         frequency did not reduce the cell count, and it could not, because the pitch
                         is the SAME min in both axes and the geometry term wins in both. Naming what
                         the metal IS is what separates them. Placed directly under the two settings
                         it governs, because it is the answer to "why does that number do nothing".

                         ANT-3 made it a THREE-WAY choice rather than adding a second checkbox: a
                         line and a sheet are mutually exclusive intents, and the LABEL is about the
                         structure — what this metal is — rather than about the algorithm, because
                         that is the question the user can actually answer. -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="colhdr" Text="This metal is" VerticalAlignment="Center"/>
                    <ComboBox  Grid.Row="5" Grid.Column="1" Name="PlanarCurrentModelCombo" FontSize="11"
                               Width="150" HorizontalAlignment="Left"
                               ItemsSource="{x:Static em:EmSetupEditorViewModel.CurrentModelChoices}"
                               SelectedItem="{Binding ViewModel.PlanarCurrentModel}"
                               ToolTip.Tip="What the current on this artwork does — which is what decides whether Cells per wavelength and Cells across conductor compete or act separately. Unstated: the cell size is the smaller of the two in BOTH directions, so on artwork with fine features the wavelength settings cannot change the mesh at all. Transmission line: wavelength ALONG the current, conductor width ACROSS it, with the direction measured per point from the metal so a bend is followed rather than averaged. Radiating sheet: a patch or any wide radiator, where the current varies on the scale of a wavelength in BOTH directions and there is no along — wavelength sets both axes, and the metal's own width is resolved only where the metal is genuinely narrow, such as a feed. No cell is ever finer than it would have been with this left alone.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static conv:PlanarCurrentModelNameConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- ANT-2's eighth control. Placed with the two settings it modifies rather
                         than at the end: it does not change the resolution, it changes which drawn
                         geometry the resolution is measured against, and the question it answers
                         ("why is my imported board asking for 700,000 unknowns?") is asked while
                         reading the two rows above it. -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="colhdr" Text="Detail floor" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock FontSize="11" VerticalAlignment="Center" Opacity="0.7" Text="&#955;_g /"/>
                        <TextBox Classes="num" Tag="PlanarDetailFloor" Width="80"
                                 Text="{Binding ViewModel.PlanarDetailFloorText}"
                                 LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                 ToolTip.Tip="Metal narrower than this fraction of a guided wavelength does not get to set the cell size. An imported board arrives with connector via lands, aperture-rounded corners and other artefacts far smaller than anything the field responds to, and one of them anywhere sets the pitch of the whole tensor grid — on a measured 1.74 GHz patch board that detail was 310 um and cost 14x the unknown count. It can only COARSEN: nothing below the floor is removed from the mesh, it just stops being what the mesh is sized on. The number is a DIVISOR, so a smaller number is a coarser floor; 0 turns it off. The notes below say how many shapes fell below it and what the pitch would have been without it."/>
                    </StackPanel>
                    <TextBlock Grid.Row="7" Grid.Column="0" Classes="colhdr" Text="Mesh frequency" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBox Classes="num" Tag="MeshFrequency" Width="110"
                                 Text="{Binding ViewModel.PlanarMeshFrequencyText}"
                                 PlaceholderText="{Binding ViewModel.MeshFrequencyPlaceholder}"
                                 LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                 ToolTip.Tip="The frequency the cell-size cap is sized at. Leave blank to use the maximum of the frequency sweep. Sizing the mesh lower than the sweep's max gives fewer unknowns and a faster run, at the cost of resolution at the top of the band — the notes below say what the trade actually is. If lowering it does not change the unknown count, the wavelength cap is not what is setting the cell size: turn on Transmission line, or lower Cells across conductor."/>
                        <TextBlock FontSize="11" VerticalAlignment="Center" Opacity="0.7"
                                   Text="{Binding ViewModel.MeshFrequencyUnit}"/>
                    </StackPanel>
                </Grid>
                <SelectableTextBlock FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource CrfWarningBrush}"
                           Text="{Binding ViewModel.PlanarMeshFieldError}"
                           IsVisible="{Binding ViewModel.PlanarMeshFieldError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <SelectableTextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding ViewModel.PlanarMeshSummary}"
                           IsVisible="{Binding ViewModel.PlanarMeshReport, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <!-- Warnings first, and in the warning brush — see the Notes block above. -->
                <SelectableTextBlock Text="{Binding ViewModel.PlanarMeshWarningsText}" Margin="0,4,0,0"
                                     Foreground="{DynamicResource CrfWarningBrush}"
                                     IsVisible="{Binding ViewModel.HasPlanarMeshWarnings}"
                                     TextWrapping="Wrap" FontSize="10"/>
                <SelectableTextBlock Text="{Binding ViewModel.PlanarMeshNotesText}" Margin="0,4,0,0"
                                     IsVisible="{Binding ViewModel.HasPlanarMeshNotes}"
                                     TextWrapping="Wrap" FontSize="10" Opacity="0.8"/>

                <!-- R-res-8: the heat map's scale, with its UNITS and its NORMALISATION, in the
                     engine's own words. An unlabelled ramp over an unstated normalisation is
                     decoration; §10.5 asks for a diagnostic. -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Current density"
                           IsVisible="{Binding ViewModel.CurrentDensity, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.CurrentDensityScale}"
                           IsVisible="{Binding ViewModel.CurrentDensity, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                  </StackPanel>
                </Border>

                <!-- ── Solver options ─────────────────────────────────────────────────────── -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Solver options"/>

                <!-- ── Vertical (via) kernel — M2, disabled with a stated reason ───────────── -->
                <TextBlock Classes="colhdr" Text="Vertical (via) kernel"/>
                <CheckBox Name="DirectVerticalKernelCheck" FontSize="11"
                          Content="Integrate G_A^zz directly (slower, accurate at any via spacing)"
                          IsChecked="{Binding ViewModel.DirectVerticalKernel}"
                          IsEnabled="{Binding ViewModel.DirectVerticalKernelDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                          ToolTip.Tip="Replaces the fitted Green's function with direct numerical integration for the one term that couples vias to each other. Costs roughly 15-45% more per frequency point per via span. Turn this on when a run is refused for its via separation."/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.DirectVerticalKernelDisabledReason}"
                           IsVisible="{Binding ViewModel.DirectVerticalKernelDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- ── M5's accelerator — its FIRST user-reachable switch (owner request, 2026-08-14).
                     Under Solver options rather than Surface mesh on purpose: it picks how the same
                     mesh is solved, changes no cell, and therefore does not invalidate the mesh.

                     The label states the measured trade rather than selling the feature. The win is
                     MEMORY, not time (~4x less working set past N ~ 900; the time crossover is around
                     N ~ 3,700), and it does NOT raise the unknown ceiling - a mesh over 5,000 unknowns
                     is refused before any solver is chosen. Saying otherwise here would send a user
                     straight back into the refusal that sent them looking. -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Accelerated solve"/>
                <CheckBox Name="AcceleratedSolveCheck" FontSize="11"
                          Content="Use the AIM accelerator (much less memory; faster only on large meshes)"
                          IsChecked="{Binding ViewModel.AcceleratedSolve}"
                          IsEnabled="{Binding ViewModel.AcceleratedSolveDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                          ToolTip.Tip="Solves the same system iteratively against a grid-accelerated matrix-vector product instead of forming and factoring the full dense matrix. It computes the same answer a different way, to its own accuracy gates. The win is working-set memory - roughly 4x less past about 900 unknowns - and it is also faster per frequency point past about 1,100; below that the dense path is faster. It DOES raise the unknown ceiling, from 5,000 to 12,000 - on a single-level mesh. A multi-level or via-bearing mesh RUNS accelerated (as a bordered system) but is still judged against the 5,000 dense ceiling, because its cost there is set by the vertical unknown count rather than by N."/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.AcceleratedSolveDisabledReason}"
                           IsVisible="{Binding ViewModel.AcceleratedSolveDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <!-- MIM-13 - the multi-level arm of the DISABLED reason was stale (P12 built the
                     bordered accelerator for exactly that mesh) and it greyed the control out on a
                     run that starts and is faster. The control is live now; what a multi-level mesh
                     still does not get is the WIDER CEILING, and that is what this says. -->
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.AcceleratedSolveCeilingNote}"
                           IsVisible="{Binding ViewModel.AcceleratedSolveCeilingNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- ── PCAL2 — the calibration override. The de-embedding checkbox that stood
                     here is GONE: R-pcal2-3 added it only so the mesh-ceiling refusal's recommended
                     remedy ("turn de-embedding off and read the raw solve") could be followed, and
                     that remedy was itself the defect - the raw solve reads every edge port as an
                     open circuit, and on every other port kind de-embedding is already inert. The
                     refusal no longer recommends it; see EmSetup.LegacyRawSolveRequested.
                     R-pcal2-2: the override below is named for what it DOES, not for the check it
                     suppresses, because the arithmetic still runs outside its validity and the file
                     it writes says so in its own provenance block. -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Port de-embedding"/>
                <CheckBox Name="DeembedOutsideValidityCheck" FontSize="11"
                          Content="De-embed outside the calibration's validity"
                          IsChecked="{Binding ViewModel.DeembedOutsideCalibrationValidity}"
                          IsEnabled="{Binding ViewModel.DeembedOutsideValidityEnabled}"
                          ToolTip.Tip="The two-line calibration assumes each port's feed is an isolated uniform line for the run the standard reproduces. A run where it is not is REFUSED, because the error box is then measured on a structure that is not the one being corrected: measured on a coupled pair, 22 dB of error in S21 at the bottom of the band and a result that is not passive. Turn this on to publish that answer anyway - for comparison against a previous run, for debugging, or when the port region is not where your answer lives. The answer is still wrong in the same way, and the Touchstone gains a line saying the de-embedding was applied outside its validity."/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.DeembedOutsideValidityDisabledReason}"
                           IsVisible="{Binding ViewModel.DeembedOutsideValidityDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- ── Dispersion (disabled with a stated reason) ───────────── -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Dispersion"/>
                <CheckBox Name="DispersionCheck" FontSize="11"
                          Content="Kirschning–Jansen dispersion correction"
                          IsChecked="{Binding ViewModel.DispersionCorrection}"
                          IsEnabled="{Binding ViewModel.DispersionDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                          ToolTip.Tip="{Binding ViewModel.DispersionDisabledReason}"/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.DispersionDisabledReason}"
                           IsVisible="{Binding ViewModel.DispersionDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- ── M1's core cap — the ONE control here that is not part of the design ────
                     R-emp-6: stored in AppPreferences, shown here because this is where the user
                     is standing when the cost lands. Commits on selection like every other closed
                     choice in this panel; no undo entry, and it can change no answer (R-emp-8). -->
                <TextBlock Classes="colhdr" Margin="0,8,0,0" Text="Cores"/>
                <ComboBox Width="200" FontSize="11"
                          ItemsSource="{Binding ViewModel.SolveCoreChoices}"
                          SelectedItem="{Binding ViewModel.SelectedSolveCores}"
                          DisplayMemberBinding="{Binding Label}"
                          ToolTip.Tip="How many cores the full-wave solver may use at once. Automatic uses the whole machine. Lowering it leaves cores free for other work and makes the run slower; it never changes the answer."/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.SolveCoresNote}"/>

                  </StackPanel>
                </Border>

                <!-- ── Radiation pattern — ANT-12 ──────────────────────────────────────────
                     Its OWN group, not a row under Solver options: it chooses an OUTPUT rather than
                     how an output is computed, it changes no s-parameter and no cell, and it is the
                     only control in this panel that asks for a second kind of result. The far field,
                     the metrics, the polarization and the plots all shipped between ANT-4 and ANT-11
                     with no way to ask for them; this checkbox is that way, and the `em` CLI verb
                     picks it up from the .cem with no flag of its own. -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                <TextBlock Classes="grouphdr" Text="Radiation pattern"/>
                <CheckBox Name="RadiationPatternCheck" FontSize="11"
                          Content="Compute the radiation pattern (gain, directivity, efficiency)"
                          IsChecked="{Binding ViewModel.RadiationPattern}"
                          IsEnabled="{Binding ViewModel.RadiationPatternDisabledReason, Converter={x:Static ObjectConverters.IsNull}}"
                          ToolTip.Tip="Adds the far field to the run: E_theta, E_phi and the radiation intensity over the upper hemisphere on a 1 degree grid, plus directivity, the two gains, radiation efficiency, the itemised power budget, beamwidth per plane and the polarization cubes. They land in the farfield group of the same result the s-parameters do, and the Data Display plots them as polar dB cuts or a 3D surface. It is a post-process of currents the solve has already paid for, so it changes no s-parameter and no cell - but it needs the currents, so a pattern is produced only at points that were actually SOLVED, which with adaptive sampling on is a subset of your grid. Off by default because it is only meaningful on a radiator."/>
                <TextBlock Classes="colhdr" TextWrapping="Wrap"
                           Text="{Binding ViewModel.RadiationPatternDisabledReason}"
                           IsVisible="{Binding ViewModel.RadiationPatternDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- The reference for the only two ABSOLUTE quantities the pattern produces. Every
                     other metric is a ratio and needs no excitation to be absolute against; TRP and
                     peak EIRP are watts, and a solve driven by a 1 V delta gap has no watts of its
                     own to offer. 0 dBm is what an over-the-air report is written against.

                     This field decides what the RUN bakes in - what the .npy carries and what a
                     headless run reports. It is NOT the only place it can be changed: the value is
                     published as its own cube, so the Data Display's trace card re-references a
                     level exactly, with no re-run. Nobody should have to repeat an hours-long sweep
                     for a dB offset, and the tooltip says so rather than leaving it to be found. -->
                <Grid ColumnDefinitions="Auto,Auto" Margin="22,4,0,0"
                      IsEnabled="{Binding ViewModel.ReferenceInputPowerEnabled}">
                    <TextBlock Grid.Column="0" Classes="colhdr" VerticalAlignment="Center"
                               Margin="0,0,6,0" Text="Reference input power (dBm)"/>
                    <NumericUpDown Grid.Column="1" Width="110" FontSize="11" Padding="5,2"
                                   Minimum="-100" Maximum="100" Increment="1"
                                   FormatString="0.##"
                                   ShowButtonSpinner="False"
                                   Value="{Binding ViewModel.ReferenceInputPowerDbm}"
                                   ToolTip.Tip="dBm. The conducted power TRP and peak EIRP are referenced to - it is an INPUT, because those two are absolute powers and this solve drives a 1 V delta gap that means nothing in watts. At the 0 dBm default, peak EIRP in dBm reads as the realized gain in dBi and TRP in dBm as the total efficiency in dB. Set it to a radio's own conducted power to compare against that radio's measured report. It changes no other metric and no s-parameter. YOU DO NOT NEED TO RE-RUN TO CHANGE IT: this sets what the run records, and the Data Display's trace card reads the same solved data against any other reference exactly."/>
                </Grid>
                  </StackPanel>
                </Border>

                <!-- ── Stackup: SHOWN, not edited (R-em-12) ────────────────── -->
                <Border Classes="group">
                  <StackPanel Spacing="2">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Classes="grouphdr" Margin="0"
                               Text="{Binding ViewModel.TechnologyName, StringFormat='Stackup — {0}'}"/>
                    <Button Grid.Column="1" Name="EditTechButton" FontSize="11" Padding="6,2"
                            Content="Edit technology…"
                            ToolTip.Tip="Opens the .ctech."/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ViewModel.StackupRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="em:EmStackupRow">
                            <Grid ColumnDefinitions="76,*,90,190,*" ColumnSpacing="6" Margin="0,1">
                                <TextBlock Grid.Column="0" FontSize="10" Opacity="0.7" Text="{Binding Kind}"/>
                                <TextBlock Grid.Column="1" FontSize="11" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" FontSize="11" Text="{Binding Thickness}"/>
                                <TextBlock Grid.Column="3" FontSize="10" Opacity="0.8" Text="{Binding Electrical}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" FontSize="10" Opacity="0.6" Text="{Binding DrawingLayers}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                  </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
