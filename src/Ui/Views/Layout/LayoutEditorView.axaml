<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lay="using:CircuitRF.Ui.Layout"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:converters="using:CircuitRF.Ui.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:shared="using:CircuitRF.Ui.Views.Shared"
             x:Class="CircuitRF.Ui.Views.Layout.LayoutEditorView"
             x:DataType="lay:LayoutDocument"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <converters:EnumEqualsToBoolConverter x:Key="EnumEqualsBool"/>
        <converters:ToLowerStringConverter x:Key="ToLower"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.ToolActive">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ToolActive /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColor}"/></Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.ToolActive:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/></Setter.Value>
            </Setter>
        </Style>

        <!-- Selection-dependent buttons: dim icon when disabled — mirrors SchematicView's
             Button.SelectionBtn exactly (Push Into Cell / Pop Out). -->
        <Style Selector="Button.SelectionBtn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- ── Breadcrumb bar styles (L3b) — mirrors SchematicView's BreadcrumbBtn exactly ──── -->
        <Style Selector="Button.LayoutBreadcrumbBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn.LayoutBreadcrumbCurrent">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn.LayoutBreadcrumbCurrent /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn.LayoutBreadcrumbCurrent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.LayoutBreadcrumbBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- brief-file-menu-restructure.md §4A: File menu, visible only when torn off.
             Wrapped in a Panel so a HOST can suppress it wholesale (WB39a: the wBond editor hosts
             this control inside its own document, where a torn-off window would otherwise show a
             second File menu belonging to the layout half). -->
        <Panel x:Name="FileMenuHost" DockPanel.Dock="Top">
            <shared:TornOffFileMenuView/>
        </Panel>

        <!-- brief-foreign-documents.md §4 item 2: edge band — a foreign document (its own file does
             not belong to the currently open workspace, R-fgn-1: regardless of docked/torn-off) shows
             an amber strip naming its source workspace, with an affordance to switch to it. Amber, not
             red (R-fgn-7: a foreign document is a normal, supported state) — never tints the rendered
             geometry, only this chrome band. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsForeign}"
                Background="{DynamicResource CrfForeignBandBrush}"
                BorderBrush="{DynamicResource CrfForeignAccentBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding SourceWorkspaceName, StringFormat='From workspace: {0}'}"
                           IsVisible="{Binding SourceWorkspaceName, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                           Text="Not part of any workspace"
                           IsVisible="{Binding SourceWorkspaceName, Converter={x:Static ObjectConverters.IsNull}}"/>
                <Button Grid.Column="1" Content="Open Workspace" FontSize="11" Padding="6,2"
                        IsVisible="{Binding SourceWorkspaceCwsPath, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Click="OnOpenSourceWorkspaceClick"/>
            </Grid>
        </Border>

        <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
        <Border x:Name="ToolbarBorder" DockPanel.Dock="Top"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <!-- WrapPanel (not a horizontal StackPanel in a ScrollViewer): a ScrollViewer set to
                 Auto/unbounded width can give its content effectively-infinite measure space on the
                 first layout pass, which for non-wrapping horizontal content can leave it painted
                 with a zero/degenerate size until a later invalidation (e.g. a pointer move) forces
                 a relayout — see PaletteToolView's WrapPanel note for the same gotcha. Wrapping
                 avoids the unbounded-width measurement entirely: it always reflows to the toolbar's
                 actual width, and does not need a ScrollViewer at all. -->
            <!-- x:Name="DocsToolbar" - see SchematicView.axaml for why the docs factory needs a
                 stable handle on this panel. -->
            <WrapPanel x:Name="DocsToolbar" Orientation="Horizontal" ItemSpacing="4" LineSpacing="4">
                        <Button Click="OnZoomToFit" ToolTip.Tip="Zoom to Fit  (F)" Padding="6,3">
                            <mi:MaterialIcon Kind="FitToPage" Width="16" Height="16"/>
                        </Button>
                        <Button Click="OnZoomIn" ToolTip.Tip="Zoom In" Padding="6,3">
                            <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="16" Height="16"/>
                        </Button>
                        <Button Click="OnZoomOut" ToolTip.Tip="Zoom Out" Padding="6,3">
                            <mi:MaterialIcon Kind="MagnifyMinusOutline" Width="16" Height="16"/>
                        </Button>
                        <Button Click="OnZoom1To1" ToolTip.Tip="Zoom 1:1 (1 px per display-unit tick)" Padding="6,3">
                            <mi:MaterialIcon Kind="Magnify" Width="16" Height="16"/>
                        </Button>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Select}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Select"
                                ToolTip.Tip="Select" Padding="6,3">
                            <mi:MaterialIcon Kind="CursorDefault" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Rect}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Rect"
                                ToolTip.Tip="Rectangle" Padding="6,3">
                            <mi:MaterialIcon Kind="RectangleOutline" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=RoundedRect}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="RoundedRect"
                                ToolTip.Tip="Rounded Rectangle" Padding="6,3">
                            <mi:MaterialIcon Kind="SquareRoundedOutline" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Circle}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Circle"
                                ToolTip.Tip="Circle (center-radius)" Padding="6,3">
                            <mi:MaterialIcon Kind="VectorCircle" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Polygon}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Polygon"
                                ToolTip.Tip="Polygon  (double-click/Enter to close, Backspace removes last vertex)" Padding="6,3">
                            <mi:MaterialIcon Kind="VectorPolygon" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Path}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Path"
                                ToolTip.Tip="Path (trace)" Padding="6,3">
                            <mi:MaterialIcon Kind="VectorLine" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Label}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Label"
                                ToolTip.Tip="Label" Padding="6,3">
                            <mi:MaterialIcon Kind="LabelOutline" Width="16" Height="16"/>
                        </Button>
                        <!-- Via tool (docs/sonnet-briefs/brief-via-primitive-and-stackup.md §4.1) —
                             single click, no drag; disabled with a reason (R13a) on a technology whose
                             stackup has no via layer, per ViaToolAvailability. -->
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Via}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Via"
                                IsEnabled="{Binding ActiveViewModel.ViaToolAvailability.CanExecute}"
                                ToolTip.Tip="{Binding ActiveViewModel.ViaToolTipText}" Padding="6,3">
                            <mi:MaterialIcon Kind="RecordCircleOutline" Width="16" Height="16"/>
                        </Button>
                        <!-- Port tool (L8e D3) — §10.6's "click an edge, get P1". A port is an
                             ordinary label with its port flag set; the tool sets the flag and
                             auto-numbers, and nothing else. The reference impedance lives in the
                             .cem, and which END of the conductor the port names is inferred from
                             the geometry at extraction time (and refused when ambiguous), never
                             stored on the shape where it would go stale under an edit. -->
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Port}"
                                Command="{Binding ActiveViewModel.SetActiveToolCommand}" CommandParameter="Port"
                                ToolTip.Tip="Port — click a conductor end to place an EM port (auto-numbered)" Padding="6,3">
                            <mi:MaterialIcon Kind="TargetVariant" Width="16" Height="16"/>
                        </Button>
                        <Button Click="OnInsertBitmap" ToolTip.Tip="Insert Bitmap…" Padding="6,3">
                            <mi:MaterialIcon Kind="ImagePlusOutline" Width="16" Height="16"/>
                        </Button>

                        <!-- Rotate. Same icons, order and shortcuts as the Schematic Editor's own
                             pair, so the gesture transfers between editors. A multi-selection turns
                             as ONE rigid body here (see LayoutEditorViewModel.Rotate.cs). -->
                        <!-- IsEnabled starts False and is maintained live by UpdateSelectionButtonStates,
                             the same shape as the Schematic Editor's own four (owner, 2026-08-27: they
                             stayed enabled here with nothing selected, and clicking one did nothing). -->
                        <Button x:Name="RotateCcwBtn" Click="OnRotateCcw" IsEnabled="False"
                                ToolTip.Tip="Rotate 90° CCW  (R)" Padding="6,3">
                            <mi:MaterialIcon Kind="RotateLeft" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="RotateCwBtn" Click="OnRotateCw" IsEnabled="False"
                                ToolTip.Tip="Rotate 90° CW  (Shift+R)" Padding="6,3">
                            <mi:MaterialIcon Kind="RotateRight" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="MirrorHBtn" Click="OnMirrorH" IsEnabled="False"
                                ToolTip.Tip="Mirror Horizontal  (M)" Padding="6,3">
                            <mi:MaterialIcon Kind="FlipHorizontal" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="MirrorVBtn" Click="OnMirrorV" IsEnabled="False"
                                ToolTip.Tip="Mirror Vertical  (Shift+M)" Padding="6,3">
                            <mi:MaterialIcon Kind="FlipVertical" Width="16" Height="16"/>
                        </Button>
                        <Button Classes.ToolActive="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Instance}"
                                Click="OnInstanceTool" ToolTip.Tip="Instance… (place a cell reference)" Padding="6,3">
                            <mi:MaterialIcon Kind="ViewGridPlusOutline" Width="16" Height="16"/>
                        </Button>
                        <!-- The "Parametric Cell…" toolbar button that used to sit here (a picker
                             listing every registered generator) was removed by owner request —
                             PCells are placed by dragging one out of the palette. The picker dialog
                             and the view-model's PlaceablePCells/BeginPCellPlacement pair are kept:
                             the palette drop path is the same placement gesture. -->

                        <!-- PCell pin overlay toggle (docs/sonnet-briefs/brief-L5-followups-2.md §6,
                             R-L5g-15) — default on; view preference only, never model state. Native
                             ToggleButton :checked chrome (Fluent theme) is the active-state cue here —
                             the local Button.ToolActive style above only selects Button, not
                             ToggleButton, so it does not apply. -->
                        <ToggleButton IsChecked="{Binding ActiveViewModel.ShowPCellPins}"
                                      ToolTip.Tip="Show PCell pins" Padding="6,3">
                            <mi:MaterialIcon Kind="PinOutline" Width="16" Height="16"/>
                        </ToggleButton>

                        <!-- The two EM MESH toggles used to sit here, between the PCell pin toggle and
                             the snap toggles. They now sit beside the EM Setup button further along
                             this toolbar (owner, 2026-08-17): all three are the same subject, and the
                             two that show what a solve produced belong next to the one that sets it
                             up rather than among the drawing-tool toggles. -->

                        <!-- Geometry snap toggles (docs/sonnet-briefs/brief-snap-distance-and-geometry-
                             snap.md R-snp-6/7) — exactly two, per the brief's own guardrail against a
                             per-feature-type settings thicket. F3/'s' also toggle the first; Alt
                             suppresses (never enables) both while held. -->
                        <ToggleButton IsChecked="{Binding ActiveViewModel.GeometrySnapEnabled}"
                                      ToolTip.Tip="Geometry snap  (F3 / S)" Padding="6,3">
                            <mi:MaterialIcon Kind="Magnet" Width="16" Height="16"/>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ActiveViewModel.IncludeIntersectionsEnabled}"
                                      ToolTip.Tip="Snap to intersections" Padding="6,3">
                            <mi:MaterialIcon Kind="VectorIntersection" Width="16" Height="16"/>
                        </ToggleButton>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- Save .clay — mirrors SchematicView's own Save button exactly (same
                             placement relative to the hierarchy-navigation group, same icon). -->
                        <Button Click="OnSaveClay"
                                ToolTip.Tip="Save layout  (Ctrl+S)"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="ContentSave" Width="16" Height="16"/>
                        </Button>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- Hierarchy navigation (L3b) — mirrors SchematicView's Push Into Cell / Pop
                             Out toolbar buttons exactly: same icons, same Classes, always visible,
                             enabled state managed in code-behind (UpdateHierarchyButtonStates). -->
                        <Button x:Name="PushInBtn"
                                Classes="SelectionBtn"
                                Click="OnToolbarPushIn"
                                ToolTip.Tip="Push Into Cell  (Ctrl+])"
                                IsEnabled="False"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="ArrowDown" Width="16" Height="16"/>
                        </Button>

                        <Button x:Name="PopOutBtn"
                                Classes="SelectionBtn"
                                Click="OnToolbarPopOut"
                                ToolTip.Tip="Pop Out  (Ctrl+[)"
                                IsEnabled="False"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="ArrowUp" Width="16" Height="16"/>
                        </Button>

                        <!-- ── The two wBond panels (wbond.md §10.1) ────────────────────────────
                             Shown only on a WIREBOND CELL (a `.wBond` beside the `.clay`, WB40) and only
                             where there is a dock to put a panel in — so they are absent from every
                             ordinary layout and from the standalone wBond app, whose own window hosts
                             both panels inline and has no dock at all (owner, 2026-08-17).

                             They TOGGLE: a second press closes what the first opened. That is what makes
                             them read as state rather than as two more "open something" buttons, and it
                             is why they are not the View ▸ Panels command. -->
                        <Border x:Name="WirePanelSeparator" Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- ToggleButtons, not Buttons (owner, 2026-08-17: "the toolbar buttons do not
                             indicate whether those panels are currently in view"). They already TOGGLE,
                             so the checked chrome is simply saying what the next press will do. The
                             checked state is pushed from code-behind, never two-way bound: the truth is
                             the dock tree, which a panel closed by its own tab X also changes. -->
                        <ToggleButton x:Name="WireProfileBtn"
                                      Click="OnToggleWireProfilePanel"
                                      ToolTip.Tip="Wire Profile panel  (P)"
                                      Padding="6,3">
                            <mi:MaterialIcon Kind="ChartBellCurve" Width="16" Height="16"/>
                        </ToggleButton>

                        <ToggleButton x:Name="WireInductanceBtn"
                                      Click="OnToggleWireInductancePanel"
                                      ToolTip.Tip="Array Inductance panel  (A)"
                                      Padding="6,3">
                            <mi:MaterialIcon Kind="TableLarge" Width="16" Height="16"/>
                        </ToggleButton>

                        <!-- Draw Wire (owner, 2026-08-17) — the third button gated on this cell having
                             wires at all, and it sits with the other two because all three only exist
                             on a wirebond cell.

                             Bound rather than pushed from code-behind, unlike its two neighbours: this
                             one IS view-model state (the session owns it, so Escape and the W key can
                             reach it), where their state is the dock tree's. A binding also re-points
                             itself on a push-in, which the code-behind path has to be told to do. -->
                        <ToggleButton x:Name="WireDrawBtn"
                                      IsChecked="{Binding ActiveViewModel.WireDrawArmed}"
                                      ToolTip.Tip="Draw Wire  (W) — click the start foot, then the end foot; Escape disarms"
                                      Padding="6,3">
                            <mi:MaterialIcon Kind="VectorPolyline" Width="16" Height="16"/>
                        </ToggleButton>

                        <!-- Angle Wire (owner, 2026-08-17). NOT the toolbar's Rotate button, which
                             turns the whole selection 90° as a rigid body exactly as it turns a
                             rectangle — and which now carries the wires too. This is the gesture that
                             makes an ANGLED wire: grab one near the end you want to move and swing it,
                             with the far end anchored. The whole swing was already implemented on the
                             overlay (WB26a) and had no way in from this editor. -->
                        <ToggleButton x:Name="WireRotateBtn"
                                      IsChecked="{Binding ActiveViewModel.WireRotateArmed}"
                                      ToolTip.Tip="Angle Wire  (Alt+R) — swing a wire about its far end; Shift snaps to 45°, Escape disarms"
                                      Padding="6,3">
                            <mi:MaterialIcon Kind="AngleAcute" Width="16" Height="16"/>
                        </ToggleButton>

                        <!-- Transform… — the wBond editor's own dialog (rotate/scale/translate the
                             wire selection by typed numbers), which this editor had no entry point for
                             (owner, 2026-08-17). Gated on a wire SELECTION as well as on the cell
                             having wires: the dialog's whole subject is what is selected. -->
                        <Button x:Name="WireTransformBtn"
                                Click="OnWireTransform"
                                ToolTip.Tip="Transform Wires…  (T) — rotate, scale or move the selected wires by typed values"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="AxisArrow" Width="16" Height="16"/>
                        </Button>

                        <!-- Publish (owner, 2026-08-18: "the export UI can't be accessed from circuitRF
                             — only from wBond", then "I still don't see any of the new buttons in the
                             wBond hosted layout. They are supposed to appear to the right of the
                             Transform button").

                             THE WIRE GROUP USED TO END AT TRANSFORM, and that was the whole bug. A
                             `.clay` with a `.wBond` beside it (WB40) is how a wirebond is normally worked
                             on inside circuitRF, and THERE IS NO WBondEditorView ANYWHERE IN THAT
                             DOCUMENT — its own toolbar row, which carries Export Touchstone and Compare,
                             is only on screen when a `.wBond` is opened as a document of its own or in
                             the standalone binary. So both of those actions were unreachable from the
                             editor most of this work is done in.

                             Both go through WBondPublishCommands, the same one WBondEditorView calls —
                             never a second implementation of the picker flow. They are gated by
                             UpdateWirePanelButtonStates alongside the rest of the group. -->
                        <Button x:Name="WireExportTouchstoneBtn"
                                Click="OnWireExportTouchstone"
                                ToolTip.Tip="Export wBond to Touchstone (.sNp)… Choose the model, reference impedance, frequency sweep and port basis in the dialog."
                                Padding="6,3">
                            <mi:MaterialIcon Kind="SineWave" Width="16" Height="16"/>
                        </Button>

                        <Button x:Name="WireCompareModelBtn"
                                Click="OnWireCompareDistributedModel"
                                ToolTip.Tip="wBond Comparison… — run the distributed (MoM) model next to the lumped one on a frequency grid."
                                Padding="6,3">
                            <mi:MaterialIcon Kind="ScaleBalance" Width="16" Height="16"/>
                        </Button>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- L5b DRC (docs/design/layout-view.md §9A). On the toolbar as well as the
                             Design menu because a check is something a user runs repeatedly while
                             fixing what it found — reaching for a menu each time is the difference
                             between a check people use and one they run once. -->
                        <Button Click="OnCheckDesignRules"
                                ToolTip.Tip="Check Design Rules (Ctrl/⌘+Shift+K)"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="ShieldCheckOutline" Width="16" Height="16"/>
                        </Button>

                        <!-- EM (owner request, 2026-08-09): the only EM entry point outside the .cem
                             editor itself. Opens this layout's own EM setup, creating it (named after
                             the layout file) the first time. Sits beside Check Design Rules because
                             both are "run something over this whole layout" actions. -->
                        <Button Click="OnOpenEmSetup"
                                ToolTip.Tip="EM Setup for this layout — opens it, creating it the first time"
                                Padding="6,3">
                            <mi:MaterialIcon Kind="SineWave" Width="16" Height="16"/>
                        </Button>

                        <!-- The two mesh overlays, immediately RIGHT of EM Setup (owner, 2026-08-17)
                             — "these are all related items so they should be close together".

                             EM mesh overlay toggle (brief-L6-L7-em-ui.md R-em-15): a session-only view
                             preference, never model state, drawing nothing until a .cem's Mesh button
                             has produced one. Native ToggleButton :checked chrome (Fluent) is the
                             active-state cue — the local Button.ToolActive style selects Button only. -->
                        <ToggleButton IsChecked="{Binding ActiveViewModel.ShowEmMesh}"
                                      ToolTip.Tip="Show EM cross-section mesh" Padding="6,3">
                            <mi:MaterialIcon Kind="GridLarge" Width="16" Height="16"/>
                        </ToggleButton>

                        <!-- The PLAN-VIEW surface mesh (L8b D5) had no toggle of its own, so a
                             full-wave mesh could only be turned off by closing the document. Same
                             session-only contract; independent of the cross-section toggle, because
                             which overlay a document shows follows from which mesh was computed. -->
                        <ToggleButton IsChecked="{Binding ActiveViewModel.ShowPlanarMesh}"
                                      ToolTip.Tip="Show full-wave surface mesh" Padding="6,3">
                            <mi:MaterialIcon Kind="Grid" Width="16" Height="16"/>
                        </ToggleButton>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- GDSII export (docs/sonnet-briefs/brief-L4a-gdsii-interchange.md) — a
                             whole-hierarchy operation, so it sits with Insert Bitmap/Instance rather
                             than under any single drawing tool. -->
                        <Button Click="OnExportGdsii" ToolTip.Tip="Export GDSII…" Padding="6,3">
                            <mi:MaterialIcon Kind="ExportVariant" Width="16" Height="16"/>
                        </Button>

                        <!-- DXF export (docs/sonnet-briefs/brief-L4b-dxf-interchange.md) — same
                             whole-hierarchy shape as Export GDSII, sits alongside it. -->
                        <Button Click="OnExportDxf" ToolTip.Tip="Export DXF…" Padding="6,3">
                            <mi:MaterialIcon Kind="FileExportOutline" Width="16" Height="16"/>
                        </Button>

                        <!-- Gerber/Excellon export (docs/sonnet-briefs/brief-L4c-gerber-export.md) —
                             closes Phase L4; whole-hierarchy export, no import, sits alongside GDSII/DXF. -->
                        <Button Click="OnExportGerber" ToolTip.Tip="Export Gerber…" Padding="6,3">
                            <mi:MaterialIcon Kind="FileChartOutline" Width="16" Height="16"/>
                        </Button>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <TextBlock Text="Layer:" VerticalAlignment="Center" FontSize="11" Margin="4,0,0,0"/>
                        <ComboBox ItemsSource="{Binding ActiveViewModel.AvailableLayers}"
                                  SelectedItem="{Binding ActiveViewModel.CurrentLayerItem, Mode=TwoWay}"
                                  FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center"
                                  MinWidth="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="lay:LayerPickerItem">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="12" Height="12" CornerRadius="2"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding SwatchColor}"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Width="1" VerticalAlignment="Stretch" Margin="2,3"
                                Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <!-- RoundedRect corner radius -->
                        <TextBlock Text="Radius:" VerticalAlignment="Center" FontSize="11"
                                   IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=RoundedRect}"/>
                        <TextBox Text="{Binding ActiveViewModel.CornerRadiusText}" Width="70" FontSize="11" Padding="4,2"
                                 IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=RoundedRect}"
                                 LostFocus="OnCornerRadiusCommit" KeyDown="OnCornerRadiusKeyDown"/>

                        <!-- Path width + end style -->
                        <TextBlock Text="Width:" VerticalAlignment="Center" FontSize="11"
                                   IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Path}"/>
                        <TextBox Text="{Binding ActiveViewModel.PathWidthText}" Width="70" FontSize="11" Padding="4,2"
                                 IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Path}"
                                 LostFocus="OnPathWidthCommit" KeyDown="OnPathWidthKeyDown"/>
                        <ComboBox ItemsSource="{x:Static lay:LayoutEditorViewModel.AllPathEndStyles}"
                                  SelectedItem="{Binding ActiveViewModel.CurrentPathEndStyle, Mode=TwoWay}"
                                  FontSize="11" Padding="6,2" MinHeight="0" VerticalContentAlignment="Center"
                                  IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Path}"/>

                        <!-- Label height -->
                        <TextBlock Text="Height:" VerticalAlignment="Center" FontSize="11"
                                   IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Label}"/>
                        <TextBox Text="{Binding ActiveViewModel.LabelHeightText}" Width="70" FontSize="11" Padding="4,2"
                                 IsVisible="{Binding ActiveViewModel.ActiveTool, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Label}"
                                 LostFocus="OnLabelHeightCommit" KeyDown="OnLabelHeightKeyDown"/>

                        <!-- Live Rect W/H — typed commit while a Rect drag is live (gate 9) -->
                        <TextBlock Text="W:" VerticalAlignment="Center" FontSize="11"
                                   IsVisible="{Binding ActiveViewModel.IsDrawingRect}"/>
                        <TextBox x:Name="DrawWidthBox" Text="{Binding ActiveViewModel.DrawWidthText}" Width="70" FontSize="11" Padding="4,2"
                                 IsVisible="{Binding ActiveViewModel.IsDrawingRect}"
                                 LostFocus="OnDrawWidthCommit" KeyDown="OnDrawWidthKeyDown"/>
                        <TextBlock Text="H:" VerticalAlignment="Center" FontSize="11"
                                   IsVisible="{Binding ActiveViewModel.IsDrawingRect}"/>
                        <TextBox x:Name="DrawHeightBox" Text="{Binding ActiveViewModel.DrawHeightText}" Width="70" FontSize="11" Padding="4,2"
                                 IsVisible="{Binding ActiveViewModel.IsDrawingRect}"
                                 LostFocus="OnDrawHeightCommit" KeyDown="OnDrawHeightKeyDown"/>

                        <TextBlock Text="{Binding ActiveViewModel.DrawReadoutText}" VerticalAlignment="Center" FontSize="11"
                                   FontWeight="SemiBold" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- ── Breadcrumb bar (L3b) — visible only when pushed in (CanPopOut) ────────────────── -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding CanPopOut}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"
                Padding="4,1">
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">

                <!-- Pop to Top button -->
                <Button x:Name="PopToTopBtn"
                        Click="OnPopToTop"
                        ToolTip.Tip="Pop to Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="Home" Width="13" Height="13"/>
                </Button>

                <!-- Divider between Pop to Top and crumb list -->
                <Border Width="1" VerticalAlignment="Stretch" Margin="2,2"
                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                <!-- Crumb list -->
                <ItemsControl x:Name="BreadcrumbItems"
                              ItemsSource="{Binding Breadcrumbs}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lay:LayoutBreadcrumbItem">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Separator glyph before non-first crumbs -->
                                <TextBlock Text=" ▸ "
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           IsVisible="{Binding IsNotFirst}"/>
                                <!-- Crumb button: flat/link style, bold+inert when current -->
                                <Button Classes="LayoutBreadcrumbBtn"
                                        Classes.LayoutBreadcrumbCurrent="{Binding IsCurrent}"
                                        IsEnabled="{Binding !IsCurrent}"
                                        Content="{Binding Text}"
                                        Tag="{Binding FrameIndex}"
                                        Click="OnBreadcrumbClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ── Metadata bar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel.Styles>
                    <Style Selector="TextBlock.label">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
                    </Style>
                    <Style Selector="TextBlock.value">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>

<!-- Unit and Snap: same font, same HEIGHT, left-aligned; Snap wider.

                         Two Avalonia facts drive every setter here, and ignoring them is what made
                         an earlier attempt look worse than the original:

                         1. An EDITABLE ComboBox (Snap) is templated around an inner TextBox with its
                            OWN padding, min-height and font; a NON-EDITABLE one (Unit) is templated
                            around a plain ContentPresenter. So identical Padding/FontSize on the two
                            ComboBoxes still yields DIFFERENT heights, and the inner TextBox does not
                            necessarily take the outer FontSize. Height is therefore pinned explicitly
                            on both, and the font is pushed into the inner TextBox by name.
                         2. The template reserves space for the drop-down chevron. Squeezing Width
                            clips the content presenter on BOTH sides — so width is expressed as
                            MinWidth (a floor, never a cap) and the padding is left at the value the
                            template expects, rather than shrunk. -->
                    <Style Selector="ComboBox.metaCombo">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <!-- Reaches the editable variant's inner TextBox, which would otherwise keep the
                         theme's own font size and make "same font size" quietly untrue. -->
                    <Style Selector="ComboBox.metaCombo /template/ TextBox">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Styles>

                <!-- The "1 DBU = 1 nm" readout was removed from this bar (owner, 2026-07-30):
                     the database resolution is fixed per document and set at creation, so it is not
                     something to monitor at a glance. LayoutEditorViewModel.ResolutionText is kept
                     for anywhere that genuinely needs to state it. -->

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Technology:"/>
                    <!-- Two actions behind the ▾, rather than the click going straight to Change:
                         Edit opens the .ctech as an ordinary document (the layer table, stackup and
                         DRC rules are all there); Change… re-targets this layout at a different
                         technology. Declared once in XAML and owned by the framework — never built
                         per click, which is the menu-stacking bug fixed twice already here. -->
                    <Button Padding="2,0" MinHeight="0" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Technology">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Classes="value" Text="{Binding ActiveViewModel.TechSummaryText}"/>
                            <!-- A Material icon, NOT a "▾" text glyph. No circuitRF typeface covers
                                 U+25BE, so Skia substituted a platform font for it — which the docs
                                 factory then had to ship a 2.1 MB fallback family for, to render one
                                 character in two figures. Every other chevron in this application is
                                 already this icon. -->
                            <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12"
                                             VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Edit" Click="OnEditTechnologyClick"/>
                                <MenuItem Header="Change Technology…" Click="OnChangeTechnologyClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Unit:"/>
                    <ComboBox Classes="metaCombo" MinWidth="64"
                              ItemsSource="{x:Static lay:LayoutEditorViewModel.AllUnits}"
                              SelectedItem="{Binding ActiveViewModel.DisplayUnit, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ToLower}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Snap:"/>
                    <!-- R-snp-1/2/3: editable ladder + typed entry, bound to SnapDbu (never SnapText).
                         IsEditable lets the user either pick a technology-relative preset or type any
                         unit-suffixed value ("2.5mil"); commits on LostFocus/Enter, mirroring the
                         staged-text idiom every other dimension field in this toolbar already uses. -->
                    <ComboBox Classes="metaCombo" MinWidth="90"
                              ItemsSource="{Binding ActiveViewModel.SnapLadderOptions}"
                              IsEditable="True"
                              Text="{Binding ActiveViewModel.SnapDistanceText, Mode=TwoWay}"
                              LostFocus="OnSnapDistanceCommit" KeyDown="OnSnapDistanceKeyDown"
                              SelectionChanged="OnSnapDistanceSelectionChanged"
                              ToolTip.Tip="Snap distance — F9 toggles on/off"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Shapes:"/>
                    <TextBlock Classes="value" Text="{Binding ActiveViewModel.ShapeCountText}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Instances:"/>
                    <TextBlock Classes="value" Text="{Binding ActiveViewModel.InstanceCountText}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="Extent:"/>
                    <TextBlock Classes="value" Text="{Binding ActiveViewModel.ExtentText}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="label" Text="X:"/>
                    <TextBlock Classes="value" Text="{Binding ActiveViewModel.CursorXText}"/>
                    <TextBlock Classes="label" Text="Y:"/>
                    <TextBlock Classes="value" Text="{Binding ActiveViewModel.CursorYText}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Canvas + rulers ──────────────────────────────────────────────── -->
        <!-- Nested DockPanels (not a Grid) — the same hosting shape SchematicCanvas/SymbolEditorCanvas
             already use, kept here for consistency. See the L1b post-ship-fix-2 note in
             src/Ui/CLAUDE.md for what is and is not confirmed about the reported toolbar-visibility
             issue — the Grid-vs-DockPanel choice was never actually shown to matter. -->
        <DockPanel>

            <!-- Top row: corner box + horizontal ruler -->
            <DockPanel x:Name="RulerRow" DockPanel.Dock="Top" Height="22">
                <Border DockPanel.Dock="Left" Width="22"
                        Background="{DynamicResource SystemChromeMediumLowColor}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,1,1"/>
                <ctrl:LayoutRulerControl x:Name="HRuler" Orientation="Horizontal" ClipToBounds="True"/>
            </DockPanel>

            <ctrl:LayoutRulerControl x:Name="VRuler" DockPanel.Dock="Left" Width="22" Orientation="Vertical" ClipToBounds="True"/>

            <Panel>
                <!-- An empty layout renders as a plain canvas with the background grid showing — no
                     placeholder overlay (owner report: the L0b placeholder used to cover the grid with
                     an opaque background, making a fresh layout look broken/blank rather than ready to
                     draw on). -->
                <ctrl:LayoutCanvas x:Name="LayoutCanvasCtrl" ViewModel="{Binding ActiveViewModel}" ClipToBounds="True">
                    <!-- L1-fix (brief-L1-fix-context-menu-stacking.md): ONE ContextMenu instance,
                         declared here and opened by Avalonia itself — mirrors SymbolEditorView.axaml's
                         bitmap context menu. LayoutCanvas never constructs a ContextMenu of its own. -->
                    <ctrl:LayoutCanvas.ContextMenu>
                        <ContextMenu Opening="OnLayoutContextMenuOpening"/>
                    </ctrl:LayoutCanvas.ContextMenu>
                </ctrl:LayoutCanvas>
            </Panel>

        </DockPanel>

    </DockPanel>

</UserControl>
