
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             xmlns:cv="using:CircuitRF.Ui.DataDisplay.Converters"
             xmlns:ctl="using:CircuitRF.Ui.DataDisplay.Controls"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:PlotInspectorViewModel"
             x:Class="CircuitRF.Ui.Views.DataDisplay.PlotInspectorView"
             MaxWidth="430">

    <Design.DataContext>
        <x:Static Member="vm:PlotInspectorViewModel.DesignInstance"/>
    </Design.DataContext>

    <UserControl.Resources>
        <cv:DoubleToDecimalConverter             x:Key="D2D"/>
        <cv:LineTypeToDashArrayConverter         x:Key="LTD"/>
        <cv:SkColorToAvaloniaColorConverter      x:Key="SKC"/>
        <cv:EnumUpperConverter                   x:Key="EnumUpper"/>
        <sys:Double x:Key="FontSize">10</sys:Double>

        <!-- The IconSelectButton ControlTheme used to be declared HERE. It now lives at
             application scope (Styles/SegmentedSelect.axaml), because the Match Designer uses the
             same control and a second copy of the template is a copy that stops matching. Nothing
             else changed: the theme resolves by {x:Type} exactly as it did from this dictionary. -->

    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ── Segmented toggle buttons ─────────────────────────────────────
             The BASE look (Button.seg-btn, and the .active accent on its ContentPresenter) is an
             application-scope style now — see Styles/CircuitRfStyles.axaml. What stays here is the
             part that names controls only the Data Display hosts. -->
        <!-- grey icons in the default (non-active) state -->
        <Style Selector="Button.seg-btn mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="Button.seg-btn ctl|PlotTypeGlyphControl">
            <Setter Property="Stroke" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <!-- white glyphs when active -->
        <Style Selector="Button.seg-btn.active mi|MaterialIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.seg-btn.active ctl|PlotTypeGlyphControl">
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <!-- ── Trace-card remove (trash) button ─────────────────────────── -->
        <Style Selector="Button.removeTrace">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Foreground"       Value="{DynamicResource CrfIconBrush}"/>
            <Setter Property="Padding"          Value="4"/>
            <Setter Property="MinWidth"         Value="0"/>
        </Style>
        <Style Selector="Button.removeTrace:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.removeTrace:pointerover mi|MaterialIcon">
            <Setter Property="Foreground" Value="Red"/>
        </Style>

        <!-- ── Opacity-tiered field labels: FontSize 10, ~0.6 opacity ──── -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Opacity"           Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- A TextBlock has no disabled look of its own, so a label beside a greyed control stayed
             at full strength and read as live. It matters now that the pattern scale controls are
             DISABLED rather than hidden (see the note in section B row 1b): "Floor" and "Rings" sit
             beside boxes that grey, and a label that does not follow them says the row is usable. -->
        <Style Selector="TextBlock.label:disabled">
            <Setter Property="Opacity" Value="0.25"/>
        </Style>

        <!-- ── Broken-source trace label uses CrfWarningBrush ──────────── -->
        <Style Selector="TextBlock.brokenSource">
            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
            <Setter Property="FontStyle"  Value="Italic"/>
        </Style>

        <!-- ── Trace card: filled rounded card with subtle outline ─────── -->
        <Style Selector="Border.traceCard">
            <Setter Property="Background"     Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="8,7"/>
            <Setter Property="Margin"         Value="0,0,0,4"/>
        </Style>

        <!-- ── Summary card: drop the per-card outline (one shared outline wraps them all,
             see Border.summaryOutline). One row per card, so many borders read as clutter. -->
        <Style Selector="Border.traceCard.summaryCard">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius"   Value="0"/>
            <Setter Property="Padding"        Value="4,3"/>
            <Setter Property="Margin"         Value="0"/>
        </Style>

        <!-- ── Single outline around the whole summary-card list (toggled by Classes.summaryOutline). -->
        <Style Selector="Border.summaryOutline">
            <Setter Property="Background"      Value="{DynamicResource SystemChromeLowColor}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource CrfTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="4"/>
        </Style>

        <!-- ── Base compact style — ALL ComboBoxes in this inspector ────── -->
        <Style Selector="ComboBox">
            <Setter Property="FontSize"                    Value="10"/>
            <Setter Property="MinHeight"                   Value="0"/>
            <Setter Property="Padding"                     Value="4,1"/>
            <Setter Property="Height"                      Value="22"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
        </Style>
        <!-- Keep .compact as no-op for compatibility -->
        <Style Selector="ComboBox.compact"/>
        <!-- Hide the dropdown chevron and collapse its column to zero width -->
        <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width"     Value="0"/>
            <Setter Property="MinWidth"  Value="0"/>
        </Style>
        <!-- Span the content presenter across both grid columns so no gap remains -->
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin"          Value="0"/>
        </Style>

        <Style Selector="ComboBoxItem:disabled">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>
        <Style Selector="ComboBoxItem:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumLowColor}"/>
        </Style>

        <!-- ── NumericUpDown ─────────────────────────────────────────────── -->
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize"                 Value="{StaticResource FontSize}"/>
            <Setter Property="Height"                   Value="16"/>
            <Setter Property="MinWidth"                 Value="10"/>
            <Setter Property="Padding"                  Value="2,0"/>
            <Setter Property="ShowButtonSpinner"        Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Slider ────────────────────────────────────────────────────── -->
        <!-- No explicit Height — let the Fluent template center track+thumb naturally.
             Negative vertical margin shrinks the layout footprint to keep row heights tight. -->
        <Style Selector="Slider">
            <Setter Property="Margin"              Value="2,-7"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement"       Value="None"/>
            <Setter Property="TickFrequency"       Value="0.1"/>
        </Style>
    </UserControl.Styles>

    <!-- Outer inspector panel: SystemChromeMediumLowColor rounded card -->
    <Border Background="{DynamicResource SystemChromeMediumLowColor}"
            CornerRadius="8"
            Padding="10">
        <StackPanel Spacing="6">

            <!-- ── §B Row 1: Segmented plot-type header (centered) ───────── -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="0">

                <Button Classes="seg-btn"
                        Classes.active="{Binding IsRectPlot}"
                        Command="{Binding SetPlotTypeRectCommand}"
                        ToolTip.Tip="Rectangular">
                    <mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                </Button>

                <Button Classes="seg-btn"
                        Classes.active="{Binding IsSmithPlot}"
                        Command="{Binding SetPlotTypeSmithCommand}"
                        ToolTip.Tip="Smith Chart">
                    <ctl:PlotTypeGlyphControl Kind="Smith" Width="16" Height="16"/>
                </Button>

                <Button Classes="seg-btn"
                        Classes.active="{Binding IsPolarPlot}"
                        Command="{Binding SetPlotTypePolarCommand}"
                        ToolTip.Tip="Polar">
                    <ctl:PlotTypeGlyphControl Kind="Polar" Width="16" Height="16"/>
                </Button>

                <Button Classes="seg-btn"
                        Classes.active="{Binding IsTablePlot}"
                        Command="{Binding SetPlotTypeTableCommand}"
                        ToolTip.Tip="Table">
                    <mi:MaterialIcon Kind="TableLarge" Width="16" Height="16"/>
                </Button>

                <!-- ANT-10: the 3D pattern surface. LAST in the row, and the tooltip says what it is
                     for, because the cuts beside it tell an engineer more about an antenna and this
                     must not read as the better one. -->
                <Button Classes="seg-btn"
                        Classes.active="{Binding IsSurfacePlot}"
                        Command="{Binding SetPlotTypeSurfaceCommand}"
                        ToolTip.Tip="3D pattern — for seeing a pattern is not the shape you assumed, and for the picture that goes in a report. The principal-plane cuts say more about an antenna.">
                    <mi:MaterialIcon Kind="Sphere" Width="16" Height="16"/>
                </Button>

                <Button Classes="seg-btn"
                        Click="OnPlotTypeHelp"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Plot type help">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="15" Height="15"/>
                </Button>

            </StackPanel>

            <!-- ── §B Row 1b: the polar RADIAL mode (ANT-7 §2) ─────────────
                 Polar only. "dB" turns the radius into an antenna pattern: the outer ring is a
                 reference, the centre is a floor, and everything below the floor is drawn AT the
                 floor rather than dropped — a gap would read as a null in the antenna. The plot
                 states which reference it is using, so an unlabelled normalised pattern cannot be
                 produced from here.

                 A WRAP PANEL, not a row (owner report, 2026-09-11: the unit control was clipped at
                 the right edge of the Plot Inspector). Eight controls of fixed width cannot be made
                 to fit a panel the user is free to narrow, and a horizontal StackPanel does not
                 report that: it lays out past its own edge and the last child is simply cut in half.
                 Each label travels with the control it names, so a group that drops to the next line
                 drops whole. -->
            <WrapPanel IsVisible="{Binding HasPatternControls}">

                <!-- The mode switch is the POLAR plot's; a surface's radius is dB by construction and
                     has no linear reading to offer, so the checkbox is not shown for it. Everything
                     after it is the SCALE, which both kinds have and both read the same way.
                     The ROW is gated on HasPatternControls, not HasPatternScale: this switch is the
                     only way INTO dB mode, so gating it on already being in dB mode hid it on every
                     polar plot that had not been authored as a pattern elsewhere.

                     THE SCALE CONTROLS ARE DISABLED, NEVER HIDDEN. Reported 2026-09-11: unchecking
                     dB radial made a row of controls disappear and shrank the Plot Inspector's own
                     width with them. They were IsVisible-gated on HasPatternScale, so
                     one checkbox changed the width of the whole panel and moved every control below
                     it. Greyed out, the row keeps its size and the reason the controls are inert is
                     visible: the checkbox they sit beside is the one that turns them on. -->
                <CheckBox Content="dB radial"
                          IsChecked="{Binding PolarRadialIsDb, Mode=TwoWay}"
                          IsVisible="{Binding IsPolarPlot}"
                          FontSize="11" Margin="0,0,8,2"
                          ToolTip.Tip="Read the radius in decibels — an antenna pattern"/>

                <!-- Bearings around the rim. A POLAR plot's, either radial mode: a locus has a
                     bearing too, it is just the phase rather than a direction, and the grid prints
                     whichever convention the plot is actually drawn in. -->
                <CheckBox Content="Angles"
                          IsChecked="{Binding PolarAngleLabels, Mode=TwoWay}"
                          IsVisible="{Binding IsPolarPlot}"
                          FontSize="11" Margin="0,0,8,2"
                          ToolTip.Tip="Print the bearing every 30° around the outside of the disc, with a spoke to each. The disc shrinks to make room rather than the numbers overprinting the outer ring."/>

                <CheckBox Content="Normalise"
                          IsChecked="{Binding PolarDbNormalised, Mode=TwoWay}"
                          IsEnabled="{Binding HasPatternScale}"
                          FontSize="11" Margin="0,0,8,2"
                          ToolTip.Tip="Outer ring = the peak of every trace on this plot (0 dB). Unchecked, the outer ring is the absolute level beside it."/>

                <!-- The outer-ring level. It carries a LABEL now that the panel wraps: an unlabelled
                     spinner that has dropped onto its own line names nothing.

                     THE THREE SPINNERS ARE 42 px, not the 72/68/58 they were (owner, 2026-09-11:
                     narrow them, three characters is enough). 42 rather than a literal three
                     characters because the widest LEGAL value of two of them is four — Ref and Floor
                     both reach -200 — and a control that clips a value the spinner itself will
                     produce is a worse trade than the few pixels. The Unit combo is FIXED at the
                     width of "dB(W/sr)", the longest unit the list offers, rather than a MinWidth
                     that a longer unit from a file could grow. -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Ref" Classes="label"
                               IsEnabled="{Binding CanEditPolarDbReference}"/>
                    <NumericUpDown Value="{Binding PolarDbReferenceValue, Mode=TwoWay}"
                                   IsEnabled="{Binding CanEditPolarDbReference}"
                                   Minimum="-200" Maximum="200" Increment="1"
                                   Width="42" Padding="4,3" FontSize="11"
                                   ShowButtonSpinner="False"
                                   ToolTip.Tip="Outer-ring level, absolute"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Floor" Classes="label"
                               IsEnabled="{Binding HasPatternScale}"/>
                    <NumericUpDown Value="{Binding PolarDbFloor, Mode=TwoWay}"
                                   IsEnabled="{Binding HasPatternScale}"
                                   Minimum="-200" Maximum="-1" Increment="5"
                                   Width="42" Padding="4,3" FontSize="11"
                                   ShowButtonSpinner="False"
                                   ToolTip.Tip="Decibels from the outer ring down to the centre"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Rings" Classes="label"
                               IsEnabled="{Binding HasPatternScale}"/>
                    <NumericUpDown Value="{Binding PolarDbRingStep, Mode=TwoWay}"
                                   IsEnabled="{Binding HasPatternScale}"
                                   Minimum="0.5" Maximum="100" Increment="5"
                                   Width="42" Padding="4,3" FontSize="11"
                                   ShowButtonSpinner="False"
                                   ToolTip.Tip="Ring spacing, dB"/>
                </StackPanel>

                <!-- A COMBO BOX, not a text box (owner request, 2026-09-11). The radial unit is one
                     of a handful of spellings an antenna quantity is quoted in, and a free text box
                     invited a typo that would have been printed around the plot as though it meant
                     something. The list is open at the bottom rather than closed: a unit that
                     arrived from a `.cdd` or from the CLI's own db-unit flag, and is not one of the
                     standard rows is added to the list so it can be seen and re-selected, never
                     silently replaced. The first row is the cube's own unit. -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2"
                            VerticalAlignment="Center">
                    <TextBlock Text="Unit" Classes="label"
                               IsEnabled="{Binding HasPatternScale}"/>
                    <ComboBox ItemsSource="{Binding PolarDbUnitOptions}"
                              SelectedItem="{Binding PolarDbUnitSelection, Mode=TwoWay}"
                              IsEnabled="{Binding HasPatternScale}"
                              Width="86" Padding="5,3" FontSize="11"
                              ToolTip.Tip="Unit the radial numbers are in. The first row — the dash — takes the cube's own: dB(W/sr) for a radiation intensity, dBi for a gain. Every other row states one outright."/>
                </StackPanel>
            </WrapPanel>

            <!-- ── §B Row 1c: the 3D view (ANT-10 §3) ──────────────────────
                 Rotate and zoom are GESTURES on the plot itself (drag, wheel); what belongs here is
                 the part a gesture answers badly — which way am I looking — plus the reset that
                 undoes both. The two principal planes are named by their own φ: which of them is the
                 E-plane is a property of the antenna's polarization and the cube does not say. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        IsVisible="{Binding IsSurfacePlot}">

                <Button Classes="seg-btn"
                        Classes.active="{Binding SurfaceViewIsIso}"
                        Command="{Binding SurfaceViewIsoCommand}"
                        FontSize="11" Padding="8,3"
                        Content="Iso"
                        ToolTip.Tip="An oblique view, off both principal planes"/>

                <Button Classes="seg-btn"
                        Classes.active="{Binding SurfaceViewIsBroadside}"
                        Command="{Binding SurfaceViewBroadsideCommand}"
                        FontSize="11" Padding="8,3"
                        Content="Broadside"
                        ToolTip.Tip="Looking straight down the z axis at the zenith"/>

                <Button Classes="seg-btn"
                        Classes.active="{Binding SurfaceViewIsPhi0}"
                        Command="{Binding SurfaceViewPhi0Command}"
                        FontSize="11" Padding="8,3"
                        Content="φ 0°"
                        ToolTip.Tip="The φ = 0° / 180° plane in the screen"/>

                <Button Classes="seg-btn"
                        Classes.active="{Binding SurfaceViewIsPhi90}"
                        Command="{Binding SurfaceViewPhi90Command}"
                        FontSize="11" Padding="8,3"
                        Content="φ 90°"
                        ToolTip.Tip="The φ = 90° / 270° plane in the screen"/>

                <Button Command="{Binding SurfaceResetCommand}"
                        FontSize="11" Padding="8,3" Margin="6,0,0,0"
                        Content="Reset"
                        ToolTip.Tip="Back to the isometric view at zoom 1"/>

            </StackPanel>

            <!-- ── §B Row 1d: what the scene DRAWS, as opposed to where it is viewed from ───
                 Split off Row 1c on owner report, 2026-09-11: the eight controls together were wider
                 than the inspector and the colour-ramp combo was clipped at its right edge. The two
                 rows also divide cleanly — the row above answers "which way am I looking", this one
                 answers "what is in the scene". -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="4"
                        IsVisible="{Binding IsSurfacePlot}">

                <CheckBox Content="Axes"
                          IsChecked="{Binding SurfaceShowAxes, Mode=TwoWay}"
                          FontSize="11"
                          ToolTip.Tip="Draw x, y and z in the scene, on the layout's own orientation"/>

                <CheckBox Content="Legend"
                          IsChecked="{Binding SurfaceShowLegend, Mode=TwoWay}"
                          FontSize="11" Margin="6,0,0,0"
                          ToolTip.Tip="The colour bar down the right, which says what the colours mean. It is drawn at every zoom level; turn it off to give its width back to the scene."/>

                <CheckBox Content="Ground"
                          IsChecked="{Binding SurfaceShowGroundDisc, Mode=TwoWay}"
                          FontSize="11" Margin="6,0,0,0"
                          ToolTip.Tip="The ground plane at θ = 90° — the horizon, and the statement that nothing is modelled below it"/>

                <ComboBox ItemsSource="{Binding SurfaceColorMaps}"
                          SelectedItem="{Binding SurfaceColorMap, Mode=TwoWay}"
                          Width="96" Padding="5,3" FontSize="11"
                          Margin="6,0,0,0"
                          ToolTip.Tip="Colour ramp — the contour plot's own set"/>
            </StackPanel>

            <!-- ── §B Row 2: + Trace (left) / Freq + Font Size (right) ─── -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

                <Button Grid.Column="0"
                        Content="+ Trace"
                        Command="{Binding AddTraceCommand}"
                        FontSize="11"
                        Padding="8,3"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Add trace (clones last, or uses first library SNP)"/>

                <!-- "+ Contour" — shown on Smith/Polar/Rect loadpull sources; hidden on Table (summary mode) -->
                <Button Grid.Column="1"
                        Content="+ Contour"
                        Command="{Binding AddContourTraceCommand}"
                        IsVisible="{Binding CanAddContourInCurrentMode}"
                        FontSize="11"
                        Padding="8,3"
                        Margin="4,0,0,0"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Add loadpull contour trace (requires a loadpull data source)"/>

                <!-- Table mode button: "+ Summary" runs the auto-fill standard-set action (shared column
                     with "+ Contour", mutually exclusive). The separate Auto-fill button was removed —
                     "+ Summary" now populates the standard performance set directly (design feedback). -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            IsVisible="{Binding IsSummaryAddMode}">
                    <Button Content="+ Summary"
                            Command="{Binding AutoFillSummaryCommand}"
                            IsEnabled="{Binding CanAutoFillSummary}"
                            FontSize="11"
                            Padding="8,3"
                            Margin="4,0,0,0"
                            HorizontalContentAlignment="Center"
                            ToolTip.Tip="Populate the standard performance set (VDD, Idq, Zsource, Zin, Zload, Power, Efficiency, Gain, AM/PM, IRL); requires a Table + loadpull source"/>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="Freq"
                           Classes="label" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="4"
                           ItemsSource="{x:Static vm:PlotInspectorViewModel.AllFreqUnits}"
                           SelectedItem="{Binding FreqUnit, Mode=TwoWay}"/>

                <TextBlock Grid.Column="5" Text="Font Size"
                           Classes="label" Margin="10,0,4,0"
                           IsVisible="{Binding IsTablePlot}"/>
                <NumericUpDown Grid.Column="6"
                               Value="{Binding FontSize, Mode=TwoWay}"
                               Minimum="6" Maximum="32" Increment="1"
                               Width="40"
                               Padding="5,5"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               AllowSpin="False"
                               IsVisible="{Binding IsTablePlot}"
                               ToolTip.Tip="Table font size"/>
            </Grid>

            <!-- ── Summary table-wide controls (Phase 7.5d) — visible when IsSummaryTable ── -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding IsSummaryTable}">
                <!-- Analysis picker on its own row (only when the source has >1 loadpull view, e.g. a
                     Loadpull + a Pursuit follow-on) — selects which analysis the summary reads.
                     IsVisible is on each control (not the row) so the binding behaves exactly as the
                     prior inline layout did; the row collapses to nothing when both are hidden. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Analysis" Classes="label"
                               IsVisible="{Binding ShowSummaryAnalysisPicker}"/>
                    <ComboBox ItemsSource="{Binding SummaryAvailableAnalyses}"
                              SelectedItem="{Binding SummarySelectedAnalysis, Mode=TwoWay}"
                              Width="80"
                              IsVisible="{Binding ShowSummaryAnalysisPicker}"
                              ToolTip.Tip="Which loadpull analysis (e.g. LP1, LPP1) to summarize"/>
                </StackPanel>

                <!-- Optimum + read-mode + compression row -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="seg-btn"
                                Classes.active="{Binding IsTableOptimumMxp}"
                                Command="{Binding SetTableOptimumMxpCommand}"
                                Padding="5,2"
                                ToolTip.Tip="MXP — max-power optimum">
                            <TextBlock Text="MXP" FontSize="10"/>
                        </Button>
                        <Button Classes="seg-btn"
                                Classes.active="{Binding IsTableOptimumMxe}"
                                Command="{Binding SetTableOptimumMxeCommand}"
                                Padding="5,2"
                                ToolTip.Tip="MXE — max-efficiency optimum">
                            <TextBlock Text="MXE" FontSize="10"/>
                        </Button>
                    </StackPanel>
                    <CheckBox Content="Interp"
                              IsChecked="{Binding IsInterp, Mode=TwoWay}"
                              FontSize="10"
                              VerticalAlignment="Center"
                              ToolTip.Tip="On = interpolated value; Off = nearest measured node"/>
                    <TextBlock Text="Comp" Classes="label"/>
                    <NumericUpDown Value="{Binding TableCompression, Mode=TwoWay}"
                                   Minimum="0" Maximum="20" Increment="0.5"
                                   FormatString="F1"
                                   Width="48"
                                   ToolTip.Tip="Table-wide compression point (dB)"/>
                    <TextBlock Text="dB" Classes="label"/>
                </StackPanel>
            </StackPanel>

            <Separator/>

            <!-- ── Trace list ─────────────────────────────────────────────── -->
            <ScrollViewer x:Name="TraceScrollViewer"
                          MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Transitions>
                    <Transitions>
                        <VectorTransition Property="Offset" Duration="0:0:0.5" Easing="QuarticEaseOut"/>
                    </Transitions>
                </ScrollViewer.Transitions>
                <!-- Single outline wraps ALL summary cards (Classes.summaryOutline shows the border only
                     for summary tables); per-card outlines are suppressed via Border.traceCard.summaryCard. -->
                <Border Classes.summaryOutline="{Binding IsSummaryTable}">
                <ItemsControl ItemsSource="{Binding Traces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TraceRowViewModel">
                            <Border Classes="traceCard"
                                    Classes.summaryCard="{Binding IsSummaryColumn}">
                                <Grid ColumnDefinitions="*,Auto">
                                <!-- Col 0: all trace content -->
                                <StackPanel Grid.Column="0" Spacing="4">

                                    <!-- ── Source row (R-dd-2) ────────────────────────────────
                                         Visible only once a second dataset is loaded — with one
                                         dataset the picker looks exactly as it did before this
                                         selector existed (no source column, no extra click). -->
                                    <Grid ColumnDefinitions="50,*"
                                          IsVisible="{Binding SourceSelectorVisible}">
                                        <TextBlock Grid.Column="0" Text="Source"
                                                   Classes="label"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableSourceEntries}"
                                                  SelectedItem="{Binding SelectedSourceItem, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="Which loaded dataset to pick a trace from">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="{StaticResource FontSize}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- ── Identity row ──────────────────────────────────────
                                         Cols: * (group) | * (item) | Auto (matrix S-only) | 26 (→R)
                                         Matrix col is Auto so it collapses when hidden. Eye moved to pin row.
                                         Hidden for contour traces (they have no cube/SNP picker). -->
                                    <Grid ClipToBounds="False"
                                          IsVisible="{Binding IsStandardTrace}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"    MinWidth="60"/>
                                            <ColumnDefinition Width="*"    MinWidth="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="26"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: group header combo -->
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailableGroups}"
                                                  SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                                  PlaceholderText="(load a file…)"
                                                  Margin="0,0,3,0"
                                                  MinWidth="20"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="{StaticResource FontSize}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Col 1: item within the group -->
                                        <!-- Analysis V/I → compact icon-select -->
                                        <ctl:IconSelectButton Grid.Column="1"
                                                              IsVisible="{Binding IsViSelector}"
                                                              ItemsSource="{Binding AvailableSignals}"
                                                              SelectedItem="{Binding SelectedSignal, Mode=TwoWay}"
                                                              Highlight="False" HighlightSelected="False"
                                                              Margin="0,0,3,0" MinWidth="40"
                                                              ToolTip.Tip="Quantity (V / I)">
                                            <ctl:IconSelectButton.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TraceDataItem">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="{StaticResource FontSize}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ctl:IconSelectButton.ItemTemplate>
                                        </ctl:IconSelectButton>

                                        <!-- Measurements / S-Parameters → keep the ComboBox -->
                                        <ComboBox Grid.Column="1"
                                                  IsVisible="{Binding !IsViSelector}"
                                                  ItemsSource="{Binding AvailableSignals}"
                                                  SelectedItem="{Binding SelectedSignal, Mode=TwoWay}"
                                                  Margin="0,0,3,0"
                                                  MinWidth="20"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                            <ComboBox.ItemContainerTheme>
                                                <ControlTheme TargetType="ComboBoxItem">
                                                    <Setter Property="IsEnabled"
                                                            Value="{ReflectionBinding IsEnabled}"/>
                                                </ControlTheme>
                                            </ComboBox.ItemContainerTheme>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TraceDataItem">
                                                    <!-- R-stb-5: a metric that does not fit this plot type stays
                                                         VISIBLE but disabled, and says why on hover, rather than
                                                         vanishing or producing an empty trace. -->
                                                    <TextBlock Text="{Binding PickerText}"
                                                               Classes.brokenSource="{Binding IsBroken}"
                                                               FontSize="{StaticResource FontSize}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding TooltipText}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Col 2: Matrix type — S-parameter sources only; Auto collapses when hidden -->
                                        <ctl:IconSelectButton Grid.Column="2"
                                                              Margin="0,0,3,0"
                                                              IsVisible="{Binding ShowMatrixTypeCombo}"
                                                              Width="34"
                                                              ItemsSource="{x:Static vm:PlotInspectorViewModel.AllMatrixTypes}"
                                                              SelectedItem="{Binding MatrixType, Mode=TwoWay}"
                                                              Highlight="True"
                                                              HighlightSelected="False"
                                                              ToolTip.Tip="Matrix type (S / Y / Z)">
                                            <ctl:IconSelectButton.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SystemBaseLowColor}"
                                                            CornerRadius="3"
                                                            Width="18" Height="16">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="9"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ctl:IconSelectButton.ItemTemplate>
                                        </ctl:IconSelectButton>

                                        <!-- Col 3: →R secondary-axis toggle (Rect only) -->
                                        <Button Grid.Column="3"
                                                Command="{Binding ToggleSecondaryAxisCommand}"
                                                IsVisible="{Binding IsRectPlot}"
                                                Padding="3,2"
                                                Margin="0,0,0,0"
                                                ToolTip.Tip="Toggle right Y axis">
                                            <mi:MaterialIcon Kind="{Binding SecondaryAxisIcon}"
                                                             Width="14" Height="14"/>
                                        </Button>
                                    </Grid>

                                    <!-- ── Network-metric card body (stability / passivity) ──────
                                         R-stb-3: ordered INPUT and OUTPUT port selection, valid for
                                         any N ≥ 2, shown only above 2 ports (at exactly 2 the choice
                                         is forced). Two independent selectors, never a pair list —
                                         pairs grow as N(N−1)/2 and do not scale. -->
                                    <StackPanel Spacing="4" IsVisible="{Binding IsNetworkMetricTrace}">

                                        <Grid ColumnDefinitions="50,*,Auto,*"
                                              IsVisible="{Binding ShowPortSelectors}">
                                            <TextBlock Grid.Column="0" Text="In / Out" Classes="label"
                                                       ToolTip.Tip="Ordered: swapping input and output swaps µ (load) and µ' (source)."/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailablePorts}"
                                                      SelectedItem="{Binding SelectedInputPort, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Input port"/>
                                            <TextBlock Grid.Column="2" Text="→" Classes="label"
                                                       Margin="4,0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="3"
                                                      ItemsSource="{Binding AvailablePorts}"
                                                      SelectedItem="{Binding SelectedOutputPort, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Output port"/>
                                        </Grid>

                                        <!-- Passivity is not 2-port-limited (R-stb-6): whole network
                                             is the default, an extracted pair is a choice. -->
                                        <Grid ColumnDefinitions="50,*" IsVisible="{Binding ShowPassivityScope}">
                                            <TextBlock Grid.Column="0" Text="Scope" Classes="label"/>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding PassivityWholeNetwork, Mode=TwoWay}"
                                                      Content="Whole network"
                                                      FontSize="{StaticResource FontSize}"
                                                      ToolTip.Tip="Unchecked: passivity of the extracted input/output 2-port only."/>
                                        </Grid>

                                        <!-- The passive readouts need the FIXTURE, which nothing in
                                             the data records. Explicit, never inferred: the wrong
                                             reading is plausible-looking and wrong everywhere.

                                             The columns are the IDENTITY ROW's, copied exactly —
                                             including the spacer standing in for the matrix-type
                                             button — so this combo box lines up with the item combo
                                             directly above it instead of starting at its own
                                             indent and running the full width of the card. -->
                                        <Grid IsVisible="{Binding ShowPassiveExtraction}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"    MinWidth="60"/>
                                                <ColumnDefinition Width="*"    MinWidth="60"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Fixture" Classes="label"
                                                       VerticalAlignment="Center"/>

                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding PassiveExtractionItems}"
                                                      SelectedItem="{Binding SelectedPassiveFixture, Mode=TwoWay}"
                                                      Margin="0,0,3,0"
                                                      MinWidth="20"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      ToolTip.Tip="{Binding PassiveFixtureTooltip}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TraceRowViewModel+PassiveFixtureItem">
                                                        <!-- The NAME only. The closed form is a
                                                             tooltip per row, so every option can be
                                                             read before one is chosen without the
                                                             control being three times as wide. -->
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="{StaticResource FontSize}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Equation}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Stands in for the identity row's matrix-type button
                                                 so column 1 is the same width in both rows. Same
                                                 footprint, same visibility, no content. -->
                                            <Panel Grid.Column="2" Width="34" Margin="0,0,3,0"
                                                   IsHitTestVisible="False"
                                                   IsVisible="{Binding ShowMatrixTypeCombo}"/>
                                        </Grid>

                                        <!-- R-stb-4 / R-stb-6: state the termination assumption. -->
                                        <TextBlock Text="{Binding TerminationNote}"
                                                   IsVisible="{Binding ShowTerminationNote}"
                                                   FontSize="9" Opacity="0.6"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- ── Contour trace body (Phase 7.4e) ─────────────────── -->
                                    <StackPanel Spacing="4"
                                                IsVisible="{Binding IsContourTrace}">

                                        <!-- Loadpull-analysis row (only when the source has >1 loadpull view,
                                             e.g. a run.npy with both a Loadpull and a Pursuit follow-on) -->
                                        <Grid ColumnDefinitions="50,*"
                                              IsVisible="{Binding ShowContourGroupPicker}">
                                            <TextBlock Grid.Column="0" Text="Analysis"
                                                       Classes="label"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailableLoadpullGroups}"
                                                      SelectedItem="{Binding SelectedLoadpullGroup, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Which loadpull analysis (e.g. LP1, LPP1) to contour"/>
                                        </Grid>

                                        <!-- Metric row -->
                                        <Grid ColumnDefinitions="50,*">
                                            <TextBlock Grid.Column="0" Text="Metric"
                                                       Classes="label"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailableMetrics}"
                                                      SelectedItem="{Binding ContourMetricName, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="FOM metric to contour"/>
                                        </Grid>

                                        <!-- Constraint row: kind toggle + value -->
                                        <Grid ColumnDefinitions="50,Auto,*">
                                            <TextBlock Grid.Column="0" Text="At"
                                                       Classes="label"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding IsCompressionConstraint}"
                                                        Command="{Binding SetConstraintCompressionCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Compression-dB slice">
                                                    <TextBlock Text="Comp" FontSize="10"/>
                                                </Button>
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding IsConstantMetricConstraint}"
                                                        Command="{Binding SetConstraintConstantCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Constant-metric slice">
                                                    <TextBlock Text="Const" FontSize="10"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal" Spacing="2"
                                                        Margin="3,0,0,0">
                                                <NumericUpDown Value="{Binding ContourConstraintValue, Mode=TwoWay}"
                                                               Minimum="-999" Maximum="999"
                                                               Increment="0.5"
                                                               FormatString="F1"
                                                               Width="46"
                                                               ToolTip.Tip="Constraint value (dB compression or metric constant)"/>
                                                <TextBlock Text="{Binding ConstraintUnits}"
                                                           Classes="label" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Constant-metric name (shown when Const kind) — §7: same metric disabled -->
                                        <Grid ColumnDefinitions="50,*"
                                              IsVisible="{Binding IsConstantMetricConstraint}">
                                            <TextBlock Grid.Column="0" Text="Metric"
                                                       Classes="label"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding ConstraintMetricOptions}"
                                                      SelectedItem="{Binding SelectedConstraintMetricItem, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Metric to hold constant">
                                                <ComboBox.ItemContainerTheme>
                                                    <ControlTheme TargetType="ComboBoxItem">
                                                        <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}"/>
                                                    </ControlTheme>
                                                </ComboBox.ItemContainerTheme>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="10"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Slice-axis pin row (only when the loadpull has >1 slice) -->
                                        <Grid ColumnDefinitions="50,*"
                                              IsVisible="{Binding ShowContourFreqPicker}">
                                            <TextBlock Grid.Column="0" Text="{Binding ContourLeadingAxisLabel}"
                                                       Classes="label"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding AvailableFrequencies}"
                                                      SelectedIndex="{Binding ContourFreqIndex, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Swept-axis value to slice at"/>
                                        </Grid>

                                        <!-- Z0 row: Γ-plane loadpull contours only (brief-dd-z0-renormalization.md §5) —
                                             the Z-plane impedance grid has no reference-impedance concept and never
                                             shows this row. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowContourZ0Control}">
                                            <TextBlock Text="Z0"
                                                       Classes="label" Margin="0,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding Z0String, Mode=TwoWay}"
                                                     IsEnabled="{Binding IsZ0Editable}"
                                                     FontSize="{StaticResource FontSize}"
                                                     Height="20"
                                                     MinHeight="0"
                                                     Width="120"
                                                     Padding="4,3"
                                                     PlaceholderText="50+j0"
                                                     ToolTip.Tip="{Binding Z0ErrorText}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Ω"
                                                       Classes="label"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox Content="Override"
                                                      IsChecked="{Binding Z0OverrideEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      FontSize="{StaticResource FontSize}"/>
                                        </StackPanel>

                                        <!-- Level-set mode toggle -->
                                        <Grid ColumnDefinitions="50,Auto">
                                            <TextBlock Grid.Column="0" Text="Levels"
                                                       Classes="label"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding IsRangeLevelMode}"
                                                        Command="{Binding SetRangeLevelModeCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Specify levels as start:step:stop">
                                                    <TextBlock Text="Range" FontSize="10"/>
                                                </Button>
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding IsCountLevelMode}"
                                                        Command="{Binding SetCountLevelModeCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Specify number of evenly-spaced levels">
                                                    <TextBlock Text="Count" FontSize="10"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Range fields: Start / Step / Stop -->
                                        <Grid ColumnDefinitions="36,Auto,36,Auto,36"
                                              IsVisible="{Binding IsRangeLevelMode}">
                                            <NumericUpDown Grid.Column="0"
                                                           Value="{Binding ContourLevelStart, Mode=TwoWay}"
                                                           Minimum="-9999" Maximum="9999"
                                                           Increment="1" FormatString="G4"
                                                           ToolTip.Tip="Level set start"/>
                                            <TextBlock Grid.Column="1" Text=":" Classes="label"
                                                       Margin="2,0" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="2"
                                                           Value="{Binding ContourLevelStep, Mode=TwoWay}"
                                                           Increment="0.25" Minimum="0.01" Maximum="9999"
                                                           FormatString="G4"
                                                           ToolTip.Tip="Level step (must be > 0)"/>
                                            <TextBlock Grid.Column="3" Text=":" Classes="label"
                                                       Margin="2,0" VerticalAlignment="Center"/>
                                            <NumericUpDown Grid.Column="4"
                                                           Value="{Binding ContourLevelStop, Mode=TwoWay}"
                                                           Minimum="-9999" Maximum="9999"
                                                           Increment="1" FormatString="G4"
                                                           ToolTip.Tip="Level set stop"/>
                                        </Grid>

                                        <!-- Count field -->
                                        <Grid ColumnDefinitions="50,Auto"
                                              IsVisible="{Binding IsCountLevelMode}">
                                            <TextBlock Grid.Column="0" Text="N levels"
                                                       Classes="label"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Value="{Binding ContourLevelCount, Mode=TwoWay}"
                                                           Minimum="2" Maximum="50" Increment="1"
                                                           FormatString="0"
                                                           Width="40"
                                                           ToolTip.Tip="Number of iso-line levels"/>
                                        </Grid>

                                        <!-- Options disclosure: chevron + label, bespoke (no TabControl) -->
                                        <Button Classes="seg-btn"
                                                Command="{Binding ToggleOptionsCommand}"
                                                HorizontalAlignment="Left"
                                                Padding="0,2"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                ToolTip.Tip="Show / hide advanced options">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <mi:MaterialIcon Kind="ChevronRight"
                                                    IsVisible="{Binding !ContourOptionsExpanded}"
                                                    Width="12" Height="12"/>
                                                <mi:MaterialIcon Kind="ChevronDown"
                                                    IsVisible="{Binding ContourOptionsExpanded}"
                                                    Width="12" Height="12"/>
                                                <TextBlock Text="Options" Classes="label"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Spacing="4"
                                                    IsVisible="{Binding ContourOptionsExpanded}">

                                            <!-- MXP / MXE markers -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding ContourDisplayMxp}"
                                                        Command="{Binding ToggleMxpCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Show max-power point (MXP)">
                                                    <TextBlock Text="Max Power" FontSize="10"/>
                                                </Button>
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding ContourDisplayMxe}"
                                                        Command="{Binding ToggleMxeCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Show max-efficiency point (MXE)">
                                                    <TextBlock Text="Max Eff" FontSize="10"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Fill style + Colormap row — §11: no width clipping -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <ComboBox Grid.Column="0"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{x:Static vm:TraceRowViewModel.AllContourColorMaps}"
                                                          SelectedItem="{Binding ContourColorMap, Mode=TwoWay}"
                                                          ToolTip.Tip="Fill colormap"/>
                                                <ctl:IconSelectButton Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    Width="80"
                                                    ItemsSource="{x:Static vm:TraceRowViewModel.ContourFillOptions}"
                                                    SelectedItem="{Binding SelectedContourFill, Mode=TwoWay}"
                                                    Highlight="False" HighlightSelected="False"
                                                    ToolTip.Tip="Fill style (None / Topography / Heatmap)">
                                                    <ctl:IconSelectButton.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="10"
                                                                       HorizontalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </ctl:IconSelectButton.ItemTemplate>
                                                </ctl:IconSelectButton>
                                            </Grid>

                                            <!-- Line row: on/off toggle + color swatch + Fade toggle + width slider -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding ContourShowIsoLines}"
                                                        Command="{Binding ToggleShowIsoLinesCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Show iso-lines">
                                                    <TextBlock Text="Lines" FontSize="10"/>
                                                </Button>
                                                <Button Command="{Binding PickLineColorCommand}"
                                                        Width="20" Height="20"
                                                        Padding="1"
                                                        Margin="2,0,2,0"
                                                        ToolTip.Tip="Iso-line color">
                                                    <Border CornerRadius="2"
                                                            Width="14" Height="14"
                                                            Background="{Binding ContourLineColorEffective, Converter={StaticResource SKC}}"/>
                                                </Button>
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding ContourFadeLineOpacity}"
                                                        Command="{Binding ToggleFadeLineOpacityCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Fade outer iso-lines toward transparent">
                                                    <TextBlock Text="Fade" FontSize="10"/>
                                                </Button>
                                                <Slider Value="{Binding ContourStrokeWidth, Mode=TwoWay}"
                                                        Minimum="0.5" Maximum="5"
                                                        SmallChange="0.25"
                                                        Width="60"
                                                        ToolTip.Tip="Iso-line width (px)"/>
                                            </StackPanel>

                                            <!-- Grid points row: §12 single "Grid" toggle + color swatch + size NUD -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto">
                                                <Button Grid.Column="0" Classes="seg-btn"
                                                        Classes.active="{Binding ContourDisplayGridPoints}"
                                                        Command="{Binding ToggleDisplayGridPtsCommand}"
                                                        Padding="5,2" Margin="0,0,4,0"
                                                        ToolTip.Tip="Show raw scatter grid points">
                                                    <TextBlock Text="Grid" FontSize="10"/>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Command="{Binding PickGridPointColorCommand}"
                                                        Width="20" Height="20"
                                                        Padding="1"
                                                        Margin="0,0,4,0"
                                                        ToolTip.Tip="Grid point color">
                                                    <Border CornerRadius="2"
                                                            Width="14" Height="14"
                                                            Background="{Binding ContourGridPointColor, Converter={StaticResource SKC}}"/>
                                                </Button>
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding ContourGridPointSize, Mode=TwoWay}"
                                                               Minimum="1" Maximum="12" Increment="0.5"
                                                               FormatString="F1"
                                                               Width="34"
                                                               ToolTip.Tip="Grid point dot radius (px)"/>
                                            </Grid>

                                            <!-- Label row: Labels toggle + Bg swatch + Text swatch + Size NUD + Spacing NUD -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button Classes="seg-btn"
                                                        Classes.active="{Binding ContourShowLabels}"
                                                        Command="{Binding ToggleShowLabelsCommand}"
                                                        Padding="5,2"
                                                        ToolTip.Tip="Show level labels">
                                                    <TextBlock Text="Labels" FontSize="10"/>
                                                </Button>
                                                <Button Command="{Binding PickLabelBgColorCommand}"
                                                        Width="20" Height="20"
                                                        Padding="1"
                                                        Margin="2,0,0,0"
                                                        ToolTip.Tip="Label background color">
                                                    <Border CornerRadius="2"
                                                            Width="14" Height="14"
                                                            Background="{Binding ContourLabelBackground, Converter={StaticResource SKC}}"/>
                                                </Button>
                                                <Button Command="{Binding PickLabelFgColorCommand}"
                                                        Width="20" Height="20"
                                                        Padding="1"
                                                        Margin="2,0,4,0"
                                                        ToolTip.Tip="Label text color">
                                                    <Border CornerRadius="2"
                                                            Width="14" Height="14"
                                                            Background="{Binding ContourLabelForeground, Converter={StaticResource SKC}}"/>
                                                </Button>
                                                <NumericUpDown Value="{Binding ContourLevelFontSize, Mode=TwoWay}"
                                                               Minimum="5" Maximum="24" Increment="1"
                                                               FormatString="F0"
                                                               Width="36"
                                                               ToolTip.Tip="Label font size (pt)"/>
                                                <NumericUpDown Value="{Binding ContourLabelSpacing, Mode=TwoWay}"
                                                               Minimum="0.1" Maximum="1000" Increment="0.1"
                                                               FormatString="F1"
                                                               Width="36"
                                                               ToolTip.Tip="Label spacing factor (smaller = more labels)"/>
                                            </StackPanel>

                                            <!-- Interp kernel -->
                                            <Grid ColumnDefinitions="50,*">
                                                <TextBlock Grid.Column="0" Text="Kernel"
                                                           Classes="label"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{x:Static vm:TraceRowViewModel.AllRbfKernels}"
                                                          SelectedItem="{Binding ContourInterpKernel, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="RBF interpolation kernel"/>
                                            </Grid>

                                            <!-- Smooth + Epsilon -->
                                            <Grid ColumnDefinitions="50,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="Smooth"
                                                           Classes="label"/>
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding ContourSmoothing, Mode=TwoWay}"
                                                               Minimum="0" Maximum="10" Increment="0.0001"
                                                               FormatString="G3"
                                                               Width="68"
                                                               ToolTip.Tip="RBF smoothing factor"/>
                                                <TextBlock Grid.Column="2" Text="ε"
                                                           Classes="label" Margin="4,0,2,0"
                                                           VerticalAlignment="Center"/>
                                                <NumericUpDown Grid.Column="3"
                                                               Value="{Binding ContourEpsilon, Mode=TwoWay}"
                                                               Minimum="0" Increment="0.1"
                                                               FormatString="G3"
                                                               Width="60"
                                                               ToolTip.Tip="RBF epsilon (blank = auto)"/>
                                            </Grid>

                                        </StackPanel>

                                    </StackPanel>
                                    <!-- end contour trace body -->

                                    <!-- ── Summary column card body (Phase 7.5 — single compact row) ─────── -->
                                    <!-- Metric combo is FIXED width so every summary card's columns align
                                         horizontally (design feedback). Units sit between Metric and Digits
                                         in a FIXED-width column so a longer unit string (e.g. "dBm") can't
                                         shift the Digits/Comp columns out of alignment across cards. Digits
                                         drives SummaryFractionDigits (the field the cell formatter reads),
                                         NOT MaximumFractionDigits. -->
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                          ColumnSpacing="4"
                                          IsVisible="{Binding IsSummaryColumn}">

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SummaryMetricOptions}"
                                                  SelectedItem="{Binding SummaryMetricSelection, Mode=TwoWay}"
                                                  Width="104"
                                                  HorizontalAlignment="Left"
                                                  ToolTip.Tip="Summary metric / impedance / bias"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SummaryUnitLabel}"
                                                   Classes="label"
                                                   Width="30"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <NumericUpDown Grid.Column="2"
                                                       Value="{Binding SummaryFractionDigits, Mode=TwoWay}"
                                                       Minimum="0" Maximum="6" Increment="1"
                                                       Width="40" FormatString="0"
                                                       ToolTip.Tip="Decimal digits (real columns)"/>

                                        <NumericUpDown Grid.Column="3"
                                                       Value="{Binding SummaryCompressionDisplay}"
                                                       IsEnabled="{Binding SummaryCompressionEditable}"
                                                       Minimum="0" Maximum="20"
                                                       FormatString="F1"
                                                       Width="44"
                                                       ToolTip.Tip="Compression is set table-wide (change it in the header)"/>
                                    </Grid>
                                    <!-- end summary column body -->

                                    <!-- Trace body — per-kind -->
                                    <StackPanel Spacing="3"
                                                IsVisible="{Binding IsStandardTrace}">

                                        <!-- ── Axis-role editor: cube-bound (Phase 7.3a) ─────── -->
                                        <ItemsControl IsVisible="{Binding ShowAxisRoles}"
                                                      ItemsSource="{Binding AxisRoles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AxisRoleRowViewModel">
                                                    <Grid ColumnDefinitions="70,Auto,Auto,Auto,*,Auto"
                                                          IsVisible="{Binding IsRowVisible}"
                                                          Margin="0,0,0,2">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding AxisLabel}"
                                                                   Classes="label"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding AxisLabel}"/>
                                                        <!-- X / Fam / Fix are hidden on a 3D
                                                             surface: it opens both angle axes whole
                                                             and pins the rest whatever the slice
                                                             says, so all three were inert there.
                                                             The surface's OWN two angle rows go
                                                             further and are not shown at all
                                                             (IsRowVisible) — nothing was left on
                                                             them. See AxisRoleRowViewModel. -->
                                                        <Button Grid.Column="1"
                                                                Classes="seg-btn"
                                                                Classes.active="{Binding IsX}"
                                                                Command="{Binding SetXCommand}"
                                                                IsEnabled="{Binding IsRoleToggleable}"
                                                                IsVisible="{Binding ShowRoleButtons}"
                                                                Padding="6,2"
                                                                ToolTip.Tip="Use as X axis">
                                                            <TextBlock Text="X" FontSize="10"/>
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Classes="seg-btn"
                                                                Classes.active="{Binding IsFamily}"
                                                                Command="{Binding SetFamilyCommand}"
                                                                IsEnabled="{Binding IsRoleToggleable}"
                                                                IsVisible="{Binding ShowRoleButtons}"
                                                                Padding="6,2"
                                                                ToolTip.Tip="Sweep this axis as a family of curves (one curve per value)">
                                                            <TextBlock Text="Fam" FontSize="10"/>
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                                Classes="seg-btn"
                                                                Classes.active="{Binding IsPinned}"
                                                                Command="{Binding SetPinnedCommand}"
                                                                IsEnabled="{Binding IsRoleToggleable}"
                                                                IsVisible="{Binding ShowRoleButtons}"
                                                                Padding="6,2"
                                                                Margin="0,0,4,0"
                                                                ToolTip.Tip="Fix this axis to a single value">
                                                            <TextBlock Text="Fix" FontSize="10"/>
                                                        </Button>
                                                        <ComboBox Grid.Column="4"
                                                                  IsVisible="{Binding ShowPinPicker}"
                                                                  ItemsSource="{Binding PinOptions}"
                                                                  SelectedIndex="{Binding PinIndex, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch"/>
                                                        <!-- Eye: reveal unlabeled nodes / device-port branches. Tied to the pin selector. -->
                                                        <Button Grid.Column="5"
                                                                Classes="seg-btn"
                                                                Classes.active="{Binding $parent[ItemsControl].DataContext.ShowAll}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.ToggleShowAllCommand}"
                                                                IsVisible="{Binding IsFilterableLabelAxis}"
                                                                Width="26" Padding="3,2" Margin="3,0,0,0"
                                                                ToolTip.Tip="Show all nodes / branch currents">
                                                            <mi:MaterialIcon Kind="Eye" Width="14" Height="14"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Classes="label"
                                                   IsVisible="{Binding ShowEmptyQuantity}"
                                                   Text="{Binding EmptyQuantityMessage}"
                                                   Margin="0,2,0,0"/>

                                        <!-- ── WSProbe (WSP-4 §2) ────────────────────────────────
                                             Which probe the metric is taken AT, and the two or three
                                             options some metrics read. The metric itself is chosen in
                                             the item picker above, beside every other quantity — this
                                             section is what a probe metric needs that a cube does not.

                                             Every row is IsVisible-gated on the metric's own kind, so
                                             an inert control is never shown: a bilateral loop gain has
                                             no Z0 to normalise by, and asking for one would imply it
                                             changed the answer. -->
                                        <StackPanel Spacing="2"
                                                    IsVisible="{Binding ShowWspSection}"
                                                    Margin="0,4,0,0">

                                            <Grid ColumnDefinitions="46,*">
                                                <TextBlock Grid.Column="0" Text="probe" Classes="label"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding WspProbeItems}"
                                                          SelectedItem="{Binding SelectedWspProbeItem, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="The WSProbe this quantity is taken at. The idx beside each label is the document's own 1-based probe index — what a measure line types as SP1.idx(&quot;LABEL&quot;)."/>
                                            </Grid>

                                            <Grid ColumnDefinitions="46,*" IsVisible="{Binding ShowWspWith}">
                                                <TextBlock Grid.Column="0" Text="with" Classes="label"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding WspProbeItems}"
                                                          SelectedItem="{Binding SelectedWspWithItem, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="The second probe of the pair. A two-block loop gain is a property of the two probes together, not of either one."/>
                                            </Grid>

                                            <Grid ColumnDefinitions="46,*,Auto" IsVisible="{Binding ShowWspSet}">
                                                <TextBlock Grid.Column="0" Text="set" Classes="label"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding WspSetText, Mode=TwoWay}"
                                                         FontSize="{StaticResource FontSize}"
                                                         HorizontalAlignment="Stretch"
                                                         PlaceholderText="GATE, DRAIN, …"
                                                         ToolTip.Tip="The ordered probe set, comma separated. ORDER is part of the answer: Ohtomo's G_i are the trailing principal minors of M in this order."/>
                                                <NumericUpDown Grid.Column="2"
                                                               Value="{Binding WspSetIndex, Mode=TwoWay}"
                                                               Minimum="1" Increment="1"
                                                               ShowButtonSpinner="True"
                                                               Width="72" Margin="4,0,0,0"
                                                               FontSize="{StaticResource FontSize}"
                                                               ToolTip.Tip="Which G_i to draw, 1-based."/>
                                            </Grid>

                                            <Grid ColumnDefinitions="46,*,Auto" IsVisible="{Binding ShowWspZ0}">
                                                <TextBlock Grid.Column="0" Text="Z0" Classes="label"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding WspZ0Text, Mode=TwoWay}"
                                                         FontSize="{StaticResource FontSize}"
                                                         HorizontalAlignment="Stretch"
                                                         PlaceholderText="source's own Z0"
                                                         ToolTip.Tip="The reference this quantity normalises by. Blank follows the source group's own port-1 Re(Z0), else 50 Ω."/>
                                                <ComboBox Grid.Column="2"
                                                          IsVisible="{Binding ShowWspSet}"
                                                          ItemsSource="{x:Static vm:TraceRowViewModel.WspSides}"
                                                          SelectedItem="{Binding WspActiveSide, Mode=TwoWay}"
                                                          Margin="4,0,0,0" Width="60"
                                                          ToolTip.Tip="Which side of every probe is the ACTIVE subnetwork (G = generator side, L = load side)."/>
                                            </Grid>

                                            <!-- ── Envelope (R-wsp4-9) ───────────────────────
                                                 The five quantities read off the RE-TERMINATED
                                                 circuit. The `probe` row above is the SUSPECT node;
                                                 these two are where the pulling happens, and each
                                                 takes a LADDER of |Γ| so the ρ at which
                                                 encirclements first appear is read off one card
                                                 rather than off three runs. -->
                                            <StackPanel Spacing="2"
                                                        IsVisible="{Binding ShowWspEnvelope}"
                                                        Margin="0,2,0,0">

                                                <Grid ColumnDefinitions="46,*,Auto,72">
                                                    <TextBlock Grid.Column="0" Text="source" Classes="label"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding WspSideProbeItems}"
                                                              SelectedItem="{Binding SelectedWspSourceItem, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              ToolTip.Tip="The probe whose G-side termination the |ΓS| ladder replaces. It must sit directly at that Term — a probe with feedback across it cannot isolate one, and the card says so."/>
                                                    <TextBlock Grid.Column="2" Text="|ΓS|" Classes="label"
                                                               VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                    <TextBox Grid.Column="3"
                                                             Text="{Binding WspGammaSText, Mode=TwoWay}"
                                                             FontSize="{StaticResource FontSize}"
                                                             PlaceholderText="off"
                                                             ToolTip.Tip="One |ΓS| per rung, comma separated (0.9, 0.875, 0.874). Blank or 0 leaves the source side unpulled."/>
                                                </Grid>

                                                <Grid ColumnDefinitions="46,*,Auto,72">
                                                    <TextBlock Grid.Column="0" Text="load" Classes="label"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding WspSideProbeItems}"
                                                              SelectedItem="{Binding SelectedWspLoadItem, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch"
                                                              ToolTip.Tip="The probe whose L-side termination the |ΓL| ladder replaces."/>
                                                    <TextBlock Grid.Column="2" Text="|ΓL|" Classes="label"
                                                               VerticalAlignment="Center" Margin="6,0,4,0"/>
                                                    <TextBox Grid.Column="3"
                                                             Text="{Binding WspGammaLText, Mode=TwoWay}"
                                                             FontSize="{StaticResource FontSize}"
                                                             PlaceholderText="off"
                                                             ToolTip.Tip="One |ΓL| per rung, comma separated. Blank or 0 leaves the load side unpulled."/>
                                                </Grid>

                                                <Grid ColumnDefinitions="46,Auto,*">
                                                    <TextBlock Grid.Column="0" Text="θ step" Classes="label"
                                                               VerticalAlignment="Center"/>
                                                    <NumericUpDown Grid.Column="1"
                                                                   Value="{Binding WspThetaStepDeg, Mode=TwoWay}"
                                                                   Minimum="0.1" Maximum="360" Increment="5"
                                                                   ShowButtonSpinner="True"
                                                                   Width="96"
                                                                   FontSize="{StaticResource FontSize}"
                                                                   ToolTip.Tip="The angular step of both Γ grids, in degrees. Every grid point is a rank-1 update per frequency — halving the step quadruples a two-sided sweep."/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding WspEnvelopeGridText}"
                                                               Classes="label"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="6,0,0,0"
                                                               ToolTip.Tip="{Binding WspEnvelopeGridText}"/>
                                                </Grid>

                                                <Grid ColumnDefinitions="46,*" IsVisible="{Binding ShowWspPassive}">
                                                    <TextBlock Grid.Column="0" Text="passive" Classes="label"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding WspPassiveText, Mode=TwoWay}"
                                                             FontSize="{StaticResource FontSize}"
                                                             HorizontalAlignment="Stretch"
                                                             PlaceholderText="this run's wsp_passive"
                                                             ToolTip.Tip="The passivated run the NDF is taken against — a second analysis of the same netlist with its devices passivated, named as a cube (SP2.wsp). Blank reads the wsp_passive beside this group's own wsp."/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- The reading: Kurokawa's start-up frequencies, the
                                                 encirclement count, or a margin's minimum together
                                                 with the search that pairs with it. "none" is a real
                                                 answer and is printed as one. -->
                                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowWspReadout}">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding WspReadoutText}"
                                                           Classes="label"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding WspReadoutText}"/>
                                                <Button Grid.Column="1"
                                                        Classes="seg-btn"
                                                        Command="{Binding MarkWspCrossingsCommand}"
                                                        IsEnabled="{Binding CanMarkWspCrossings}"
                                                        Padding="6,2" Margin="4,0,0,0"
                                                        ToolTip.Tip="{Binding MarkWspCrossingsTooltip}">
                                                    <TextBlock Text="Mark crossings" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <!-- ── Plot versus: give the trace its own X data ────────
                                             "vs X" turns Gain-vs-swept-Pin into Gain-vs-Pout. The X
                                             side's swept axis and family MIRROR the Y side's by axis
                                             name (that is what XRoleSummary states), so the only
                                             choice here is WHICH quantity is X — plus a Fix row for
                                             any axis the Y side does not have. -->
                                        <StackPanel Spacing="2"
                                                    IsVisible="{Binding ShowVersusRow}"
                                                    Margin="0,2,0,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <CheckBox Grid.Column="0"
                                                          Content="vs X"
                                                          IsChecked="{Binding VersusEnabled, Mode=TwoWay}"
                                                          FontSize="{StaticResource FontSize}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0"
                                                          ToolTip.Tip="Plot this trace against another quantity (e.g. Gain vs Pout) instead of the swept axis"/>
                                                <ComboBox Grid.Column="1"
                                                          IsVisible="{Binding XSourceSelectorVisible}"
                                                          ItemsSource="{Binding XSourceEntries}"
                                                          SelectedItem="{Binding SelectedXSourceItem, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="Which loaded dataset the X quantity comes from">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       FontSize="{StaticResource FontSize}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,*,Auto"
                                                  IsVisible="{Binding VersusEnabled}">
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding XGroups}"
                                                          SelectedItem="{Binding SelectedXGroup, Mode=TwoWay}"
                                                          Margin="0,0,3,0"
                                                          MinWidth="20"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          ToolTip.Tip="Group the X quantity lives in">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="{StaticResource FontSize}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding XSignals}"
                                                          SelectedItem="{Binding SelectedXSignal, Mode=TwoWay}"
                                                          MinWidth="20"
                                                          Margin="0,0,3,0"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Stretch"
                                                          ToolTip.Tip="Quantity plotted along X">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:TraceDataItem">
                                                            <TextBlock Text="{Binding PickerText}"
                                                                       FontSize="{StaticResource FontSize}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding TooltipText}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- X-side transform: the X axis must be REAL, and an
                                                     ordinary X quantity (a voltage) is complex. The
                                                     card's other transform combo transforms Y. -->
                                                <ComboBox Grid.Column="2"
                                                          Width="74"
                                                          ItemsSource="{Binding XTransformItems}"
                                                          SelectedItem="{Binding SelectedXTransformItem, Mode=TwoWay}"
                                                          ToolTip.Tip="Applied to the X quantity only — a complex X (e.g. a voltage) needs mag/dB/real to become a real axis">
                                                    <ComboBox.ItemContainerTheme>
                                                        <ControlTheme TargetType="ComboBoxItem">
                                                            <Setter Property="IsEnabled"
                                                                    Value="{ReflectionBinding Enabled}"/>
                                                        </ControlTheme>
                                                    </ComboBox.ItemContainerTheme>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CubeTransformItem">
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="{StaticResource FontSize}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <TextBlock IsVisible="{Binding HasXRoleSummary}"
                                                       Text="{Binding XRoleSummary}"
                                                       FontSize="10"
                                                       Opacity="0.6"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="18,0,0,0"/>

                                            <!-- Rows for the X quantity's OWN axes only — the ones the
                                                 Y side does not have. A SHARED axis gets no row: it is
                                                 already edited by the trace's axis rows above, and a
                                                 second copy put two controls on one piece of state.
                                                 What the user needs about it is the statement in
                                                 XRoleSummary, not another button. -->
                                            <ItemsControl IsVisible="{Binding VersusEnabled}"
                                                          ItemsSource="{Binding XAxisPins}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:XAxisPinRowViewModel">
                                                        <Grid ColumnDefinitions="62,Auto,*" Margin="18,0,0,2">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding AxisLabel}"
                                                                       Classes="label"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip.Tip="{Binding AxisLabel}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="Fix"
                                                                       FontSize="10"
                                                                       Opacity="0.6"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,4,0"
                                                                       ToolTip.Tip="{Binding RoleTooltip}"/>
                                                            <ComboBox Grid.Column="2"
                                                                      ItemsSource="{Binding PinOptions}"
                                                                      SelectedIndex="{Binding PinIndex, Mode=TwoWay}"
                                                                      HorizontalAlignment="Stretch"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- ── Spec editor row: transform combo + cube-bound TextBox ─
                                             Transform combo moves here from identity row (Part D).
                                             Auto col collapses on Smith/Polar so TextBox reclaims width. -->
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                            <!-- Transform combo (Rect/Table, and a PATTERN plot, whose
                                                 radius IS decibels and which therefore needs one most
                                                 - see TraceRowViewModel.ShowTransformCombo) -->
                                            <ComboBox Grid.Column="0"
                                                      IsVisible="{Binding ShowTransformCombo}"
                                                      IsEnabled="{Binding IsTransformComboEnabled}"
                                                      ToolTip.Tip="Disabled for a real expression result — its transform is set in the expression text."
                                                      Width="90"
                                                      Margin="0,0,3,0"
                                                      ItemsSource="{Binding TraceTransformItems}"
                                                      SelectedItem="{Binding SelectedTransformItem, Mode=TwoWay}">
                                                <ComboBox.ItemContainerTheme>
                                                    <ControlTheme TargetType="ComboBoxItem">
                                                        <Setter Property="IsEnabled"
                                                                Value="{ReflectionBinding Enabled}"/>
                                                    </ControlTheme>
                                                </ComboBox.ItemContainerTheme>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CubeTransformItem">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="{StaticResource FontSize}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Spec editor (cube-bound) -->
                                            <TextBox Grid.Column="1"
                                                     IsVisible="{Binding IsCubeBoundTrace}"
                                                     Text="{Binding SpecShorthand, Mode=OneWay}"
                                                     FontSize="{StaticResource FontSize}"
                                                     Padding="4,2"
                                                     GotFocus="OnSpecEditGotFocus"
                                                     LostFocus="OnSpecEditLostFocus"
                                                     KeyDown="OnSpecEditKeyDown"
                                                     ToolTip.Tip="Type a cube shorthand, e.g. dB20 V[0, 1, :] — or plot against another quantity with &quot;Y vs X&quot;, e.g. Gain vs Pout"/>
                                        </Grid>
                                        <SelectableTextBlock IsVisible="{Binding HasSpecError}"
                                                             Text="{Binding SpecError}"
                                                             FontSize="10"
                                                             Opacity="0.6"
                                                             Foreground="{DynamicResource CrfIconBrush}"
                                                             TextWrapping="Wrap"
                                                             Margin="0,1,0,0"/>

                                        <!-- Pattern cut: which half of the plane this trace draws.
                                             ONE control, three named states - the two checkboxes it
                                             replaces were mutually exclusive and one of them had to
                                             hide, which moved the card under the pointer. See
                                             TraceRowViewModel.PatternCutIndex. -->
                                        <Grid Name="PatternCutRow"
                                              ColumnDefinitions="Auto,*"
                                              Margin="0,4,0,0"
                                              IsVisible="{Binding ShowPatternCut}">
                                            <TextBlock Grid.Column="0"
                                                       Text="Cut"
                                                       Classes="label"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{x:Static vm:TraceRowViewModel.PatternCutModes}"
                                                      SelectedIndex="{Binding PatternCutIndex, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="A cut is a PLANE: it runs from -&#952;max through broadside to +&#952;max, and the negative half is the &#966; + 180&#176; branch. Front half draws this slice alone. Back half draws it on the negative side - pin the trace at &#966; + 180 and pick this to build the plane out of two traces, which is what you want when the two halves need different colours. Whole plane fetches the &#966; + 180 slice alongside this one and draws both halves as a single curve, so an E-plane and an H-plane cut is two traces instead of four."/>
                                        </Grid>

                                        <!-- A dBm LEVEL's reference power. Shown only on a cube
                                             that says it is one (unit dBm, with the run's own
                                             reference published beside it) - today TrpDbm and
                                             PeakEirpDbm. It is HERE rather than only on the EM
                                             panel because re-referencing is an exact dB shift on
                                             numbers already in hand: making a user re-run an
                                             hours-long sweep for it would charge the price of a
                                             simulation for an offset. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              Margin="0,4,0,0"
                                              IsVisible="{Binding ShowReferenceInputPower}">
                                            <TextBlock Grid.Column="0"
                                                       Classes="label"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ReferenceInputPowerCaption}"
                                                       ToolTip.Tip="{Binding ReferenceInputPowerCaption}"/>
                                            <NumericUpDown Grid.Column="1"
                                                           Width="86" FontSize="11" Padding="5,2"
                                                           Minimum="-100" Maximum="100" Increment="1"
                                                           FormatString="0.##"
                                                           ShowButtonSpinner="False"
                                                           Value="{Binding ReferenceInputPowerDbm, Mode=TwoWay}"
                                                           ToolTip.Tip="dBm. The conducted power this level is read against. It opens on the reference the RUN published and changing it re-reads the same solved data - no re-run, because the correction is an exact dB shift. The trace's label always states the reference it is drawn at."/>
                                            <Button Grid.Column="2"
                                                    Classes="seg-btn"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding ResetReferenceInputPowerCommand}"
                                                    IsVisible="{Binding IsReferenceInputPowerOverridden}"
                                                    ToolTip.Tip="Back to the reference the run published. Not the same as typing that number in: this clears the override, so a later re-run at a different reference is followed.">
                                                <mi:MaterialIcon Kind="Restore" Width="13" Height="13"/>
                                            </Button>
                                        </Grid>

                                        <!-- ── Line row ──────────────────────────────────────────
                                             Cols: 34 (ISB) | 3* (NUD+slider nested) | * (color, ≤ 95)
                                             Col 1 contains a nested Grid(30,*): the NUD, then the slider.

                                             THE SLIDER GETS THE SPACE, and both of its neighbours are
                                             why that has to be spelled out. The colour column used to
                                             be 1000* capped at 95, which is a FLAT 95 px at every
                                             width the panel ever has, and a fourth 26 px column after
                                             it held nothing — so 155 px of the row was spoken for
                                             before the slider was offered any of it. In the docked
                                             Properties panel at 234 px (an ordinary width for it) the
                                             row is 174 px, the columns summed to 185 and OVERFLOWED,
                                             and the slider sat on its 38 px floor whatever the panel
                                             did. 3*:* with the cap kept gives the slider the growth
                                             and leaves the swatch its size; the spacer is gone rather
                                             than shrunk, because it aligned with a control (the
                                             identity row's →R) that only a Rect plot shows at all.

                                             Not on a Table, and not on the 3D surface — see
                                             TraceRowViewModel.ShowLineAndSymbol for why. -->
                                        <Grid ClipToBounds="False"
                                              IsVisible="{Binding ShowLineAndSymbol}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="3*" MinWidth="60"/>
                                                <ColumnDefinition Width="*"  MinWidth="40" MaxWidth="95"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Line ISB: Off / Solid / Dashed / … -->
                                            <ctl:IconSelectButton Grid.Column="0"
                                                                  Margin="0,0,6,0"
                                                                  ItemsSource="{x:Static vm:PlotInspectorViewModel.LineModes}"
                                                                  SelectedItem="{Binding SelectedLineMode, Mode=TwoWay}"
                                                                  Highlight="{Binding LineEnabled}"
                                                                  HighlightSelected="False"
                                                                  ToolTip.Tip="Line style (Off / Solid / Dashed)">
                                                <ctl:IconSelectButton.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LineModeItem">
                                                        <Canvas Width="20" Height="10"
                                                                Opacity="{Binding Opacity}">
                                                            <Line StartPoint="0,5" EndPoint="20,5"
                                                                  StrokeThickness="1.5"
                                                                  Stroke="{DynamicResource CrfIconBrush}"
                                                                  StrokeDashArray="{Binding Type, Converter={StaticResource LTD}}"/>
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ctl:IconSelectButton.ItemTemplate>
                                            </ctl:IconSelectButton>

                                            <!-- Col 1: NUD(30) + Slider(*) nested so slider right edge
                                                 aligns with the signal combo's right edge above. -->
                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="30,*"
                                                  ClipToBounds="False"
                                                  Margin="0,0,3,0">
                                                <NumericUpDown Grid.Column="0"
                                                               Value="{Binding LineWidth,
                                                                   Converter={StaticResource D2D},
                                                                   Mode=TwoWay}"
                                                               Minimum="0.5" Maximum="5"
                                                               Increment="0.25"
                                                               FormatString="F2"
                                                               IsEnabled="{Binding LineEnabled}"
                                                               ToolTip.Tip="Line width (px)"/>
                                                <Slider Grid.Column="1"
                                                        Value="{Binding LineWidth, Mode=TwoWay}"
                                                        Minimum="0.5" Maximum="5"
                                                        SmallChange="0.25"
                                                        MinWidth="20"
                                                        IsEnabled="{Binding LineEnabled}"/>
                                            </Grid>

                                            <!-- Col 2: the colour swatch -->
                                            <ctl:IconSelectButton Grid.Column="2"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static vm:PlotInspectorViewModel.ColorItems}"
                                                                  SelectedItem="{Binding SelectedLineColor, Mode=TwoWay}"
                                                                  IsEnabled="{Binding LineEnabled}"
                                                                  Highlight="False"
                                                                  HighlightSelected="False"
                                                                  ToolTip.Tip="Line color">
                                                <ctl:IconSelectButton.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorItem">
                                                        <Border Background="{Binding Brush}"
                                                                CornerRadius="3"
                                                                MinWidth="20" Height="12"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ctl:IconSelectButton.ItemTemplate>
                                            </ctl:IconSelectButton>

                                        </Grid>

                                        <!-- Table number-format controls — visible only for Table plot -->
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                              IsVisible="{Binding IsTablePlot}">

                                            <TextBlock Grid.Column="0" Text="Format"
                                                       Classes="label" Margin="0,0,4,0"/>
                                            <ComboBox  Grid.Column="1"
                                                       Classes="compact"
                                                       ItemsSource="{x:Static vm:PlotInspectorViewModel.AllPrecisionFormats}"
                                                       SelectedItem="{Binding FormatString, Mode=TwoWay}"
                                                       Width="90"
                                                       ToolTip.Tip="Number format (Auto / Fixed / Scientific)">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static vm:PrecisionFormatConverter.Instance}}"
                                                                   FontSize="{StaticResource FontSize}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBlock Grid.Column="2" Text="Digits"
                                                       Classes="label" Margin="10,0,4,0"/>
                                            <NumericUpDown Grid.Column="3"
                                                           Value="{Binding MaximumFractionDigits, Mode=TwoWay}"
                                                           Minimum="0" Maximum="15" Increment="1"
                                                           Width="40"
                                                           FormatString="0"
                                                           ToolTip.Tip="Maximum decimal digits"/>
                                        </Grid>

                                        <!-- ── Symbol row ─────────────────────────────────────────
                                             Same column layout as the line row (34 | 3* | *), and it
                                             has to stay the same: the two read as one block.        -->
                                        <Grid ClipToBounds="False"
                                              IsVisible="{Binding ShowLineAndSymbol}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="3*" MinWidth="60"/>
                                                <ColumnDefinition Width="*"  MinWidth="40" MaxWidth="95"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Symbol ISB: Off / Circle / Square -->
                                            <ctl:IconSelectButton Grid.Column="0"
                                                                  Margin="0,0,6,0"
                                                                  ItemsSource="{x:Static vm:PlotInspectorViewModel.SymbolModes}"
                                                                  SelectedItem="{Binding SelectedSymbolMode, Mode=TwoWay}"
                                                                  Highlight="{Binding MarkerEnabled}"
                                                                  HighlightSelected="False"
                                                                  ToolTip.Tip="Marker shape (Off / Circle / Square)">
                                                <ctl:IconSelectButton.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SymbolModeItem">
                                                        <mi:MaterialIcon Kind="{Binding Icon}"
                                                                         Width="10" Height="10"
                                                                         Opacity="{Binding Opacity}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ctl:IconSelectButton.ItemTemplate>
                                            </ctl:IconSelectButton>

                                            <!-- Col 1: NUD(30) + Slider(*) nested -->
                                            <Grid Grid.Column="1"
                                                  ColumnDefinitions="30,*"
                                                  ClipToBounds="False"
                                                  Margin="0,0,3,0">
                                                <NumericUpDown Grid.Column="0"
                                                               Value="{Binding MarkerSize,
                                                                   Converter={StaticResource D2D},
                                                                   Mode=TwoWay}"
                                                               Minimum="0.5" Maximum="5"
                                                               Increment="0.25"
                                                               FormatString="F2"
                                                               IsEnabled="{Binding MarkerEnabled}"
                                                               ToolTip.Tip="Symbol size (px)"/>
                                                <Slider Grid.Column="1"
                                                        Value="{Binding MarkerSize, Mode=TwoWay}"
                                                        Minimum="0.5" Maximum="5"
                                                        SmallChange="0.25"
                                                        MinWidth="20"
                                                        IsEnabled="{Binding MarkerEnabled}"/>
                                            </Grid>

                                            <!-- Col 2: the colour swatch -->
                                            <ctl:IconSelectButton Grid.Column="2"
                                                                  HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static vm:PlotInspectorViewModel.ColorItems}"
                                                                  SelectedItem="{Binding SelectedMarkerColor, Mode=TwoWay}"
                                                                  IsEnabled="{Binding MarkerEnabled}"
                                                                  Highlight="False"
                                                                  HighlightSelected="False"
                                                                  ToolTip.Tip="Marker color">
                                                <ctl:IconSelectButton.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ColorItem">
                                                        <Border Background="{Binding Brush}"
                                                                CornerRadius="3"
                                                                MinWidth="20" Height="12"
                                                                HorizontalAlignment="Stretch"
                                                                ToolTip.Tip="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ctl:IconSelectButton.ItemTemplate>
                                            </ctl:IconSelectButton>

                                        </Grid>

                                        <!-- Z0 row: S-param (network or cube-bound) traces, and a Γ-plane contour -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding ShowZ0Row}">

                                            <TextBlock Text="Z0"
                                                       Classes="label" Margin="0,0,0,0"
                                                       VerticalAlignment="Center"/>

                                            <!-- Read-only-by-default box + Override checkbox. brief-dd-z0-renormalization.md
                                                 §2: an "unusual" (non-uniform/complex) source no longer replaces this with a
                                                 static label — renormalizing a per-port source to a uniform user Z0 is exactly
                                                 what RFNetwork.SToS/RenormalizeSCube already do; ShowZ0Badge/Z0BadgeTooltip
                                                 carry the "source was unusual" provenance indicator instead. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding ShowZ0Control}"
                                                        VerticalAlignment="Center">
                                                <TextBox Text="{Binding Z0String, Mode=TwoWay}"
                                                         IsEnabled="{Binding IsZ0Editable}"
                                                         FontSize="{StaticResource FontSize}"
                                                         Height="20"
                                                         MinHeight="0"
                                                         Width="120"
                                                         Padding="4,3"
                                                         PlaceholderText="50+j0"
                                                         ToolTip.Tip="{Binding Z0ErrorText}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="Ω"
                                                           Classes="label"
                                                           VerticalAlignment="Center"/>
                                                <CheckBox Content="Override"
                                                          IsChecked="{Binding Z0OverrideEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          FontSize="{StaticResource FontSize}"/>
                                                <TextBlock Text="{Binding Z0ErrorText}"
                                                           IsVisible="{Binding HasZ0Error}"
                                                           Classes="label"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{DynamicResource SystemBaseMediumColor}" Opacity="0.85"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </StackPanel>

                                        </StackPanel>

                                    </StackPanel>
                                    <!-- end trace body -->

                                </StackPanel>
                                <!-- Col 1: trash button pinned to card top-right -->
                                <Button Grid.Column="1"
                                        Classes="removeTrace"
                                        Command="{Binding RemoveCommand}"
                                        VerticalAlignment="Top"
                                        ToolTip.Tip="Remove this trace">
                                    <mi:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                                </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Border>
            </ScrollViewer>

            <!-- ── Footer ─────────────────────────────────────────────────── -->
            <Separator/>
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Padding="12,4,12,4"/>
        </StackPanel>
    </Border>
</UserControl>
