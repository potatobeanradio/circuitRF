<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             x:Class="CircuitRF.Ui.Views.DataDisplay.MarkerEditorView"
             x:DataType="vm:MarkerEditorViewModel"
             Width="250">

    <Design.DataContext>
        <x:Static Member="vm:MarkerEditorViewModel.DesignInstance"/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- ── Opacity-tiered field labels ──────────────────────────────── -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="Opacity"           Value="0.6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Compact TextBox ──────────────────────────────────────────── -->
        <Style Selector="TextBox">
            <Setter Property="FontSize"  Value="10"/>
            <Setter Property="Height"    Value="22"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding"   Value="4,1"/>
        </Style>

        <!-- ── Compact ComboBox (no chevron, full-width content) ─────────  -->
        <Style Selector="ComboBox">
            <Setter Property="FontSize"                   Value="10"/>
            <Setter Property="MinHeight"                  Value="0"/>
            <Setter Property="Padding"                    Value="4,1"/>
            <Setter Property="Height"                     Value="22"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width"     Value="0"/>
            <Setter Property="MinWidth"  Value="0"/>
        </Style>
        <Style Selector="ComboBox /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- ── Compact NumericUpDown ─────────────────────────────────────── -->
        <Style Selector="NumericUpDown">
            <Setter Property="FontSize"                 Value="10"/>
            <Setter Property="Height"                   Value="22"/>
            <Setter Property="MinWidth"                 Value="10"/>
            <Setter Property="Padding"                  Value="4,1"/>
            <Setter Property="ShowButtonSpinner"        Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Segmented ToggleButton — idle ─────────────────────────────── -->
        <Style Selector="ToggleButton.seg-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="MinWidth"        Value="0"/>
            <Setter Property="FontSize"        Value="10"/>
        </Style>
        <!-- ── Checked (active) — accent bg + white foreground ───────────── -->
        <Style Selector="ToggleButton.seg-btn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.seg-btn:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorLight1}"/>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.seg-btn:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource SystemAccentColorDark1}"/>
            </Setter>
        </Style>
    </UserControl.Styles>

    <!-- ── Outer inspector card ─────────────────────────────────────────── -->
    <Border Background="{DynamicResource SystemChromeMediumLowColor}"
            CornerRadius="8"
            Padding="10">
        <StackPanel Spacing="8">

            <!-- Name — label + box on one row -->
            <Grid ColumnDefinitions="Auto,8,*">
                <TextBlock Grid.Column="0" Text="Marker Name" Classes="label"/>
                <TextBox  Grid.Column="2" Text="{Binding Name}"/>
            </Grid>

            <!-- Frequency — committed on Enter, snapped to nearest data point;
                 hidden for contour and spectrum markers -->
            <StackPanel Spacing="3" IsVisible="{Binding ShowFrequencyField}">
                <TextBlock Text="{Binding FreqUnitLabel, StringFormat='Frequency ({0})'}"
                           Classes="label"/>
                <TextBox x:Name="FreqTextBox"
                         Text="{Binding FreqDisplayText}"
                         Width="120"
                         HorizontalAlignment="Left"
                         KeyDown="OnFreqTextBoxKeyDown"/>
            </StackPanel>

            <!-- Data readout block — card-styled, read-only live values -->
            <Border Background="{DynamicResource SystemChromeLowColor}"
                    BorderBrush="{DynamicResource CrfTileBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,6">
                <StackPanel Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <SelectableTextBlock Grid.Column="0"
                                             Text="{Binding OwnDataLine}"
                                             TextWrapping="Wrap"
                                             FontSize="11"/>
                        <SelectableTextBlock Grid.Column="1"
                                             Text="{Binding OwnZ0Line}"
                                             FontSize="11"
                                             Opacity="0.55"
                                             IsVisible="{Binding ShowZ0Line}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MultiLines}"
                                  IsVisible="{Binding HasMultiLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MultiTraceLineItem">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding DataText}"
                                                         TextWrapping="Wrap"
                                                         FontSize="11"
                                                         Opacity="0.55"/>
                                    <SelectableTextBlock Grid.Column="1"
                                                         Text="{Binding Z0Text}"
                                                         FontSize="11"
                                                         Opacity="0.55"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Impedance — contour markers only; label + box on one row; Enter commits + moves marker -->
            <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding ShowImpedanceField}">
                <TextBlock Grid.Column="0" Text="Impedance (Ω)" Classes="label"/>
                <TextBox Grid.Column="2"
                         x:Name="ImpedanceTextBox"
                         Text="{Binding ImpedanceText}"
                         KeyDown="OnImpedanceKeyDown"/>
            </Grid>

            <!-- VSWR: toggle + value on one row — placed above Format -->
            <Grid ColumnDefinitions="Auto,8,Auto,6,Auto"
                  IsVisible="{Binding ShowVswrControls}">
                <ToggleButton Grid.Column="0"
                              Classes="seg-btn"
                              IsChecked="{Binding VswrEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Draw a constant-VSWR circle around this marker">
                    VSWR
                </ToggleButton>
                <TextBlock Grid.Column="2"
                           Text="VSWR"
                           Classes="label"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="4"
                         x:Name="VswrValueTextBox"
                         Text="{Binding VswrValueText}"
                         Width="64"
                         KeyDown="OnVswrValueKeyDown"/>
            </Grid>

            <!-- Format — Smith/Polar + contour; shows mA / RI / dB casing -->
            <StackPanel Spacing="3" IsVisible="{Binding ShowFormatSelector}">
                <TextBlock Text="Format" Classes="label"/>
                <ComboBox ItemsSource="{x:Static vm:MarkerEditorViewModel.AllFormats}"
                          SelectedItem="{Binding MatrixFormat}"
                          Width="72"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:MatrixFormatConverter.Instance}}"
                                       FontSize="10"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Normalize (ToggleButton) -->
            <ToggleButton Classes="seg-btn"
                          IsChecked="{Binding UseNormalized, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding ShowNormZ}"
                          ToolTip.Tip="Normalize to reference impedance">
                Norm Z
            </ToggleButton>

            <!-- Multi-marker / Δ Delta — Rect only -->
            <StackPanel Orientation="Horizontal" Spacing="4"
                        IsVisible="{Binding ShowMultiDeltaControls}">
                <ToggleButton Classes="seg-btn"
                              IsChecked="{Binding IsMulti, Mode=TwoWay}"
                              ToolTip.Tip="Multi-marker mode">
                    Multi
                </ToggleButton>
                <ToggleButton Classes="seg-btn"
                              IsChecked="{Binding IsDelta, Mode=TwoWay}"
                              ToolTip.Tip="Delta mode">
                    Δ
                </ToggleButton>
            </StackPanel>

            <!-- Show Info Box — locked on for Table plots (no on-canvas way to re-open a hidden box) -->
            <ToggleButton Classes="seg-btn"
                          IsChecked="{Binding ShowInfoBox, Mode=TwoWay}"
                          IsEnabled="{Binding CanToggleInfoBox}"
                          HorizontalAlignment="Left"
                          ToolTip.Tip="Show this marker's info box (always on for Table plots)">
                Info Box
            </ToggleButton>

            <!-- Contour mode: snap to grid point vs free/interpolated -->
            <ToggleButton Classes="seg-btn"
                          IsChecked="{Binding ContourSnapped, Mode=TwoWay}"
                          IsVisible="{Binding ShowContourModeToggle}"
                          ToolTip.Tip="Snap to grid point (off = free / interpolated)">
                Snap to Point
            </ToggleButton>

            <!-- Precision / Digits / Size — always at the bottom -->
            <Grid ColumnDefinitions="Auto,8,Auto,8,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Precision" Classes="label"/>
                    <ComboBox ItemsSource="{x:Static vm:MarkerEditorViewModel.AllPrecisionFormats}"
                              SelectedItem="{Binding FormatString}"
                              Width="92">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static vm:PrecisionFormatConverter.Instance}}"
                                           FontSize="10"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="Digits" Classes="label"/>
                    <NumericUpDown Value="{Binding Digits}"
                                   Minimum="1" Maximum="16"
                                   Increment="1"
                                   FormatString="0"
                                   Width="40"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="3">
                    <TextBlock Text="Size" Classes="label"/>
                    <ComboBox ItemsSource="{x:Static vm:MarkerEditorViewModel.AllStyles}"
                              SelectedItem="{Binding Style}"
                              Width="68">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static vm:MarkerStyleConverter.Instance}}"
                                           FontSize="10"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>

</UserControl>
