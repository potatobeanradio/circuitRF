<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             x:Class="CircuitRF.Ui.Views.DataDisplay.MarkerEditorView"
             x:DataType="vm:MarkerEditorViewModel"
             Width="240"
             Padding="12">

    <Design.DataContext>
        <x:Static Member="vm:MarkerEditorViewModel.DesignInstance"/>
    </Design.DataContext>

    <StackPanel Spacing="8">

        <!-- Name -->
        <StackPanel Spacing="4">
            <TextBlock Text="Marker Name" FontSize="11" Opacity="0.6"/>
            <TextBox Text="{Binding Name}" />
        </StackPanel>

        <!-- Frequency — committed to model on Enter, snapped to nearest data point -->
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding FreqUnitLabel, StringFormat='Frequency ({0})'}"
                       FontSize="11" Opacity="0.6"/>
            <TextBox x:Name="FreqTextBox"
                     Text="{Binding FreqDisplayText}"
                     Width="120" HorizontalAlignment="Left"
                     KeyDown="OnFreqTextBoxKeyDown"/>
        </StackPanel>

        <!-- Data value for the marker's own trace (always shown) -->
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <SelectableTextBlock Grid.Column="0"
                                     Text="{Binding OwnDataLine}"
                                     TextWrapping="Wrap"
                                     FontSize="11"/>
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding OwnZ0Line}"
                                     FontSize="11"/>
            </Grid>
        </StackPanel>

        <!-- Multi-marker: additional row per other trace -->
        <StackPanel Spacing="4" IsVisible="{Binding HasMultiLines}">
            <ItemsControl ItemsSource="{Binding MultiLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MultiTraceLineItem">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                            <SelectableTextBlock Grid.Column="0"
                                                 Text="{Binding DataText}"
                                                 TextWrapping="Wrap"
                                                 FontSize="11"/>
                            <SelectableTextBlock Grid.Column="1"
                                                 Text="{Binding Z0Text}"
                                                 FontSize="11"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Format (complex only) | Precision | Digits — all on one row.
             Format Auto-column + its spacer collapse on Rect plots. -->
        <Grid ColumnDefinitions="Auto,Auto,*,8,Auto">
            <!-- Format — hidden on Rect plots where values are always scalar -->
            <StackPanel Grid.Column="0" Spacing="4" IsVisible="{Binding ShowFormatSelector}">
                <TextBlock Text="Format" FontSize="11" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Static vm:MarkerEditorViewModel.AllFormats}"
                          SelectedItem="{Binding MatrixFormat}"
                          Width="72"/>
            </StackPanel>

            <!-- Gap after Format — collapses with Format when hidden -->
            <Border Grid.Column="1" Width="8" IsVisible="{Binding ShowFormatSelector}"/>

            <!-- Precision (Auto / Fixed / Scientific) -->
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Precision" FontSize="11" Opacity="0.6"/>
                <ComboBox ItemsSource="{x:Static vm:MarkerEditorViewModel.AllPrecisionFormats}"
                          SelectedItem="{Binding FormatString}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:PrecisionFormatConverter.Instance}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Digits — compact, no spinner -->
            <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Digits" FontSize="11" Opacity="0.6"/>
                <NumericUpDown Value="{Binding Digits}"
                               Minimum="1" Maximum="16"
                               Increment="1"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               Width="52"/>
            </StackPanel>
        </Grid>

        <!-- Normalize Impedance CheckBox + Size ComboBox on the same row. -->
        <Grid ColumnDefinitions="*,8,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Column="2" Grid.Row="0"
                       Text="Display Size" FontSize="11" Opacity="0.6"/>
            <CheckBox Grid.Column="0" Grid.Row="1"
                      Content="Normalize Impedance"
                      IsChecked="{Binding UseNormalized}"/>
            <ComboBox Grid.Column="2" Grid.Row="1"
                      ItemsSource="{x:Static vm:MarkerEditorViewModel.AllStyles}"
                      SelectedItem="{Binding Style}"
                      Width="68">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static vm:MarkerStyleConverter.Instance}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Multi-marker / delta — only meaningful on Rect plots -->
        <StackPanel Spacing="4" IsVisible="{Binding ShowMultiDeltaControls}">
            <CheckBox Content="Multi-marker"
                      IsChecked="{Binding IsMulti}"/>
            <CheckBox Content="Δ Delta mode"
                      IsChecked="{Binding IsDelta}"/>
        </StackPanel>

    </StackPanel>

</UserControl>
