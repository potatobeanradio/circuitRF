<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:SnpLibraryViewModel"
             x:Class="CircuitRF.Ui.Views.DataDisplay.SnpLibraryView"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Padding"    Value="3"/>
            <Setter Property="Width"      Value="22"/>
            <Setter Property="Height"     Value="22"/>
            <Setter Property="MinHeight"  Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemBaseLowColor}"/>
        </Style>
        <!-- Broken / missing file entries shown in destructive-action colour, italic -->
        <Style Selector="TextBlock.broken">
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorTextColor}"/>
            <Setter Property="FontStyle"  Value="Italic"/>
        </Style>
    </UserControl.Styles>

    <DockPanel Background="{DynamicResource SystemChromeMediumLowColor}"
               DragDrop.AllowDrop="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Padding="8,5"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="SNP Library"
                           FontWeight="SemiBold"
                           FontSize="12"
                           VerticalAlignment="Center">
                    <ToolTip.Tip>
                        <TextBlock Text="Contains the list of s-parameter data currently loaded into memory.  Load a Touchstone file to add to SNP Library."
                                   TextWrapping="Wrap"
                                   MaxWidth="275"/>
                    </ToolTip.Tip>
                </TextBlock>
                <!-- Import button — bound to the command injected by the document container -->
                <Button Grid.Column="1"
                        Classes="icon"
                        Command="{Binding ImportCommand}"
                        ToolTip.Tip="Load Touchstone…  (Ctrl+L)">
                    <mi:MaterialIcon Kind="FileImportOutline" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <!-- Drop hint shown when list is empty.
             On Linux, Avalonia 12 does not implement the XDND protocol, so
             drag-and-drop from the file manager never fires.  Show a
             platform-specific hint so Linux users know to use Ctrl+L instead. -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding !Entries.Count}"
                Padding="8,12"
                Opacity="0.5"
                VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <mi:MaterialIcon Kind="FileImportOutline"
                                 Width="28" Height="28"
                                 HorizontalAlignment="Center"/>
                <TextBlock Text="{OnPlatform Default='Drop .snp files here',
                                             Linux='Use Ctrl+L to load files'}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <TextBlock Text="(drag-and-drop requires a future Avalonia update)"
                           IsVisible="{OnPlatform Default=False, Linux=True}"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Entry list -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SnpEntryViewModel">
                        <Grid ColumnDefinitions="*,22,22"
                              Margin="2,1">

                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Refresh"
                                              Command="{Binding RefreshCommand}"/>
                                    <MenuItem Header="{OnPlatform Default='Reveal in Explorer', macOS='Reveal in Finder'}"
                                              Command="{Binding RevealInExplorerCommand}"
                                              IsEnabled="{Binding !IsBroken}"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Path"
                                              Command="{Binding CopyPathCommand}"/>
                                    <MenuItem Header="Copy Path Relative"
                                              Command="{Binding CopyPathRelativeCommand}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <!-- File name / unique path suffix — red+italic when broken -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       Classes.broken="{Binding IsBroken}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Padding="6,2"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Snp.FilePath}"/>

                            <!-- Reload / find-missing -->
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="Reload from disk (or locate missing file)">
                                <mi:MaterialIcon Kind="Refresh"
                                                 Width="13" Height="13"/>
                            </Button>

                            <!-- Remove from library -->
                            <Button Grid.Column="2"
                                    Classes="icon"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="Remove from library">
                                <mi:MaterialIcon Kind="Close"
                                                 Width="13" Height="13"/>
                            </Button>

                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</UserControl>
