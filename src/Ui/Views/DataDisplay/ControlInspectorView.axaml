<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             x:Class="CircuitRF.Ui.Views.DataDisplay.ControlInspectorView"
             x:DataType="vm:ControlInspectorViewModel"
             IsVisible="{Binding IsActive, FallbackValue=False}">
    <!-- One label column, as the annotation inspector above it; the panel's own header names the kind. Nothing here
         appears or disappears beside a field when another option changes: the Range and Bound blocks are the same
         three rows, and the one problem line (a refused entry, or what is wrong with the domain) is reserved under
         both, so neither a domain switch nor a refusal moves anything below it. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Three short boxes on one line in the panel's usual width. -->
        <Style Selector="CheckBox.show">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Margin="8,4,8,8" Spacing="4">
        <Grid Classes="row" ColumnDefinitions="75,*">
            <TextBlock Classes="lbl" Text="Name"/>
            <TextBox x:Name="NameBox" Tag="NameText" Grid.Column="1" Text="{Binding NameText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" AutomationProperties.Name="Control name"
                     ToolTip.Tip="What a link names it by: @name"/>
        </Grid>
        <Grid Classes="row" ColumnDefinitions="75,*">
            <TextBlock Classes="lbl" Text="Label"/>
            <TextBox x:Name="LabelBox" Tag="LabelText" Grid.Column="1" Text="{Binding LabelText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" PlaceholderText="{Binding NameText}" AutomationProperties.Name="Control label"/>
        </Grid>

        <!-- brief-ddl-6: the button's two choices. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsButton}">
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Action"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="seg-btn" Classes.active="{Binding IsToggle}" Content="Toggle"
                            Command="{Binding SetToggleCommand}" ToolTip.Tip="A click turns it on, the next one off"/>
                    <Button Classes="seg-btn" Classes.active="{Binding IsMomentary}" Content="Momentary"
                            Command="{Binding SetMomentaryCommand}" ToolTip.Tip="On only while it is pressed"/>
                </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Label at"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="seg-btn" Classes.active="{Binding IsLabelUnder}" Content="Under"
                            Command="{Binding SetLabelUnderCommand}"/>
                    <Button Classes="seg-btn" Classes.active="{Binding IsLabelOnFace}" Content="On face"
                            Command="{Binding SetLabelOnFaceCommand}"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- brief-ddl-6: what a readout shows. Pickers only. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsReadout}">
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Source"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0"
                          ItemsSource="{Binding ReadoutSourceItems}" SelectedItem="{Binding SelectedReadoutSource, Mode=TwoWay}"
                          AutomationProperties.Name="Readout source"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Show"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="seg-btn" Classes.active="{Binding IsShowValue}" Content="Value"
                            Command="{Binding SetShowValueCommand}" ToolTip.Tip="The source's value: a marker's X, a control's setting"/>
                    <Button Classes="seg-btn" Classes.active="{Binding IsShowCoordinate}" Content="Coordinate"
                            Command="{Binding SetShowCoordinateCommand}" ToolTip.Tip="One coordinate the source supplies"/>
                    <Button Classes="seg-btn" Classes.active="{Binding IsShowReading}" Content="Reading"
                            Command="{Binding SetShowReadingCommand}" ToolTip.Tip="A marker's reading on its trace, as its info box gives it"/>
                </StackPanel>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Coordinate"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0" IsEnabled="{Binding ReadoutAxisEnabled}"
                          ItemsSource="{Binding ReadoutAxisItems}" SelectedItem="{Binding SelectedReadoutAxis, Mode=TwoWay}"
                          AutomationProperties.Name="Readout coordinate"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <CheckBox Grid.Column="1" Content="Name" IsChecked="{Binding ReadoutShowName, Mode=TwoWay}"
                          ToolTip.Tip="The label, or the source's name, above the value"/>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsStepped}">
        <Grid Classes="row" ColumnDefinitions="75,*">
            <TextBlock Classes="lbl" Text="Domain"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="seg-btn" Classes.active="{Binding IsRange}" Content="Range"
                        Command="{Binding SetRangeCommand}" ToolTip.Tip="Stops of its own: a start, a stop and a step"/>
                <Button Classes="seg-btn" Classes.active="{Binding IsBound}" Content="Bound"
                        Command="{Binding SetBoundCommand}" ToolTip.Tip="The samples of one axis of a data source"/>
            </StackPanel>
        </Grid>

        <!-- Range -->
        <StackPanel Spacing="4" IsVisible="{Binding IsRange}">
            <Grid Classes="row" ColumnDefinitions="75,*,52,*">
                <TextBlock Classes="lbl" Text="Start"/>
                <TextBox x:Name="StartBox" Tag="StartText" Grid.Column="1" Text="{Binding StartText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" MinWidth="0" AutomationProperties.Name="Range start"/>
                <TextBlock Grid.Column="2" Classes="lbl" Text="Stop" Margin="8,0,0,0"/>
                <TextBox x:Name="StopBox" Tag="StopText" Grid.Column="3" Text="{Binding StopText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" MinWidth="0" AutomationProperties.Name="Range stop"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*,52,*">
                <TextBlock Classes="lbl" Text="Step"/>
                <TextBox x:Name="StepBox" Tag="StepText" Grid.Column="1" Text="{Binding StepText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsEnabled="{Binding StepEnabled}" PlaceholderText="{Binding StepPlaceholder}"
                         KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" MinWidth="0" AutomationProperties.Name="Range step"
                         ToolTip.Tip="The spacing; 0 is continuous. Greyed while a point count sets it."/>
                <TextBlock Grid.Column="2" Classes="lbl" Text="Points" Margin="8,0,0,0"/>
                <TextBox x:Name="PointsBox" Tag="PointsText" Grid.Column="3" Text="{Binding PointsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" MinWidth="0" PlaceholderText="auto" AutomationProperties.Name="Range points"
                         ToolTip.Tip="A point count, which sets the step; blank uses the step"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*,Auto">
                <TextBlock Classes="lbl" Text="Unit"/>
                <ComboBox x:Name="UnitBox" Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0"
                          IsEditable="True" ItemsSource="{Binding UnitChoices}" Text="{Binding UnitText, Mode=OneWay}"
                          LostFocus="OnUnitCommit" KeyDown="OnUnitKeyDown" SelectionChanged="OnUnitSelectionChanged"
                          AutomationProperties.Name="Range unit"/>
                <CheckBox Grid.Column="2" Content="Log" IsChecked="{Binding Log, Mode=TwoWay}" Margin="8,0,0,0"
                          ToolTip.Tip="Log spacing, over a point count"/>
            </Grid>
        </StackPanel>

        <!-- Bound: pickers only, each listing what the one before it offers. -->
        <StackPanel Spacing="4" IsVisible="{Binding IsBound}">
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Source"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0"
                          ItemsSource="{Binding SourceItems}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          AutomationProperties.Name="Bound source"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Quantity"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0"
                          ItemsSource="{Binding QuantityItems}" SelectedItem="{Binding SelectedQuantity, Mode=TwoWay}"
                          AutomationProperties.Name="Bound quantity"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="75,*">
                <TextBlock Classes="lbl" Text="Axis"/>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MinWidth="0"
                          ItemsSource="{Binding AxisItems}" SelectedItem="{Binding SelectedAxis, Mode=TwoWay}"
                          AutomationProperties.Name="Bound axis"/>
            </Grid>
        </StackPanel>
        </StackPanel>

        <!-- Reserved under both blocks: one line, the full sentence in its tooltip. -->
        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource CrfWarningBrush}" FontSize="11"
                   MinHeight="15" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Problem}"/>

        <Grid Classes="row" ColumnDefinitions="75,*" IsVisible="{Binding IsSlider}">
            <TextBlock Classes="lbl" Text="Orientation"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="seg-btn" Classes.active="{Binding IsHorizontal}" Content="Horizontal"
                        Command="{Binding SetHorizontalCommand}"/>
                <Button Classes="seg-btn" Classes.active="{Binding IsVertical}" Content="Vertical"
                        Command="{Binding SetVerticalCommand}"/>
            </StackPanel>
        </Grid>
        <Grid Classes="row" ColumnDefinitions="75,*">
            <TextBlock Classes="lbl" Text="Size"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="seg-btn" Classes.active="{Binding IsSmall}" Content="S" MinWidth="26"
                        HorizontalContentAlignment="Center" Command="{Binding SetSmallCommand}" ToolTip.Tip="Small"/>
                <Button Classes="seg-btn" Classes.active="{Binding IsMedium}" Content="M" MinWidth="26"
                        HorizontalContentAlignment="Center" Command="{Binding SetMediumCommand}" ToolTip.Tip="Medium"/>
                <Button Classes="seg-btn" Classes.active="{Binding IsLarge}" Content="L" MinWidth="26"
                        HorizontalContentAlignment="Center" Command="{Binding SetLargeCommand}" ToolTip.Tip="Large"/>
                <TextBlock Text="Custom" IsVisible="{Binding IsCustom}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>
        </Grid>
        <Grid Classes="row" ColumnDefinitions="75,*" IsVisible="{Binding IsStepped}">
            <TextBlock Classes="lbl" Text="Show"/>
            <!-- Two by two, the same at every panel width: a wrap would leave "Value" alone on a second line. -->
            <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
                <CheckBox Classes="show" Content="Label" IsChecked="{Binding ShowLabel, Mode=TwoWay}"
                          ToolTip.Tip="The name or label inside the control. Off, the slider moves into its space"/>
                <CheckBox Classes="show" Content="Ticks" IsChecked="{Binding ShowTicks, Mode=TwoWay}"/>
                <CheckBox Classes="show" Content="Ends" IsChecked="{Binding ShowEnds, Mode=TwoWay}"
                          ToolTip.Tip="The first and last values at the ends of the track"/>
                <CheckBox Classes="show" Content="Value" IsChecked="{Binding ShowValue, Mode=TwoWay}"
                          ToolTip.Tip="The value it is on, as a readout"/>
            </UniformGrid>
        </Grid>
        <Grid Classes="row" ColumnDefinitions="75,Auto,*">
            <TextBlock Classes="lbl" Text="{Binding AccentLabel}"/>
            <Button Grid.Column="1" Click="PickAccent" ToolTip.Tip="Choose the accent colour"
                    AutomationProperties.Name="Accent colour" VerticalAlignment="Center">
                <Border Width="20" Height="14" BorderThickness="1" Background="{Binding AccentSwatch}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </Button>
            <Button Grid.Column="2" Click="ResetAccent" Content="Default" Margin="4,0,0,0" VerticalAlignment="Center"
                    IsEnabled="{Binding !IsDefaultAccent}"/>
        </Grid>
        <!-- A button's eight preset colours; the swatch above opens any other. -->
        <Grid Classes="row" ColumnDefinitions="75,*" IsVisible="{Binding IsButton}">
            <ItemsControl Grid.Column="1" ItemsSource="{Binding ColorPresets}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ColorPreset">
                        <Button Padding="0" MinWidth="0" MinHeight="0" Width="18" Height="18" ToolTip.Tip="{Binding Hex}"
                                Command="{Binding $parent[ItemsControl].((vm:ControlInspectorViewModel)DataContext).PickPresetCommand}"
                                CommandParameter="{Binding}">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Swatch}" BorderThickness="1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <Grid Classes="row" ColumnDefinitions="75,*">
            <CheckBox Grid.Column="1" Content="Lock Position" IsChecked="{Binding Locked, Mode=TwoWay}"
                      ToolTip.Tip="Neither moved nor resized; it still operates"/>
        </Grid>
    </StackPanel>
</UserControl>
