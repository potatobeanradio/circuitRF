<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dd="using:CircuitRF.Ui.DataDisplay"
             xmlns:v="using:CircuitRF.Ui.Views.DataDisplay"
             x:Class="CircuitRF.Ui.Views.DataDisplay.DataDisplayView"
             x:DataType="dd:DataDisplayDocument">

    <!-- Full-bleed canvas surface matching other document bodies. -->
    <Grid>
        <!-- Active tab's canvas fills the document area. -->
        <v:PlotCanvasView DataContext="{Binding ViewModel.Window.ActiveTab}"/>

        <!-- TEMP 3a — replaced by the toolbar in 3b -->
        <Button Content="Add Plot"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Command="{Binding ViewModel.Window.AddPlotCommand}"/>
    </Grid>

</UserControl>
