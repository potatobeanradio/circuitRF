<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             x:DataType="vm:AxesLimitsViewModel"
             x:Class="CircuitRF.Ui.Views.DataDisplay.AxesLimitsView"
             Width="300">

    <Border Background="{DynamicResource SystemChromeMediumLowColor}"
            CornerRadius="8"
            Padding="12">
        <StackPanel Spacing="8">

            <TextBlock Text="Axes Limits"
                       FontWeight="SemiBold"
                       FontSize="13"
                       HorizontalAlignment="Center"/>

            <Separator/>

            <!-- ── X Axis ─────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="X Axis"
                               FontWeight="SemiBold"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding XUnitLabel}"
                               FontSize="10"
                               Opacity="0.7"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding XAutoscale, Mode=TwoWay}"
                          Content="Autoscale"
                          FontSize="11"
                          VerticalAlignment="Center"/>
            </Grid>
            <!-- The X axis's own mapping. Its own row rather than squeezed onto the header row
                 beside Autoscale: at this flyout's 300 px the header already carries "X Axis", the
                 unit and the Autoscale box. Rect only — a Smith or Polar X carries Re(Γ), which is
                 signed, and the Y blocks below are deliberately untouched (there is no log Y). -->
            <StackPanel Orientation="Horizontal" Spacing="10"
                        IsVisible="{Binding ShowXScale}">
                <TextBlock Text="Scale"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Width="32"/>
                <RadioButton
                             Content="Linear"
                             FontSize="11"
                             IsChecked="{Binding !XLogScale}"
                             VerticalAlignment="Center"/>
                <RadioButton
                             Content="Log"
                             FontSize="11"
                             IsChecked="{Binding XLogScale, Mode=TwoWay}"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <Grid ColumnDefinitions="32,*,8,32,*"
                  IsEnabled="{Binding XFieldsEnabled}">
                <TextBlock Grid.Column="0" Text="Min"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding XMinText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
                <TextBlock Grid.Column="3" Text="Max"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="4"
                           Text="{Binding XMaxText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
            </Grid>

            <Grid ColumnDefinitions="32,*,8,32,*" IsVisible="{Binding ShowStep}">
                <TextBlock Grid.Column="0" Text="Step"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding XStepText, Mode=TwoWay}"
                           IsEnabled="{Binding XStepEnabled}"
                           PlaceholderText="Auto"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"
                           ToolTip.Tip="Spacing of the numbered grid lines along X, in the axis's units. Empty is automatic. Linear axis only."/>
            </Grid>

            <Separator/>

            <!-- ── Y Axis (primary left) ──────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Y Axis"
                           FontWeight="SemiBold"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding YAutoscale, Mode=TwoWay}"
                          Content="Autoscale"
                          FontSize="11"
                          VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="32,*,8,32,*"
                  IsEnabled="{Binding YFieldsEnabled}">
                <TextBlock Grid.Column="0" Text="Min"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding YMinText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
                <TextBlock Grid.Column="3" Text="Max"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="4"
                           Text="{Binding YMaxText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
            </Grid>

            <Grid ColumnDefinitions="32,*,8,32,*" IsVisible="{Binding ShowStep}">
                <TextBlock Grid.Column="0" Text="Step"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding YStepText, Mode=TwoWay}"
                           PlaceholderText="Auto"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"
                           ToolTip.Tip="Spacing of the numbered grid lines along Y, in the axis's units. Empty is automatic."/>
            </Grid>

            <!-- ── Y2 Axis (secondary right, Rect only) ───── -->
            <Separator IsVisible="{Binding ShowY2}"/>

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowY2}">
                <TextBlock Grid.Column="0"
                           Text="Y2 Axis (Right)"
                           FontWeight="SemiBold"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding Y2Autoscale, Mode=TwoWay}"
                          Content="Autoscale"
                          FontSize="11"
                          VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnDefinitions="32,*,8,32,*"
                  IsEnabled="{Binding Y2FieldsEnabled}"
                  IsVisible="{Binding ShowY2}">
                <TextBlock Grid.Column="0" Text="Min"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Y2MinText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
                <TextBlock Grid.Column="3" Text="Max"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="4"
                           Text="{Binding Y2MaxText, Mode=TwoWay}"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"/>
            </Grid>

            <Grid ColumnDefinitions="32,*,8,32,*" IsVisible="{Binding ShowY2}">
                <TextBlock Grid.Column="0" Text="Step"
                           VerticalAlignment="Center"
                           FontSize="11"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Y2StepText, Mode=TwoWay}"
                           PlaceholderText="Auto"
                           FontSize="11"
                           Height="24"
                           Padding="4,2"
                           ToolTip.Tip="Spacing of the numbered grid lines on the right-hand axis, in its units. Empty is automatic."/>
            </Grid>

            <!-- One world unit as many pixels along X as along Y (Rect, brief NZ-8): a constellation's circle of error
                 stays a circle. The plot box narrows; the limits above are unchanged. -->
            <Separator IsVisible="{Binding ShowXScale}"/>
            <CheckBox IsChecked="{Binding EqualAspect, Mode=TwoWay}"
                      IsVisible="{Binding ShowXScale}"
                      Content="Equal X and Y scale (1:1)"
                      FontSize="11"
                      ToolTip.Tip="One unit is as long along X as along Y: the plot box narrows to keep it, the limits stay as set. Linear axes only."/>

            <Separator/>

            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    Width="50"/>

        </StackPanel>
    </Border>

</UserControl>
