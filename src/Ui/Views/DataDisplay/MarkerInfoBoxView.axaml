<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.DataDisplay.ViewModels"
             xmlns:ctl="using:CircuitRF.Ui.Controls"
             x:Class="CircuitRF.Ui.Views.DataDisplay.MarkerInfoBoxView"
             x:DataType="vm:MarkerInfoBoxViewModel"
             Width="{Binding BoxWidth}"
             Height="{Binding BoxHeight}"
             IsVisible="{Binding IsBoxVisible}"
             Background="Transparent">

    <!--
        Background="Transparent" is required for Avalonia hit-testing.
        Without a non-null background, a UserControl with no visual children
        is not hit-testable, so pointer events (drag, double-tap) would fall through.
        The actual box is rendered entirely in Skia via ICustomDrawOperation.
        Width/Height are set from MeasureInfoBox() so hit bounds match the Skia box.
        Cursor=Hand signals the box is draggable.
    -->

    <Canvas>
        <!-- The application's inline editor: the label's own face and size, its number placed on the frequency's own
             baseline after "freq=". The unit is not in the box: it is plain text just past the box's right edge, on the
             same baseline, so only the number is edited (OpenFrequencyEditor, PlaceFrequencyUnit). -->
        <ctl:SchematicInlineEditBox x:Name="FrequencyEditor"/>
        <TextBlock x:Name="FrequencyUnit" IsVisible="False" IsHitTestVisible="False"/>
    </Canvas>
</UserControl>
