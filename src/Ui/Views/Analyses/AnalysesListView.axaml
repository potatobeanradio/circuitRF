<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Analyses.AnalysesListView"
             x:DataType="vm:AnalysesListViewModel"
             Background="{DynamicResource SystemChromeLowColor}">

    <UserControl.Resources>
        <vm:BoolToIndentConverter x:Key="IndentConv"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Remove ListBoxItem padding so the DataTemplate Border controls its own padding -->
        <Style Selector="ListBox.AnalysisRows ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>

        <!-- The Expander's header must span the panel whether it is open or shut. Left to the theme,
             the collapsed control sizes to its header content and the expanded one to its (wider)
             body, so the block visibly changes width as it is toggled. Selected by TYPE inside the
             template rather than by a part name: a name that does not exist matches nothing and
             fails silently. -->
        <Style Selector="Expander.corners /template/ ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Expander.corners /template/ ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Schematic name + Run -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="4,4,4,1">
            <Button Grid.Column="0"
                    Command="{Binding RunCommand}"
                    ToolTip.Tip="Run analysis"
                    Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,5,0">
                <mi:MaterialIcon Kind="Play" Width="15" Height="15"
                                 Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding HeaderLabel}"
                       FontWeight="SemiBold" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,2">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">

                <Button Command="{Binding AddCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Add analysis" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding EditCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Edit selected analysis" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="Pencil" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding DuplicateCommand}"
                        ToolTip.Tip="Duplicate selected analysis" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding RemoveCommand}"
                        ToolTip.Tip="Remove selected analysis" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,2,0">
                    <mi:MaterialIcon Kind="Delete" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding MoveUpCommand}"
                        ToolTip.Tip="Move up (inner / earlier)" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="ChevronUp" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding MoveDownCommand}"
                        ToolTip.Tip="Move down (outer / later)" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                    <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>

                <Border Width="1" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                        Background="{DynamicResource SystemBaseLowColor}"/>

                <Button Command="{Binding CopyCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Copy selected analyses (⌘C / Ctrl+C)" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding CopyAllCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Copy all analyses" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="SelectAll" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding PasteCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Paste analyses (⌘V / Ctrl+V)" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,4,0">
                    <mi:MaterialIcon Kind="ContentPaste" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>

                <Border Width="1" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                        Background="{DynamicResource SystemBaseLowColor}"/>

                <Button Command="{Binding InsertFromTemplateCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Insert from Template…" Padding="3,2" Background="Transparent" BorderThickness="0" Margin="0,0,1,0">
                    <mi:MaterialIcon Kind="FileImportOutline" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
                <Button Command="{Binding SaveAsTemplateCommand}" CommandParameter="{Binding $parent[Window]}"
                        ToolTip.Tip="Save as Template…" Padding="3,2" Background="Transparent" BorderThickness="0">
                    <mi:MaterialIcon Kind="BookmarkPlusOutline" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" Click="OnHelp"
                    ToolTip.Tip="Help" Padding="3,2" Background="Transparent" BorderThickness="0">
                <mi:MaterialIcon Kind="HelpCircleOutline" Width="14" Height="14" Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </Button>
        </Grid>

        <!-- Body — results file, corners, the analyses list, footer.

             ONE ScrollViewer, whose scroll mode is conditional (AnalysesListViewModel.BodyScrollMode):
             Disabled with no corners, so the body is constrained to the viewport and the analyses
             ListBox scrolls itself exactly as before — no scroller inside a scroller. Auto once
             corners exist, so an expanded corner list and the analyses below it are both reachable. -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="{Binding BodyScrollMode}"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Results file override (R-res-2/3) — one file per RUN, so this is a single schematic-level
             field here, never a per-analysis-card field. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
              IsVisible="{Binding !NoActiveSchematic}"
              Margin="4,0,4,4">
            <TextBlock Grid.Column="0" Text="Results file:"
                       FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Grid.Column="1" Name="ResultsFileNameBox"
                     Text="{Binding ResultsFileNameText}"
                     PlaceholderText="{Binding HeaderLabel, StringFormat='{}{0}.npy'}"
                     FontSize="11" Padding="4,2"
                     GotFocus="OnResultsFileNameGotFocus"
                     LostFocus="OnResultsFileNameLostFocus"
                     KeyDown="OnResultsFileNameKeyDown"
                     ToolTip.Tip="Blank overwrites the default results file on every run. Naming a file
here is how you preserve a baseline instead of the current results — either way, the named file
overwrites silently on every subsequent run under that same name."/>
        </Grid>

        <!-- Corners — ABSENT, not greyed, when no referenced kit declares any. A corner is a
             property of THIS testbench's run, which is why it sits beside the results-file field
             rather than on a workspace-wide surface.

             COLLAPSED by default, and height-capped when open: a kit declares one corner file
             per device family per simulator flavour (twelve of them), which as an always-open list
             pushed the analyses off the panel entirely. -->
        <Expander Grid.Row="1"
                  Classes="corners"
                  IsVisible="{Binding HasCorners}"
                  IsExpanded="{Binding CornersExpanded, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Margin="4,0,4,4"
                  Padding="0">
            <Expander.Header>
                <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                    <TextBlock Grid.Column="0"
                               Text="Corners" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CornersSummaryText}"
                               FontSize="10" Opacity="0.55"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Expander.Header>

            <StackPanel Spacing="4" Margin="0,2,0,0">
                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                           Text="A corner is a named set of process constants the kit ships (typical, slow, fast, …). Choosing one substitutes those values into this testbench before it runs; the kit's own default is used where nothing is chosen."/>

                <!-- No scroller of its own: the panel body's single conditional ScrollViewer
                     (above) is what makes an expanded list and the analyses below it both
                     reachable, without one scroller nested inside another. -->
                <ItemsControl ItemsSource="{Binding CornerRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CornerAxisRowViewModel">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,1"
                                      ToolTip.Tip="{Binding ToolTip}">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               MinWidth="92" MaxWidth="132"
                                               TextTrimming="CharacterEllipsis"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              FontSize="11" Padding="4,2">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CornerOption">
                                                <TextBlock Text="{Binding Label}" FontSize="11"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <!-- List area -->
        <Grid Grid.Row="2">

            <!-- No active schematic -->
            <TextBlock Text="Open a schematic to set up analyses."
                       IsVisible="{Binding NoActiveSchematic}"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       FontSize="11" TextWrapping="Wrap"
                       Margin="8,6"
                       VerticalAlignment="Top"/>

            <!-- Empty state — schematic is open but has no analyses yet -->
            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8" Margin="12">
                <TextBlock Text="No analyses yet."
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           FontSize="12" TextAlignment="Center"/>
                <TextBlock Text="Add one to simulate this schematic."
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Command="{Binding AddCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Plus" Width="14" Height="14"/>
                        <TextBlock Text="Add Analysis" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- The rows — ListBox: selection, multi-select copy, double-click to edit -->
            <ListBox Classes="AnalysisRows"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     SelectionMode="Multiple"
                     IsVisible="{Binding !IsEmpty}"
                     DoubleTapped="OnRowDoubleTapped"
                     SelectionChanged="OnSelectionChanged"
                     KeyDown="OnListKeyDown"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnalysisRowViewModel">
                        <Border Padding="4,3"
                                Background="Transparent"
                                Margin="{Binding IsSweep, Converter={StaticResource IndentConv}}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                                <!-- Enabled checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          ToolTip.Tip="Enable / disable (disabled analyses are not run)"
                                          Margin="0,0,4,0"
                                          VerticalAlignment="Center"/>

                                <!-- Type badge -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SystemListLowColor}"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TypeLabel}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                                </Border>

                                <!-- Name + summary -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <!-- Footer hint (only when rows exist) -->
        <TextBlock Grid.Row="3"
                   Text="Analyses run in listed order."
                   IsVisible="{Binding !IsEmpty}"
                   Foreground="{DynamicResource SystemBaseMediumLowColor}"
                   FontSize="10"
                   Margin="6,2,6,4"/>
            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
