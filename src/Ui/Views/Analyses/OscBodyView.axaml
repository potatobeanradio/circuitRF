<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.Analyses.OscBodyView"
             x:DataType="vm:OscBodyViewModel">
    <!-- Brief NZ-9: the OscProbe, the start-up search, and the harmonic-balance keys an oscillator shares with HB. -->
    <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="OscProbe:" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" FontSize="12" HorizontalAlignment="Stretch"
                   ItemsSource="{Binding Probes}" SelectedItem="{Binding Probe}" PlaceholderText="the OscProbe on this bench"
                   ToolTip.Tip="Where the auxiliary generator goes: an OscProbe in series in the oscillator's loop, or across its resonator with Mode=shunt."/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fguess:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding Fguess}"
                   ToolTip.Tip="Where the start-up search is centred."/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Unit:" FontSize="12" VerticalAlignment="Center"/>
        <ComboBox  Grid.Row="1" Grid.Column="3" FontSize="12" HorizontalAlignment="Stretch"
                   ItemsSource="{x:Static vm:OscBodyViewModel.Units}" SelectedItem="{Binding Unit}"
                   ToolTip.Tip="Unit of Fguess, Fstart and Fstop."/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fstart:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" FontSize="12" Text="{Binding Fstart}" PlaceholderText="Fguess / 2"
                   ToolTip.Tip="Low end of the start-up search. Blank: half of Fguess."/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Fstop:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="3" FontSize="12" Text="{Binding Fstop}" PlaceholderText="1.5 x Fguess"
                   ToolTip.Tip="High end of the start-up search. Blank: 1.5 times Fguess."/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="MaxHarm:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="3" Grid.Column="1" FontSize="12" Text="{Binding MaxHarm}"
                   ToolTip.Tip="Highest harmonic of the oscillation, as HB's."/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="Oversample:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="3" Grid.Column="3" FontSize="12" Text="{Binding FftOverSample}"
                   ToolTip.Tip="Oversampling factor for the time-domain transform, as HB's FFTOverSample."/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Tol:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4" Grid.Column="1" FontSize="12" Text="{Binding Tol}"
                   ToolTip.Tip="Convergence tolerance of every harmonic-balance solve, in amperes, as HB's."/>
        <TextBlock Grid.Row="4" Grid.Column="2" Text="Aguess:" FontSize="12" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="4" Grid.Column="3" FontSize="12" Text="{Binding Aguess}" PlaceholderText="ramp from small"
                   ToolTip.Tip="The generator amplitude to start from: volts for a shunt OscProbe, amperes for a series one. Blank ramps it up until the negative resistance runs out."/>
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" FontSize="11" Foreground="{DynamicResource CrfWarningBrush}"
                   Text="{Binding Problem}" TextTrimming="CharacterEllipsis" MinHeight="15"/>
    </Grid>
</UserControl>
