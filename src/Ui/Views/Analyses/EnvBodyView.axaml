<!-- Envelope analysis body (type=env). The stimulus is the schematic's MOD_Source (shown read-only at the
     top); this card says how long, how accurately and how to split the work across cores. What a run records
     is the schematic's: every labeled net's voltage and every IProbe's power, shown read-only in the row the
     Probes field had, so nothing below it moves. Layout and type sizes follow the HB card. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.Analyses.EnvBodyView"
             x:DataType="vm:EnvBodyViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="6">
        <TextBlock Text="Stimulus" FontSize="11" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding StimulusSummary}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemBaseMediumColor}"/>

        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="lbl" Text="Stop time (s)"/>
            <TextBox Grid.Column="1" Text="{Binding Stop}" ToolTip.Tip="Simulated signal time. ACPR settles within ~0.1 dB from 0.5 ms of LTE/NR."/>
            <TextBlock Grid.Column="2" Classes="lbl" Text="Accuracy" Margin="12,0,8,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:EnvBodyViewModel.AccuracyOptions}" SelectedItem="{Binding Accuracy}" FontSize="11" HorizontalAlignment="Stretch"/>

            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding AccuracyDescription}" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>

            <TextBlock Grid.Row="5" Classes="lbl" Text="Envelope"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{x:Static vm:EnvBodyViewModel.EnvelopeOptions}" SelectedItem="{Binding Envelope}" FontSize="11" HorizontalAlignment="Stretch"
                      ToolTip.Tip="How widely spaced carriers are simulated: one envelope over all of them, or one fundamental per carrier group"/>
            <TextBlock Grid.Row="6" Grid.ColumnSpan="4" Text="{Binding EnvelopeDescription}" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"/>

            <TextBlock Grid.Row="2" Classes="lbl" Text="Harmonics"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxHarm}" ToolTip.Tip="Harmonics of the fundamental carried by every envelope step"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Classes="lbl" Text="Mix order" Margin="12,0,8,0"/>
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MaxMixOrder}"
                     ToolTip.Tip="Used when carriers are far apart and each gets its own fundamental. 7 converges IM5; at 5, IM5 sits on the truncation edge."/>

            <TextBlock Grid.Row="3" Classes="lbl" Text="Records"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding RecordsSummary}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SystemBaseMediumColor}" ToolTip.Tip="{Binding RecordsDetail}"/>

            <TextBlock Grid.Row="4" Classes="lbl" Text="Segments"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Segments}"
                     ToolTip.Tip="Parallel-in-time: auto = one per core, or one segment when the circuit remembers too long to warm up in parallel. Each segment starts early by the warm-up."/>
            <TextBlock Grid.Row="4" Grid.Column="2" Classes="lbl" Text="Warm-up (s)" Margin="12,0,8,0"/>
            <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding Warmup}" ToolTip.Tip="auto = 5 us, or five of the circuit's slowest time constants (traps, thermal, bias network) when Segments is auto"/>

            <CheckBox Grid.Row="7" Grid.ColumnSpan="4" FontSize="11" Content="Keep the envelopes (time cubes)" IsChecked="{Binding SaveWaveforms}"
                      ToolTip.Tip="Off keeps every spectrum, power, AM-AM and pulse number; only the V and I envelopes and the instantaneous power go"/>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="4" Text="Noise" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <CheckBox Grid.Row="9" Grid.ColumnSpan="2" FontSize="11" Content="Thermal noise" IsChecked="{Binding Noise}"
                      ToolTip.Tip="Passive parts at their own temperature, S-parameter blocks with noise data and amplifiers with NF add seeded noise; the PSD shows the floor and ACLR includes it. Devices run noiseless."/>
            <TextBlock Grid.Row="9" Grid.Column="2" Classes="lbl" Text="Seed" Margin="12,0,8,0"/>
            <TextBox Grid.Row="9" Grid.Column="3" Text="{Binding Seed}"
                     ToolTip.Tip="Seeds the thermal noise and every source's PhaseNoise mask. The same seed gives the same noise on every run."/>
            <CheckBox Grid.Row="10" Grid.ColumnSpan="4" FontSize="11" Content="New seed at each sweep point" IsChecked="{Binding SeedPerPoint}"
                      ToolTip.Tip="Off: every point of a parametric sweep draws the same noise, so the differences between points are the circuit's"/>
            <CheckBox Grid.Row="11" Grid.ColumnSpan="4" FontSize="11" Content="Split EVM into distortion and noise" IsChecked="{Binding EvmSplit}"
                      ToolTip.Tip="Runs the record a second time with the noise and every phase-noise mask off: EVM splits into distortion and noise, and the in-channel SNR is measured. Twice the run time."/>
        </Grid>
    </StackPanel>
</UserControl>
