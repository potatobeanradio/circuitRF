<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Views.Analyses.HbBodyView"
             x:DataType="vm:HbBodyViewModel">

    <UserControl.Styles>
        <Style Selector="Button.hb-btn">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource SystemBaseMediumLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"   Value="3"/>
            <Setter Property="Padding"        Value="8,2"/>
            <Setter Property="MinWidth"       Value="0"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="Margin"         Value="0,0,2,0"/>
        </Style>
        <Style Selector="Button.hb-btn.active">
            <Setter Property="Background"  Value="{DynamicResource SystemBaseHighColor}"/>
            <Setter Property="Foreground"  Value="{DynamicResource SystemRegionColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseHighColor}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <!-- Unit combo: compact. No Padding override — let the Fluent template handle it. -->
        <Style Selector="ComboBox.unit-combo">
            <Setter Property="MinWidth"  Value="60"/>
            <Setter Property="MaxWidth"  Value="68"/>
            <Setter Property="FontSize"  Value="9"/>
            <Setter Property="Margin"    Value="3,0,0,0"/>
        </Style>
    </UserControl.Styles>

    <!-- ScrollViewer keeps the dialog within MaxHeight when Advanced is expanded -->
    <ScrollViewer MaxHeight="380"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Spacing="10" Margin="0,0,4,0">

            <!-- ── Basic: Tone + Max harmonics ─────────────────────────────── -->
            <!-- Max harmonics is a small integer — give it a fixed narrow column -->
            <Grid ColumnDefinitions="*,76" ColumnSpacing="10">

                <!-- Single-tone f₀ with unit combo. In multi-tone mode the tone LIST below owns
                     every tone including the first, so this collapses rather than duplicating it. -->
                <StackPanel Spacing="2" IsVisible="{Binding IsSingleTone}">
                    <TextBlock Text="{Binding ToneLabel}"
                               FontSize="10" Opacity="0.6"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding ToneCoeff, Mode=TwoWay}"
                                 FontSize="11"/>
                        <ComboBox Grid.Column="1"
                                  Classes="unit-combo"
                                  ItemsSource="{x:Static vm:HbBodyViewModel.FreqUnits}"
                                  SelectedItem="{Binding ToneUnit, Mode=TwoWay}"/>
                    </Grid>
                    <TextBlock Text="{Binding TonePreview}"
                               FontSize="10" Opacity="0.55"/>
                </StackPanel>

                <!-- Max harmonics -->
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Max harmonics"
                               FontSize="10" Opacity="0.6"/>
                    <TextBox Text="{Binding MaxHarmonicExpr, Mode=TwoWay}"
                             FontSize="11"/>
                    <TextBlock Text="{Binding MaxHarmonicPreview}"
                               FontSize="10" Opacity="0.55"/>
                </StackPanel>

            </Grid>

            <!-- ── Single / Multi-tone toggle ─────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Tones:"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.75"/>
                <Button Content="Single"
                        Classes="hb-btn"
                        Classes.active="{Binding IsSingleTone}"
                        Command="{Binding SetSingleToneCommand}"/>
                <Button Content="Multi"
                        Classes="hb-btn"
                        Classes.active="{Binding IsMultiTone}"
                        Command="{Binding SetMultiToneCommand}"/>
            </StackPanel>

            <!-- ── Multi-tone: the tone LIST + mix order (appear when Multi is active) ───── -->
            <StackPanel IsVisible="{Binding IsMultiTone}" Spacing="8">

                <!-- Tone list header: count + Add (disabled at the engine's maximum) -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ToneCountSummary}"
                               FontSize="10" Opacity="0.6"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="+ Tone"
                            Command="{Binding AddToneCommand}"
                            FontSize="11"
                            Padding="8,3"
                            HorizontalContentAlignment="Center"/>
                </Grid>

                <!-- One row per tone. Row 1 lives here too, so every tone is edited the same way. -->
                <ScrollViewer MaxHeight="220"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HbToneRowViewModel">
                                <Border Padding="8,6"
                                        Background="{DynamicResource SystemChromeLowColor}"
                                        CornerRadius="4"
                                        Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="*,24">
                                        <StackPanel Spacing="2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Caption}"
                                                       FontSize="10" Opacity="0.6"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Text="{Binding Coeff, Mode=TwoWay}"
                                                         FontSize="11"/>
                                                <ComboBox Grid.Column="1"
                                                          Classes="unit-combo"
                                                          ItemsSource="{x:Static vm:HbToneRowViewModel.FreqUnits}"
                                                          SelectedItem="{Binding Unit, Mode=TwoWay}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Preview}"
                                                       FontSize="10" Opacity="0.55"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Command="{Binding RemoveCommand}"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Remove this tone"
                                                Padding="3,3"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="13"
                                                Content="×"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Max mix order, with the retained-product count it implies. The engine refuses
                     an analysis over that limit, so the number belongs beside the knob that sets
                     it rather than in an error at Run. -->
                <Grid ColumnDefinitions="*,76" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding MixProductPreview}"
                                   FontSize="10" Opacity="0.6"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Max mix order"
                                   FontSize="10" Opacity="0.6"/>
                        <TextBox Text="{Binding MaxMixOrderExpr, Mode=TwoWay}"
                                 FontSize="11"/>
                        <TextBlock Text="{Binding MaxMixOrderPreview}"
                                   FontSize="10" Opacity="0.55"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── Separator before Small-signal ──────────────────────────── -->
            <Separator Opacity="0.3"/>

            <!-- ── Small-signal (the WSProbe tickle sweep, brief-wsprobe-5 R-wsp5-1, and the frequencies HB noise is
                 read at, brief NZ-5 — so the group is named for neither) ──
                 Empty start/stop = no small-signal solve at all, which is why nothing here is
                 pre-filled; the live point count says which of the two states the analysis is in. -->
            <Expander Header="Small-signal"
                      IsExpanded="{Binding SmallSignalExpanded, Mode=TwoWay}"
                      FontSize="11">

                <StackPanel Spacing="8" Margin="0,8,0,0">

                    <!-- Row 1: Start + Stop + unit -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Freq. start"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding SsStartExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Stop"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding SsStopExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Unit" FontSize="10" Opacity="0.6"/>
                            <ComboBox Classes="unit-combo"
                                      ItemsSource="{x:Static vm:HbBodyViewModel.FreqUnits}"
                                      SelectedItem="{Binding SsUnit, Mode=TwoWay}"
                                      FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Step OR points, log, sideband order -->
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Step" FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding SsStepExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Points (wins over Step)"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding SsNptsExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                            <CheckBox IsChecked="{Binding SsLog, Mode=TwoWay}"
                                      Content="Log" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SmallSignalPreview}"
                               FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>

                    <!-- Row 3: sideband order + margin threshold -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Sideband order (default = Max harmonics)"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding SsMaxHarmExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="WSProbe margin threshold, dB (or none)"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding MarginThresholdExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Noise on the same conversion matrix (brief NZ-5): read at these frequencies, which are the
                         OUTPUT frequencies. Always laid out, enabled by the box, so nothing shifts when it is ticked. -->
                    <CheckBox IsChecked="{Binding Noise, Mode=TwoWay}"
                              Content="Noise (NF, Gc, Te, Nout at these frequencies, the output ones)" FontSize="11"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsEnabled="{Binding Noise}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Input port" FontSize="10" Opacity="0.6"/>
                            <ComboBox ItemsSource="{Binding PortChoices}"
                                      SelectedItem="{Binding NoiseInExpr, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Output port" FontSize="10" Opacity="0.6"/>
                            <ComboBox ItemsSource="{Binding PortChoices}"
                                      SelectedItem="{Binding NoiseOutExpr, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Signal sideband k" FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding NoiseSidebandExpr, Mode=TwoWay}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding NoiseSidebandPreview}" IsEnabled="{Binding Noise}"
                               FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
                    <CheckBox IsChecked="{Binding NoiseContrib, Mode=TwoWay}" IsEnabled="{Binding Noise}"
                              Content="Each part's share (NFc, NFpct)" FontSize="11"/>

                </StackPanel>
            </Expander>

            <!-- ── Separator before Advanced ──────────────────────────────── -->
            <Separator Opacity="0.3"/>

            <!-- ── Advanced expander (collapsed by default) ─────────────────── -->
            <Expander Header="Advanced"
                      IsExpanded="{Binding AdvancedExpanded, Mode=TwoWay}"
                      FontSize="11">

                <StackPanel Spacing="8" Margin="0,8,0,0">

                    <!-- Row 1: FFT oversample + Tolerance -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="FFT oversample"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding FftOverSampleExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Tolerance"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding TolExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                            <TextBlock Text="{Binding TolPreview}"
                                       FontSize="10" Opacity="0.55"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Drive stepping + Guard harmonic -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Drive stepping"
                                       FontSize="10" Opacity="0.6"/>
                            <ComboBox ItemsSource="{x:Static vm:HbBodyViewModel.DriveSteppingOptions}"
                                      SelectedItem="{Binding DriveSteppingExpr, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Guard harmonic"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding GuardHarmonicExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                            <TextBlock Text="{Binding GuardHarmonicPreview}"
                                       FontSize="10" Opacity="0.55"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Newton λ + Max iterations -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Newton step λ"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding LambdaExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                            <TextBlock Text="{Binding LambdaPreview}"
                                       FontSize="10" Opacity="0.55"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Max iterations"
                                       FontSize="10" Opacity="0.6"/>
                            <TextBox Text="{Binding MaxIterExpr, Mode=TwoWay}"
                                     FontSize="11"/>
                            <TextBlock Text="{Binding MaxIterPreview}"
                                       FontSize="10" Opacity="0.55"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>

</UserControl>
