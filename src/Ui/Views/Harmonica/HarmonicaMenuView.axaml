<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:CircuitRF.Ui.Harmonica"
             x:Class="CircuitRF.Ui.Views.Harmonica.HarmonicaMenuView"
             x:DataType="vm:HarmonicaMenuViewModel"
             x:CompileBindings="True">

  <!--
    harmonicarf.md §7.6 / R-h7-1 — harmonicaRF's OWN menu set.

    **There is no Simulate menu, and there is not going to be one.** harmonicaRF is always
    simulating, so a menu offering to start it would describe a different tool. A test asserts its
    absence on both surfaces.

    **TWO SURFACES, HAND-MIRRORED**, exactly as WorkspaceWindow.axaml maintains circuitRF's own bar:
      (1) the macOS NativeMenu, attached below via NativeMenu.Menu on this control — which is what
          gives its bindings a DataContext to resolve against. The code-behind hands it to the
          hosting Window when harmonicaRF is in a window of its own (a torn-off document, or the
          standalone binary of §3.1); a docked tab must not replace circuitRF's app menu bar.
      (2) the in-window Menu, which is this control's content and is ALWAYS shown. Unlike the File
          menu, harmonicaRF's Markers / Display / Grid menus have no equivalent anywhere in
          circuitRF's bar — there is nowhere else for them to live, so the document carries its own.

    Anything added here must go on BOTH, or it exists on one platform only.
  -->

  <NativeMenu.Menu>
    <NativeMenu>

      <NativeMenuItem Header="File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="New"          Command="{Binding NewDocumentCommand}"/>
            <NativeMenuItem Header="Open .charm…" Command="{Binding OpenDocumentCommand}"/>
            <NativeMenuItem Header="Save"         Command="{Binding SaveDocumentCommand}"/>
            <NativeMenuItem Header="Save As…"     Command="{Binding SaveDocumentAsCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Set DUT…"     Command="{Binding SetDutCommand}"/>
            <NativeMenuItem Header="Refresh DUT"  Command="{Binding RefreshDutCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Import .gam…" Command="{Binding ImportGamCommand}"/>
            <NativeMenuItem Header="Export .gam…" Command="{Binding ExportGamCommand}"/>
            <NativeMenuItem Header="Export Data…" Command="{Binding ExportDataCommand}"/>
            <NativeMenuItem Header="Export Testbench…" Command="{Binding ExportTestbenchCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Close"        Command="{Binding CloseDocumentCommand}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <NativeMenuItem Header="Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Undo" Command="{Binding UndoCommand}" Gesture="Meta+Z"/>
            <NativeMenuItem Header="Redo" Command="{Binding RedoCommand}" Gesture="Meta+Shift+Z"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Copy Plot"            Command="{Binding CopyPlotCommand}"/>
            <NativeMenuItem Header="Copy Readouts"        Command="{Binding CopyReadoutsCommand}"/>
            <NativeMenuItem Header="Copy Termination Set" Command="{Binding CopyTerminationsCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…"            Command="{Binding SettingsCommand}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <!-- R-h7-2 — the first thing in harmonicaRF that can CREATE a marker. Each band toggles the
           marker AND its TerminationSet entry through one call; band 1 refuses removal. -->
      <NativeMenuItem Header="Markers">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!-- Populated in code-behind (RebuildNativeBandMenus) from the SAME SourceBands /
                 LoadBands collections the in-window menu binds to, so the two surfaces cannot
                 disagree about which bands are marked. NativeMenu has no ItemsSource — the Window
                 menu in WorkspaceWindow.axaml is built the same way for the same reason. -->
            <NativeMenuItem Header="Source Bands">
              <NativeMenuItem.Menu><NativeMenu/></NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Load Bands">
              <NativeMenuItem.Menu><NativeMenu/></NativeMenuItem.Menu>
            </NativeMenuItem>
            <!-- R9D §3.6 — writes ONLY the Load-side markers that already exist; never creates one. -->
            <NativeMenuItem Header="Preset Terminations">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Class B"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="B"        Gesture="Meta+B"/>
                  <NativeMenuItem Header="Class J"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="J"        Gesture="Meta+J"/>
                  <NativeMenuItem Header="Class J*"  Command="{Binding SetPaClassPresetCommand}" CommandParameter="JStar"    Gesture="Meta+Shift+J"/>
                  <NativeMenuItem Header="Class F"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="F"        Gesture="Meta+F"/>
                  <NativeMenuItem Header="Class F⁻¹" Command="{Binding SetPaClassPresetCommand}" CommandParameter="FInverse" Gesture="Meta+Shift+F"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Reset to Defaults" Command="{Binding ResetMarkersCommand}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <NativeMenuItem Header="Display">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!-- brief-harmonicarf-r6a §4 — Edit Display / Add Trace… / Remove All Traces and their
                 separator are removed from BOTH menu surfaces (this one and the MenuItem block below):
                 editing the display is deferred to a harmonicaRF v2. Every line of code behind them —
                 ToggleEditDisplayCommand, AddTraceCommand, RemoveAllTracesCommand, HarmonicaEditDisplay,
                 HarmonicaTracePicker, HarmonicaTracePickerDialog, the PickedTraces plumbing and all
                 their tests — stays in place; re-adding these three lines (and their MenuItem
                 counterparts below) is the whole of turning it back on. Follows the same precedent the
                 R5 Diagnostics Overlay removal below already set. -->
            <NativeMenuItem Header="Contour Plane">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Load"   Command="{Binding SetGridSideCommand}" CommandParameter="Load"/>
                  <NativeMenuItem Header="Source" Command="{Binding SetGridSideCommand}" CommandParameter="Source"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <!-- Populated in code-behind (RebuildNativeBandMenus), from ContourHarmonics — NativeMenu
                 has no ItemsSource, same reason Source/Load Bands are built there too (see that
                 comment above). Owner-reported: this used to be three hardcoded items and never
                 tracked K. -->
            <NativeMenuItem Header="Contour Harmonic">
              <NativeMenuItem.Menu><NativeMenu/></NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Efficiency Metric">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="Drain Efficiency"  Command="{Binding SetEfficiencyMetricCommand}" CommandParameter="DE"/>
                  <NativeMenuItem Header="PAE" Command="{Binding SetEfficiencyMetricCommand}" CommandParameter="PAE"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Loadline Plane" Command="{Binding ToggleLoadlinePlaneCommand}"/>
            <NativeMenuItem Header="Contour Levels">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="5"  Command="{Binding SetContourLevelsCommand}" CommandParameter="5"/>
                  <NativeMenuItem Header="10" Command="{Binding SetContourLevelsCommand}" CommandParameter="10"/>
                  <NativeMenuItem Header="20" Command="{Binding SetContourLevelsCommand}" CommandParameter="20"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Iso-line Labels" Command="{Binding ToggleIsoLineLabelsCommand}"/>
            <!-- Round 11 §4 — ⌘L here, Ctrl+L as a KeyBinding on HarmonicaView; see
                 HarmonicaAppMenuInjector's matching note for why the two modifiers live on two
                 different surfaces rather than both on each. -->
            <NativeMenuItem Header="Grid Points" Command="{Binding ToggleShowGridPointsCommand}"
                            Gesture="Cmd+L"/>
            <!-- brief-harmonicarf-r6a §4 — owner request: the "Cursor Snap to Compression" menu item
                 is removed (this menu-only; ToggleCursorSnapCommand and
                 HarmonicaViewModel.SnapCursorToCompression stay wired, default true, behaviour on). -->
            <!-- brief-harmonicarf-r5 §1 — owner request 2026-08-13: the Diagnostics Overlay menu items
                 are removed from BOTH menu surfaces (this one and the MenuItem block below), but the
                 commands (ToggleDiagnosticsOverlayCommand/ResetDiagnosticsOverlayCommand), the VM state
                 (HarmonicaViewModel.ShowDiagnosticsOverlay/Diagnostics), the overlay/renderer classes
                 and the .charm persistence are all left in place — re-adding these two lines (and their
                 MenuItem counterparts below) is the whole of turning it back on. -->
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Power Sweep…"       Command="{Binding PowerSweepCommand}"/>
            <NativeMenuItem Header="Set Z0…"            Command="{Binding SetZ0Command}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <NativeMenuItem Header="Grid">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Solve Now"    Command="{Binding SolveNowCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Grid Preset">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="3 × 12" Command="{Binding SetGridPresetCommand}" CommandParameter="3×12"/>
                  <NativeMenuItem Header="5 × 12" Command="{Binding SetGridPresetCommand}" CommandParameter="5×12"/>
                  <NativeMenuItem Header="7 × 16" Command="{Binding SetGridPresetCommand}" CommandParameter="7×16"/>
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Reset Grid"   Command="{Binding ResetGridCommand}"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Import .gam…" Command="{Binding ImportGamCommand}"/>
            <NativeMenuItem Header="Export .gam…" Command="{Binding ExportGamCommand}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

      <NativeMenuItem Header="Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="harmonicaRF Documentation" Command="{Binding HelpCommand}"/>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>

    </NativeMenu>
  </NativeMenu.Menu>

  <!-- ── Surface 2: the in-window Menu, hand-mirrored with the NativeMenu above ──
       Hidden on macOS, where the native bar above already carries it — the same
       IsVisible="{OnPlatform True, macOS=False}" rule WorkspaceWindow's own in-window Menu uses
       (R-h9a-2: on macOS the in-window Menu must never render at all — it was IsVisible="False" only
       by accident of nothing setting it, not by design). -->
  <Menu x:Name="InWindowMenu" IsVisible="{OnPlatform True, macOS=False}">

    <MenuItem Header="_File" Padding="8,4">
      <MenuItem Header="_New"           Command="{Binding NewDocumentCommand}"/>
      <MenuItem Header="_Open .charm…"  Command="{Binding OpenDocumentCommand}"/>
      <MenuItem Header="_Save"          Command="{Binding SaveDocumentCommand}" InputGesture="Ctrl+S"/>
      <MenuItem Header="Save _As…"      Command="{Binding SaveDocumentAsCommand}"/>
      <Separator/>
      <MenuItem Header="Set _DUT…"      Command="{Binding SetDutCommand}"
                ToolTip.Tip="Choose the device under test — an SDD, a built-in FET law, or an external model."/>
      <MenuItem Header="_Refresh DUT"   Command="{Binding RefreshDutCommand}"
                ToolTip.Tip="Re-elaborate the same DUT — for a kit or a .osdi that changed on disk since Set DUT. Elaboration happens only on Set and here, never on a value change or a frame."/>
      <Separator/>
      <MenuItem Header="_Import .gam…"  Command="{Binding ImportGamCommand}"
                ToolTip.Tip="Read a Γ grid from a .gam file. An imported grid is an arbitrary scatter, not a ring set."/>
      <MenuItem Header="_Export .gam…"  Command="{Binding ExportGamCommand}"
                ToolTip.Tip="Write the current Γ grid, holes included."/>
      <MenuItem Header="Export Da_ta…"  Command="{Binding ExportDataCommand}"/>
      <MenuItem Header="Export Test_bench…" Command="{Binding ExportTestbenchCommand}"
                ToolTip.Tip="Write a runnable .cnl reproducing this operating point, so the reference engine can check it."/>
      <Separator/>
      <MenuItem Header="_Close"         Command="{Binding CloseDocumentCommand}"/>
    </MenuItem>

    <MenuItem Header="_Edit" Padding="8,4">
      <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"/>
      <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Shift+Z"/>
      <Separator/>
      <MenuItem Header="Copy _Plot"     Command="{Binding CopyPlotCommand}"/>
      <MenuItem Header="Copy _Readouts" Command="{Binding CopyReadoutsCommand}"/>
      <MenuItem Header="Copy _Termination Set" Command="{Binding CopyTerminationsCommand}"
                ToolTip.Tip="A Tuner pair ready to paste into a schematic."/>
      <Separator/>
      <MenuItem Header="_Settings…"      Command="{Binding SettingsCommand}"/>
    </MenuItem>

    <MenuItem Header="_Markers" Padding="8,4">
      <MenuItem Header="_Source Bands" ItemsSource="{Binding SourceBands}">
        <MenuItem.Styles>
          <Style Selector="MenuItem" x:DataType="vm:HarmonicaBandMenuItem">
            <Setter Property="Header"      Value="{Binding Header}"/>
            <Setter Property="ToggleType"  Value="CheckBox"/>
            <Setter Property="IsChecked"   Value="{Binding IsPresent, Mode=TwoWay}"/>
            <Setter Property="IsEnabled"   Value="{Binding CanRemove}"/>
            <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}"/>
          </Style>
        </MenuItem.Styles>
      </MenuItem>
      <MenuItem Header="_Load Bands" ItemsSource="{Binding LoadBands}">
        <MenuItem.Styles>
          <Style Selector="MenuItem" x:DataType="vm:HarmonicaBandMenuItem">
            <Setter Property="Header"      Value="{Binding Header}"/>
            <Setter Property="ToggleType"  Value="CheckBox"/>
            <Setter Property="IsChecked"   Value="{Binding IsPresent, Mode=TwoWay}"/>
            <Setter Property="IsEnabled"   Value="{Binding CanRemove}"/>
            <Setter Property="ToolTip.Tip" Value="{Binding Tooltip}"/>
          </Style>
        </MenuItem.Styles>
      </MenuItem>
      <!-- R9D §3.6 — writes ONLY the Load-side markers that already exist; never creates one. -->
      <MenuItem Header="_Preset Terminations">
        <MenuItem Header="Class _B"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="B"        InputGesture="Ctrl+B"/>
        <MenuItem Header="Class _J"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="J"        InputGesture="Ctrl+J"/>
        <MenuItem Header="Class J_*"  Command="{Binding SetPaClassPresetCommand}" CommandParameter="JStar"    InputGesture="Ctrl+Shift+J"/>
        <MenuItem Header="Class _F"   Command="{Binding SetPaClassPresetCommand}" CommandParameter="F"        InputGesture="Ctrl+F"/>
        <MenuItem Header="Class F⁻¹"  Command="{Binding SetPaClassPresetCommand}" CommandParameter="FInverse" InputGesture="Ctrl+Shift+F"/>
      </MenuItem>
      <Separator/>
      <MenuItem Header="_Reset to Defaults" Command="{Binding ResetMarkersCommand}"/>
    </MenuItem>

    <MenuItem Header="_Display" Padding="8,4">
      <!-- brief-harmonicarf-r6a §4 — Edit Display / Add Trace… / Remove All Traces and their separator
           are removed from BOTH menu surfaces (this one and the NativeMenu block above): editing the
           display is deferred to a harmonicaRF v2. Every line of code behind them —
           ToggleEditDisplayCommand, AddTraceCommand, RemoveAllTracesCommand, HarmonicaEditDisplay,
           HarmonicaTracePicker, HarmonicaTracePickerDialog, the PickedTraces plumbing and all their
           tests — stays in place; re-adding these three MenuItems (and their NativeMenuItem
           counterparts above) is the whole of turning it back on. Follows the same precedent the R5
           Diagnostics Overlay removal below already set. HarmonicaEditTarget (the right-click panel
           resolver) is used by live features — Copy Plot and the panel context menus — so it is NOT
           part of this deferral. -->
      <MenuItem Header="Contour _Plane">
        <MenuItem Header="_Load"   Command="{Binding SetGridSideCommand}" CommandParameter="Load"/>
        <MenuItem Header="_Source" Command="{Binding SetGridSideCommand}" CommandParameter="Source"/>
      </MenuItem>
      <!-- Owner-reported: this used to be three hardcoded items (f₀/2f₀/3f₀), so K > 3 had no way to
           reach its own bands. ContourHarmonics is rebuilt to K's own length by
           HarmonicaMenuViewModel.RebuildBandMenus, the SAME trigger the band checkboxes above use. -->
      <MenuItem Header="Contour _Harmonic" ItemsSource="{Binding ContourHarmonics}">
        <MenuItem.Styles>
          <Style Selector="MenuItem" x:DataType="vm:HarmonicaHarmonicMenuItem">
            <Setter Property="Header"  Value="{Binding Header}"/>
            <Setter Property="Command" Value="{Binding SelectCommand}"/>
          </Style>
        </MenuItem.Styles>
      </MenuItem>
      <MenuItem Header="E_fficiency Metric">
        <MenuItem Header="_Drain Efficiency"  Command="{Binding SetEfficiencyMetricCommand}" CommandParameter="DE"/>
        <MenuItem Header="_PAE" Command="{Binding SetEfficiencyMetricCommand}" CommandParameter="PAE"/>
      </MenuItem>
      <MenuItem Header="Loadline P_lane" Command="{Binding ToggleLoadlinePlaneCommand}"
                ToolTip.Tip="One toggle: the DCIV family and the loadline move together."/>
      <MenuItem Header="Contour Le_vels">
        <MenuItem Header="5"  Command="{Binding SetContourLevelsCommand}" CommandParameter="5"/>
        <MenuItem Header="10" Command="{Binding SetContourLevelsCommand}" CommandParameter="10"/>
        <MenuItem Header="20" Command="{Binding SetContourLevelsCommand}" CommandParameter="20"/>
      </MenuItem>
      <MenuItem Header="_Iso-line Labels" Command="{Binding ToggleIsoLineLabelsCommand}"
                ToolTip.Tip="Off by default — a dense unfilled contour set reads better without them, and labelling is the most expensive part of the extract."/>
      <!-- Round 11 §4 — InputGesture is DISPLAY ONLY in Avalonia (HotKey is the functional one), which
           is exactly what is wanted: the keystroke itself is HarmonicaView's own KeyBinding, so this
           label cannot become a second handler for it. -->
      <MenuItem Header="_Grid Points" Command="{Binding ToggleShowGridPointsCommand}"
                InputGesture="Ctrl+L"
                ToolTip.Tip="The Γ grid sample dots. Off by default; draggable once shown. Ctrl/⌘+L toggles them."/>
      <!-- brief-harmonicarf-r6a §4 — owner request: the "Cursor Snap to Compression" menu item is
           removed (this menu-only; ToggleCursorSnapCommand and
           HarmonicaViewModel.SnapCursorToCompression stay wired, default true, behaviour on). -->
      <!-- brief-harmonicarf-r5 §1 — see the matching NativeMenu comment above: the Diagnostics
           Overlay items are deliberately removed from the menu (owner request, 2026-08-13), while
           ToggleDiagnosticsOverlayCommand/ResetDiagnosticsOverlayCommand and everything they drive
           stay wired and working underneath. -->
      <Separator/>
      <MenuItem Header="_Power Sweep…" Command="{Binding PowerSweepCommand}"
                ToolTip.Tip="The explicit Pin Start/Stop/Step ladder, the tickle, and the exact-compression-solve option.">
        <MenuItem.Icon><mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/></MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Set _Z0…" Command="{Binding SetZ0Command}"
                ToolTip.Tip="The Smith-chart reference impedance. Also settable from the readout strip's own Z0 field."/>
    </MenuItem>

    <MenuItem Header="_Grid" Padding="8,4">
      <MenuItem Header="_Solve Now" Command="{Binding SolveNowCommand}"
                ToolTip.Tip="Re-solve at the full grid. harmonicaRF solves continuously; this forces a full-quality refresh.">
        <MenuItem.Icon><mi:MaterialIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
      </MenuItem>
      <Separator/>
      <MenuItem Header="Grid _Preset">
        <MenuItem Header="3 × 12" Command="{Binding SetGridPresetCommand}" CommandParameter="3×12"/>
        <MenuItem Header="5 × 12" Command="{Binding SetGridPresetCommand}" CommandParameter="5×12"/>
        <MenuItem Header="7 × 16" Command="{Binding SetGridPresetCommand}" CommandParameter="7×16"/>
      </MenuItem>
      <MenuItem Header="_Reset Grid"   Command="{Binding ResetGridCommand}"/>
      <Separator/>
      <MenuItem Header="_Import .gam…" Command="{Binding ImportGamCommand}"/>
      <MenuItem Header="_Export .gam…" Command="{Binding ExportGamCommand}"/>
    </MenuItem>

    <MenuItem Header="_Help" Padding="8,4">
      <MenuItem Header="harmonicaRF _Documentation" Command="{Binding HelpCommand}"/>
    </MenuItem>

  </Menu>
</UserControl>
