<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="CircuitRF.Ui.Views.Harmonica.ReadoutStripView">

  <!--
    §7.5 — the dense settings / readout strip.

    "Deliberately dense: small fonts, no section titles, no decoration — the data is self-explanatory
    to the intended user, and every element carries a tooltip for newcomers. All text is SELECTABLE
    so any readout can be copied."

    All three of those are load-bearing and each is easy to lose:
      • NO section titles and NO decoration — a WrapPanel of label/value pairs, nothing more.
      • Every pair carries a ToolTip, set per item in code-behind from the frame's own tooltip text.
      • SelectableTextBlock, not TextBlock — for every row EXCEPT an editable one (R-h9r2-15). A
        readout you cannot copy is a readout you retype by hand into a report, with the transcription
        errors that implies — but SelectableTextBlock consumes double-tap as select-a-word before it
        ever reaches a parent's DoubleTapped handler, so an editable row (R-h9c-8's inline editor)
        would never engage if it stayed selectable. An editable row's text is reachable for selection
        one double-click away, inside the editor itself.
  -->

  <!--
    R-h9r2-15/16 — CircuitRF.Ui.Tests.Harmonica.HarmonicaInlineEditSelectabilityTests pins both halves
    of this: editable rows are plain TextBlock (so the inline editor's double-tap actually engages)
    while every other row stays SelectableTextBlock; the editor itself seeds with the value AND its
    unit and pre-selects only the value.

    Colours come from Harmonica.ReadoutText — §7.9.2 is explicit that this role covers ALL text in
    the strip — so the strip cannot drift away from the panels' own palette.
  -->

  <!--
    H7 adds the strip's INPUT half (§7.5). It is the same WrapPanel discipline — one row of dense
    label/editor pairs, no titles, every element tooltipped — sitting above the readouts, with a hair
    rule between so the two halves read as input and output rather than as one undifferentiated list.
  -->

  <!--
    §5 (R1C) — "the owner is asking for COLUMNS". General stays a dense wrapping run (the original
    §7.5 shape); Source · Load · MXP · MXE (R-h9c-6) are four vertical columns beside it, left to
    right in that order — the editable termination columns nearest the charts they belong to, the
    read-only performance summaries beside them.

    R3C §1/§2 add two more columns, at the FRONT of Columns: SettingsColumn (the seven named §7.5
    inputs — Vgs, Idq, Vds, f0, K, compr, Z0 — as inline-editable text, R3C §1) and
    OperatingPointColumn (Pin/Pout/Gain/DE/PAE/Pdc at the operating point, R3C §2). Final left-to-right
    order: Settings · Operating point · Source · Load · MXP · MXE. SettingsColumn hugs the left edge
    of the window (this root Panel's own Margin, shared by everything in it) exactly as the owner
    asked. HarmonicaR3cStripTests.ColumnsPanel_ListsTheSixColumns_InTheOwnersOrder pins this ordering
    by scanning THIS file's own x:Name order, since nothing here is unit-testable through a live
    control tree.
  -->
  <!--
    R3C follow-up — EditorOverlay is a transparent Canvas layered ON TOP of the content StackPanel,
    both children of the same Panel so they share one coordinate space. An inline editor used to be
    spliced INTO a row's own StackPanel, which meant its own MinWidth widened that row's — and
    therefore its whole COLUMN's (a StackPanel sizes to its widest row) — layout, visibly shoving
    every column to its right sideways the instant an edit opened. The floated box renders in
    EditorOverlay instead (ReadoutStripView.axaml.cs's BeginInlineEdit), positioned over the hidden
    (Opacity 0, so its layout slot stays reserved) original value control — so no column ever moves,
    and the editor genuinely renders over everything, per the owner's own words. Background is left
    UNSET (not even Transparent) so the overlay's own empty space passes clicks through to whatever
    is under it; only an actual open editor's TextBox is ever hit-testable.
  -->
  <Panel Margin="6,4">
      <StackPanel Orientation="Vertical" Spacing="3">
        <WrapPanel x:Name="Inputs" Orientation="Horizontal"/>
        <TextBlock x:Name="InputError" FontSize="10" IsVisible="False" TextWrapping="Wrap"/>
        <WrapPanel x:Name="Items"  Orientation="Horizontal"/>
        <!-- R9A §3 — the two horizontal rule Border separators were removed here; the owner asked
             for the LINES to go, not the Spacing="3" gap between chunks. -->
        <!--
          R-hui-1 — the owner's revised 2 x 4 chunk grid, (row, column):
            row 1:  A Settings (spans both rows) · B Operating point · E MXP            · F MXE
            row 2:  [Settings continues]         · C Terminations   · G Intrinsic VDS · H Intrinsic IDS
          Settings (Vgs, Idq, Vds, etc.) now occupies BOTH (1,1) and (2,1) — extending down instead of
          sitting in one row — so it has room to grow (future settings like capacitance) without
          stretching row 1 taller than the other three chunks there need. Source and Load are merged
          into ONE chunk (Terminations) at (2,2), freeing the column-1/row-2 slot Settings now spans
          into. Re-parenting only: every surviving x:Name from the old grid keeps
          UpdateReadoutColumn's build-once/update-in-place machinery working unchanged.
        -->
        <Grid x:Name="Columns" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="6" ColumnSpacing="16">
          <StackPanel x:Name="SettingsColumn"       Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="OperatingPointColumn" Grid.Row="0" Grid.Column="1" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="MxpColumn"             Grid.Row="0" Grid.Column="2" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="MxeColumn"             Grid.Row="0" Grid.Column="3" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="TerminationsColumn"    Grid.Row="1" Grid.Column="1" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="IntrinsicVdsColumn"    Grid.Row="1" Grid.Column="2" Orientation="Vertical" Spacing="1"/>
          <StackPanel x:Name="IntrinsicIdsColumn"    Grid.Row="1" Grid.Column="3" Orientation="Vertical" Spacing="1"/>
        </Grid>
      </StackPanel>
      <Canvas x:Name="EditorOverlay"/>
  </Panel>
</UserControl>
