<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ctrl="clr-namespace:CircuitRF.Ui.Controls"
             xmlns:hv="clr-namespace:CircuitRF.Ui.Views.Harmonica"
             xmlns:vm="clr-namespace:CircuitRF.Ui.Harmonica"
             mc:Ignorable="d"
             x:DataType="vm:HarmonicaDocument"
             x:CompileBindings="True"
             x:Class="CircuitRF.Ui.Views.Harmonica.HarmonicaView">

  <!--
    §7.1's LOCKED layout. The four plot panels are drawn by ONE Skia canvas from the document's own
    CharmLayout (R-h45-1 — the layout is data, not code), so H7's Edit Display has something to
    unlock rather than something to rewrite. The readout strip is the one panel that is NOT Skia:
    §7.5 requires every element tooltipped and ALL TEXT SELECTABLE, which is a job for real controls.

    The strip is therefore positioned by the SAME CharmLayout placement the canvas uses, applied in
    code-behind — one layout source, two consumers.
  -->

  <DockPanel>

    <!-- ── §7.6 — harmonicaRF's OWN menu set, on both hand-mirrored surfaces (R-h7-1).
         File / Edit / Markers / Display / Grid / Help. No Simulate menu, ever. ── -->
    <hv:HarmonicaMenuView x:Name="Menus" DockPanel.Dock="Top"/>

    <!-- ── §2/§3 (R1C) — the bottom message line. Harmonica.Messages colours it; it shows the
         LAST message only (no history, no scroll) and is selectable so it can be copied into a bug
         report. A grid-solving frame appends an inline "Solving…" bar in Harmonica.ProgressBar,
         width 75, BEFORE any changing counter — nothing that grows may sit to the bar's left or it
         jitters. ── -->
    <Border x:Name="MessageBar" DockPanel.Dock="Bottom"
            BorderBrush="{DynamicResource CrfTileBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="6,3">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <SelectableTextBlock x:Name="MessageText" VerticalAlignment="Center" FontSize="11"/>
        <TextBlock x:Name="SolvingText" Text="Solving…" VerticalAlignment="Center" FontSize="11"
                   IsVisible="False"/>
        <ProgressBar x:Name="SolveProgressBar" Width="75" Height="10" Minimum="0" Maximum="1"
                     VerticalAlignment="Center" IsVisible="False"/>
        <TextBlock x:Name="SolveProgressCounter" VerticalAlignment="Center" FontSize="11"
                   IsVisible="False"/>
      </StackPanel>
    </Border>

    <!-- ── The §7.1 panel area. The canvas fills it; the readout strip is overlaid at the
         placement CharmLayout gives it, so both read one layout source. ── -->
    <Panel x:Name="PanelHost">
      <ctrl:HarmonicaCanvas x:Name="Canvas" ClipToBounds="True">
        <!-- R-h9b-10/12 — ONE ContextMenu instance, mirroring LayoutCanvas's own L1-fix pattern: the
             canvas only RECORDS a right-click (ContextMenuTarget); this menu's Opening handler reads
             it and rebuilds ItemsSource fresh, so the power-sweep X-unit picker and the DCIV Sweeps
             trigger — two different right-click gestures on two different panels — share one menu
             rather than each popping its own. -->
        <ctrl:HarmonicaCanvas.ContextMenu>
          <ContextMenu Opening="OnCanvasContextMenuOpening"/>
        </ctrl:HarmonicaCanvas.ContextMenu>
      </ctrl:HarmonicaCanvas>

      <Border x:Name="ReadoutHost"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="Transparent">
        <hv:ReadoutStripView x:Name="Readouts"/>
      </Border>
    </Panel>

  </DockPanel>
</UserControl>
