<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:tun="using:CircuitRF.Ui.Tuning"
             xmlns:opt="using:CircuitRF.Design.Optimization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CircuitRF.Ui.Views.Tuning.TuningToolView"
             x:DataType="dockVm:TuningTool"
             Background="{DynamicResource SystemChromeLowColor}">

    <!-- brief-tuneopt-4 §2. Header (schematic + status), a toolbar of the Analyses panel's own small
         icon buttons, then one row per tune-enabled entry. Readouts carry no prose: a value, or a
         short status, and a sentence only where there is no value at all. -->

    <!-- The Fluent slider reserves 15 px above and below its track and a 32 px minimum, so it lays
         out 50 px tall around a 20 px thumb — and the value box beside it stretched to the row that
         made. These zero the reserve and take a 16 px thumb: the slider is as tall as its thumb, which
         stays centred on the track (measured headlessly, 2026-10-07). A negative margin only shrank
         the footprint and left the row tall. -->
    <UserControl.Resources>
        <GridLength x:Key="SliderPreContentMargin">0</GridLength>
        <GridLength x:Key="SliderPostContentMargin">0</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">0</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
        <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
        <!-- The header's digits menu: one radio item per choice (TuningDigitsChoice). -->
        <ControlTheme x:Key="DigitsMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="tun:TuningDigitsChoice">
            <Setter Property="Header" Value="{Binding Label}"/>
            <Setter Property="ToggleType" Value="Radio"/>
            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding Digits}"/>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.tb">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
        </Style>
        <Style Selector="Button.tb mi|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="Button.tb:disabled mi|MaterialIcon">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <!-- Fluent paints a disabled button's presenter grey, which on a borderless icon reads as PRESSED. -->
        <Style Selector="Button.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- brief-sdl-7: the Circuit + EM correction toggle, drawn as the toolbar's buttons are; on, its icon takes the accent. -->
        <Style Selector="ToggleButton.tb">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,1,0"/>
        </Style>
        <Style Selector="ToggleButton.tb mi|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="ToggleButton.tb:disabled mi|MaterialIcon">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="ToggleButton.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.tb:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ToggleButton.tb:checked mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Border.row.lagging">
            <Setter Property="Background" Value="#14FFA000"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="TextBlock.bound">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.AddRows ListBoxItem">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, x:DataType=tun:TuningAddRow}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- No schematic focused: one line, nothing else. -->
        <TextBlock IsVisible="{Binding !Panel.HasSchematic}"
                   Text="{x:Static tun:TuningPanelViewModel.NoSchematicText}"
                   Margin="8" FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding HasSchematic}"
              DataContext="{Binding Panel}" x:DataType="tun:TuningPanelViewModel">

            <!-- Header: schematic, status dot, last evaluation time / how far behind. The time text has a
                 minimum width so "0.4 s" becoming "1.4 s behind" does not push the dot sideways. -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,4,2,1">
                <TextBlock Grid.Column="0" Text="{Binding HeaderLabel}"
                           FontWeight="SemiBold" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Ellipse Grid.Column="1" x:Name="StatusDot" Width="8" Height="8" Margin="6,0,4,0"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" x:Name="StatusTime" FontSize="11" Opacity="0.7"
                           MinWidth="80" TextAlignment="Left" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Classes="tb" Margin="4,0,0,0" VerticalAlignment="Center"
                        ToolTip.Tip="Significant digits for tuned and optimized values">
                    <mi:MaterialIcon Kind="DecimalDecrease"/>
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding DigitsChoices}" ItemContainerTheme="{StaticResource DigitsMenuItem}"/>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Toolbar. -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,0,4,2">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Classes="tb" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}"
                            ToolTip.Tip="Start tuning — the Data Display follows the sliders">
                        <mi:MaterialIcon Kind="Play"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}"
                            ToolTip.Tip="Stop tuning — keeps the last result as the results file">
                        <mi:MaterialIcon Kind="Stop"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding RevertCommand}"
                            ToolTip.Tip="Revert every slider to the schematic's value">
                        <mi:MaterialIcon Kind="Restore"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding PushCommand}"
                            ToolTip.Tip="Push the tuned values into the schematic (undoable)">
                        <mi:MaterialIcon Kind="TrayArrowDown"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding LockInCommand}"
                            ToolTip.Tip="Lock in — keep the current values as a preset">
                        <mi:MaterialIcon Kind="LockOutline"/>
                    </Button>

                    <Border Width="1" Height="12" Margin="2,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource SystemBaseLowColor}"/>

                    <Button Classes="tb" Command="{Binding SnapshotCommand}"
                            ToolTip.Tip="Snapshot — keep the current traces as faded ghosts">
                        <mi:MaterialIcon Kind="CameraOutline"/>
                    </Button>
                    <Button Classes="tb" Command="{Binding ClearSnapshotCommand}"
                            ToolTip.Tip="Clear snapshot">
                        <mi:MaterialIcon Kind="CameraOffOutline"/>
                    </Button>

                    <Border Width="1" Height="12" Margin="2,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource SystemBaseLowColor}"/>

                    <!-- brief-sdl-7 D7: the sliders drive the circuit model; EM is one solve, on request. -->
                    <Button Classes="tb" Command="{Binding SolveEmHereCommand}"
                            ToolTip.Tip="Solve EM here — one EM solve of the layout at these values, drawn as faded traces under the circuit model">
                        <mi:MaterialIcon Kind="CubeScan"/>
                    </Button>
                    <ToggleButton Classes="tb" IsChecked="{Binding ShowEmCorrection}" IsEnabled="{Binding HasEm}"
                                  ToolTip.Tip="Circuit + EM correction — add the last EM solve's difference to the live circuit traces (an estimate away from the solved values)">
                        <mi:MaterialIcon Kind="VectorLink"/>
                    </ToggleButton>

                    <Border Width="1" Height="12" Margin="2,0,3,0" VerticalAlignment="Center"
                            Background="{DynamicResource SystemBaseLowColor}"/>

                    <!-- Add…: the catalog, searchable, multi-select, Enter adds. -->
                    <Button Classes="tb" x:Name="AddButton" ToolTip.Tip="Add values to tune…">
                        <mi:MaterialIcon Kind="Plus"/>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <Grid RowDefinitions="Auto,Auto,*" Width="320" Height="300"
                                      DataContext="{Binding Add}" x:DataType="tun:TuningAddViewModel">
                                    <!-- The search box takes what the × leaves: the popup's width is unchanged. -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" x:Name="AddSearch" Text="{Binding SearchText}"
                                                 PlaceholderText="Name, instance, parameter or cell" FontSize="12">
                                            <TextBox.InnerLeftContent>
                                                <mi:MaterialIcon Kind="Magnify" Width="14" Height="14" Margin="6,0,0,0" Opacity="0.6"/>
                                            </TextBox.InnerLeftContent>
                                        </TextBox>
                                        <Button Grid.Column="1" Classes="tb" Margin="4,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding CloseCommand}" ToolTip.Tip="Close">
                                            <mi:MaterialIcon Kind="Close" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                    <CheckBox Grid.Row="1" Content="Include sub-cells" FontSize="12" Margin="0,4"
                                              IsChecked="{Binding IncludeSubCells}"/>
                                    <ListBox Grid.Row="2" x:Name="AddList" Classes="AddRows"
                                             ItemsSource="{Binding Results}" SelectionMode="Multiple,Toggle">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="tun:TuningAddRow">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Display}" FontSize="12"/>
                                                        <TextBlock Text="{Binding Location}" Classes="muted" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="11"
                                                               Opacity="0.8" Margin="8,0,0,0"/>
                                                    <mi:MaterialIcon Grid.Column="2" Kind="LockOutline" Width="12" Height="12"
                                                                     Margin="4,0,0,0" Opacity="0.6"
                                                                     IsVisible="{Binding IsReadOnly}"
                                                                     ToolTip.Tip="{Binding ReadOnlyReason}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- ⚙: run on release, and which analyses a move evaluates. -->
                    <Panel>
                        <Button Classes="tb" x:Name="SettingsButton" ToolTip.Tip="Tuning settings">
                            <mi:MaterialIcon Kind="CogOutline"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="280" Spacing="4">
                                        <CheckBox Content="Run on release" FontSize="12" IsChecked="{Binding RunOnRelease}"
                                                  ToolTip.Tip="Simulate only when a slider is let go"/>
                                        <Separator Margin="0,2"/>
                                        <RadioButton Content="All enabled analyses" FontSize="12"
                                                     IsChecked="{Binding ScopeSettings.UseAll}"/>
                                        <RadioButton Content="Only these:" FontSize="12"
                                                     IsChecked="{Binding !ScopeSettings.UseAll}"/>
                                        <ItemsControl ItemsSource="{Binding ScopeSettings.Analyses}" Margin="18,0,0,0"
                                                      IsEnabled="{Binding !ScopeSettings.UseAll}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="tun:TuningScopeRow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <CheckBox Grid.Column="0" Content="{Binding Name}" FontSize="12"
                                                                  IsChecked="{Binding IsChecked}"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PointsText}" Classes="muted" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding Warning}" FontSize="10" HorizontalAlignment="Right"
                                                                       Foreground="{DynamicResource SystemErrorTextColor}"
                                                                       IsVisible="{Binding HasWarning}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <!-- The badge: the last evaluation was slow. One click turns run-on-release on. -->
                        <Button Command="{Binding AcceptRunOnReleaseCommand}" IsVisible="{Binding RunOnReleaseSuggested}"
                                Width="9" Height="9" Padding="0" MinWidth="0" MinHeight="0" CornerRadius="5"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-1,0"
                                Background="#FFFFA000" BorderThickness="0"
                                ToolTip.Tip="Evaluations are slow — click to simulate only when a slider is released"/>
                    </Panel>

                    <Button Classes="tb" Click="OnHelp" ToolTip.Tip="Help">
                        <mi:MaterialIcon Kind="HelpCircleOutline"/>
                    </Button>

                    <!-- Evaluate at (brief-yield-7): the nominal, or one of the schematic's enabled corners. -->
                    <ComboBox ItemsSource="{Binding EvaluateAtChoices}" SelectedItem="{Binding EvaluateAt}"
                              IsVisible="{Binding HasCorners}" FontSize="11" MinHeight="22" Padding="6,1"
                              Margin="4,0,0,0" VerticalAlignment="Center"
                              ToolTip.Tip="Evaluate at — the sliders' values at this corner. Push still writes the values alone."/>
                </StackPanel>

                <!-- Presets (TO-5): "Last tuned" pinned first, then newest first. Click a name to recall it;
                     tick two (or one and Schematic) to compare. -->
                <Button Grid.Column="2" x:Name="PresetsButton" Padding="6,1" FontSize="11"
                        Background="Transparent" BorderThickness="0" ToolTip.Tip="Presets">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="Presets" VerticalAlignment="Center"/>
                        <mi:MaterialIcon Kind="MenuDown" Width="12" Height="12"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="2">
                                <TextBlock Text="No presets yet. Lock in (the padlock) keeps the sliders' values as one." FontSize="12" Opacity="0.6"
                                           TextWrapping="Wrap" IsVisible="{Binding !HasPresets}"/>
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="tun:TuningPresetItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Background="Transparent"
                                                  ToolTip.Tip="{Binding ToolTipText}">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForCompare}"
                                                          MinWidth="0" Padding="0" Margin="0,0,4,0"
                                                          ToolTip.Tip="Select to compare"/>
                                                <Panel Grid.Column="1">
                                                    <Button Command="{Binding RecallCommand}" IsVisible="{Binding !IsRenaming}"
                                                            Background="Transparent" BorderThickness="0" Padding="2,1"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <mi:MaterialIcon Kind="PinOutline" Width="11" Height="11" Opacity="0.6"
                                                                             IsVisible="{Binding IsLastTuned}"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBox Text="{Binding RenameText}" IsVisible="{Binding IsRenaming}"
                                                             Classes="presetRename" FontSize="12" Padding="2,0" MinHeight="0"/>
                                                </Panel>
                                                <TextBlock Grid.Column="2" Text="{Binding CreatedText}" Classes="muted"
                                                           VerticalAlignment="Center" Margin="6,0,2,0"/>
                                                <Button Grid.Column="3" Classes="tb" ToolTip.Tip="More">
                                                    <mi:MaterialIcon Kind="DotsVertical"/>
                                                    <Button.Flyout>
                                                        <MenuFlyout FlyoutPresenterClasses="compact">
                                                            <MenuItem Header="Recall" Command="{Binding RecallCommand}"/>
                                                            <MenuItem Header="Recall and Push" Command="{Binding RecallAndPushCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Rename" Command="{Binding RenameCommand}"/>
                                                            <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}"/>
                                                            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"/>
                                                            <Separator/>
                                                            <MenuItem Header="Copy as .cnl" Command="{Binding CopyAsCnlCommand}"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,2"/>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0" Content="Schematic" FontSize="12"
                                              IsChecked="{Binding CompareSchematic}"
                                              ToolTip.Tip="Compare a preset with the schematic's values"/>
                                    <Button Grid.Column="2" Content="Compare" FontSize="11" Padding="8,1"
                                            Command="{Binding CompareCommand}"
                                            ToolTip.Tip="Compare the two ticked presets"/>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- What the last action did; under it, what the EM traces are (brief-sdl-7 D7). -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.75"
                           Margin="6,0,6,2" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusDetail}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding EmText}" FontSize="11" Margin="6,0,6,2" TextTrimming="CharacterEllipsis" Opacity="0.75"
                           IsVisible="{Binding EmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- Compare (R-to5-6): both values of every key and the difference. No simulation. -->
            <Border Grid.Row="3" IsVisible="{Binding HasComparison}" Margin="4,0,4,4" Padding="4,2"
                    BorderThickness="1" BorderBrush="{DynamicResource SystemBaseLowColor}" CornerRadius="3">
                <StackPanel Spacing="1" Grid.IsSharedSizeScope="True">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ComparisonTitle}" FontSize="11" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="tb" Command="{Binding CloseComparisonCommand}" ToolTip.Tip="Close">
                            <mi:MaterialIcon Kind="Close"/>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ComparisonRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="opt:PresetComparisonRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="cmpKey"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="cmpA"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="cmpB"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding A, TargetNullValue='—'}" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding B, TargetNullValue='—'}" FontSize="11" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Difference}" Classes="muted"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tun:TuningRowViewModel">
                            <Border Classes="row" Classes.lagging="{Binding IsLagging}" Padding="6,3,4,3">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto,Auto">

                                    <!-- Name, and where it lives for a sub-cell row. -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center" MinWidth="80" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Key}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Location}" Classes="muted" IsVisible="{Binding HasLocation}"
                                                   VerticalAlignment="Center"/>
                                        <mi:MaterialIcon Kind="LockOutline" Width="11" Height="11" Opacity="0.6"
                                                         IsVisible="{Binding IsReadOnly}" ToolTip.Tip="{Binding ReadOnlyReason}"/>
                                    </StackPanel>

                                    <!-- Disabled: the reason, and nothing to drag. -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                               IsVisible="{Binding IsDisabled}" Classes="muted" VerticalAlignment="Center"
                                               Text="{Binding DisabledReason, StringFormat='disabled — {0}'}"/>

                                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1"
                                            Value="{Binding Position}" IsVisible="{Binding IsEnabled}"
                                            Classes="tuning" VerticalAlignment="Center"
                                            Focusable="True" Tag="{Binding}"
                                            ToolTip.Tip="Up/Down: previous or next value · Left/Right: one step (Shift: ten) · Page Up/Down: a tenth of the range"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ValueBoxText}"
                                             IsVisible="{Binding IsEnabled}" Classes="tuningValue"
                                             Width="{Binding ValueBoxWidth}" FontSize="12" Padding="4,1" MinHeight="0" Margin="4,0,2,0"
                                             VerticalAlignment="Center" HorizontalContentAlignment="Right" Tag="{Binding}"
                                             ToolTip.Tip="{Binding CandidateTip}"/>
                                    <!-- The unit, or for a vendor part its stated value. -->
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UnitText}" FontSize="11"
                                               IsVisible="{Binding IsEnabled}" VerticalAlignment="Center" MinWidth="16"/>

                                    <!-- ⋮ -->
                                    <Button Grid.Row="0" Grid.Column="4" Classes="tb" ToolTip.Tip="More">
                                        <mi:MaterialIcon Kind="DotsVertical"/>
                                        <Button.Flyout>
                                            <MenuFlyout FlyoutPresenterClasses="compact">
                                                <!-- A vendor part: which parts the slider steps through (brief vendorlib-4 R-vl4-5a). -->
                                                <MenuItem Header="Same kind" Command="{Binding SetSameKindCommand}" IsVisible="{Binding IsPart}"
                                                          ToolTip.Tip="The parts like the placed one: same file, same description but the value">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsSameKind}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Search the library…" Command="{Binding EditQueryCommand}" IsVisible="{Binding IsPart}"
                                                          ToolTip.Tip="The parts a search of the part's own library finds — the palette's search">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding !IsSameKind}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Clear value bounds" Command="{Binding ResetRangeCommand}" IsVisible="{Binding IsPart}"/>
                                                <!-- How the slider moves: ONE choice, ticked. -->
                                                <MenuItem Header="Linear" Command="{Binding SetLinearCommand}" IsVisible="{Binding IsNumeric}">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsModeLinear}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Log" Command="{Binding SetLogCommand}" IsVisible="{Binding IsNumeric}">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsModeLog}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Step…" Command="{Binding EditStepCommand}" IsVisible="{Binding IsNumeric}">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsModeStep}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Standard values" IsVisible="{Binding CanSeries}">
                                                    <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsSeries}"/></MenuItem.Icon>
                                                    <MenuItem Header="E6" Command="{Binding SetSeriesCommand}" CommandParameter="E6">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsE6}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="E12" Command="{Binding SetSeriesCommand}" CommandParameter="E12">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsE12}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="E24" Command="{Binding SetSeriesCommand}" CommandParameter="E24">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsE24}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="E48" Command="{Binding SetSeriesCommand}" CommandParameter="E48">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsE48}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="E96" Command="{Binding SetSeriesCommand}" CommandParameter="E96">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsE96}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Preferences ladder" Command="{Binding SetSeriesCommand}" CommandParameter="Preferred" IsVisible="{Binding CanPreferred}">
                                                        <MenuItem.Icon><mi:MaterialIcon Kind="Check" IsVisible="{Binding IsPreferred}"/></MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Re-centre range on value" Command="{Binding RecentreRangeCommand}" IsVisible="{Binding IsNumeric}"/>
                                                <MenuItem Header="Reset range to default" Command="{Binding ResetRangeCommand}" IsVisible="{Binding IsNumeric}"/>
                                                <Separator IsVisible="{Binding IsNumeric}"/>
                                                <MenuItem Header="Reveal on canvas" Command="{Binding RevealCommand}"/>
                                                <MenuItem Header="Remove from tuning" Command="{Binding RemoveCommand}"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>

                                    <!-- min / max under the slider, editable in place; the scale beside them. -->
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto,Auto"
                                          IsVisible="{Binding IsEnabled}">
                                        <Panel Grid.Column="0">
                                            <TextBlock Text="{Binding MinText}" Classes="bound" IsVisible="{Binding !IsEditingMin}"
                                                       Tag="min" PointerPressed="OnBoundPressed" ToolTip.Tip="Minimum — click to edit"/>
                                            <TextBox Text="{Binding MinText}" IsVisible="{Binding IsEditingMin}" Classes="tuningBound"
                                                     Tag="min" Width="64" FontSize="10" Padding="2,0" MinHeight="0"/>
                                        </Panel>
                                        <Panel Grid.Column="2">
                                            <TextBlock Text="{Binding MaxText}" Classes="bound" IsVisible="{Binding !IsEditingMax}"
                                                       Tag="max" PointerPressed="OnBoundPressed" ToolTip.Tip="Maximum — click to edit"/>
                                            <TextBox Text="{Binding MaxText}" IsVisible="{Binding IsEditingMax}" Classes="tuningBound"
                                                     Tag="max" Width="64" FontSize="10" Padding="2,0" MinHeight="0"/>
                                        </Panel>
                                        <TextBlock Grid.Column="3" Text="{Binding ScaleLabel}" Classes="muted" Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- A vendor part: its candidates in one line, and the library search when it is edited. -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Spacing="2" IsVisible="{Binding IsPart}">
                                        <TextBlock Text="{Binding CandidatesText}" Classes="muted" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding CandidatesText}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsEditingQuery}">
                                            <TextBlock Text="search" Classes="muted" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding QueryText}" Classes="tuningBound" Tag="query"
                                                     Width="160" FontSize="10" Padding="2,0" MinHeight="0"
                                                     PlaceholderText="0603 C0G 50V"
                                                     ToolTip.Tip="A search of the part's own library, as the palette searches it. Enter applies it; blank goes back to the parts of the same kind."/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Step… -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                IsVisible="{Binding IsEditingStep}">
                                        <TextBlock Text="step" Classes="muted" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding StepText}" Classes="tuningBound" Tag="step"
                                                 Width="64" FontSize="10" Padding="2,0" MinHeight="0"/>
                                        <TextBlock Text="{Binding Unit}" Classes="muted" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Panel>
</UserControl>
