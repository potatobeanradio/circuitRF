<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CircuitRF.Ui"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:views="using:CircuitRF.Ui.Views"
             xmlns:pv="using:CircuitRF.Ui.Views.ProjectTree"
             xmlns:propv="using:CircuitRF.Ui.Views.Properties"
             xmlns:cv="using:CircuitRF.Ui.Views.Content"
             xmlns:schemDoc="using:CircuitRF.Ui.Schematic"
             xmlns:md="using:CircuitRF.Ui.Markdown"
             xmlns:mv="using:CircuitRF.Ui.Views.Messages"
             xmlns:drcv="using:CircuitRF.Ui.Views.Drc"
             xmlns:lvsv="using:CircuitRF.Ui.Views.Lvs"
             xmlns:instv="using:CircuitRF.Ui.Views.Instances"
             xmlns:revv="using:CircuitRF.Ui.Views.Revision"
             xmlns:wbondv="using:CircuitRF.Ui.Views.WBond"
             xmlns:av="using:CircuitRF.Ui.Views.Analyses"
             xmlns:palv="using:CircuitRF.Ui.Views.Palette"
             xmlns:dd="using:CircuitRF.Ui.DataDisplay"
             xmlns:harm="using:CircuitRF.Ui.Harmonica"
             xmlns:harmv="using:CircuitRF.Ui.Views.Harmonica"
             xmlns:railrf="using:CircuitRF.Ui.RailRf"
             xmlns:railv="using:CircuitRF.Ui.Views.RailRf"
             xmlns:sm="using:CircuitRF.Ui.Smith"
             xmlns:smv="using:CircuitRF.Ui.Views.Smith"
             xmlns:wb="using:CircuitRF.Ui.WBond"
             xmlns:wbv="using:CircuitRF.Ui.Views.WBond"
             xmlns:ddv="using:CircuitRF.Ui.Views.DataDisplay"
             xmlns:v3d="using:CircuitRF.Ui.Viewer3D"
             xmlns:v3dv="using:CircuitRF.Ui.Views.Viewer3D"
             xmlns:lay="using:CircuitRF.Ui.Layout"
             xmlns:em="using:CircuitRF.Ui.Layout.Em"
             xmlns:layv="using:CircuitRF.Ui.Views.Layout"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:dockCtrl="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
             xmlns:dockCore="clr-namespace:Dock.Model.Core;assembly=Dock.Model"
             x:Class="CircuitRF.Ui.App"
             Name="circuitRF"
             RequestedThemeVariant="Default">

    <!-- macOS app menu (app name + About + Settings). Ignored on Windows/Linux.
         Do NOT add Quit here — AppKit appends it automatically; adding it explicitly
         causes a duplicate. Quit is handled via ShutdownRequested in App.axaml.cs. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About circuitRF…"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <!-- Standard ViewLocator for normal MVVM pairs. -->
        <local:ViewLocator/>

        <!-- Dock region views — DataTemplates map Dock Tool/Document subclasses to views.
             Dock resolves these when rendering the dock layout. -->
        <DataTemplate DataType="{x:Type dockVm:ProjectTreeTool}">
            <pv:ProjectTreeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:PropertiesTool}">
            <propv:PropertiesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:AnalysesTool}">
            <av:AnalysesToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:MessagesTool}">
            <mv:MessagesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:PaletteTool}">
            <palv:PaletteToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:WBondProfileTool}">
            <wbondv:WBondProfileToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:WBondInductanceTool}">
            <wbondv:WBondInductanceToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:DrcTool}">
            <drcv:DrcToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:LvsTool}">
            <lvsv:LvsToolView/>
        </DataTemplate>
        <!-- brief-find-instance-panel.md — the focused schematic's or layout's placed components. -->
        <DataTemplate DataType="{x:Type dockVm:InstancesTool}">
            <instv:InstancesToolView/>
        </DataTemplate>
        <!-- RC-10's one history panel (§5.10). It replaced two, and the merge is why there is one row
             here: §5's argument is about two kinds of ENTRY and rev 2 spent it as an argument for two
             WINDOWS. A panel with no template at all renders as nothing but its own type name, which
             is how RC-5's list first shipped. -->
        <DataTemplate DataType="{x:Type dockVm:HistoryTool}">
            <revv:HistoryToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:StubDocument}">
            <cv:StubContentView/>
        </DataTemplate>
        <!-- A workspace's README.md, read-only. Opened instead of the Welcome tab when a workspace
             has one and nothing else is being restored — which is what an example workspace, freshly
             copied out of Tools ▸ Examples, always is. -->
        <DataTemplate DataType="{x:Type md:MarkdownDocument}">
            <cv:MarkdownDocumentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:SchematicDocument}">
            <cv:SchematicView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:SymbolEditorDocument}">
            <cv:SymbolEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:CellParameterEditorDocument}">
            <cv:CellParameterEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dd:DataDisplayDocument}">
            <ddv:DataDisplayView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type harm:HarmonicaDocument}">
            <harmv:HarmonicaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type lay:LayoutDocument}">
            <layv:LayoutEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type lay:TechDocument}">
            <layv:TechEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type v3d:Viewer3DDocument}">
            <v3dv:Viewer3DView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type em:EmSetupDocument}">
            <layv:EmSetupEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type wb:WBondDocument}">
            <wbv:WBondEditorView/>
        </DataTemplate>

        <!-- The Smith Chart tool is a DOCUMENT and not an application (smith-chart.md §5.1), so it
             appears here beside the other document kinds rather than owning a window of its own. -->
        <DataTemplate DataType="{x:Type sm:SmithChartDocument}">
            <smv:SmithChartView/>
        </DataTemplate>

        <!-- R-rail24-1a — the part library is a DOCUMENT, so it appears here beside the other
             document kinds. railRF's own window is a different thing and stays one. -->
        <DataTemplate DataType="{x:Type railrf:PartLibraryDocument}">
            <railv:PartLibraryEditorView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- R-h8-6 — ONE dictionary, both Applications. See Styles/CircuitRfResources.axaml. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CircuitRF.Ui/Styles/CircuitRfResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- R-h8-6 — ONE style set, both Applications. See Styles/CircuitRfStyles.axaml. -->
        <StyleInclude Source="avares://CircuitRF.Ui/Styles/CircuitRfStyles.axaml"/>
    </Application.Styles>
</Application>
