<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CircuitRF.Ui"
             xmlns:conv="using:CircuitRF.Ui.Converters"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             xmlns:views="using:CircuitRF.Ui.Views"
             xmlns:pv="using:CircuitRF.Ui.Views.ProjectTree"
             xmlns:propv="using:CircuitRF.Ui.Views.Properties"
             xmlns:cv="using:CircuitRF.Ui.Views.Content"
             xmlns:schemDoc="using:CircuitRF.Ui.Schematic"
             xmlns:mv="using:CircuitRF.Ui.Views.Messages"
             xmlns:drcv="using:CircuitRF.Ui.Views.Drc"
             xmlns:av="using:CircuitRF.Ui.Views.Analyses"
             xmlns:palv="using:CircuitRF.Ui.Views.Palette"
             xmlns:dd="using:CircuitRF.Ui.DataDisplay"
             xmlns:ddv="using:CircuitRF.Ui.Views.DataDisplay"
             xmlns:lay="using:CircuitRF.Ui.Layout"
             xmlns:em="using:CircuitRF.Ui.Layout.Em"
             xmlns:layv="using:CircuitRF.Ui.Views.Layout"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:dockCtrl="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
             xmlns:dockCore="clr-namespace:Dock.Model.Core;assembly=Dock.Model"
             x:Class="CircuitRF.Ui.App"
             Name="circuitRF"
             RequestedThemeVariant="Default">

    <!-- macOS app menu (app name + About + Settings). Ignored on Windows/Linux.
         Do NOT add Quit here — AppKit appends it automatically; adding it explicitly
         causes a duplicate. Quit is handled via ShutdownRequested in App.axaml.cs. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About circuitRF…"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Settings…" Gesture="Meta+OemComma"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <!-- Standard ViewLocator for normal MVVM pairs. -->
        <local:ViewLocator/>

        <!-- Dock region views — DataTemplates map Dock Tool/Document subclasses to views.
             Dock resolves these when rendering the dock layout. -->
        <DataTemplate DataType="{x:Type dockVm:ProjectTreeTool}">
            <pv:ProjectTreeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:PropertiesTool}">
            <propv:PropertiesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:AnalysesTool}">
            <av:AnalysesToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:MessagesTool}">
            <mv:MessagesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:PaletteTool}">
            <palv:PaletteToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:DrcTool}">
            <drcv:DrcToolView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:StubDocument}">
            <cv:StubContentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:SchematicDocument}">
            <cv:SchematicView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:SymbolEditorDocument}">
            <cv:SymbolEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type schemDoc:CellParameterEditorDocument}">
            <cv:CellParameterEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type dd:DataDisplayDocument}">
            <ddv:DataDisplayView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type lay:LayoutDocument}">
            <layv:LayoutEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type lay:TechDocument}">
            <layv:TechEditorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type em:EmSetupDocument}">
            <layv:EmSetupEditorView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="DejaVuSans">avares://CircuitRF.Ui/Assets/Fonts#DejaVu Sans</FontFamily>
        <sys:Double x:Key="FontSize">12</sys:Double>

        <!-- System.Warning brush — initialized from ColorTheme.BuiltIn in App.axaml.cs;
             updated on ThemeService.ThemeChanged so tree warning nodes follow the active theme. -->
        <SolidColorBrush x:Key="CrfWarningBrush" Color="#CE4A24"/>

        <!-- Palette tile definition border: semitransparent neutral gray so it reads against
             the panel in both light and dark without fighting the armed accent color.
             BorderBrush requires a Brush; System*Color keys resolve to Color (not Brush) and
             may silently fail to render on BorderBrush — always use a SolidColorBrush resource. -->
        <SolidColorBrush x:Key="CrfTileBorderBrush" Color="#55808080"/>

        <!-- Icon brush: wraps SystemBaseMediumColor as a Brush so it can be assigned to
             Stroke/BorderBrush properties (which require IBrush, not Color).
             Defined at Application scope so popup visual trees can reach it. -->
        <SolidColorBrush x:Key="CrfIconBrush" Color="{DynamicResource SystemBaseMediumColor}"/>

        <!-- brief-foreign-documents.md §4/R-fgn-7: marks a foreign document's chrome (edge band, tab
             tint) — amber, NEVER red (red means error; a foreign document is a normal, supported
             state), and never used to tint rendered geometry. Semi-transparent so it reads over either
             theme without a separate light/dark pair, same convention as CrfTileBorderBrush above. -->
        <SolidColorBrush x:Key="CrfForeignBandBrush" Color="#33E8A33D"/>
        <SolidColorBrush x:Key="CrfForeignAccentBrush" Color="#E8A33D"/>

<!-- Converters registered as application-level resources so all views can use them -->
        <conv:TreeItemIconConverter           x:Key="TreeItemIconConverter"/>
        <conv:StubKindIsSchematicConverter    x:Key="StubKindIsSchematicConverter"/>
        <conv:StubKindIsDataDisplayConverter  x:Key="StubKindIsDataDisplayConverter"/>
        <conv:MessageLevelToIconConverter     x:Key="MessageLevelToIconConverter"/>
        <conv:MessageLevelToColorConverter    x:Key="MessageLevelToColorConverter"/>
        <conv:IsNotNullConverter              x:Key="IsNotNullConverter"/>

        <!-- Override Dock.Fluent accent brushes with the OS system accent color.
             DockFluentTheme/Accents/Fluent.axaml hardcodes VS-blue (#007ACC) for these
             "DockApplication*" keys. Application.Resources wins over StyleInclude resources
             for DynamicResource lookups, so overriding them here replaces the hardcoded blue.
             However, the theme also uses StaticResource aliases (e.g. DockTabActiveBackgroundBrush
             → DockApplicationAccentBrushLow) which resolve at THEME LOAD time — those alias keys
             must be overridden here directly too, or they keep pointing to the original #007ACC
             brush regardless of the DockApplicationAccentBrush* overrides. -->

        <!-- Primary accent family -->
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow"       Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed"       Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh"      Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="{DynamicResource SystemAccentColor}"/>

        <!-- StaticResource aliases the theme resolves at load time — must also be overridden -->
        <SolidColorBrush x:Key="DockTabActiveBackgroundBrush"        Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockTabActiveIndicatorBrush"         Color="{DynamicResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="DockTabHoverBackgroundBrush"         Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush"    Color="{DynamicResource SystemAccentColorLight2}"/>
        <SolidColorBrush x:Key="DockSplitterHoverBrush"              Color="{DynamicResource SystemAccentColorLight1}"/>
        <SolidColorBrush x:Key="DockSplitterDragBrush"               Color="{DynamicResource SystemAccentColor}"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />

        <!-- Dock.Avalonia.Themes.Fluent — provides DockControl rendering and styling.
             Resolved from Dock.Avalonia.Themes.Fluent 12.0.0.2 package. -->
        <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>

        <!-- Avalonia.Controls.ColorPicker Fluent theme (12.0.3).
             Required for ColorView/ColorPicker controls to render with templates.
             Path verified from embedded resources in Avalonia.Controls.ColorPicker.dll:
             Avalonia.Controls.ColorPicker.Themes.Fluent.Fluent.xaml -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>

        <!-- Document bodies: use Dock's NON-deferred (cached) content template.
             The default 'DockDocumentControlSingleContentTemplate' wraps each document body in a
             DeferredContentControl that realizes content on a background-priority timeline. In our
             app that defers the first paint of a newly-activated document until the next layout
             pass (the canvas stayed blank/stale until a panel was toggled). The cached template
             hosts each dockable in a plain ContentControl (resolved via the App DataTemplates),
             so document bodies paint on the normal layout pass. Trade-off: all open document
             bodies are kept realized (cached) rather than lazily built — fine at our tab counts. -->
        <Style Selector="dockCtrl|DocumentControl">
            <Setter Property="Template" Value="{DynamicResource DockDocumentControlCachedContentTemplate}"/>

            <!-- brief-foreign-documents.md §4 item 3: tab header tint. Overrides the theme's own
                 default HeaderTemplate (a bare TextBlock bound to Title) with the same TextBlock
                 wrapped in a Border whose Background tints amber for a foreign document — never red
                 (R-fgn-7), never touching rendered geometry. x:CompileBindings="False" because the
                 declared DataType is the IDockable interface, but the runtime item may be any
                 concrete Document type; only LayoutDocument actually declares IsForeign today — every
                 other document type binds null here and renders untinted, exactly like a
                 workspace-bound LayoutDocument. -->
            <Setter Property="HeaderTemplate">
                <DataTemplate x:CompileBindings="False" DataType="dockCore:IDockable">
                    <Border Background="{Binding IsForeign, Converter={x:Static conv:ForeignDocumentTintConverter.Instance}}">
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   Padding="{DynamicResource DockHeaderContentPadding}"/>
                    </Border>
                </DataTemplate>
            </Setter>
        </Style>

        <!-- Material Icons -->
        <mi:MaterialIconStyles/>

        <!-- ── Dock region backgrounds ──────────────────────────────────────
             The DockFluentTheme defaults to SystemAltHighColor (pure white / pure black).
             Override to SystemChromeLowColor (~#F2F2F2 light / ~#171717 dark) so panels
             feel like part of the window chrome, not a harsh contrast surface. -->
        <Style Selector="dockCtrl|ToolControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>

            <!-- CrfToolControlCachedContentTemplate — TOOL analog of DockDocumentControlCachedContentTemplate.
                 The package ToolControl ControlTheme (Dock.Avalonia.Themes.Fluent 12.0.0.2) wraps
                 the active dockable in DeferredContentControl+ControlRecyclingDataTemplate. On tab
                 switch the deferred control retains the existing realized view and only updates
                 DataContext; views with x:DataType compiled bindings silently no-op on the wrong type
                 → stale fallback content ("No workspace open").
                 This template reproduces the full package chrome extracted from the ControlTheme
                 (ToolTabStrip at DockPanel.Dock="Bottom"; Border with DockSurfacePanelBrush /
                 DockBorderSubtleBrush / BorderThickness "1 0 1 0"; PART names preserved) but replaces
                 DeferredContentControl with a plain ContentControl. Avalonia re-resolves the App
                 DataTemplate on each Content change, realizing the correct view for the new active
                 dockable type on every tab switch.
                 x:CompileBindings="False": the DataContext is set at runtime by Dock (to the ToolDock
                 model); no fixed x:DataType is available. DockProperties/ToolTabStrip/DockableControl
                 are in the default Avalonia xmlns (registered by Dock.Avalonia) — no prefix needed.
                 On Dock upgrades: re-extract the ToolControl ControlTheme and mirror its chrome here;
                 change only PART_ContentPresenter (DeferredContentControl → plain ContentControl). -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:CompileBindings="False" TargetType="dockCtrl:ToolControl">
                        <DockPanel x:Name="PART_DockPanel"
                                   Background="Transparent"
                                   ZIndex="1"
                                   DockProperties.IsDropArea="True"
                                   DockProperties.IsDockTarget="True">
                            <ToolTabStrip x:Name="PART_TabStrip"
                                          ItemsSource="{Binding VisibleDockables}"
                                          SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                                          IconTemplate="{TemplateBinding IconTemplate}"
                                          HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                          ModifiedTemplate="{TemplateBinding ModifiedTemplate}"
                                          DockPanel.Dock="Bottom"
                                          DockProperties.IsDropArea="True"
                                          DockProperties.DockAdornerHost="{Binding ElementName=PART_DockPanel}"/>
                            <Border x:Name="PART_Border"
                                    ZIndex="-1"
                                    Background="{DynamicResource DockSurfacePanelBrush}"
                                    Margin="0"
                                    BorderBrush="{DynamicResource DockBorderSubtleBrush}"
                                    BorderThickness="1 0 1 0">
                                <DockableControl DataContext="{Binding ActiveDockable}"
                                                 TrackingMode="Visible">
                                    <ContentControl x:Name="PART_ContentPresenter"
                                                    Content="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch"/>
                                </DockableControl>
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Floating TOOL window title bar: remove the chrome menu (Float / Dock / Dock as Tabbed
             Document). Owner-reported: on a floating tool window those items do nothing, and "Dock"
             is permanently disabled — a menu that cannot act violates R13a (act, or say why), so it
             is removed rather than left as decoration.

             SCOPED TO :floating ON PURPOSE. ToolChromeControl also provides the chrome for DOCKED
             tool panels, where Float does real work; a blanket removal would delete a working
             affordance to fix a broken one. ToolChromeControl sets IsFloating (and hence the
             :floating pseudo-class) when it finds itself hosted in a HostWindow, so this matches
             exactly the case the owner reported.

             MenuButtonTheme is the control's own public hook for theming that button (there is no
             DockSettings flag for it — checked). Replacing it with a theme that is simply not
             visible removes the button, and with it the flyout, without overriding the whole chrome
             template the way DocumentControl/ToolControl above have to. -->
        <Style Selector="dockCtrl|ToolChromeControl:floating">
            <Setter Property="MenuButtonTheme">
                <ControlTheme TargetType="Button">
                    <Setter Property="IsVisible" Value="False"/>
                    <Setter Property="Width" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </ControlTheme>
            </Setter>
        </Style>

        <Style Selector="dockCtrl|DocumentDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>
        <Style Selector="dockCtrl|RootDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>
        <Style Selector="dockCtrl|ProportionalDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>
        <Style Selector="dockCtrl|PinnedDockControl">
            <Setter Property="Background" Value="{DynamicResource SystemChromeLowColor}"/>
        </Style>

        <!-- Toolbar icons: soften from SystemBaseHighColor (~87% black) to SystemBaseMediumColor (~60%).
             MaterialIcon.Foreground does not inherit via TextElement.Foreground, so a descendant
             style targeting the StackPanel.Toolbar class is required. -->
        <Style Selector="StackPanel.Toolbar mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>

        <!-- Global font defaults -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <!-- Owner-reported 3 times now (ScaleDialog, FlattenToPolygonDialog, ...): a Button wider
                 than its content (any fixed-Width dialog button, e.g. Cancel/OK) left-aligns its label
                 by Avalonia's own default, reading as visually off. Centering it ONCE, globally, here
                 is the fix that makes this class of bug impossible to reintroduce per-dialog — do NOT
                 go back to fixing it button-by-button in each new dialog's AXAML. -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource TextControlSelectionHighlightColor}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        </Style>
    </Application.Styles>
</Application>
