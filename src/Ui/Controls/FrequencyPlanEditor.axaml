<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CircuitRF.Ui.ViewModels"
             x:Class="CircuitRF.Ui.Controls.FrequencyPlanEditor">

    <!-- A frequency PLAN over FrequencySpecViewModel rows (R-em-11's editor, shared by brief vendorlib-11 R-vl11-4a):
         the EM Setup panel, Export to Library and the S-parameter analysis all place this control, so there is one plan editor. The
         rows and the + Segment command are the host's; see FrequencyPlanEditor.axaml.cs. The text styles are carried
         here so the control looks the same in any host. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.colhdr">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox.cell">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="0">
    <!-- GitHub discussion 26: a frequency PLAN, one tinted card per segment. A card's top line is its mode
         (Step / Points / Single, then Lin / Log) and its x; under it three equal blocks, Start, Stop and the
         count or step, each a label, a box and a preview — so the three boxes share one line in every card
         by construction, and the card fits a 520 px dialog without wrapping. On a single point the Stop and
         count blocks hide their CONTENT and keep their width, and Lin / Log is last on its line, so nothing
         moves under the pointer that clicked Single. "+ Segment" adds a single point; the run takes the
         union of every card's frequencies. -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <TextBlock Classes="colhdr" Text="Sweep" VerticalAlignment="Bottom"/>
        <Button Grid.Column="1" Content="+ Segment" Classes="seg-btn" x:Name="AddButton"
                ToolTip.Tip="Add a segment to the frequency plan: a single frequency, or a further sweep. The run solves every segment's frequencies together, each once."/>
    </Grid>
    <ItemsControl x:Name="Rows">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:FrequencySpecViewModel">
          <Border Background="{DynamicResource CrfSubCardBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button Content="Step"   Classes="seg-btn" Classes.active="{Binding IsStepMode}"
                            Command="{Binding SetModeStepCommand}"/>
                    <Button Content="Points" Classes="seg-btn" Classes.active="{Binding IsPointsMode}"
                            Command="{Binding SetModePointsCommand}"/>
                    <Button Content="Single" Classes="seg-btn" Classes.active="{Binding IsSinglePoint}"
                            Command="{Binding SetModeSingleCommand}"
                            ToolTip.Tip="One frequency rather than a sweep."/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="0" IsVisible="{Binding IsSweep}">
                    <Button Content="Lin" Classes="seg-btn"
                            Classes.active="{Binding IsLinear}" Command="{Binding SetKindLinearCommand}"/>
                    <Button Content="Log" Classes="seg-btn"
                            Classes.active="{Binding IsLog}" Command="{Binding SetKindLogCommand}"/>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemoveSelf}"
                        VerticalAlignment="Center" Padding="4,0"
                        Background="Transparent" BorderThickness="0" FontSize="13"
                        ToolTip.Tip="Remove this segment"/>
              </Grid>
              <WrapPanel>
                <StackPanel Spacing="2" Width="140" Margin="0,0,8,0">
                  <Panel>
                    <TextBlock Text="Start" Classes="colhdr" IsVisible="{Binding IsSweep}"/>
                    <TextBlock Text="Frequency" Classes="colhdr" IsVisible="{Binding IsSinglePoint}"/>
                  </Panel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="cell" Text="{Binding StartCoeff, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Classes="cell"
                              ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                              SelectedItem="{Binding StartUnit, Mode=TwoWay}"/>
                  </Grid>
                  <TextBlock Text="{Binding StartPreview}" FontSize="10" Opacity="0.55"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Spacing="2" Width="140" Margin="0,0,8,0">
                  <TextBlock Text="Stop" Classes="colhdr" IsVisible="{Binding IsSweep}"/>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsSweep}">
                    <TextBox Classes="cell" Text="{Binding StopCoeff, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Classes="cell"
                              ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                              SelectedItem="{Binding StopUnit, Mode=TwoWay}"/>
                  </Grid>
                  <TextBlock Text="{Binding StopPreview}" FontSize="10" Opacity="0.55"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding IsSweep}"/>
                </StackPanel>
                <StackPanel Spacing="2" Width="140">
                  <TextBlock Text="Step" Classes="colhdr" IsVisible="{Binding IsStepMode}"/>
                  <TextBlock Text="Points" Classes="colhdr" IsVisible="{Binding IsPointsMode}"/>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsStepMode}">
                    <TextBox Classes="cell" Text="{Binding StepCoeff, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1" Classes="cell"
                              ItemsSource="{x:Static vm:FrequencySpecViewModel.FreqUnits}"
                              SelectedItem="{Binding StepUnit, Mode=TwoWay}"/>
                  </Grid>
                  <TextBox Classes="cell" IsVisible="{Binding IsPointsMode}"
                           Text="{Binding NumPointsExpr, Mode=TwoWay}"/>
                  <TextBlock Text="{Binding StepPreview}" FontSize="10" Opacity="0.55"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding IsStepMode}"/>
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </StackPanel>
</UserControl>
