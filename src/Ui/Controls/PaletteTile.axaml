<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             x:Class="CircuitRF.Ui.Controls.PaletteTile"
             x:Name="TileRoot"
             x:DataType="dockVm:PaletteTileVm">

    <UserControl.Styles>
        <!-- Subtle 1px definition border for all unarmed tiles (HIG) -->
        <Style Selector="Button">
            <Setter Property="BorderBrush" Value="{DynamicResource DockBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <!-- Armed: accent background + matching border so definition border doesn't fight the highlight -->
        <Style Selector="Button.armed">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight3}"/>
        </Style>
        <Style Selector="Button.armed:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
    </UserControl.Styles>

    <!-- Tooltip: display name + category (hover to see both) -->
    <ToolTip.Tip>
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding Item.DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Item.Category}"/>
        </StackPanel>
    </ToolTip.Tip>

    <!-- Tile: square button + caption below. Width=68 + Margin 2px H gives 72px slot (width-driven column rule). -->
    <StackPanel Spacing="3" HorizontalAlignment="Center" Width="68" Margin="2 3 2 3">

        <!-- Square glyph button — Command + armed visual class -->
        <Button Width="60"
                Height="60"
                Padding="4"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                HorizontalAlignment="Center"
                Command="{Binding ArmCommand}"
                Classes.armed="{Binding #TileRoot.IsArmed}">
            <ctrl:PaletteGlyphControl Kind="{Binding Item.Kind}" Width="50" Height="50"/>
        </Button>

        <!-- Type label underneath — DisplayName, truncated if long -->
        <TextBlock Text="{Binding Item.DisplayName}"
                   FontSize="10"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="68"
                   HorizontalAlignment="Center"/>
    </StackPanel>

</UserControl>
