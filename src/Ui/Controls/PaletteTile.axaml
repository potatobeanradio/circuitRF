<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="using:CircuitRF.Ui.Controls"
             xmlns:dockVm="using:CircuitRF.Ui.ViewModels.Dock"
             x:Class="CircuitRF.Ui.Controls.PaletteTile"
             x:Name="TileRoot"
             x:DataType="dockVm:PaletteTileVm">

    <UserControl.Styles>
        <!-- Hover + armed states only. The BASE border is set as DIRECT ATTRIBUTES on the
             Border element below (not via a selector) so it always renders — a Border#name
             selector Setter for BorderBrush was not taking effect. Armed/hover override here. -->
        <Style Selector="Border#TileGlyph:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemChromeMediumColor}"/>
        </Style>
        <Style Selector="Border#TileGlyph.armed">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Border#TileGlyph.armed:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}"/>
        </Style>
    </UserControl.Styles>

    <!-- Tooltip: display name + category (hover to see both) -->
    <ToolTip.Tip>
        <StackPanel Spacing="2">
            <TextBlock Text="{Binding Item.DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Item.Category}"/>
        </StackPanel>
    </ToolTip.Tip>

    <!-- Tile: square glyph border + caption below. Width=60 + Margin 2px H gives 62px slot (width-driven column rule).
         The Border is the single pointer owner: PointerReleased-without-drag = arm; PointerMoved-past-threshold = DnD. -->
    <StackPanel Spacing="3" HorizontalAlignment="Center" Width="60" Margin="1 2 1 2">

        <!-- Square glyph border — single pointer owner for both arm (click) and drag-and-drop.
             Border properties are DIRECT ATTRIBUTES (not style setters) so they always render. -->
        <Border x:Name="TileGlyph"
                Width="52"
                Height="52"
                Padding="4"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderBrush="{DynamicResource CrfTileBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Cursor="Hand"
                Classes.armed="{Binding #TileRoot.IsArmed}">
            <ctrl:PaletteGlyphControl Kind="{Binding Item.Kind}" Width="44" Height="44"/>
        </Border>

        <!-- Type label underneath — DisplayName, truncated if long -->
        <TextBlock Text="{Binding Item.DisplayName}"
                   FontSize="10"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="60"
                   HorizontalAlignment="Center"/>
    </StackPanel>

</UserControl>
