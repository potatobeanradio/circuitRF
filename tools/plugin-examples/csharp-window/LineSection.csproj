<Project Sdk="Microsoft.NET.Sdk">

  <!-- A circuitRF plugin with its own window, published with NativeAOT to one native program per platform.
       It references nothing in the circuitRF repository: copied anywhere, it builds the same. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>line-section</AssemblyName>
    <RootNamespace>LineSectionPlugin</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Warn at build time about anything NativeAOT would trim away, rather than fail at run time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
  </ItemGroup>

</Project>
