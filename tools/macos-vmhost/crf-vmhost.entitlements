<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to create a virtual machine at all. Without it the process is killed the moment it
         calls into Virtualization.framework, with no useful diagnostic. -->
    <key>com.apple.security.virtualization</key>
    <true/>
</dict>
</plist>
