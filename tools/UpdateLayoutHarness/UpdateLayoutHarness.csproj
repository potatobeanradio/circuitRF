<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UpdateLayoutHarness — runs Design ▸ Update Layout from Schematic the way the GUI runs it (the workspace view
    model's own command path, its preferences, its Messages), headlessly, over a scripted session of schematic and
    layout edits, and saves each layout it is asked to. Not part of the application and NOT in circuitRF.slnx, so a
    plain `dotnet build` neither builds it nor restores Avalonia.Headless. Usage in README.md beside this file.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ui\CircuitRF.Ui.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.3" />
  </ItemGroup>

</Project>
