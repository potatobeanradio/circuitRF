    {
      "InstanceName": "MeasInput",
      "Symbol": "Meas",
      "X": -2000,
      "Y": 1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pin_avail_dBm",
          "Expression": "Pin                                        ; the sweep variable itself",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pin_deliv_W",
          "Expression": "real(0.5*HB1.V(\u0022Vin\u0022,1)*conj(HB1.I(\u0022Iin\u0022,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pin_deliv_dBm",
          "Expression": "10*log10(Pin_deliv_W*1000)                 ; a measure may use an earlier one",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IRL_dB",
          "Expression": "Pin_deliv_dBm - Pin_avail_dBm              ; input return loss",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasOutput",
      "Symbol": "Meas",
      "X": -2000,
      "Y": 2300,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pout_W",
          "Expression": "real(0.5*HB1.V(\u0022Vout\u0022,1)*conj(HB1.I(\u0022Iout\u0022,1)))  ; V and I at the FUNDAMENTAL",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_dBm",
          "Expression": "10*log10(Pout_W*1000)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gp_dB",
          "Expression": "Pout_dBm - Pin_deliv_dBm                   ; power gain",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gt_dB",
          "Expression": "Pout_dBm - Pin_avail_dBm                   ; transducer gain",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasEfficiency",
      "Symbol": "Meas",
      "X": 1700,
      "Y": 2400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "PDC_W",
          "Expression": "real(HB1.V(\u0022VDD\u0022,0)*HB1.I(\u0022IDC\u0022,0))           ; harmonic 0 is DC",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Eff",
          "Expression": "Pout_W/PDC_W*100                              ; drain efficiency, %",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE",
          "Expression": "(Pout_W - Pin_deliv_W)/PDC_W*100              ; power-added efficiency, %",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasHarmonics",
      "Symbol": "Meas",
      "X": 1700,
      "Y": 1500,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Vout_2f0_dBc",
          "Expression": "dB(HB1.V(\u0022Vout\u0022,2)/HB1.V(\u0022Vout\u0022,1))   ; dB() broadcasts over a cube; abs() does NOT",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Vout_3f0_dBc",
          "Expression": "dB(HB1.V(\u0022Vout\u0022,3)/HB1.V(\u0022Vout\u0022,1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Vout_pk",
          "Expression": "mag(HB1.V(\u0022Vout\u0022,1))                       ; mag(), not abs()",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Zin",
          "Expression": "HB1.V(\u0022Vin\u0022,1)/HB1.I(\u0022Iin\u0022,1)                  ; complex - plots on a Smith chart",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "VAR1",
      "Symbol": "Var",
      "X": -2200,
      "Y": -200,
      "Rotation": "R0",
      "MirrorX": false,
