        {
          "Name": "I[1,0]",
          "Expression": "_v1/50\u002BPeriphery_mm*Isg*(if(_v1/Vtg\u003C40,exp(_v1/Vtg),exp(40)*(1\u002B_v1/Vtg-40))-1)-Periphery_mm*Ibk*if((_v2-_v1-Vbr)/Vbk\u003C40,exp((_v2-_v1-Vbr)/Vbk),exp(40)*(1\u002B(_v2-_v1-Vbr)/Vbk-40))",
          "Unit": "",
          "ShowOnSchematic": false,
          "Dimension": "None"
        },
        {
          "Name": "I[2,0]",
          "Expression": "Periphery_mm*(B*TC*tanh(_v2*a*(tanh(g*(TV0-_v1\u002B_v2*th\u002BSc*ln(exp(-(Sv-_v1)/Sc)\u002B1)))\u002B1))*ln(exp(-(2*TV0-2*_v1\u002B2*_v2*th\u002B2*Sc*ln(exp(-(Sv-_v1)/Sc)\u002B1))/TC)\u002B1)*(_v2*lam\u002B1))/2\u002BPeriphery_mm*Ibk*if((_v2-_v1-Vbr)/Vbk\u003C40,exp((_v2-_v1-Vbr)/Vbk),exp(40)*(1\u002B(_v2-_v1-Vbr)/Vbk-40))",
          "Unit": "",
          "ShowOnSchematic": false,
          "Dimension": "None"
        },
        {
          "Name": "I[1,1]",
          "Expression": "Periphery_mm*(Cgsp*_v1\u002BCgs0/2*(_v1\u002Bln(cosh(Kgs*(_v1-Vgs0)))/Kgs))",
          "Unit": "",
          "ShowOnSchematic": false,
          "Dimension": "None"
        },
        {
          "Name": "I[2,1]",
          "Expression": "Periphery_mm*(Cdsm*_v2\u002B(Cds0-Cdsm)*Vds0*(1-exp(-_v2/Vds0)))",
          "Unit": "",
          "ShowOnSchematic": false,
          "Dimension": "None"
        },
        {
