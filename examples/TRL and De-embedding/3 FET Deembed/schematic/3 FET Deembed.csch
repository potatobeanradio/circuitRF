    {
      "InstanceName": "MEAS1",
      "Symbol": "Meas",
      "X": 0,
      "Y": 7000,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Id_deembedded_mA",
          "Expression": "DC1.I(\"ID1\")*1e3   ; the drain current, through the Deembed",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y11_deembedded",
          "Expression": "((1-SP1.S(1,1))*(1+SP1.S(2,2)) + SP1.S(1,2)*SP1.S(2,1))/(50*((1+SP1.S(1,1))*(1+SP1.S(2,2)) - SP1.S(1,2)*SP1.S(2,1)))   ; Y from S, Z0 = 50 ohm. Ports 1 and 2 see the device de-embedded",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y12_deembedded",
          "Expression": "-2*SP1.S(1,2)/(50*((1+SP1.S(1,1))*(1+SP1.S(2,2)) - SP1.S(1,2)*SP1.S(2,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y21_deembedded",
          "Expression": "-2*SP1.S(2,1)/(50*((1+SP1.S(1,1))*(1+SP1.S(2,2)) - SP1.S(1,2)*SP1.S(2,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y22_deembedded",
          "Expression": "((1+SP1.S(1,1))*(1-SP1.S(2,2)) + SP1.S(1,2)*SP1.S(2,1))/(50*((1+SP1.S(1,1))*(1+SP1.S(2,2)) - SP1.S(1,2)*SP1.S(2,1)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Cgs_pF_deembedded",
          "Expression": "imag(Y11_deembedded + Y12_deembedded)/(2*pi*freq)*1e12",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Cgd_pF_deembedded",
          "Expression": "-imag(Y12_deembedded)/(2*pi*freq)*1e12",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "gm_mS_deembedded",
          "Expression": "abs(Y21_deembedded - Y12_deembedded)*1e3",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rds_deembedded",
          "Expression": "1/real(Y22_deembedded + Y12_deembedded)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y11_raw",
          "Expression": "((1-SP1.S(3,3))*(1+SP1.S(4,4)) + SP1.S(3,4)*SP1.S(4,3))/(50*((1+SP1.S(3,3))*(1+SP1.S(4,4)) - SP1.S(3,4)*SP1.S(4,3)))   ; ports 3 and 4 see it as measured",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y12_raw",
          "Expression": "-2*SP1.S(3,4)/(50*((1+SP1.S(3,3))*(1+SP1.S(4,4)) - SP1.S(3,4)*SP1.S(4,3)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y21_raw",
          "Expression": "-2*SP1.S(4,3)/(50*((1+SP1.S(3,3))*(1+SP1.S(4,4)) - SP1.S(3,4)*SP1.S(4,3)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Y22_raw",
          "Expression": "((1+SP1.S(3,3))*(1-SP1.S(4,4)) + SP1.S(3,4)*SP1.S(4,3))/(50*((1+SP1.S(3,3))*(1+SP1.S(4,4)) - SP1.S(3,4)*SP1.S(4,3)))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Cgs_pF_raw",
          "Expression": "imag(Y11_raw + Y12_raw)/(2*pi*freq)*1e12",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Cgd_pF_raw",
          "Expression": "-imag(Y12_raw)/(2*pi*freq)*1e12",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "gm_mS_raw",
          "Expression": "abs(Y21_raw - Y12_raw)*1e3",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rds_raw",
          "Expression": "1/real(Y22_raw + Y12_raw)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Vgs_intrinsic",
          "Expression": "HB1.V(\"vg1\",1)   ; at the intrinsic plane: the Deembed's pin 1",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Ig_intrinsic",
          "Expression": "HB1.I(\"IG1\",1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Vds_intrinsic",
          "Expression": "HB1.V(\"vd1\",1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Id_intrinsic",
          "Expression": "HB1.I(\"ID1\",1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pout_intrinsic_W",
          "Expression": "-real(0.5*Vds_intrinsic*conj(Id_intrinsic))   ; delivered by the intrinsic device",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
  ],
