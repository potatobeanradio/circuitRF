      "X": -5200,
      "Y": 1900,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pbb_dBm",
          "Expression": "Pbb                                  ; drive per tone, into measurement scope",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pc1_dBm",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(1,0,1)\u0022)) \u002B 6.9897",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pc2_dBm",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(0,1,1)\u0022)) \u002B 6.9897",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Ptot_W",
          "Expression": "( mag(HB1.V(\u0022ant\u0022,\u0022(1,0,1)\u0022))*mag(HB1.V(\u0022ant\u0022,\u0022(1,0,1)\u0022)) \u002B mag(HB1.V(\u0022ant\u0022,\u0022(0,1,1)\u0022))*mag(HB1.V(\u0022ant\u0022,\u0022(0,1,1)\u0022)) )/200",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Ptot_dBm",
          "Expression": "10*log10(Ptot_W*1000)                ; both carriers together",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gain_dB",
          "Expression": "(Pc1_dBm - Pbb_dBm)                  ; baseband in to antenna",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pmod_dBm",
          "Expression": "dB(HB1.V(\u0022rfsum\u0022,\u0022(1,0,1)\u0022)) \u002B 10",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "GainRF_dB",
          "Expression": "(Pc1_dBm - Pmod_dBm)                 ; modulator out to antenna",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
