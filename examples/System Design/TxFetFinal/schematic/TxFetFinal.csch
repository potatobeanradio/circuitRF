      "Parameters": [
        {
          "Name": "Ppa_W",
          "Expression": "real(0.5*HB1.V(\u0022drn\u0022,\u0022(1,0)\u0022)*conj(HB1.I(\u0022Iout\u0022,\u0022(1,0)\u0022))) \u002B real(0.5*HB1.V(\u0022drn\u0022,\u0022(0,1)\u0022)*conj(HB1.I(\u0022Iout\u0022,\u0022(0,1)\u0022)))  ; RF out of the drain, BOTH carriers",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pin_W",
          "Expression": "real(0.5*HB1.V(\u0022gate\u0022,\u0022(1,0)\u0022)*conj(HB1.I(\u0022Iin\u0022,\u0022(1,0)\u0022))) \u002B real(0.5*HB1.V(\u0022gate\u0022,\u0022(0,1)\u0022)*conj(HB1.I(\u0022Iin\u0022,\u0022(0,1)\u0022)))  ; drive INTO the FET gate",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PDC_W",
          "Expression": "real(HB1.V(\u0022VDD\u0022,\u0022(0,0)\u0022)*HB1.I(\u0022IDC\u0022,\u0022(0,0)\u0022))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PAE_pct",
          "Expression": "(Ppa_W - Pin_W)/PDC_W*100              ; PAE at the DEVICE: RF added, over DC drawn",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "H2_dBc",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(2,0)\u0022)/HB1.V(\u0022ant\u0022,\u0022(1,0)\u0022))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasTR",
      "Symbol": "Meas",
      "X": 1000,
      "Y": 2200,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Prx1_dBm",
          "Expression": "dB(HB1.V(\u0022rxport\u0022,\u0022(1,0)\u0022)) \u002B 10     ; the receiver port, on transmit",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "TRiso_dB",
          "Expression": "(Pc1_dBm - Prx1_dBm)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasLin",
      "Symbol": "Meas",
      "X": -1000,
      "Y": 2200,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pim3_dBm",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(2,-1)\u0022)) \u002B 6.9897",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IM3_dBc",
          "Expression": "(Pc1_dBm - Pim3_dBm)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "OIP3_dBm",
          "Expression": "Pc1_dBm \u002B IM3_dBc/2",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
