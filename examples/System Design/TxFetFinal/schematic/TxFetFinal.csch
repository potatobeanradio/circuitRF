    {
      "InstanceName": "MeasOut",
      "Symbol": "Meas",
      "X": -5000,
      "Y": 2200,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "Pdrv_dBm",
          "Expression": "Pdrv                                 ; drive per tone, into measurement scope",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pc1_dBm",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(1,0)\u0022)) \u002B 6.9897",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pc2_dBm",
          "Expression": "dB(HB1.V(\u0022ant\u0022,\u0022(0,1)\u0022)) \u002B 6.9897",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Ptot_W",
          "Expression": "( mag(HB1.V(\u0022ant\u0022,\u0022(1,0)\u0022))*mag(HB1.V(\u0022ant\u0022,\u0022(1,0)\u0022)) \u002B mag(HB1.V(\u0022ant\u0022,\u0022(0,1)\u0022))*mag(HB1.V(\u0022ant\u0022,\u0022(0,1)\u0022)) )/200",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Ptot_dBm",
          "Expression": "10*log10(Ptot_W*1000)                ; both carriers together",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gain_dB",
          "Expression": "(Pc1_dBm - Pdrv_dBm)                 ; two System stages plus the FET",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MeasPA",
      "Symbol": "Meas",
