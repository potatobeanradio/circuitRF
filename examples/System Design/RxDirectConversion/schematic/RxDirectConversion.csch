      "Parameters": [
        {
          "Name": "Prf_dBm",
          "Expression": "Prf                                  ; drive per carrier, into measurement scope",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pbb1_dBm",
          "Expression": "dB(HB1.V(\u0022bbio\u0022,\u0022(1,0,-1)\u0022)) \u002B 10",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Pbb2_dBm",
          "Expression": "dB(HB1.V(\u0022bbio\u0022,\u0022(0,1,-1)\u0022)) \u002B 10",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gain_dB",
          "Expression": "(Pbb1_dBm - Prf_dBm)                 ; antenna to I baseband",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "PbbQ_dBm",
          "Expression": "dB(HB1.V(\u0022bbqo\u0022,\u0022(1,0,-1)\u0022)) \u002B 10",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "IQbal_dB",
          "Expression": "(Pbb1_dBm - PbbQ_dBm)                ; I against Q",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
