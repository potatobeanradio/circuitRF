    {
      "InstanceName": "VAR1",
      "Symbol": "Var",
      "X": 0,
      "Y": -1700,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "temp",
          "Expression": "16.85",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "L_dB",
          "Expression": "3",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "K",
          "Expression": "10^(L_dB/20)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rsh",
          "Expression": "50*(K \u002B 1)/(K - 1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rse",
          "Expression": "50*(K*K - 1)/(2*K)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "GA_dB",
          "Expression": "16",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "NFminA_dB",
          "Expression": "0.8",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "GoptA",
          "Expression": "polar(0.25, 45)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "rnA",
          "Expression": "0.25",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "GB_dB",
          "Expression": "12",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "NFB_dB",
          "Expression": "3",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    },
    {
      "InstanceName": "MEAS1",
      "Symbol": "Meas",
      "X": 1900,
      "Y": -1400,
      "Rotation": "R0",
      "MirrorX": false,
      "Disable": "None",
      "Parameters": [
        {
          "Name": "FA",
          "Expression": "pow(10, NFminA_dB/10) \u002B 4*rnA*mag(GoptA)*mag(GoptA)/(mag(1 \u002B GoptA)*mag(1 \u002B GoptA))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "GA",
          "Expression": "pow(10, GA_dB/10)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "FB",
          "Expression": "pow(10, NFB_dB/10)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "L",
          "Expression": "pow(10, L_dB/10)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "NF_friis",
          "Expression": "10*log10(FA \u002B (L - 1)/GA \u002B (FB - 1)*L/GA)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "NF_padfirst",
          "Expression": "10*log10(L*FA \u002B (FB - 1)*L/GA)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gain_dB",
          "Expression": "dB(SP1.S(2,1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Gain_sum",
          "Expression": "GA_dB - L_dB \u002B GB_dB",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
  ],
