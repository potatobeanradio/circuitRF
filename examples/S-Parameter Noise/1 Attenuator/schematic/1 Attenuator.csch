          "Dimension": "None"
        },
        {
          "Name": "NF_closed",
          "Expression": "10*log10(1 \u002B (T_K/290)*(pow(10, L_dB/10) - 1))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Tn",
          "Expression": "real(SP1.Cs(2,2))/1.380649e-23",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Tn_closed",
          "Expression": "T_K*(1 - pow(10, -L_dB/10))",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
    }
