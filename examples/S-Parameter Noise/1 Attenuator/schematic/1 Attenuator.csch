        },
        {
          "Name": "K",
          "Expression": "10^(L_dB/20)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rsh",
          "Expression": "50*(K \u002B 1)/(K - 1)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        },
        {
          "Name": "Rse",
          "Expression": "50*(K*K - 1)/(2*K)",
          "Unit": "",
          "ShowOnSchematic": true,
          "Dimension": "None"
        }
      ]
