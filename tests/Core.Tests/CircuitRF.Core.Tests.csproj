<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\CircuitRF.Core.csproj" />
  </ItemGroup>

  <!--
    The reference device worker is built alongside these tests and launched as a real child process,
    so the process transport is exercised the way it actually runs. ReferenceOutputAssembly is false
    because nothing here links against it - it is only ever started.

    Its location is recorded as assembly metadata rather than derived from the test's own output
    folder, which would be a relative-path guess that breaks the first time a layout changes.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\DeviceWorkerExample\DeviceWorkerExample.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DeviceWorkerExampleDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\tools\DeviceWorkerExample\bin\$(Configuration)\net10.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>