<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      TreatWarningsAsErrors is intentionally OFF for the test project so that
      framework-generated partial classes (xunit) don't fail the build.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- CommunityToolkit.Mvvm needed because SchematicViewModel is ObservableObject -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Reference Ui project. Only framework-free classes are under test:
    SchematicEditModel, commands, SchematicHitTest, WireGeometry, SchematicPersistence.
    Tests must NOT call any Avalonia runtime APIs.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ui\CircuitRF.Ui.csproj" />
  </ItemGroup>

  <!--
    The CLI, built alongside these tests so `Cli em` can be run as a real process (brief-cli-em-verb.md
    gate 3). Its output directory is recorded as assembly metadata and the DLL is exec'd DIRECTLY: a
    `dotnet run` on src/Cli would start a nested MSBuild inside a `dotnet test` that already holds the
    build locks, which deadlocks.

    RND-2 made it a LINKED reference as well (it was ReferenceOutputAssembly="false"), because two of
    `render`'s gates are about what happens INSIDE one process - a cancellation delivered through
    RunHost, and a layer selection leaking into a second render through a shared cached Technology -
    and neither can be observed by launching a process that answers one command and exits. Every
    byte-identity gate still launches the real DLL; see src/Cli.Verbs/CircuitRF.Cli.Verbs.csproj for the
    InternalsVisibleTo grant this needs.

    Copied verbatim from tests/Engine.Tests/CircuitRF.Engine.Tests.csproj, which learned all of this
    first (see MatchStampTests.ACnlContainingAMatch_RunsHeadlessUnderCliSparam). Re-derived here the
    hard way before that note was found - the hang is silent, with no CPU and no child process, and
    looks exactly like a slow EM solve.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Cli\CircuitRF.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CliDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../src/Cli/bin/$(Configuration)/net10.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The reference device worker, built alongside these tests and launched as a real child process -
    the same arrangement Core.Tests already has, for a different reason. `circuitrf serve` may write
    NOTHING to stdout but its own protocol framing (brief-automation-5-protocol-adapter.md R-aut5-2),
    and a device worker is the loudest thing this program runs: it is a second process, it logs, and
    its output is forwarded. Auditing that with a fake would audit the fake.

    ReferenceOutputAssembly is false because nothing here links against it - it is only ever started.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\DeviceWorkerExample\DeviceWorkerExample.csproj"
                      ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DeviceWorkerExampleDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\tools\DeviceWorkerExample\bin\$(Configuration)\net10.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Copy Default.ccolor preset so ColorThemeTests can load it from AppContext.BaseDirectory. -->
  <ItemGroup>
    <Content Include="..\..\src\Render\Assets\Color\Default.ccolor" CopyToOutputDirectory="PreserveNewest">
      <Link>Default.ccolor</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Pins this assembly to en-US before any test runs, so assertions stop depending on the
         runner's OS locale (brief-localization-groundwork.md R-loc-4). Shared by all seven test
         projects; see tests/TestCulture.cs for why it is a ModuleInitializer. -->
    <Compile Include="../TestCulture.cs" Link="TestCulture.cs" />
  </ItemGroup>

</Project>
