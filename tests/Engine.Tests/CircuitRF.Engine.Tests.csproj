<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="PureHDF" Version="2.1.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Engine/CircuitRF.Engine.csproj" />
    <ProjectReference Include="../../src/Core/CircuitRF.Core.csproj" />
  </ItemGroup>

  <!--
    The reference device worker, run as a real child process so an analysis can be solved end to end
    through one. Nothing here links against it - it is only ever started.
  -->
  <ItemGroup>
    <ProjectReference Include="../../tools/DeviceWorkerExample/DeviceWorkerExample.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The CLI, built alongside these tests so `Cli sparam` can be run as a real process. Nothing here
    links against it - it is only ever launched. Its output directory is recorded as assembly
    metadata and the DLL is exec'd DIRECTLY: a `dotnet run` on src/Cli would start a nested
    MSBuild inside a `dotnet test` that already holds the build locks, which deadlocks.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Cli/CircuitRF.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CliDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../src/Cli/bin/$(Configuration)/net10.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DeviceWorkerExampleDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../tools/DeviceWorkerExample/bin/$(Configuration)/net10.0</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
