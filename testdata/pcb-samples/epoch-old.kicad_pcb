(kicad_pcb (version 20171130) (host "board-editor" "(5.1.0)")
  (layers
    (0 top_layer signal)
    (31 bottom_layer signal)
    (37 F.SilkS user)
    (36 B.SilkS user)
    (44 Edge.Cuts user)
    (39 F.Mask user)
    (38 B.Mask user)
  )
  (general (thickness 1.6))
