  (net 0 "")
  (net 3 SIGNAL)
  (gr_line (start 0 0) (end 4 3) (width 0.2) (layer top_layer))
  (gr_arc (start 10 10) (end 12 10) (angle 90) (width 0.15) (layer F.SilkS))
  (segment (start 1 1) (end 2 2) (width 0.25) (layer top_layer) (net 3))
