; hero1.cnl — Hero 1: 4-port linear network embedding a non-reciprocal 2-port SnP block.
; Sweep 1-3 GHz (inside the .s2p's 1-5 GHz range). Embedded block is internal (a1<->a2);
; the 4 external ports are built by the surrounding RLC.

Port:Term1  p1 0  Num=1 Z=50 Ohm
Port:Term2  p2 0  Num=2 Z=50 Ohm
Port:Term3  p3 0  Num=3 Z=50 Ohm
Port:Term4  p4 0  Num=4 Z=50 Ohm

L:L1   p1   a1   L=3.3 nH
C:C1   a1   0    C=1.5 pF

SnP:X1  a1 a2  NumPorts=2 File="potentially_unstable_amp.s2p" Type="touchstone" InterpMode="linear" InterpDomain="RI" ExtrapMode="clamp"

L:L2   a2   p2   L=2.7 nH
C:C2   p2   0    C=1.0 pF

C:C3   p3   a1   C=1.5 pF
R:R3   p3   0    R=200 Ohm

L:L4   p4   a2   L=1.8 nH
R:R4   p4   0    R=150 Ohm

C:C5   a1   a2   C=0.2 pF