    crfp[] = Volume In BoundingBox{crfx0 - e, crfy0 - e, crfz0 - e, crfx1 + e, crfy1 + e, crfz1 + e};
    crfo[] = crfp[];
    crfo[] -= made[];
    crfp[] -= crfo[];
    made[] -= crfp[];
  EndIf
Return
