// conductor floor
c0[] = Surface In BoundingBox{-12000 - e, -11000 - e, -1000 - e, 12000 + e, 11000 + e, 0 + e};
x[] = c0[];
x[] -= voids[];
c0[] -= x[];
c0[] -= claimed[];
claimed[] += c0[];
// conductor lid
c6[] = Surface In BoundingBox{-12000 - e, -11000 - e, 4000 - e, 12000 + e, 11000 + e, 5000 + e};
x[] = c6[];
x[] -= voids[];
c6[] -= x[];
c6[] -= claimed[];
claimed[] += c6[];
// conductors floor, wall_w, wall_e, wall_s, wall_n, lid, touching: what their boxes left
y[] = Surface In BoundingBox{-12000 - e, -11000 - e, -1000 - e, 12000 + e, 11000 + e, 5000 + e};
x[] = y[];
x[] -= voids[];
y[] -= x[];
y[] -= claimed[];
c0[] += y[];
claimed[] += y[];
rest[] = single[];
rest[] -= claimed[];

// ---- physical groups: attributes are circuitRF's (groups.json) --------------------------
Physical Surface("floor", 1) = {c0[]};
Physical Volume("substrate", 2) = {s1[]};
Physical Surface("wall_w", 3) = {c2[]};
Physical Surface("wall_e", 4) = {c3[]};
Physical Surface("wall_s", 5) = {c4[]};
