// ---- the initial mesh: Palace's adaptive refinement converges the answer ------------------
// Largest element per material: 0.1 of its wavelength at 16 GHz (twice the eigenmode target);
// 1 of the smallest at conductors and sheets; at most 1/4 of each port
// sheet's smaller side at the ports; growing by 1.3.
Mesh.MeshSizeMax = 1873.7028625;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromCurvature = 12;
Field[1] = Constant; Field[1].VIn = 1263.250212194; Field[1].VolumesList = {s1[]};
Field[2] = Constant; Field[2].VIn = 1873.7028625; Field[2].VolumesList = {bg[]};
Field[3] = Distance; Field[3].SurfacesList = {c0[], c2[], c3[], c4[], c5[], c6[], c7[], w0[]}; Field[3].Sampling = 50;
Field[4] = Threshold; Field[4].InField = 3; Field[4].SizeMin = 1263.250212194; Field[4].SizeMax = 1873.7028625; Field[4].DistMin = 1263.250212194; Field[4].DistMax = 3298.09237988;
Field[5] = Distance; Field[5].SurfacesList = {q0[], q1[]}; Field[5].Sampling = 50;
Field[6] = Threshold; Field[6].InField = 5; Field[6].SizeMin = 63.5; Field[6].SizeMax = 1873.7028625; Field[6].DistMin = 63.5; Field[6].DistMax = 6097.509541667;
Field[7] = Min; Field[7].FieldsList = {1, 2, 4, 6};
