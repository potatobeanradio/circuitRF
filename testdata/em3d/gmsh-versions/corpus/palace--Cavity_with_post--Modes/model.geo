// Generated by circuitRF for Palace (brief-em3d-7). Do not edit: circuitRF rewrites this file from
// the setup, and an unchanged file reuses the mesh beside it. Units: micrometres (Palace L0 = 1e-6).
// Run by circuitRF as:  gmsh model.geo -3 -o model.msh    (writes entities.txt beside it)

SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Geometry.OCCBoundsUseStl = 1;
e = 0.001;

Macro CrfMap
  crft = StrCat(crfn, "[] = {");
  For crfi In {0:#crfl[]-1}
    crfr = 0;
    For crfk In {0:#frag[]-1}
      If (frag[crfk] < crfl[crfi])
        crfr += 1;
      EndIf
    EndFor
    If (crfi)
      crft = StrCat(crft, ", ");
    EndIf
    crft = StrCat(crft, Sprintf("crfb[%g]", crfr));
  EndFor
  Printf(StrCat(crft, "};")) >> "built-83261bac75752ff2.map";
Return
If (!FileExists("built-83261bac75752ff2.map"))
// ---- solids, in construction order -------------------------------------------------------
// floor: Conductor, Aluminium, order 1
v = newv; Box(v) = {-12000, -11000, -1000, 24000, 22000, 1000};
s0[] = {v};
// substrate: Dielectric, PTFE-glass laminate, order 2
v = newv; Box(v) = {-11000, -10000, 0, 22000, 20000, 254};
s1[] = {v};
// wall_w: Conductor, Aluminium, order 4
v = newv; Box(v) = {-12000, -11000, 0, 1000, 22000, 4000};
s2[] = {v};
// wall_e: Conductor, Aluminium, order 5
v = newv; Box(v) = {11000, -11000, 0, 1000, 22000, 4000};
s3[] = {v};
// wall_s: Conductor, Aluminium, order 6
v = newv; Box(v) = {-11000, -11000, 0, 22000, 1000, 4000};
s4[] = {v};
// wall_n: Conductor, Aluminium, order 7
v = newv; Box(v) = {-11000, 10000, 0, 22000, 1000, 4000};
s5[] = {v};
// lid: Conductor, Aluminium, order 8
v = newv; Box(v) = {-12000, -11000, 4000, 24000, 22000, 1000};
s6[] = {v};
// post: Conductor, Aluminium, order 9
v = newv; Cylinder(v) = {0, 2440, 0, 0, 0, 4000, 1250};
s7[] = {v};

// ---- disjoint by construction order: each solid loses what a higher-order solid takes -----
// metal takes precedence over dielectric: every metal is ranked above every dielectric (em-3d.md §6.3a)
s1[] = BooleanDifference{ Volume{s1[]}; }{ Volume{s7[]}; };

// ---- the air box, and the background: what no solid claims inside it --------------------
bx = newv; Box(bx) = {-12000, -11000, -1000, 24000, 22000, 6000};
bg[] = BooleanDifference{ Volume{bx}; }{ Volume{s0[], s1[], s2[], s3[], s4[], s5[], s6[], s7[]}; };

// ---- sheets and port sheets --------------------------------------------------------------
// sheet line: Perfect conductor, 0 um thick
cl[] = {};
p = newp;
Point(p + 0) = {-10800, -390, 254};
Point(p + 1) = {10800, -390, 254};
Point(p + 2) = {10800, 390, 254};
Point(p + 3) = {-10800, 390, 254};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
h0[] = {s};
// port/1: from floor to line
p = newp;
Point(p + 0) = {-10800, -390, 0};
Point(p + 1) = {-10800, 390, 0};
Point(p + 2) = {-10800, 390, 254};
Point(p + 3) = {-10800, -390, 254};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p0[] = {s};
// port/2: from floor to line
p = newp;
Point(p + 0) = {10800, -390, 0};
Point(p + 1) = {10800, 390, 0};
Point(p + 2) = {10800, 390, 254};
Point(p + 3) = {10800, -390, 254};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p1[] = {s};

// ---- one fragment: imprints the shared faces and the sheets, splits no volume -------------
frag[] = BooleanFragments{ Volume{s1[], bg[]}; }{ Surface{h0[], p0[], p1[]}; };
If (#frag[] == 0)
  frag[] = {s1[], bg[]};
EndIf
crfv[] = Volume{:};
crfx[] = frag[];
crfx[] -= crfv[];
frag[] -= crfx[];
crfs = #frag[] != (#s1[] + #bg[]);
crfj = 0;
crfc = #s1[];
If (crfs)
  crfq[] = BooleanFragments{ Volume{s1[]}; }{ Surface{h0[], p0[], p1[]}; };
  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
s1[] = {};
For crfi In {0:crfc-1}
  s1[] += frag[crfj + crfi];
EndFor
crfj += crfc;
crfc = #bg[];
If (crfs)
  crfq[] = BooleanFragments{ Volume{bg[]}; }{ Surface{h0[], p0[], p1[]}; };
  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
bg[] = {};
For crfi In {0:crfc-1}
  bg[] += frag[crfj + crfi];
EndFor
crfj += crfc;
Hide {:}
Recursive Show { Volume{frag[]}; }
Geometry.OCCExportOnlyVisible = 1;
Save "built-83261bac75752ff2.brep";
Printf("// which of built-83261bac75752ff2.brep's volumes each list holds") > "built-83261bac75752ff2.map";
crfn = "s1"; crfl[] = s1[];
Call CrfMap;
crfn = "bg"; crfl[] = bg[];
Call CrfMap;
Printf("crfBuiltComplete = 1;") >> "built-83261bac75752ff2.map";
Delete Model;
EndIf
crfb[] = ShapeFromFile("built-83261bac75752ff2.brep");
Include "built-83261bac75752ff2.map";
allV[] = Volume{:};
allS[] = Surface{:};
single[] = CombinedBoundary{ Volume{allV[]}; };
For k In {0:#single[]-1}
  single[k] = Abs(single[k]);
EndFor
claimed[] = {};

// ---- surfaces, recovered by what circuitRF placed; each face claimed once ------------------
