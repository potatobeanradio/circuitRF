// sheet line
w0[] = Surface In BoundingBox{-10800 - e, -390 - e, 254 - e, 10800 + e, 390 + e, 254 + e};
w0[] -= claimed[];
claimed[] += w0[];
voids[] = single[];
voids[] -= claimed[];
// conductor post
c7[] = Surface In BoundingBox{-1250 - e, 1190 - e, 0 - e, 1250 + e, 3690 + e, 4000 + e};
x[] = c7[];
x[] -= voids[];
c7[] -= x[];
