f3[] = Surface In BoundingBox{-12000 - e, 11000 - e, -1000 - e, 12000 + e, 11000 + e, 5000 + e};
f3[] -= claimed[];
claimed[] += f3[];
// air box zmin
f4[] = Surface In BoundingBox{-12000 - e, -11000 - e, -1000 - e, 12000 + e, 11000 + e, -1000 + e};
f4[] -= claimed[];
claimed[] += f4[];
// air box zmax
f5[] = Surface In BoundingBox{-12000 - e, -11000 - e, 5000 - e, 12000 + e, 11000 + e, 5000 + e};
f5[] -= claimed[];
claimed[] += f5[];
// port/1
q0[] = Surface In BoundingBox{-10800 - e, -390 - e, 0 - e, -10800 + e, 390 + e, 254 + e};
q0[] -= claimed[];
claimed[] += q0[];
// port/2
q1[] = Surface In BoundingBox{10800 - e, -390 - e, 0 - e, 10800 + e, 390 + e, 254 + e};
q1[] -= claimed[];
