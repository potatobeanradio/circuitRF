  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
bg[] = {};
For crfi In {0:crfc-1}
  bg[] += frag[crfj + crfi];
EndFor
crfj += crfc;
Hide {:}
Recursive Show { Volume{frag[]}; }
Geometry.OCCExportOnlyVisible = 1;
Save "built-938ba8482f2de99b.brep";
