// ---- the initial mesh: Palace's adaptive refinement converges the answer ------------------
// Largest element per material: 0.1 of its wavelength at 40 GHz (twice the eigenmode target);
// 1 of the smallest at conductors and sheets; at most 1/4 of each port
// sheet's smaller side at the ports; growing by 1.3.
Mesh.MeshSizeMax = 749.481145;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromCurvature = 12;
Field[1] = Constant; Field[1].VIn = 239.412969725; Field[1].VolumesList = {s1[]};
