// Generated by circuitRF for Palace (brief-em3d-7). Do not edit: circuitRF rewrites this file from
// the setup, and an unchanged file reuses the mesh beside it. Units: micrometres (Palace L0 = 1e-6).
// Run by circuitRF as:  gmsh model.geo -3 -o model.msh    (writes entities.txt beside it)

SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Geometry.OCCBoundsUseStl = 1;
e = 0.001;

Macro CrfMap
  crft = StrCat(crfn, "[] = {");
  For crfi In {0:#crfl[]-1}
    crfr = 0;
    For crfk In {0:#frag[]-1}
      If (frag[crfk] < crfl[crfi])
        crfr += 1;
      EndIf
    EndFor
    If (crfi)
      crft = StrCat(crft, ", ");
    EndIf
    crft = StrCat(crft, Sprintf("crfb[%g]", crfr));
  EndFor
  Printf(StrCat(crft, "};")) >> "built-b0716e99df2b2985.map";
Return
If (!FileExists("built-b0716e99df2b2985.map"))
// ---- solids, in construction order -------------------------------------------------------
// RO4350: Dielectric, RO4350B, order 1
v = newv; Box(v) = {-3000, -4000, 35, 9000, 8000, 508};
s0[] = {v};
// air: Air, Air, order 2
v = newv; Box(v) = {-3000, -4000, 543, 9000, 8000, 3035};
s1[] = {v};
// Top Copper (1 oz)/A: Conductor, Copper, order 3
cl[] = {};
p = newp;
Point(p + 0) = {0, 500, 543};
Point(p + 1) = {3000, 500, 543};
Point(p + 2) = {3000, 1000, 543};
Point(p + 3) = {0, 1000, 543};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
bs[] = {s};
ex[] = Extrude {0, 0, 35} { Surface{bs[]}; };
s2[] = {ex[1]};
// Top Copper (1 oz)/B: Conductor, Copper, order 4
cl[] = {};
p = newp;
Point(p + 0) = {0, -1000, 543};
Point(p + 1) = {3000, -1000, 543};
Point(p + 2) = {3000, -500, 543};
Point(p + 3) = {0, -500, 543};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
bs[] = {s};
ex[] = Extrude {0, 0, 35} { Surface{bs[]}; };
s3[] = {ex[1]};
// via/1: Conductor, Copper, order 5
v = newv; Cylinder(v) = {2800, 750, 35, 0, 0, 543, 150};
s4[] = {v};
// via/2: Conductor, Copper, order 6
v = newv; Cylinder(v) = {2800, -750, 35, 0, 0, 543, 150};
s5[] = {v};

// ---- disjoint by construction order: each solid loses what a higher-order solid takes -----
s0[] = BooleanDifference{ Volume{s0[]}; }{ Volume{s4[], s5[]}; };
s1[] = BooleanDifference{ Volume{s1[]}; }{ Volume{s2[], s3[], s4[], s5[]}; };

// ---- the air box, and the background: what no solid claims inside it --------------------
bx = newv; Box(bx) = {-3000, -4000, 35, 9000, 8000, 3543};
bg[] = BooleanDifference{ Volume{bx}; }{ Volume{s0[], s1[], s2[], s3[], s4[], s5[]}; };

// ---- sheets and port sheets --------------------------------------------------------------
// port/1: from airbox/zmin to Top Copper (1 oz)/A
p = newp;
Point(p + 0) = {0, 500, 35};
Point(p + 1) = {0, 1000, 35};
Point(p + 2) = {0, 1000, 543};
Point(p + 3) = {0, 500, 543};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p0[] = {s};
// port/2: from airbox/zmin to Top Copper (1 oz)/B
p = newp;
Point(p + 0) = {0, -1000, 35};
Point(p + 1) = {0, -500, 35};
Point(p + 2) = {0, -500, 543};
Point(p + 3) = {0, -1000, 543};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p1[] = {s};

// ---- one fragment: imprints the shared faces and the sheets, splits no volume -------------
frag[] = BooleanFragments{ Volume{s0[], s1[], bg[]}; }{ Surface{p0[], p1[]}; };
If (#frag[] == 0)
  frag[] = {s0[], s1[], bg[]};
EndIf
crfv[] = Volume{:};
crfx[] = frag[];
crfx[] -= crfv[];
frag[] -= crfx[];
crfs = #frag[] != (#s0[] + #s1[] + #bg[]);
crfj = 0;
crfc = #s0[];
If (crfs)
  crfq[] = BooleanFragments{ Volume{s0[]}; }{ Surface{p0[], p1[]}; };
  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
s0[] = {};
For crfi In {0:crfc-1}
  s0[] += frag[crfj + crfi];
EndFor
crfj += crfc;
crfc = #s1[];
If (crfs)
  crfq[] = BooleanFragments{ Volume{s1[]}; }{ Surface{p0[], p1[]}; };
  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
s1[] = {};
For crfi In {0:crfc-1}
  s1[] += frag[crfj + crfi];
EndFor
crfj += crfc;
crfc = #bg[];
If (crfs)
  crfq[] = BooleanFragments{ Volume{bg[]}; }{ Surface{p0[], p1[]}; };
  crfv[] = Volume{:};
  crfo[] = crfq[];
  crfo[] -= crfv[];
  crfq[] -= crfo[];
  crfc = #crfq[];
EndIf
bg[] = {};
For crfi In {0:crfc-1}
  bg[] += frag[crfj + crfi];
EndFor
crfj += crfc;
Hide {:}
Recursive Show { Volume{frag[]}; }
Geometry.OCCExportOnlyVisible = 1;
Save "built-b0716e99df2b2985.brep";
Printf("// which of built-b0716e99df2b2985.brep's volumes each list holds") > "built-b0716e99df2b2985.map";
crfn = "s0"; crfl[] = s0[];
Call CrfMap;
crfn = "s1"; crfl[] = s1[];
Call CrfMap;
crfn = "bg"; crfl[] = bg[];
Call CrfMap;
Printf("crfBuiltComplete = 1;") >> "built-b0716e99df2b2985.map";
Delete Model;
EndIf
crfb[] = ShapeFromFile("built-b0716e99df2b2985.brep");
Include "built-b0716e99df2b2985.map";
allV[] = Volume{:};
allS[] = Surface{:};
single[] = CombinedBoundary{ Volume{allV[]}; };
For k In {0:#single[]-1}
  single[k] = Abs(single[k]);
EndFor
claimed[] = {};

// ---- surfaces, recovered by what circuitRF placed; each face claimed once ------------------
// port/1
q0[] = Surface In BoundingBox{0 - e, 500 - e, 35 - e, 0 + e, 1000 + e, 543 + e};
q0[] -= claimed[];
claimed[] += q0[];
// port/2
q1[] = Surface In BoundingBox{0 - e, -1000 - e, 35 - e, 0 + e, -500 + e, 543 + e};
q1[] -= claimed[];
claimed[] += q1[];
// air box xmin
f0[] = Surface In BoundingBox{-3000 - e, -4000 - e, 35 - e, -3000 + e, 4000 + e, 3578 + e};
f0[] -= claimed[];
claimed[] += f0[];
// air box xmax
f1[] = Surface In BoundingBox{6000 - e, -4000 - e, 35 - e, 6000 + e, 4000 + e, 3578 + e};
f1[] -= claimed[];
claimed[] += f1[];
// air box ymin
f2[] = Surface In BoundingBox{-3000 - e, -4000 - e, 35 - e, 6000 + e, -4000 + e, 3578 + e};
f2[] -= claimed[];
claimed[] += f2[];
// air box ymax
f3[] = Surface In BoundingBox{-3000 - e, 4000 - e, 35 - e, 6000 + e, 4000 + e, 3578 + e};
f3[] -= claimed[];
claimed[] += f3[];
// air box zmin
f4[] = Surface In BoundingBox{-3000 - e, -4000 - e, 35 - e, 6000 + e, 4000 + e, 35 + e};
f4[] -= claimed[];
claimed[] += f4[];
// air box zmax
f5[] = Surface In BoundingBox{-3000 - e, -4000 - e, 3578 - e, 6000 + e, 4000 + e, 3578 + e};
f5[] -= claimed[];
claimed[] += f5[];
voids[] = single[];
voids[] -= claimed[];
// conductor via/1
c4[] = Surface In BoundingBox{2650 - e, 600 - e, 35 - e, 2950 + e, 900 + e, 578 + e};
x[] = c4[];
x[] -= voids[];
c4[] -= x[];
c4[] -= claimed[];
claimed[] += c4[];
// conductor via/2
c5[] = Surface In BoundingBox{2650 - e, -900 - e, 35 - e, 2950 + e, -600 + e, 578 + e};
x[] = c5[];
x[] -= voids[];
