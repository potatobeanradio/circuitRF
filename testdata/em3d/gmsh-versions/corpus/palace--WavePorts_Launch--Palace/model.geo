Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
bs[] = {s};
ex[] = Extrude {0, 0, 508} { Surface{bs[]}; };
s3[] = {ex[1]};
// B1/Bottom Copper/1: Conductor, Copper, order 5
cl[] = {};
p = newp;
Point(p + 0) = {0, -2540, -35};
