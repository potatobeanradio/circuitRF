// bore: Dielectric, PTFE, order 2
v = newv; Cylinder(v) = {-5000, 0, 725.5, 5000, 0, 0, 670};
s1[] = {v};
// pin: Conductor, Connector alloy, order 3
s2[] = ShapeFromFile("kernel-f6a5abbe959a1b9e.brep");
ns2 = #s2[];
// B1/Laminate: Dielectric, PTFE-glass laminate, order 4
cl[] = {};
p = newp;
Point(p + 0) = {0, -2540, 0};
Point(p + 1) = {5080, -2540, 0};
Point(p + 2) = {5080, 2540, 0};
Point(p + 3) = {0, 2540, 0};
l = newc;
Line(l + 0) = {p + 0, p + 1};
