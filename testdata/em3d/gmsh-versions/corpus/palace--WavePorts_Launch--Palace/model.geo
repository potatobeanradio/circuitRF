e = 0.001;

Macro CrfMap
  crft = StrCat(crfn, "[] = {");
  For crfi In {0:#crfl[]-1}
    crfr = 0;
    For crfk In {0:#frag[]-1}
      If (frag[crfk] < crfl[crfi])
        crfr += 1;
      EndIf
    EndFor
    If (crfi)
      crft = StrCat(crft, ", ");
    EndIf
    crft = StrCat(crft, Sprintf("crfb[%g]", crfr));
  EndFor
  Printf(StrCat(crft, "};")) >> "built-ac84ed7e23ae647d.map";
Return
