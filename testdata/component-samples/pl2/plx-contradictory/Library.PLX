EXAMPLEA_LIBRARY_ASCII "GIZMO4"

(asciiHeader
    (fileUnits MIL)
)
(library Library_1
	(padStyleDef "LANDA"
		(holeDiam 0)
		(padShape (layerNumRef 1) (padShapeType Rect)  (shapeWidth 60) (shapeHeight 10))
		(padShape (layerNumRef 22) (padShapeType Rect)  (shapeWidth 60) (shapeHeight 10))
	)
	(padStyleDef "LANDB"
		(holeDiam 0)
		(padShape (layerNumRef 1) (padShapeType Rect)  (shapeWidth 70) (shapeHeight 90))
	)
	(patternDef "GIZMO4_LAND" (originalName "GIZMO4_LAND")
		(multiLayer
			(pad (padNum 1) (padStyleRef LANDA) (pt -80, 30) (rotation 0))
			(pad (padNum 2) (padStyleRef LANDA) (pt -80, 10) (rotation 0))
			(pad (padNum 3) (padStyleRef LANDA) (pt 80, 10) (rotation 0))
			(pad (padNum 4) (padStyleRef LANDA) (pt 80, 30) (rotation 0))
			(pad (padNum 5) (padStyleRef LANDB) (pt 0, 0) (rotation 0))
		)
		(layerContents (layerNumRef 18)
			(line (pt -100, 40) (pt 100, 40) (width 5))
			(line (pt -100, -20) (pt -100, 40) (width 5))
		)
	)
	(symbolDef "GIZMO4" (originalName "GIZMO4")
		(pin (pinNum 1) (pt 0, 0) (rotation 0) (pinLength 300 mils) (pinDisplay (dispPinName true)) (pinName (text (pt 310, 0) "ALPHA" (textStyleRef "H82s5"))
))
		(pin (pinNum 2) (pt 0, -100) (rotation 0) (pinLength 300 mils) (pinDisplay (dispPinName true)) (pinName (text (pt 310, -100) "DELTA" (textStyleRef "H82s5"))
))
		(pin (pinNum 3) (pt 0, -300) (rotation 0) (pinLength 300 mils) (pinDisplay (dispPinName true)) (pinName (text (pt 310, -300) "BETA" (textStyleRef "H82s5"))
))
		(pin (pinNum 4) (pt 1800, -300) (rotation 180) (pinLength 300 mils) (pinDisplay (dispPinName true)) (pinName (text (pt 1490, -300) "GAMMA" (textStyleRef "H82s5"))
))
		(pin (pinNum 5) (pt 1800, 0) (rotation 180) (pinLength 300 mils) (pinDisplay (dispPinName true)) (pinName (text (pt 1490, 0) "THERMAL" (textStyleRef "H82s5"))
))
		(line (pt 300, 200) (pt 1500, 200) (width 5))
		(line (pt 1500, 200) (pt 1500, -800) (width 5))
		(line (pt 1500, -800) (pt 300, -800) (width 5))
		(line (pt 300, -800) (pt 300, 200) (width 5))
	)
	(compDef "GIZMO4"
		(originalName "GIZMO4")
		(compHeader (numPins 5)
			(numParts 1)
			(refDesPrefix U)
		)
		(compPin "1" (pinName "ALPHA") (partNum 1) (symPinNum 1) (gateEq 0) (pinEq 0) (pinType Input))
		(compPin "2" (pinName "BETA") (partNum 1) (symPinNum 3) (gateEq 0) (pinEq 0) (pinType Input))
		(compPin "3" (pinName "GAMMA") (partNum 1) (symPinNum 4) (gateEq 0) (pinEq 0) (pinType Input))
		(compPin "4" (pinName "DELTA") (partNum 1) (symPinNum 2) (gateEq 0) (pinEq 0) (pinType Input))
		(compPin "TPAD" (pinName "THERMAL") (partNum 1) (symPinNum 5) (gateEq 0) (pinEq 0) (pinType Input))
		(attachedSymbol (partNum 1) (altType Normal) (symbolName "GIZMO4"))
		(attachedPattern (patternNum 1) (patternName "GIZMO4_LAND")
			(numPads 5)
			(padPinMap
				(padNum 1) (compPinRef "1")
				(padNum 2) (compPinRef "3")
				(padNum 3) (compPinRef "3")
				(padNum 4) (compPinRef "4")
				(padNum 5) (compPinRef "TPAD")
			)
		)
		(attr "Description" "Synthetic fixture, invented part")
	)
)
