  "DeviceRules": [
    {
      "Name": "Thin-film resistor",
      "Kind": "Resistor",
      "Body": "not(4/0, 1/0)",
      "Terminals": [
        "1/0"
      ],
      "Parameters": {
        "R": "TfrSheetResistance * Length / Width"
      }
    },
    {
      "Name": "MIM capacitor",
      "Kind": "Capacitor",
      "Body": "and(and(9/0, 6/0), 1/0)",
      "Terminals": [
        "1/0",
        "9/0"
      ],
      "Parameters": {
        "C": "MimCapDensity * Area"
      }
    },
    {
      "Name": "Microstrip line (Metal1)",
      "Kind": "TransmissionLine",
      "Body": "and(1/0, 20/0)",
      "Terminals": [
        "1/0"
      ],
      "Parameters": {
        "L": "Length",
        "W": "Width"
      },
      "CopperBody": true
    },
    {
      "Name": "Microstrip line (Metal2)",
      "Kind": "TransmissionLine",
      "Body": "and(2/0, 20/0)",
      "Terminals": [
        "2/0"
      ],
      "Parameters": {
        "L": "Length",
        "W": "Width"
      },
      "CopperBody": true
    },
    {
      "Name": "Spiral inductor",
      "Kind": "Inductor",
      "Body": "and(or(or(1/0, 2/0), 3/0), 21/0)",
      "Terminals": [
        "or(1/0, 2/0)"
      ],
      "CopperBody": true
    },
    {
      "Name": "Backside via to ground",
      "Kind": "Via",
      "Body": "8/0",
      "Terminals": [
        "1/0"
      ],
      "CopperBody": true,
      "GroundTerminal": true
    }
  ],
  "MaterialLibraries": [
    "generic-materials.cmat"
