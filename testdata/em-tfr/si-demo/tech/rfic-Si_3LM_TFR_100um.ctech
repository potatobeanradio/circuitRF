 "DeviceRules": [
  {
   "Name": "Thin-film resistor",
   "Kind": "Resistor",
   "Body": "4/0",
   "Terminals": [
    "11/0"
   ],
   "Parameters": {
    "R": "TfrSheetResistance * Length / Width"
   }
  },
  {
   "Name": "Thin-film resistor Hi",
   "Kind": "Resistor",
   "Body": "7/0",
   "Terminals": [
    "11/0"
   ],
   "Parameters": {
    "R": "TfrSheetResistance * Length / Width"
   }
  },
  {
   "Name": "Microstrip line (Metal3)",
   "Kind": "TransmissionLine",
   "Body": "and(3/0, 20/0)",
   "Terminals": [
    "3/0"
   ],
   "Parameters": {
    "L": "Length",
    "W": "Width"
   },
   "CopperBody": true
  }
 ],
