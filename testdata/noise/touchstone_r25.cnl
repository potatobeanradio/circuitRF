; Touchstone noise round trip: noise_r25.s2p (R 25) between 25 ohm ports.
; Expected: NFmin, Rn, Gamma_opt as in the file (Gamma_opt re-referenced to the port-1 Z0).
; Default ambient: data-file noise is absolute, independent of the ambient.
Port:P1  p1 0  Num=1 Z=25.0 Ohm
Port:P2  p2 0  Num=2 Z=25.0 Ohm
SnP:X1  p1  p2  NumPorts=2 File="noise_r25.s2p"
analysis SP1 type=sparam start=1.0 stop=5.0 npts=5 Unit=GHz
