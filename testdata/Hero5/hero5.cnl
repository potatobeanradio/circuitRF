; ============================================================
; hero5.cnl — Phase-4c two-tone HB: grounded-source GaN HEMT PA, intermodulation.
; Same SDD FET as Phase 3 / Hero 2. Two tones at RFfreq ± ToneSpacing/2
; (1.995 / 2.005 GHz, 10 MHz spacing). Diamond MaxMixOrder=5, MaxHarm=4.
; Deliberate baseband load ZLoad_0 = 10+j10 to exercise even-order IM behavior.
; SELF-GENERATED regression target — NOT independently validated.
; ============================================================

; ---- FET model parameters (same as Phase 3) ----
Sv=-0.837
Sc=0.71
TV0=4.268
TC=1.507
th=0.001
a=0.176
g=0.089
lam=0.0012
B=1130

; ---- two-tone plan ----
RFfreq      = 2e9
ToneSpacing = 10e6

; ---- HB config ----
MaxMixOrder = 5               ; diamond bound |k1|+|k2| <= MaxMixOrder
MaxHarm     = 4
OverSamp    = 1
HBtol       = 1e-7
DriveStep   = IfNecessary
Guard       = 0

; ---- terminations, banded by frequency around the carriers ----
;   The engine evaluates every model at the POSITIVE mixing-product frequency |k1*f1+k2*f2|
;   (negative-frequency reps are handled by conjugate symmetry in the engine), so 'freq' here is
;   always the positive magnitude — band on it directly, no abs() needed.
;   baseband (freq < 0.5 GHz):  difference products (f2-f1 = 10 MHz, etc.)
;   fundamental (0.5..2.5 GHz): carriers + IM3/IM5 (1.975..2.025 GHz)
;   2nd zone (2.5..4.5 GHz), 3rd zone (4.5..6.5 GHz), else near-short.
ZSource_0 = 0.00001 + j*0     ; baseband source
ZSource_f = 25                ; fundamental source impedance
ZSource_2 = 1e-6              ; 2f0 and above: near-short
ZSource_3 = 1e-6

ZLoad_0 = 10 + j*10           ; baseband load — exercises even-order IM
ZLoad_f = 80 + j*10           ; fundamental load
ZLoad_2 = 1                   ; 2f0 termination
ZLoad_3 = 1e-6               ; >=3f0: near-short

; ---- DC bias ----
Vgg = -3.05
Vdd = 48

; ---- drive level (swept), equal-amplitude tones ----
PavlStop_dbm = 20
Pavl_dbm = -20
Pavl_w   = 10^((Pavl_dbm - 30)/10)
Vs_mag   = sqrt(8 * Pavl_w * real(ZSource_f))   ; per-tone |Vs| at the 25-ohm fundamental Zs

; ============================================================
; GATE bias-tee (SDD port 1 = n_gate)
;   drive chain:  Vdrive(2 tones) -> Zsource -> Cblock_g -> n_gate
;   bias  chain:  Vgate(Vdc) -> Lchoke_g -> n_gate
; ============================================================
V_nTone:Vdrive   n_src 0   NumFreqs=2  Freq[1]=RFfreq-ToneSpacing/2  V[1]=Vs_mag  Phase[1]=0  Freq[2]=RFfreq+ToneSpacing/2  V[2]=Vs_mag  Phase[2]=0
Z_Port:Zsource   n_src n_zs    Z[1,1]=if(freq < 0.5e9) then ZSource_0 elseif(freq < 2.5e9) then ZSource_f elseif(freq < 4.5e9) then ZSource_2 elseif(freq < 6.5e9) then ZSource_3 else 1e-6 endif
C:Cblock_g       n_zs n_gate   C=1 uF
V_1Tone:Vgate    n_gbias 0     Vdc=Vgg
L:Lchoke_g       n_gbias n_gate  L=1 uH

; ============================================================
; The FET (SDD), source grounded: port1 = n_gate, port2 = n_drain
; ============================================================
SDD:M1  n_gate 0  n_drain 0  \
  I[1,0]=_v1/50  \
  I[2,0]=(B*TC*tanh(_v2*a*(tanh(g*(TV0 - _v1 + _v2*th + Sc*ln(exp(-(Sv - _v1)/Sc) + 1))) + 1))*ln(exp(-(2*TV0 - 2*_v1 + 2*_v2*th + 2*Sc*ln(exp(-(Sv - _v1)/Sc) + 1))/TC) + 1)*(_v2*lam + 1))/2

; ============================================================
; DRAIN bias-tee (SDD port 2 = n_drain)
;   load chain:  n_drain -> Cblock_d -> Zload -> gnd
;   bias chain:  n_drain -> Lchoke_d -> Vdrain(Vdc)
; ============================================================
C:Cblock_d       n_drain n_zl   C=1 uF
Z_Port:Zload     n_zl 0          Z[1,1]=if(freq < 0.5e9) then ZLoad_0 elseif(freq < 2.5e9) then ZLoad_f elseif(freq < 4.5e9) then ZLoad_2 elseif(freq < 6.5e9) then ZLoad_3 else 1e-6 endif
L:Lchoke_d       n_drain n_dbias  L=1 uH
V_1Tone:Vdrain   n_dbias 0       Vdc=Vdd

; ============================================================
; HB analysis: two tones, diamond MaxMixOrder, sweep Pavl_dbm, harmonics to MaxHarm
; ============================================================
analysis HB5  type=hb  NumFreqs=2  Tone[1]=RFfreq-ToneSpacing/2  Tone[2]=RFfreq+ToneSpacing/2  MaxMixOrder=MaxMixOrder  MaxHarm=MaxHarm \
     Sweep="Pavl_dbm: -20 .. PavlStop_dbm step 1"  FFTOverSample=OverSamp  Tol=HBtol \
     DriveStepping=DriveStep  GuardHarmonic=Guard
